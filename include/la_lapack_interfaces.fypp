    & ('rscl', ['RSCL: multiplies an n-element real vector x by the real scalar 1/a.', 'This is done without overflow or underflow as long as', 'the final result x/a does not overflow or underflow.'], &
    &  [('drscl', 'drscl', 'real'), ('qrscl', 'qrscl', None), ('srscl', 'srscl', 'real'), ('xrscl', 'xrscl', None)], &
    &  {'real': '               pure subroutine {ri}rscl(n,sa,sx,incx)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(in) :: sa\n                    {rt},intent(inout) :: sx(*)\n               end subroutine {ri}rscl'}), &
    & ('sb2st_kernels', ['SB2ST_KERNELS: is an internal routine used by the DSYTRD_SB2ST', 'subroutine.'], &
    &  [('dsb2st_kernels', 'dsb2st_kernels', 'real'), ('qsb2st_kernels', 'qsb2st_kernels', None), ('ssb2st_kernels', 'ssb2st_kernels', 'real'), ('xsb2st_kernels', 'xsb2st_kernels', None)], &
    &  {'real': '               pure subroutine {ri}sb2st_kernels(uplo,wantz,ttype,st,ed,sweep,n,nb,ib,a, &\n                         lda,v,tau,ldvt,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    logical(lk),intent(in) :: wantz\n                    integer(ilp),intent(in) :: ttype,st,ed,sweep,n,nb,ib,lda,ldvt\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: v(*),tau(*),work(*)\n               end subroutine {ri}sb2st_kernels'}), &
    & ('sbev', ['SBEV: computes all the eigenvalues and, optionally, eigenvectors of', 'a real symmetric band matrix A.'], &
    &  [('dsbev', 'dsbev', 'real'), ('qsbev', 'qsbev', None), ('ssbev', 'ssbev', 'real'), ('xsbev', 'xsbev', None)], &
    &  {'real': '               subroutine {ri}sbev(jobz,uplo,n,kd,ab,ldab,w,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kd,ldab,ldz,n\n                    {rt},intent(inout) :: ab(ldab,*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}sbev'}), &
    & ('sbevd', ['SBEVD: computes all the eigenvalues and, optionally, eigenvectors of', 'a real symmetric band matrix A. If eigenvectors are desired, it uses', 'a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('dsbevd', 'dsbevd', 'real'), ('qsbevd', 'qsbevd', None), ('ssbevd', 'ssbevd', 'real'), ('xsbevd', 'xsbevd', None)], &
    &  {'real': '               subroutine {ri}sbevd(jobz,uplo,n,kd,ab,ldab,w,z,ldz,work,lwork,iwork, &\n                         liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: kd,ldab,ldz,liwork,lwork,n\n                    {rt},intent(inout) :: ab(ldab,*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}sbevd'}), &
    & ('sbgst', ['SBGST: reduces a real symmetric-definite banded generalized', 'eigenproblem  A*x = lambda*B*x  to standard form  C*y = lambda*y,', 'such that C has the same bandwidth as A.', 'B must have been previously factorized as S**T*S by DPBSTF, using a', 'split Cholesky factorization. A is overwritten by C = X**T*A*X, where', 'X = S**(-1)*Q and Q is an orthogonal matrix chosen to preserve the', 'bandwidth of A.'], &
    &  [('dsbgst', 'dsbgst', 'real'), ('qsbgst', 'qsbgst', None), ('ssbgst', 'ssbgst', 'real'), ('xsbgst', 'xsbgst', None)], &
    &  {'real': '               pure subroutine {ri}sbgst(vect,uplo,n,ka,kb,ab,ldab,bb,ldbb,x,ldx,work, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,vect\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldx,n\n                    {rt},intent(inout) :: ab(ldab,*)\n                    {rt},intent(in) :: bb(ldbb,*)\n                    {rt},intent(out) :: work(*),x(ldx,*)\n               end subroutine {ri}sbgst'}), &
    & ('sbgv', ['SBGV: computes all the eigenvalues, and optionally, the eigenvectors', 'of a real generalized symmetric-definite banded eigenproblem, of', 'the form A*x=(lambda)*B*x. Here A and B are assumed to be symmetric', 'and banded, and B is also positive definite.'], &
    &  [('dsbgv', 'dsbgv', 'real'), ('qsbgv', 'qsbgv', None), ('ssbgv', 'ssbgv', 'real'), ('xsbgv', 'xsbgv', None)], &
    &  {'real': '               pure subroutine {ri}sbgv(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,w,z,ldz,work, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldz,n\n                    {rt},intent(inout) :: ab(ldab,*),bb(ldbb,*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}sbgv'}), &
    & ('sbgvd', ['SBGVD: computes all the eigenvalues, and optionally, the eigenvectors', 'of a real generalized symmetric-definite banded eigenproblem, of the', 'form A*x=(lambda)*B*x.  Here A and B are assumed to be symmetric and', 'banded, and B is also positive definite.  If eigenvectors are', 'desired, it uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('dsbgvd', 'dsbgvd', 'real'), ('qsbgvd', 'qsbgvd', None), ('ssbgvd', 'ssbgvd', 'real'), ('xsbgvd', 'xsbgvd', None)], &
    &  {'real': '               pure subroutine {ri}sbgvd(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,w,z,ldz,work, &\n                         lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldz,liwork,lwork,n\n                    {rt},intent(inout) :: ab(ldab,*),bb(ldbb,*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}sbgvd'}), &
    & ('sbtrd', ['SBTRD: reduces a real symmetric band matrix A to symmetric', 'tridiagonal form T by an orthogonal similarity transformation:', 'Q**T * A * Q = T.'], &
    &  [('dsbtrd', 'dsbtrd', 'real'), ('qsbtrd', 'qsbtrd', None), ('ssbtrd', 'ssbtrd', 'real'), ('xsbtrd', 'xsbtrd', None)], &
    &  {'real': '               pure subroutine {ri}sbtrd(vect,uplo,n,kd,ab,ldab,d,e,q,ldq,work,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,vect\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kd,ldab,ldq,n\n                    {rt},intent(inout) :: ab(ldab,*),q(ldq,*)\n                    {rt},intent(out) :: d(*),e(*),work(*)\n               end subroutine {ri}sbtrd'}), &
    & ('sfrk', ['Level 3 BLAS like routine for C in RFP Format.', 'SFRK: performs one of the symmetric rank--k operations', 'C := alpha*A*A**T + beta*C,', 'or', 'C := alpha*A**T*A + beta*C,', 'where alpha and beta are real scalars, C is an n--by--n symmetric', 'matrix and A is an n--by--k matrix in the first case and a k--by--n', 'matrix in the second case.'], &
    &  [('dsfrk', 'dsfrk', 'real'), ('qsfrk', 'qsfrk', None), ('ssfrk', 'ssfrk', 'real'), ('xsfrk', 'xsfrk', None)], &
    &  {'real': '               pure subroutine {ri}sfrk(transr,uplo,trans,n,k,alpha,a,lda,beta,c)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*)\n                    integer(ilp),intent(in) :: k,lda,n\n                    character,intent(in) :: trans,transr,uplo\n                    {rt},intent(inout) :: c(*)\n               end subroutine {ri}sfrk'}), &
    & ('spcon', ['SPCON: estimates the reciprocal of the condition number (in the', '1-norm) of a complex symmetric packed matrix A using the', 'factorization A = U*D*U**T or A = L*D*L**T computed by CSPTRF.', 'An estimate is obtained for norm(inv(A)), and the reciprocal of the', 'condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).'], &
    &  [('cspcon', 'cspcon', 'complex'), ('dspcon', 'dspcon', 'real'), ('qspcon', 'qspcon', None), ('sspcon', 'sspcon', 'real'), ('wspcon', 'wspcon', None), ('xspcon', 'xspcon', None), ('yspcon', 'yspcon', None), ('zspcon', 'zspcon', 'complex')], &
    &  {'complex': '               pure subroutine {ri}spcon(uplo,n,ap,ipiv,anorm,rcond,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,ipiv(*)\n                    real({rk}),intent(in) :: anorm\n                    real({rk}),intent(out) :: rcond\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}spcon', 'real': '               pure subroutine {ri}spcon(uplo,n,ap,ipiv,anorm,rcond,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: n,ipiv(*)\n                    {rt},intent(in) :: anorm,ap(*)\n                    {rt},intent(out) :: rcond,work(*)\n               end subroutine {ri}spcon'}), &
    & ('spev', ['SPEV: computes all the eigenvalues and, optionally, eigenvectors of a', 'real symmetric matrix A in packed storage.'], &
    &  [('dspev', 'dspev', 'real'), ('qspev', 'qspev', None), ('sspev', 'sspev', 'real'), ('xspev', 'xspev', None)], &
    &  {'real': '               subroutine {ri}spev(jobz,uplo,n,ap,w,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}spev'}), &
    & ('spevd', ['SPEVD: computes all the eigenvalues and, optionally, eigenvectors', 'of a real symmetric matrix A in packed storage. If eigenvectors are', 'desired, it uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('dspevd', 'dspevd', 'real'), ('qspevd', 'qspevd', None), ('sspevd', 'sspevd', 'real'), ('xspevd', 'xspevd', None)], &
    &  {'real': '               subroutine {ri}spevd(jobz,uplo,n,ap,w,z,ldz,work,lwork,iwork,liwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldz,liwork,lwork,n\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}spevd'}), &
    & ('spgst', ['SPGST: reduces a real symmetric-definite generalized eigenproblem', 'to standard form, using packed storage.', 'If ITYPE = 1, the problem is A*x = lambda*B*x,', 'and A is overwritten by inv(U**T)*A*inv(U) or inv(L)*A*inv(L**T)', 'If ITYPE = 2 or 3, the problem is A*B*x = lambda*x or', 'B*A*x = lambda*x, and A is overwritten by U*A*U**T or L**T*A*L.', 'B must have been previously factorized as U**T*U or L*L**T by DPPTRF.'], &
    &  [('dspgst', 'dspgst', 'real'), ('qspgst', 'qspgst', None), ('sspgst', 'sspgst', 'real'), ('xspgst', 'xspgst', None)], &
    &  {'real': '               pure subroutine {ri}spgst(itype,uplo,n,ap,bp,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: itype,n\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(in) :: bp(*)\n               end subroutine {ri}spgst'}), &
    & ('spgv', ['SPGV: computes all the eigenvalues and, optionally, the eigenvectors', 'of a real generalized symmetric-definite eigenproblem, of the form', 'A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.', 'Here A and B are assumed to be symmetric, stored in packed format,', 'and B is also positive definite.'], &
    &  [('dspgv', 'dspgv', 'real'), ('qspgv', 'qspgv', None), ('sspgv', 'sspgv', 'real'), ('xspgv', 'xspgv', None)], &
    &  {'real': '               subroutine {ri}spgv(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: itype,ldz,n\n                    {rt},intent(inout) :: ap(*),bp(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}spgv'}), &
    & ('spgvd', ['SPGVD: computes all the eigenvalues, and optionally, the eigenvectors', 'of a real generalized symmetric-definite eigenproblem, of the form', 'A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and', 'B are assumed to be symmetric, stored in packed format, and B is also', 'positive definite.', 'If eigenvectors are desired, it uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('dspgvd', 'dspgvd', 'real'), ('qspgvd', 'qspgvd', None), ('sspgvd', 'sspgvd', 'real'), ('xspgvd', 'xspgvd', None)], &
    &  {'real': '               subroutine {ri}spgvd(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,lwork,iwork, &\n                         liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: itype,ldz,liwork,lwork,n\n                    {rt},intent(inout) :: ap(*),bp(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}spgvd'}), &
    & ('spmv', ['SPMV:  performs the matrix-vector operation', 'y := alpha*A*x + beta*y,', 'where alpha and beta are scalars, x and y are n element vectors and', 'A is an n by n symmetric matrix, supplied in packed form.'], &
    &  [('cspmv', 'cspmv', 'complex'), ('wspmv', 'wspmv', None), ('yspmv', 'yspmv', None), ('zspmv', 'zspmv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}spmv(uplo,n,alpha,ap,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: alpha,beta,ap(*),x(*)\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}spmv'}), &
    & ('spr', ['SPR:    performs the symmetric rank 1 operation', 'A := alpha*x*x**H + A,', 'where alpha is a complex scalar, x is an n element vector and A is an', 'n by n symmetric matrix, supplied in packed form.'], &
    &  [('cspr', 'cspr', 'complex'), ('wspr', 'wspr', None), ('yspr', 'yspr', None), ('zspr', 'zspr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}spr(uplo,n,alpha,x,incx,ap)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(in) :: alpha,x(*)\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}spr'}), &
    & ('sprfs', ['SPRFS: improves the computed solution to a system of linear', 'equations when the coefficient matrix is symmetric indefinite', 'and packed, and provides error bounds and backward error estimates', 'for the solution.'], &
    &  [('csprfs', 'csprfs', 'complex'), ('dsprfs', 'dsprfs', 'real'), ('qsprfs', 'qsprfs', None), ('ssprfs', 'ssprfs', 'real'), ('wsprfs', 'wsprfs', None), ('xsprfs', 'xsprfs', None), ('ysprfs', 'ysprfs', None), ('zsprfs', 'zsprfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sprfs(uplo,n,nrhs,ap,afp,ipiv,b,ldb,x,ldx,ferr,berr, &\n                         work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs,ipiv(*)\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    {rt},intent(in) :: afp(*),ap(*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}sprfs', 'real': '               pure subroutine {ri}sprfs(uplo,n,nrhs,ap,afp,ipiv,b,ldb,x,ldx,ferr,berr, &\n                         work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs,ipiv(*)\n                    {rt},intent(in) :: afp(*),ap(*),b(ldb,*)\n                    {rt},intent(out) :: berr(*),ferr(*),work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}sprfs'}), &
    & ('spsv', ['SPSV: computes the solution to a complex system of linear equations', 'A * X = B,', 'where A is an N-by-N symmetric matrix stored in packed format and X', 'and B are N-by-NRHS matrices.', 'The diagonal pivoting method is used to factor A as', "A = U * D * U**T,  if UPLO = 'U', or", "A = L * D * L**T,  if UPLO = 'L',", 'where U (or L) is a product of permutation and unit upper (lower)', 'triangular matrices, D is symmetric and block diagonal with 1-by-1', 'and 2-by-2 diagonal blocks.  The factored form of A is then used to', 'solve the system of equations A * X = B.'], &
    &  [('cspsv', 'cspsv', 'complex'), ('dspsv', 'dspsv', 'real'), ('qspsv', 'qspsv', None), ('sspsv', 'sspsv', 'real'), ('wspsv', 'wspsv', None), ('xspsv', 'xspsv', None), ('yspsv', 'yspsv', None), ('zspsv', 'zspsv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}spsv(uplo,n,nrhs,ap,ipiv,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(inout) :: ap(*),b(ldb,*)\n               end subroutine {ri}spsv', 'real': '               pure subroutine {ri}spsv(uplo,n,nrhs,ap,ipiv,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(inout) :: ap(*),b(ldb,*)\n               end subroutine {ri}spsv'}), &
    & ('sptrd', ['SPTRD: reduces a real symmetric matrix A stored in packed form to', 'symmetric tridiagonal form T by an orthogonal similarity', 'transformation: Q**T * A * Q = T.'], &
    &  [('dsptrd', 'dsptrd', 'real'), ('qsptrd', 'qsptrd', None), ('ssptrd', 'ssptrd', 'real'), ('xsptrd', 'xsptrd', None)], &
    &  {'real': '               pure subroutine {ri}sptrd(uplo,n,ap,d,e,tau,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: d(*),e(*),tau(*)\n               end subroutine {ri}sptrd'}), &
    & ('sptrf', ['SPTRF: computes the factorization of a complex symmetric matrix A', 'stored in packed format using the Bunch-Kaufman diagonal pivoting', 'method:', 'A = U*D*U**T  or  A = L*D*L**T', 'where U (or L) is a product of permutation and unit upper (lower)', 'triangular matrices, and D is symmetric and block diagonal with', '1-by-1 and 2-by-2 diagonal blocks.'], &
    &  [('csptrf', 'csptrf', 'complex'), ('dsptrf', 'dsptrf', 'real'), ('qsptrf', 'qsptrf', None), ('ssptrf', 'ssptrf', 'real'), ('wsptrf', 'wsptrf', None), ('xsptrf', 'xsptrf', None), ('ysptrf', 'ysptrf', None), ('zsptrf', 'zsptrf', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sptrf(uplo,n,ap,ipiv,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}sptrf', 'real': '               pure subroutine {ri}sptrf(uplo,n,ap,ipiv,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}sptrf'}), &
    & ('sptri', ['SPTRI: computes the inverse of a complex symmetric indefinite matrix', 'A in packed storage using the factorization A = U*D*U**T or', 'A = L*D*L**T computed by CSPTRF.'], &
    &  [('csptri', 'csptri', 'complex'), ('dsptri', 'dsptri', 'real'), ('qsptri', 'qsptri', None), ('ssptri', 'ssptri', 'real'), ('wsptri', 'wsptri', None), ('xsptri', 'xsptri', None), ('ysptri', 'ysptri', None), ('zsptri', 'zsptri', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sptri(uplo,n,ap,ipiv,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,ipiv(*)\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sptri', 'real': '               pure subroutine {ri}sptri(uplo,n,ap,ipiv,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,ipiv(*)\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sptri'}), &
    & ('sptrs', ['SPTRS: solves a system of linear equations A*X = B with a complex', 'symmetric matrix A stored in packed format using the factorization', 'A = U*D*U**T or A = L*D*L**T computed by CSPTRF.'], &
    &  [('csptrs', 'csptrs', 'complex'), ('dsptrs', 'dsptrs', 'real'), ('qsptrs', 'qsptrs', None), ('ssptrs', 'ssptrs', 'real'), ('wsptrs', 'wsptrs', None), ('xsptrs', 'xsptrs', None), ('ysptrs', 'ysptrs', None), ('zsptrs', 'zsptrs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sptrs(uplo,n,nrhs,ap,ipiv,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs,ipiv(*)\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}sptrs', 'real': '               pure subroutine {ri}sptrs(uplo,n,nrhs,ap,ipiv,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs,ipiv(*)\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}sptrs'}), &
    & ('stebz', ['STEBZ: computes the eigenvalues of a symmetric tridiagonal', 'matrix T.  The user may ask for all eigenvalues, all eigenvalues', 'in the half-open interval (VL, VU], or the IL-th through IU-th', 'eigenvalues.', 'To avoid overflow, the matrix must be scaled so that its', 'largest element is no greater than overflow**(1/2) * underflow**(1/4) in absolute value, and for greatest', 'accuracy, it should not be much smaller than that.', 'See W. Kahan "Accurate Eigenvalues of a Symmetric Tridiagonal', 'Matrix", Report CS41, Computer Science Dept., Stanford', 'University, July 21, 1966.'], &
    &  [('dstebz', 'dstebz', 'real'), ('qstebz', 'qstebz', None), ('sstebz', 'sstebz', 'real'), ('xstebz', 'xstebz', None)], &
    &  {'real': '               pure subroutine {ri}stebz(range,order,n,vl,vu,il,iu,abstol,d,e,m,nsplit,w, &\n                          iblock,isplit,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: order,range\n                    integer(ilp),intent(in) :: il,iu,n\n                    integer(ilp),intent(out) :: info,m,nsplit,iblock(*),isplit(*),iwork(*)\n                              \n                    {rt},intent(in) :: abstol,vl,vu,d(*),e(*)\n                    {rt},intent(out) :: w(*),work(*)\n               end subroutine {ri}stebz'}), &
    & ('stedc', ['STEDC: computes all eigenvalues and, optionally, eigenvectors of a', 'symmetric tridiagonal matrix using the divide and conquer method.', 'The eigenvectors of a full or band complex Hermitian matrix can also', 'be found if CHETRD or CHPTRD or CHBTRD has been used to reduce this', 'matrix to tridiagonal form.', 'This code makes very mild assumptions about floating point', 'arithmetic. It will work on machines with a guard digit in', 'add/subtract, or on those binary machines without guard digits', 'which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or Cray-2.', 'It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.  See SLAED3 for details.'], &
    &  [('cstedc', 'cstedc', 'complex'), ('dstedc', 'dstedc', 'real'), ('qstedc', 'qstedc', None), ('sstedc', 'sstedc', 'real'), ('wstedc', 'wstedc', None), ('xstedc', 'xstedc', None), ('ystedc', 'ystedc', None), ('zstedc', 'zstedc', 'complex')], &
    &  {'complex': '               pure subroutine {ri}stedc(compz,n,d,e,z,ldz,work,lwork,rwork,lrwork,iwork, &\n                         liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compz\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldz,liwork,lrwork,lwork,n\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(out) :: work(*)\n                    {rt},intent(inout) :: z(ldz,*)\n               end subroutine {ri}stedc', 'real': '               pure subroutine {ri}stedc(compz,n,d,e,z,ldz,work,lwork,iwork,liwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compz\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldz,liwork,lwork,n\n                    {rt},intent(inout) :: d(*),e(*),z(ldz,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}stedc'}), &
    & ('stegr', ['STEGR: computes selected eigenvalues and, optionally, eigenvectors', 'of a real symmetric tridiagonal matrix T. Any such unreduced matrix has', 'a well defined set of pairwise different real eigenvalues, the corresponding', 'real eigenvectors are pairwise orthogonal.', 'The spectrum may be computed either completely or partially by specifying', 'either an interval (VL,VU] or a range of indices IL:IU for the desired', 'eigenvalues.', 'STEGR is a compatibility wrapper around the improved CSTEMR routine.', 'See SSTEMR for further details.', 'One important change is that the ABSTOL parameter no longer provides any', 'benefit and hence is no longer used.', 'Note : STEGR and CSTEMR work only on machines which follow', 'IEEE-754 floating-point standard in their handling of infinities and', 'NaNs.  Normal execution may create these exceptiona values and hence', 'may abort due to a floating point exception in environments which', 'do not conform to the IEEE-754 standard.'], &
    &  [('cstegr', 'cstegr', 'complex'), ('dstegr', 'dstegr', 'real'), ('qstegr', 'qstegr', None), ('sstegr', 'sstegr', 'real'), ('wstegr', 'wstegr', None), ('xstegr', 'xstegr', None), ('ystegr', 'ystegr', None), ('zstegr', 'zstegr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}stegr(jobz,range,n,d,e,vl,vu,il,iu,abstol,m,w,z,ldz, &\n                         isuppz,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,range\n                    integer(ilp),intent(in) :: il,iu,ldz,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,isuppz(*),iwork(*)\n                    real({rk}),intent(in) :: abstol,vl,vu\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: w(*),work(*)\n                    {rt},intent(out) :: z(ldz,*)\n               end subroutine {ri}stegr', 'real': '               pure subroutine {ri}stegr(jobz,range,n,d,e,vl,vu,il,iu,abstol,m,w,z,ldz, &\n                         isuppz,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,range\n                    integer(ilp),intent(in) :: il,iu,ldz,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,isuppz(*),iwork(*)\n                    {rt},intent(in) :: abstol,vl,vu\n                    {rt},intent(inout) :: d(*),e(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}stegr'}), &
    & ('stein', ['STEIN: computes the eigenvectors of a real symmetric tridiagonal', 'matrix T corresponding to specified eigenvalues, using inverse', 'iteration.', 'The maximum number of iterations allowed for each eigenvector is', 'specified by an internal parameter MAXITS (currently set to 5).', 'Although the eigenvectors are real, they are stored in a complex', 'array, which may be passed to CUNMTR or CUPMTR for back', 'transformation to the eigenvectors of a complex Hermitian matrix', 'which was reduced to tridiagonal form.'], &
    &  [('cstein', 'cstein', 'complex'), ('dstein', 'dstein', 'real'), ('qstein', 'qstein', None), ('sstein', 'sstein', 'real'), ('wstein', 'wstein', None), ('xstein', 'xstein', None), ('ystein', 'ystein', None), ('zstein', 'zstein', 'complex')], &
    &  {'complex': '               pure subroutine {ri}stein(n,d,e,m,w,iblock,isplit,z,ldz,work,iwork,ifail, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info,ifail(*),iwork(*)\n                    integer(ilp),intent(in) :: ldz,m,n,iblock(*),isplit(*)\n                    real({rk}),intent(in) :: d(*),e(*),w(*)\n                    real({rk}),intent(out) :: work(*)\n                    {rt},intent(out) :: z(ldz,*)\n               end subroutine {ri}stein', 'real': '               pure subroutine {ri}stein(n,d,e,m,w,iblock,isplit,z,ldz,work,iwork,ifail, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info,ifail(*),iwork(*)\n                    integer(ilp),intent(in) :: ldz,m,n,iblock(*),isplit(*)\n                    {rt},intent(in) :: d(*),e(*),w(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}stein'}), &
    & ('stemr', ['STEMR: computes selected eigenvalues and, optionally, eigenvectors', 'of a real symmetric tridiagonal matrix T. Any such unreduced matrix has', 'a well defined set of pairwise different real eigenvalues, the corresponding', 'real eigenvectors are pairwise orthogonal.', 'The spectrum may be computed either completely or partially by specifying', 'either an interval (VL,VU] or a range of indices IL:IU for the desired', 'eigenvalues.', 'Depending on the number of desired eigenvalues, these are computed either', 'by bisection or the dqds algorithm. Numerically orthogonal eigenvectors are', 'computed by the use of various suitable L D L^T factorizations near clusters', 'of close eigenvalues (referred to as RRRs, Relatively Robust', 'Representations). An informal sketch of the algorithm follows.', 'For each unreduced block (submatrix) of T,', '(a) Compute T - sigma I  = L D L^T, so that L and D', 'define all the wanted eigenvalues to high relative accuracy.', 'This means that small relative changes in the entries of D and L', 'cause only small relative changes in the eigenvalues and', 'eigenvectors. The standard (unfactored) representation of the', 'tridiagonal matrix T does not have this property in general.', '(b) Compute the eigenvalues to suitable accuracy.', 'If the eigenvectors are desired, the algorithm attains full', 'accuracy of the computed eigenvalues only right before', 'the corresponding vectors have to be computed, see steps c) and d).', '(c) For each cluster of close eigenvalues, select a new', 'shift close to the cluster, find a new factorization, and refine', 'the shifted eigenvalues to suitable accuracy.', '(d) For each eigenvalue with a large enough relative separation compute', 'the corresponding eigenvector by forming a rank revealing twisted', 'factorization. Go back to (c) for any clusters that remain.', 'For more details, see:', '- Inderjit S. Dhillon and Beresford N. Parlett: "Multiple representations', 'to compute orthogonal eigenvectors of symmetric tridiagonal matrices,"', 'Linear Algebra and its Applications, 387(1), pp. 1-28, August 2004.', '- Inderjit Dhillon and Beresford Parlett: "Orthogonal Eigenvectors and', 'Relative Gaps," SIAM Journal on Matrix Analysis and Applications, Vol. 25,', '2004.  Also LAPACK Working Note 154.', '- Inderjit Dhillon: "A new O(n^2) algorithm for the symmetric', 'tridiagonal eigenvalue/eigenvector problem",', 'Computer Science Division Technical Report No. UCB/CSD-97-971,', 'UC Berkeley, May 1997.', 'Further Details', '1.STEMR works only on machines which follow IEEE-754', 'floating-point standard in their handling of infinities and NaNs.', 'This permits the use of efficient inner loops avoiding a check for', 'zero divisors.', '2. LAPACK routines can be used to reduce a complex Hermitean matrix to', 'real symmetric tridiagonal form.', '(Any complex Hermitean tridiagonal matrix has real values on its diagonal', 'and potentially complex numbers on its off-diagonals. By applying a', 'similarity transform with an appropriate diagonal matrix', 'diag(1,e^{i \\phy_1}, ... , e^{i \\phy_{n-1}}), the complex Hermitean', 'matrix can be transformed into a real symmetric matrix and complex', 'arithmetic can be entirely avoided.)', 'While the eigenvectors of the real symmetric tridiagonal matrix are real,', 'the eigenvectors of original complex Hermitean matrix have complex entries', 'in general.', 'Since LAPACK drivers overwrite the matrix data with the eigenvectors,', 'STEMR accepts complex workspace to facilitate interoperability', 'with CUNMTR or CUPMTR.'], &
    &  [('cstemr', 'cstemr', 'complex'), ('dstemr', 'dstemr', 'real'), ('qstemr', 'qstemr', None), ('sstemr', 'sstemr', 'real'), ('wstemr', 'wstemr', None), ('xstemr', 'xstemr', None), ('ystemr', 'ystemr', None), ('zstemr', 'zstemr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}stemr(jobz,range,n,d,e,vl,vu,il,iu,m,w,z,ldz,nzc, &\n                         isuppz,tryrac,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,range\n                    logical(lk),intent(inout) :: tryrac\n                    integer(ilp),intent(in) :: il,iu,ldz,nzc,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,isuppz(*),iwork(*)\n                    real({rk}),intent(in) :: vl,vu\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: w(*),work(*)\n                    {rt},intent(out) :: z(ldz,*)\n               end subroutine {ri}stemr', 'real': '               pure subroutine {ri}stemr(jobz,range,n,d,e,vl,vu,il,iu,m,w,z,ldz,nzc, &\n                         isuppz,tryrac,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,range\n                    logical(lk),intent(inout) :: tryrac\n                    integer(ilp),intent(in) :: il,iu,ldz,nzc,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,isuppz(*),iwork(*)\n                    {rt},intent(in) :: vl,vu\n                    {rt},intent(inout) :: d(*),e(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}stemr'}), &
    & ('steqr', ['STEQR: computes all eigenvalues and, optionally, eigenvectors of a', 'symmetric tridiagonal matrix using the implicit QL or QR method.', 'The eigenvectors of a full or band complex Hermitian matrix can also', 'be found if CHETRD or CHPTRD or CHBTRD has been used to reduce this', 'matrix to tridiagonal form.'], &
    &  [('csteqr', 'csteqr', 'complex'), ('dsteqr', 'dsteqr', 'real'), ('qsteqr', 'qsteqr', None), ('ssteqr', 'ssteqr', 'real'), ('wsteqr', 'wsteqr', None), ('xsteqr', 'xsteqr', None), ('ysteqr', 'ysteqr', None), ('zsteqr', 'zsteqr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}steqr(compz,n,d,e,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compz\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: work(*)\n                    {rt},intent(inout) :: z(ldz,*)\n               end subroutine {ri}steqr', 'real': '               pure subroutine {ri}steqr(compz,n,d,e,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compz\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    {rt},intent(inout) :: d(*),e(*),z(ldz,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}steqr'}), &
    & ('sterf', ['STERF: computes all eigenvalues of a symmetric tridiagonal matrix', 'using the Pal-Walker-Kahan variant of the QL or QR algorithm.'], &
    &  [('dsterf', 'dsterf', 'real'), ('qsterf', 'qsterf', None), ('ssterf', 'ssterf', 'real'), ('xsterf', 'xsterf', None)], &
    &  {'real': '               pure subroutine {ri}sterf(n,d,e,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: d(*),e(*)\n               end subroutine {ri}sterf'}), &
    & ('stev', ['STEV: computes all eigenvalues and, optionally, eigenvectors of a', 'real symmetric tridiagonal matrix A.'], &
    &  [('dstev', 'dstev', 'real'), ('qstev', 'qstev', None), ('sstev', 'sstev', 'real'), ('xstev', 'xstev', None)], &
    &  {'real': '               pure subroutine {ri}stev(jobz,n,d,e,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    {rt},intent(inout) :: d(*),e(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}stev'}), &
    & ('stevd', ['STEVD: computes all eigenvalues and, optionally, eigenvectors of a', 'real symmetric tridiagonal matrix. If eigenvectors are desired, it', 'uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('dstevd', 'dstevd', 'real'), ('qstevd', 'qstevd', None), ('sstevd', 'sstevd', 'real'), ('xstevd', 'xstevd', None)], &
    &  {'real': '               pure subroutine {ri}stevd(jobz,n,d,e,z,ldz,work,lwork,iwork,liwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldz,liwork,lwork,n\n                    {rt},intent(inout) :: d(*),e(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}stevd'}), &
    & ('stevr', ['STEVR: computes selected eigenvalues and, optionally, eigenvectors', 'of a real symmetric tridiagonal matrix T.  Eigenvalues and', 'eigenvectors can be selected by specifying either a range of values', 'or a range of indices for the desired eigenvalues.', 'Whenever possible, STEVR calls DSTEMR to compute the', 'eigenspectrum using Relatively Robust Representations.  DSTEMR', 'computes eigenvalues by the dqds algorithm, while orthogonal', 'eigenvectors are computed from various "good" L D L^T representations', '(also known as Relatively Robust Representations). Gram-Schmidt', 'orthogonalization is avoided as far as possible. More specifically,', 'the various steps of the algorithm are as follows. For the i-th', 'unreduced block of T,', '(a) Compute T - sigma_i = L_i D_i L_i^T, such that L_i D_i L_i^T', 'is a relatively robust representation,', '(b) Compute the eigenvalues, lambda_j, of L_i D_i L_i^T to high', 'relative accuracy by the dqds algorithm,', '(c) If there is a cluster of close eigenvalues, "choose" sigma_i', 'close to the cluster, and go to step (a),', '(d) Given the approximate eigenvalue lambda_j of L_i D_i L_i^T,', 'compute the corresponding eigenvector by forming a', 'rank-revealing twisted factorization.', 'The desired accuracy of the output can be specified by the input', 'parameter ABSTOL.', 'For more details, see "A new O(n^2) algorithm for the symmetric', 'tridiagonal eigenvalue/eigenvector problem", by Inderjit Dhillon,', 'Computer Science Division Technical Report No. UCB//CSD-97-971,', 'UC Berkeley, May 1997.', 'Note 1 : STEVR calls DSTEMR when the full spectrum is requested', 'on machines which conform to the ieee-754 floating point standard.', 'STEVR calls DSTEBZ and DSTEIN on non-ieee machines and', 'when partial spectrum requests are made.', 'Normal execution of DSTEMR may create NaNs and infinities and', 'hence may abort due to a floating point exception in environments', 'which do not handle NaNs and infinities in the ieee standard default', 'manner.'], &
    &  [('dstevr', 'dstevr', 'real'), ('qstevr', 'qstevr', None), ('sstevr', 'sstevr', 'real'), ('xstevr', 'xstevr', None)], &
    &  {'real': '               pure subroutine {ri}stevr(jobz,range,n,d,e,vl,vu,il,iu,abstol,m,w,z,ldz, &\n                         isuppz,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,range\n                    integer(ilp),intent(in) :: il,iu,ldz,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,isuppz(*),iwork(*)\n                    {rt},intent(in) :: abstol,vl,vu\n                    {rt},intent(inout) :: d(*),e(*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}stevr'}), &
    & ('sycon', ['SYCON: estimates the reciprocal of the condition number (in the', '1-norm) of a complex symmetric matrix A using the factorization', 'A = U*D*U**T or A = L*D*L**T computed by CSYTRF.', 'An estimate is obtained for norm(inv(A)), and the reciprocal of the', 'condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).'], &
    &  [('csycon', 'csycon', 'complex'), ('dsycon', 'dsycon', 'real'), ('qsycon', 'qsycon', None), ('ssycon', 'ssycon', 'real'), ('wsycon', 'wsycon', None), ('xsycon', 'xsycon', None), ('ysycon', 'ysycon', None), ('zsycon', 'zsycon', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sycon(uplo,n,a,lda,ipiv,anorm,rcond,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    real({rk}),intent(in) :: anorm\n                    real({rk}),intent(out) :: rcond\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sycon', 'real': '               pure subroutine {ri}sycon(uplo,n,a,lda,ipiv,anorm,rcond,work,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    {rt},intent(in) :: anorm,a(lda,*)\n                    {rt},intent(out) :: rcond,work(*)\n               end subroutine {ri}sycon'}), &
    & ('sycon_rook', ['SYCON_ROOK: estimates the reciprocal of the condition number (in the', '1-norm) of a complex symmetric matrix A using the factorization', 'A = U*D*U**T or A = L*D*L**T computed by CSYTRF_ROOK.', 'An estimate is obtained for norm(inv(A)), and the reciprocal of the', 'condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).'], &
    &  [('csycon_rook', 'csycon_rook', 'complex'), ('dsycon_rook', 'dsycon_rook', 'real'), ('qsycon_rook', 'qsycon_rook', None), ('ssycon_rook', 'ssycon_rook', 'real'), ('wsycon_rook', 'wsycon_rook', None), ('xsycon_rook', 'xsycon_rook', None), ('ysycon_rook', 'ysycon_rook', None), ('zsycon_rook', 'zsycon_rook', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sycon_rook(uplo,n,a,lda,ipiv,anorm,rcond,work,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    real({rk}),intent(in) :: anorm\n                    real({rk}),intent(out) :: rcond\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sycon_rook', 'real': '               pure subroutine {ri}sycon_rook(uplo,n,a,lda,ipiv,anorm,rcond,work,iwork,info &\n                         )\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    {rt},intent(in) :: anorm,a(lda,*)\n                    {rt},intent(out) :: rcond,work(*)\n               end subroutine {ri}sycon_rook'}), &
    & ('syconv', ['SYCONV: convert A given by TRF into L and D and vice-versa.', 'Get Non-diag elements of D (returned in workspace) and', 'apply or reverse permutation done in TRF.'], &
    &  [('csyconv', 'csyconv', 'complex'), ('dsyconv', 'dsyconv', 'real'), ('qsyconv', 'qsyconv', None), ('ssyconv', 'ssyconv', 'real'), ('wsyconv', 'wsyconv', None), ('xsyconv', 'xsyconv', None), ('ysyconv', 'ysyconv', None), ('zsyconv', 'zsyconv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}syconv(uplo,way,n,a,lda,ipiv,e,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,way\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: e(*)\n               end subroutine {ri}syconv', 'real': '               pure subroutine {ri}syconv(uplo,way,n,a,lda,ipiv,e,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,way\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: e(*)\n               end subroutine {ri}syconv'}), &
    & ('syconvf', ["If parameter WAY = 'C':", 'SYCONVF: converts the factorization output format used in', 'CSYTRF provided on entry in parameter A into the factorization', 'output format used in CSYTRF_RK (or CSYTRF_BK) that is stored', 'on exit in parameters A and E. It also converts in place details of', 'the intechanges stored in IPIV from the format used in CSYTRF into', 'the format used in CSYTRF_RK (or CSYTRF_BK).', "If parameter WAY = 'R':", 'SYCONVF performs the conversion in reverse direction, i.e.', 'converts the factorization output format used in CSYTRF_RK', '(or CSYTRF_BK) provided on entry in parameters A and E into', 'the factorization output format used in CSYTRF that is stored', 'on exit in parameter A. It also converts in place details of', 'the intechanges stored in IPIV from the format used in CSYTRF_RK', '(or CSYTRF_BK) into the format used in CSYTRF.', 'SYCONVF can also convert in Hermitian matrix case, i.e. between', 'formats used in CHETRF and CHETRF_RK (or CHETRF_BK).'], &
    &  [('csyconvf', 'csyconvf', 'complex'), ('dsyconvf', 'dsyconvf', 'real'), ('qsyconvf', 'qsyconvf', None), ('ssyconvf', 'ssyconvf', 'real'), ('wsyconvf', 'wsyconvf', None), ('xsyconvf', 'xsyconvf', None), ('ysyconvf', 'ysyconvf', None), ('zsyconvf', 'zsyconvf', 'complex')], &
    &  {'complex': '               pure subroutine {ri}syconvf(uplo,way,n,a,lda,e,ipiv,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,way\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    integer(ilp),intent(inout) :: ipiv(*)\n                    {rt},intent(inout) :: a(lda,*),e(*)\n               end subroutine {ri}syconvf', 'real': '               pure subroutine {ri}syconvf(uplo,way,n,a,lda,e,ipiv,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,way\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    integer(ilp),intent(inout) :: ipiv(*)\n                    {rt},intent(inout) :: a(lda,*),e(*)\n               end subroutine {ri}syconvf'}), &
    & ('syconvf_rook', ["If parameter WAY = 'C':", 'SYCONVF_ROOK: converts the factorization output format used in', 'CSYTRF_ROOK provided on entry in parameter A into the factorization', 'output format used in CSYTRF_RK (or CSYTRF_BK) that is stored', 'on exit in parameters A and E. IPIV format for CSYTRF_ROOK and', 'CSYTRF_RK (or CSYTRF_BK) is the same and is not converted.', "If parameter WAY = 'R':", 'SYCONVF_ROOK performs the conversion in reverse direction, i.e.', 'converts the factorization output format used in CSYTRF_RK', '(or CSYTRF_BK) provided on entry in parameters A and E into', 'the factorization output format used in CSYTRF_ROOK that is stored', 'on exit in parameter A. IPIV format for CSYTRF_ROOK and', 'CSYTRF_RK (or CSYTRF_BK) is the same and is not converted.', 'SYCONVF_ROOK can also convert in Hermitian matrix case, i.e. between', 'formats used in CHETRF_ROOK and CHETRF_RK (or CHETRF_BK).'], &
    &  [('csyconvf_rook', 'csyconvf_rook', 'complex'), ('dsyconvf_rook', 'dsyconvf_rook', 'real'), ('qsyconvf_rook', 'qsyconvf_rook', None), ('ssyconvf_rook', 'ssyconvf_rook', 'real'), ('wsyconvf_rook', 'wsyconvf_rook', None), ('xsyconvf_rook', 'xsyconvf_rook', None), ('ysyconvf_rook', 'ysyconvf_rook', None), ('zsyconvf_rook', 'zsyconvf_rook', 'complex')], &
    &  {'complex': '               pure subroutine {ri}syconvf_rook(uplo,way,n,a,lda,e,ipiv,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,way\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    {rt},intent(inout) :: a(lda,*),e(*)\n               end subroutine {ri}syconvf_rook', 'real': '               pure subroutine {ri}syconvf_rook(uplo,way,n,a,lda,e,ipiv,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo,way\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n,ipiv(*)\n                    {rt},intent(inout) :: a(lda,*),e(*)\n               end subroutine {ri}syconvf_rook'}), &
    & ('syequb', ['SYEQUB: computes row and column scalings intended to equilibrate a', 'symmetric matrix A (with respect to the Euclidean norm) and reduce', 'its condition number. The scale factors S are computed by the BIN', 'algorithm (see references) so that the scaled matrix B with elements', 'B(i,j) = S(i)*A(i,j)*S(j) has a condition number within a factor N of', 'the smallest possible condition number over all possible diagonal', 'scalings.'], &
    &  [('csyequb', 'csyequb', 'complex'), ('dsyequb', 'dsyequb', 'real'), ('qsyequb', 'qsyequb', None), ('ssyequb', 'ssyequb', 'real'), ('wsyequb', 'wsyequb', None), ('xsyequb', 'xsyequb', None), ('ysyequb', 'ysyequb', None), ('zsyequb', 'zsyequb', 'complex')], &
    &  {'complex': '               pure subroutine {ri}syequb(uplo,n,a,lda,s,scond,amax,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    real({rk}),intent(out) :: amax,scond,s(*)\n                    character,intent(in) :: uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}syequb', 'real': '               pure subroutine {ri}syequb(uplo,n,a,lda,s,scond,amax,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(out) :: amax,scond,s(*),work(*)\n                    character,intent(in) :: uplo\n                    {rt},intent(in) :: a(lda,*)\n               end subroutine {ri}syequb'}), &
    & ('syev', ['SYEV: computes all eigenvalues and, optionally, eigenvectors of a', 'real symmetric matrix A.'], &
    &  [('dsyev', 'dsyev', 'real'), ('qsyev', 'qsyev', None), ('ssyev', 'ssyev', 'real'), ('xsyev', 'xsyev', None)], &
    &  {'real': '               subroutine {ri}syev(jobz,uplo,n,a,lda,w,work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,lwork,n\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: w(*),work(*)\n               end subroutine {ri}syev'}), &
    & ('syevd', ['SYEVD: computes all eigenvalues and, optionally, eigenvectors of a', 'real symmetric matrix A. If eigenvectors are desired, it uses a', 'divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.', 'Because of large use of BLAS of level 3, SYEVD needs N**2 more', 'workspace than DSYEVX.'], &
    &  [('dsyevd', 'dsyevd', 'real'), ('qsyevd', 'qsyevd', None), ('ssyevd', 'ssyevd', 'real'), ('xsyevd', 'xsyevd', None)], &
    &  {'real': '               subroutine {ri}syevd(jobz,uplo,n,a,lda,w,work,lwork,iwork,liwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: lda,liwork,lwork,n\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: w(*),work(*)\n               end subroutine {ri}syevd'}), &
    & ('syevr', ['SYEVR: computes selected eigenvalues and, optionally, eigenvectors', 'of a real symmetric matrix A.  Eigenvalues and eigenvectors can be', 'selected by specifying either a range of values or a range of', 'indices for the desired eigenvalues.', 'SYEVR first reduces the matrix A to tridiagonal form T with a call', 'to DSYTRD.  Then, whenever possible, SYEVR calls DSTEMR to compute', 'the eigenspectrum using Relatively Robust Representations.  DSTEMR', 'computes eigenvalues by the dqds algorithm, while orthogonal', 'eigenvectors are computed from various "good" L D L^T representations', '(also known as Relatively Robust Representations). Gram-Schmidt', 'orthogonalization is avoided as far as possible. More specifically,', 'the various steps of the algorithm are as follows.', 'For each unreduced block (submatrix) of T,', '(a) Compute T - sigma I  = L D L^T, so that L and D', 'define all the wanted eigenvalues to high relative accuracy.', 'This means that small relative changes in the entries of D and L', 'cause only small relative changes in the eigenvalues and', 'eigenvectors. The standard (unfactored) representation of the', 'tridiagonal matrix T does not have this property in general.', '(b) Compute the eigenvalues to suitable accuracy.', 'If the eigenvectors are desired, the algorithm attains full', 'accuracy of the computed eigenvalues only right before', 'the corresponding vectors have to be computed, see steps c) and d).', '(c) For each cluster of close eigenvalues, select a new', 'shift close to the cluster, find a new factorization, and refine', 'the shifted eigenvalues to suitable accuracy.', '(d) For each eigenvalue with a large enough relative separation compute', 'the corresponding eigenvector by forming a rank revealing twisted', 'factorization. Go back to (c) for any clusters that remain.', 'The desired accuracy of the output can be specified by the input', 'parameter ABSTOL.', "For more details, see DSTEMR's documentation and:", '- Inderjit S. Dhillon and Beresford N. Parlett: "Multiple representations', 'to compute orthogonal eigenvectors of symmetric tridiagonal matrices,"', 'Linear Algebra and its Applications, 387(1), pp. 1-28, August 2004.', '- Inderjit Dhillon and Beresford Parlett: "Orthogonal Eigenvectors and', 'Relative Gaps," SIAM Journal on Matrix Analysis and Applications, Vol. 25,', '2004.  Also LAPACK Working Note 154.', '- Inderjit Dhillon: "A new O(n^2) algorithm for the symmetric', 'tridiagonal eigenvalue/eigenvector problem",', 'Computer Science Division Technical Report No. UCB/CSD-97-971,', 'UC Berkeley, May 1997.', 'Note 1 : SYEVR calls DSTEMR when the full spectrum is requested', 'on machines which conform to the ieee-754 floating point standard.', 'SYEVR calls DSTEBZ and DSTEIN on non-ieee machines and', 'when partial spectrum requests are made.', 'Normal execution of DSTEMR may create NaNs and infinities and', 'hence may abort due to a floating point exception in environments', 'which do not handle NaNs and infinities in the ieee standard default', 'manner.'], &
    &  [('dsyevr', 'dsyevr', 'real'), ('qsyevr', 'qsyevr', None), ('ssyevr', 'ssyevr', 'real'), ('xsyevr', 'xsyevr', None)], &
    &  {'real': '               subroutine {ri}syevr(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z, &\n                         ldz,isuppz,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,range,uplo\n                    integer(ilp),intent(in) :: il,iu,lda,ldz,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,isuppz(*),iwork(*)\n                    {rt},intent(in) :: abstol,vl,vu\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: w(*),work(*),z(ldz,*)\n               end subroutine {ri}syevr'}), &
    & ('sygst', ['SYGST: reduces a real symmetric-definite generalized eigenproblem', 'to standard form.', 'If ITYPE = 1, the problem is A*x = lambda*B*x,', 'and A is overwritten by inv(U**T)*A*inv(U) or inv(L)*A*inv(L**T)', 'If ITYPE = 2 or 3, the problem is A*B*x = lambda*x or', 'B*A*x = lambda*x, and A is overwritten by U*A*U**T or L**T*A*L.', 'B must have been previously factorized as U**T*U or L*L**T by DPOTRF.'], &
    &  [('dsygst', 'dsygst', 'real'), ('qsygst', 'qsygst', None), ('ssygst', 'ssygst', 'real'), ('xsygst', 'xsygst', None)], &
    &  {'real': '               pure subroutine {ri}sygst(itype,uplo,n,a,lda,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: itype,lda,ldb,n\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(in) :: b(ldb,*)\n               end subroutine {ri}sygst'}), &
    & ('sygv', ['SYGV: computes all the eigenvalues, and optionally, the eigenvectors', 'of a real generalized symmetric-definite eigenproblem, of the form', 'A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.', 'Here A and B are assumed to be symmetric and B is also', 'positive definite.'], &
    &  [('dsygv', 'dsygv', 'real'), ('qsygv', 'qsygv', None), ('ssygv', 'ssygv', 'real'), ('xsygv', 'xsygv', None)], &
    &  {'real': '               subroutine {ri}sygv(itype,jobz,uplo,n,a,lda,b,ldb,w,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: itype,lda,ldb,lwork,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: w(*),work(*)\n               end subroutine {ri}sygv'}), &
    & ('sygvd', ['SYGVD: computes all the eigenvalues, and optionally, the eigenvectors', 'of a real generalized symmetric-definite eigenproblem, of the form', 'A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and', 'B are assumed to be symmetric and B is also positive definite.', 'If eigenvectors are desired, it uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('dsygvd', 'dsygvd', 'real'), ('qsygvd', 'qsygvd', None), ('ssygvd', 'ssygvd', 'real'), ('xsygvd', 'xsygvd', None)], &
    &  {'real': '               subroutine {ri}sygvd(itype,jobz,uplo,n,a,lda,b,ldb,w,work,lwork,iwork, &\n                         liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: itype,lda,ldb,liwork,lwork,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: w(*),work(*)\n               end subroutine {ri}sygvd'}), &
    & ('symv', ['SYMV:  performs the matrix-vector  operation', 'y := alpha*A*x + beta*y,', 'where alpha and beta are scalars, x and y are n element vectors and', 'A is an n by n symmetric matrix.'], &
    &  [('csymv', 'csymv', 'complex'), ('wsymv', 'wsymv', None), ('ysymv', 'ysymv', None), ('zsymv', 'zsymv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}symv(uplo,n,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: incx,incy,lda,n\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}symv'}), &
    & ('syr', ['SYR:   performs the symmetric rank 1 operation', 'A := alpha*x*x**H + A,', 'where alpha is a complex scalar, x is an n element vector and A is an', 'n by n symmetric matrix.'], &
    &  [('csyr', 'csyr', 'complex'), ('wsyr', 'wsyr', None), ('ysyr', 'ysyr', None), ('zsyr', 'zsyr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}syr(uplo,n,alpha,x,incx,a,lda)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: incx,lda,n\n                    {rt},intent(in) :: alpha,x(*)\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}syr'}), &
    & ('syrfs', ['SYRFS: improves the computed solution to a system of linear', 'equations when the coefficient matrix is symmetric indefinite, and', 'provides error bounds and backward error estimates for the solution.'], &
    &  [('csyrfs', 'csyrfs', 'complex'), ('dsyrfs', 'dsyrfs', 'real'), ('qsyrfs', 'qsyrfs', None), ('ssyrfs', 'ssyrfs', 'real'), ('wsyrfs', 'wsyrfs', None), ('xsyrfs', 'xsyrfs', None), ('ysyrfs', 'ysyrfs', None), ('zsyrfs', 'zsyrfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}syrfs(uplo,n,nrhs,a,lda,af,ldaf,ipiv,b,ldb,x,ldx,ferr, &\n                          berr,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldaf,ldb,ldx,n,nrhs,ipiv(*)\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    {rt},intent(in) :: a(lda,*),af(ldaf,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}syrfs', 'real': '               pure subroutine {ri}syrfs(uplo,n,nrhs,a,lda,af,ldaf,ipiv,b,ldb,x,ldx,ferr, &\n                          berr,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: lda,ldaf,ldb,ldx,n,nrhs,ipiv(*)\n                    {rt},intent(in) :: a(lda,*),af(ldaf,*),b(ldb,*)\n                    {rt},intent(out) :: berr(*),ferr(*),work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}syrfs'}), &
    & ('sysv', ['SYSV: computes the solution to a complex system of linear equations', 'A * X = B,', 'where A is an N-by-N symmetric matrix and X and B are N-by-NRHS', 'matrices.', 'The diagonal pivoting method is used to factor A as', "A = U * D * U**T,  if UPLO = 'U', or", "A = L * D * L**T,  if UPLO = 'L',", 'where U (or L) is a product of permutation and unit upper (lower)', 'triangular matrices, and D is symmetric and block diagonal with', '1-by-1 and 2-by-2 diagonal blocks.  The factored form of A is then', 'used to solve the system of equations A * X = B.'], &
    &  [('csysv', 'csysv', 'complex'), ('dsysv', 'dsysv', 'real'), ('qsysv', 'qsysv', None), ('ssysv', 'ssysv', 'real'), ('wsysv', 'wsysv', None), ('xsysv', 'xsysv', None), ('ysysv', 'ysysv', None), ('zsysv', 'zsysv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sysv(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sysv', 'real': '               pure subroutine {ri}sysv(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sysv'}), &
    & ('sysv_aa', ['CSYSV computes the solution to a complex system of linear equations', 'A * X = B,', 'where A is an N-by-N symmetric matrix and X and B are N-by-NRHS', 'matrices.', "Aasen's algorithm is used to factor A as", "A = U**T * T * U,  if UPLO = 'U', or", "A = L * T * L**T,  if UPLO = 'L',", 'where U (or L) is a product of permutation and unit upper (lower)', 'triangular matrices, and T is symmetric tridiagonal. The factored', 'form of A is then used to solve the system of equations A * X = B.'], &
    &  [('csysv_aa', 'csysv_aa', 'complex'), ('dsysv_aa', 'dsysv_aa', 'real'), ('qsysv_aa', 'qsysv_aa', None), ('ssysv_aa', 'ssysv_aa', 'real'), ('wsysv_aa', 'wsysv_aa', None), ('xsysv_aa', 'xsysv_aa', None), ('ysysv_aa', 'ysysv_aa', None), ('zsysv_aa', 'zsysv_aa', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sysv_aa(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sysv_aa', 'real': '               pure subroutine {ri}sysv_aa(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sysv_aa'}), &
    & ('sysv_rk', ['SYSV_RK: computes the solution to a complex system of linear', 'equations A * X = B, where A is an N-by-N symmetric matrix', 'and X and B are N-by-NRHS matrices.', 'The bounded Bunch-Kaufman (rook) diagonal pivoting method is used', 'to factor A as', "A = P*U*D*(U**T)*(P**T),  if UPLO = 'U', or", "A = P*L*D*(L**T)*(P**T),  if UPLO = 'L',", 'where U (or L) is unit upper (or lower) triangular matrix,', 'U**T (or L**T) is the transpose of U (or L), P is a permutation', 'matrix, P**T is the transpose of P, and D is symmetric and block', 'diagonal with 1-by-1 and 2-by-2 diagonal blocks.', 'CSYTRF_RK is called to compute the factorization of a complex', 'symmetric matrix.  The factored form of A is then used to solve', 'the system of equations A * X = B by calling BLAS3 routine CSYTRS_3.'], &
    &  [('csysv_rk', 'csysv_rk', 'complex'), ('dsysv_rk', 'dsysv_rk', 'real'), ('qsysv_rk', 'qsysv_rk', None), ('ssysv_rk', 'ssysv_rk', 'real'), ('wsysv_rk', 'wsysv_rk', None), ('xsysv_rk', 'xsysv_rk', None), ('ysysv_rk', 'ysysv_rk', None), ('zsysv_rk', 'zsysv_rk', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sysv_rk(uplo,n,nrhs,a,lda,e,ipiv,b,ldb,work,lwork,info &\n                         )\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: e(*),work(*)\n               end subroutine {ri}sysv_rk', 'real': '               pure subroutine {ri}sysv_rk(uplo,n,nrhs,a,lda,e,ipiv,b,ldb,work,lwork,info &\n                         )\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: e(*),work(*)\n               end subroutine {ri}sysv_rk'}), &
    & ('sysv_rook', ['SYSV_ROOK: computes the solution to a complex system of linear', 'equations', 'A * X = B,', 'where A is an N-by-N symmetric matrix and X and B are N-by-NRHS', 'matrices.', 'The diagonal pivoting method is used to factor A as', "A = U * D * U**T,  if UPLO = 'U', or", "A = L * D * L**T,  if UPLO = 'L',", 'where U (or L) is a product of permutation and unit upper (lower)', 'triangular matrices, and D is symmetric and block diagonal with', '1-by-1 and 2-by-2 diagonal blocks.', 'CSYTRF_ROOK is called to compute the factorization of a complex', 'symmetric matrix A using the bounded Bunch-Kaufman ("rook") diagonal', 'pivoting method.', 'The factored form of A is then used to solve the system', 'of equations A * X = B by calling CSYTRS_ROOK.'], &
    &  [('csysv_rook', 'csysv_rook', 'complex'), ('dsysv_rook', 'dsysv_rook', 'real'), ('qsysv_rook', 'qsysv_rook', None), ('ssysv_rook', 'ssysv_rook', 'real'), ('wsysv_rook', 'wsysv_rook', None), ('xsysv_rook', 'xsysv_rook', None), ('ysysv_rook', 'ysysv_rook', None), ('zsysv_rook', 'zsysv_rook', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sysv_rook(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sysv_rook', 'real': '               pure subroutine {ri}sysv_rook(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldb,lwork,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sysv_rook'}), &
