     end subroutine la_${ri}$geequb
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETC2: computes an LU factorization, using complete pivoting, of the
     !> n-by-n matrix A. The factorization has the form A = P * L * U * Q,
     !> where P and Q are permutation matrices, L is lower triangular with
     !> unit diagonal elements and U is upper triangular.
     !> This is a level 1 BLAS version of the algorithm.

     pure subroutine la_${ri}$getc2(n,a,lda,ipiv,jpiv,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           integer(ilp),intent(out) :: ipiv(*),jpiv(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,ip,ipv,j,jp,jpv
           real(${rk}$) :: bignum,eps,smin,smlnum,xmax
           ! Intrinsic Functions
           intrinsic :: abs,cmplx,max
           ! Executable Statements
           info = 0
           ! quick return if possible
           if (n == 0) return
           ! set constants to control overflow
           eps = la_${ci}$lamch('P')
           smlnum = la_${ci}$lamch('S')/eps
           bignum = one/smlnum
           call la_${ci}$labad(smlnum,bignum)
           ! handle the case n=1 by itself
           if (n == 1) then
              ipiv(1) = 1
              jpiv(1) = 1
              if (abs(a(1,1)) < smlnum) then
                 info = 1
                 a(1,1) = cmplx(smlnum,zero,KIND=${rk}$)
              end if
              return
           end if
           ! factorize a using complete pivoting.
           ! set pivots less than smin to smin
           loop_40: do i = 1,n - 1
              ! find max element in matrix a
              xmax = zero
              do ip = i,n
                 do jp = i,n
                    if (abs(a(ip,jp)) >= xmax) then
                       xmax = abs(a(ip,jp))
                       ipv = ip
                       jpv = jp
                    end if
                 end do
              end do
              if (i == 1) smin = max(eps*xmax,smlnum)
              ! swap rows
              if (ipv /= i) call la_${ri}$swap(n,a(ipv,1),lda,a(i,1),lda)
              ipiv(i) = ipv
              ! swap columns
              if (jpv /= i) call la_${ri}$swap(n,a(1,jpv),1,a(1,i),1)
              jpiv(i) = jpv
              ! check for singularity
              if (abs(a(i,i)) < smin) then
                 info = i
                 a(i,i) = cmplx(smin,zero,KIND=${rk}$)
              end if
              do j = i + 1,n
                 a(j,i) = a(j,i)/a(i,i)
              end do
              call la_${ri}$geru(n - i,n - i,-cmplx(one,KIND=${rk}$),a(i + 1,i),1,a(i,i + 1),lda, &
                        a(i + 1,i + 1),lda)
           end do loop_40
           if (abs(a(n,n)) < smin) then
              info = n
              a(n,n) = cmplx(smin,zero,KIND=${rk}$)
           end if
           ! set last pivots to n
           ipiv(n) = n
           jpiv(n) = n
           return
     end subroutine la_${ri}$getc2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETF2: computes an LU factorization of a general m-by-n matrix A
     !> using partial pivoting with row interchanges.
     !> The factorization has the form
     !> A = P * L * U
     !> where P is a permutation matrix, L is lower triangular with unit
     !> diagonal elements (lower trapezoidal if m > n), and U is upper
     !> triangular (upper trapezoidal if m < n).
     !> This is the right-looking Level 2 BLAS version of the algorithm.

     pure subroutine la_${ri}$getf2(m,n,a,lda,ipiv,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           integer(ilp),intent(out) :: ipiv(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           real(${rk}$) :: sfmin
           integer(ilp) :: i,j,jp
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETF2',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) return
           ! compute machine safe minimum
           sfmin = la_${ci}$lamch('S')
           do j = 1,min(m,n)
              ! find pivot and test for singularity.
              jp = j - 1 + la_i${ri}$amax(m - j + 1,a(j,j),1)
              ipiv(j) = jp
              if (a(jp,j) /= czero) then
                 ! apply the interchange to columns 1:n.
                 if (jp /= j) call la_${ri}$swap(n,a(j,1),lda,a(jp,1),lda)
                 ! compute elements j+1:m of j-th column.
                 if (j < m) then
                    if (abs(a(j,j)) >= sfmin) then
                       call la_${ri}$scal(m - j,cone/a(j,j),a(j + 1,j),1)
                    else
                       do i = 1,m - j
                          a(j + i,j) = a(j + i,j)/a(j,j)
                       end do
                    end if
                 end if
              else if (info == 0) then
                 info = j
              end if
              if (j < min(m,n)) then
                 ! update trailing submatrix.
                 call la_${ri}$geru(m - j,n - j,-cone,a(j + 1,j),1,a(j,j + 1),lda,a(j + 1,j + 1 &
                           ),lda)
              end if
           end do
           return
     end subroutine la_${ri}$getf2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GTTRF: computes an LU factorization of a complex tridiagonal matrix A
     !> using elimination with partial pivoting and row interchanges.
     !> The factorization has the form
     !> A = L * U
     !> where L is a product of permutation and unit lower bidiagonal
     !> matrices and U is upper triangular with nonzeros in only the main
     !> diagonal and first two superdiagonals.

     pure subroutine la_${ri}$gttrf(n,dl,d,du,du2,ipiv,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           integer(ilp),intent(out) :: ipiv(*)
           complex(${rk}$),intent(inout) :: d(*),dl(*),du(*)
           complex(${rk}$),intent(out) :: du2(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i
           complex(${rk}$) :: fact,temp,zdum
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,real
#:else
           intrinsic :: abs,real,aimag
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           info = 0
           if (n < 0) then
              info = -1
              call la_xerbla('${ri.upper()}$GTTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! initialize ipiv(i) = i and du2(i) = 0
           do i = 1,n
              ipiv(i) = i
           end do
           do i = 1,n - 2
              du2(i) = zero
           end do
           do i = 1,n - 2
              if (cabs1(d(i)) >= cabs1(dl(i))) then
                 ! no row interchange required, eliminate dl(i)
                 if (cabs1(d(i)) /= zero) then
                    fact = dl(i)/d(i)
                    dl(i) = fact
                    d(i + 1) = d(i + 1) - fact*du(i)
                 end if
              else
                 ! interchange rows i and i+1, eliminate dl(i)
                 fact = d(i)/dl(i)
                 d(i) = dl(i)
                 dl(i) = fact
                 temp = du(i)
                 du(i) = d(i + 1)
                 d(i + 1) = temp - fact*d(i + 1)
                 du2(i) = du(i + 1)
                 du(i + 1) = -fact*du(i + 1)
                 ipiv(i) = i + 1
              end if
           end do
           if (n > 1) then
              i = n - 1
              if (cabs1(d(i)) >= cabs1(dl(i))) then
                 if (cabs1(d(i)) /= zero) then
                    fact = dl(i)/d(i)
                    dl(i) = fact
                    d(i + 1) = d(i + 1) - fact*du(i)
                 end if
              else
                 fact = d(i)/dl(i)
                 d(i) = dl(i)
                 dl(i) = fact
                 temp = du(i)
                 du(i) = d(i + 1)
                 d(i + 1) = temp - fact*d(i + 1)
                 ipiv(i) = i + 1
              end if
           end if
           ! check for a zero on the diagonal of u.
           do i = 1,n
              if (cabs1(d(i)) == zero) then
                 info = i
                 go to 50
              end if
           end do
           50 continue
           return
     end subroutine la_${ri}$gttrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GTTS2: solves one of the systems of equations
     !> A * X = B,  A**T * X = B,  or  A**H * X = B,
     !> with a tridiagonal matrix A using the LU factorization computed
     !> by ${ri.upper()}$GTTRF.

     pure subroutine la_${ri}$gtts2(itrans,n,nrhs,dl,d,du,du2,ipiv,b,ldb)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: itrans,ldb,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
           complex(${rk}$),intent(in) :: d(*),dl(*),du(*),du2(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,j
           complex(${rk}$) :: temp
           ! Intrinsic Functions
           intrinsic :: conjg
           ! Executable Statements
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (itrans == 0) then
              ! solve a*x = b using the lu factorization of a,
              ! overwriting each right hand side vector with its solution.
              if (nrhs <= 1) then
                 j = 1
                 10 continue
                 ! solve l*x = b.
                 do i = 1,n - 1
                    if (ipiv(i) == i) then
                       b(i + 1,j) = b(i + 1,j) - dl(i)*b(i,j)
                    else
                       temp = b(i,j)
                       b(i,j) = b(i + 1,j)
                       b(i + 1,j) = temp - dl(i)*b(i,j)
                    end if
                 end do
                 ! solve u*x = b.
                 b(n,j) = b(n,j)/d(n)
                 if (n > 1) b(n - 1,j) = (b(n - 1,j) - du(n - 1)*b(n,j))/d(n - 1)
                 do i = n - 2,1,-1
                    b(i,j) = (b(i,j) - du(i)*b(i + 1,j) - du2(i)*b(i + 2,j))/d(i)

                 end do
                 if (j < nrhs) then
                    j = j + 1
                    go to 10
                 end if
              else
                 do j = 1,nrhs
                 ! solve l*x = b.
                    do i = 1,n - 1
                       if (ipiv(i) == i) then
                          b(i + 1,j) = b(i + 1,j) - dl(i)*b(i,j)
                       else
                          temp = b(i,j)
                          b(i,j) = b(i + 1,j)
                          b(i + 1,j) = temp - dl(i)*b(i,j)
                       end if
                    end do
                 ! solve u*x = b.
                    b(n,j) = b(n,j)/d(n)
                    if (n > 1) b(n - 1,j) = (b(n - 1,j) - du(n - 1)*b(n,j))/d(n - 1)
                    do i = n - 2,1,-1
                       b(i,j) = (b(i,j) - du(i)*b(i + 1,j) - du2(i)*b(i + 2,j))/d(i)

                    end do
                 end do
              end if
           else if (itrans == 1) then
              ! solve a**t * x = b.
              if (nrhs <= 1) then
                 j = 1
                 70 continue
                 ! solve u**t * x = b.
                 b(1,j) = b(1,j)/d(1)
                 if (n > 1) b(2,j) = (b(2,j) - du(1)*b(1,j))/d(2)
                 do i = 3,n
                    b(i,j) = (b(i,j) - du(i - 1)*b(i - 1,j) - du2(i - 2)*b(i - 2,j))/d(i &
                              )
                 end do
                 ! solve l**t * x = b.
                 do i = n - 1,1,-1
                    if (ipiv(i) == i) then
                       b(i,j) = b(i,j) - dl(i)*b(i + 1,j)
                    else
                       temp = b(i + 1,j)
                       b(i + 1,j) = b(i,j) - dl(i)*temp
                       b(i,j) = temp
                    end if
                 end do
                 if (j < nrhs) then
                    j = j + 1
                    go to 70
                 end if
              else
                 do j = 1,nrhs
                 ! solve u**t * x = b.
                    b(1,j) = b(1,j)/d(1)
                    if (n > 1) b(2,j) = (b(2,j) - du(1)*b(1,j))/d(2)
                    do i = 3,n
                       b(i,j) = (b(i,j) - du(i - 1)*b(i - 1,j) - du2(i - 2)*b(i - 2,j))/d( &
                                  i)
                    end do
                 ! solve l**t * x = b.
                    do i = n - 1,1,-1
                       if (ipiv(i) == i) then
                          b(i,j) = b(i,j) - dl(i)*b(i + 1,j)
                       else
                          temp = b(i + 1,j)
                          b(i + 1,j) = b(i,j) - dl(i)*temp
                          b(i,j) = temp
                       end if
                    end do
                 end do
              end if
           else
              ! solve a**h * x = b.
              if (nrhs <= 1) then
                 j = 1
                 130 continue
                 ! solve u**h * x = b.
                 b(1,j) = b(1,j)/conjg(d(1))
                 if (n > 1) b(2,j) = (b(2,j) - conjg(du(1))*b(1,j))/conjg(d(2))

                 do i = 3,n
                    b(i,j) = (b(i,j) - conjg(du(i - 1))*b(i - 1,j) - conjg(du2(i - 2))*b( &
                              i - 2,j))/conjg(d(i))
                 end do
                 ! solve l**h * x = b.
                 do i = n - 1,1,-1
                    if (ipiv(i) == i) then
                       b(i,j) = b(i,j) - conjg(dl(i))*b(i + 1,j)
                    else
                       temp = b(i + 1,j)
                       b(i + 1,j) = b(i,j) - conjg(dl(i))*temp
                       b(i,j) = temp
                    end if
                 end do
                 if (j < nrhs) then
                    j = j + 1
                    go to 130
                 end if
              else
                 do j = 1,nrhs
                 ! solve u**h * x = b.
                    b(1,j) = b(1,j)/conjg(d(1))
                    if (n > 1) b(2,j) = (b(2,j) - conjg(du(1))*b(1,j))/conjg(d(2))

                    do i = 3,n
                       b(i,j) = (b(i,j) - conjg(du(i - 1))*b(i - 1,j) - conjg(du2(i - 2)) &
                                 *b(i - 2,j))/conjg(d(i))
                    end do
                 ! solve l**h * x = b.
                    do i = n - 1,1,-1
                       if (ipiv(i) == i) then
                          b(i,j) = b(i,j) - conjg(dl(i))*b(i + 1,j)
                       else
                          temp = b(i + 1,j)
                          b(i + 1,j) = b(i,j) - conjg(dl(i))*temp
                          b(i,j) = temp
                       end if
                    end do
                 end do
              end if
           end if
     end subroutine la_${ri}$gtts2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LA_GBRPVGRW: computes the reciprocal pivot growth factor
     !> norm(A)/norm(U). The "max absolute element" norm is used. If this is
     !> much less than 1, the stability of the LU factorization of the
     !> (equilibrated) matrix A could be poor. This also means that the
     !> solution X, estimated condition numbers, and error bounds could be
     !> unreliable.

     pure real(${rk}$) function la_${ri}$la_gbrpvgrw(n,kl,ku,ncols,ab,ldab,afb,ldafb)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: n,kl,ku,ncols,ldab,ldafb
           ! Array Arguments
           complex(${rk}$),intent(in) :: ab(ldab,*),afb(ldafb,*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,j,kd
           real(${rk}$) :: amax,umax,rpvgrw
           complex(${rk}$) :: zdum
           ! Intrinsic Functions
           intrinsic :: abs,max,min,real,aimag
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           rpvgrw = one
           kd = ku + 1
           do j = 1,ncols
              amax = zero
              umax = zero
              do i = max(j - ku,1),min(j + kl,n)
                 amax = max(cabs1(ab(kd + i - j,j)),amax)
              end do
              do i = max(j - ku,1),j
                 umax = max(cabs1(afb(kd + i - j,j)),umax)
              end do
#:if rk == "sp"
              if (umax /= 0.0_${rk}$) then
#:else
              if (umax /= zero) then
#:endif
                 rpvgrw = min(amax/umax,rpvgrw)
              end if
           end do
           la_${ri}$la_gbrpvgrw = rpvgrw
     end function la_${ri}$la_gbrpvgrw
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAQGB: equilibrates a general M by N band matrix A with KL
     !> subdiagonals and KU superdiagonals using the row and scaling factors
     !> in the vectors R and C.

     pure subroutine la_${ri}$laqgb(m,n,kl,ku,ab,ldab,r,c,rowcnd,colcnd,amax,equed)
        use la_constants_${rk}$

        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           integer(ilp),intent(in) :: kl,ku,ldab,m,n
           real(${rk}$),intent(in) :: amax,colcnd,rowcnd
           ! Array Arguments
           real(${rk}$),intent(in) :: c(*),r(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: cj,large,small
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! quick return if possible
           if (m <= 0 .or. n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ci}$lamch('SAFE MINIMUM')/la_${ci}$lamch('PRECISION')
           large = one/small
           if (rowcnd >= thresh .and. amax >= small .and. amax <= large) then
              ! no row scaling
              if (colcnd >= thresh) then
                 ! no column scaling
                 equed = 'N'
              else
                 ! column scaling
                 do j = 1,n
                    cj = c(j)
                    do i = max(1,j - ku),min(m,j + kl)
                       ab(ku + 1 + i - j,j) = cj*ab(ku + 1 + i - j,j)
                    end do
                 end do
                 equed = 'C'
              end if
           else if (colcnd >= thresh) then
              ! row scaling, no column scaling
              do j = 1,n
                 do i = max(1,j - ku),min(m,j + kl)
                    ab(ku + 1 + i - j,j) = r(i)*ab(ku + 1 + i - j,j)
                 end do
              end do
              equed = 'R'
           else
              ! row and column scaling
              do j = 1,n
                 cj = c(j)
                 do i = max(1,j - ku),min(m,j + kl)
                    ab(ku + 1 + i - j,j) = cj*r(i)*ab(ku + 1 + i - j,j)
                 end do
              end do
              equed = 'B'
           end if
           return
     end subroutine la_${ri}$laqgb
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAQGE: equilibrates a general M by N matrix A using the row and
     !> column scaling factors in the vectors R and C.

     pure subroutine la_${ri}$laqge(m,n,a,lda,r,c,rowcnd,colcnd,amax,equed)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           integer(ilp),intent(in) :: lda,m,n
           real(${rk}$),intent(in) :: amax,colcnd,rowcnd
           ! Array Arguments
           real(${rk}$),intent(in) :: c(*),r(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: cj,large,small
           ! Executable Statements
           ! quick return if possible
           if (m <= 0 .or. n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ci}$lamch('SAFE MINIMUM')/la_${ci}$lamch('PRECISION')
           large = one/small
           if (rowcnd >= thresh .and. amax >= small .and. amax <= large) then
              ! no row scaling
              if (colcnd >= thresh) then
                 ! no column scaling
                 equed = 'N'
              else
                 ! column scaling
                 do j = 1,n
                    cj = c(j)
                    do i = 1,m
                       a(i,j) = cj*a(i,j)
                    end do
                 end do
                 equed = 'C'
              end if
           else if (colcnd >= thresh) then
              ! row scaling, no column scaling
              do j = 1,n
                 do i = 1,m
                    a(i,j) = r(i)*a(i,j)
                 end do
              end do
              equed = 'R'
           else
              ! row and column scaling
              do j = 1,n
                 cj = c(j)
                 do i = 1,m
                    a(i,j) = cj*r(i)*a(i,j)
                 end do
              end do
              equed = 'B'
           end if
           return
     end subroutine la_${ri}$laqge
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LASWP: performs a series of row interchanges on the matrix A.
     !> One row interchange is initiated for each of rows K1 through K2 of A.

     pure subroutine la_${ri}$laswp(n,a,lda,k1,k2,ipiv,incx)
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx,k1,k2,lda,n
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
       ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,i1,i2,inc,ip,ix,ix0,j,k,n32
           complex(${rk}$) :: temp
           ! Executable Statements
           ! interchange row i with row ipiv(k1+(i-k1)*abs(incx)) for each of rows
           ! k1 through k2.
           if (incx > 0) then
              ix0 = k1
              i1 = k1
              i2 = k2
              inc = 1
           else if (incx < 0) then
              ix0 = k1 + (k1 - k2)*incx
              i1 = k2
              i2 = k1
              inc = -1
           else
              return
           end if
           n32 = (n/32)*32
           if (n32 /= 0) then
              do j = 1,n32,32
                 ix = ix0
                 do i = i1,i2,inc
                    ip = ipiv(ix)
                    if (ip /= i) then
                       do k = j,j + 31
                          temp = a(i,k)
                          a(i,k) = a(ip,k)
                          a(ip,k) = temp
                       end do
                    end if
                    ix = ix + incx
                 end do
              end do
           end if
           if (n32 /= n) then
              n32 = n32 + 1
              ix = ix0
              do i = i1,i2,inc
                 ip = ipiv(ix)
                 if (ip /= i) then
                    do k = n32,n
                       temp = a(i,k)
                       a(i,k) = a(ip,k)
                       a(ip,k) = temp
                    end do
                 end if
                 ix = ix + incx
              end do
           end if
           return
     end subroutine la_${ri}$laswp
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GBCON: estimates the reciprocal of the condition number of a complex
     !> general band matrix A, in either the 1-norm or the infinity-norm,
     !> using the LU factorization computed by ${ri.upper()}$GBTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as
     !> RCOND = 1 / ( norm(A) * norm(inv(A)) ).

     pure subroutine la_${ri}$gbcon(norm,n,kl,ku,ab,ldab,ipiv,anorm,rcond,work,rwork, &
               info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: norm
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kl,ku,ldab,n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(in) :: ab(ldab,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lnoti,onenrm
           character :: normin
           integer(ilp) :: ix,j,jp,kase,kase1,kd,lm
           real(${rk}$) :: ainvnm,scale,smlnum
           complex(${rk}$) :: t,zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,min,real
#:else
           intrinsic :: abs,real,aimag,min
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           onenrm = norm == '1' .or. la_lsame(norm,'O')
           if (.not. onenrm .and. .not. la_lsame(norm,'I')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kl < 0) then
              info = -3
           else if (ku < 0) then
              info = -4
           else if (ldab < 2*kl + ku + 1) then
              info = -6
           else if (anorm < zero) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GBCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ci}$lamch('SAFE MINIMUM')
           ! estimate the norm of inv(a).
           ainvnm = zero
           normin = 'N'
           if (onenrm) then
              kase1 = 1
           else
              kase1 = 2
           end if
           kd = kl + ku + 1
           lnoti = kl > 0
           kase = 0
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,ainvnm,kase,isave)
           if (kase /= 0) then
              if (kase == kase1) then
                 ! multiply by inv(l).
                 if (lnoti) then
                    do j = 1,n - 1
                       lm = min(kl,n - j)
                       jp = ipiv(j)
                       t = work(jp)
                       if (jp /= j) then
                          work(jp) = work(j)
                          work(j) = t
                       end if
                       call la_${ri}$axpy(lm,-t,ab(kd + 1,j),1,work(j + 1),1)
                    end do
                 end if
                 ! multiply by inv(u).
                 call la_${ri}$latbs('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,kl + ku,ab, &
                           ldab,work,scale,rwork,info)
              else
                 ! multiply by inv(u**h).
                 call la_${ri}$latbs('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,kl + ku, &
                           ab,ldab,work,scale,rwork,info)
                 ! multiply by inv(l**h).
                 if (lnoti) then
                    do j = n - 1,1,-1
                       lm = min(kl,n - j)
                       work(j) = work(j) - la_${ri}$dotc(lm,ab(kd + 1,j),1,work(j + 1),1)

                       jp = ipiv(j)
                       if (jp /= j) then
                          t = work(jp)
                          work(jp) = work(j)
                          work(j) = t
                       end if
                    end do
                 end if
              end if
              ! divide x by 1/scale if doing so will not cause overflow.
              normin = 'Y'
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < cabs1(work(ix))*smlnum .or. scale == zero) go to 40
                 call la_${ri}$${ci}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           40 continue
           return
     end subroutine la_${ri}$gbcon
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GBTRF: computes an LU factorization of a complex m-by-n band matrix A
     !> using partial pivoting with row interchanges.
     !> This is the blocked version of the algorithm, calling Level 3 BLAS.

     pure subroutine la_${ri}$gbtrf(m,n,kl,ku,ab,ldab,ipiv,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kl,ku,ldab,m,n
           ! Array Arguments
           integer(ilp),intent(out) :: ipiv(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 64
           integer(ilp),parameter :: ldwork = nbmax + 1

           ! Local Scalars
           integer(ilp) :: i,i2,i3,ii,ip,j,j2,j3,jb,jj,jm,jp,ju,k2,km,kv,nb, &
                     nw
           complex(${rk}$) :: temp
           ! Local Arrays
           complex(${rk}$) :: work13(ldwork,nbmax),work31(ldwork,nbmax)
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! kv is the number of superdiagonals in the factor u, allowing for
           ! fill-in
           kv = ku + kl
           ! test the input parameters.
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kl < 0) then
              info = -3
           else if (ku < 0) then
              info = -4
           else if (ldab < kl + kv + 1) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GBTRF',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) return
           ! determine the block size for this environment
           nb = la_ilaenv(1,'${ri.upper()}$GBTRF',' ',m,n,kl,ku)
           ! the block size must not exceed the limit set by the size of the
           ! local arrays work13 and work31.
           nb = min(nb,nbmax)
           if (nb <= 1 .or. nb > kl) then
              ! use unblocked code
              call la_${ri}$gbtf2(m,n,kl,ku,ab,ldab,ipiv,info)
           else
              ! use blocked code
              ! czero the superdiagonal elements of the work array work13
              do j = 1,nb
                 do i = 1,j - 1
                    work13(i,j) = czero
                 end do
              end do
              ! czero the subdiagonal elements of the work array work31
              do j = 1,nb
                 do i = j + 1,nb
                    work31(i,j) = czero
                 end do
              end do
              ! gaussian elimination with partial pivoting
              ! set fill-in elements in columns ku+2 to kv to czero
              do j = ku + 2,min(kv,n)
                 do i = kv - j + 2,kl
                    ab(i,j) = czero
                 end do
              end do
              ! ju is the index of the last column affected by the current
              ! stage of the factorization
              ju = 1
              loop_180: do j = 1,min(m,n),nb
                 jb = min(nb,min(m,n) - j + 1)
                 ! the active part of the matrix is partitioned
                    ! a11   a12   a13
                    ! a21   a22   a23
                    ! a31   a32   a33
                 ! here a11, a21 and a31 denote the current block of jb columns
                 ! which is about to be factorized. the number of rows in the
                 ! partitioning are jb, i2, i3 respectively, and the numbers
                 ! of columns are jb, j2, j3. the superdiagonal elements of a13
                 ! and the subdiagonal elements of a31 lie outside the band.
                 i2 = min(kl - jb,m - j - jb + 1)
                 i3 = min(jb,m - j - kl + 1)
                 ! j2 and j3 are computed after ju has been updated.
                 ! factorize the current block of jb columns
                 loop_80: do jj = j,j + jb - 1
                    ! set fill-in elements in column jj+kv to czero
                    if (jj + kv <= n) then
                       do i = 1,kl
                          ab(i,jj + kv) = czero
                       end do
                    end if
                    ! find pivot and test for singularity. km is the number of
                    ! subdiagonal elements in the current column.
                    km = min(kl,m - jj)
                    jp = la_i${ri}$amax(km + 1,ab(kv + 1,jj),1)
                    ipiv(jj) = jp + jj - j
                    if (ab(kv + jp,jj) /= czero) then
                       ju = max(ju,min(jj + ku + jp - 1,n))
                       if (jp /= 1) then
                          ! apply interchange to columns j to j+jb-1
                          if (jp + jj - 1 < j + kl) then
                             call la_${ri}$swap(jb,ab(kv + 1 + jj - j,j),ldab - 1,ab(kv + jp + jj - j,j) &
                                       ,ldab - 1)
                          else
                             ! the interchange affects columns j to jj-1 of a31
                             ! which are stored in the work array work31
                             call la_${ri}$swap(jj - j,ab(kv + 1 + jj - j,j),ldab - 1,work31(jp + jj - j - &
                                       kl,1),ldwork)
                             call la_${ri}$swap(j + jb - jj,ab(kv + 1,jj),ldab - 1,ab(kv + jp,jj), &
                                       ldab - 1)
                          end if
                       end if
                       ! compute multipliers
                       call la_${ri}$scal(km,cone/ab(kv + 1,jj),ab(kv + 2,jj),1)
                       ! update trailing submatrix within the band and within
                       ! the current block. jm is the index of the last column
                       ! which needs to be updated.
                       jm = min(ju,j + jb - 1)
                       if (jm > jj) call la_${ri}$geru(km,jm - jj,-cone,ab(kv + 2,jj),1,ab(kv, &
                                 jj + 1),ldab - 1,ab(kv + 1,jj + 1),ldab - 1)
                    else
                       ! if pivot is czero, set info to the index of the pivot
                       ! unless a czero pivot has already been found.
                       if (info == 0) info = jj
                    end if
                    ! copy current column of a31 into the work array work31
                    nw = min(jj - j + 1,i3)
                    if (nw > 0) call la_${ri}$copy(nw,ab(kv + kl + 1 - jj + j,jj),1,work31(1,jj - j + 1) &
                              ,1)
                 end do loop_80
                 if (j + jb <= n) then
                    ! apply the row interchanges to the other blocks.
                    j2 = min(ju - j + 1,kv) - jb
                    j3 = max(0,ju - j - kv + 1)
                    ! use la_${ri}$laswp to apply the row interchanges to a12, a22, and
                    ! a32.
                    call la_${ri}$laswp(j2,ab(kv + 1 - jb,j + jb),ldab - 1,1,jb,ipiv(j),1)

                    ! adjust the pivot indices.
                    do i = j,j + jb - 1
                       ipiv(i) = ipiv(i) + j - 1
                    end do
                    ! apply the row interchanges to a13, a23, and a33
                    ! columnwise.
                    k2 = j - 1 + jb + j2
                    do i = 1,j3
                       jj = k2 + i
                       do ii = j + i - 1,j + jb - 1
                          ip = ipiv(ii)
                          if (ip /= ii) then
                             temp = ab(kv + 1 + ii - jj,jj)
                             ab(kv + 1 + ii - jj,jj) = ab(kv + 1 + ip - jj,jj)
                             ab(kv + 1 + ip - jj,jj) = temp
                          end if
                       end do
                    end do
                    ! update the relevant part of the trailing submatrix
                    if (j2 > 0) then
                       ! update a12
                       call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','UNIT',jb,j2,cone, &
                                 ab(kv + 1,j),ldab - 1,ab(kv + 1 - jb,j + jb),ldab - 1)
                       if (i2 > 0) then
                          ! update a22
                          call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',i2,j2,jb,-cone,ab( &
                           kv + 1 + jb,j),ldab - 1,ab(kv + 1 - jb,j + jb),ldab - 1,cone,ab(kv + 1,j + jb) &
                                     ,ldab - 1)
                       end if
                       if (i3 > 0) then
                          ! update a32
                          call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',i3,j2,jb,-cone, &
                          work31,ldwork,ab(kv + 1 - jb,j + jb),ldab - 1,cone,ab(kv + kl + 1 - jb,j + jb), &
                                     ldab - 1)
                       end if
                    end if
                    if (j3 > 0) then
                       ! copy the lower triangle of a13 into the work array
                       ! work13
                       do jj = 1,j3
                          do ii = jj,jb
                             work13(ii,jj) = ab(ii - jj + 1,jj + j + kv - 1)
                          end do
                       end do
                       ! update a13 in the work array
                       call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','UNIT',jb,j3,cone, &
                                 ab(kv + 1,j),ldab - 1,work13,ldwork)
                       if (i2 > 0) then
                          ! update a23
                          call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',i2,j3,jb,-cone,ab( &
                           kv + 1 + jb,j),ldab - 1,work13,ldwork,cone,ab(1 + jb,j + kv),ldab - 1)

                       end if
                       if (i3 > 0) then
                          ! update a33
                          call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',i3,j3,jb,-cone, &
                                    work31,ldwork,work13,ldwork,cone,ab(1 + kl,j + kv),ldab - 1)
                       end if
                       ! copy the lower triangle of a13 back into place
                       do jj = 1,j3
                          do ii = jj,jb
                             ab(ii - jj + 1,jj + j + kv - 1) = work13(ii,jj)
                          end do
                       end do
                    end if
                 else
                    ! adjust the pivot indices.
                    do i = j,j + jb - 1
                       ipiv(i) = ipiv(i) + j - 1
                    end do
                 end if
                 ! partially undo the interchanges in the current block to
                 ! restore the upper triangular form of a31 and copy the upper
                 ! triangle of a31 back into place
                 do jj = j + jb - 1,j,-1
                    jp = ipiv(jj) - jj + 1
                    if (jp /= 1) then
                       ! apply interchange to columns j to jj-1
                       if (jp + jj - 1 < j + kl) then
                          ! the interchange does not affect a31
                          call la_${ri}$swap(jj - j,ab(kv + 1 + jj - j,j),ldab - 1,ab(kv + jp + jj - j,j), &
                                     ldab - 1)
                       else
                          ! the interchange does affect a31
                          call la_${ri}$swap(jj - j,ab(kv + 1 + jj - j,j),ldab - 1,work31(jp + jj - j - kl, &
                                    1),ldwork)
                       end if
                    end if
                    ! copy the current column of a31 back into place
                    nw = min(i3,jj - j + 1)
                    if (nw > 0) call la_${ri}$copy(nw,work31(1,jj - j + 1),1,ab(kv + kl + 1 - jj + j,jj) &
                              ,1)
                 end do
              end do loop_180
           end if
           return
     end subroutine la_${ri}$gbtrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GBTRS: solves a system of linear equations
     !> A * X = B,  A**T * X = B,  or  A**H * X = B
     !> with a general band matrix A using the LU factorization computed
     !> by ${ri.upper()}$GBTRF.

     pure subroutine la_${ri}$gbtrs(trans,n,kl,ku,nrhs,ab,ldab,ipiv,b,ldb,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kl,ku,ldab,ldb,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(in) :: ab(ldab,*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lnoti,notran
           integer(ilp) :: i,j,kd,l,lm
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           notran = la_lsame(trans,'N')
           if (.not. notran .and. .not. la_lsame(trans,'T') .and. .not. la_lsame(trans, &
                     'C')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kl < 0) then
              info = -3
           else if (ku < 0) then
              info = -4
           else if (nrhs < 0) then
              info = -5
           else if (ldab < (2*kl + ku + 1)) then
              info = -7
           else if (ldb < max(1,n)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GBTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           kd = ku + kl + 1
           lnoti = kl > 0
           if (notran) then
              ! solve  a*x = b.
              ! solve l*x = b, overwriting b with x.
              ! l is represented as a product of permutations and unit lower
              ! triangular matrices l = p(1) * l(1) * ... * p(n-1) * l(n-1),
              ! where each transformation l(i) is a rank-cone modification of
              ! the identity matrix.
              if (lnoti) then
                 do j = 1,n - 1
                    lm = min(kl,n - j)
                    l = ipiv(j)
                    if (l /= j) call la_${ri}$swap(nrhs,b(l,1),ldb,b(j,1),ldb)
                    call la_${ri}$geru(lm,nrhs,-cone,ab(kd + 1,j),1,b(j,1),ldb,b(j + 1, &
                              1),ldb)
                 end do
              end if
              do i = 1,nrhs
                 ! solve u*x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','NO TRANSPOSE','NON-UNIT',n,kl + ku,ab,ldab,b(1, &
                           i),1)
              end do
           else if (la_lsame(trans,'T')) then
              ! solve a**t * x = b.
              do i = 1,nrhs
                 ! solve u**t * x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','TRANSPOSE','NON-UNIT',n,kl + ku,ab,ldab,b(1,i) &
                           ,1)
              end do
              ! solve l**t * x = b, overwriting b with x.
              if (lnoti) then
                 do j = n - 1,1,-1
                    lm = min(kl,n - j)
                    call la_${ri}$gemv('TRANSPOSE',lm,nrhs,-cone,b(j + 1,1),ldb,ab(kd + 1,j &
                              ),1,cone,b(j,1),ldb)
                    l = ipiv(j)
                    if (l /= j) call la_${ri}$swap(nrhs,b(l,1),ldb,b(j,1),ldb)
                 end do
              end if
           else
              ! solve a**h * x = b.
              do i = 1,nrhs
                 ! solve u**h * x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',n,kl + ku,ab,ldab, &
                            b(1,i),1)
              end do
              ! solve l**h * x = b, overwriting b with x.
              if (lnoti) then
                 do j = n - 1,1,-1
                    lm = min(kl,n - j)
                    call la_${ri}$lacgv(nrhs,b(j,1),ldb)
                    call la_${ri}$gemv('CONJUGATE TRANSPOSE',lm,nrhs,-cone,b(j + 1,1),ldb, &
                              ab(kd + 1,j),1,cone,b(j,1),ldb)
                    call la_${ri}$lacgv(nrhs,b(j,1),ldb)
                    l = ipiv(j)
                    if (l /= j) call la_${ri}$swap(nrhs,b(l,1),ldb,b(j,1),ldb)
                 end do
              end if
           end if
           return
     end subroutine la_${ri}$gbtrs
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GECON: estimates the reciprocal of the condition number of a general
     !> complex matrix A, in either the 1-norm or the infinity-norm, using
     !> the LU factorization computed by ${ri.upper()}$GETRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as
     !> RCOND = 1 / ( norm(A) * norm(inv(A)) ).

     pure subroutine la_${ri}$gecon(norm,n,a,lda,anorm,rcond,work,rwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: norm
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: onenrm
           character :: normin
           integer(ilp) :: ix,kase,kase1
           real(${rk}$) :: ainvnm,scale,sl,smlnum,su
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,real
#:else
           intrinsic :: abs,real,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           onenrm = norm == '1' .or. la_lsame(norm,'O')
           if (.not. onenrm .and. .not. la_lsame(norm,'I')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (anorm < zero) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GECON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ci}$lamch('SAFE MINIMUM')
           ! estimate the norm of inv(a).
           ainvnm = zero
           normin = 'N'
           if (onenrm) then
              kase1 = 1
           else
              kase1 = 2
           end if
           kase = 0
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,ainvnm,kase,isave)
           if (kase /= 0) then
              if (kase == kase1) then
                 ! multiply by inv(l).
                 call la_${ri}$latrs('LOWER','NO TRANSPOSE','UNIT',normin,n,a,lda,work,sl, &
                           rwork,info)
                 ! multiply by inv(u).
                 call la_${ri}$latrs('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           su,rwork(n + 1),info)
              else
                 ! multiply by inv(u**h).
                 call la_${ri}$latrs('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,a,lda, &
                            work,su,rwork(n + 1),info)
                 ! multiply by inv(l**h).
                 call la_${ri}$latrs('LOWER','CONJUGATE TRANSPOSE','UNIT',normin,n,a,lda, &
                           work,sl,rwork,info)
              end if
              ! divide x by 1/(sl*su) if doing so will not cause overflow.
              scale = sl*su
              normin = 'Y'
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < cabs1(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$${ci}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$gecon
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GESC2: solves a system of linear equations
     !> A * X = scale* RHS
     !> with a general N-by-N matrix A using the LU factorization with
     !> complete pivoting computed by ${ri.upper()}$GETC2.

     pure subroutine la_${ri}$gesc2(n,a,lda,rhs,ipiv,jpiv,scale)
        use la_constants_${rk}$,only:zero,one,two
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(out) :: scale
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*),jpiv(*)
           complex(${rk}$),intent(in) :: a(lda,*)
           complex(${rk}$),intent(inout) :: rhs(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: bignum,eps,smlnum
           complex(${rk}$) :: temp
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,cmplx,real
#:else
           intrinsic :: abs,real,cmplx
#:endif
           ! Executable Statements
           ! set constant to control overflow
           eps = la_${ci}$lamch('P')
           smlnum = la_${ci}$lamch('S')/eps
           bignum = one/smlnum
           call la_${ci}$labad(smlnum,bignum)
           ! apply permutations ipiv to rhs
           call la_${ri}$laswp(1,rhs,lda,1,n - 1,ipiv,1)
           ! solve for l part
           do i = 1,n - 1
              do j = i + 1,n
                 rhs(j) = rhs(j) - a(j,i)*rhs(i)
              end do
           end do
           ! solve for u part
           scale = one
           ! check for scaling
           i = la_i${ri}$amax(n,rhs,1)
           if (two*smlnum*abs(rhs(i)) > abs(a(n,n))) then
              temp = cmplx(one/two,zero,KIND=${rk}$)/abs(rhs(i))
              call la_${ri}$scal(n,temp,rhs(1),1)
              scale = scale*real(temp,KIND=${rk}$)
           end if
           do i = n,1,-1
              temp = cmplx(one,zero,KIND=${rk}$)/a(i,i)
              rhs(i) = rhs(i)*temp
              do j = i + 1,n
                 rhs(i) = rhs(i) - rhs(j)*(a(i,j)*temp)
              end do
           end do
           ! apply permutations jpiv to the solution (rhs)
           call la_${ri}$laswp(1,rhs,lda,1,n - 1,jpiv,-1)
           return
     end subroutine la_${ri}$gesc2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETRF2: computes an LU factorization of a general M-by-N matrix A
     !> using partial pivoting with row interchanges.
     !> The factorization has the form
     !> A = P * L * U
     !> where P is a permutation matrix, L is lower triangular with unit
     !> diagonal elements (lower trapezoidal if m > n), and U is upper
     !> triangular (upper trapezoidal if m < n).
     !> This is the recursive version of the algorithm. It divides
     !> the matrix into four submatrices:
     !> [  A11 | A12  ]  where A11 is n1 by n1 and A22 is n2 by n2
     !> A = [ -----|----- ]  with n1 = min(m,n)/2
     !> [  A21 | A22  ]       n2 = n-n1
     !> [ A11 ]
     !> The subroutine calls itself to factor [ --- ],
     !> [ A12 ]
     !> [ A12 ]
     !> do the swaps on [ --- ], solve A12, update A22,
     !> [ A22 ]
     !> then calls itself to factor A22 and do the swaps on A21.

     pure recursive subroutine la_${ri}$getrf2(m,n,a,lda,ipiv,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           integer(ilp),intent(out) :: ipiv(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           real(${rk}$) :: sfmin
           complex(${rk}$) :: temp
           integer(ilp) :: i,iinfo,n1,n2
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETRF2',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) return
           if (m == 1) then
              ! use unblocked code for cone row case
              ! just need to handle ipiv and info
              ipiv(1) = 1
              if (a(1,1) == czero) info = 1
           else if (n == 1) then
              ! use unblocked code for cone column case
              ! compute machine safe minimum
              sfmin = la_${ci}$lamch('S')
              ! find pivot and test for singularity
              i = la_i${ri}$amax(m,a(1,1),1)
              ipiv(1) = i
              if (a(i,1) /= czero) then
                 ! apply the interchange
                 if (i /= 1) then
                    temp = a(1,1)
                    a(1,1) = a(i,1)
                    a(i,1) = temp
                 end if
                 ! compute elements 2:m of the column
                 if (abs(a(1,1)) >= sfmin) then
                    call la_${ri}$scal(m - 1,cone/a(1,1),a(2,1),1)
                 else
                    do i = 1,m - 1
                       a(1 + i,1) = a(1 + i,1)/a(1,1)
                    end do
                 end if
              else
                 info = 1
              end if
           else
              ! use recursive code
              n1 = min(m,n)/2
              n2 = n - n1
                     ! [ a11 ]
              ! factor [ --- ]
                     ! [ a21 ]
              call la_${ri}$getrf2(m,n1,a,lda,ipiv,iinfo)
              if (info == 0 .and. iinfo > 0) info = iinfo
                                    ! [ a12 ]
              ! apply interchanges to [ --- ]
                                    ! [ a22 ]
              call la_${ri}$laswp(n2,a(1,n1 + 1),lda,1,n1,ipiv,1)
              ! solve a12
              call la_${ri}$trsm('L','L','N','U',n1,n2,cone,a,lda,a(1,n1 + 1),lda)

              ! update a22
              call la_${ri}$gemm('N','N',m - n1,n2,n1,-cone,a(n1 + 1,1),lda,a(1,n1 + 1), &
                        lda,cone,a(n1 + 1,n1 + 1),lda)
              ! factor a22
              call la_${ri}$getrf2(m - n1,n2,a(n1 + 1,n1 + 1),lda,ipiv(n1 + 1),iinfo)
              ! adjust info and the pivot indices
              if (info == 0 .and. iinfo > 0) info = iinfo + n1
              do i = n1 + 1,min(m,n)
                 ipiv(i) = ipiv(i) + n1
              end do
              ! apply interchanges to a21
              call la_${ri}$laswp(n1,a(1,1),lda,n1 + 1,min(m,n),ipiv,1)
           end if
           return
     end subroutine la_${ri}$getrf2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETRI: computes the inverse of a matrix using the LU factorization
     !> computed by ${ri.upper()}$GETRF.
     !> This method inverts U and then computes inv(A) by solving the system
     !> inv(A)*L = inv(U) for inv(A).

     pure subroutine la_${ri}$getri(n,a,lda,ipiv,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,iws,j,jb,jj,jp,ldwork,lwkopt,nb,nbmin,nn
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$GETRI',' ',n,-1,-1,-1)
           lwkopt = n*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (n < 0) then
              info = -1
           else if (lda < max(1,n)) then
              info = -3
           else if (lwork < max(1,n) .and. .not. lquery) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETRI',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form inv(u).  if info > 0 from la_${ri}$trtri, then u is singular,
           ! and the inverse is not computed.
           call la_${ri}$trtri('UPPER','NON-UNIT',n,a,lda,info)
           if (info > 0) return
           nbmin = 2
           ldwork = n
           if (nb > 1 .and. nb < n) then
              iws = max(ldwork*nb,1)
              if (lwork < iws) then
                 nb = lwork/ldwork
                 nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GETRI',' ',n,-1,-1,-1))
              end if
           else
              iws = n
           end if
           ! solve the equation inv(a)*l = inv(u) for inv(a).
           if (nb < nbmin .or. nb >= n) then
              ! use unblocked code.
              do j = n,1,-1
                 ! copy current column of l to work and replace with zeros.
                 do i = j + 1,n
                    work(i) = a(i,j)
                    a(i,j) = czero
                 end do
                 ! compute current column of inv(a).
                 if (j < n) call la_${ri}$gemv('NO TRANSPOSE',n,n - j,-cone,a(1,j + 1),lda,work( &
                            j + 1),1,cone,a(1,j),1)
              end do
           else
              ! use blocked code.
              nn = ((n - 1)/nb)*nb + 1
              do j = nn,1,-nb
                 jb = min(nb,n - j + 1)
                 ! copy current block column of l to work and replace with
                 ! zeros.
                 do jj = j,j + jb - 1
                    do i = jj + 1,n
                       work(i + (jj - j)*ldwork) = a(i,jj)
                       a(i,jj) = czero
                    end do
                 end do
                 ! compute current block column of inv(a).
                 if (j + jb <= n) call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',n,jb,n - j - jb + 1,- &
                           cone,a(1,j + jb),lda,work(j + jb),ldwork,cone,a(1,j),lda)
                 call la_${ri}$trsm('RIGHT','LOWER','NO TRANSPOSE','UNIT',n,jb,cone,work(j &
                           ),ldwork,a(1,j),lda)
              end do
           end if
           ! apply column interchanges.
           do j = n - 1,1,-1
              jp = ipiv(j)
              if (jp /= j) call la_${ri}$swap(n,a(1,j),1,a(1,jp),1)
           end do
           work(1) = iws
           return
     end subroutine la_${ri}$getri
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETRS: solves a system of linear equations
     !> A * X = B,  A**T * X = B,  or  A**H * X = B
     !> with a general N-by-N matrix A using the LU factorization computed
     !> by ${ri.upper()}$GETRF.

     pure subroutine la_${ri}$getrs(trans,n,nrhs,a,lda,ipiv,b,ldb,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(in) :: a(lda,*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: notran
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           notran = la_lsame(trans,'N')
           if (.not. notran .and. .not. la_lsame(trans,'T') .and. .not. la_lsame(trans, &
                     'C')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (notran) then
              ! solve a * x = b.
              ! apply row interchanges to the right hand sides.
              call la_${ri}$laswp(nrhs,b,ldb,1,n,ipiv,1)
              ! solve l*x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','UNIT',n,nrhs,cone,a,lda,b, &
                         ldb)
              ! solve u*x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','UPPER','NO TRANSPOSE','NON-UNIT',n,nrhs,cone,a, &
                        lda,b,ldb)
           else
              ! solve a**t * x = b  or a**h * x = b.
              ! solve u**t *x = b or u**h *x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','UPPER',trans,'NON-UNIT',n,nrhs,cone,a,lda,b,ldb &
                        )
              ! solve l**t *x = b, or l**h *x = b overwriting b with x.
              call la_${ri}$trsm('LEFT','LOWER',trans,'UNIT',n,nrhs,cone,a,lda,b,ldb)

              ! apply row interchanges to the solution vectors.
              call la_${ri}$laswp(nrhs,b,ldb,1,n,ipiv,-1)
           end if
           return
     end subroutine la_${ri}$getrs
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GTTRS: solves one of the systems of equations
     !> A * X = B,  A**T * X = B,  or  A**H * X = B,
     !> with a tridiagonal matrix A using the LU factorization computed
     !> by ${ri.upper()}$GTTRF.

     pure subroutine la_${ri}$gttrs(trans,n,nrhs,dl,d,du,du2,ipiv,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
           complex(${rk}$),intent(in) :: d(*),dl(*),du(*),du2(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: notran
           integer(ilp) :: itrans,j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           info = 0
           notran = (trans == 'N' .or. trans == 'N')
           if (.not. notran .and. .not. (trans == 'T' .or. trans == 'T') .and. .not. (trans == 'C' .or. &
                     trans == 'C')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(n,1)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GTTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           ! decode trans
           if (notran) then
              itrans = 0
           else if (trans == 'T' .or. trans == 'T') then
              itrans = 1
           else
              itrans = 2
           end if
           ! determine the number of right-hand sides to solve at a time.
           if (nrhs == 1) then
              nb = 1
           else
              nb = max(1,la_ilaenv(1,'${ri.upper()}$GTTRS',trans,n,nrhs,-1,-1))
           end if
           if (nb >= nrhs) then
              call la_${ri}$gtts2(itrans,n,nrhs,dl,d,du,du2,ipiv,b,ldb)
           else
              do j = 1,nrhs,nb
                 jb = min(nrhs - j + 1,nb)
                 call la_${ri}$gtts2(itrans,n,jb,dl,d,du,du2,ipiv,b(1,j),ldb)
              end do
           end if
     end subroutine la_${ri}$gttrs
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LATDF: computes the contribution to the reciprocal Dif-estimate
     !> by solving for x in Z * x = b, where b is chosen such that the norm
     !> of x is as large as possible. It is assumed that LU decomposition
     !> of Z has been computed by ${ri.upper()}$GETC2. On entry RHS = f holds the
     !> contribution from earlier solved sub-systems, and on return RHS = x.
     !> The factorization of Z returned by ${ri.upper()}$GETC2 has the form
     !> Z = P * L * U * Q, where P and Q are permutation matrices. L is lower
     !> triangular with unit diagonal elements and U is upper triangular.

     pure subroutine la_${ri}$latdf(ijob,n,z,ldz,rhs,rdsum,rdscal,ipiv,jpiv)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: ijob,ldz,n
           real(${rk}$),intent(inout) :: rdscal,rdsum
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*),jpiv(*)
           complex(${rk}$),intent(inout) :: rhs(*),z(ldz,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: maxdim = 2

           ! Local Scalars
           integer(ilp) :: i,info,j,k
           real(${rk}$) :: rtemp,scale,sminu,splus
           complex(${rk}$) :: bm,bp,pmone,temp
           ! Local Arrays
           real(${rk}$) :: rwork(maxdim)
           complex(${rk}$) :: work(4*maxdim),xm(maxdim),xp(maxdim)
           ! Intrinsic Functions
           intrinsic :: abs,real,sqrt
           ! Executable Statements
           if (ijob /= 2) then
              ! apply permutations ipiv to rhs
              call la_${ri}$laswp(1,rhs,ldz,1,n - 1,ipiv,1)
              ! solve for l-part choosing rhs either to +1 or -1.
              pmone = -cone
              loop_10: do j = 1,n - 1
                 bp = rhs(j) + cone
                 bm = rhs(j) - cone
                 splus = one
                 ! lockahead for l- part rhs(1:n-1) = +-1
                 ! splus and smin computed more efficiently than in bsolve[1].
                 splus = splus + real(la_${ri}$dotc(n - j,z(j + 1,j),1,z(j + 1,j),1),KIND=${rk}$)

                 sminu = real(la_${ri}$dotc(n - j,z(j + 1,j),1,rhs(j + 1),1),KIND=${rk}$)
                 splus = splus*real(rhs(j),KIND=${rk}$)
                 if (splus > sminu) then
                    rhs(j) = bp
                 else if (sminu > splus) then
                    rhs(j) = bm
                 else
                    ! in this case the updating sums are equal and we can
                    ! choose rhs(j) +1 or -1. the first time this happens we
                    ! choose -1, thereafter +1. this is a simple way to get
                    ! good estimates of matrices like byers well-known example
                    ! (see [1]). (not done in bsolve.)
                    rhs(j) = rhs(j) + pmone
                    pmone = cone
                 end if
                 ! compute the remaining r.h.s.
                 temp = -rhs(j)
                 call la_${ri}$axpy(n - j,temp,z(j + 1,j),1,rhs(j + 1),1)
              end do loop_10
              ! solve for u- part, lockahead for rhs(n) = +-1. this is not done
              ! in bsolve and will hopefully give us a better estimate because
              ! any ill-conditioning of the original matrix is transferred to u
              ! and not to l. u(n, n) is an approximation to sigma_min(lu).
              call la_${ri}$copy(n - 1,rhs,1,work,1)
              work(n) = rhs(n) + cone
              rhs(n) = rhs(n) - cone
              splus = zero
              sminu = zero
              do i = n,1,-1
                 temp = cone/z(i,i)
                 work(i) = work(i)*temp
                 rhs(i) = rhs(i)*temp
                 do k = i + 1,n
                    work(i) = work(i) - work(k)*(z(i,k)*temp)
                    rhs(i) = rhs(i) - rhs(k)*(z(i,k)*temp)
                 end do
                 splus = splus + abs(work(i))
                 sminu = sminu + abs(rhs(i))
              end do
              if (splus > sminu) call la_${ri}$copy(n,work,1,rhs,1)
              ! apply the permutations jpiv to the computed solution (rhs)
              call la_${ri}$laswp(1,rhs,ldz,1,n - 1,jpiv,-1)
              ! compute the sum of squares
              call la_${ri}$lassq(n,rhs,1,rdscal,rdsum)
              return
           end if
           ! entry ijob = 2
           ! compute approximate nullvector xm of z
           call la_${ri}$gecon('I',n,z,ldz,one,rtemp,work,rwork,info)
           call la_${ri}$copy(n,work(n + 1),1,xm,1)
           ! compute rhs
           call la_${ri}$laswp(1,xm,ldz,1,n - 1,ipiv,-1)
           temp = cone/sqrt(la_${ri}$dotc(n,xm,1,xm,1))
           call la_${ri}$scal(n,temp,xm,1)
           call la_${ri}$copy(n,xm,1,xp,1)
           call la_${ri}$axpy(n,cone,rhs,1,xp,1)
           call la_${ri}$axpy(n,-cone,xm,1,rhs,1)
           call la_${ri}$gesc2(n,z,ldz,rhs,ipiv,jpiv,scale)
           call la_${ri}$gesc2(n,z,ldz,xp,ipiv,jpiv,scale)
           if (la_${ci}$${ri}$asum(n,xp,1) > la_${ci}$${ri}$asum(n,rhs,1)) call la_${ri}$copy(n,xp,1, &
                     rhs,1)
           ! compute the sum of squares
           call la_${ri}$lassq(n,rhs,1,rdscal,rdsum)
           return
     end subroutine la_${ri}$latdf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GBRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is banded, and provides
     !> error bounds and backward error estimates for the solution.

     pure subroutine la_${ri}$gbrfs(trans,n,kl,ku,nrhs,ab,ldab,afb,ldafb,ipiv,b,ldb,x, &
               ldx,ferr,berr,work,rwork,info)
        use la_constants_${rk}$,only:zero,two,three,cone
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kl,ku,ldab,ldafb,ldb,ldx,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           complex(${rk}$),intent(in) :: ab(ldab,*),afb(ldafb,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: notran
           character :: transn,transt
           integer(ilp) :: count,i,j,k,kase,kk,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,min,real
#:else
           intrinsic :: abs,real,aimag,max,min
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           notran = la_lsame(trans,'N')
           if (.not. notran .and. .not. la_lsame(trans,'T') .and. .not. la_lsame(trans, &
                     'C')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kl < 0) then
              info = -3
           else if (ku < 0) then
              info = -4
           else if (nrhs < 0) then
              info = -5
           else if (ldab < kl + ku + 1) then
              info = -7
           else if (ldafb < 2*kl + ku + 1) then
              info = -9
           else if (ldb < max(1,n)) then
              info = -12
           else if (ldx < max(1,n)) then
              info = -14
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GBRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           if (notran) then
              transn = 'N'
              transt = 'C'
           else
              transn = 'C'
              transt = 'N'
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = min(kl + ku + 2,n + 1)
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - op(a) * x,
              ! where op(a) = a, a**t, or a**h, depending on trans.
              call la_${ri}$copy(n,b(1,j),1,work,1)
              call la_${ri}$gbmv(trans,n,n,kl,ku,-cone,ab,ldab,x(1,j),1,cone,work,1 &
                        )
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(op(a))*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 rwork(i) = cabs1(b(i,j))
              end do
              ! compute abs(op(a))*abs(x) + abs(b).
              if (notran) then
                 do k = 1,n
                    kk = ku + 1 - k
                    xk = cabs1(x(k,j))
                    do i = max(1,k - ku),min(n,k + kl)
                       rwork(i) = rwork(i) + cabs1(ab(kk + i,k))*xk
                    end do
                 end do
              else
                 do k = 1,n
                    s = zero
                    kk = ku + 1 - k
                    do i = max(1,k - ku),min(n,k + kl)
                       s = s + cabs1(ab(kk + i,k))*cabs1(x(i,j))
                    end do
                    rwork(k) = rwork(k) + s
                 end do
              end if
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$gbtrs(trans,n,kl,ku,1,afb,ldafb,ipiv,work,n,info)
                 call la_${ri}$axpy(n,cone,work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(op(a)))*
                 ! ( abs(r) + nz*eps*( abs(op(a))*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(op(a)) is the inverse of op(a)
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(op(a))*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(op(a))*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(op(a)) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(op(a))*abs(x)+abs(b) )))
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(n + 1),work,ferr(j),kase,isave)
              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(op(a)**h).
                    call la_${ri}$gbtrs(transt,n,kl,ku,1,afb,ldafb,ipiv,work,n,info)

                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                 else
                    ! multiply by inv(op(a))*diag(w).
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                    call la_${ri}$gbtrs(transn,n,kl,ku,1,afb,ldafb,ipiv,work,n,info)

                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,cabs1(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$gbrfs
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GERFS: improves the computed solution to a system of linear
     !> equations and provides error bounds and backward error estimates for
     !> the solution.

     pure subroutine la_${ri}$gerfs(trans,n,nrhs,a,lda,af,ldaf,ipiv,b,ldb,x,ldx,ferr, &
               berr,work,rwork,info)
        use la_constants_${rk}$,only:zero,two,three,cone
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldaf,ldb,ldx,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           complex(${rk}$),intent(in) :: a(lda,*),af(ldaf,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: notran
           character :: transn,transt
           integer(ilp) :: count,i,j,k,kase,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,real
#:else
           intrinsic :: abs,real,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           notran = la_lsame(trans,'N')
           if (.not. notran .and. .not. la_lsame(trans,'T') .and. .not. la_lsame(trans, &
                     'C')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldaf < max(1,n)) then
              info = -7
           else if (ldb < max(1,n)) then
              info = -10
           else if (ldx < max(1,n)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GERFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           if (notran) then
              transn = 'N'
              transt = 'C'
           else
              transn = 'C'
              transt = 'N'
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = n + 1
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - op(a) * x,
              ! where op(a) = a, a**t, or a**h, depending on trans.
              call la_${ri}$copy(n,b(1,j),1,work,1)
              call la_${ri}$gemv(trans,n,n,-cone,a,lda,x(1,j),1,cone,work,1)
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(op(a))*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 rwork(i) = cabs1(b(i,j))
              end do
              ! compute abs(op(a))*abs(x) + abs(b).
              if (notran) then
                 do k = 1,n
                    xk = cabs1(x(k,j))
                    do i = 1,n
                       rwork(i) = rwork(i) + cabs1(a(i,k))*xk
                    end do
                 end do
              else
                 do k = 1,n
                    s = zero
                    do i = 1,n
                       s = s + cabs1(a(i,k))*cabs1(x(i,j))
                    end do
                    rwork(k) = rwork(k) + s
                 end do
              end if
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$getrs(trans,n,1,af,ldaf,ipiv,work,n,info)
                 call la_${ri}$axpy(n,cone,work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(op(a)))*
                 ! ( abs(r) + nz*eps*( abs(op(a))*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(op(a)) is the inverse of op(a)
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(op(a))*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(op(a))*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(op(a)) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(op(a))*abs(x)+abs(b) )))
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(n + 1),work,ferr(j),kase,isave)
              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(op(a)**h).
                    call la_${ri}$getrs(transt,n,1,af,ldaf,ipiv,work,n,info)
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                 else
                    ! multiply by inv(op(a))*diag(w).
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                    call la_${ri}$getrs(transn,n,1,af,ldaf,ipiv,work,n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,cabs1(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$gerfs
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETRF: computes an LU factorization of a general M-by-N matrix A
     !> using partial pivoting with row interchanges.
     !> The factorization has the form
     !> A = P * L * U
     !> where P is a permutation matrix, L is lower triangular with unit
     !> diagonal elements (lower trapezoidal if m > n), and U is upper
     !> triangular (upper trapezoidal if m < n).
     !> This is the right-looking Level 3 BLAS version of the algorithm.

     pure subroutine la_${ri}$getrf(m,n,a,lda,ipiv,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           integer(ilp),intent(out) :: ipiv(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,iinfo,j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETRF',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) return
           ! determine the block size for this environment.
           nb = la_ilaenv(1,'${ri.upper()}$GETRF',' ',m,n,-1,-1)
           if (nb <= 1 .or. nb >= min(m,n)) then
              ! use unblocked code.
              call la_${ri}$getrf2(m,n,a,lda,ipiv,info)
           else
              ! use blocked code.
              do j = 1,min(m,n),nb
                 jb = min(min(m,n) - j + 1,nb)
                 ! factor diagonal and subdiagonal blocks and test for exact
                 ! singularity.
                 call la_${ri}$getrf2(m - j + 1,jb,a(j,j),lda,ipiv(j),iinfo)
                 ! adjust info and the pivot indices.
                 if (info == 0 .and. iinfo > 0) info = iinfo + j - 1
                 do i = j,min(m,j + jb - 1)
                    ipiv(i) = j - 1 + ipiv(i)
                 end do
                 ! apply interchanges to columns 1:j-1.
                 call la_${ri}$laswp(j - 1,a,lda,j,j + jb - 1,ipiv,1)
                 if (j + jb <= n) then
                    ! apply interchanges to columns j+jb:n.
                    call la_${ri}$laswp(n - j - jb + 1,a(1,j + jb),lda,j,j + jb - 1,ipiv,1)
                    ! compute block row of u.
                    call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','UNIT',jb,n - j - jb + 1,cone, &
                               a(j,j),lda,a(j,j + jb),lda)
                    if (j + jb <= m) then
                       ! update trailing submatrix.
                       call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',m - j - jb + 1,n - j - jb + 1,jb,- &
                       cone,a(j + jb,j),lda,a(j,j + jb),lda,cone,a(j + jb,j + jb),lda)

                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$getrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GTCON: estimates the reciprocal of the condition number of a complex
     !> tridiagonal matrix A using the LU factorization as computed by
     !> ${ri.upper()}$GTTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$gtcon(norm,n,dl,d,du,du2,ipiv,anorm,rcond,work,info)
        use la_constants_${rk}$

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: norm
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           complex(${rk}$),intent(in) :: d(*),dl(*),du(*),du2(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: onenrm
           integer(ilp) :: i,kase,kase1
           real(${rk}$) :: ainvnm
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: cmplx
           ! Executable Statements
           ! test the input arguments.
           info = 0
           onenrm = norm == '1' .or. la_lsame(norm,'O')
           if (.not. onenrm .and. .not. la_lsame(norm,'I')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (anorm < zero) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GTCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           ! check that d(1:n) is non-zero.
           do i = 1,n
              if (d(i) == cmplx(zero,KIND=${rk}$)) return
           end do
           ainvnm = zero
           if (onenrm) then
              kase1 = 1
           else
              kase1 = 2
           end if
           kase = 0
           20 continue
           call la_${ri}$lacn2(n,work(n + 1),work,ainvnm,kase,isave)
           if (kase /= 0) then
              if (kase == kase1) then
                 ! multiply by inv(u)*inv(l).
                 call la_${ri}$gttrs('NO TRANSPOSE',n,1,dl,d,du,du2,ipiv,work,n,info)

              else
                 ! multiply by inv(l**h)*inv(u**h).
                 call la_${ri}$gttrs('CONJUGATE TRANSPOSE',n,1,dl,d,du,du2,ipiv,work,n, &
                           info)
              end if
              go to 20
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           return
     end subroutine la_${ri}$gtcon
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GTRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is tridiagonal, and provides
     !> error bounds and backward error estimates for the solution.

     pure subroutine la_${ri}$gtrfs(trans,n,nrhs,dl,d,du,dlf,df,duf,du2,ipiv,b,ldb,x, &
               ldx,ferr,berr,work,rwork,info)
        use la_constants_${rk}$,only:zero,one,two,three
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,ldx,n,nrhs
           ! Array Arguments
           integer(ilp),intent(in) :: ipiv(*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           complex(${rk}$),intent(in) :: b(ldb,*),d(*),df(*),dl(*),dlf(*),du(*),du2(*),duf(*)

           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: notran
           character :: transn,transt
           integer(ilp) :: count,i,j,kase,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,cmplx,max,real
#:else
           intrinsic :: abs,real,cmplx,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           notran = la_lsame(trans,'N')
           if (.not. notran .and. .not. la_lsame(trans,'T') .and. .not. la_lsame(trans, &
                     'C')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -13
           else if (ldx < max(1,n)) then
              info = -15
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GTRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           if (notran) then
              transn = 'N'
              transt = 'C'
           else
              transn = 'C'
              transt = 'N'
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = 4
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_110: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - op(a) * x,
              ! where op(a) = a, a**t, or a**h, depending on trans.
              call la_${ri}$copy(n,b(1,j),1,work,1)
              call la_${ri}$lagtm(trans,n,1,-one,dl,d,du,x(1,j),ldx,one,work,n)

              ! compute abs(op(a))*abs(x) + abs(b) for use in the backward
              ! error bound.
              if (notran) then
                 if (n == 1) then
                    rwork(1) = cabs1(b(1,j)) + cabs1(d(1))*cabs1(x(1,j))
                 else
                    rwork(1) = cabs1(b(1,j)) + cabs1(d(1))*cabs1(x(1,j)) + cabs1( &
                              du(1))*cabs1(x(2,j))
                    do i = 2,n - 1
                       rwork(i) = cabs1(b(i,j)) + cabs1(dl(i - 1))*cabs1(x(i - 1,j)) + &
                       cabs1(d(i))*cabs1(x(i,j)) + cabs1(du(i))*cabs1(x(i + 1,j))

                    end do
                    rwork(n) = cabs1(b(n,j)) + cabs1(dl(n - 1))*cabs1(x(n - 1,j)) + &
                              cabs1(d(n))*cabs1(x(n,j))
                 end if
              else
                 if (n == 1) then
                    rwork(1) = cabs1(b(1,j)) + cabs1(d(1))*cabs1(x(1,j))
                 else
                    rwork(1) = cabs1(b(1,j)) + cabs1(d(1))*cabs1(x(1,j)) + cabs1( &
                              dl(1))*cabs1(x(2,j))
                    do i = 2,n - 1
                       rwork(i) = cabs1(b(i,j)) + cabs1(du(i - 1))*cabs1(x(i - 1,j)) + &
                       cabs1(d(i))*cabs1(x(i,j)) + cabs1(dl(i))*cabs1(x(i + 1,j))

                    end do
                    rwork(n) = cabs1(b(n,j)) + cabs1(du(n - 1))*cabs1(x(n - 1,j)) + &
                              cabs1(d(n))*cabs1(x(n,j))
                 end if
              end if
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(op(a))*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$gttrs(trans,n,1,dlf,df,duf,du2,ipiv,work,n,info)
                 call la_${ri}$axpy(n,cmplx(one,KIND=${rk}$),work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(op(a)))*
                 ! ( abs(r) + nz*eps*( abs(op(a))*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(op(a)) is the inverse of op(a)
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(op(a))*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(op(a))*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(op(a)) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(op(a))*abs(x)+abs(b) )))
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              kase = 0
              70 continue
              call la_${ri}$lacn2(n,work(n + 1),work,ferr(j),kase,isave)
              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(op(a)**h).
                    call la_${ri}$gttrs(transt,n,1,dlf,df,duf,du2,ipiv,work,n,info)

                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                 else
                    ! multiply by inv(op(a))*diag(w).
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                    call la_${ri}$gttrs(transn,n,1,dlf,df,duf,du2,ipiv,work,n,info)

                 end if
                 go to 70
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,cabs1(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_110
           return
     end subroutine la_${ri}$gtrfs
#:endfor

end module la_lapack_solve_lu_comp
