#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
#:if rk == "sp"
     !> ${ri.upper()}$${ci.upper()}$ROT: applies a plane rotation, where the cos and sin (c and s) are real
     !> and the vectors ${ri}$x and ${ri}$y are complex.
#:else
     !> Applies a plane rotation, where the cos and sin (c and s) are real
     !> and the vectors cx and cy are complex.
#:endif
     !> jack dongarra, linpack, 3/11/78.

     pure subroutine la_${ri}$${ci}$rot(n,${ri}$x,incx,${ri}$y,incy,c,s)
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx,incy,n
           real(${rk}$),intent(in) :: c,s
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ${ri}$x(*),${ri}$y(*)
       ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,ix,iy
           complex(${rk}$) :: ctemp
           ! Executable Statements
           if (n <= 0) return
           if (incx == 1 .and. incy == 1) then
              ! code for both increments equal to 1
              do i = 1,n
                 ctemp = c*${ri}$x(i) + s*${ri}$y(i)
                 ${ri}$y(i) = c*${ri}$y(i) - s*${ri}$x(i)
                 ${ri}$x(i) = ctemp
              end do
           else
              ! code for unequal increments or equal increments not equal
                ! to 1
              ix = 1
              iy = 1
              if (incx < 0) ix = (-n + 1)*incx + 1
              if (incy < 0) iy = (-n + 1)*incy + 1
              do i = 1,n
                 ctemp = c*${ri}$x(ix) + s*${ri}$y(iy)
                 ${ri}$y(iy) = c*${ri}$y(iy) - s*${ri}$x(ix)
                 ${ri}$x(ix) = ctemp
                 ix = ix + incx
                 iy = iy + incy
              end do
           end if
           return
     end subroutine la_${ri}$${ci}$rot
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
#:if rk == "sp"
     !> ${ri.upper()}$${ci.upper()}$SCAL: scales a complex vector by a real constant.
#:else
     !> ${ri.upper()}$${ci.upper()}$SCAL: scales a vector by a constant.
#:endif

     pure subroutine la_${ri}$${ci}$scal(n,${ci}$a,${ri}$x,incx)
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           real(${rk}$),intent(in) :: ${ci}$a
           integer(ilp),intent(in) :: incx,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ${ri}$x(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,nincx
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: aimag,cmplx,real
#:else
           intrinsic :: cmplx
#:endif
           if (n <= 0 .or. incx <= 0) return
           if (incx == 1) then
              ! code for increment equal to 1
              do i = 1,n
#:if rk == "sp"
                 ${ri}$x(i) = cmplx(${ci}$a*real(${ri}$x(i),KIND=${rk}$),${ci}$a*aimag(${ri}$x(i)),KIND=${rk}$)
#:else
                 ${ri}$x(i) = cmplx(${ci}$a,0.0_${rk}$,KIND=${rk}$)*${ri}$x(i)
#:endif
              end do
           else
              ! code for increment not equal to 1
              nincx = n*incx
              do i = 1,nincx,incx
#:if rk == "sp"
                 ${ri}$x(i) = cmplx(${ci}$a*real(${ri}$x(i),KIND=${rk}$),${ci}$a*aimag(${ri}$x(i)),KIND=${rk}$)
#:else
                 ${ri}$x(i) = cmplx(${ci}$a,0.0_${rk}$,KIND=${rk}$)*${ri}$x(i)
#:endif
              end do
           end if
           return
     end subroutine la_${ri}$${ci}$scal
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> !
     !>
     !> The computation uses the formulas
     !> |x| = sqrt( Re(x)**2 + Im(x)**2 )
     !> sgn(x) = x / |x|  if x /= 0
     !> = 1        if x  = 0
     !> c = |a| / sqrt(|a|**2 + |b|**2)
     !> s = sgn(a) * conjg(b) / sqrt(|a|**2 + |b|**2)
     !> When a and b are real and r /= 0, the formulas simplify to
     !> r = sgn(a)*sqrt(|a|**2 + |b|**2)
     !> c = a / r
     !> s = b / r
     !> the same as in ${ci.upper()}$ROTG when |a| > |b|.  When |b| >= |a|, the
     !> sign of c and s will be different from those computed by ${ci.upper()}$ROTG
     !> if the signs of a and b are not the same.

     pure subroutine la_${ri}$rotg(a,b,c,s)
        use la_constants_${rk}$
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
        ! Constants
        integer,parameter :: wp = kind(1._${rk}$)
        ! Scaling Constants
        ! Scalar Arguments
        real(${rk}$),intent(out) :: c
        complex(${rk}$),intent(inout) :: a
        complex(${rk}$),intent(in) :: b
        complex(${rk}$),intent(out) :: s
        ! Local Scalars
        real(${rk}$) :: d,f1,f2,g1,g2,h2,p,u,uu,v,vv,w
        complex(${rk}$) :: f,fs,g,gs,r,t
        ! Intrinsic Functions
        intrinsic :: abs,aimag,conjg,max,min,real,sqrt
        ! Statement Functions
        real(${rk}$) :: abssq
        ! Statement Function Definitions
        abssq(t) = real(t,KIND=${rk}$)**2 + aimag(t)**2
        ! Executable Statements
        f = a
        g = b
        if (g == czero) then
           c = one
           s = czero
           r = f
        else if (f == czero) then
           c = zero
           g1 = max(abs(real(g,KIND=${rk}$)),abs(aimag(g)))
           if (g1 > rtmin .and. g1 < rtmax) then
              ! use unscaled algorithm
              g2 = abssq(g)
              d = sqrt(g2)
              s = conjg(g)/d
              r = d
           else
              ! use scaled algorithm
              u = min(safmax,max(safmin,g1))
              uu = one/u
              gs = g*uu
              g2 = abssq(gs)
              d = sqrt(g2)
              s = conjg(gs)/d
              r = d*u
           end if
        else
           f1 = max(abs(real(f,KIND=${rk}$)),abs(aimag(f)))
           g1 = max(abs(real(g,KIND=${rk}$)),abs(aimag(g)))
     if (f1 > rtmin .and. f1 < rtmax .and. g1 > rtmin .and. g1 < rtmax) then
              ! use unscaled algorithm
              f2 = abssq(f)
              g2 = abssq(g)
              h2 = f2 + g2
              if (f2 > rtmin .and. h2 < rtmax) then
                 d = sqrt(f2*h2)
              else
                 d = sqrt(f2)*sqrt(h2)
              end if
              p = 1/d
              c = f2*p
              s = conjg(g)*(f*p)
              r = f*(h2*p)
           else
              ! use scaled algorithm
              u = min(safmax,max(safmin,f1,g1))
              uu = one/u
              gs = g*uu
              g2 = abssq(gs)
              if (f1*uu < rtmin) then
                 ! f is not well-scaled when scaled by g1.
                 ! use a different scaling for f.
                 v = min(safmax,max(safmin,f1))
                 vv = one/v
                 w = v*uu
                 fs = f*vv
                 f2 = abssq(fs)
                 h2 = f2*w**2 + g2
              else
                 ! otherwise use the same scaling for f and g.
                 w = one
                 fs = f*uu
                 f2 = abssq(fs)
                 h2 = f2 + g2
              end if
              if (f2 > rtmin .and. h2 < rtmax) then
                 d = sqrt(f2*h2)
              else
                 d = sqrt(f2)*sqrt(h2)
              end if
              p = 1/d
              c = (f2*p)*w
              s = conjg(gs)*(fs*p)
              r = (fs*(h2*p))*u
           end if
        end if
        a = r
        return
     end subroutine la_${ri}$rotg
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SCAL: scales a vector by a constant.

     pure subroutine la_${ri}$scal(n,${ri}$a,${ri}$x,incx)
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           complex(${rk}$),intent(in) :: ${ri}$a
           integer(ilp),intent(in) :: incx,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ${ri}$x(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,nincx
           if (n <= 0 .or. incx <= 0) return
           if (incx == 1) then
              ! code for increment equal to 1
              do i = 1,n
                 ${ri}$x(i) = ${ri}$a*${ri}$x(i)
              end do
           else
              ! code for increment not equal to 1
              nincx = n*incx
              do i = 1,nincx,incx
                 ${ri}$x(i) = ${ri}$a*${ri}$x(i)
              end do
           end if
           return
     end subroutine la_${ri}$scal
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SWAP: interchanges two vectors.

     pure subroutine la_${ri}$swap(n,${ri}$x,incx,${ri}$y,incy)
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx,incy,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ${ri}$x(*),${ri}$y(*)
        ! =====================================================================
           ! Local Scalars
           complex(${rk}$) :: ${ri}$temp
           integer(ilp) :: i,ix,iy
           if (n <= 0) return
           if (incx == 1 .and. incy == 1) then
             ! code for both increments equal to 1
              do i = 1,n
                 ${ri}$temp = ${ri}$x(i)
                 ${ri}$x(i) = ${ri}$y(i)
                 ${ri}$y(i) = ${ri}$temp
              end do
           else
             ! code for unequal increments or equal increments not equal
               ! to 1
              ix = 1
              iy = 1
              if (incx < 0) ix = (-n + 1)*incx + 1
              if (incy < 0) iy = (-n + 1)*incy + 1
              do i = 1,n
                 ${ri}$temp = ${ri}$x(ix)
                 ${ri}$x(ix) = ${ri}$y(iy)
                 ${ri}$y(iy) = ${ri}$temp
                 ix = ix + incx
                 iy = iy + incy
              end do
           end if
           return
     end subroutine la_${ri}$swap
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

     !> Compute the inner product of two vectors with extended
     !> precision accumulation.
     !> Returns S.P. result with dot product accumulated in D.P.
     !> SDSDOT: = SB + sum for I = 0 to N-1 of SX(LX+I*INCX)*SY(LY+I*INCY),
     !> where LX = 1 if INCX >= 0, else LX = 1+(1-N)*INCX, and LY is
     !> defined in a similar way using INCY.

     pure real(sp) function la_sdsdot(n,sb,sx,incx,sy,incy)
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           real(sp),intent(in) :: sb
           integer(ilp),intent(in) :: incx,incy,n
           ! Array Arguments
           real(sp),intent(in) :: sx(*),sy(*)
           ! Local Scalars
           real(dp) :: dsdot
           integer(ilp) :: i,kx,ky,ns
           ! Intrinsic Functions
           intrinsic :: real
           dsdot = sb
           if (n <= 0) then
              la_sdsdot = dsdot
              return
           end if
           if (incx == incy .and. incx > 0) then
           ! code for equal and positive increments.
              ns = n*incx
              do i = 1,ns,incx
                 dsdot = dsdot + real(sx(i),KIND=sp)*real(sy(i),KIND=sp)
              end do
           else
           ! code for unequal or nonpositive increments.
              kx = 1
              ky = 1
              if (incx < 0) kx = 1 + (1 - n)*incx
              if (incy < 0) ky = 1 + (1 - n)*incy
              do i = 1,n
                 dsdot = dsdot + real(sx(kx),KIND=sp)*real(sy(ky),KIND=sp)
                 kx = kx + incx
                 ky = ky + incy
              end do
           end if
           la_sdsdot = dsdot
           return
     end function la_sdsdot

end module la_blas_level1
