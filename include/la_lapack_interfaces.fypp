    & ('orbdb4', ['ORBDB4: simultaneously bidiagonalizes the blocks of a tall and skinny', 'matrix X with orthonomal columns:', '[ B11 ]', '[ X11 ]   [ P1 |    ] [  0  ]', '[-----] = [---------] [-----] Q1**T .', '[ X21 ]   [    | P2 ] [ B21 ]', '[  0  ]', 'X11 is P-by-Q, and X21 is (M-P)-by-Q. M-Q must be no larger than P,', 'M-P, or Q. Routines DORBDB1, DORBDB2, and DORBDB3 handle cases in', 'which M-Q is not the minimum dimension.', 'The orthogonal matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),', 'and (M-Q)-by-(M-Q), respectively. They are represented implicitly by', 'Householder vectors.', 'B11 and B12 are (M-Q)-by-(M-Q) bidiagonal matrices represented', 'implicitly by angles THETA, PHI.'], &
    &  [('dorbdb4', 'dorbdb4', 'real'), ('qorbdb4', 'qorbdb4', None), ('sorbdb4', 'sorbdb4', 'real'), ('xorbdb4', 'xorbdb4', None)], &
    &  {'real': '               subroutine {ri}orbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2, &\n                         tauq1,phantom,work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21\n                    {rt},intent(out) :: phi(*),theta(*),phantom(*),taup1(*),taup2(*),tauq1(*) &\n                              ,work(*)\n                    {rt},intent(inout) :: x11(ldx11,*),x21(ldx21,*)\n               end subroutine {ri}orbdb4'}), &
