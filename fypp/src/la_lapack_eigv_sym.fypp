#:include "common.fypp"
!> Symmetric and Hermitian eigenvalue drivers: dense, packed, banded and generalized problems
module la_lapack_eigv_sym
     use la_constants
     use la_blas_aux
     use la_blas_level1
     use la_blas_level2_gen
     use la_blas_level2_sym
     use la_blas_level2_tri
     use la_blas_level3_gen
     use la_blas_level3_sym
     use la_blas_level3_tri
     use la_lapack_aux
     use la_lapack_auxiliary
     use la_lapack_blas_like_base
     use la_lapack_blas_like_l2
     use la_lapack_blas_like_mnorm
     use la_lapack_eigv_sym_comp
     use la_lapack_eigv_tridiag
     use la_lapack_eigv_tridiag3
     use la_lapack_householder_reflectors
     use la_lapack_orthogonal_factors_ql
     use la_lapack_orthogonal_factors_qr
     use la_lapack_solve_chol_comp
     implicit none(type,external)
     private

     public :: sp,dp,qp,lk,ilp
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     public :: la_${ri}$sb2st_kernels
     public :: la_${ri}$sytd2
     public :: la_${ri}$sytrd
     public :: la_${ri}$sytrd_sb2st
     public :: la_${ri}$orgtr
     public :: la_${ri}$ormtr
     public :: la_${ri}$sbev
     public :: la_${ri}$sbevx
     public :: la_${ri}$sbgv
     public :: la_${ri}$sbgvx
     public :: la_${ri}$spev
     public :: la_${ri}$spevx
     public :: la_${ri}$spgv
     public :: la_${ri}$spgvx
     public :: la_${ri}$syev
     public :: la_${ri}$syevx
     public :: la_${ri}$sygv
     public :: la_${ri}$sygvx
     public :: la_${ri}$sytrd_sy2sb
     public :: la_${ri}$syevd
     public :: la_${ri}$sygvd
     public :: la_${ri}$sbevd
     public :: la_${ri}$sbgvd
     public :: la_${ri}$spevd
     public :: la_${ri}$spgvd
     public :: la_${ri}$syevr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     public :: la_${ri}$hb2st_kernels
     public :: la_${ri}$hetd2
     public :: la_${ri}$hetrd
     public :: la_${ri}$hetrd_hb2st
     public :: la_${ri}$hetrd_he2hb
     public :: la_${ri}$ungtr
     public :: la_${ri}$unmtr
     public :: la_${ri}$heev
     public :: la_${ri}$heevr
     public :: la_${ri}$heevx
     public :: la_${ri}$hegv
     public :: la_${ri}$hegvx
     public :: la_${ri}$hpev
     public :: la_${ri}$hpevx
     public :: la_${ri}$hpgv
     public :: la_${ri}$hpgvx
     public :: la_${ri}$hbev
     public :: la_${ri}$hbevd
     public :: la_${ri}$hbevx
     public :: la_${ri}$hbgv
     public :: la_${ri}$hbgvd
     public :: la_${ri}$hbgvx
     public :: la_${ri}$heevd
     public :: la_${ri}$hegvd
     public :: la_${ri}$hpevd
     public :: la_${ri}$hpgvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

     contains

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SB2ST_KERNELS: is an internal routine used by the ${ri.upper()}$SYTRD_SB2ST
     !> subroutine.

     pure subroutine la_${ri}$sb2st_kernels(uplo,wantz,ttype,st,ed,sweep,n,nb,ib,a,lda, &
               v,tau,ldvt,work)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           logical(lk),intent(in) :: wantz
           integer(ilp),intent(in) :: ttype,st,ed,sweep,n,nb,ib,lda,ldvt
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: v(*),tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i,j1,j2,lm,ln,vpos,taupos,dpos,ofdpos,ajeter
           real(${rk}$) :: ctmp
           ! Intrinsic Functions
           intrinsic :: mod
           ! Executable Statements
           ajeter = ib + ldvt
           upper = la_lsame(uplo,'U')
           if (upper) then
               dpos = 2*nb + 1
               ofdpos = 2*nb
           else
               dpos = 1
               ofdpos = 2
           end if
           ! upper case
           if (upper) then
               if (wantz) then
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               else
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               end if
               if (ttype == 1) then
                   lm = ed - st + 1
                   v(vpos) = one
                   do i = 1,lm - 1
                       v(vpos + i) = (a(ofdpos - i,st + i))
                       a(ofdpos - i,st + i) = zero
                   end do
                   ctmp = (a(ofdpos,st))
                   call la_${ri}$larfg(lm,ctmp,v(vpos + 1),1,tau(taupos))
                   a(ofdpos,st) = ctmp
                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1, (tau(taupos)),a(dpos,st), &
                             lda - 1,work)
               end if
               if (ttype == 3) then
                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1, (tau(taupos)),a(dpos,st), &
                             lda - 1,work)
               end if
               if (ttype == 2) then
                   j1 = ed + 1
                   j2 = min(ed + nb,n)
                   ln = ed - st + 1
                   lm = j2 - j1 + 1
                   if (lm > 0) then
                       call la_${ri}$larfx('LEFT',ln,lm,v(vpos), (tau(taupos)),a(dpos - nb, &
                                  j1),lda - 1,work)
                       if (wantz) then
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       else
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       end if
                       v(vpos) = one
                       do i = 1,lm - 1
                           v(vpos + i) = (a(dpos - nb - i,j1 + i))
                           a(dpos - nb - i,j1 + i) = zero
                       end do
                       ctmp = (a(dpos - nb,j1))
                       call la_${ri}$larfg(lm,ctmp,v(vpos + 1),1,tau(taupos))
                       a(dpos - nb,j1) = ctmp
                       call la_${ri}$larfx('RIGHT',ln - 1,lm,v(vpos),tau(taupos),a(dpos - nb + &
                                 1,j1),lda - 1,work)
                   end if
               end if
           ! lower case
           else
               if (wantz) then
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               else
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               end if
               if (ttype == 1) then
                   lm = ed - st + 1
                   v(vpos) = one
                   do i = 1,lm - 1
                       v(vpos + i) = a(ofdpos + i,st - 1)
                       a(ofdpos + i,st - 1) = zero
                   end do
                   call la_${ri}$larfg(lm,a(ofdpos,st - 1),v(vpos + 1),1,tau(taupos))

                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1, (tau(taupos)),a(dpos,st), &
                             lda - 1,work)
               end if
               if (ttype == 3) then
                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1, (tau(taupos)),a(dpos,st), &
                             lda - 1,work)
               end if
               if (ttype == 2) then
                   j1 = ed + 1
                   j2 = min(ed + nb,n)
                   ln = ed - st + 1
                   lm = j2 - j1 + 1
                   if (lm > 0) then
                       call la_${ri}$larfx('RIGHT',lm,ln,v(vpos),tau(taupos),a(dpos + nb, &
                                 st),lda - 1,work)
                       if (wantz) then
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       else
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       end if
                       v(vpos) = one
                       do i = 1,lm - 1
                           v(vpos + i) = a(dpos + nb + i,st)
                           a(dpos + nb + i,st) = zero
                       end do
                       call la_${ri}$larfg(lm,a(dpos + nb,st),v(vpos + 1),1,tau(taupos))

                       call la_${ri}$larfx('LEFT',lm,ln - 1,v(vpos), (tau(taupos)),a(dpos + &
                                 nb - 1,st + 1),lda - 1,work)
                   end if
               end if
           end if
           return
     end subroutine la_${ri}$sb2st_kernels
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYTD2: reduces a real symmetric matrix A to symmetric tridiagonal
     !> form T by an orthogonal similarity transformation: Q**T * A * Q = T.

     pure subroutine la_${ri}$sytd2(uplo,n,a,lda,d,e,tau,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: d(*),e(*),tau(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i
           real(${rk}$) :: alpha,taui
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYTD2',-info)
              return
           end if
           ! quick return if possible
           if (n <= 0) return
           if (upper) then
              ! reduce the upper triangle of a
              do i = n - 1,1,-1
                 ! generate elementary reflector h(i) = i - tau * v * v**t
                 ! to annihilate a(1:i-1,i+1)
                 call la_${ri}$larfg(i,a(i,i + 1),a(1,i + 1),1,taui)
                 e(i) = a(i,i + 1)
                 if (taui /= zero) then
                    ! apply h(i) from both sides to a(1:i,1:i)
                    a(i,i + 1) = one
                    ! compute  x := tau * a * v  storing x in tau(1:i)
                    call la_${ri}$symv(uplo,i,taui,a,lda,a(1,i + 1),1,zero,tau,1)

                    ! compute  w := x - 1/2 * tau * (x**t * v) * v
                    alpha = -half*taui*la_${ri}$dot(i,tau,1,a(1,i + 1),1)
                    call la_${ri}$axpy(i,alpha,a(1,i + 1),1,tau,1)
                    ! apply the transformation as a rank-2 update:
                       ! a := a - v * w**t - w * v**t
                    call la_${ri}$syr2(uplo,i,-one,a(1,i + 1),1,tau,1,a,lda)
                    a(i,i + 1) = e(i)
                 end if
                 d(i + 1) = a(i + 1,i + 1)
                 tau(i) = taui
              end do
              d(1) = a(1,1)
           else
              ! reduce the lower triangle of a
              do i = 1,n - 1
                 ! generate elementary reflector h(i) = i - tau * v * v**t
                 ! to annihilate a(i+2:n,i)
                 call la_${ri}$larfg(n - i,a(i + 1,i),a(min(i + 2,n),i),1,taui)
                 e(i) = a(i + 1,i)
                 if (taui /= zero) then
                    ! apply h(i) from both sides to a(i+1:n,i+1:n)
                    a(i + 1,i) = one
                    ! compute  x := tau * a * v  storing y in tau(i:n-1)
                    call la_${ri}$symv(uplo,n - i,taui,a(i + 1,i + 1),lda,a(i + 1,i),1,zero, &
                              tau(i),1)
                    ! compute  w := x - 1/2 * tau * (x**t * v) * v
                    alpha = -half*taui*la_${ri}$dot(n - i,tau(i),1,a(i + 1,i),1)
                    call la_${ri}$axpy(n - i,alpha,a(i + 1,i),1,tau(i),1)
                    ! apply the transformation as a rank-2 update:
                       ! a := a - v * w**t - w * v**t
                    call la_${ri}$syr2(uplo,n - i,-one,a(i + 1,i),1,tau(i),1,a(i + 1,i + 1), &
                               lda)
                    a(i + 1,i) = e(i)
                 end if
                 d(i) = a(i,i)
                 tau(i) = taui
              end do
              d(n) = a(n,n)
           end if
           return
     end subroutine la_${ri}$sytd2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYTRD: reduces a real symmetric matrix A to real symmetric
     !> tridiagonal form T by an orthogonal similarity transformation:
     !> Q**T * A * Q = T.

     pure subroutine la_${ri}$sytrd(uplo,n,a,lda,d,e,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: d(*),e(*),tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper
           integer(ilp) :: i,iinfo,iws,j,kk,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (lwork < 1 .and. .not. lquery) then
              info = -9
           end if
           if (info == 0) then
              ! determine the block size.
              nb = la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
              lwkopt = n*nb
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYTRD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
              work(1) = 1
              return
           end if
           nx = n
           iws = 1
           if (nb > 1 .and. nb < n) then
              ! determine when to cross over from blocked to unblocked code
              ! (last block is always handled by unblocked code).
              nx = max(nb,la_ilaenv(3,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1))
              if (nx < n) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  determine the
                    ! minimum value of nb, and reduce nb or force use of
                    ! unblocked code by setting nx = n.
                    nb = max(lwork/ldwork,1)
                    nbmin = la_ilaenv(2,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
                    if (nb < nbmin) nx = n
                 end if
              else
                 nx = n
              end if
           else
              nb = 1
           end if
           if (upper) then
              ! reduce the upper triangle of a.
              ! columns 1:kk are handled by the unblocked method.
              kk = n - ((n - nx + nb - 1)/nb)*nb
              do i = n - nb + 1,kk + 1,-nb
                 ! reduce columns i:i+nb-1 to tridiagonal form and form the
                 ! matrix w which is needed to update the unreduced part of
                 ! the matrix
                 call la_${ri}$latrd(uplo,i + nb - 1,nb,a,lda,e,tau,work,ldwork)
                 ! update the unreduced submatrix a(1:i-1,1:i-1), using an
                 ! update of the form:  a := a - v*w**t - w*v**t
                 call la_${ri}$syr2k(uplo,'NO TRANSPOSE',i - 1,nb,-one,a(1,i),lda,work, &
                           ldwork,one,a,lda)
                 ! copy superdiagonal elements back into a, and diagonal
                 ! elements into d
                 do j = i,i + nb - 1
                    a(j - 1,j) = e(j - 1)
                    d(j) = a(j,j)
                 end do
              end do
              ! use unblocked code to reduce the last or only block
              call la_${ri}$sytd2(uplo,kk,a,lda,d,e,tau,iinfo)
           else
              ! reduce the lower triangle of a
              do i = 1,n - nx,nb
                 ! reduce columns i:i+nb-1 to tridiagonal form and form the
                 ! matrix w which is needed to update the unreduced part of
                 ! the matrix
                 call la_${ri}$latrd(uplo,n - i + 1,nb,a(i,i),lda,e(i),tau(i),work, &
                           ldwork)
                 ! update the unreduced submatrix a(i+ib:n,i+ib:n), using
                 ! an update of the form:  a := a - v*w**t - w*v**t
                 call la_${ri}$syr2k(uplo,'NO TRANSPOSE',n - i - nb + 1,nb,-one,a(i + nb,i),lda, &
                           work(nb + 1),ldwork,one,a(i + nb,i + nb),lda)
                 ! copy subdiagonal elements back into a, and diagonal
                 ! elements into d
                 do j = i,i + nb - 1
                    a(j + 1,j) = e(j)
                    d(j) = a(j,j)
                 end do
              end do
              ! use unblocked code to reduce the last or only block
              call la_${ri}$sytd2(uplo,n - i + 1,a(i,i),lda,d(i),e(i),tau(i),iinfo)

           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$sytrd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYTRD_SB2ST: reduces a real symmetric band matrix A to real symmetric
     !> tridiagonal form T by a orthogonal similarity transformation:
     !> Q**T * A * Q = T.

     pure subroutine la_${ri}$sytrd_sb2st(stage1,vect,uplo,n,kd,ab,ldab,d,e,hous,lhous, &
               work,lwork,info)
        use la_constants_${rk}$
#if defined(_OPENMP)
#endif
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: stage1,uplo,vect
           integer(ilp),intent(in) :: n,kd,ldab,lhous,lwork
           integer(ilp),intent(out) :: info
           ! Array Arguments
           real(${rk}$),intent(out) :: d(*),e(*)
           real(${rk}$),intent(inout) :: ab(ldab,*)
           real(${rk}$),intent(out) :: hous(*),work(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: rzero = 0.0e+0_${rk}$

           ! Local Scalars
           logical(lk) :: lquery,wantq,upper,afters1
           integer(ilp) :: i,m,k,ib,sweepid,myid,shift,stt,st,ed,stind,edind, &
           blklastind,colpt,thed,stepercol,grsiz,thgrsiz,thgrnb,thgrid,nbtiles,ttype, &
           tid,nthreads,debug,abdpos,abofdpos,dpos,ofdpos,awpos,inda,indw,apos,sizea, &
                     lda,indv,indtau,si${ri}$ev,sizetau,ldv,lhmin,lwmin
           ! Intrinsic Functions
           intrinsic :: min,max,ceiling,real
           ! Executable Statements
           ! determine the minimal workspace size required.
           ! test the input parameters
           debug = 0
           info = 0
           afters1 = la_lsame(stage1,'Y')
           wantq = la_lsame(vect,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1) .or. (lhous == -1)
           ! determine the block size, the workspace size and the hous size.
           ib = la_ilaenv2stage(2,'${ri.upper()}$SYTRD_SB2ST',vect,n,kd,-1,-1)
           lhmin = la_ilaenv2stage(3,'${ri.upper()}$SYTRD_SB2ST',vect,n,kd,ib,-1)
           lwmin = la_ilaenv2stage(4,'${ri.upper()}$SYTRD_SB2ST',vect,n,kd,ib,-1)
           if (.not. afters1 .and. .not. la_lsame(stage1,'N')) then
              info = -1
           else if (.not. la_lsame(vect,'N')) then
              info = -2
           else if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (kd < 0) then
              info = -5
           else if (ldab < (kd + 1)) then
              info = -7
           else if (lhous < lhmin .and. .not. lquery) then
              info = -11
           else if (lwork < lwmin .and. .not. lquery) then
              info = -13
           end if
           if (info == 0) then
              hous(1) = lhmin
              work(1) = lwmin
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYTRD_SB2ST',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
               hous(1) = 1
               work(1) = 1
               return
           end if
           ! determine pointer position
           ldv = kd + ib
           sizetau = 2*n
           si${ri}$ev = 2*n
           indtau = 1
           indv = indtau + sizetau
           lda = 2*kd + 1
           sizea = lda*n
           inda = 1
           indw = inda + sizea
           nthreads = 1
           tid = 0
           if (upper) then
               apos = inda + kd
               awpos = inda
               dpos = apos + kd
               ofdpos = dpos - 1
               abdpos = kd + 1
               abofdpos = kd
           else
               apos = inda
               awpos = inda + kd + 1
               dpos = apos
               ofdpos = dpos + 1
               abdpos = 1
               abofdpos = 2
           end if
           ! case kd=0:
           ! the matrix is diagonal. we just copy it (convert to "real" for
           ! real because d is double and the imaginary part should be 0)
           ! and store it in d. a sequential code here is better or
           ! in a parallel environment it might need two cores for d and e
           if (kd == 0) then
               do i = 1,n
                   d(i) = (ab(abdpos,i))
               end do
               do i = 1,n - 1
                   e(i) = rzero
               end do
               hous(1) = 1
               work(1) = 1
               return
           end if
           ! case kd=1:
           ! the matrix is already tridiagonal. we have to make diagonal
           ! and offdiagonal elements real, and store them in d and e.
           ! for that, for real precision just copy the diag and offdiag
           ! to d and e while for the complex case the bulge chasing is
           ! performed to convert the hermetian tridiagonal to symmetric
           ! tridiagonal. a simpler conversion formula might be used, but then
           ! updating the q matrix will be required and based if q is generated
           ! or not this might complicate the story.
           if (kd == 1) then
               do i = 1,n
                   d(i) = (ab(abdpos,i))
               end do
               if (upper) then
                   do i = 1,n - 1
                      e(i) = (ab(abofdpos,i + 1))
                   end do
               else
                   do i = 1,n - 1
                      e(i) = (ab(abofdpos,i))
                   end do
               end if
               hous(1) = 1
               work(1) = 1
               return
           end if
           ! main code start here.
           ! reduce the symmetric band of a to a tridiagonal matrix.
           thgrsiz = n
           grsiz = 1
           shift = 3
           nbtiles = ceiling(real(n,KIND=${rk}$)/real(kd,KIND=${rk}$))
           stepercol = ceiling(real(shift,KIND=${rk}$)/real(grsiz,KIND=${rk}$))
           thgrnb = ceiling(real(n - 1,KIND=${rk}$)/real(thgrsiz,KIND=${rk}$))
           call la_${ri}$lacpy("A",kd + 1,n,ab,ldab,work(apos),lda)
           call la_${ri}$laset("A",kd,n,zero,zero,work(awpos),lda)
           ! openmp parallelisation start here
#if defined(_OPENMP)
!$OMP PARALLEL PRIVATE( TID, THGRID, BLKLASTIND )
!$OMP$         PRIVATE( THED, I, M, K, ST, ED, STT, SWEEPID )
!$OMP$         PRIVATE( MYID, TTYPE, COLPT, STIND, EDIND )
!$OMP$         SHARED ( UPLO, WANTQ, INDV, INDTAU, HOUS, WORK)
!$OMP$         SHARED ( N, KD, IB, NBTILES, LDA, LDV, INDA )
!$OMP$         SHARED ( STEPERCOL, THGRNB, THGRSIZ, GRSIZ, SHIFT )
!$OMP MASTER
#endif
           ! main bulge chasing loop
           loop_100: do thgrid = 1,thgrnb
               stt = (thgrid - 1)*thgrsiz + 1
               thed = min((stt + thgrsiz - 1), (n - 1))
               loop_110: do i = stt,n - 1
                   ed = min(i,thed)
                   if (stt > ed) exit
                   loop_120: do m = 1,stepercol
                       st = stt
                       loop_130: do sweepid = st,ed
                           loop_140: do k = 1,grsiz
                               myid = (i - sweepid)*(stepercol*grsiz) + (m - 1)*grsiz + k
                               if (myid == 1) then
                                   ttype = 1
                               else
                                   ttype = mod(myid,2) + 2
                               end if
                               if (ttype == 2) then
                                   colpt = (myid/2)*kd + sweepid
                                   stind = colpt - kd + 1
                                   edind = min(colpt,n)
                                   blklastind = colpt
                               else
                                   colpt = ((myid + 1)/2)*kd + sweepid
                                   stind = colpt - kd + 1
                                   edind = min(colpt,n)
                                   if ((stind >= edind - 1) .and. (edind == n)) then
                                       blklastind = n
                                   else
                                       blklastind = 0
                                   end if
                               end if
                               ! call the kernel
#if defined(_OPENMP) &&  _OPENMP >= 201307
                               if (ttype /= 1) then
!$OMP TASK DEPEND(in:WORK(MYID+SHIFT-1))
!$OMP$     DEPEND(in:WORK(MYID-1))
!$OMP$     DEPEND(out:WORK(MYID))
                                   tid = omp_get_thread_num()
                                   call la_${ri}$sb2st_kernels(uplo,wantq,ttype,stind,edind, &
                                   sweepid,n,kd,ib,work(inda),lda,hous(indv),hous( &
                                             indtau),ldv,work(indw + tid*kd))
!$OMP END TASK
                               else
!$OMP TASK DEPEND(in:WORK(MYID+SHIFT-1))
!$OMP$     DEPEND(out:WORK(MYID))
                                   tid = omp_get_thread_num()
                                   call la_${ri}$sb2st_kernels(uplo,wantq,ttype,stind,edind, &
                                   sweepid,n,kd,ib,work(inda),lda,hous(indv),hous( &
                                             indtau),ldv,work(indw + tid*kd))
!$OMP END TASK
                               end if
#else
                               call la_${ri}$sb2st_kernels(uplo,wantq,ttype,stind,edind, &
                               sweepid,n,kd,ib,work(inda),lda,hous(indv),hous(indtau), &
                                          ldv,work(indw + tid*kd))
#endif
                               if (blklastind >= (n - 1)) then
                                   stt = stt + 1
                                   exit
                               end if
                           end do loop_140
                       end do loop_130
                   end do loop_120
               end do loop_110
           end do loop_100
#if defined(_OPENMP)
!$OMP END MASTER
!$OMP END PARALLEL
#endif
           ! copy the diagonal from a to d. note that d is real thus only
           ! the real part is needed, the imaginary part should be zero.
           do i = 1,n
               d(i) = (work(dpos + (i - 1)*lda))
           end do
           ! copy the off diagonal from a to e. note that e is real thus only
           ! the real part is needed, the imaginary part should be zero.
           if (upper) then
               do i = 1,n - 1
                  e(i) = (work(ofdpos + i*lda))
               end do
           else
               do i = 1,n - 1
                  e(i) = (work(ofdpos + (i - 1)*lda))
               end do
           end if
           hous(1) = lhmin
           work(1) = lwmin
           return
     end subroutine la_${ri}$sytrd_sb2st
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$ORGTR: generates a real orthogonal matrix Q which is defined as the
     !> product of n-1 elementary reflectors of order N, as returned by
     !> ${ri.upper()}$SYTRD:
     !> if UPLO = 'U', Q = H(n-1) . . . H(2) H(1),
     !> if UPLO = 'L', Q = H(1) H(2) . . . H(n-1).

     pure subroutine la_${ri}$orgtr(uplo,n,a,lda,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper
           integer(ilp) :: i,iinfo,j,lwkopt,nb
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (lwork < max(1,n - 1) .and. .not. lquery) then
              info = -7
           end if
           if (info == 0) then
              if (upper) then
                 nb = la_ilaenv(1,'${ri.upper()}$ORGQL',' ',n - 1,n - 1,n - 1,-1)
              else
                 nb = la_ilaenv(1,'${ri.upper()}$ORGQR',' ',n - 1,n - 1,n - 1,-1)
              end if
              lwkopt = max(1,n - 1)*nb
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORGTR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
              work(1) = 1
              return
           end if
           if (upper) then
              ! q was determined by a call to la_${ri}$sytrd with uplo = 'u'
              ! shift the vectors which define the elementary reflectors one
              ! column to the left, and set the last row and column of q to
              ! those of the unit matrix
              do j = 1,n - 1
                 do i = 1,j - 1
                    a(i,j) = a(i,j + 1)
                 end do
                 a(n,j) = zero
              end do
              do i = 1,n - 1
                 a(i,n) = zero
              end do
              a(n,n) = one
              ! generate q(1:n-1,1:n-1)
              call la_${ri}$orgql(n - 1,n - 1,n - 1,a,lda,tau,work,lwork,iinfo)
           else
              ! q was determined by a call to la_${ri}$sytrd with uplo = 'l'.
              ! shift the vectors which define the elementary reflectors one
              ! column to the right, and set the first row and column of q to
              ! those of the unit matrix
              do j = n,2,-1
                 a(1,j) = zero
                 do i = j + 1,n
                    a(i,j) = a(i,j - 1)
                 end do
              end do
              a(1,1) = one
              do i = 2,n
                 a(i,1) = zero
              end do
              if (n > 1) then
                 ! generate q(2:n,2:n)
                 call la_${ri}$orgqr(n - 1,n - 1,n - 1,a(2,2),lda,tau,work,lwork,iinfo)

              end if
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$orgtr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$ORMTR: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'T':      Q**T * C       C * Q**T
     !> where Q is a real orthogonal matrix of order nq, with nq = m if
     !> SIDE = 'L' and nq = n if SIDE = 'R'. Q is defined as the product of
     !> nq-1 elementary reflectors, as returned by ${ri.upper()}$SYTRD:
     !> if UPLO = 'U', Q = H(nq-1) . . . H(2) H(1);
     !> if UPLO = 'L', Q = H(1) H(2) . . . H(nq-1).

     pure subroutine la_${ri}$ormtr(side,uplo,trans,m,n,a,lda,tau,c,ldc,work,lwork, &
               info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldc,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,lquery,upper
#:if rk == "sp"
           integer(ilp) :: i1,i2,iinfo,lwkopt,mi,ni,nb,nq,nw
#:else
           integer(ilp) :: i1,i2,iinfo,lwkopt,mi,nb,ni,nq,nw
#:endif
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           ! nq is the order of q and nw is the minimum dimension of work
           if (left) then
              nq = m
              nw = max(1,n)
           else
              nq = n
              nw = max(1,m)
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -2
           else if (.not. la_lsame(trans,'N') .and. .not. la_lsame(trans,'T')) &
                     then
              info = -3
           else if (m < 0) then
              info = -4
           else if (n < 0) then
              info = -5
           else if (lda < max(1,nq)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           else if (lwork < nw .and. .not. lquery) then
              info = -12
           end if
           if (info == 0) then
              if (upper) then
                 if (left) then
                    nb = la_ilaenv(1,'${ri.upper()}$ORMQL',side//trans,m - 1,n,m - 1,-1)
                 else
                    nb = la_ilaenv(1,'${ri.upper()}$ORMQL',side//trans,m,n - 1,n - 1,-1)
                 end if
              else
                 if (left) then
                    nb = la_ilaenv(1,'${ri.upper()}$ORMQR',side//trans,m - 1,n,m - 1,-1)
                 else
                    nb = la_ilaenv(1,'${ri.upper()}$ORMQR',side//trans,m,n - 1,n - 1,-1)
                 end if
              end if
              lwkopt = nw*nb
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORMTR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. nq == 1) then
              work(1) = 1
              return
           end if
           if (left) then
              mi = m - 1
              ni = n
           else
              mi = m
              ni = n - 1
           end if
           if (upper) then
              ! q was determined by a call to la_${ri}$sytrd with uplo = 'u'
              call la_${ri}$ormql(side,trans,mi,ni,nq - 1,a(1,2),lda,tau,c,ldc,work, &
                        lwork,iinfo)
           else
              ! q was determined by a call to la_${ri}$sytrd with uplo = 'l'
              if (left) then
                 i1 = 2
                 i2 = 1
              else
                 i1 = 1
                 i2 = 2
              end if
              call la_${ri}$ormqr(side,trans,mi,ni,nq - 1,a(2,1),lda,tau,c(i1,i2),ldc, &
                         work,lwork,iinfo)
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$ormtr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SBEV: computes all the eigenvalues and, optionally, eigenvectors of
     !> a real symmetric band matrix A.

     subroutine la_${ri}$sbev(jobz,uplo,n,kd,ab,ldab,w,z,ldz,work,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldz,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ab(ldab,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,wantz
           integer(ilp) :: iinfo,imax,inde,indwrk,iscale
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (kd < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SBEV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              if (lower) then
                 w(1) = ab(1,1)
              else
                 w(1) = ab(kd + 1,1)
              end if
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lansb('M',uplo,n,kd,ab,ldab,work)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 call la_${ri}$lascl('B',kd,kd,one,sigma,n,n,ab,ldab,info)
              else
                 call la_${ri}$lascl('Q',kd,kd,one,sigma,n,n,ab,ldab,info)
              end if
           end if
           ! call la_${ri}$sbtrd to reduce symmetric band matrix to tridiagonal form.
           inde = 1
           indwrk = inde + n
           call la_${ri}$sbtrd(jobz,uplo,n,kd,ab,ldab,w,work(inde),z,ldz,work(indwrk) &
                     ,iinfo)
#:if rk == "sp"
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, call la_${ri}$steqr.
#:else
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, call la_${ril}$steqr.
#:endif
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              call la_${ri}$steqr(jobz,n,w,work(inde),z,ldz,work(indwrk),info)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           return
     end subroutine la_${ri}$sbev
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SBEVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a real symmetric band matrix A.  Eigenvalues and eigenvectors can
     !> be selected by specifying either a range of values or a range of
     !> indices for the desired eigenvalues.

     subroutine la_${ri}$sbevx(jobz,range,uplo,n,kd,ab,ldab,q,ldq,vl,vu,il,iu,abstol, &
               m,w,z,ldz,work,iwork,ifail,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,kd,ldab,ldq,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(inout) :: ab(ldab,*)
           real(${rk}$),intent(out) :: q(ldq,*),w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lower,test,valeig,wantz
           character :: order
           integer(ilp) :: i,iinfo,imax,indd,inde,indee,indibl,indisp,indiwo,indwrk, &
                     iscale,itmp1,j,jj,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lower = la_lsame(uplo,'L')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (kd < 0) then
              info = -5
           else if (ldab < kd + 1) then
              info = -7
           else if (wantz .and. ldq < max(1,n)) then
              info = -9
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -11
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -12
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -13
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) info = -18
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SBEVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           if (n == 1) then
              m = 1
              if (lower) then
                 tmp1 = ab(1,1)
              else
                 tmp1 = ab(kd + 1,1)
              end if
              if (valeig) then
                 if (.not. (vl < tmp1 .and. vu >= tmp1)) m = 0
              end if
              if (m == 1) then
                 w(1) = tmp1
                 if (wantz) z(1,1) = one
              end if
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           else
              vll = zero
              vuu = zero
           end if
           anrm = la_${ri}$lansb('M',uplo,n,kd,ab,ldab,work)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 call la_${ri}$lascl('B',kd,kd,one,sigma,n,n,ab,ldab,info)
              else
                 call la_${ri}$lascl('Q',kd,kd,one,sigma,n,n,ab,ldab,info)
              end if
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! call la_${ri}$sbtrd to reduce symmetric band matrix to tridiagonal form.
           indd = 1
           inde = indd + n
           indwrk = inde + n
           call la_${ri}$sbtrd(jobz,uplo,n,kd,ab,ldab,work(indd),work(inde),q,ldq, &
                     work(indwrk),iinfo)
           ! if all eigenvalues are desired and abstol is less than or equal
#:if rk == "sp"
           ! to zero, then call la_${ri}$sterf or la_${ri}$steqr.  if this fails for some
#:else
           ! to zero, then call la_${ri}$sterf or la_${ril}$steqr.  if this fails for some
#:endif
           ! eigenvalue, then try la_${ri}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ri}$copy(n,work(indd),1,w,1)
              indee = indwrk + 2*n
              if (.not. wantz) then
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$sterf(n,w,work(indee),info)
              else
                 call la_${ri}$lacpy('A',n,n,q,ldq,z,ldz)
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$steqr(jobz,n,w,work(indee),z,ldz,work(indwrk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 30
              end if
              info = 0
           end if
#:if rk == "sp"
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ri}$stein.
#:else
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ril}$stein.
#:endif
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwo = indisp + n
           call la_${ri}$stebz(range,order,n,vll,vuu,il,iu,abstll,work(indd),work(inde &
           ),m,nsplit,w,iwork(indibl),iwork(indisp),work(indwrk),iwork(indiwo),info &
                     )
           if (wantz) then
              call la_${ri}$stein(n,work(indd),work(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,work(indwrk),iwork(indiwo),ifail,info)
              ! apply orthogonal matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              do j = 1,m
                 call la_${ri}$copy(n,z(1,j),1,work(1),1)
                 call la_${ri}$gemv('N',n,n,one,q,ldq,work,1,zero,z(1,j),1)
              end do
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           30 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$sbevx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SBGV: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a real generalized symmetric-definite banded eigenproblem, of
     !> the form A*x=(lambda)*B*x. Here A and B are assumed to be symmetric
     !> and banded, and B is also positive definite.

     pure subroutine la_${ri}$sbgv(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,w,z,ldz,work, &
               info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldz,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ab(ldab,*),bb(ldbb,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper,wantz
           character :: vect
           integer(ilp) :: iinfo,inde,indwrk
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ka < 0) then
              info = -4
           else if (kb < 0 .or. kb > ka) then
              info = -5
           else if (ldab < ka + 1) then
              info = -7
           else if (ldbb < kb + 1) then
              info = -9
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SBGV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a split cholesky factorization of b.
           call la_${ri}$pbstf(uplo,n,kb,bb,ldbb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem.
           inde = 1
           indwrk = inde + n
           call la_${ri}$sbgst(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,z,ldz,work(indwrk), &
                     iinfo)
           ! reduce to tridiagonal form.
           if (wantz) then
              vect = 'U'
           else
              vect = 'N'
           end if
           call la_${ri}$sbtrd(vect,uplo,n,ka,ab,ldab,w,work(inde),z,ldz,work(indwrk) &
                     ,iinfo)
#:if rk == "sp"
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, call la_${ri}$steqr.
#:else
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, call la_${ril}$steqr.
#:endif
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              call la_${ri}$steqr(jobz,n,w,work(inde),z,ldz,work(indwrk),info)
           end if
           return
     end subroutine la_${ri}$sbgv
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SBGVX: computes selected eigenvalues, and optionally, eigenvectors
     !> of a real generalized symmetric-definite banded eigenproblem, of
     !> the form A*x=(lambda)*B*x.  Here A and B are assumed to be symmetric
     !> and banded, and B is also positive definite.  Eigenvalues and
     !> eigenvectors can be selected by specifying either all eigenvalues,
     !> a range of values or a range of indices for the desired eigenvalues.

     pure subroutine la_${ri}$sbgvx(jobz,range,uplo,n,ka,kb,ab,ldab,bb,ldbb,q,ldq,vl, &
               vu,il,iu,abstol,m,w,z,ldz,work,iwork,ifail,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,ka,kb,ldab,ldbb,ldq,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(inout) :: ab(ldab,*),bb(ldbb,*)
           real(${rk}$),intent(out) :: q(ldq,*),w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,test,upper,valeig,wantz
           character :: order,vect
           integer(ilp) :: i,iinfo,indd,inde,indee,indibl,indisp,indiwo,indwrk,itmp1,j, &
                     jj,nsplit
           real(${rk}$) :: tmp1
           ! Intrinsic Functions
           intrinsic :: min
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (ka < 0) then
              info = -5
           else if (kb < 0 .or. kb > ka) then
              info = -6
           else if (ldab < ka + 1) then
              info = -8
           else if (ldbb < kb + 1) then
              info = -10
           else if (ldq < 1 .or. (wantz .and. ldq < n)) then
              info = -12
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -14
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -15
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -16
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -21
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SBGVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           ! form a split cholesky factorization of b.
           call la_${ri}$pbstf(uplo,n,kb,bb,ldbb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem.
           call la_${ri}$sbgst(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,q,ldq,work,iinfo)

           ! reduce symmetric band matrix to tridiagonal form.
           indd = 1
           inde = indd + n
           indwrk = inde + n
           if (wantz) then
              vect = 'U'
           else
              vect = 'N'
           end if
           call la_${ri}$sbtrd(vect,uplo,n,ka,ab,ldab,work(indd),work(inde),q,ldq, &
                     work(indwrk),iinfo)
           ! if all eigenvalues are desired and abstol is less than or equal
#:if rk == "sp"
           ! to zero, then call la_${ri}$sterf or la_${ri}$steqr.  if this fails for some
#:else
           ! to zero, then call la_${ri}$sterf or la_${ril}$steqr.  if this fails for some
#:endif
           ! eigenvalue, then try la_${ri}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ri}$copy(n,work(indd),1,w,1)
              indee = indwrk + 2*n
              call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
              if (.not. wantz) then
                 call la_${ri}$sterf(n,w,work(indee),info)
              else
                 call la_${ri}$lacpy('A',n,n,q,ldq,z,ldz)
                 call la_${ri}$steqr(jobz,n,w,work(indee),z,ldz,work(indwrk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 30
              end if
              info = 0
           end if
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired,
           ! call la_${ri}$stein.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwo = indisp + n
           call la_${ri}$stebz(range,order,n,vl,vu,il,iu,abstol,work(indd),work(inde), &
            m,nsplit,w,iwork(indibl),iwork(indisp),work(indwrk),iwork(indiwo),info)

           if (wantz) then
              call la_${ri}$stein(n,work(indd),work(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,work(indwrk),iwork(indiwo),ifail,info)
              ! apply transformation matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              do j = 1,m
                 call la_${ri}$copy(n,z(1,j),1,work(1),1)
                 call la_${ri}$gemv('N',n,n,one,q,ldq,work,1,zero,z(1,j),1)
              end do
           end if
           30 continue
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$sbgvx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SPEV: computes all the eigenvalues and, optionally, eigenvectors of a
     !> real symmetric matrix A in packed storage.

     subroutine la_${ri}$spev(jobz,uplo,n,ap,w,z,ldz,work,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldz,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ap(*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: wantz
           integer(ilp) :: iinfo,imax,inde,indtau,indwrk,iscale
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (la_lsame(uplo,'U') .or. la_lsame(uplo,'L'))) &
                     then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SPEV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = ap(1)
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lansp('M',uplo,n,ap,work)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              call la_${ri}$scal((n*(n + 1))/2,sigma,ap,1)
           end if
           ! call la_${ri}$sptrd to reduce symmetric packed matrix to tridiagonal form.
           inde = 1
           indtau = inde + n
           call la_${ri}$sptrd(uplo,n,ap,w,work(inde),work(indtau),iinfo)
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, first call
           ! la_${ri}$opgtr to generate the orthogonal matrix, then call la_${ri}$steqr.
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              indwrk = indtau + n
              call la_${ri}$opgtr(uplo,n,ap,work(indtau),z,ldz,work(indwrk),iinfo)

              call la_${ri}$steqr(jobz,n,w,work(inde),z,ldz,work(indtau),info)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           return
     end subroutine la_${ri}$spev
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SPEVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a real symmetric matrix A in packed storage.  Eigenvalues/vectors
     !> can be selected by specifying either a range of values or a range of
     !> indices for the desired eigenvalues.

     subroutine la_${ri}$spevx(jobz,range,uplo,n,ap,vl,vu,il,iu,abstol,m,w,z,ldz, &
               work,iwork,ifail,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(inout) :: ap(*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,test,valeig,wantz
           character :: order
           integer(ilp) :: i,iinfo,imax,indd,inde,indee,indibl,indisp,indiwo,indtau, &
                     indwrk,iscale,itmp1,j,jj,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (la_lsame(uplo,'L') .or. la_lsame(uplo,'U'))) &
                     then
              info = -3
           else if (n < 0) then
              info = -4
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -7
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -8
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -9
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) info = -14
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SPEVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           if (n == 1) then
              if (alleig .or. indeig) then
                 m = 1
                 w(1) = ap(1)
              else
                 if (vl < ap(1) .and. vu >= ap(1)) then
                    m = 1
                    w(1) = ap(1)
                 end if
              end if
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           else
              vll = zero
              vuu = zero
           end if
           anrm = la_${ri}$lansp('M',uplo,n,ap,work)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              call la_${ri}$scal((n*(n + 1))/2,sigma,ap,1)
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! call la_${ri}$sptrd to reduce symmetric packed matrix to tridiagonal form.
           indtau = 1
           inde = indtau + n
           indd = inde + n
           indwrk = indd + n
           call la_${ri}$sptrd(uplo,n,ap,work(indd),work(inde),work(indtau),iinfo)

           ! if all eigenvalues are desired and abstol is less than or equal
#:if rk == "sp"
           ! to zero, then call la_${ri}$sterf or la_${ri}$opgtr and la_${ri}$steqr.  if this fails
#:else
           ! to zero, then call la_${ri}$sterf or la_${ri}$opgtr and la_${ril}$steqr.  if this fails
#:endif
           ! for some eigenvalue, then try la_${ri}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ri}$copy(n,work(indd),1,w,1)
              indee = indwrk + 2*n
              if (.not. wantz) then
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$sterf(n,w,work(indee),info)
              else
                 call la_${ri}$opgtr(uplo,n,ap,work(indtau),z,ldz,work(indwrk),iinfo)

                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$steqr(jobz,n,w,work(indee),z,ldz,work(indwrk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 20
              end if
              info = 0
           end if
#:if rk == "sp"
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ri}$stein.
#:else
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ril}$stein.
#:endif
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwo = indisp + n
           call la_${ri}$stebz(range,order,n,vll,vuu,il,iu,abstll,work(indd),work(inde &
           ),m,nsplit,w,iwork(indibl),iwork(indisp),work(indwrk),iwork(indiwo),info &
                     )
           if (wantz) then
              call la_${ri}$stein(n,work(indd),work(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,work(indwrk),iwork(indiwo),ifail,info)
              ! apply orthogonal matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              call la_${ri}$opmtr('L',uplo,'N',n,m,ap,work(indtau),z,ldz,work(indwrk), &
                         iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           20 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$spevx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SPGV: computes all the eigenvalues and, optionally, the eigenvectors
     !> of a real generalized symmetric-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.
     !> Here A and B are assumed to be symmetric, stored in packed format,
     !> and B is also positive definite.

     subroutine la_${ri}$spgv(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,ldz,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ap(*),bp(*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper,wantz
           character :: trans
           integer(ilp) :: j,neig
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SPGV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$pptrf(uplo,n,bp,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$spgst(itype,uplo,n,ap,bp,info)
           call la_${ri}$spev(jobz,uplo,n,ap,w,z,ldz,work,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              neig = n
              if (info > 0) neig = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**t*y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'T'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpsv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**t*y
                 if (upper) then
                    trans = 'T'
                 else
                    trans = 'N'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpmv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              end if
           end if
           return
     end subroutine la_${ri}$spgv
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SPGVX: computes selected eigenvalues, and optionally, eigenvectors
     !> of a real generalized symmetric-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A
     !> and B are assumed to be symmetric, stored in packed storage, and B
     !> is also positive definite.  Eigenvalues and eigenvectors can be
     !> selected by specifying either a range of values or a range of indices
     !> for the desired eigenvalues.

     subroutine la_${ri}$spgvx(itype,jobz,range,uplo,n,ap,bp,vl,vu,il,iu,abstol,m,w, &
               z,ldz,work,iwork,ifail,info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,itype,iu,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(inout) :: ap(*),bp(*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
       ! =====================================================================
           ! Local Scalars
           logical(lk) :: alleig,indeig,upper,valeig,wantz
           character :: trans
           integer(ilp) :: j
           ! Intrinsic Functions
           intrinsic :: min
           ! Executable Statements
           ! test the input parameters.
           upper = la_lsame(uplo,'U')
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -3
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -4
           else if (n < 0) then
              info = -5
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) then
                    info = -9
                 end if
              else if (indeig) then
                 if (il < 1) then
                    info = -10
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -11
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -16
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SPGVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$pptrf(uplo,n,bp,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$spgst(itype,uplo,n,ap,bp,info)
           call la_${ri}$spevx(jobz,range,uplo,n,ap,vl,vu,il,iu,abstol,m,w,z,ldz, &
                     work,iwork,ifail,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              if (info > 0) m = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**t*y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'T'
                 end if
                 do j = 1,m
                    call la_${ri}$tpsv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**t*y
                 if (upper) then
                    trans = 'T'
                 else
                    trans = 'N'
                 end if
                 do j = 1,m
                    call la_${ri}$tpmv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              end if
           end if
           return
     end subroutine la_${ri}$spgvx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYEV: computes all eigenvalues and, optionally, eigenvectors of a
     !> real symmetric matrix A.

     subroutine la_${ri}$syev(jobz,uplo,n,a,lda,w,work,lwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: w(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,lquery,wantz
           integer(ilp) :: iinfo,imax,inde,indtau,indwrk,iscale,llwork,lwkopt,nb
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: max,sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           lquery = (lwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           end if
           if (info == 0) then
              nb = la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
              lwkopt = max(1, (nb + 2)*n)
              work(1) = lwkopt
              if (lwork < max(1,3*n - 1) .and. .not. lquery) info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYEV ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
              return
           end if
           if (n == 1) then
              w(1) = a(1,1)
              work(1) = 2
              if (wantz) a(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lansy('M',uplo,n,a,lda,work)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) call la_${ri}$lascl(uplo,0,0,one,sigma,n,n,a,lda,info)
           ! call la_${ri}$sytrd to reduce symmetric matrix to tridiagonal form.
           inde = 1
           indtau = inde + n
           indwrk = indtau + n
           llwork = lwork - indwrk + 1
           call la_${ri}$sytrd(uplo,n,a,lda,w,work(inde),work(indtau),work(indwrk), &
                     llwork,iinfo)
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, first call
           ! la_${ri}$orgtr to generate the orthogonal matrix, then call la_${ri}$steqr.
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              call la_${ri}$orgtr(uplo,n,a,lda,work(indtau),work(indwrk),llwork,iinfo)

              call la_${ri}$steqr(jobz,n,w,work(inde),a,lda,work(indtau),info)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           ! set work(1) to optimal workspace size.
           work(1) = lwkopt
           return
     end subroutine la_${ri}$syev
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYEVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a real symmetric matrix A.  Eigenvalues and eigenvectors can be
     !> selected by specifying either a range of values or a range of indices
     !> for the desired eigenvalues.

     subroutine la_${ri}$syevx(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z,ldz, &
               work,lwork,iwork,ifail,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,lda,ldz,lwork,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
       ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lower,lquery,test,valeig,wantz
           character :: order
           integer(ilp) :: i,iinfo,imax,indd,inde,indee,indibl,indisp,indiwo,indtau, &
           indwkn,indwrk,iscale,itmp1,j,jj,llwork,llwrkn,lwkmin,lwkopt,nb, &
                     nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           lower = la_lsame(uplo,'L')
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lquery = (lwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -8
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -9
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -10
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -15
              end if
           end if
           if (info == 0) then
              if (n <= 1) then
                 lwkmin = 1
                 work(1) = lwkmin
              else
                 lwkmin = 8*n
                 nb = la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
                 nb = max(nb,la_ilaenv(1,'${ri.upper()}$ORMTR',uplo,n,-1,-1,-1))
                 lwkopt = max(lwkmin, (nb + 3)*n)
                 work(1) = lwkopt
              end if
              if (lwork < lwkmin .and. .not. lquery) info = -17
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYEVX',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) then
              return
           end if
           if (n == 1) then
              if (alleig .or. indeig) then
                 m = 1
                 w(1) = a(1,1)
              else
                 if (vl < a(1,1) .and. vu >= a(1,1)) then
                    m = 1
                    w(1) = a(1,1)
                 end if
              end if
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           end if
           anrm = la_${ri}$lansy('M',uplo,n,a,lda,work)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 do j = 1,n
                    call la_${ri}$scal(n - j + 1,sigma,a(j,j),1)
                 end do
              else
                 do j = 1,n
                    call la_${ri}$scal(j,sigma,a(1,j),1)
                 end do
              end if
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! call la_${ri}$sytrd to reduce symmetric matrix to tridiagonal form.
           indtau = 1
           inde = indtau + n
           indd = inde + n
           indwrk = indd + n
           llwork = lwork - indwrk + 1
           call la_${ri}$sytrd(uplo,n,a,lda,work(indd),work(inde),work(indtau),work( &
                     indwrk),llwork,iinfo)
           ! if all eigenvalues are desired and abstol is less than or equal to
#:if rk == "sp"
           ! zero, then call la_${ri}$sterf or la_${ri}$orgtr and la_${ri}$steqr.  if this fails for
#:else
           ! zero, then call la_${ri}$sterf or la_${ri}$orgtr and la_${ril}$steqr.  if this fails for
#:endif
           ! some eigenvalue, then try la_${ri}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ri}$copy(n,work(indd),1,w,1)
              indee = indwrk + 2*n
              if (.not. wantz) then
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$sterf(n,w,work(indee),info)
              else
                 call la_${ri}$lacpy('A',n,n,a,lda,z,ldz)
                 call la_${ri}$orgtr(uplo,n,z,ldz,work(indtau),work(indwrk),llwork, &
                           iinfo)
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$steqr(jobz,n,w,work(indee),z,ldz,work(indwrk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 40
              end if
              info = 0
           end if
#:if rk == "sp"
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ri}$stein.
#:else
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ril}$stein.
#:endif
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwo = indisp + n
           call la_${ri}$stebz(range,order,n,vll,vuu,il,iu,abstll,work(indd),work(inde &
           ),m,nsplit,w,iwork(indibl),iwork(indisp),work(indwrk),iwork(indiwo),info &
                     )
           if (wantz) then
              call la_${ri}$stein(n,work(indd),work(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,work(indwrk),iwork(indiwo),ifail,info)
              ! apply orthogonal matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              indwkn = inde
              llwrkn = lwork - indwkn + 1
              call la_${ri}$ormtr('L',uplo,'N',n,m,a,lda,work(indtau),z,ldz,work( &
                        indwkn),llwrkn,iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           40 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           ! set work(1) to optimal workspace size.
           work(1) = lwkopt
           return
     end subroutine la_${ri}$syevx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYGV: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a real generalized symmetric-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.
     !> Here A and B are assumed to be symmetric and B is also
     !> positive definite.

     subroutine la_${ri}$sygv(itype,jobz,uplo,n,a,lda,b,ldb,w,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,lda,ldb,lwork,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: w(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: trans
           integer(ilp) :: lwkmin,lwkopt,nb,neig
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info == 0) then
              lwkmin = max(1,3*n - 1)
              nb = la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
              lwkopt = max(lwkmin, (nb + 2)*n)
              work(1) = lwkopt
              if (lwork < lwkmin .and. .not. lquery) then
                 info = -11
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYGV ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$potrf(uplo,n,b,ldb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$sygst(itype,uplo,n,a,lda,b,ldb,info)
           call la_${ri}$syev(jobz,uplo,n,a,lda,w,work,lwork,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              neig = n
              if (info > 0) neig = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**t*y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'T'
                 end if
                 call la_${ri}$trsm('LEFT',uplo,trans,'NON-UNIT',n,neig,one,b,ldb,a,lda)

              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**t*y
                 if (upper) then
                    trans = 'T'
                 else
                    trans = 'N'
                 end if
                 call la_${ri}$trmm('LEFT',uplo,trans,'NON-UNIT',n,neig,one,b,ldb,a,lda)

              end if
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$sygv
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYGVX: computes selected eigenvalues, and optionally, eigenvectors
     !> of a real generalized symmetric-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A
     !> and B are assumed to be symmetric and B is also positive definite.
     !> Eigenvalues and eigenvectors can be selected by specifying either a
     !> range of values or a range of indices for the desired eigenvalues.

     subroutine la_${ri}$sygvx(itype,jobz,range,uplo,n,a,lda,b,ldb,vl,vu,il,iu,abstol, &
                m,w,z,ldz,work,lwork,iwork,ifail,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,itype,iu,lda,ldb,ldz,lwork,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
       ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lquery,upper,valeig,wantz
           character :: trans
           integer(ilp) :: lwkmin,lwkopt,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           upper = la_lsame(uplo,'U')
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lquery = (lwork == -1)
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -3
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -4
           else if (n < 0) then
              info = -5
           else if (lda < max(1,n)) then
              info = -7
           else if (ldb < max(1,n)) then
              info = -9
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -11
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -12
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -13
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -18
              end if
           end if
           if (info == 0) then
              lwkmin = max(1,8*n)
              nb = la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
              lwkopt = max(lwkmin, (nb + 3)*n)
              work(1) = lwkopt
              if (lwork < lwkmin .and. .not. lquery) then
                 info = -20
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYGVX',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) then
              return
           end if
           ! form a cholesky factorization of b.
           call la_${ri}$potrf(uplo,n,b,ldb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$sygst(itype,uplo,n,a,lda,b,ldb,info)
           call la_${ri}$syevx(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z,ldz, &
                     work,lwork,iwork,ifail,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              if (info > 0) m = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**t*y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'T'
                 end if
                 call la_${ri}$trsm('LEFT',uplo,trans,'NON-UNIT',n,m,one,b,ldb,z,ldz)

              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**t*y
                 if (upper) then
                    trans = 'T'
                 else
                    trans = 'N'
                 end if
                 call la_${ri}$trmm('LEFT',uplo,trans,'NON-UNIT',n,m,one,b,ldb,z,ldz)

              end if
           end if
           ! set work(1) to optimal workspace size.
           work(1) = lwkopt
           return
     end subroutine la_${ri}$sygvx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYTRD_SY2SB: reduces a real symmetric matrix A to real symmetric
     !> band-diagonal form AB by a orthogonal similarity transformation:
     !> Q**T * A * Q = AB.

     pure subroutine la_${ri}$sytrd_sy2sb(uplo,n,kd,a,lda,ab,ldab,tau,work,lwork,info)
        use la_constants_${rk}$

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldab,lwork,n,kd
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: ab(ldab,*),tau(*),work(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: rone = 1.0e+0_${rk}$

           ! Local Scalars
           logical(lk) :: lquery,upper
           integer(ilp) :: i,j,iinfo,lwmin,pn,pk,lk,ldt,ldw,lds2,lds1,ls2,ls1,lw,lt, &
                      tpos,wpos,s2pos,s1pos
           ! Intrinsic Functions
           intrinsic :: min,max
           ! Executable Statements
           ! determine the minimal workspace size required
           ! and test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           lwmin = la_ilaenv2stage(4,'${ri.upper()}$SYTRD_SY2SB','',n,kd,-1,-1)
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldab < max(1,kd + 1)) then
              info = -7
           else if (lwork < lwmin .and. .not. lquery) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYTRD_SY2SB',-info)
              return
           else if (lquery) then
              work(1) = lwmin
              return
           end if
           ! quick return if possible
           ! copy the upper/lower portion of a into ab
           if (n <= kd + 1) then
               if (upper) then
                   do i = 1,n
                       lk = min(kd + 1,i)
                       call la_${ri}$copy(lk,a(i - lk + 1,i),1,ab(kd + 1 - lk + 1,i),1)
                   end do
               else
                   do i = 1,n
                       lk = min(kd + 1,n - i + 1)
                       call la_${ri}$copy(lk,a(i,i),1,ab(1,i),1)
                   end do
               end if
               work(1) = 1
               return
           end if
           ! determine the pointer position for the workspace
           ldt = kd
           lds1 = kd
           lt = ldt*kd
           lw = n*kd
           ls1 = lds1*kd
           ls2 = lwmin - lt - lw - ls1
            ! ls2 = n*max(kd,factoptnb)
           tpos = 1
           wpos = tpos + lt
           s1pos = wpos + lw
           s2pos = s1pos + ls1
           if (upper) then
               ldw = kd
               lds2 = kd
           else
               ldw = n
               lds2 = n
           end if
           ! set the workspace of the triangular matrix t to zero once such a
           ! way every time t is generated the upper/lower portion will be always zero
           call la_${ri}$laset("A",ldt,kd,zero,zero,work(tpos),ldt)
           if (upper) then
               do i = 1,n - kd,kd
                  pn = n - i - kd + 1
                  pk = min(n - i - kd + 1,kd)
                  ! compute the lq factorization of the current block
                  call la_${ri}$gelqf(kd,pn,a(i,i + kd),lda,tau(i),work(s2pos),ls2, &
                            iinfo)
                  ! copy the upper portion of a into ab
                  do j = i,i + pk - 1
                     lk = min(kd,n - j) + 1
                     call la_${ri}$copy(lk,a(j,j),lda,ab(kd + 1,j),ldab - 1)
                  end do
                  call la_${ri}$laset('LOWER',pk,pk,zero,one,a(i,i + kd),lda)
                  ! form the matrix t
                  call la_${ri}$larft('FORWARD','ROWWISE',pn,pk,a(i,i + kd),lda,tau(i), &
                            work(tpos),ldt)
                  ! compute w:
                  call la_${ri}$gemm('CONJUGATE','NO TRANSPOSE',pk,pn,pk,one,work(tpos), &
                            ldt,a(i,i + kd),lda,zero,work(s2pos),lds2)
                  call la_${ri}$symm('RIGHT',uplo,pk,pn,one,a(i + kd,i + kd),lda,work(s2pos &
                            ),lds2,zero,work(wpos),ldw)
                  call la_${ri}$gemm('NO TRANSPOSE','CONJUGATE',pk,pk,pn,one,work(wpos), &
                            ldw,work(s2pos),lds2,zero,work(s1pos),lds1)
                  call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',pk,pn,pk,-half,work( &
                            s1pos),lds1,a(i,i + kd),lda,one,work(wpos),ldw)
                  ! update the unreduced submatrix a(i+kd:n,i+kd:n), using
                  ! an update of the form:  a := a - v'*w - w'*v
                  call la_${ri}$syr2k(uplo,'CONJUGATE',pn,pk,-one,a(i,i + kd),lda,work( &
                            wpos),ldw,rone,a(i + kd,i + kd),lda)
               end do
              ! copy the upper band to ab which is the band storage matrix
              do j = n - kd + 1,n
                 lk = min(kd,n - j) + 1
                 call la_${ri}$copy(lk,a(j,j),lda,ab(kd + 1,j),ldab - 1)
              end do
           else
               ! reduce the lower triangle of a to lower band matrix
               loop_40: do i = 1,n - kd,kd
                  pn = n - i - kd + 1
                  pk = min(n - i - kd + 1,kd)
                  ! compute the qr factorization of the current block
                  call la_${ri}$geqrf(pn,kd,a(i + kd,i),lda,tau(i),work(s2pos),ls2, &
                            iinfo)
                  ! copy the upper portion of a into ab
                  do j = i,i + pk - 1
                     lk = min(kd,n - j) + 1
                     call la_${ri}$copy(lk,a(j,j),1,ab(1,j),1)
                  end do
                  call la_${ri}$laset('UPPER',pk,pk,zero,one,a(i + kd,i),lda)
                  ! form the matrix t
                  call la_${ri}$larft('FORWARD','COLUMNWISE',pn,pk,a(i + kd,i),lda,tau(i), &
                            work(tpos),ldt)
                  ! compute w:
                  call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',pn,pk,pk,one,a(i + kd,i), &
                             lda,work(tpos),ldt,zero,work(s2pos),lds2)
                  call la_${ri}$symm('LEFT',uplo,pn,pk,one,a(i + kd,i + kd),lda,work(s2pos), &
                             lds2,zero,work(wpos),ldw)
                  call la_${ri}$gemm('CONJUGATE','NO TRANSPOSE',pk,pk,pn,one,work(s2pos), &
                            lds2,work(wpos),ldw,zero,work(s1pos),lds1)
                  call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',pn,pk,pk,-half,a(i + kd,i &
                            ),lda,work(s1pos),lds1,one,work(wpos),ldw)
                  ! update the unreduced submatrix a(i+kd:n,i+kd:n), using
                  ! an update of the form:  a := a - v*w' - w*v'
                  call la_${ri}$syr2k(uplo,'NO TRANSPOSE',pn,pk,-one,a(i + kd,i),lda,work( &
                            wpos),ldw,rone,a(i + kd,i + kd),lda)
                  ! ==================================================================
                  ! restore a for comparison and checking to be removed
                   ! do 45 j = i, i+pk-1
                      ! lk = min( kd, n-j ) + 1
                      ! call la_${ri}$copy( lk, ab( 1, j ), 1, a( j, j ), 1 )
                      45 continue
                  ! ==================================================================
               end do loop_40
              ! copy the lower band to ab which is the band storage matrix
              do j = n - kd + 1,n
                 lk = min(kd,n - j) + 1
                 call la_${ri}$copy(lk,a(j,j),1,ab(1,j),1)
              end do
           end if
           work(1) = lwmin
           return
     end subroutine la_${ri}$sytrd_sy2sb
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYEVD: computes all eigenvalues and, optionally, eigenvectors of a
     !> real symmetric matrix A. If eigenvectors are desired, it uses a
     !> divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.
     !> Because of large use of BLAS of level 3, ${ri.upper()}$SYEVD needs N**2 more
     !> workspace than ${ri.upper()}$SYEVX.

     subroutine la_${ri}$syevd(jobz,uplo,n,a,lda,w,work,lwork,iwork,liwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,liwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: w(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,lquery,wantz
           integer(ilp) :: iinfo,inde,indtau,indwk2,indwrk,iscale,liopt,liwmin,llwork, &
                     llwrk2,lopt,lwmin
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: max,sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           lquery = (lwork == -1 .or. liwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           end if
           if (info == 0) then
              if (n <= 1) then
                 liwmin = 1
                 lwmin = 1
                 lopt = lwmin
                 liopt = liwmin
              else
                 if (wantz) then
                    liwmin = 3 + 5*n
                    lwmin = 1 + 6*n + 2*n**2
                 else
                    liwmin = 1
                    lwmin = 2*n + 1
                 end if
                 lopt = max(lwmin,2*n + la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1))

                 liopt = liwmin
              end if
              work(1) = lopt
              iwork(1) = liopt
              if (lwork < lwmin .and. .not. lquery) then
                 info = -8
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -10
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYEVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = a(1,1)
              if (wantz) a(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lansy('M',uplo,n,a,lda,work)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) call la_${ri}$lascl(uplo,0,0,one,sigma,n,n,a,lda,info)
           ! call la_${ri}$sytrd to reduce symmetric matrix to tridiagonal form.
           inde = 1
           indtau = inde + n
           indwrk = indtau + n
           llwork = lwork - indwrk + 1
           indwk2 = indwrk + n*n
           llwrk2 = lwork - indwk2 + 1
           call la_${ri}$sytrd(uplo,n,a,lda,w,work(inde),work(indtau),work(indwrk), &
                     llwork,iinfo)
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, first call
           ! la_${ri}$stedc to generate the eigenvector matrix, work(indwrk), of the
           ! tridiagonal matrix, then call la_${ri}$ormtr to multiply it by the
           ! householder transformations stored in a.
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              call la_${ri}$stedc('I',n,w,work(inde),work(indwrk),n,work(indwk2), &
                        llwrk2,iwork,liwork,info)
              call la_${ri}$ormtr('L',uplo,'N',n,n,a,lda,work(indtau),work(indwrk),n, &
                        work(indwk2),llwrk2,iinfo)
              call la_${ri}$lacpy('A',n,n,work(indwrk),n,a,lda)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) call la_${ri}$scal(n,one/sigma,w,1)
           work(1) = lopt
           iwork(1) = liopt
           return
     end subroutine la_${ri}$syevd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYGVD: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a real generalized symmetric-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and
     !> B are assumed to be symmetric and B is also positive definite.
     !> If eigenvectors are desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$sygvd(itype,jobz,uplo,n,a,lda,b,ldb,w,work,lwork,iwork,liwork, &
                info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,lda,ldb,liwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: w(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: trans
           integer(ilp) :: liopt,liwmin,lopt,lwmin
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,real
#:else
           intrinsic :: real,max
#:endif
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1 .or. liwork == -1)
           info = 0
           if (n <= 1) then
              liwmin = 1
              lwmin = 1
           else if (wantz) then
              liwmin = 3 + 5*n
              lwmin = 1 + 6*n + 2*n**2
           else
              liwmin = 1
              lwmin = 2*n + 1
           end if
           lopt = lwmin
           liopt = liwmin
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info == 0) then
              work(1) = lopt
              iwork(1) = liopt
              if (lwork < lwmin .and. .not. lquery) then
                 info = -11
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -13
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYGVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$potrf(uplo,n,b,ldb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$sygst(itype,uplo,n,a,lda,b,ldb,info)
           call la_${ri}$syevd(jobz,uplo,n,a,lda,w,work,lwork,iwork,liwork,info)
           lopt = max(real(lopt,KIND=${rk}$),real(work(1),KIND=${rk}$))
           liopt = max(real(liopt,KIND=${rk}$),real(iwork(1),KIND=${rk}$))
           if (wantz .and. info == 0) then
              ! backtransform eigenvectors to the original problem.
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**t*y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'T'
                 end if
                 call la_${ri}$trsm('LEFT',uplo,trans,'NON-UNIT',n,n,one,b,ldb,a,lda)

              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**t*y
                 if (upper) then
                    trans = 'T'
                 else
                    trans = 'N'
                 end if
                 call la_${ri}$trmm('LEFT',uplo,trans,'NON-UNIT',n,n,one,b,ldb,a,lda)

              end if
           end if
           work(1) = lopt
           iwork(1) = liopt
           return
     end subroutine la_${ri}$sygvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SBEVD: computes all the eigenvalues and, optionally, eigenvectors of
     !> a real symmetric band matrix A. If eigenvectors are desired, it uses
     !> a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$sbevd(jobz,uplo,n,kd,ab,ldab,w,z,ldz,work,lwork,iwork,liwork, &
               info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldz,liwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: ab(ldab,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,lquery,wantz
           integer(ilp) :: iinfo,inde,indwk2,indwrk,iscale,liwmin,llwrk2,lwmin
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           lquery = (lwork == -1 .or. liwork == -1)
           info = 0
           if (n <= 1) then
              liwmin = 1
              lwmin = 1
           else
              if (wantz) then
                 liwmin = 3 + 5*n
                 lwmin = 1 + 5*n + 2*n**2
              else
                 liwmin = 1
                 lwmin = 2*n
              end if
           end if
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (kd < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info == 0) then
              work(1) = lwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -11
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -13
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SBEVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = ab(1,1)
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lansb('M',uplo,n,kd,ab,ldab,work)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 call la_${ri}$lascl('B',kd,kd,one,sigma,n,n,ab,ldab,info)
              else
                 call la_${ri}$lascl('Q',kd,kd,one,sigma,n,n,ab,ldab,info)
              end if
           end if
           ! call la_${ri}$sbtrd to reduce symmetric band matrix to tridiagonal form.
           inde = 1
           indwrk = inde + n
           indwk2 = indwrk + n*n
           llwrk2 = lwork - indwk2 + 1
           call la_${ri}$sbtrd(jobz,uplo,n,kd,ab,ldab,w,work(inde),z,ldz,work(indwrk) &
                     ,iinfo)
#:if rk == "sp"
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, call la_${ri}$stedc.
#:else
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, call la_${ril}$stedc.
#:endif
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              call la_${ri}$stedc('I',n,w,work(inde),work(indwrk),n,work(indwk2), &
                        llwrk2,iwork,liwork,info)
              call la_${ri}$gemm('N','N',n,n,n,one,z,ldz,work(indwrk),n,zero,work( &
                        indwk2),n)
              call la_${ri}$lacpy('A',n,n,work(indwk2),n,z,ldz)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) call la_${ri}$scal(n,one/sigma,w,1)
           work(1) = lwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$sbevd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SBGVD: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a real generalized symmetric-definite banded eigenproblem, of the
     !> form A*x=(lambda)*B*x.  Here A and B are assumed to be symmetric and
     !> banded, and B is also positive definite.  If eigenvectors are
     !> desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     pure subroutine la_${ri}$sbgvd(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,w,z,ldz,work, &
               lwork,iwork,liwork,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldz,liwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: ab(ldab,*),bb(ldbb,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: vect
           integer(ilp) :: iinfo,inde,indwk2,indwrk,liwmin,llwrk2,lwmin
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1 .or. liwork == -1)
           info = 0
           if (n <= 1) then
              liwmin = 1
              lwmin = 1
           else if (wantz) then
              liwmin = 3 + 5*n
              lwmin = 1 + 5*n + 2*n**2
           else
              liwmin = 1
              lwmin = 2*n
           end if
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ka < 0) then
              info = -4
           else if (kb < 0 .or. kb > ka) then
              info = -5
           else if (ldab < ka + 1) then
              info = -7
           else if (ldbb < kb + 1) then
              info = -9
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -12
           end if
           if (info == 0) then
              work(1) = lwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -14
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -16
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SBGVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a split cholesky factorization of b.
           call la_${ri}$pbstf(uplo,n,kb,bb,ldbb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem.
           inde = 1
           indwrk = inde + n
           indwk2 = indwrk + n*n
           llwrk2 = lwork - indwk2 + 1
           call la_${ri}$sbgst(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,z,ldz,work,iinfo)

           ! reduce to tridiagonal form.
           if (wantz) then
              vect = 'U'
           else
              vect = 'N'
           end if
           call la_${ri}$sbtrd(vect,uplo,n,ka,ab,ldab,w,work(inde),z,ldz,work(indwrk) &
                     ,iinfo)
#:if rk == "sp"
           ! for eigenvalues only, call la_${ri}$sterf. for eigenvectors, call la_${ri}$stedc.
#:else
           ! for eigenvalues only, call la_${ri}$sterf. for eigenvectors, call la_${ril}$stedc.
#:endif
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              call la_${ri}$stedc('I',n,w,work(inde),work(indwrk),n,work(indwk2), &
                        llwrk2,iwork,liwork,info)
              call la_${ri}$gemm('N','N',n,n,n,one,z,ldz,work(indwrk),n,zero,work( &
                        indwk2),n)
              call la_${ri}$lacpy('A',n,n,work(indwk2),n,z,ldz)
           end if
           work(1) = lwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$sbgvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SPEVD: computes all the eigenvalues and, optionally, eigenvectors
     !> of a real symmetric matrix A in packed storage. If eigenvectors are
     !> desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$spevd(jobz,uplo,n,ap,w,z,ldz,work,lwork,iwork,liwork,info)
        use la_constants_${rk}$,only:zero,one

        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldz,liwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: ap(*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,wantz
           integer(ilp) :: iinfo,inde,indtau,indwrk,iscale,liwmin,llwork,lwmin
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lquery = (lwork == -1 .or. liwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (la_lsame(uplo,'U') .or. la_lsame(uplo,'L'))) &
                     then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -7
           end if
           if (info == 0) then
              if (n <= 1) then
                 liwmin = 1
                 lwmin = 1
              else
                 if (wantz) then
                    liwmin = 3 + 5*n
                    lwmin = 1 + 6*n + n**2
                 else
                    liwmin = 1
                    lwmin = 2*n
                 end if
              end if
              iwork(1) = liwmin
              work(1) = lwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -9
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -11
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SPEVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = ap(1)
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lansp('M',uplo,n,ap,work)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              call la_${ri}$scal((n*(n + 1))/2,sigma,ap,1)
           end if
           ! call la_${ri}$sptrd to reduce symmetric packed matrix to tridiagonal form.
           inde = 1
           indtau = inde + n
           call la_${ri}$sptrd(uplo,n,ap,w,work(inde),work(indtau),iinfo)
           ! for eigenvalues only, call la_${ri}$sterf.  for eigenvectors, first call
           ! la_${ri}$stedc to generate the eigenvector matrix, work(indwrk), of the
           ! tridiagonal matrix, then call la_${ri}$opmtr to multiply it by the
           ! householder transformations represented in ap.
           if (.not. wantz) then
              call la_${ri}$sterf(n,w,work(inde),info)
           else
              indwrk = indtau + n
              llwork = lwork - indwrk + 1
              call la_${ri}$stedc('I',n,w,work(inde),z,ldz,work(indwrk),llwork,iwork, &
                        liwork,info)
              call la_${ri}$opmtr('L',uplo,'N',n,n,ap,work(indtau),z,ldz,work(indwrk), &
                         iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) call la_${ri}$scal(n,one/sigma,w,1)
           work(1) = lwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$spevd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SPGVD: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a real generalized symmetric-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and
     !> B are assumed to be symmetric, stored in packed format, and B is also
     !> positive definite.
     !> If eigenvectors are desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$spgvd(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,lwork,iwork,liwork, &
                info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,ldz,liwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: ap(*),bp(*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: trans
           integer(ilp) :: j,liwmin,lwmin,neig
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,real
#:else
           intrinsic :: real,max
#:endif
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1 .or. liwork == -1)
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info == 0) then
              if (n <= 1) then
                 liwmin = 1
                 lwmin = 1
              else
                 if (wantz) then
                    liwmin = 3 + 5*n
                    lwmin = 1 + 6*n + 2*n**2
                 else
                    liwmin = 1
                    lwmin = 2*n
                 end if
              end if
              work(1) = lwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -11
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -13
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SPGVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of bp.
           call la_${ri}$pptrf(uplo,n,bp,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$spgst(itype,uplo,n,ap,bp,info)
           call la_${ri}$spevd(jobz,uplo,n,ap,w,z,ldz,work,lwork,iwork,liwork,info)

           lwmin = max(real(lwmin,KIND=${rk}$),real(work(1),KIND=${rk}$))
           liwmin = max(real(liwmin,KIND=${rk}$),real(iwork(1),KIND=${rk}$))
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              neig = n
              if (info > 0) neig = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**t *y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'T'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpsv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**t *y
                 if (upper) then
                    trans = 'T'
                 else
                    trans = 'N'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpmv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              end if
           end if
           work(1) = lwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$spgvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$SYEVR: computes selected eigenvalues and, optionally, eigenvectors
     !> of a real symmetric matrix A.  Eigenvalues and eigenvectors can be
     !> selected by specifying either a range of values or a range of
     !> indices for the desired eigenvalues.
     !> ${ri.upper()}$SYEVR first reduces the matrix A to tridiagonal form T with a call
     !> to ${ri.upper()}$SYTRD.  Then, whenever possible, ${ri.upper()}$SYEVR calls ${ri.upper()}$STEMR to compute
     !> the eigenspectrum using Relatively Robust Representations.  ${ri.upper()}$STEMR
     !> computes eigenvalues by the dqds algorithm, while orthogonal
     !> eigenvectors are computed from various "good" L D L^T representations
     !> (also known as Relatively Robust Representations). Gram-Schmidt
     !> orthogonalization is avoided as far as possible. More specifically,
     !> the various steps of the algorithm are as follows.
     !> For each unreduced block (submatrix) of T,
     !> (a) Compute T - sigma I  = L D L^T, so that L and D
     !> define all the wanted eigenvalues to high relative accuracy.
     !> This means that small relative changes in the entries of D and L
     !> cause only small relative changes in the eigenvalues and
     !> eigenvectors. The standard (unfactored) representation of the
     !> tridiagonal matrix T does not have this property in general.
     !> (b) Compute the eigenvalues to suitable accuracy.
     !> If the eigenvectors are desired, the algorithm attains full
     !> accuracy of the computed eigenvalues only right before
     !> the corresponding vectors have to be computed, see steps c) and d).
     !> (c) For each cluster of close eigenvalues, select a new
     !> shift close to the cluster, find a new factorization, and refine
     !> the shifted eigenvalues to suitable accuracy.
     !> (d) For each eigenvalue with a large enough relative separation compute
     !> the corresponding eigenvector by forming a rank revealing twisted
     !> factorization. Go back to (c) for any clusters that remain.
     !> The desired accuracy of the output can be specified by the input
     !> parameter ABSTOL.
     !> For more details, see ${ri.upper()}$STEMR's documentation and:
     !> - Inderjit S. Dhillon and Beresford N. Parlett: "Multiple representations
     !> to compute orthogonal eigenvectors of symmetric tridiagonal matrices,"
     !> Linear Algebra and its Applications, 387(1), pp. 1-28, August 2004.
     !> - Inderjit Dhillon and Beresford Parlett: "Orthogonal Eigenvectors and
     !> Relative Gaps," SIAM Journal on Matrix Analysis and Applications, Vol. 25,
     !> 2004.  Also LAPACK Working Note 154.
     !> - Inderjit Dhillon: "A new O(n^2) algorithm for the symmetric
     !> tridiagonal eigenvalue/eigenvector problem",
     !> Computer Science Division Technical Report No. UCB/CSD-97-971,
     !> UC Berkeley, May 1997.
     !> Note 1 : ${ri.upper()}$SYEVR calls ${ri.upper()}$STEMR when the full spectrum is requested
     !> on machines which conform to the ieee-754 floating point standard.
     !> ${ri.upper()}$SYEVR calls ${ri.upper()}$STEBZ and ${ri.upper()}$STEIN on non-ieee machines and
     !> when partial spectrum requests are made.
     !> Normal execution of ${ri.upper()}$STEMR may create NaNs and infinities and
     !> hence may abort due to a floating point exception in environments
     !> which do not handle NaNs and infinities in the ieee standard default
     !> manner.

     subroutine la_${ri}$syevr(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z,ldz, &
               isuppz,work,lwork,iwork,liwork,info)
        use la_constants_${rk}$,only:zero,one,two
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,lda,ldz,liwork,lwork,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: isuppz(*),iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: w(*),work(*),z(ldz,*)
       ! =====================================================================

           ! Local Scalars
#:if rk == "sp"
           logical(lk) :: alleig,indeig,lower,lquery,test,valeig,wantz,tryrac
#:else
           logical(lk) :: alleig,indeig,lower,lquery,valeig,wantz,tryrac
#:endif
           character :: order
           integer(ilp) :: i,ieeeok,iinfo,imax,indd,inddd,inde,indee,indibl,indifl, &
           indisp,indiwo,indtau,indwk,indwkn,iscale,j,jj,liwmin,llwork,llwrkn,lwkopt, &
                     lwmin,nb,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           ieeeok = la_ilaenv(10,'${ri.upper()}$SYEVR','N',1,2,3,4)
           lower = la_lsame(uplo,'L')
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lquery = ((lwork == -1) .or. (liwork == -1))
           lwmin = max(1,26*n)
           liwmin = max(1,10*n)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -8
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -9
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -10
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -15
#:if rk != "sp"
              else if (lwork < lwmin .and. .not. lquery) then
                 info = -18
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -20
#:endif
              end if
           end if
           if (info == 0) then
              nb = la_ilaenv(1,'${ri.upper()}$SYTRD',uplo,n,-1,-1,-1)
              nb = max(nb,la_ilaenv(1,'${ri.upper()}$ORMTR',uplo,n,-1,-1,-1))
              lwkopt = max((nb + 1)*n,lwmin)
              work(1) = lwkopt
              iwork(1) = liwmin
#:if rk == "sp"
              if (lwork < lwmin .and. .not. lquery) then
                 info = -18
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -20
              end if
#:endif
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$SYEVR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) then
              work(1) = 1
              return
           end if
           if (n == 1) then
#:if rk == "sp"
              work(1) = 26
#:else
              work(1) = 7
#:endif
              if (alleig .or. indeig) then
                 m = 1
                 w(1) = a(1,1)
              else
                 if (vl < a(1,1) .and. vu >= a(1,1)) then
                    m = 1
                    w(1) = a(1,1)
                 end if
              end if
              if (wantz) then
                 z(1,1) = one
                 isuppz(1) = 1
                 isuppz(2) = 1
              end if
              return
           end if
           ! get machine constants.
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           eps = la_${ri}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           end if
           anrm = la_${ri}$lansy('M',uplo,n,a,lda,work)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 do j = 1,n
                    call la_${ri}$scal(n - j + 1,sigma,a(j,j),1)
                 end do
              else
                 do j = 1,n
                    call la_${ri}$scal(j,sigma,a(1,j),1)
                 end do
              end if
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! initialize indices into workspaces.  note: the iwork indices are
           ! used only if la_${ri}$sterf or la_${ri}$stemr fail.
           ! work(indtau:indtau+n-1) stores the scalar factors of the
           ! elementary reflectors used in la_${ri}$sytrd.
           indtau = 1
           ! work(indd:indd+n-1) stores the tridiagonal's diagonal entries.
           indd = indtau + n
           ! work(inde:inde+n-1) stores the off-diagonal entries of the
           ! tridiagonal matrix from la_${ri}$sytrd.
           inde = indd + n
           ! work(inddd:inddd+n-1) is a copy of the diagonal entries over
           ! -written by la_${ri}$stemr (the la_${ri}$sterf path copies the diagonal to w).
           inddd = inde + n
           ! work(indee:indee+n-1) is a copy of the off-diagonal entries over
           ! -written while computing the eigenvalues in la_${ri}$sterf and la_${ri}$stemr.
           indee = inddd + n
           ! indwk is the starting offset of the left-over workspace, and
           ! llwork is the remaining workspace size.
           indwk = indee + n
           llwork = lwork - indwk + 1
           ! iwork(indibl:indibl+m-1) corresponds to iblock in la_${ri}$stebz and
           ! stores the block indices of each of the m<=n eigenvalues.
           indibl = 1
           ! iwork(indisp:indisp+nsplit-1) corresponds to isplit in la_${ri}$stebz and
           ! stores the starting and finishing indices of each block.
           indisp = indibl + n
           ! iwork(indifl:indifl+n-1) stores the indices of eigenvectors
           ! that corresponding to eigenvectors that fail to converge in
           ! la_${ri}$stein.  this information is discarded; if any fail, the driver
           ! returns info > 0.
           indifl = indisp + n
           ! indiwo is the offset of the remaining integer workspace.
           indiwo = indifl + n
           ! call la_${ri}$sytrd to reduce symmetric matrix to tridiagonal form.
           call la_${ri}$sytrd(uplo,n,a,lda,work(indd),work(inde),work(indtau),work( &
                     indwk),llwork,iinfo)
           ! if all eigenvalues are desired
           ! then call la_${ri}$sterf or la_${ri}$stemr and la_${ri}$ormtr.
#:if rk == "sp"
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (ieeeok == 1)) then
#:else
           if ((alleig .or. (indeig .and. il == 1 .and. iu == n)) .and. ieeeok == 1) then
#:endif
              if (.not. wantz) then
                 call la_${ri}$copy(n,work(indd),1,w,1)
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$sterf(n,w,work(indee),info)
              else
                 call la_${ri}$copy(n - 1,work(inde),1,work(indee),1)
                 call la_${ri}$copy(n,work(indd),1,work(inddd),1)
                 if (abstol <= two*n*eps) then
                    tryrac = .true.
                 else
                    tryrac = .false.
                 end if
                 call la_${ri}$stemr(jobz,'A',n,work(inddd),work(indee),vl,vu,il,iu,m, &
                            w,z,ldz,n,isuppz,tryrac,work(indwk),lwork,iwork,liwork,info)
              ! apply orthogonal matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stemr.
                 if (wantz .and. info == 0) then
                    indwkn = inde
                    llwrkn = lwork - indwkn + 1
                    call la_${ri}$ormtr('L',uplo,'N',n,m,a,lda,work(indtau),z,ldz,work( &
                               indwkn),llwrkn,iinfo)
                 end if
              end if
              if (info == 0) then
                 ! everything worked.  skip la_${ri}$stebz/la_${ri}$stein.  iwork(:) are
                 ! undefined.
                 m = n
                 go to 30
              end if
              info = 0
           end if
           ! otherwise, call la_${ri}$stebz and, if eigenvectors are desired, la_${ri}$stein.
           ! also call la_${ri}$stebz and la_${ri}$stein if la_${ri}$stemr fails.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           call la_${ri}$stebz(range,order,n,vll,vuu,il,iu,abstll,work(indd),work(inde &
           ),m,nsplit,w,iwork(indibl),iwork(indisp),work(indwk),iwork(indiwo),info)

           if (wantz) then
              call la_${ri}$stein(n,work(indd),work(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,work(indwk),iwork(indiwo),iwork(indifl),info)
              ! apply orthogonal matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              indwkn = inde
              llwrkn = lwork - indwkn + 1
              call la_${ri}$ormtr('L',uplo,'N',n,m,a,lda,work(indtau),z,ldz,work( &
                        indwkn),llwrkn,iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
        ! jump here if la_${ri}$stemr/la_${ri}$stein succeeded.
        30 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ri}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.  note: we do not sort the ifail portion of iwork.
           ! it may not be initialized (if la_${ri}$stemr/la_${ri}$stein succeeded), and we do
           ! not return this detailed information to the user.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    w(i) = w(j)
                    w(j) = tmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                 end if
              end do
           end if
           ! set work(1) to optimal workspace size.
           work(1) = lwkopt
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$syevr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HB2ST_KERNELS: is an internal routine used by the ${ri.upper()}$HETRD_HB2ST
     !> subroutine.

     pure subroutine la_${ri}$hb2st_kernels(uplo,wantz,ttype,st,ed,sweep,n,nb,ib,a,lda, &
               v,tau,ldvt,work)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           logical(lk),intent(in) :: wantz
           integer(ilp),intent(in) :: ttype,st,ed,sweep,n,nb,ib,lda,ldvt
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: v(*),tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i,j1,j2,lm,ln,vpos,taupos,dpos,ofdpos,ajeter
           complex(${rk}$) :: ctmp
           ! Intrinsic Functions
           intrinsic :: conjg,mod
           ! Executable Statements
           ajeter = ib + ldvt
           upper = la_lsame(uplo,'U')
           if (upper) then
               dpos = 2*nb + 1
               ofdpos = 2*nb
           else
               dpos = 1
               ofdpos = 2
           end if
           ! upper case
           if (upper) then
               if (wantz) then
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               else
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               end if
               if (ttype == 1) then
                   lm = ed - st + 1
                   v(vpos) = cone
                   do i = 1,lm - 1
                       v(vpos + i) = conjg(a(ofdpos - i,st + i))
                       a(ofdpos - i,st + i) = czero
                   end do
                   ctmp = conjg(a(ofdpos,st))
                   call la_${ri}$larfg(lm,ctmp,v(vpos + 1),1,tau(taupos))
                   a(ofdpos,st) = ctmp
                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1,conjg(tau(taupos)),a(dpos,st) &
                             ,lda - 1,work)
               end if
               if (ttype == 3) then
                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1,conjg(tau(taupos)),a(dpos,st) &
                             ,lda - 1,work)
               end if
               if (ttype == 2) then
                   j1 = ed + 1
                   j2 = min(ed + nb,n)
                   ln = ed - st + 1
                   lm = j2 - j1 + 1
                   if (lm > 0) then
                       call la_${ri}$larfx('LEFT',ln,lm,v(vpos),conjg(tau(taupos)),a( &
                                 dpos - nb,j1),lda - 1,work)
                       if (wantz) then
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       else
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       end if
                       v(vpos) = cone
                       do i = 1,lm - 1
                           v(vpos + i) = conjg(a(dpos - nb - i,j1 + i))
                           a(dpos - nb - i,j1 + i) = czero
                       end do
                       ctmp = conjg(a(dpos - nb,j1))
                       call la_${ri}$larfg(lm,ctmp,v(vpos + 1),1,tau(taupos))
                       a(dpos - nb,j1) = ctmp
                       call la_${ri}$larfx('RIGHT',ln - 1,lm,v(vpos),tau(taupos),a(dpos - nb + &
                                 1,j1),lda - 1,work)
                   end if
               end if
           ! lower case
           else
               if (wantz) then
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               else
                   vpos = mod(sweep - 1,2)*n + st
                   taupos = mod(sweep - 1,2)*n + st
               end if
               if (ttype == 1) then
                   lm = ed - st + 1
                   v(vpos) = cone
                   do i = 1,lm - 1
                       v(vpos + i) = a(ofdpos + i,st - 1)
                       a(ofdpos + i,st - 1) = czero
                   end do
                   call la_${ri}$larfg(lm,a(ofdpos,st - 1),v(vpos + 1),1,tau(taupos))

                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1,conjg(tau(taupos)),a(dpos,st) &
                             ,lda - 1,work)
               end if
               if (ttype == 3) then
                   lm = ed - st + 1
                   call la_${ri}$larfy(uplo,lm,v(vpos),1,conjg(tau(taupos)),a(dpos,st) &
                             ,lda - 1,work)
               end if
               if (ttype == 2) then
                   j1 = ed + 1
                   j2 = min(ed + nb,n)
                   ln = ed - st + 1
                   lm = j2 - j1 + 1
                   if (lm > 0) then
                       call la_${ri}$larfx('RIGHT',lm,ln,v(vpos),tau(taupos),a(dpos + nb, &
                                 st),lda - 1,work)
                       if (wantz) then
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       else
                           vpos = mod(sweep - 1,2)*n + j1
                           taupos = mod(sweep - 1,2)*n + j1
                       end if
                       v(vpos) = cone
                       do i = 1,lm - 1
                           v(vpos + i) = a(dpos + nb + i,st)
                           a(dpos + nb + i,st) = czero
                       end do
                       call la_${ri}$larfg(lm,a(dpos + nb,st),v(vpos + 1),1,tau(taupos))

                       call la_${ri}$larfx('LEFT',lm,ln - 1,v(vpos),conjg(tau(taupos)),a( &
                                 dpos + nb - 1,st + 1),lda - 1,work)
                   end if
               end if
           end if
           return
     end subroutine la_${ri}$hb2st_kernels
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HETD2: reduces a complex Hermitian matrix A to real symmetric
     !> tridiagonal form T by a unitary similarity transformation:
     !> Q**H * A * Q = T.

     pure subroutine la_${ri}$hetd2(uplo,n,a,lda,d,e,tau,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           real(${rk}$),intent(out) :: d(*),e(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i
           complex(${rk}$) :: alpha,taui
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real
#:else
           intrinsic :: real,max,min
#:endif
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HETD2',-info)
              return
           end if
           ! quick return if possible
           if (n <= 0) return
           if (upper) then
              ! reduce the upper triangle of a
              a(n,n) = real(a(n,n),KIND=${rk}$)
              do i = n - 1,1,-1
                 ! generate elementary reflector h(i) = i - tau * v * v**h
                 ! to annihilate a(1:i-1,i+1)
                 alpha = a(i,i + 1)
                 call la_${ri}$larfg(i,alpha,a(1,i + 1),1,taui)
                 e(i) = real(alpha,KIND=${rk}$)
                 if (taui /= czero) then
                    ! apply h(i) from both sides to a(1:i,1:i)
                    a(i,i + 1) = cone
                    ! compute  x := tau * a * v  storing x in tau(1:i)
                    call la_${ri}$hemv(uplo,i,taui,a,lda,a(1,i + 1),1,czero,tau,1)

                    ! compute  w := x - 1/2 * tau * (x**h * v) * v
                    alpha = -chalf*taui*la_${ri}$dotc(i,tau,1,a(1,i + 1),1)
                    call la_${ri}$axpy(i,alpha,a(1,i + 1),1,tau,1)
                    ! apply the transformation as a rank-2 update:
                       ! a := a - v * w**h - w * v**h
                    call la_${ri}$her2(uplo,i,-cone,a(1,i + 1),1,tau,1,a,lda)
                 else
                    a(i,i) = real(a(i,i),KIND=${rk}$)
                 end if
                 a(i,i + 1) = e(i)
                 d(i + 1) = real(a(i + 1,i + 1),KIND=${rk}$)
                 tau(i) = taui
              end do
              d(1) = real(a(1,1),KIND=${rk}$)
           else
              ! reduce the lower triangle of a
              a(1,1) = real(a(1,1),KIND=${rk}$)
              do i = 1,n - 1
                 ! generate elementary reflector h(i) = i - tau * v * v**h
                 ! to annihilate a(i+2:n,i)
                 alpha = a(i + 1,i)
                 call la_${ri}$larfg(n - i,alpha,a(min(i + 2,n),i),1,taui)
                 e(i) = real(alpha,KIND=${rk}$)
                 if (taui /= czero) then
                    ! apply h(i) from both sides to a(i+1:n,i+1:n)
                    a(i + 1,i) = cone
                    ! compute  x := tau * a * v  storing y in tau(i:n-1)
                    call la_${ri}$hemv(uplo,n - i,taui,a(i + 1,i + 1),lda,a(i + 1,i),1,czero, &
                              tau(i),1)
                    ! compute  w := x - 1/2 * tau * (x**h * v) * v
                    alpha = -chalf*taui*la_${ri}$dotc(n - i,tau(i),1,a(i + 1,i),1)
                    call la_${ri}$axpy(n - i,alpha,a(i + 1,i),1,tau(i),1)
                    ! apply the transformation as a rank-2 update:
                       ! a := a - v * w**h - w * v**h
                    call la_${ri}$her2(uplo,n - i,-cone,a(i + 1,i),1,tau(i),1,a(i + 1,i + 1) &
                              ,lda)
                 else
                    a(i + 1,i + 1) = real(a(i + 1,i + 1),KIND=${rk}$)
                 end if
                 a(i + 1,i) = e(i)
                 d(i) = real(a(i,i),KIND=${rk}$)
                 tau(i) = taui
              end do
              d(n) = real(a(n,n),KIND=${rk}$)
           end if
           return
     end subroutine la_${ri}$hetd2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HETRD: reduces a complex Hermitian matrix A to real symmetric
     !> tridiagonal form T by a unitary similarity transformation:
     !> Q**H * A * Q = T.

     pure subroutine la_${ri}$hetrd(uplo,n,a,lda,d,e,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           real(${rk}$),intent(out) :: d(*),e(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper
           integer(ilp) :: i,iinfo,iws,j,kk,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (lwork < 1 .and. .not. lquery) then
              info = -9
           end if
           if (info == 0) then
              ! determine the block size.
              nb = la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
              lwkopt = n*nb
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HETRD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
              work(1) = 1
              return
           end if
           nx = n
           iws = 1
           if (nb > 1 .and. nb < n) then
              ! determine when to cross over from blocked to unblocked code
              ! (last block is always handled by unblocked code).
              nx = max(nb,la_ilaenv(3,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1))
              if (nx < n) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  determine the
                    ! minimum value of nb, and reduce nb or force use of
                    ! unblocked code by setting nx = n.
                    nb = max(lwork/ldwork,1)
                    nbmin = la_ilaenv(2,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
                    if (nb < nbmin) nx = n
                 end if
              else
                 nx = n
              end if
           else
              nb = 1
           end if
           if (upper) then
              ! reduce the upper triangle of a.
              ! columns 1:kk are handled by the unblocked method.
              kk = n - ((n - nx + nb - 1)/nb)*nb
              do i = n - nb + 1,kk + 1,-nb
                 ! reduce columns i:i+nb-1 to tridiagonal form and form the
                 ! matrix w which is needed to update the unreduced part of
                 ! the matrix
                 call la_${ri}$latrd(uplo,i + nb - 1,nb,a,lda,e,tau,work,ldwork)
                 ! update the unreduced submatrix a(1:i-1,1:i-1), using an
                 ! update of the form:  a := a - v*w**h - w*v**h
                 call la_${ri}$her2k(uplo,'NO TRANSPOSE',i - 1,nb,-cone,a(1,i),lda,work, &
                           ldwork,one,a,lda)
                 ! copy superdiagonal elements back into a, and diagonal
                 ! elements into d
                 do j = i,i + nb - 1
                    a(j - 1,j) = e(j - 1)
                    d(j) = real(a(j,j),KIND=${rk}$)
                 end do
              end do
              ! use unblocked code to reduce the last or only block
              call la_${ri}$hetd2(uplo,kk,a,lda,d,e,tau,iinfo)
           else
              ! reduce the lower triangle of a
              do i = 1,n - nx,nb
                 ! reduce columns i:i+nb-1 to tridiagonal form and form the
                 ! matrix w which is needed to update the unreduced part of
                 ! the matrix
                 call la_${ri}$latrd(uplo,n - i + 1,nb,a(i,i),lda,e(i),tau(i),work, &
                           ldwork)
                 ! update the unreduced submatrix a(i+nb:n,i+nb:n), using
                 ! an update of the form:  a := a - v*w**h - w*v**h
                 call la_${ri}$her2k(uplo,'NO TRANSPOSE',n - i - nb + 1,nb,-cone,a(i + nb,i),lda, &
                           work(nb + 1),ldwork,one,a(i + nb,i + nb),lda)
                 ! copy subdiagonal elements back into a, and diagonal
                 ! elements into d
                 do j = i,i + nb - 1
                    a(j + 1,j) = e(j)
                    d(j) = real(a(j,j),KIND=${rk}$)
                 end do
              end do
              ! use unblocked code to reduce the last or only block
              call la_${ri}$hetd2(uplo,n - i + 1,a(i,i),lda,d(i),e(i),tau(i),iinfo)

           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$hetrd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HETRD_HB2ST: reduces a complex Hermitian band matrix A to real symmetric
     !> tridiagonal form T by a unitary similarity transformation:
     !> Q**H * A * Q = T.

     pure subroutine la_${ri}$hetrd_hb2st(stage1,vect,uplo,n,kd,ab,ldab,d,e,hous,lhous, &
               work,lwork,info)
        use la_constants_${rk}$
#if defined(_OPENMP)
#endif
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: stage1,uplo,vect
           integer(ilp),intent(in) :: n,kd,ldab,lhous,lwork
           integer(ilp),intent(out) :: info
           ! Array Arguments
           real(${rk}$),intent(out) :: d(*),e(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
           complex(${rk}$),intent(out) :: hous(*),work(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: rzero = 0.0e+0_${rk}$

           ! Local Scalars
           logical(lk) :: lquery,wantq,upper,afters1
           integer(ilp) :: i,m,k,ib,sweepid,myid,shift,stt,st,ed,stind,edind, &
           blklastind,colpt,thed,stepercol,grsiz,thgrsiz,thgrnb,thgrid,nbtiles,ttype, &
           tid,nthreads,debug,abdpos,abofdpos,dpos,ofdpos,awpos,inda,indw,apos,sizea, &
                     lda,indv,indtau,si${ri}$ev,sizetau,ldv,lhmin,lwmin
           real(${rk}$) :: abstmp
           complex(${rk}$) :: tmp
           ! Intrinsic Functions
           intrinsic :: min,max,ceiling,real
           ! Executable Statements
           ! determine the minimal workspace size required.
           ! test the input parameters
           debug = 0
           info = 0
           afters1 = la_lsame(stage1,'Y')
           wantq = la_lsame(vect,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1) .or. (lhous == -1)
           ! determine the block size, the workspace size and the hous size.
           ib = la_ilaenv2stage(2,'${ri.upper()}$HETRD_HB2ST',vect,n,kd,-1,-1)
           lhmin = la_ilaenv2stage(3,'${ri.upper()}$HETRD_HB2ST',vect,n,kd,ib,-1)
           lwmin = la_ilaenv2stage(4,'${ri.upper()}$HETRD_HB2ST',vect,n,kd,ib,-1)
           if (.not. afters1 .and. .not. la_lsame(stage1,'N')) then
              info = -1
           else if (.not. la_lsame(vect,'N')) then
              info = -2
           else if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (kd < 0) then
              info = -5
           else if (ldab < (kd + 1)) then
              info = -7
           else if (lhous < lhmin .and. .not. lquery) then
              info = -11
           else if (lwork < lwmin .and. .not. lquery) then
              info = -13
           end if
           if (info == 0) then
              hous(1) = lhmin
              work(1) = lwmin
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HETRD_HB2ST',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
               hous(1) = 1
               work(1) = 1
               return
           end if
           ! determine pointer position
           ldv = kd + ib
           sizetau = 2*n
           si${ri}$ev = 2*n
           indtau = 1
           indv = indtau + sizetau
           lda = 2*kd + 1
           sizea = lda*n
           inda = 1
           indw = inda + sizea
           nthreads = 1
           tid = 0
           if (upper) then
               apos = inda + kd
               awpos = inda
               dpos = apos + kd
               ofdpos = dpos - 1
               abdpos = kd + 1
               abofdpos = kd
           else
               apos = inda
               awpos = inda + kd + 1
               dpos = apos
               ofdpos = dpos + 1
               abdpos = 1
               abofdpos = 2
           end if
           ! case kd=0:
           ! the matrix is diagonal. we just copy it (convert to "real" for
           ! complex because d is double and the imaginary part should be 0)
           ! and store it in d. a sequential code here is better or
           ! in a parallel environment it might need two cores for d and e
           if (kd == 0) then
               do i = 1,n
                   d(i) = real(ab(abdpos,i),KIND=${rk}$)
               end do
               do i = 1,n - 1
                   e(i) = rzero
               end do
               hous(1) = 1
               work(1) = 1
               return
           end if
           ! case kd=1:
           ! the matrix is already tridiagonal. we have to make diagonal
           ! and offdiagonal elements real, and store them in d and e.
           ! for that, for real precision just copy the diag and offdiag
           ! to d and e while for the complex case the bulge chasing is
           ! performed to convert the hermetian tridiagonal to symmetric
           ! tridiagonal. a simpler conversion formula might be used, but then
           ! updating the q matrix will be required and based if q is generated
           ! or not this might complicate the story.
           if (kd == 1) then
               do i = 1,n
                   d(i) = real(ab(abdpos,i),KIND=${rk}$)
               end do
               ! make off-diagonal elements real and copy them to e
               if (upper) then
                   do i = 1,n - 1
                       tmp = ab(abofdpos,i + 1)
                       abstmp = abs(tmp)
                       ab(abofdpos,i + 1) = abstmp
                       e(i) = abstmp
                       if (abstmp /= rzero) then
                          tmp = tmp/abstmp
                       else
                          tmp = cone
                       end if
                       if (i < n - 1) ab(abofdpos,i + 2) = ab(abofdpos,i + 2)*tmp
                        ! if( wantz ) then
                           ! call la_${ri}$scal( n, conjg( tmp ), q( 1, i+1 ), 1 )
                        ! end if
                   end do
               else
                   do i = 1,n - 1
                      tmp = ab(abofdpos,i)
                      abstmp = abs(tmp)
                      ab(abofdpos,i) = abstmp
                      e(i) = abstmp
                      if (abstmp /= rzero) then
                         tmp = tmp/abstmp
                      else
                         tmp = cone
                      end if
                      if (i < n - 1) ab(abofdpos,i + 1) = ab(abofdpos,i + 1)*tmp
                       ! if( wantq ) then
                          ! call la_${ri}$scal( n, tmp, q( 1, i+1 ), 1 )
                       ! end if
                   end do
               end if
               hous(1) = 1
               work(1) = 1
               return
           end if
           ! main code start here.
           ! reduce the hermitian band of a to a tridiagonal matrix.
           thgrsiz = n
           grsiz = 1
           shift = 3
           nbtiles = ceiling(real(n,KIND=${rk}$)/real(kd,KIND=${rk}$))
           stepercol = ceiling(real(shift,KIND=${rk}$)/real(grsiz,KIND=${rk}$))
           thgrnb = ceiling(real(n - 1,KIND=${rk}$)/real(thgrsiz,KIND=${rk}$))
           call la_${ri}$lacpy("A",kd + 1,n,ab,ldab,work(apos),lda)
           call la_${ri}$laset("A",kd,n,czero,czero,work(awpos),lda)
           ! openmp parallelisation start here
#if defined(_OPENMP)
!$OMP PARALLEL PRIVATE( TID, THGRID, BLKLASTIND )
!$OMP$         PRIVATE( THED, I, M, K, ST, ED, STT, SWEEPID )
!$OMP$         PRIVATE( MYID, TTYPE, COLPT, STIND, EDIND )
!$OMP$         SHARED ( UPLO, WANTQ, INDV, INDTAU, HOUS, WORK)
!$OMP$         SHARED ( N, KD, IB, NBTILES, LDA, LDV, INDA )
!$OMP$         SHARED ( STEPERCOL, THGRNB, THGRSIZ, GRSIZ, SHIFT )
!$OMP MASTER
#endif
           ! main bulge chasing loop
           loop_100: do thgrid = 1,thgrnb
               stt = (thgrid - 1)*thgrsiz + 1
               thed = min((stt + thgrsiz - 1), (n - 1))
               loop_110: do i = stt,n - 1
                   ed = min(i,thed)
                   if (stt > ed) exit
                   loop_120: do m = 1,stepercol
                       st = stt
                       loop_130: do sweepid = st,ed
                           loop_140: do k = 1,grsiz
                               myid = (i - sweepid)*(stepercol*grsiz) + (m - 1)*grsiz + k
                               if (myid == 1) then
                                   ttype = 1
                               else
                                   ttype = mod(myid,2) + 2
                               end if
                               if (ttype == 2) then
                                   colpt = (myid/2)*kd + sweepid
                                   stind = colpt - kd + 1
                                   edind = min(colpt,n)
                                   blklastind = colpt
                               else
                                   colpt = ((myid + 1)/2)*kd + sweepid
                                   stind = colpt - kd + 1
                                   edind = min(colpt,n)
                                   if ((stind >= edind - 1) .and. (edind == n)) then
                                       blklastind = n
                                   else
                                       blklastind = 0
                                   end if
                               end if
                               ! call the kernel
#if defined(_OPENMP) &&  _OPENMP >= 201307
                               if (ttype /= 1) then
!$OMP TASK DEPEND(in:WORK(MYID+SHIFT-1))
!$OMP$     DEPEND(in:WORK(MYID-1))
!$OMP$     DEPEND(out:WORK(MYID))
                                   tid = omp_get_thread_num()
                                   call la_${ri}$hb2st_kernels(uplo,wantq,ttype,stind,edind, &
                                   sweepid,n,kd,ib,work(inda),lda,hous(indv),hous( &
                                             indtau),ldv,work(indw + tid*kd))
!$OMP END TASK
                               else
!$OMP TASK DEPEND(in:WORK(MYID+SHIFT-1))
!$OMP$     DEPEND(out:WORK(MYID))
                                   tid = omp_get_thread_num()
                                   call la_${ri}$hb2st_kernels(uplo,wantq,ttype,stind,edind, &
                                   sweepid,n,kd,ib,work(inda),lda,hous(indv),hous( &
                                             indtau),ldv,work(indw + tid*kd))
!$OMP END TASK
                               end if
#else
                               call la_${ri}$hb2st_kernels(uplo,wantq,ttype,stind,edind, &
                               sweepid,n,kd,ib,work(inda),lda,hous(indv),hous(indtau), &
                                          ldv,work(indw + tid*kd))
#endif
                               if (blklastind >= (n - 1)) then
                                   stt = stt + 1
                                   exit
                               end if
                           end do loop_140
                       end do loop_130
                   end do loop_120
               end do loop_110
           end do loop_100
#if defined(_OPENMP)
!$OMP END MASTER
!$OMP END PARALLEL
#endif
           ! copy the diagonal from a to d. note that d is real thus only
           ! the real part is needed, the imaginary part should be czero.
           do i = 1,n
               d(i) = real(work(dpos + (i - 1)*lda),KIND=${rk}$)
           end do
           ! copy the off diagonal from a to e. note that e is real thus only
           ! the real part is needed, the imaginary part should be czero.
           if (upper) then
               do i = 1,n - 1
                  e(i) = real(work(ofdpos + i*lda),KIND=${rk}$)
               end do
           else
               do i = 1,n - 1
                  e(i) = real(work(ofdpos + (i - 1)*lda),KIND=${rk}$)
               end do
           end if
           hous(1) = lhmin
           work(1) = lwmin
           return
     end subroutine la_${ri}$hetrd_hb2st
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HETRD_HE2HB: reduces a complex Hermitian matrix A to complex Hermitian
     !> band-diagonal form AB by a unitary similarity transformation:
     !> Q**H * A * Q = AB.

     pure subroutine la_${ri}$hetrd_he2hb(uplo,n,kd,a,lda,ab,ldab,tau,work,lwork,info)
        use la_constants_${rk}$

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldab,lwork,n,kd
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: ab(ldab,*),tau(*),work(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: rone = 1.0e+0_${rk}$

           ! Local Scalars
           logical(lk) :: lquery,upper
           integer(ilp) :: i,j,iinfo,lwmin,pn,pk,lk,ldt,ldw,lds2,lds1,ls2,ls1,lw,lt, &
                      tpos,wpos,s2pos,s1pos
           ! Intrinsic Functions
           intrinsic :: min,max
           ! Executable Statements
           ! determine the minimal workspace size required
           ! and test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           lwmin = la_ilaenv2stage(4,'${ri.upper()}$HETRD_HE2HB','',n,kd,-1,-1)
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldab < max(1,kd + 1)) then
              info = -7
           else if (lwork < lwmin .and. .not. lquery) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HETRD_HE2HB',-info)
              return
           else if (lquery) then
              work(1) = lwmin
              return
           end if
           ! quick return if possible
           ! copy the upper/lower portion of a into ab
           if (n <= kd + 1) then
               if (upper) then
                   do i = 1,n
                       lk = min(kd + 1,i)
                       call la_${ri}$copy(lk,a(i - lk + 1,i),1,ab(kd + 1 - lk + 1,i),1)
                   end do
               else
                   do i = 1,n
                       lk = min(kd + 1,n - i + 1)
                       call la_${ri}$copy(lk,a(i,i),1,ab(1,i),1)
                   end do
               end if
               work(1) = 1
               return
           end if
           ! determine the pointer position for the workspace
           ldt = kd
           lds1 = kd
           lt = ldt*kd
           lw = n*kd
           ls1 = lds1*kd
           ls2 = lwmin - lt - lw - ls1
            ! ls2 = n*max(kd,factoptnb)
           tpos = 1
           wpos = tpos + lt
           s1pos = wpos + lw
           s2pos = s1pos + ls1
           if (upper) then
               ldw = kd
               lds2 = kd
           else
               ldw = n
               lds2 = n
           end if
           ! set the workspace of the triangular matrix t to czero once such a
           ! way every time t is generated the upper/lower portion will be always czero
           call la_${ri}$laset("A",ldt,kd,czero,czero,work(tpos),ldt)
           if (upper) then
               do i = 1,n - kd,kd
                  pn = n - i - kd + 1
                  pk = min(n - i - kd + 1,kd)
                  ! compute the lq factorization of the current block
                  call la_${ri}$gelqf(kd,pn,a(i,i + kd),lda,tau(i),work(s2pos),ls2, &
                            iinfo)
                  ! copy the upper portion of a into ab
                  do j = i,i + pk - 1
                     lk = min(kd,n - j) + 1
                     call la_${ri}$copy(lk,a(j,j),lda,ab(kd + 1,j),ldab - 1)
                  end do
                  call la_${ri}$laset('LOWER',pk,pk,czero,cone,a(i,i + kd),lda)
                  ! form the matrix t
                  call la_${ri}$larft('FORWARD','ROWWISE',pn,pk,a(i,i + kd),lda,tau(i), &
                            work(tpos),ldt)
                  ! compute w:
                  call la_${ri}$gemm('CONJUGATE','NO TRANSPOSE',pk,pn,pk,cone,work(tpos), &
                            ldt,a(i,i + kd),lda,czero,work(s2pos),lds2)
                  call la_${ri}$hemm('RIGHT',uplo,pk,pn,cone,a(i + kd,i + kd),lda,work( &
                            s2pos),lds2,czero,work(wpos),ldw)
                  call la_${ri}$gemm('NO TRANSPOSE','CONJUGATE',pk,pk,pn,cone,work(wpos), &
                            ldw,work(s2pos),lds2,czero,work(s1pos),lds1)
                  call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',pk,pn,pk,-chalf,work( &
                            s1pos),lds1,a(i,i + kd),lda,cone,work(wpos),ldw)
                  ! update the unreduced submatrix a(i+kd:n,i+kd:n), using
                  ! an update of the form:  a := a - v'*w - w'*v
                  call la_${ri}$her2k(uplo,'CONJUGATE',pn,pk,-cone,a(i,i + kd),lda,work( &
                            wpos),ldw,rone,a(i + kd,i + kd),lda)
               end do
              ! copy the upper band to ab which is the band storage matrix
              do j = n - kd + 1,n
                 lk = min(kd,n - j) + 1
                 call la_${ri}$copy(lk,a(j,j),lda,ab(kd + 1,j),ldab - 1)
              end do
           else
               ! reduce the lower triangle of a to lower band matrix
               loop_40: do i = 1,n - kd,kd
                  pn = n - i - kd + 1
                  pk = min(n - i - kd + 1,kd)
                  ! compute the qr factorization of the current block
                  call la_${ri}$geqrf(pn,kd,a(i + kd,i),lda,tau(i),work(s2pos),ls2, &
                            iinfo)
                  ! copy the upper portion of a into ab
                  do j = i,i + pk - 1
                     lk = min(kd,n - j) + 1
                     call la_${ri}$copy(lk,a(j,j),1,ab(1,j),1)
                  end do
                  call la_${ri}$laset('UPPER',pk,pk,czero,cone,a(i + kd,i),lda)
                  ! form the matrix t
                  call la_${ri}$larft('FORWARD','COLUMNWISE',pn,pk,a(i + kd,i),lda,tau(i), &
                            work(tpos),ldt)
                  ! compute w:
                  call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',pn,pk,pk,cone,a(i + kd,i) &
                            ,lda,work(tpos),ldt,czero,work(s2pos),lds2)
                  call la_${ri}$hemm('LEFT',uplo,pn,pk,cone,a(i + kd,i + kd),lda,work(s2pos) &
                            ,lds2,czero,work(wpos),ldw)
                  call la_${ri}$gemm('CONJUGATE','NO TRANSPOSE',pk,pk,pn,cone,work(s2pos), &
                            lds2,work(wpos),ldw,czero,work(s1pos),lds1)
                  call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',pn,pk,pk,-chalf,a(i + kd, &
                            i),lda,work(s1pos),lds1,cone,work(wpos),ldw)
                  ! update the unreduced submatrix a(i+kd:n,i+kd:n), using
                  ! an update of the form:  a := a - v*w' - w*v'
                  call la_${ri}$her2k(uplo,'NO TRANSPOSE',pn,pk,-cone,a(i + kd,i),lda,work( &
                            wpos),ldw,rone,a(i + kd,i + kd),lda)
                  ! ==================================================================
                  ! restore a for comparison and checking to be removed
                   ! do 45 j = i, i+pk-1
                      ! lk = min( kd, n-j ) + 1
                      ! call la_${ri}$copy( lk, ab( 1, j ), 1, a( j, j ), 1 )
                      45 continue
                  ! ==================================================================
               end do loop_40
              ! copy the lower band to ab which is the band storage matrix
              do j = n - kd + 1,n
                 lk = min(kd,n - j) + 1
                 call la_${ri}$copy(lk,a(j,j),1,ab(1,j),1)
              end do
           end if
           work(1) = lwmin
           return
     end subroutine la_${ri}$hetrd_he2hb
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$UNGTR: generates a complex unitary matrix Q which is defined as the
     !> product of n-1 elementary reflectors of order N, as returned by
     !> ${ri.upper()}$HETRD:
     !> if UPLO = 'U', Q = H(n-1) . . . H(2) H(1),
     !> if UPLO = 'L', Q = H(1) H(2) . . . H(n-1).

     pure subroutine la_${ri}$ungtr(uplo,n,a,lda,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper
           integer(ilp) :: i,iinfo,j,lwkopt,nb
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (lwork < max(1,n - 1) .and. .not. lquery) then
              info = -7
           end if
           if (info == 0) then
              if (upper) then
                 nb = la_ilaenv(1,'${ri.upper()}$UNGQL',' ',n - 1,n - 1,n - 1,-1)
              else
                 nb = la_ilaenv(1,'${ri.upper()}$UNGQR',' ',n - 1,n - 1,n - 1,-1)
              end if
              lwkopt = max(1,n - 1)*nb
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNGTR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
              work(1) = 1
              return
           end if
           if (upper) then
              ! q was determined by a call to la_${ri}$hetrd with uplo = 'u'
              ! shift the vectors which define the elementary reflectors cone
              ! column to the left, and set the last row and column of q to
              ! those of the unit matrix
              do j = 1,n - 1
                 do i = 1,j - 1
                    a(i,j) = a(i,j + 1)
                 end do
                 a(n,j) = czero
              end do
              do i = 1,n - 1
                 a(i,n) = czero
              end do
              a(n,n) = cone
              ! generate q(1:n-1,1:n-1)
              call la_${ri}$ungql(n - 1,n - 1,n - 1,a,lda,tau,work,lwork,iinfo)
           else
              ! q was determined by a call to la_${ri}$hetrd with uplo = 'l'.
              ! shift the vectors which define the elementary reflectors cone
              ! column to the right, and set the first row and column of q to
              ! those of the unit matrix
              do j = n,2,-1
                 a(1,j) = czero
                 do i = j + 1,n
                    a(i,j) = a(i,j - 1)
                 end do
              end do
              a(1,1) = cone
              do i = 2,n
                 a(i,1) = czero
              end do
              if (n > 1) then
                 ! generate q(2:n,2:n)
                 call la_${ri}$ungqr(n - 1,n - 1,n - 1,a(2,2),lda,tau,work,lwork,iinfo)

              end if
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$ungtr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$UNMTR: overwrites the general complex M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'C':      Q**H * C       C * Q**H
     !> where Q is a complex unitary matrix of order nq, with nq = m if
     !> SIDE = 'L' and nq = n if SIDE = 'R'. Q is defined as the product of
     !> nq-1 elementary reflectors, as returned by ${ri.upper()}$HETRD:
     !> if UPLO = 'U', Q = H(nq-1) . . . H(2) H(1);
     !> if UPLO = 'L', Q = H(1) H(2) . . . H(nq-1).

     pure subroutine la_${ri}$unmtr(side,uplo,trans,m,n,a,lda,tau,c,ldc,work,lwork, &
               info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldc,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,lquery,upper
           integer(ilp) :: i1,i2,iinfo,lwkopt,mi,nb,ni,nq,nw
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           ! nq is the order of q and nw is the minimum dimension of work
           if (left) then
              nq = m
              nw = max(1,n)
           else
              nq = n
              nw = max(1,m)
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -2
           else if (.not. la_lsame(trans,'N') .and. .not. la_lsame(trans,'C')) &
                     then
              info = -3
           else if (m < 0) then
              info = -4
           else if (n < 0) then
              info = -5
           else if (lda < max(1,nq)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           else if (lwork < nw .and. .not. lquery) then
              info = -12
           end if
           if (info == 0) then
              if (upper) then
                 if (left) then
                    nb = la_ilaenv(1,'${ri.upper()}$UNMQL',side//trans,m - 1,n,m - 1,-1)
                 else
                    nb = la_ilaenv(1,'${ri.upper()}$UNMQL',side//trans,m,n - 1,n - 1,-1)
                 end if
              else
                 if (left) then
                    nb = la_ilaenv(1,'${ri.upper()}$UNMQR',side//trans,m - 1,n,m - 1,-1)
                 else
                    nb = la_ilaenv(1,'${ri.upper()}$UNMQR',side//trans,m,n - 1,n - 1,-1)
                 end if
              end if
              lwkopt = nw*nb
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNMTR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. nq == 1) then
              work(1) = 1
              return
           end if
           if (left) then
              mi = m - 1
              ni = n
           else
              mi = m
              ni = n - 1
           end if
           if (upper) then
              ! q was determined by a call to la_${ri}$hetrd with uplo = 'u'
              call la_${ri}$unmql(side,trans,mi,ni,nq - 1,a(1,2),lda,tau,c,ldc,work, &
                        lwork,iinfo)
           else
              ! q was determined by a call to la_${ri}$hetrd with uplo = 'l'
              if (left) then
                 i1 = 2
                 i2 = 1
              else
                 i1 = 1
                 i2 = 2
              end if
              call la_${ri}$unmqr(side,trans,mi,ni,nq - 1,a(2,1),lda,tau,c(i1,i2),ldc, &
                         work,lwork,iinfo)
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$unmtr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEEV: computes all eigenvalues and, optionally, eigenvectors of a
     !> complex Hermitian matrix A.

     subroutine la_${ri}$heev(jobz,uplo,n,a,lda,w,work,lwork,rwork,info)
        use la_constants_${rk}$,only:zero,one,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,lquery,wantz
           integer(ilp) :: iinfo,imax,inde,indtau,indwrk,iscale,llwork,lwkopt,nb
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: max,sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           lquery = (lwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           end if
           if (info == 0) then
              nb = la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
              lwkopt = max(1, (nb + 1)*n)
              work(1) = lwkopt
              if (lwork < max(1,2*n - 1) .and. .not. lquery) info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEEV ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) then
              return
           end if
           if (n == 1) then
              w(1) = real(a(1,1),KIND=${rk}$)
              work(1) = 1
              if (wantz) a(1,1) = cone
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lanhe('M',uplo,n,a,lda,rwork)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) call la_${ri}$lascl(uplo,0,0,one,sigma,n,n,a,lda,info)
           ! call la_${ri}$hetrd to reduce hermitian matrix to tridiagonal form.
           inde = 1
           indtau = 1
           indwrk = indtau + n
           llwork = lwork - indwrk + 1
           call la_${ri}$hetrd(uplo,n,a,lda,w,rwork(inde),work(indtau),work(indwrk), &
                     llwork,iinfo)
           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, first call
           ! la_${ri}$ungtr to generate the unitary matrix, then call la_${ri}$steqr.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              call la_${ri}$ungtr(uplo,n,a,lda,work(indtau),work(indwrk),llwork,iinfo)

              indwrk = inde + n
              call la_${ri}$steqr(jobz,n,w,rwork(inde),a,lda,rwork(indwrk),info)

           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           ! set work(1) to optimal complex workspace size.
           work(1) = lwkopt
           return
     end subroutine la_${ri}$heev
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEEVR: computes selected eigenvalues and, optionally, eigenvectors
     !> of a complex Hermitian matrix A.  Eigenvalues and eigenvectors can
     !> be selected by specifying either a range of values or a range of
     !> indices for the desired eigenvalues.
     !> ${ri.upper()}$HEEVR first reduces the matrix A to tridiagonal form T with a call
     !> to ${ri.upper()}$HETRD.  Then, whenever possible, ${ri.upper()}$HEEVR calls ${ri.upper()}$STEMR to compute
#:if rk == "sp"
     !> the eigenspectrum using Relatively Robust Representations.  ${ri.upper()}$STEMR
#:else
     !> eigenspectrum using Relatively Robust Representations.  ${ri.upper()}$STEMR
#:endif
     !> computes eigenvalues by the dqds algorithm, while orthogonal
     !> eigenvectors are computed from various "good" L D L^T representations
     !> (also known as Relatively Robust Representations). Gram-Schmidt
     !> orthogonalization is avoided as far as possible. More specifically,
     !> the various steps of the algorithm are as follows.
     !> For each unreduced block (submatrix) of T,
     !> (a) Compute T - sigma I  = L D L^T, so that L and D
     !> define all the wanted eigenvalues to high relative accuracy.
     !> This means that small relative changes in the entries of D and L
     !> cause only small relative changes in the eigenvalues and
     !> eigenvectors. The standard (unfactored) representation of the
     !> tridiagonal matrix T does not have this property in general.
     !> (b) Compute the eigenvalues to suitable accuracy.
     !> If the eigenvectors are desired, the algorithm attains full
     !> accuracy of the computed eigenvalues only right before
     !> the corresponding vectors have to be computed, see steps c) and d).
     !> (c) For each cluster of close eigenvalues, select a new
     !> shift close to the cluster, find a new factorization, and refine
     !> the shifted eigenvalues to suitable accuracy.
     !> (d) For each eigenvalue with a large enough relative separation compute
     !> the corresponding eigenvector by forming a rank revealing twisted
     !> factorization. Go back to (c) for any clusters that remain.
     !> The desired accuracy of the output can be specified by the input
     !> parameter ABSTOL.
     !> For more details, see ${ri.upper()}$STEMR's documentation and:
     !> - Inderjit S. Dhillon and Beresford N. Parlett: "Multiple representations
     !> to compute orthogonal eigenvectors of symmetric tridiagonal matrices,"
     !> Linear Algebra and its Applications, 387(1), pp. 1-28, August 2004.
     !> - Inderjit Dhillon and Beresford Parlett: "Orthogonal Eigenvectors and
     !> Relative Gaps," SIAM Journal on Matrix Analysis and Applications, Vol. 25,
     !> 2004.  Also LAPACK Working Note 154.
     !> - Inderjit Dhillon: "A new O(n^2) algorithm for the symmetric
     !> tridiagonal eigenvalue/eigenvector problem",
     !> Computer Science Division Technical Report No. UCB/CSD-97-971,
     !> UC Berkeley, May 1997.
     !> Note 1 : ${ri.upper()}$HEEVR calls ${ri.upper()}$STEMR when the full spectrum is requested
     !> on machines which conform to the ieee-754 floating point standard.
     !> ${ri.upper()}$HEEVR calls ${ci.upper()}$STEBZ and ${ri.upper()}$STEIN on non-ieee machines and
     !> when partial spectrum requests are made.
     !> Normal execution of ${ri.upper()}$STEMR may create NaNs and infinities and
     !> hence may abort due to a floating point exception in environments
     !> which do not handle NaNs and infinities in the ieee standard default
     !> manner.

     subroutine la_${ri}$heevr(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z,ldz, &
               isuppz,work,lwork,rwork,lrwork,iwork,liwork,info)
        use la_constants_${rk}$,only:zero,one,two
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,lda,ldz,liwork,lrwork,lwork,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: isuppz(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lower,lquery,test,valeig,wantz,tryrac
           character :: order
           integer(ilp) :: i,ieeeok,iinfo,imax,indibl,indifl,indisp,indiwo,indrd,indrdd, &
           indre,indree,indrwk,indtau,indwk,indwkn,iscale,itmp1,j,jj,liwmin,llwork, &
                     llrwork,llwrkn,lrwmin,lwkopt,lwmin,nb,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           ieeeok = la_ilaenv(10,'${ri.upper()}$HEEVR','N',1,2,3,4)
           lower = la_lsame(uplo,'L')
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lquery = ((lwork == -1) .or. (lrwork == -1) .or. (liwork == -1))
           lrwmin = max(1,24*n)
           liwmin = max(1,10*n)
           lwmin = max(1,2*n)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -8
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -9
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -10
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -15
              end if
           end if
           if (info == 0) then
              nb = la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
              nb = max(nb,la_ilaenv(1,'${ri.upper()}$UNMTR',uplo,n,-1,-1,-1))
              lwkopt = max((nb + 1)*n,lwmin)
              work(1) = lwkopt
              rwork(1) = lrwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -18
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -20
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -22
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEEVR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) then
              work(1) = 1
              return
           end if
           if (n == 1) then
              work(1) = 2
              if (alleig .or. indeig) then
                 m = 1
                 w(1) = real(a(1,1),KIND=${rk}$)
              else
                 if (vl < real(a(1,1),KIND=${rk}$) .and. vu >= real(a(1,1),KIND=${rk}$)) then
                    m = 1
                    w(1) = real(a(1,1),KIND=${rk}$)
                 end if
              end if
              if (wantz) then
                 z(1,1) = one
                 isuppz(1) = 1
                 isuppz(2) = 1
              end if
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           end if
           anrm = la_${ri}$lansy('M',uplo,n,a,lda,rwork)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 do j = 1,n
                    call la_${ri}$${ci}$scal(n - j + 1,sigma,a(j,j),1)
                 end do
              else
                 do j = 1,n
                    call la_${ri}$${ci}$scal(j,sigma,a(1,j),1)
                 end do
              end if
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! initialize indices into workspaces.  note: the iwork indices are
           ! used only if la_${ci}$sterf or la_${ri}$stemr fail.
           ! work(indtau:indtau+n-1) stores the complex scalar factors of the
           ! elementary reflectors used in la_${ri}$hetrd.
           indtau = 1
           ! indwk is the starting offset of the remaining complex workspace,
           ! and llwork is the remaining complex workspace size.
           indwk = indtau + n
           llwork = lwork - indwk + 1
           ! rwork(indrd:indrd+n-1) stores the real tridiagonal's diagonal
           ! entries.
           indrd = 1
           ! rwork(indre:indre+n-1) stores the off-diagonal entries of the
           ! tridiagonal matrix from la_${ri}$hetrd.
           indre = indrd + n
           ! rwork(indrdd:indrdd+n-1) is a copy of the diagonal entries over
           ! -written by la_${ri}$stemr (the la_${ci}$sterf path copies the diagonal to w).
           indrdd = indre + n
           ! rwork(indree:indree+n-1) is a copy of the off-diagonal entries over
           ! -written while computing the eigenvalues in la_${ci}$sterf and la_${ri}$stemr.
           indree = indrdd + n
           ! indrwk is the starting offset of the left-over real workspace, and
           ! llrwork is the remaining workspace size.
           indrwk = indree + n
           llrwork = lrwork - indrwk + 1
           ! iwork(indibl:indibl+m-1) corresponds to iblock in la_${ci}$stebz and
           ! stores the block indices of each of the m<=n eigenvalues.
           indibl = 1
           ! iwork(indisp:indisp+nsplit-1) corresponds to isplit in la_${ci}$stebz and
           ! stores the starting and finishing indices of each block.
           indisp = indibl + n
           ! iwork(indifl:indifl+n-1) stores the indices of eigenvectors
           ! that corresponding to eigenvectors that fail to converge in
           ! la_${ci}$stein.  this information is discarded; if any fail, the driver
           ! returns info > 0.
           indifl = indisp + n
           ! indiwo is the offset of the remaining integer workspace.
           indiwo = indifl + n
           ! call la_${ri}$hetrd to reduce hermitian matrix to tridiagonal form.
           call la_${ri}$hetrd(uplo,n,a,lda,rwork(indrd),rwork(indre),work(indtau), &
                     work(indwk),llwork,iinfo)
           ! if all eigenvalues are desired
           ! then call la_${ci}$sterf or la_${ri}$stemr and la_${ri}$unmtr.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (ieeeok == 1)) then
              if (.not. wantz) then
                 call la_${ci}$copy(n,rwork(indrd),1,w,1)
                 call la_${ci}$copy(n - 1,rwork(indre),1,rwork(indree),1)
                 call la_${ci}$sterf(n,w,rwork(indree),info)
              else
                 call la_${ci}$copy(n - 1,rwork(indre),1,rwork(indree),1)
                 call la_${ci}$copy(n,rwork(indrd),1,rwork(indrdd),1)
                 if (abstol <= two*n*eps) then
                    tryrac = .true.
                 else
                    tryrac = .false.
                 end if
                 call la_${ri}$stemr(jobz,'A',n,rwork(indrdd),rwork(indree),vl,vu,il, &
                 iu,m,w,z,ldz,n,isuppz,tryrac,rwork(indrwk),llrwork,iwork,liwork,info)

                 ! apply unitary matrix used in reduction to tridiagonal
                 ! form to eigenvectors returned by la_${ri}$stemr.
                 if (wantz .and. info == 0) then
                    indwkn = indwk
                    llwrkn = lwork - indwkn + 1
                    call la_${ri}$unmtr('L',uplo,'N',n,m,a,lda,work(indtau),z,ldz,work( &
                               indwkn),llwrkn,iinfo)
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 30
              end if
              info = 0
           end if
           ! otherwise, call la_${ci}$stebz and, if eigenvectors are desired, la_${ri}$stein.
           ! also call la_${ci}$stebz and la_${ri}$stein if la_${ri}$stemr fails.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           call la_${ci}$stebz(range,order,n,vll,vuu,il,iu,abstll,rwork(indrd),rwork( &
           indre),m,nsplit,w,iwork(indibl),iwork(indisp),rwork(indrwk),iwork(indiwo) &
                     ,info)
           if (wantz) then
              call la_${ri}$stein(n,rwork(indrd),rwork(indre),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,rwork(indrwk),iwork(indiwo),iwork(indifl),info)
              ! apply unitary matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              indwkn = indwk
              llwrkn = lwork - indwkn + 1
              call la_${ri}$unmtr('L',uplo,'N',n,m,a,lda,work(indtau),z,ldz,work( &
                        indwkn),llwrkn,iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           30 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                 end if
              end do
           end if
           ! set work(1) to optimal workspace size.
           work(1) = lwkopt
           rwork(1) = lrwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$heevr
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEEVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a complex Hermitian matrix A.  Eigenvalues and eigenvectors can
     !> be selected by specifying either a range of values or a range of
     !> indices for the desired eigenvalues.

     subroutine la_${ri}$heevx(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z,ldz, &
               work,lwork,rwork,iwork,ifail,info)
        use la_constants_${rk}$,only:zero,one,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,lda,ldz,lwork,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lower,lquery,test,valeig,wantz
           character :: order
           integer(ilp) :: i,iinfo,imax,indd,inde,indee,indibl,indisp,indiwk,indrwk, &
                     indtau,indwrk,iscale,itmp1,j,jj,llwork,lwkmin,lwkopt,nb,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
           intrinsic :: real,max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           lower = la_lsame(uplo,'L')
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lquery = (lwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -8
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -9
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -10
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -15
              end if
           end if
           if (info == 0) then
              if (n <= 1) then
                 lwkmin = 1
                 work(1) = lwkmin
              else
                 lwkmin = 2*n
                 nb = la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
                 nb = max(nb,la_ilaenv(1,'${ri.upper()}$UNMTR',uplo,n,-1,-1,-1))
                 lwkopt = max(1, (nb + 1)*n)
                 work(1) = lwkopt
              end if
              if (lwork < lwkmin .and. .not. lquery) info = -17
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEEVX',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) then
              return
           end if
           if (n == 1) then
              if (alleig .or. indeig) then
                 m = 1
                 w(1) = real(a(1,1),KIND=${rk}$)
              else if (valeig) then
                 if (vl < real(a(1,1),KIND=${rk}$) .and. vu >= real(a(1,1),KIND=${rk}$)) then
                    m = 1
                    w(1) = real(a(1,1),KIND=${rk}$)
                 end if
              end if
              if (wantz) z(1,1) = cone
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           end if
           anrm = la_${ri}$lanhe('M',uplo,n,a,lda,rwork)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 do j = 1,n
                    call la_${ri}$${ci}$scal(n - j + 1,sigma,a(j,j),1)
                 end do
              else
                 do j = 1,n
                    call la_${ri}$${ci}$scal(j,sigma,a(1,j),1)
                 end do
              end if
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! call la_${ri}$hetrd to reduce hermitian matrix to tridiagonal form.
           indd = 1
           inde = indd + n
           indrwk = inde + n
           indtau = 1
           indwrk = indtau + n
           llwork = lwork - indwrk + 1
           call la_${ri}$hetrd(uplo,n,a,lda,rwork(indd),rwork(inde),work(indtau),work( &
                      indwrk),llwork,iinfo)
           ! if all eigenvalues are desired and abstol is less than or equal to
           ! zero, then call la_${ci}$sterf or la_${ri}$ungtr and la_${ri}$steqr.  if this fails for
           ! some eigenvalue, then try la_${ci}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ci}$copy(n,rwork(indd),1,w,1)
              indee = indrwk + 2*n
              if (.not. wantz) then
                 call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
                 call la_${ci}$sterf(n,w,rwork(indee),info)
              else
                 call la_${ri}$lacpy('A',n,n,a,lda,z,ldz)
                 call la_${ri}$ungtr(uplo,n,z,ldz,work(indtau),work(indwrk),llwork, &
                           iinfo)
                 call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
                 call la_${ri}$steqr(jobz,n,w,rwork(indee),z,ldz,rwork(indrwk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 40
              end if
              info = 0
           end if
           ! otherwise, call la_${ci}$stebz and, if eigenvectors are desired, la_${ri}$stein.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwk = indisp + n
           call la_${ci}$stebz(range,order,n,vll,vuu,il,iu,abstll,rwork(indd),rwork( &
           inde),m,nsplit,w,iwork(indibl),iwork(indisp),rwork(indrwk),iwork(indiwk), &
                      info)
           if (wantz) then
              call la_${ri}$stein(n,rwork(indd),rwork(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,rwork(indrwk),iwork(indiwk),ifail,info)
              ! apply unitary matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              call la_${ri}$unmtr('L',uplo,'N',n,m,a,lda,work(indtau),z,ldz,work( &
                        indwrk),llwork,iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           40 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           ! set work(1) to optimal complex workspace size.
           work(1) = lwkopt
           return
     end subroutine la_${ri}$heevx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEGV: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.
     !> Here A and B are assumed to be Hermitian and B is also
     !> positive definite.

     subroutine la_${ri}$hegv(itype,jobz,uplo,n,a,lda,b,ldb,w,work,lwork,rwork,info)
        use la_constants_${rk}$

        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,lda,ldb,lwork,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: trans
           integer(ilp) :: lwkopt,nb,neig
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1)
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info == 0) then
              nb = la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
              lwkopt = max(1, (nb + 1)*n)
              work(1) = lwkopt
              if (lwork < max(1,2*n - 1) .and. .not. lquery) then
                 info = -11
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEGV ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$potrf(uplo,n,b,ldb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$hegst(itype,uplo,n,a,lda,b,ldb,info)
           call la_${ri}$heev(jobz,uplo,n,a,lda,w,work,lwork,rwork,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              neig = n
              if (info > 0) neig = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = inv(l)**h*y or inv(u)*y
#:else
                 ! backtransform eigenvectors: x = inv(l)**h *y or inv(u)*y
#:endif
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'C'
                 end if
                 call la_${ri}$trsm('LEFT',uplo,trans,'NON-UNIT',n,neig,cone,b,ldb,a,lda &
                           )
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = l*y or u**h*y
#:else
                 ! backtransform eigenvectors: x = l*y or u**h *y
#:endif
                 if (upper) then
                    trans = 'C'
                 else
                    trans = 'N'
                 end if
                 call la_${ri}$trmm('LEFT',uplo,trans,'NON-UNIT',n,neig,cone,b,ldb,a,lda &
                           )
              end if
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$hegv
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEGVX: computes selected eigenvalues, and optionally, eigenvectors
     !> of a complex generalized Hermitian-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and
     !> B are assumed to be Hermitian and B is also positive definite.
     !> Eigenvalues and eigenvectors can be selected by specifying either a
     !> range of values or a range of indices for the desired eigenvalues.

     subroutine la_${ri}$hegvx(itype,jobz,range,uplo,n,a,lda,b,ldb,vl,vu,il,iu,abstol, &
                m,w,z,ldz,work,lwork,rwork,iwork,ifail,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,itype,iu,lda,ldb,ldz,lwork,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lquery,upper,valeig,wantz
           character :: trans
           integer(ilp) :: lwkopt,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lquery = (lwork == -1)
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -3
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -4
           else if (n < 0) then
              info = -5
           else if (lda < max(1,n)) then
              info = -7
           else if (ldb < max(1,n)) then
              info = -9
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -11
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -12
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -13
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -18
              end if
           end if
           if (info == 0) then
              nb = la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1)
              lwkopt = max(1, (nb + 1)*n)
              work(1) = lwkopt
              if (lwork < max(1,2*n) .and. .not. lquery) then
                 info = -20
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEGVX',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) then
              return
           end if
           ! form a cholesky factorization of b.
           call la_${ri}$potrf(uplo,n,b,ldb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$hegst(itype,uplo,n,a,lda,b,ldb,info)
           call la_${ri}$heevx(jobz,range,uplo,n,a,lda,vl,vu,il,iu,abstol,m,w,z,ldz, &
                     work,lwork,rwork,iwork,ifail,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              if (info > 0) m = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = inv(l)**h*y or inv(u)*y
#:else
                 ! backtransform eigenvectors: x = inv(l)**h *y or inv(u)*y
#:endif
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'C'
                 end if
                 call la_${ri}$trsm('LEFT',uplo,trans,'NON-UNIT',n,m,cone,b,ldb,z,ldz)

              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = l*y or u**h*y
#:else
                 ! backtransform eigenvectors: x = l*y or u**h *y
#:endif
                 if (upper) then
                    trans = 'C'
                 else
                    trans = 'N'
                 end if
                 call la_${ri}$trmm('LEFT',uplo,trans,'NON-UNIT',n,m,cone,b,ldb,z,ldz)

              end if
           end if
           ! set work(1) to optimal complex workspace size.
           work(1) = lwkopt
           return
     end subroutine la_${ri}$hegvx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HPEV: computes all the eigenvalues and, optionally, eigenvectors of a
     !> complex Hermitian matrix in packed storage.

     subroutine la_${ri}$hpev(jobz,uplo,n,ap,w,z,ldz,work,rwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldz,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ap(*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: wantz
           integer(ilp) :: iinfo,imax,inde,indrwk,indtau,indwrk,iscale
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (la_lsame(uplo,'L') .or. la_lsame(uplo,'U'))) &
                     then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HPEV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = real(ap(1),KIND=${rk}$)
              rwork(1) = 1
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lanhp('M',uplo,n,ap,rwork)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              call la_${ri}$${ci}$scal((n*(n + 1))/2,sigma,ap,1)
           end if
           ! call la_${ri}$hptrd to reduce hermitian packed matrix to tridiagonal form.
           inde = 1
           indtau = 1
           call la_${ri}$hptrd(uplo,n,ap,w,rwork(inde),work(indtau),iinfo)
           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, first call
           ! la_${ri}$upgtr to generate the orthogonal matrix, then call la_${ri}$steqr.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              indwrk = indtau + n
              call la_${ri}$upgtr(uplo,n,ap,work(indtau),z,ldz,work(indwrk),iinfo)

              indrwk = inde + n
              call la_${ri}$steqr(jobz,n,w,rwork(inde),z,ldz,rwork(indrwk),info)

           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           return
     end subroutine la_${ri}$hpev
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HPEVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a complex Hermitian matrix A in packed storage.
     !> Eigenvalues/vectors can be selected by specifying either a range of
     !> values or a range of indices for the desired eigenvalues.

     subroutine la_${ri}$hpevx(jobz,range,uplo,n,ap,vl,vu,il,iu,abstol,m,w,z,ldz, &
               work,rwork,iwork,ifail,info)
        use la_constants_${rk}$,only:zero,one,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ap(*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,test,valeig,wantz
           character :: order
           integer(ilp) :: i,iinfo,imax,indd,inde,indee,indibl,indisp,indiwk,indrwk, &
                     indtau,indwrk,iscale,itmp1,j,jj,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (la_lsame(uplo,'L') .or. la_lsame(uplo,'U'))) &
                     then
              info = -3
           else if (n < 0) then
              info = -4
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -7
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -8
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -9
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) info = -14
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HPEVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           if (n == 1) then
              if (alleig .or. indeig) then
                 m = 1
                 w(1) = real(ap(1),KIND=${rk}$)
              else
                 if (vl < real(ap(1),KIND=${rk}$) .and. vu >= real(ap(1),KIND=${rk}$)) then
                    m = 1
                    w(1) = real(ap(1),KIND=${rk}$)
                 end if
              end if
              if (wantz) z(1,1) = cone
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           else
              vll = zero
              vuu = zero
           end if
           anrm = la_${ri}$lanhp('M',uplo,n,ap,rwork)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              call la_${ri}$${ci}$scal((n*(n + 1))/2,sigma,ap,1)
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! call la_${ri}$hptrd to reduce hermitian packed matrix to tridiagonal form.
           indd = 1
           inde = indd + n
           indrwk = inde + n
           indtau = 1
           indwrk = indtau + n
           call la_${ri}$hptrd(uplo,n,ap,rwork(indd),rwork(inde),work(indtau),iinfo)

           ! if all eigenvalues are desired and abstol is less than or equal
           ! to zero, then call la_${ci}$sterf or la_${ri}$upgtr and la_${ri}$steqr.  if this fails
           ! for some eigenvalue, then try la_${ci}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ci}$copy(n,rwork(indd),1,w,1)
              indee = indrwk + 2*n
              if (.not. wantz) then
                 call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
                 call la_${ci}$sterf(n,w,rwork(indee),info)
              else
                 call la_${ri}$upgtr(uplo,n,ap,work(indtau),z,ldz,work(indwrk),iinfo)

                 call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
                 call la_${ri}$steqr(jobz,n,w,rwork(indee),z,ldz,rwork(indrwk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 20
              end if
              info = 0
           end if
           ! otherwise, call la_${ci}$stebz and, if eigenvectors are desired, la_${ri}$stein.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwk = indisp + n
           call la_${ci}$stebz(range,order,n,vll,vuu,il,iu,abstll,rwork(indd),rwork( &
           inde),m,nsplit,w,iwork(indibl),iwork(indisp),rwork(indrwk),iwork(indiwk), &
                      info)
           if (wantz) then
              call la_${ri}$stein(n,rwork(indd),rwork(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,rwork(indrwk),iwork(indiwk),ifail,info)
              ! apply unitary matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              indwrk = indtau + n
              call la_${ri}$upmtr('L',uplo,'N',n,m,ap,work(indtau),z,ldz,work(indwrk), &
                         iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           20 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$hpevx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HPGV: computes all the eigenvalues and, optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.
     !> Here A and B are assumed to be Hermitian, stored in packed format,
     !> and B is also positive definite.

     subroutine la_${ri}$hpgv(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,rwork,info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,ldz,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ap(*),bp(*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper,wantz
           character :: trans
           integer(ilp) :: j,neig
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HPGV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$pptrf(uplo,n,bp,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$hpgst(itype,uplo,n,ap,bp,info)
           call la_${ri}$hpev(jobz,uplo,n,ap,w,z,ldz,work,rwork,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              neig = n
              if (info > 0) neig = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = inv(l)**h*y or inv(u)*y
#:else
                 ! backtransform eigenvectors: x = inv(l)**h *y or inv(u)*y
#:endif
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'C'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpsv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = l*y or u**h*y
#:else
                 ! backtransform eigenvectors: x = l*y or u**h *y
#:endif
                 if (upper) then
                    trans = 'C'
                 else
                    trans = 'N'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpmv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              end if
           end if
           return
     end subroutine la_${ri}$hpgv
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HPGVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a complex generalized Hermitian-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and
     !> B are assumed to be Hermitian, stored in packed format, and B is also
     !> positive definite.  Eigenvalues and eigenvectors can be selected by
     !> specifying either a range of values or a range of indices for the
     !> desired eigenvalues.

     subroutine la_${ri}$hpgvx(itype,jobz,range,uplo,n,ap,bp,vl,vu,il,iu,abstol,m,w, &
               z,ldz,work,rwork,iwork,ifail,info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,itype,iu,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ap(*),bp(*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: alleig,indeig,upper,valeig,wantz
           character :: trans
           integer(ilp) :: j
           ! Intrinsic Functions
           intrinsic :: min
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -3
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -4
           else if (n < 0) then
              info = -5
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) then
                    info = -9
                 end if
              else if (indeig) then
                 if (il < 1) then
                    info = -10
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -11
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -16
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HPGVX',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$pptrf(uplo,n,bp,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$hpgst(itype,uplo,n,ap,bp,info)
           call la_${ri}$hpevx(jobz,range,uplo,n,ap,vl,vu,il,iu,abstol,m,w,z,ldz, &
                     work,rwork,iwork,ifail,info)
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              if (info > 0) m = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = inv(l)**h*y or inv(u)*y
#:else
                 ! backtransform eigenvectors: x = inv(l)**h *y or inv(u)*y
#:endif
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'C'
                 end if
                 do j = 1,m
                    call la_${ri}$tpsv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
#:if rk == "sp"
                 ! backtransform eigenvectors: x = l*y or u**h*y
#:else
                 ! backtransform eigenvectors: x = l*y or u**h *y
#:endif
                 if (upper) then
                    trans = 'C'
                 else
                    trans = 'N'
                 end if
                 do j = 1,m
                    call la_${ri}$tpmv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              end if
           end if
           return
     end subroutine la_${ri}$hpgvx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HBEV: computes all the eigenvalues and, optionally, eigenvectors of
     !> a complex Hermitian band matrix A.

     subroutine la_${ri}$hbev(jobz,uplo,n,kd,ab,ldab,w,z,ldz,work,rwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldz,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,wantz
           integer(ilp) :: iinfo,imax,inde,indrwk,iscale
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (kd < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HBEV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              if (lower) then
                 w(1) = real(ab(1,1),KIND=${rk}$)
              else
                 w(1) = real(ab(kd + 1,1),KIND=${rk}$)
              end if
              if (wantz) z(1,1) = one
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lanhb('M',uplo,n,kd,ab,ldab,rwork)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 call la_${ri}$lascl('B',kd,kd,one,sigma,n,n,ab,ldab,info)
              else
                 call la_${ri}$lascl('Q',kd,kd,one,sigma,n,n,ab,ldab,info)
              end if
           end if
           ! call la_${ri}$hbtrd to reduce hermitian band matrix to tridiagonal form.
           inde = 1
           call la_${ri}$hbtrd(jobz,uplo,n,kd,ab,ldab,w,rwork(inde),z,ldz,work,iinfo)

           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, call la_${ri}$steqr.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              indrwk = inde + n
              call la_${ri}$steqr(jobz,n,w,rwork(inde),z,ldz,rwork(indrwk),info)

           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           return
     end subroutine la_${ri}$hbev
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HBEVD: computes all the eigenvalues and, optionally, eigenvectors of
     !> a complex Hermitian band matrix A.  If eigenvectors are desired, it
     !> uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$hbevd(jobz,uplo,n,kd,ab,ldab,w,z,ldz,work,lwork,rwork,lrwork, &
               iwork,liwork,info)
        use la_constants_${rk}$,only:zero,one,czero,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldz,liwork,lrwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,lquery,wantz
           integer(ilp) :: iinfo,imax,inde,indwk2,indwrk,iscale,liwmin,llrwk,llwk2, &
                     lrwmin,lwmin
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           lquery = (lwork == -1 .or. liwork == -1 .or. lrwork == -1)
           info = 0
           if (n <= 1) then
              lwmin = 1
              lrwmin = 1
              liwmin = 1
           else
              if (wantz) then
                 lwmin = 2*n**2
                 lrwmin = 1 + 5*n + 2*n**2
                 liwmin = 3 + 5*n
              else
                 lwmin = n
                 lrwmin = n
                 liwmin = 1
              end if
           end if
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (kd < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info == 0) then
              work(1) = lwmin
              rwork(1) = lrwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -11
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -13
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -15
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HBEVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = real(ab(1,1),KIND=${rk}$)
              if (wantz) z(1,1) = cone
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lanhb('M',uplo,n,kd,ab,ldab,rwork)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 call la_${ri}$lascl('B',kd,kd,one,sigma,n,n,ab,ldab,info)
              else
                 call la_${ri}$lascl('Q',kd,kd,one,sigma,n,n,ab,ldab,info)
              end if
           end if
           ! call la_${ri}$hbtrd to reduce hermitian band matrix to tridiagonal form.
           inde = 1
           indwrk = inde + n
           indwk2 = 1 + n*n
           llwk2 = lwork - indwk2 + 1
           llrwk = lrwork - indwrk + 1
           call la_${ri}$hbtrd(jobz,uplo,n,kd,ab,ldab,w,rwork(inde),z,ldz,work,iinfo)

           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, call la_${ri}$stedc.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              call la_${ri}$stedc('I',n,w,rwork(inde),work,n,work(indwk2),llwk2,rwork( &
                        indwrk),llrwk,iwork,liwork,info)
              call la_${ri}$gemm('N','N',n,n,n,cone,z,ldz,work,n,czero,work(indwk2), &
                        n)
              call la_${ri}$lacpy('A',n,n,work(indwk2),n,z,ldz)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           work(1) = lwmin
           rwork(1) = lrwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$hbevd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HBEVX: computes selected eigenvalues and, optionally, eigenvectors
     !> of a complex Hermitian band matrix A.  Eigenvalues and eigenvectors
     !> can be selected by specifying either a range of values or a range of
     !> indices for the desired eigenvalues.

     subroutine la_${ri}$hbevx(jobz,range,uplo,n,kd,ab,ldab,q,ldq,vl,vu,il,iu,abstol, &
               m,w,z,ldz,work,rwork,iwork,ifail,info)
        use la_constants_${rk}$,only:zero,one,czero,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,kd,ldab,ldq,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
           complex(${rk}$),intent(out) :: q(ldq,*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,lower,test,valeig,wantz
           character :: order
           integer(ilp) :: i,iinfo,imax,indd,inde,indee,indibl,indisp,indiwk,indrwk, &
                     indwrk,iscale,itmp1,j,jj,nsplit
           real(${rk}$) :: abstll,anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum,tmp1,vll, &
                     vuu
           complex(${rk}$) :: ctmp1
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           lower = la_lsame(uplo,'L')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (kd < 0) then
              info = -5
           else if (ldab < kd + 1) then
              info = -7
           else if (wantz .and. ldq < max(1,n)) then
              info = -9
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -11
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -12
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -13
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) info = -18
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HBEVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           if (n == 1) then
              m = 1
              if (lower) then
                 ctmp1 = ab(1,1)
              else
                 ctmp1 = ab(kd + 1,1)
              end if
              tmp1 = real(ctmp1,KIND=${rk}$)
              if (valeig) then
                 if (.not. (vl < tmp1 .and. vu >= tmp1)) m = 0
              end if
              if (m == 1) then
                 w(1) = real(ctmp1,KIND=${rk}$)
                 if (wantz) z(1,1) = cone
              end if
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = min(sqrt(bignum),one/sqrt(sqrt(safmin)))
           ! scale matrix to allowable range, if necessary.
           iscale = 0
           abstll = abstol
           if (valeig) then
              vll = vl
              vuu = vu
           else
              vll = zero
              vuu = zero
           end if
           anrm = la_${ri}$lanhb('M',uplo,n,kd,ab,ldab,rwork)
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              if (lower) then
                 call la_${ri}$lascl('B',kd,kd,one,sigma,n,n,ab,ldab,info)
              else
                 call la_${ri}$lascl('Q',kd,kd,one,sigma,n,n,ab,ldab,info)
              end if
              if (abstol > 0) abstll = abstol*sigma
              if (valeig) then
                 vll = vl*sigma
                 vuu = vu*sigma
              end if
           end if
           ! call la_${ri}$hbtrd to reduce hermitian band matrix to tridiagonal form.
           indd = 1
           inde = indd + n
           indrwk = inde + n
           indwrk = 1
           call la_${ri}$hbtrd(jobz,uplo,n,kd,ab,ldab,rwork(indd),rwork(inde),q,ldq, &
                     work(indwrk),iinfo)
           ! if all eigenvalues are desired and abstol is less than or equal
           ! to zero, then call la_${ci}$sterf or la_${ri}$steqr.  if this fails for some
           ! eigenvalue, then try la_${ci}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ci}$copy(n,rwork(indd),1,w,1)
              indee = indrwk + 2*n
              if (.not. wantz) then
                 call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
                 call la_${ci}$sterf(n,w,rwork(indee),info)
              else
                 call la_${ri}$lacpy('A',n,n,q,ldq,z,ldz)
                 call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
                 call la_${ri}$steqr(jobz,n,w,rwork(indee),z,ldz,rwork(indrwk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 30
              end if
              info = 0
           end if
           ! otherwise, call la_${ci}$stebz and, if eigenvectors are desired, la_${ri}$stein.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwk = indisp + n
           call la_${ci}$stebz(range,order,n,vll,vuu,il,iu,abstll,rwork(indd),rwork( &
           inde),m,nsplit,w,iwork(indibl),iwork(indisp),rwork(indrwk),iwork(indiwk), &
                      info)
           if (wantz) then
              call la_${ri}$stein(n,rwork(indd),rwork(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,rwork(indrwk),iwork(indiwk),ifail,info)
              ! apply unitary matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              do j = 1,m
                 call la_${ri}$copy(n,z(1,j),1,work(1),1)
                 call la_${ri}$gemv('N',n,n,cone,q,ldq,work,1,czero,z(1,j),1)
              end do
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           30 continue
           if (iscale == 1) then
              if (info == 0) then
                 imax = m
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$hbevx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HBGV: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite banded eigenproblem, of
     !> the form A*x=(lambda)*B*x. Here A and B are assumed to be Hermitian
     !> and banded, and B is also positive definite.

     pure subroutine la_${ri}$hbgv(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,w,z,ldz,work, &
               rwork,info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldz,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*),bb(ldbb,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper,wantz
           character :: vect
           integer(ilp) :: iinfo,inde,indwrk
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ka < 0) then
              info = -4
           else if (kb < 0 .or. kb > ka) then
              info = -5
           else if (ldab < ka + 1) then
              info = -7
           else if (ldbb < kb + 1) then
              info = -9
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HBGV ',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a split cholesky factorization of b.
           call la_${ri}$pbstf(uplo,n,kb,bb,ldbb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem.
           inde = 1
           indwrk = inde + n
           call la_${ri}$hbgst(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,z,ldz,work,rwork( &
                     indwrk),iinfo)
           ! reduce to tridiagonal form.
           if (wantz) then
              vect = 'U'
           else
              vect = 'N'
           end if
           call la_${ri}$hbtrd(vect,uplo,n,ka,ab,ldab,w,rwork(inde),z,ldz,work,iinfo)

           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, call la_${ri}$steqr.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              call la_${ri}$steqr(jobz,n,w,rwork(inde),z,ldz,rwork(indwrk),info)

           end if
           return
     end subroutine la_${ri}$hbgv
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HBGVD: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite banded eigenproblem, of
     !> the form A*x=(lambda)*B*x. Here A and B are assumed to be Hermitian
     !> and banded, and B is also positive definite.  If eigenvectors are
     !> desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     pure subroutine la_${ri}$hbgvd(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,w,z,ldz,work, &
               lwork,rwork,lrwork,iwork,liwork,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ka,kb,ldab,ldbb,ldz,liwork,lrwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*),bb(ldbb,*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: vect
           integer(ilp) :: iinfo,inde,indwk2,indwrk,liwmin,llrwk,llwk2,lrwmin, &
                     lwmin
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1 .or. lrwork == -1 .or. liwork == -1)
           info = 0
           if (n <= 1) then
              lwmin = 1 + n
              lrwmin = 1 + n
              liwmin = 1
           else if (wantz) then
              lwmin = 2*n**2
              lrwmin = 1 + 5*n + 2*n**2
              liwmin = 3 + 5*n
           else
              lwmin = n
              lrwmin = n
              liwmin = 1
           end if
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ka < 0) then
              info = -4
           else if (kb < 0 .or. kb > ka) then
              info = -5
           else if (ldab < ka + 1) then
              info = -7
           else if (ldbb < kb + 1) then
              info = -9
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -12
           end if
           if (info == 0) then
              work(1) = lwmin
              rwork(1) = lrwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -14
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -16
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -18
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HBGVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a split cholesky factorization of b.
           call la_${ri}$pbstf(uplo,n,kb,bb,ldbb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem.
           inde = 1
           indwrk = inde + n
           indwk2 = 1 + n*n
           llwk2 = lwork - indwk2 + 2
           llrwk = lrwork - indwrk + 2
           call la_${ri}$hbgst(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,z,ldz,work,rwork, &
                     iinfo)
           ! reduce hermitian band matrix to tridiagonal form.
           if (wantz) then
              vect = 'U'
           else
              vect = 'N'
           end if
           call la_${ri}$hbtrd(vect,uplo,n,ka,ab,ldab,w,rwork(inde),z,ldz,work,iinfo)

           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, call la_${ri}$stedc.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              call la_${ri}$stedc('I',n,w,rwork(inde),work,n,work(indwk2),llwk2,rwork( &
                        indwrk),llrwk,iwork,liwork,info)
              call la_${ri}$gemm('N','N',n,n,n,cone,z,ldz,work,n,czero,work(indwk2), &
                        n)
              call la_${ri}$lacpy('A',n,n,work(indwk2),n,z,ldz)
           end if
           work(1) = lwmin
           rwork(1) = lrwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$hbgvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HBGVX: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite banded eigenproblem, of
     !> the form A*x=(lambda)*B*x. Here A and B are assumed to be Hermitian
     !> and banded, and B is also positive definite.  Eigenvalues and
     !> eigenvectors can be selected by specifying either all eigenvalues,
     !> a range of values or a range of indices for the desired eigenvalues.

     pure subroutine la_${ri}$hbgvx(jobz,range,uplo,n,ka,kb,ab,ldab,bb,ldbb,q,ldq,vl, &
               vu,il,iu,abstol,m,w,z,ldz,work,rwork,iwork,ifail,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,range,uplo
           integer(ilp),intent(in) :: il,iu,ka,kb,ldab,ldbb,ldq,ldz,n
           integer(ilp),intent(out) :: info,m
           real(${rk}$),intent(in) :: abstol,vl,vu
           ! Array Arguments
           integer(ilp),intent(out) :: ifail(*),iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*),bb(ldbb,*)
           complex(${rk}$),intent(out) :: q(ldq,*),work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: alleig,indeig,test,upper,valeig,wantz
           character :: order,vect
           integer(ilp) :: i,iinfo,indd,inde,indee,indibl,indisp,indiwk,indrwk,indwrk, &
                     itmp1,j,jj,nsplit
           real(${rk}$) :: tmp1
           ! Intrinsic Functions
           intrinsic :: min
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           alleig = la_lsame(range,'A')
           valeig = la_lsame(range,'V')
           indeig = la_lsame(range,'I')
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (alleig .or. valeig .or. indeig)) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (ka < 0) then
              info = -5
           else if (kb < 0 .or. kb > ka) then
              info = -6
           else if (ldab < ka + 1) then
              info = -8
           else if (ldbb < kb + 1) then
              info = -10
           else if (ldq < 1 .or. (wantz .and. ldq < n)) then
              info = -12
           else
              if (valeig) then
                 if (n > 0 .and. vu <= vl) info = -14
              else if (indeig) then
                 if (il < 1 .or. il > max(1,n)) then
                    info = -15
                 else if (iu < min(n,il) .or. iu > n) then
                    info = -16
                 end if
              end if
           end if
           if (info == 0) then
              if (ldz < 1 .or. (wantz .and. ldz < n)) then
                 info = -21
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HBGVX',-info)
              return
           end if
           ! quick return if possible
           m = 0
           if (n == 0) return
           ! form a split cholesky factorization of b.
           call la_${ri}$pbstf(uplo,n,kb,bb,ldbb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem.
           call la_${ri}$hbgst(jobz,uplo,n,ka,kb,ab,ldab,bb,ldbb,q,ldq,work,rwork, &
                     iinfo)
           ! solve the standard eigenvalue problem.
           ! reduce hermitian band matrix to tridiagonal form.
           indd = 1
           inde = indd + n
           indrwk = inde + n
           indwrk = 1
           if (wantz) then
              vect = 'U'
           else
              vect = 'N'
           end if
           call la_${ri}$hbtrd(vect,uplo,n,ka,ab,ldab,rwork(indd),rwork(inde),q,ldq, &
                     work(indwrk),iinfo)
           ! if all eigenvalues are desired and abstol is less than or equal
           ! to zero, then call la_${ci}$sterf or la_${ri}$steqr.  if this fails for some
           ! eigenvalue, then try la_${ci}$stebz.
           test = .false.
           if (indeig) then
              if (il == 1 .and. iu == n) then
                 test = .true.
              end if
           end if
           if ((alleig .or. test) .and. (abstol <= zero)) then
              call la_${ci}$copy(n,rwork(indd),1,w,1)
              indee = indrwk + 2*n
              call la_${ci}$copy(n - 1,rwork(inde),1,rwork(indee),1)
              if (.not. wantz) then
                 call la_${ci}$sterf(n,w,rwork(indee),info)
              else
                 call la_${ri}$lacpy('A',n,n,q,ldq,z,ldz)
                 call la_${ri}$steqr(jobz,n,w,rwork(indee),z,ldz,rwork(indrwk),info)

                 if (info == 0) then
                    do i = 1,n
                       ifail(i) = 0
                    end do
                 end if
              end if
              if (info == 0) then
                 m = n
                 go to 30
              end if
              info = 0
           end if
           ! otherwise, call la_${ci}$stebz and, if eigenvectors are desired,
           ! call la_${ri}$stein.
           if (wantz) then
              order = 'B'
           else
              order = 'E'
           end if
           indibl = 1
           indisp = indibl + n
           indiwk = indisp + n
           call la_${ci}$stebz(range,order,n,vl,vu,il,iu,abstol,rwork(indd),rwork(inde &
           ),m,nsplit,w,iwork(indibl),iwork(indisp),rwork(indrwk),iwork(indiwk), &
                     info)
           if (wantz) then
              call la_${ri}$stein(n,rwork(indd),rwork(inde),m,w,iwork(indibl),iwork( &
                        indisp),z,ldz,rwork(indrwk),iwork(indiwk),ifail,info)
              ! apply unitary matrix used in reduction to tridiagonal
              ! form to eigenvectors returned by la_${ri}$stein.
              do j = 1,m
                 call la_${ri}$copy(n,z(1,j),1,work(1),1)
                 call la_${ri}$gemv('N',n,n,cone,q,ldq,work,1,czero,z(1,j),1)
              end do
           end if
           30 continue
           ! if eigenvalues are not in order, then sort them, along with
           ! eigenvectors.
           if (wantz) then
              do j = 1,m - 1
                 i = 0
                 tmp1 = w(j)
                 do jj = j + 1,m
                    if (w(jj) < tmp1) then
                       i = jj
                       tmp1 = w(jj)
                    end if
                 end do
                 if (i /= 0) then
                    itmp1 = iwork(indibl + i - 1)
                    w(i) = w(j)
                    iwork(indibl + i - 1) = iwork(indibl + j - 1)
                    w(j) = tmp1
                    iwork(indibl + j - 1) = itmp1
                    call la_${ri}$swap(n,z(1,i),1,z(1,j),1)
                    if (info /= 0) then
                       itmp1 = ifail(i)
                       ifail(i) = ifail(j)
                       ifail(j) = itmp1
                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$hbgvx
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEEVD: computes all eigenvalues and, optionally, eigenvectors of a
     !> complex Hermitian matrix A.  If eigenvectors are desired, it uses a
     !> divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$heevd(jobz,uplo,n,a,lda,w,work,lwork,rwork,lrwork,iwork,liwork, &
                info)
        use la_constants_${rk}$,only:zero,one,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,liwork,lrwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,lquery,wantz
           integer(ilp) :: iinfo,imax,inde,indrwk,indtau,indwk2,indwrk,iscale,liopt, &
                     liwmin,llrwk,llwork,llwrk2,lopt,lropt,lrwmin,lwmin
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: max,sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lower = la_lsame(uplo,'L')
           lquery = (lwork == -1 .or. lrwork == -1 .or. liwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (lower .or. la_lsame(uplo,'U'))) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           end if
           if (info == 0) then
              if (n <= 1) then
                 lwmin = 1
                 lrwmin = 1
                 liwmin = 1
                 lopt = lwmin
                 lropt = lrwmin
                 liopt = liwmin
              else
                 if (wantz) then
                    lwmin = 2*n + n*n
                    lrwmin = 1 + 5*n + 2*n**2
                    liwmin = 3 + 5*n
                 else
                    lwmin = n + 1
                    lrwmin = n
                    liwmin = 1
                 end if
                 lopt = max(lwmin,n + la_ilaenv(1,'${ri.upper()}$HETRD',uplo,n,-1,-1,-1))
                 lropt = lrwmin
                 liopt = liwmin
              end if
              work(1) = lopt
              rwork(1) = lropt
              iwork(1) = liopt
              if (lwork < lwmin .and. .not. lquery) then
                 info = -8
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -10
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -12
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEEVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = real(a(1,1),KIND=${rk}$)
              if (wantz) a(1,1) = cone
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lanhe('M',uplo,n,a,lda,rwork)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) call la_${ri}$lascl(uplo,0,0,one,sigma,n,n,a,lda,info)
           ! call la_${ri}$hetrd to reduce hermitian matrix to tridiagonal form.
           inde = 1
           indtau = 1
           indwrk = indtau + n
           indrwk = inde + n
           indwk2 = indwrk + n*n
           llwork = lwork - indwrk + 1
           llwrk2 = lwork - indwk2 + 1
           llrwk = lrwork - indrwk + 1
           call la_${ri}$hetrd(uplo,n,a,lda,w,rwork(inde),work(indtau),work(indwrk), &
                     llwork,iinfo)
           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, first call
           ! la_${ri}$stedc to generate the eigenvector matrix, work(indwrk), of the
           ! tridiagonal matrix, then call la_${ri}$unmtr to multiply it to the
           ! householder transformations represented as householder vectors in
           ! a.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              call la_${ri}$stedc('I',n,w,rwork(inde),work(indwrk),n,work(indwk2), &
                        llwrk2,rwork(indrwk),llrwk,iwork,liwork,info)
              call la_${ri}$unmtr('L',uplo,'N',n,n,a,lda,work(indtau),work(indwrk),n, &
                        work(indwk2),llwrk2,iinfo)
              call la_${ri}$lacpy('A',n,n,work(indwrk),n,a,lda)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           work(1) = lopt
           rwork(1) = lropt
           iwork(1) = liopt
           return
     end subroutine la_${ri}$heevd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HEGVD: computes all the eigenvalues, and optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and
     !> B are assumed to be Hermitian and B is also positive definite.
     !> If eigenvectors are desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$hegvd(itype,jobz,uplo,n,a,lda,b,ldb,w,work,lwork,rwork,lrwork, &
                iwork,liwork,info)
        use la_constants_${rk}$
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,lda,ldb,liwork,lrwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: trans
           integer(ilp) :: liopt,liwmin,lopt,lropt,lrwmin,lwmin
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,real
#:else
           intrinsic :: real,max
#:endif
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1 .or. lrwork == -1 .or. liwork == -1)
           info = 0
           if (n <= 1) then
              lwmin = 1
              lrwmin = 1
              liwmin = 1
           else if (wantz) then
              lwmin = 2*n + n*n
              lrwmin = 1 + 5*n + 2*n*n
              liwmin = 3 + 5*n
           else
              lwmin = n + 1
              lrwmin = n
              liwmin = 1
           end if
           lopt = lwmin
           lropt = lrwmin
           liopt = liwmin
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info == 0) then
              work(1) = lopt
              rwork(1) = lropt
              iwork(1) = liopt
              if (lwork < lwmin .and. .not. lquery) then
                 info = -11
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -13
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -15
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HEGVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$potrf(uplo,n,b,ldb,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$hegst(itype,uplo,n,a,lda,b,ldb,info)
           call la_${ri}$heevd(jobz,uplo,n,a,lda,w,work,lwork,rwork,lrwork,iwork,liwork, &
                      info)
           lopt = max(real(lopt,KIND=${rk}$),real(work(1),KIND=${rk}$))
           lropt = max(real(lropt,KIND=${rk}$),real(rwork(1),KIND=${rk}$))
           liopt = max(real(liopt,KIND=${rk}$),real(iwork(1),KIND=${rk}$))
           if (wantz .and. info == 0) then
              ! backtransform eigenvectors to the original problem.
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**h *y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'C'
                 end if
                 call la_${ri}$trsm('LEFT',uplo,trans,'NON-UNIT',n,n,cone,b,ldb,a,lda)

              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**h *y
                 if (upper) then
                    trans = 'C'
                 else
                    trans = 'N'
                 end if
                 call la_${ri}$trmm('LEFT',uplo,trans,'NON-UNIT',n,n,cone,b,ldb,a,lda)

              end if
           end if
           work(1) = lopt
           rwork(1) = lropt
           iwork(1) = liopt
           return
     end subroutine la_${ri}$hegvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HPEVD: computes all the eigenvalues and, optionally, eigenvectors of
     !> a complex Hermitian matrix A in packed storage.  If eigenvectors are
     !> desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$hpevd(jobz,uplo,n,ap,w,z,ldz,work,lwork,rwork,lrwork,iwork, &
               liwork,info)
        use la_constants_${rk}$,only:zero,one,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldz,liwork,lrwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ap(*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,wantz
           integer(ilp) :: iinfo,imax,inde,indrwk,indtau,indwrk,iscale,liwmin,llrwk, &
                     llwrk,lrwmin,lwmin
           real(${rk}$) :: anrm,bignum,eps,rmax,rmin,safmin,sigma,smlnum
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           lquery = (lwork == -1 .or. lrwork == -1 .or. liwork == -1)
           info = 0
           if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -1
           else if (.not. (la_lsame(uplo,'L') .or. la_lsame(uplo,'U'))) &
                     then
              info = -2
           else if (n < 0) then
              info = -3
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -7
           end if
           if (info == 0) then
              if (n <= 1) then
                 lwmin = 1
                 liwmin = 1
                 lrwmin = 1
              else
                 if (wantz) then
                    lwmin = 2*n
                    lrwmin = 1 + 5*n + 2*n**2
                    liwmin = 3 + 5*n
                 else
                    lwmin = n
                    lrwmin = n
                    liwmin = 1
                 end if
              end if
              work(1) = lwmin
              rwork(1) = lrwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -9
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -11
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -13
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HPEVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (n == 1) then
              w(1) = real(ap(1),KIND=${rk}$)
              if (wantz) z(1,1) = cone
              return
           end if
           ! get machine constants.
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           eps = la_${ci}$lamch('PRECISION')
           smlnum = safmin/eps
           bignum = one/smlnum
           rmin = sqrt(smlnum)
           rmax = sqrt(bignum)
           ! scale matrix to allowable range, if necessary.
           anrm = la_${ri}$lanhp('M',uplo,n,ap,rwork)
           iscale = 0
           if (anrm > zero .and. anrm < rmin) then
              iscale = 1
              sigma = rmin/anrm
           else if (anrm > rmax) then
              iscale = 1
              sigma = rmax/anrm
           end if
           if (iscale == 1) then
              call la_${ri}$${ci}$scal((n*(n + 1))/2,sigma,ap,1)
           end if
           ! call la_${ri}$hptrd to reduce hermitian packed matrix to tridiagonal form.
           inde = 1
           indtau = 1
           indrwk = inde + n
           indwrk = indtau + n
           llwrk = lwork - indwrk + 1
           llrwk = lrwork - indrwk + 1
           call la_${ri}$hptrd(uplo,n,ap,w,rwork(inde),work(indtau),iinfo)
           ! for eigenvalues only, call la_${ci}$sterf.  for eigenvectors, first call
           ! la_${ri}$upgtr to generate the orthogonal matrix, then call la_${ri}$stedc.
           if (.not. wantz) then
              call la_${ci}$sterf(n,w,rwork(inde),info)
           else
              call la_${ri}$stedc('I',n,w,rwork(inde),z,ldz,work(indwrk),llwrk,rwork( &
                        indrwk),llrwk,iwork,liwork,info)
              call la_${ri}$upmtr('L',uplo,'N',n,n,ap,work(indtau),z,ldz,work(indwrk), &
                         iinfo)
           end if
           ! if matrix was scaled, then rescale eigenvalues appropriately.
           if (iscale == 1) then
              if (info == 0) then
                 imax = n
              else
                 imax = info - 1
              end if
              call la_${ci}$scal(imax,one/sigma,w,1)
           end if
           work(1) = lwmin
           rwork(1) = lrwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$hpevd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$HPGVD: computes all the eigenvalues and, optionally, the eigenvectors
     !> of a complex generalized Hermitian-definite eigenproblem, of the form
     !> A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and
     !> B are assumed to be Hermitian, stored in packed format, and B is also
     !> positive definite.
     !> If eigenvectors are desired, it uses a divide and conquer algorithm.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$hpgvd(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,lwork,rwork,lrwork, &
                iwork,liwork,info)
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: itype,ldz,liwork,lrwork,lwork,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),w(*)
           complex(${rk}$),intent(inout) :: ap(*),bp(*)
           complex(${rk}$),intent(out) :: work(*),z(ldz,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery,upper,wantz
           character :: trans
           integer(ilp) :: j,liwmin,lrwmin,lwmin,neig
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,real
#:else
           intrinsic :: real,max
#:endif
           ! Executable Statements
           ! test the input parameters.
           wantz = la_lsame(jobz,'V')
           upper = la_lsame(uplo,'U')
           lquery = (lwork == -1 .or. lrwork == -1 .or. liwork == -1)
           info = 0
           if (itype < 1 .or. itype > 3) then
              info = -1
           else if (.not. (wantz .or. la_lsame(jobz,'N'))) then
              info = -2
           else if (.not. (upper .or. la_lsame(uplo,'L'))) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (ldz < 1 .or. (wantz .and. ldz < n)) then
              info = -9
           end if
           if (info == 0) then
              if (n <= 1) then
                 lwmin = 1
                 liwmin = 1
                 lrwmin = 1
              else
                 if (wantz) then
                    lwmin = 2*n
                    lrwmin = 1 + 5*n + 2*n**2
                    liwmin = 3 + 5*n
                 else
                    lwmin = n
                    lrwmin = n
                    liwmin = 1
                 end if
              end if
              work(1) = lwmin
              rwork(1) = lrwmin
              iwork(1) = liwmin
              if (lwork < lwmin .and. .not. lquery) then
                 info = -11
              else if (lrwork < lrwmin .and. .not. lquery) then
                 info = -13
              else if (liwork < liwmin .and. .not. lquery) then
                 info = -15
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$HPGVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! form a cholesky factorization of b.
           call la_${ri}$pptrf(uplo,n,bp,info)
           if (info /= 0) then
              info = n + info
              return
           end if
           ! transform problem to standard eigenvalue problem and solve.
           call la_${ri}$hpgst(itype,uplo,n,ap,bp,info)
           call la_${ri}$hpevd(jobz,uplo,n,ap,w,z,ldz,work,lwork,rwork,lrwork,iwork, &
                     liwork,info)
           lwmin = max(real(lwmin,KIND=${rk}$),real(work(1),KIND=${rk}$))
           lrwmin = max(real(lrwmin,KIND=${rk}$),real(rwork(1),KIND=${rk}$))
           liwmin = max(real(liwmin,KIND=${rk}$),real(iwork(1),KIND=${rk}$))
           if (wantz) then
              ! backtransform eigenvectors to the original problem.
              neig = n
              if (info > 0) neig = info - 1
              if (itype == 1 .or. itype == 2) then
                 ! for a*x=(lambda)*b*x and a*b*x=(lambda)*x;
                 ! backtransform eigenvectors: x = inv(l)**h *y or inv(u)*y
                 if (upper) then
                    trans = 'N'
                 else
                    trans = 'C'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpsv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              else if (itype == 3) then
                 ! for b*a*x=(lambda)*x;
                 ! backtransform eigenvectors: x = l*y or u**h *y
                 if (upper) then
                    trans = 'C'
                 else
                    trans = 'N'
                 end if
                 do j = 1,neig
                    call la_${ri}$tpmv(uplo,trans,'NON-UNIT',n,bp,z(1,j),1)
                 end do
              end if
           end if
           work(1) = lwmin
           rwork(1) = lrwmin
           iwork(1) = liwmin
           return
     end subroutine la_${ri}$hpgvd
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

end module la_lapack_eigv_sym
