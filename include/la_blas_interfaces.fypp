#:mute

#! Generic BLAS interfaces of module la_blas, one entry per generic: name, the lines
#! of its doc comment, (external specific name, module procedure, external stub) in
#! file order, and one external-stub template per type class, with {ri}/{ci}/{rt}/{rk}
#! and the neighbour fields of LA_BY_INITIAL as substitution fields.  Regenerate with
#! `python3 scripts/templatize.py --blas-interfaces`.

#:set LA_BLAS_INTERFACES = [ &
    & ('axpy', ['AXPY: constant times a vector plus a vector.'], &
    &  [('caxpy', 'caxpy', True), ('daxpy', 'daxpy', True), ('qaxpy', 'qaxpy', False), ('saxpy', 'saxpy', True), ('waxpy', 'waxpy', False), ('zaxpy', 'zaxpy', True)], &
    &  {'complex': '               pure subroutine {ri}axpy(n,{ri}a,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: {ri}a,{ri}x(*)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(inout) :: {ri}y(*)\n               end subroutine {ri}axpy', 'real': '               pure subroutine {ri}axpy(n,{ri}a,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: {ri}a,{ri}x(*)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(inout) :: {ri}y(*)\n               end subroutine {ri}axpy'}), &
    & ('copy', ['COPY: copies a vector x to a vector y.'], &
    &  [('ccopy', 'ccopy', True), ('dcopy', 'dcopy', True), ('qcopy', 'qcopy', False), ('scopy', 'scopy', True), ('wcopy', 'wcopy', False), ('zcopy', 'zcopy', True)], &
    &  {'complex': '               pure subroutine {ri}copy(n,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: {ri}x(*)\n                    {rt},intent(out) :: {ri}y(*)\n               end subroutine {ri}copy', 'real': '               pure subroutine {ri}copy(n,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: {ri}x(*)\n                    {rt},intent(out) :: {ri}y(*)\n               end subroutine {ri}copy'}), &
    & ('dot', ['DOT: forms the dot product of two vectors.', 'uses unrolled loops for increments equal to one.'], &
    &  [('ddot', 'ddot', True), ('qdot', 'qdot', False), ('sdot', 'sdot', True)], &
    &  {'real': '               pure {rt} function {ri}dot(n,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: {ri}x(*),{ri}y(*)\n               end function {ri}dot'}), &
    & ('dotc', ['DOTC: forms the dot product of two complex vectors', 'DOTC = X^H * Y'], &
    &  [('cdotc', 'cdotc', True), ('wdotc', 'wdotc', False), ('zdotc', 'zdotc', True)], &
    &  {'complex': '               pure {rt} function {ri}dotc(n,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: {ri}x(*),{ri}y(*)\n               end function {ri}dotc'}), &
    & ('dotu', ['DOTU: forms the dot product of two complex vectors', 'DOTU = X^T * Y'], &
    &  [('cdotu', 'cdotu', True), ('wdotu', 'wdotu', False), ('zdotu', 'zdotu', True)], &
    &  {'complex': '               pure {rt} function {ri}dotu(n,{ri}x,incx,{ri}y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: {ri}x(*),{ri}y(*)\n               end function {ri}dotu'}), &
    & ('gbmv', ['GBMV:  performs one of the matrix-vector operations', 'y := alpha*A*x + beta*y,   or   y := alpha*A**T*x + beta*y,   or', 'y := alpha*A**H*x + beta*y,', 'where alpha and beta are scalars, x and y are vectors and A is an', 'm by n band matrix, with kl sub-diagonals and ku super-diagonals.'], &
    &  [('cgbmv', 'cgbmv', True), ('dgbmv', 'dgbmv', True), ('qgbmv', 'qgbmv', False), ('sgbmv', 'sgbmv', True), ('wgbmv', 'wgbmv', False), ('zgbmv', 'zgbmv', True)], &
    &  {'complex': '               pure subroutine {ri}gbmv(trans,m,n,kl,ku,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    integer(ilp),intent(in) :: incx,incy,kl,ku,lda,m,n\n                    character,intent(in) :: trans\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}gbmv', 'real': '               pure subroutine {ri}gbmv(trans,m,n,kl,ku,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    integer(ilp),intent(in) :: incx,incy,kl,ku,lda,m,n\n                    character,intent(in) :: trans\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}gbmv'}), &
    & ('gemm', ['GEMM:  performs one of the matrix-matrix operations', 'C := alpha*op( A )*op( B ) + beta*C,', 'where  op( X ) is one of', 'op( X ) = X   or   op( X ) = X**T   or   op( X ) = X**H,', 'alpha and beta are scalars, and A, B and C are matrices, with op( A )', 'an m by k matrix,  op( B )  a  k by n matrix and  C an m by n matrix.'], &
    &  [('cgemm', 'cgemm', True), ('dgemm', 'dgemm', True), ('qgemm', 'qgemm', False), ('sgemm', 'sgemm', True), ('wgemm', 'wgemm', False), ('zgemm', 'zgemm', True)], &
    &  {'complex': '               pure subroutine {ri}gemm(transa,transb,m,n,k,alpha,a,lda,b,ldb,beta,c,ldc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),b(ldb,*)\n                    integer(ilp),intent(in) :: k,lda,ldb,ldc,m,n\n                    character,intent(in) :: transa,transb\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}gemm', 'real': '               pure subroutine {ri}gemm(transa,transb,m,n,k,alpha,a,lda,b,ldb,beta,c,ldc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),b(ldb,*)\n                    integer(ilp),intent(in) :: k,lda,ldb,ldc,m,n\n                    character,intent(in) :: transa,transb\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}gemm'}), &
    & ('gemv', ['GEMV: performs one of the matrix-vector operations', 'y := alpha*A*x + beta*y,   or   y := alpha*A**T*x + beta*y,   or', 'y := alpha*A**H*x + beta*y,', 'where alpha and beta are scalars, x and y are vectors and A is an', 'm by n matrix.'], &
    &  [('cgemv', 'cgemv', True), ('dgemv', 'dgemv', True), ('qgemv', 'qgemv', False), ('sgemv', 'sgemv', True), ('wgemv', 'wgemv', False), ('zgemv', 'zgemv', True)], &
    &  {'complex': '               pure subroutine {ri}gemv(trans,m,n,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,m,n\n                    character,intent(in) :: trans\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}gemv', 'real': '               pure subroutine {ri}gemv(trans,m,n,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,m,n\n                    character,intent(in) :: trans\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}gemv'}), &
    & ('ger', ['GER:   performs the rank 1 operation', 'A := alpha*x*y**T + A,', 'where alpha is a scalar, x is an m element vector, y is an n element', 'vector and A is an m by n matrix.'], &
    &  [('dger', 'dger', True), ('qger', 'qger', False), ('sger', 'sger', True)], &
    &  {'real': '               pure subroutine {ri}ger(m,n,alpha,x,incx,y,incy,a,lda)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,x(*),y(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,m,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}ger'}), &
    & ('gerc', ['GERC:  performs the rank 1 operation', 'A := alpha*x*y**H + A,', 'where alpha is a scalar, x is an m element vector, y is an n element', 'vector and A is an m by n matrix.'], &
    &  [('cgerc', 'cgerc', True), ('wgerc', 'wgerc', False), ('zgerc', 'zgerc', True)], &
    &  {'complex': '               pure subroutine {ri}gerc(m,n,alpha,x,incx,y,incy,a,lda)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,x(*),y(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,m,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}gerc'}), &
    & ('geru', ['GERU:  performs the rank 1 operation', 'A := alpha*x*y**T + A,', 'where alpha is a scalar, x is an m element vector, y is an n element', 'vector and A is an m by n matrix.'], &
    &  [('cgeru', 'cgeru', True), ('wgeru', 'wgeru', False), ('zgeru', 'zgeru', True)], &
    &  {'complex': '               pure subroutine {ri}geru(m,n,alpha,x,incx,y,incy,a,lda)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,x(*),y(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,m,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}geru'}), &
    & ('hbmv', ['HBMV:  performs the matrix-vector  operation', 'y := alpha*A*x + beta*y,', 'where alpha and beta are scalars, x and y are n element vectors and', 'A is an n by n hermitian band matrix, with k super-diagonals.'], &
    &  [('chbmv', 'chbmv', True), ('whbmv', 'whbmv', False), ('zhbmv', 'zhbmv', True)], &
    &  {'complex': '               pure subroutine {ri}hbmv(uplo,n,k,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    integer(ilp),intent(in) :: incx,incy,k,lda,n\n                    character,intent(in) :: uplo\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}hbmv'}), &
    & ('hemm', ['HEMM:  performs one of the matrix-matrix operations', 'C := alpha*A*B + beta*C,', 'or', 'C := alpha*B*A + beta*C,', 'where alpha and beta are scalars, A is an hermitian matrix and  B and', 'C are m by n matrices.'], &
    &  [('chemm', 'chemm', True), ('whemm', 'whemm', False), ('zhemm', 'zhemm', True)], &
    &  {'complex': '               pure subroutine {ri}hemm(side,uplo,m,n,alpha,a,lda,b,ldb,beta,c,ldc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),b(ldb,*)\n                    integer(ilp),intent(in) :: lda,ldb,ldc,m,n\n                    character,intent(in) :: side,uplo\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}hemm'}), &
    & ('hemv', ['HEMV:  performs the matrix-vector  operation', 'y := alpha*A*x + beta*y,', 'where alpha and beta are scalars, x and y are n element vectors and', 'A is an n by n hermitian matrix.'], &
    &  [('chemv', 'chemv', True), ('whemv', 'whemv', False), ('zhemv', 'zhemv', True)], &
    &  {'complex': '               pure subroutine {ri}hemv(uplo,n,alpha,a,lda,x,incx,beta,y,incy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,beta,a(lda,*),x(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,n\n                    character,intent(in) :: uplo\n                    {rt},intent(inout) :: y(*)\n               end subroutine {ri}hemv'}), &
    & ('her', ['HER:   performs the hermitian rank 1 operation', 'A := alpha*x*x**H + A,', 'where alpha is a real scalar, x is an n element vector and A is an', 'n by n hermitian matrix.'], &
    &  [('cher', 'cher', True), ('wher', 'wher', False), ('zher', 'zher', True)], &
    &  {'complex': '               pure subroutine {ri}her(uplo,n,alpha,x,incx,a,lda)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    real({rk}),intent(in) :: alpha\n                    integer(ilp),intent(in) :: incx,lda,n\n                    character,intent(in) :: uplo\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(in) :: x(*)\n               end subroutine {ri}her'}), &
    & ('her2', ['HER2:  performs the hermitian rank 2 operation', 'A := alpha*x*y**H + conjg( alpha )*y*x**H + A,', 'where alpha is a scalar, x and y are n element vectors and A is an n', 'by n hermitian matrix.'], &
    &  [('cher2', 'cher2', True), ('wher2', 'wher2', False), ('zher2', 'zher2', True)], &
    &  {'complex': '               pure subroutine {ri}her2(uplo,n,alpha,x,incx,y,incy,a,lda)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,x(*),y(*)\n                    integer(ilp),intent(in) :: incx,incy,lda,n\n                    character,intent(in) :: uplo\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}her2'}), &
    & ('her2k', ['HER2K:  performs one of the hermitian rank 2k operations', 'C := alpha*A*B**H + conjg( alpha )*B*A**H + beta*C,', 'or', 'C := alpha*A**H*B + conjg( alpha )*B**H*A + beta*C,', 'where  alpha and beta  are scalars with  beta  real,  C is an  n by n', 'hermitian matrix and  A and B  are  n by k matrices in the first case', 'and  k by n  matrices in the second case.'], &
    &  [('cher2k', 'cher2k', True), ('wher2k', 'wher2k', False), ('zher2k', 'zher2k', True)], &
    &  {'complex': '               pure subroutine {ri}her2k(uplo,trans,n,k,alpha,a,lda,b,ldb,beta,c,ldc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,a(lda,*),b(ldb,*)\n                    real({rk}),intent(in) :: beta\n                    integer(ilp),intent(in) :: k,lda,ldb,ldc,n\n                    character,intent(in) :: trans,uplo\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}her2k'}), &
    & ('herk', ['HERK:  performs one of the hermitian rank k operations', 'C := alpha*A*A**H + beta*C,', 'or', 'C := alpha*A**H*A + beta*C,', 'where  alpha and beta  are  real scalars,  C is an  n by n  hermitian', 'matrix and  A  is an  n by k  matrix in the  first case and a  k by n', 'matrix in the second case.'], &
    &  [('cherk', 'cherk', True), ('wherk', 'wherk', False), ('zherk', 'zherk', True)], &
    &  {'complex': '               pure subroutine {ri}herk(uplo,trans,n,k,alpha,a,lda,beta,c,ldc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    real({rk}),intent(in) :: alpha,beta\n                    integer(ilp),intent(in) :: k,lda,ldc,n\n                    character,intent(in) :: trans,uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}herk'}), &
    & ('hpmv', ['HPMV:  performs the matrix-vector operation', 'y := alpha*A*x + beta*y,', 'where alpha and beta are scalars, x and y are n element vectors and', 'A is an n by n hermitian matrix, supplied in packed form.'], &
    &  [('chpmv', 'chpmv', True), ('whpmv', 'whpmv', False), ('zhpmv', 'zhpmv', True)], &
