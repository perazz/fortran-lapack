     !> ${ri.upper()}$DOTC: forms the dot product of two complex vectors
     !> ${ri.upper()}$DOTC = X^H * Y

     pure complex(${rk}$) function la_${ri}$dotc(n,${ri}$x,incx,${ri}$y,incy)
        ! -- reference blas level1 routine --
        ! -- reference blas is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx,incy,n
           ! Array Arguments
           complex(${rk}$),intent(in) :: ${ri}$x(*),${ri}$y(*)
        ! =====================================================================
           ! Local Scalars
           complex(${rk}$) :: ${ri}$temp
           integer(ilp) :: i,ix,iy
           ! Intrinsic Functions
           intrinsic :: conjg
           ${ri}$temp = (0.0_${rk}$,0.0_${rk}$)
           la_${ri}$dotc = (0.0_${rk}$,0.0_${rk}$)
           if (n <= 0) return
           if (incx == 1 .and. incy == 1) then
              ! code for both increments equal to 1
              do i = 1,n
                 ${ri}$temp = ${ri}$temp + conjg(${ri}$x(i))*${ri}$y(i)
              end do
           else
              ! code for unequal increments or equal increments
                ! not equal to 1
              ix = 1
              iy = 1
              if (incx < 0) ix = (-n + 1)*incx + 1
              if (incy < 0) iy = (-n + 1)*incy + 1
              do i = 1,n
                 ${ri}$temp = ${ri}$temp + conjg(${ri}$x(ix))*${ri}$y(iy)
                 ix = ix + incx
                 iy = iy + incy
              end do
           end if
           la_${ri}$dotc = ${ri}$temp
           return
     end function la_${ri}$dotc
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

