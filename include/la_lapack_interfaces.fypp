    &  {'complex': '               pure subroutine {ri}pptrf(uplo,n,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}pptrf', 'real': '               pure subroutine {ri}pptrf(uplo,n,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}pptrf'}), &
    & ('pptri', ['PPTRI: computes the inverse of a complex Hermitian positive definite', 'matrix A using the Cholesky factorization A = U**H*U or A = L*L**H', 'computed by CPPTRF.'], &
    &  [('cpptri', 'cpptri', 'complex'), ('dpptri', 'dpptri', 'real'), ('qpptri', 'qpptri', None), ('spptri', 'spptri', 'real'), ('wpptri', 'wpptri', None), ('xpptri', 'xpptri', None), ('ypptri', 'ypptri', None), ('zpptri', 'zpptri', 'complex')], &
    &  {'complex': '               pure subroutine {ri}pptri(uplo,n,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}pptri', 'real': '               pure subroutine {ri}pptri(uplo,n,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}pptri'}), &
    & ('pptrs', ['PPTRS: solves a system of linear equations A*X = B with a Hermitian', 'positive definite matrix A in packed storage using the Cholesky', 'factorization A = U**H*U or A = L*L**H computed by CPPTRF.'], &
    &  [('cpptrs', 'cpptrs', 'complex'), ('dpptrs', 'dpptrs', 'real'), ('qpptrs', 'qpptrs', None), ('spptrs', 'spptrs', 'real'), ('wpptrs', 'wpptrs', None), ('xpptrs', 'xpptrs', None), ('ypptrs', 'ypptrs', None), ('zpptrs', 'zpptrs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}pptrs(uplo,n,nrhs,ap,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}pptrs', 'real': '               pure subroutine {ri}pptrs(uplo,n,nrhs,ap,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}pptrs'}), &
    & ('pstrf', ['PSTRF: computes the Cholesky factorization with complete', 'pivoting of a complex Hermitian positive semidefinite matrix A.', 'The factorization has the form', "P**T * A * P = U**H * U ,  if UPLO = 'U',", "P**T * A * P = L  * L**H,  if UPLO = 'L',", 'where U is an upper triangular matrix and L is lower triangular, and', 'P is stored as vector PIV.', 'This algorithm does not attempt to check that A is positive', 'semidefinite. This version of the algorithm calls level 3 BLAS.'], &
    &  [('cpstrf', 'cpstrf', 'complex'), ('dpstrf', 'dpstrf', 'real'), ('qpstrf', 'qpstrf', None), ('spstrf', 'spstrf', 'real'), ('wpstrf', 'wpstrf', None), ('xpstrf', 'xpstrf', None), ('ypstrf', 'ypstrf', None), ('zpstrf', 'zpstrf', 'complex')], &
    &  {'complex': '               pure subroutine {ri}pstrf(uplo,n,a,lda,piv,rank,tol,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    real({rk}),intent(in) :: tol\n                    integer(ilp),intent(out) :: info,rank,piv(n)\n                    integer(ilp),intent(in) :: lda,n\n                    character,intent(in) :: uplo\n                    {rt},intent(inout) :: a(lda,*)\n                    real({rk}),intent(out) :: work(2*n)\n               end subroutine {ri}pstrf', 'real': '               pure subroutine {ri}pstrf(uplo,n,a,lda,piv,rank,tol,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: tol\n                    integer(ilp),intent(out) :: info,rank,piv(n)\n                    integer(ilp),intent(in) :: lda,n\n                    character,intent(in) :: uplo\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: work(2*n)\n               end subroutine {ri}pstrf'}), &
    & ('ptcon', ['PTCON: computes the reciprocal of the condition number (in the', '1-norm) of a complex Hermitian positive definite tridiagonal matrix', 'using the factorization A = L*D*L**H or A = U**H*D*U computed by', 'CPTTRF.', 'Norm(inv(A)) is computed by a direct method, and the reciprocal of', 'the condition number is computed as', 'RCOND = 1 / (ANORM * norm(inv(A))).'], &
    &  [('cptcon', 'cptcon', 'complex'), ('dptcon', 'dptcon', 'real'), ('qptcon', 'qptcon', None), ('sptcon', 'sptcon', 'real'), ('wptcon', 'wptcon', None), ('xptcon', 'xptcon', None), ('yptcon', 'yptcon', None), ('zptcon', 'zptcon', 'complex')], &
    &  {'complex': '               pure subroutine {ri}ptcon(n,d,e,anorm,rcond,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    real({rk}),intent(in) :: anorm,d(*)\n                    real({rk}),intent(out) :: rcond,rwork(*)\n                    {rt},intent(in) :: e(*)\n               end subroutine {ri}ptcon', 'real': '               pure subroutine {ri}ptcon(n,d,e,anorm,rcond,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(in) :: anorm,d(*),e(*)\n                    {rt},intent(out) :: rcond,work(*)\n               end subroutine {ri}ptcon'}), &
    & ('pteqr', ['PTEQR: computes all eigenvalues and, optionally, eigenvectors of a', 'symmetric positive definite tridiagonal matrix by first factoring the', 'matrix using SPTTRF and then calling CBDSQR to compute the singular', 'values of the bidiagonal factor.', 'This routine computes the eigenvalues of the positive definite', 'tridiagonal matrix to high relative accuracy.  This means that if the', 'eigenvalues range over many orders of magnitude in size, then the', 'small eigenvalues and corresponding eigenvectors will be computed', 'more accurately than, for example, with the standard QR method.', 'The eigenvectors of a full or band positive definite Hermitian matrix', 'can also be found if CHETRD, CHPTRD, or CHBTRD has been used to', 'reduce this matrix to tridiagonal form.  (The reduction to', 'tridiagonal form, however, may preclude the possibility of obtaining', 'high relative accuracy in the small eigenvalues of the original', 'matrix, if these eigenvalues range over many orders of magnitude.)'], &
    &  [('cpteqr', 'cpteqr', 'complex'), ('dpteqr', 'dpteqr', 'real'), ('qpteqr', 'qpteqr', None), ('spteqr', 'spteqr', 'real'), ('wpteqr', 'wpteqr', None), ('xpteqr', 'xpteqr', None), ('ypteqr', 'ypteqr', None), ('zpteqr', 'zpteqr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}pteqr(compz,n,d,e,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compz\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: work(*)\n                    {rt},intent(inout) :: z(ldz,*)\n               end subroutine {ri}pteqr', 'real': '               pure subroutine {ri}pteqr(compz,n,d,e,z,ldz,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compz\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    {rt},intent(inout) :: d(*),e(*),z(ldz,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}pteqr'}), &
    & ('ptrfs', ['PTRFS: improves the computed solution to a system of linear', 'equations when the coefficient matrix is Hermitian positive definite', 'and tridiagonal, and provides error bounds and backward error', 'estimates for the solution.'], &
    &  [('cptrfs', 'cptrfs', 'complex'), ('dptrfs', 'dptrfs', 'real'), ('qptrfs', 'qptrfs', None), ('sptrfs', 'sptrfs', 'real'), ('wptrfs', 'wptrfs', None), ('xptrfs', 'xptrfs', None), ('yptrfs', 'yptrfs', None), ('zptrfs', 'zptrfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}ptrfs(uplo,n,nrhs,d,e,df,ef,b,ldb,x,ldx,ferr,berr, &\n                         work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    real({rk}),intent(in) :: d(*),df(*)\n                    {rt},intent(in) :: b(ldb,*),e(*),ef(*)\n                    {rt},intent(out) :: work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}ptrfs', 'real': '               pure subroutine {ri}ptrfs(n,nrhs,d,e,df,ef,b,ldb,x,ldx,ferr,berr,work, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs\n                    {rt},intent(in) :: b(ldb,*),d(*),df(*),e(*),ef(*)\n                    {rt},intent(out) :: berr(*),ferr(*),work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}ptrfs'}), &
    & ('ptsv', ['PTSV: computes the solution to a complex system of linear equations', 'A*X = B, where A is an N-by-N Hermitian positive definite tridiagonal', 'matrix, and X and B are N-by-NRHS matrices.', 'A is factored as A = L*D*L**H, and the factored form of A is then', 'used to solve the system of equations.'], &
    &  [('cptsv', 'cptsv', 'complex'), ('dptsv', 'dptsv', 'real'), ('qptsv', 'qptsv', None), ('sptsv', 'sptsv', 'real'), ('wptsv', 'wptsv', None), ('xptsv', 'xptsv', None), ('yptsv', 'yptsv', None), ('zptsv', 'zptsv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}ptsv(n,nrhs,d,e,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    real({rk}),intent(inout) :: d(*)\n                    {rt},intent(inout) :: b(ldb,*),e(*)\n               end subroutine {ri}ptsv', 'real': '               pure subroutine {ri}ptsv(n,nrhs,d,e,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(inout) :: b(ldb,*),d(*),e(*)\n               end subroutine {ri}ptsv'}), &
    & ('pttrf', ['PTTRF: computes the L*D*L**H factorization of a complex Hermitian', 'positive definite tridiagonal matrix A.  The factorization may also', 'be regarded as having the form A = U**H *D*U.'], &
    &  [('cpttrf', 'cpttrf', 'complex'), ('dpttrf', 'dpttrf', 'real'), ('qpttrf', 'qpttrf', None), ('spttrf', 'spttrf', 'real'), ('wpttrf', 'wpttrf', None), ('xpttrf', 'xpttrf', None), ('ypttrf', 'ypttrf', None), ('zpttrf', 'zpttrf', 'complex')], &
    &  {'complex': '               pure subroutine {ri}pttrf(n,d,e,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    real({rk}),intent(inout) :: d(*)\n                    {rt},intent(inout) :: e(*)\n               end subroutine {ri}pttrf', 'real': '               pure subroutine {ri}pttrf(n,d,e,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: d(*),e(*)\n               end subroutine {ri}pttrf'}), &
    & ('pttrs', ['PTTRS: solves a tridiagonal system of the form', 'A * X = B', 'using the factorization A = U**H*D*U or A = L*D*L**H computed by CPTTRF.', 'D is a diagonal matrix specified in the vector D, U (or L) is a unit', 'bidiagonal matrix whose superdiagonal (subdiagonal) is specified in', 'the vector E, and X and B are N by NRHS matrices.'], &
