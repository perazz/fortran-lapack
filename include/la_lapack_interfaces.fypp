    &  {'complex': '               pure subroutine {ri}lacgv(n,x,incx)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(inout) :: x(*)\n               end subroutine {ri}lacgv'}), &
    & ('lacon', ['LACON: estimates the 1-norm of a square, complex matrix A.', 'Reverse communication is used for evaluating matrix-vector products.'], &
    &  [('clacon', 'clacon', 'complex'), ('dlacon', 'dlacon', 'real'), ('qlacon', 'qlacon', None), ('slacon', 'slacon', 'real'), ('wlacon', 'wlacon', None), ('xlacon', 'xlacon', None), ('ylacon', 'ylacon', None), ('zlacon', 'zlacon', 'complex')], &
    &  {'complex': '               subroutine {ri}lacon(n,v,x,est,kase)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(inout) :: kase\n                    integer(ilp),intent(in) :: n\n                    real({rk}),intent(inout) :: est\n                    {rt},intent(out) :: v(n)\n                    {rt},intent(inout) :: x(n)\n               end subroutine {ri}lacon', 'real': '               subroutine {ri}lacon(n,v,x,isgn,est,kase)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(inout) :: kase\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: est,x(*)\n                    integer(ilp),intent(out) :: isgn(*)\n                    {rt},intent(out) :: v(*)\n               end subroutine {ri}lacon'}), &
    & ('lacpy', ['LACPY: copies all or part of a two-dimensional matrix A to another', 'matrix B.'], &
    &  [('clacpy', 'clacpy', 'complex'), ('dlacpy', 'dlacpy', 'real'), ('qlacpy', 'qlacpy', None), ('slacpy', 'slacpy', 'real'), ('wlacpy', 'wlacpy', None), ('xlacpy', 'xlacpy', None), ('ylacpy', 'ylacpy', None), ('zlacpy', 'zlacpy', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lacpy(uplo,m,n,a,lda,b,ldb)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: lda,ldb,m,n\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: b(ldb,*)\n               end subroutine {ri}lacpy', 'real': '               pure subroutine {ri}lacpy(uplo,m,n,a,lda,b,ldb)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: lda,ldb,m,n\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: b(ldb,*)\n               end subroutine {ri}lacpy'}), &
    & ('lacrm', ['LACRM: performs a very simple matrix-matrix multiplication:', 'C := A * B,', 'where A is M by N and complex; B is N by N and real;', 'C is M by N and complex.'], &
    &  [('clacrm', 'clacrm', 'complex'), ('wlacrm', 'wlacrm', None), ('ylacrm', 'ylacrm', None), ('zlacrm', 'zlacrm', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lacrm(m,n,a,lda,b,ldb,c,ldc,rwork)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: lda,ldb,ldc,m,n\n                    real({rk}),intent(in) :: b(ldb,*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: c(ldc,*)\n               end subroutine {ri}lacrm'}), &
    & ('lacrt', ['LACRT: performs the operation', '(  c  s )( x )  ==> ( x )', '( -s  c )( y )      ( y )', 'where c and s are complex and the vectors x and y are complex.'], &
    &  [('clacrt', 'clacrt', 'complex'), ('wlacrt', 'wlacrt', None), ('ylacrt', 'ylacrt', None), ('zlacrt', 'zlacrt', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lacrt(n,cx,incx,cy,incy,c,s)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,incy,n\n                    {rt},intent(in) :: c,s\n                    {rt},intent(inout) :: cx(*),cy(*)\n               end subroutine {ri}lacrt'}), &
    & ('ladiv_f', ['LADIV_F: := X / Y, where X and Y are complex.  The computation of X / Y', 'will not overflow on an intermediary step unless the results', 'overflows.'], &
    &  [('cladiv', 'cladiv', 'complex'), ('wladiv', 'wladiv', None), ('yladiv', 'yladiv', None), ('zladiv', 'zladiv', 'complex')], &
    &  {'complex': '               pure {rt} function {ri}ladiv(x,y)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: x,y\n               end function {ri}ladiv'}), &
    & ('ladiv_s', ['LADIV_S: performs complex division in  real arithmetic', 'a + i*b', 'p + i*q = ---------', 'c + i*d', 'The algorithm is due to Michael Baudin and Robert L. Smith', 'and can be found in the paper', '"A Robust Complex Division in Scilab"'], &
    &  [('dladiv', 'dladiv', 'real'), ('qladiv', 'qladiv', None), ('sladiv', 'sladiv', 'real'), ('xladiv', 'xladiv', None)], &
    &  {'real': '               pure subroutine {ri}ladiv(a,b,c,d,p,q)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: a,b,c,d\n                    {rt},intent(out) :: p,q\n               end subroutine {ri}ladiv'}), &
    & ('ladiv1', [], &
    &  [('dladiv1', 'dladiv1', 'real'), ('qladiv1', 'qladiv1', None), ('sladiv1', 'sladiv1', 'real'), ('xladiv1', 'xladiv1', None)], &
    &  {'real': '               pure subroutine {ri}ladiv1(a,b,c,d,p,q)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(inout) :: a\n                    {rt},intent(in) :: b,c,d\n                    {rt},intent(out) :: p,q\n               end subroutine {ri}ladiv1'}), &
    & ('ladiv2', [], &
    &  [('dladiv2', 'dladiv2', 'real'), ('qladiv2', 'qladiv2', None), ('sladiv2', 'sladiv2', 'real'), ('xladiv2', 'xladiv2', None)], &
    &  {'real': '               pure {rt} function {ri}ladiv2(a,b,c,d,r,t)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: a,b,c,d,r,t\n               end function {ri}ladiv2'}), &
    & ('laebz', ['LAEBZ: contains the iteration loops which compute and use the', 'function N(w), which is the count of eigenvalues of a symmetric', 'tridiagonal matrix T less than or equal to its argument  w.  It', 'performs a choice of two types of loops:', 'IJOB=1, followed by', 'IJOB=2: It takes as input a list of intervals and returns a list of', 'sufficiently small intervals whose union contains the same', 'eigenvalues as the union of the original intervals.', 'The input intervals are (AB(j,1),AB(j,2)], j=1,...,MINP.', 'The output interval (AB(j,1),AB(j,2)] will contain', 'eigenvalues NAB(j,1)+1,...,NAB(j,2), where 1 <= j <= MOUT.', 'IJOB=3: It performs a binary search in each input interval', '(AB(j,1),AB(j,2)] for a point  w(j)  such that', 'N(w(j))=NVAL(j), and uses  C(j)  as the starting point of', 'the search.  If such a w(j) is found, then on output', 'AB(j,1)=AB(j,2)=w.  If no such w(j) is found, then on output', '(AB(j,1),AB(j,2)] will be a small interval containing the', 'point where N(w) jumps through NVAL(j), unless that point', 'lies outside the initial interval.', 'Note that the intervals are in all cases half-open intervals,', 'i.e., of the form  (a,b] , which includes  b  but not  a .', 'To avoid underflow, the matrix should be scaled so that its largest', 'element is no greater than  overflow**(1/2) * underflow**(1/4)', 'in absolute value.  To assure the most accurate computation', 'of small eigenvalues, the matrix should be scaled to be', 'not much smaller than that, either.', 'See W. Kahan "Accurate Eigenvalues of a Symmetric Tridiagonal', 'Matrix", Report CS41, Computer Science Dept., Stanford', 'University, July 21, 1966', 'Note: the arguments are, in general, *not* checked for unreasonable', 'values.'], &
    &  [('dlaebz', 'dlaebz', 'real'), ('qlaebz', 'qlaebz', None), ('slaebz', 'slaebz', 'real'), ('xlaebz', 'xlaebz', None)], &
    &  {'real': '               pure subroutine {ri}laebz(ijob,nitmax,n,mmax,minp,nbmin,abstol,reltol,pivmin, &\n                         d,e,e2,nval,ab,c,mout,nab,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: ijob,minp,mmax,n,nbmin,nitmax\n                    integer(ilp),intent(out) :: info,mout,iwork(*)\n                    {rt},intent(in) :: abstol,pivmin,reltol,d(*),e(*),e2(*)\n                    integer(ilp),intent(inout) :: nab(mmax,*),nval(*)\n                    {rt},intent(inout) :: ab(mmax,*),c(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}laebz'}), &
    & ('laed0', ['Using the divide and conquer method, LAED0: computes all eigenvalues', 'of a symmetric tridiagonal matrix which is one diagonal block of', 'those from reducing a dense or band Hermitian matrix and', 'corresponding eigenvectors of the dense or band matrix.'], &
    &  [('claed0', 'claed0', 'complex'), ('dlaed0', 'dlaed0', 'real'), ('qlaed0', 'qlaed0', None), ('slaed0', 'slaed0', 'real'), ('wlaed0', 'wlaed0', None), ('xlaed0', 'xlaed0', None), ('ylaed0', 'ylaed0', None), ('zlaed0', 'zlaed0', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laed0(qsiz,n,d,e,q,ldq,qstore,ldqs,rwork,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldq,ldqs,n,qsiz\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: q(ldq,*)\n                    {rt},intent(out) :: qstore(ldqs,*)\n               end subroutine {ri}laed0', 'real': '               pure subroutine {ri}laed0(icompq,qsiz,n,d,e,q,ldq,qstore,ldqs,work,iwork, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: icompq,ldq,ldqs,n,qsiz\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    {rt},intent(inout) :: d(*),e(*),q(ldq,*)\n                    {rt},intent(out) :: qstore(ldqs,*),work(*)\n               end subroutine {ri}laed0'}), &
    & ('laed1', ['LAED1: computes the updated eigensystem of a diagonal', 'matrix after modification by a rank-one symmetric matrix.  This', 'routine is used only for the eigenproblem which requires all', 'eigenvalues and eigenvectors of a tridiagonal matrix.  DLAED7 handles', 'the case in which eigenvalues only or eigenvalues and eigenvectors', 'of a full symmetric matrix (which was reduced to tridiagonal form)', 'are desired.', 'T = Q(in) ( D(in) + RHO * Z*Z**T ) Q**T(in) = Q(out) * D(out) * Q**T(out)', 'where Z = Q**T*u, u is a vector of length N with ones in the', 'CUTPNT and CUTPNT + 1 th elements and zeros elsewhere.', 'The eigenvectors of the original matrix are stored in Q, and the', 'eigenvalues are in D.  The algorithm consists of three stages:', 'The first stage consists of deflating the size of the problem', 'when there are multiple eigenvalues or if there is a zero in', 'the Z vector.  For each such occurrence the dimension of the', 'secular equation problem is reduced by one.  This stage is', 'performed by the routine DLAED2.', 'The second stage consists of calculating the updated', 'eigenvalues. This is done by finding the roots of the secular', 'equation via the routine DLAED4 (as called by DLAED3).', 'This routine also calculates the eigenvectors of the current', 'problem.', 'The final stage consists of computing the updated eigenvectors', 'directly using the updated eigenvalues.  The eigenvectors for', 'the current problem are multiplied with the eigenvectors from', 'the overall problem.'], &
    &  [('dlaed1', 'dlaed1', 'real'), ('qlaed1', 'qlaed1', None), ('slaed1', 'slaed1', 'real'), ('xlaed1', 'xlaed1', None)], &
    &  {'real': '               pure subroutine {ri}laed1(n,d,q,ldq,indxq,rho,cutpnt,work,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: cutpnt,ldq,n\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    {rt},intent(inout) :: rho,d(*),q(ldq,*)\n                    integer(ilp),intent(inout) :: indxq(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}laed1'}), &
    & ('laed4', ['This subroutine computes the I-th updated eigenvalue of a symmetric', 'rank-one modification to a diagonal matrix whose elements are', 'given in the array d, and that', 'D(i) < D(j)  for  i < j', 'and that RHO > 0.  This is arranged by the calling routine, and is', 'no loss in generality.  The rank-one modified system is thus', 'diag( D )  +  RHO * Z * Z_transpose.', 'where we assume the Euclidean norm of Z is 1.', 'The method consists of approximating the rational functions in the', 'secular equation by simpler interpolating rational functions.'], &
    &  [('dlaed4', 'dlaed4', 'real'), ('qlaed4', 'qlaed4', None), ('slaed4', 'slaed4', 'real'), ('xlaed4', 'xlaed4', None)], &
    &  {'real': '               pure subroutine {ri}laed4(n,i,d,z,delta,rho,dlam,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: i,n\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(out) :: dlam,delta(*)\n                    {rt},intent(in) :: rho,d(*),z(*)\n               end subroutine {ri}laed4'}), &
    & ('laed5', ['This subroutine computes the I-th eigenvalue of a symmetric rank-one', 'modification of a 2-by-2 diagonal matrix', 'diag( D )  +  RHO * Z * transpose(Z) .', 'The diagonal elements in the array D are assumed to satisfy', 'D(i) < D(j)  for  i < j .', 'We also assume RHO > 0 and that the Euclidean norm of the vector', 'Z is one.'], &
    &  [('dlaed5', 'dlaed5', 'real'), ('qlaed5', 'qlaed5', None), ('slaed5', 'slaed5', 'real'), ('xlaed5', 'xlaed5', None)], &
    &  {'real': '               pure subroutine {ri}laed5(i,d,z,delta,rho,dlam)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: i\n                    {rt},intent(out) :: dlam,delta(2)\n                    {rt},intent(in) :: rho,d(2),z(2)\n               end subroutine {ri}laed5'}), &
    & ('laed6', ['LAED6: computes the positive or negative root (closest to the origin)', 'of', 'z(1)        z(2)        z(3)', 'f(x) =   rho + --------- + ---------- + ---------', 'd(1)-x      d(2)-x      d(3)-x', 'It is assumed that', 'if ORGATI = .true. the root is between d(2) and d(3);', 'otherwise it is between d(1) and d(2)', 'This routine will be called by DLAED4 when necessary. In most cases,', 'the root sought is the smallest in magnitude, though it might not be', 'in some extremely rare situations.'], &
    &  [('dlaed6', 'dlaed6', 'real'), ('qlaed6', 'qlaed6', None), ('slaed6', 'slaed6', 'real'), ('xlaed6', 'xlaed6', None)], &
    &  {'real': '               pure subroutine {ri}laed6(kniter,orgati,rho,d,z,finit,tau,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: orgati\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kniter\n                    {rt},intent(in) :: finit,rho,d(3),z(3)\n                    {rt},intent(out) :: tau\n               end subroutine {ri}laed6'}), &
    & ('laed7', ['LAED7: computes the updated eigensystem of a diagonal', 'matrix after modification by a rank-one symmetric matrix. This', 'routine is used only for the eigenproblem which requires all', 'eigenvalues and optionally eigenvectors of a dense or banded', 'Hermitian matrix that has been reduced to tridiagonal form.', 'T = Q(in) ( D(in) + RHO * Z*Z**H ) Q**H(in) = Q(out) * D(out) * Q**H(out)', 'where Z = Q**Hu, u is a vector of length N with ones in the', 'CUTPNT and CUTPNT + 1 th elements and zeros elsewhere.', 'The eigenvectors of the original matrix are stored in Q, and the', 'eigenvalues are in D.  The algorithm consists of three stages:', 'The first stage consists of deflating the size of the problem', 'when there are multiple eigenvalues or if there is a zero in', 'the Z vector.  For each such occurrence the dimension of the', 'secular equation problem is reduced by one.  This stage is', 'performed by the routine SLAED2.', 'The second stage consists of calculating the updated', 'eigenvalues. This is done by finding the roots of the secular', 'equation via the routine SLAED4 (as called by SLAED3).', 'This routine also calculates the eigenvectors of the current', 'problem.', 'The final stage consists of computing the updated eigenvectors', 'directly using the updated eigenvalues.  The eigenvectors for', 'the current problem are multiplied with the eigenvectors from', 'the overall problem.'], &
    &  [('claed7', 'claed7', 'complex'), ('dlaed7', 'dlaed7', 'real'), ('qlaed7', 'qlaed7', None), ('slaed7', 'slaed7', 'real'), ('wlaed7', 'wlaed7', None), ('xlaed7', 'xlaed7', None), ('ylaed7', 'ylaed7', None), ('zlaed7', 'zlaed7', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laed7(n,cutpnt,qsiz,tlvls,curlvl,curpbm,d,q,ldq,rho, &\n               indxq,qstore,qptr,prmptr,perm,givptr,givcol,givnum,work,rwork,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: curlvl,curpbm,cutpnt,ldq,n,qsiz,tlvls\n                    integer(ilp),intent(out) :: info,indxq(*),iwork(*)\n                    real({rk}),intent(inout) :: rho,d(*),givnum(2,*),qstore(*)\n                    integer(ilp),intent(inout) :: givcol(2,*),givptr(*),perm(*),prmptr(*),qptr(*)\n                              \n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: q(ldq,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}laed7', 'real': '               pure subroutine {ri}laed7(icompq,n,qsiz,tlvls,curlvl,curpbm,d,q,ldq,indxq, &\n               rho,cutpnt,qstore,qptr,prmptr,perm,givptr,givcol,givnum,work,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: curlvl,curpbm,cutpnt,icompq,ldq,n,qsiz, &\n                              tlvls\n                    integer(ilp),intent(out) :: info,indxq(*),iwork(*)\n                    {rt},intent(inout) :: rho,d(*),givnum(2,*),q(ldq,*),qstore(*)\n                    integer(ilp),intent(inout) :: givcol(2,*),givptr(*),perm(*),prmptr(*),qptr(*)\n                              \n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}laed7'}), &
    & ('laed8', ['LAED8: merges the two sets of eigenvalues together into a single', 'sorted set.  Then it tries to deflate the size of the problem.', 'There are two ways in which deflation can occur:  when two or more', 'eigenvalues are close together or if there is a tiny element in the', 'Z vector.  For each such occurrence the order of the related secular', 'equation problem is reduced by one.'], &
    &  [('claed8', 'claed8', 'complex'), ('dlaed8', 'dlaed8', 'real'), ('qlaed8', 'qlaed8', None), ('slaed8', 'slaed8', 'real'), ('wlaed8', 'wlaed8', None), ('xlaed8', 'xlaed8', None), ('ylaed8', 'ylaed8', None), ('zlaed8', 'zlaed8', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laed8(k,n,qsiz,q,ldq,d,rho,cutpnt,z,dlamda,q2,ldq2,w, &\n                         indxp,indx,indxq,perm,givptr,givcol,givnum,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: cutpnt,ldq,ldq2,n,qsiz\n                    integer(ilp),intent(out) :: givptr,info,k,givcol(2,*),indx(*),indxp(*),perm( &\n                              *)\n                    real({rk}),intent(inout) :: rho,d(*),z(*)\n                    integer(ilp),intent(inout) :: indxq(*)\n                    real({rk}),intent(out) :: dlamda(*),givnum(2,*),w(*)\n                    {rt},intent(inout) :: q(ldq,*)\n                    {rt},intent(out) :: q2(ldq2,*)\n               end subroutine {ri}laed8', 'real': '               pure subroutine {ri}laed8(icompq,k,n,qsiz,d,q,ldq,indxq,rho,cutpnt,z, &\n                         dlamda,q2,ldq2,w,perm,givptr,givcol,givnum,indxp,indx,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: cutpnt,icompq,ldq,ldq2,n,qsiz\n                    integer(ilp),intent(out) :: givptr,info,k,givcol(2,*),indx(*),indxp(*),perm( &\n                              *)\n                    {rt},intent(inout) :: rho,d(*),q(ldq,*),z(*)\n                    integer(ilp),intent(inout) :: indxq(*)\n                    {rt},intent(out) :: dlamda(*),givnum(2,*),q2(ldq2,*),w(*)\n               end subroutine {ri}laed8'}), &
    & ('laed9', ['LAED9: finds the roots of the secular equation, as defined by the', 'values in D, Z, and RHO, between KSTART and KSTOP.  It makes the', 'appropriate calls to DLAED4 and then stores the new matrix of', 'eigenvectors for use in calculating the next level of Z vectors.'], &
    &  [('dlaed9', 'dlaed9', 'real'), ('qlaed9', 'qlaed9', None), ('slaed9', 'slaed9', 'real'), ('xlaed9', 'xlaed9', None)], &
    &  {'real': '               pure subroutine {ri}laed9(k,kstart,kstop,n,d,q,ldq,rho,dlamda,w,s,lds, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: k,kstart,kstop,ldq,lds,n\n                    {rt},intent(in) :: rho\n                    {rt},intent(out) :: d(*),q(ldq,*),s(lds,*)\n                    {rt},intent(inout) :: dlamda(*),w(*)\n               end subroutine {ri}laed9'}), &
    & ('laeda', ['LAEDA: computes the Z vector corresponding to the merge step in the', 'CURLVLth step of the merge process with TLVLS steps for the CURPBMth', 'problem.'], &
    &  [('dlaeda', 'dlaeda', 'real'), ('qlaeda', 'qlaeda', None), ('slaeda', 'slaeda', 'real'), ('xlaeda', 'xlaeda', None)], &
    &  {'real': '               pure subroutine {ri}laeda(n,tlvls,curlvl,curpbm,prmptr,perm,givptr,givcol, &\n                         givnum,q,qptr,z,ztemp,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: curlvl,curpbm,n,tlvls,givcol(2,*),givptr(*),perm( &\n                              *),prmptr(*),qptr(*)\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(in) :: givnum(2,*),q(*)\n                    {rt},intent(out) :: z(*),ztemp(*)\n               end subroutine {ri}laeda'}), &
    & ('laein', ['LAEIN: uses inverse iteration to find a right or left eigenvector', 'corresponding to the eigenvalue W of a complex upper Hessenberg', 'matrix H.'], &
    &  [('claein', 'claein', 'complex'), ('dlaein', 'dlaein', 'real'), ('qlaein', 'qlaein', None), ('slaein', 'slaein', 'real'), ('wlaein', 'wlaein', None), ('xlaein', 'xlaein', None), ('ylaein', 'ylaein', None), ('zlaein', 'zlaein', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laein(rightv,noinit,n,h,ldh,w,v,b,ldb,rwork,eps3, &\n                         smlnum,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: noinit,rightv\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldh,n\n                    real({rk}),intent(in) :: eps3,smlnum\n                    {rt},intent(in) :: w,h(ldh,*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(out) :: b(ldb,*)\n                    {rt},intent(inout) :: v(*)\n               end subroutine {ri}laein', 'real': '               pure subroutine {ri}laein(rightv,noinit,n,h,ldh,wr,wi,vr,vi,b,ldb,work, &\n                         eps3,smlnum,bignum,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: noinit,rightv\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldh,n\n                    {rt},intent(in) :: bignum,eps3,smlnum,wi,wr,h(ldh,*)\n                    {rt},intent(out) :: b(ldb,*),work(*)\n                    {rt},intent(inout) :: vi(*),vr(*)\n               end subroutine {ri}laein'}), &
    & ('laesy', ['LAESY: computes the eigendecomposition of a 2-by-2 symmetric matrix', '( ( A, B );( B, C ) )', 'provided the norm of the matrix of eigenvectors is larger than', 'some threshold value.', 'RT1 is the eigenvalue of larger absolute value, and RT2 of', 'smaller absolute value.  If the eigenvectors are computed, then', 'on return ( CS1, SN1 ) is the unit eigenvector for RT1, hence', '[  CS1     SN1   ] . [ A  B ] . [ CS1    -SN1   ] = [ RT1  0  ]', '[ -SN1     CS1   ]   [ B  C ]   [ SN1     CS1   ]   [  0  RT2 ]'], &
    &  [('claesy', 'claesy', 'complex'), ('wlaesy', 'wlaesy', None), ('ylaesy', 'ylaesy', None), ('zlaesy', 'zlaesy', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laesy(a,b,c,rt1,rt2,evscal,cs1,sn1)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: a,b,c\n                    {rt},intent(out) :: cs1,evscal,rt1,rt2,sn1\n               end subroutine {ri}laesy'}), &
    & ('laexc', ['LAEXC: swaps adjacent diagonal blocks T11 and T22 of order 1 or 2 in', 'an upper quasi-triangular matrix T by an orthogonal similarity', 'transformation.', 'T must be in Schur canonical form, that is, block upper triangular', 'with 1-by-1 and 2-by-2 diagonal blocks; each 2-by-2 diagonal block', 'has its diagonal elements equal and its off-diagonal elements of', 'opposite sign.'], &
    &  [('dlaexc', 'dlaexc', 'real'), ('qlaexc', 'qlaexc', None), ('slaexc', 'slaexc', 'real'), ('xlaexc', 'xlaexc', None)], &
    &  {'real': '               subroutine {ri}laexc(wantq,n,t,ldt,q,ldq,j1,n1,n2,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantq\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: j1,ldq,ldt,n,n1,n2\n                    {rt},intent(inout) :: q(ldq,*),t(ldt,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}laexc'}), &
    & ('lagtf', ['LAGTF: factorizes the matrix (T - lambda*I), where T is an n by n', 'tridiagonal matrix and lambda is a scalar, as', 'T - lambda*I = PLU,', 'where P is a permutation matrix, L is a unit lower tridiagonal matrix', 'with at most one non-zero sub-diagonal elements per column and U is', 'an upper triangular matrix with at most two non-zero super-diagonal', 'elements per column.', 'The factorization is obtained by Gaussian elimination with partial', 'pivoting and implicit row scaling.', 'The parameter LAMBDA is included in the routine so that LAGTF may', 'be used, in conjunction with DLAGTS, to obtain eigenvectors of T by', 'inverse iteration.'], &
    &  [('dlagtf', 'dlagtf', 'real'), ('qlagtf', 'qlagtf', None), ('slagtf', 'slagtf', 'real'), ('xlagtf', 'xlagtf', None)], &
    &  {'real': '               pure subroutine {ri}lagtf(n,a,lambda,b,c,tol,d,in,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info,in(*)\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(in) :: lambda,tol\n                    {rt},intent(inout) :: a(*),b(*),c(*)\n                    {rt},intent(out) :: d(*)\n               end subroutine {ri}lagtf'}), &
    & ('lagtm', ['LAGTM: performs a matrix-vector product of the form', 'B := alpha * A * X + beta * B', 'where A is a tridiagonal matrix of order N, B and X are N by NRHS', 'matrices, and alpha and beta are real scalars, each of which may be', '0., 1., or -1.'], &
    &  [('clagtm', 'clagtm', 'complex'), ('dlagtm', 'dlagtm', 'real'), ('qlagtm', 'qlagtm', None), ('slagtm', 'slagtm', 'real'), ('wlagtm', 'wlagtm', None), ('xlagtm', 'xlagtm', None), ('ylagtm', 'ylagtm', None), ('zlagtm', 'zlagtm', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lagtm(trans,n,nrhs,alpha,dl,d,du,x,ldx,beta,b,ldb)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: trans\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs\n                    real({rk}),intent(in) :: alpha,beta\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(in) :: d(*),dl(*),du(*),x(ldx,*)\n               end subroutine {ri}lagtm', 'real': '               pure subroutine {ri}lagtm(trans,n,nrhs,alpha,dl,d,du,x,ldx,beta,b,ldb)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: trans\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs\n                    {rt},intent(in) :: alpha,beta,d(*),dl(*),du(*),x(ldx,*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}lagtm'}), &
    & ('lagts', ['LAGTS: may be used to solve one of the systems of equations', '(T - lambda*I)*x = y   or   (T - lambda*I)**T*x = y,', 'where T is an n by n tridiagonal matrix, for x, following the', 'factorization of (T - lambda*I) as', '(T - lambda*I) = P*L*U ,', 'by routine DLAGTF. The choice of equation to be solved is', 'controlled by the argument JOB, and in each case there is an option', 'to perturb zero or very small diagonal elements of U, this option', 'being intended for use in applications such as inverse iteration.'], &
    &  [('dlagts', 'dlagts', 'real'), ('qlagts', 'qlagts', None), ('slagts', 'slagts', 'real'), ('xlagts', 'xlagts', None)], &
    &  {'real': '               pure subroutine {ri}lagts(job,n,a,b,c,d,in,y,tol,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: job,n,in(*)\n                    {rt},intent(inout) :: tol,y(*)\n                    {rt},intent(in) :: a(*),b(*),c(*),d(*)\n               end subroutine {ri}lagts'}), &
    & ('lahef', ['LAHEF: computes a partial factorization of a complex Hermitian', 'matrix A using the Bunch-Kaufman diagonal pivoting method. The', 'partial factorization has the form:', "A  =  ( I  U12 ) ( A11  0  ) (  I      0     )  if UPLO = 'U', or:", '( 0  U22 ) (  0   D  ) ( U12**H U22**H )', "A  =  ( L11  0 ) (  D   0  ) ( L11**H L21**H )  if UPLO = 'L'", '( L21  I ) (  0  A22 ) (  0      I     )', 'where the order of D is at most NB. The actual order is returned in', 'the argument KB, and is either NB or NB-1, or N if N <= NB.', 'Note that U**H denotes the conjugate transpose of U.', 'LAHEF is an auxiliary routine called by CHETRF. It uses blocked code', "(calling Level 3 BLAS) to update the submatrix A11 (if UPLO = 'U') or", "A22 (if UPLO = 'L')."], &
    &  [('clahef', 'clahef', 'complex'), ('wlahef', 'wlahef', None), ('ylahef', 'ylahef', None), ('zlahef', 'zlahef', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lahef(uplo,n,nb,kb,a,lda,ipiv,w,ldw,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,kb,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldw,n,nb\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: w(ldw,*)\n               end subroutine {ri}lahef'}), &
    & ('lahef_aa', ['LAHEF_AA: factorizes a panel of a complex hermitian matrix A using', "the Aasen's algorithm. The panel consists of a set of NB rows of A", 'when UPLO is U, or a set of NB columns when UPLO is L.', "In order to factorize the panel, the Aasen's algorithm requires the", 'last row, or column, of the previous panel. The first row, or column,', 'of A is set to be the first row, or column, of an identity matrix,', 'which is used to factorize the first panel.', 'The resulting J-th row of U, or J-th column of L, is stored in the', '(J-1)-th row, or column, of A (without the unit diagonals), while', 'the diagonal and subdiagonal of A are overwritten by those of T.'], &
    &  [('clahef_aa', 'clahef_aa', 'complex'), ('wlahef_aa', 'wlahef_aa', None), ('ylahef_aa', 'ylahef_aa', None), ('zlahef_aa', 'zlahef_aa', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lahef_aa(uplo,j1,m,nb,a,lda,ipiv,h,ldh,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: m,nb,j1,lda,ldh\n                    integer(ilp),intent(out) :: ipiv(*)\n                    {rt},intent(inout) :: a(lda,*),h(ldh,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}lahef_aa'}), &
    & ('lahef_rk', ['LAHEF_RK: computes a partial factorization of a complex Hermitian', 'matrix A using the bounded Bunch-Kaufman (rook) diagonal', 'pivoting method. The partial factorization has the form:', "A  =  ( I  U12 ) ( A11  0  ) (  I       0    )  if UPLO = 'U', or:", '( 0  U22 ) (  0   D  ) ( U12**H U22**H )', "A  =  ( L11  0 ) (  D   0  ) ( L11**H L21**H )  if UPLO = 'L',", '( L21  I ) (  0  A22 ) (  0       I    )', 'where the order of D is at most NB. The actual order is returned in', 'the argument KB, and is either NB or NB-1, or N if N <= NB.', 'LAHEF_RK is an auxiliary routine called by CHETRF_RK. It uses', 'blocked code (calling Level 3 BLAS) to update the submatrix', "A11 (if UPLO = 'U') or A22 (if UPLO = 'L')."], &
    &  [('clahef_rk', 'clahef_rk', 'complex'), ('wlahef_rk', 'wlahef_rk', None), ('ylahef_rk', 'ylahef_rk', None), ('zlahef_rk', 'zlahef_rk', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lahef_rk(uplo,n,nb,kb,a,lda,e,ipiv,w,ldw,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,kb,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldw,n,nb\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: w(ldw,*),e(*)\n               end subroutine {ri}lahef_rk'}), &
    & ('lahef_rook', ['LAHEF_ROOK: computes a partial factorization of a complex Hermitian', 'matrix A using the bounded Bunch-Kaufman ("rook") diagonal pivoting', 'method. The partial factorization has the form:', "A  =  ( I  U12 ) ( A11  0  ) (  I      0     )  if UPLO = 'U', or:", '( 0  U22 ) (  0   D  ) ( U12**H U22**H )', "A  =  ( L11  0 ) (  D   0  ) ( L11**H L21**H )  if UPLO = 'L'", '( L21  I ) (  0  A22 ) (  0      I     )', 'where the order of D is at most NB. The actual order is returned in', 'the argument KB, and is either NB or NB-1, or N if N <= NB.', 'Note that U**H denotes the conjugate transpose of U.', 'LAHEF_ROOK is an auxiliary routine called by CHETRF_ROOK. It uses', 'blocked code (calling Level 3 BLAS) to update the submatrix', "A11 (if UPLO = 'U') or A22 (if UPLO = 'L')."], &
    &  [('clahef_rook', 'clahef_rook', 'complex'), ('wlahef_rook', 'wlahef_rook', None), ('ylahef_rook', 'ylahef_rook', None), ('zlahef_rook', 'zlahef_rook', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lahef_rook(uplo,n,nb,kb,a,lda,ipiv,w,ldw,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,kb,ipiv(*)\n                    integer(ilp),intent(in) :: lda,ldw,n,nb\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: w(ldw,*)\n               end subroutine {ri}lahef_rook'}), &
    & ('lahqr', ['LAHQR: is an auxiliary routine called by CHSEQR to update the', 'eigenvalues and Schur decomposition already computed by CHSEQR, by', 'dealing with the Hessenberg submatrix in rows and columns ILO to', 'IHI.'], &
    &  [('clahqr', 'clahqr', 'complex'), ('dlahqr', 'dlahqr', 'real'), ('qlahqr', 'qlahqr', None), ('slahqr', 'slahqr', 'real'), ('wlahqr', 'wlahqr', None), ('xlahqr', 'xlahqr', None), ('ylahqr', 'ylahqr', None), ('zlahqr', 'zlahqr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lahqr(wantt,wantz,n,ilo,ihi,h,ldh,w,iloz,ihiz,z,ldz, &\n                         info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: ihi,ihiz,ilo,iloz,ldh,ldz,n\n                    integer(ilp),intent(out) :: info\n                    logical(lk),intent(in) :: wantt,wantz\n                    {rt},intent(inout) :: h(ldh,*),z(ldz,*)\n                    {rt},intent(out) :: w(*)\n               end subroutine {ri}lahqr', 'real': '               pure subroutine {ri}lahqr(wantt,wantz,n,ilo,ihi,h,ldh,wr,wi,iloz,ihiz,z, &\n                         ldz,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: ihi,ihiz,ilo,iloz,ldh,ldz,n\n                    integer(ilp),intent(out) :: info\n                    logical(lk),intent(in) :: wantt,wantz\n                    {rt},intent(inout) :: h(ldh,*),z(ldz,*)\n                    {rt},intent(out) :: wi(*),wr(*)\n               end subroutine {ri}lahqr'}), &
    & ('laic1', ['LAIC1: applies one step of incremental condition estimation in', 'its simplest version:', 'Let x, twonorm(x) = 1, be an approximate singular vector of an j-by-j', 'lower triangular matrix L, such that', 'twonorm(L*x) = sest', 'Then LAIC1 computes sestpr, s, c such that', 'the vector', '[ s*x ]', 'xhat = [  c  ]', 'is an approximate singular vector of', '[ L      0  ]', 'Lhat = [ w**H gamma ]', 'in the sense that', 'twonorm(Lhat*xhat) = sestpr.', 'Depending on JOB, an estimate for the largest or smallest singular', 'value is computed.', 'Note that [s c]**H and sestpr**2 is an eigenpair of the system', 'diag(sest*sest, 0) + [alpha  gamma] * [ conjg(alpha) ]', '[ conjg(gamma) ]', 'where  alpha =  x**H*w.'], &
    &  [('claic1', 'claic1', 'complex'), ('dlaic1', 'dlaic1', 'real'), ('qlaic1', 'qlaic1', None), ('slaic1', 'slaic1', 'real'), ('wlaic1', 'wlaic1', None), ('xlaic1', 'xlaic1', None), ('ylaic1', 'ylaic1', None), ('zlaic1', 'zlaic1', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laic1(job,j,x,sest,w,gamma,sestpr,s,c)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: j,job\n                    real({rk}),intent(in) :: sest\n                    real({rk}),intent(out) :: sestpr\n                    {rt},intent(out) :: c,s\n                    {rt},intent(in) :: gamma,w(j),x(j)\n               end subroutine {ri}laic1', 'real': '               pure subroutine {ri}laic1(job,j,x,sest,w,gamma,sestpr,s,c)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: j,job\n                    {rt},intent(out) :: c,s,sestpr\n                    {rt},intent(in) :: gamma,sest,w(j),x(j)\n               end subroutine {ri}laic1'}), &
    & ('laisnan', ['This routine is not for general use.  It exists solely to avoid', 'over-optimization in DISNAN.', 'LAISNAN: checks for NaNs by comparing its two arguments for', 'inequality.  NaN is the only floating-point value where NaN != NaN', 'returns .TRUE.  To check for NaNs, pass the same variable as both', 'arguments.', 'A compiler must assume that the two arguments are', 'not the same variable, and the test will not be optimized away.', 'Interprocedural or whole-program optimization may delete this', 'test.  The ISNAN functions will be replaced by the correct', 'Fortran 03 intrinsic once the intrinsic is widely available.'], &
    &  [('dlaisnan', 'dlaisnan', 'real'), ('qlaisnan', 'qlaisnan', None), ('slaisnan', 'slaisnan', 'real'), ('xlaisnan', 'xlaisnan', None)], &
    &  {'real': '               pure logical(lk) function {ri}laisnan({ri}in1,{ri}in2)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: {ri}in1,{ri}in2\n               end function {ri}laisnan'}), &
    & ('lals0', ['LALS0: applies back the multiplying factors of either the left or the', 'right singular vector matrix of a diagonal matrix appended by a row', 'to the right hand side matrix B in solving the least squares problem', 'using the divide-and-conquer SVD approach.', 'For the left singular vector matrix, three types of orthogonal', 'matrices are involved:', '(1L) Givens rotations: the number of such rotations is GIVPTR; the', 'pairs of columns/rows they were applied to are stored in GIVCOL;', 'and the C- and S-values of these rotations are stored in GIVNUM.', '(2L) Permutation. The (NL+1)-st row of B is to be moved to the first', 'row, and for J=2:N, PERM(J)-th row of B is to be moved to the', 'J-th row.', '(3L) The left singular vector matrix of the remaining matrix.', 'For the right singular vector matrix, four types of orthogonal', 'matrices are involved:', '(1R) The right singular vector matrix of the remaining matrix.', '(2R) If SQRE = 1, one extra Givens rotation to generate the right', 'null space.', '(3R) The inverse transformation of (2L).', '(4R) The inverse transformation of (1L).'], &
    &  [('clals0', 'clals0', 'complex'), ('dlals0', 'dlals0', 'real'), ('qlals0', 'qlals0', None), ('slals0', 'slals0', 'real'), ('wlals0', 'wlals0', None), ('xlals0', 'xlals0', None), ('ylals0', 'ylals0', None), ('zlals0', 'zlals0', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lals0(icompq,nl,nr,sqre,nrhs,b,ldb,bx,ldbx,perm,givptr, &\n                         givcol,ldgcol,givnum,ldgnum,poles,difl,difr,z,k,c,s,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: givptr,icompq,k,ldb,ldbx,ldgcol,ldgnum,nl,nr,nrhs, &\n                              sqre,givcol(ldgcol,*),perm(*)\n                    integer(ilp),intent(out) :: info\n                    real({rk}),intent(in) :: c,s,difl(*),difr(ldgnum,*),givnum(ldgnum,*),poles( &\n                              ldgnum,*),z(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: bx(ldbx,*)\n               end subroutine {ri}lals0', 'real': '               pure subroutine {ri}lals0(icompq,nl,nr,sqre,nrhs,b,ldb,bx,ldbx,perm,givptr, &\n                         givcol,ldgcol,givnum,ldgnum,poles,difl,difr,z,k,c,s,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: givptr,icompq,k,ldb,ldbx,ldgcol,ldgnum,nl,nr,nrhs, &\n                              sqre,givcol(ldgcol,*),perm(*)\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(in) :: c,s,difl(*),difr(ldgnum,*),givnum(ldgnum,*),poles( &\n                              ldgnum,*),z(*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: bx(ldbx,*),work(*)\n               end subroutine {ri}lals0'}), &
    & ('lalsa', ['LALSA: is an itermediate step in solving the least squares problem', 'by computing the SVD of the coefficient matrix in compact form (The', 'singular vectors are computed as products of simple orthorgonal', 'matrices.).', 'If ICOMPQ = 0, LALSA applies the inverse of the left singular vector', 'matrix of an upper bidiagonal matrix to the right hand side; and if', 'ICOMPQ = 1, LALSA applies the right singular vector matrix to the', 'right hand side. The singular vector matrices were generated in', 'compact form by LALSA.'], &
    &  [('clalsa', 'clalsa', 'complex'), ('dlalsa', 'dlalsa', 'real'), ('qlalsa', 'qlalsa', None), ('slalsa', 'slalsa', 'real'), ('wlalsa', 'wlalsa', None), ('xlalsa', 'xlalsa', None), ('ylalsa', 'ylalsa', None), ('zlalsa', 'zlalsa', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lalsa(icompq,smlsiz,n,nrhs,b,ldb,bx,ldbx,u,ldu,vt,k, &\n               difl,difr,z,poles,givptr,givcol,ldgcol,perm,givnum,c,s,rwork,iwork,info &\n                         )\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: icompq,ldb,ldbx,ldgcol,ldu,n,nrhs,smlsiz,givcol( &\n                              ldgcol,*),givptr(*),k(*),perm(ldgcol,*)\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    real({rk}),intent(in) :: c(*),difl(ldu,*),difr(ldu,*),givnum(ldu,*),poles(ldu, &\n                              *),s(*),u(ldu,*),vt(ldu,*),z(ldu,*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: bx(ldbx,*)\n               end subroutine {ri}lalsa', 'real': '               pure subroutine {ri}lalsa(icompq,smlsiz,n,nrhs,b,ldb,bx,ldbx,u,ldu,vt,k, &\n               difl,difr,z,poles,givptr,givcol,ldgcol,perm,givnum,c,s,work,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: icompq,ldb,ldbx,ldgcol,ldu,n,nrhs,smlsiz,givcol( &\n                              ldgcol,*),givptr(*),k(*),perm(ldgcol,*)\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: bx(ldbx,*),work(*)\n                    {rt},intent(in) :: c(*),difl(ldu,*),difr(ldu,*),givnum(ldu,*),poles(ldu, &\n                              *),s(*),u(ldu,*),vt(ldu,*),z(ldu,*)\n               end subroutine {ri}lalsa'}), &
    & ('lalsd', ['LALSD: uses the singular value decomposition of A to solve the least', 'squares problem of finding X to minimize the Euclidean norm of each', 'column of A*X-B, where A is N-by-N upper bidiagonal, and X and B', 'are N-by-NRHS. The solution X overwrites B.', 'The singular values of A smaller than RCOND times the largest', 'singular value are treated as zero in solving the least squares', 'problem; in this case a minimum norm solution is returned.', 'The actual singular values are returned in D in ascending order.', 'This code makes very mild assumptions about floating point', 'arithmetic. It will work on machines with a guard digit in', 'add/subtract, or on those binary machines without guard digits', 'which subtract like the Cray XMP, Cray YMP, Cray C 90, or Cray 2.', 'It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('clalsd', 'clalsd', 'complex'), ('dlalsd', 'dlalsd', 'real'), ('qlalsd', 'qlalsd', None), ('slalsd', 'slalsd', 'real'), ('wlalsd', 'wlalsd', None), ('xlalsd', 'xlalsd', None), ('ylalsd', 'ylalsd', None), ('zlalsd', 'zlalsd', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lalsd(uplo,smlsiz,n,nrhs,d,e,b,ldb,rcond,rank,work, &\n                         rwork,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,rank,iwork(*)\n                    integer(ilp),intent(in) :: ldb,n,nrhs,smlsiz\n                    real({rk}),intent(in) :: rcond\n                    real({rk}),intent(inout) :: d(*),e(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}lalsd', 'real': '               pure subroutine {ri}lalsd(uplo,smlsiz,n,nrhs,d,e,b,ldb,rcond,rank,work, &\n                         iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info,rank,iwork(*)\n                    integer(ilp),intent(in) :: ldb,n,nrhs,smlsiz\n                    {rt},intent(in) :: rcond\n                    {rt},intent(inout) :: b(ldb,*),d(*),e(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}lalsd'}), &
    & ('lamrg', ['LAMRG: will create a permutation list which will merge the elements', 'of A (which is composed of two independently sorted sets) into a', 'single set which is sorted in ascending order.'], &
    &  [('dlamrg', 'dlamrg', 'real'), ('qlamrg', 'qlamrg', None), ('slamrg', 'slamrg', 's'), ('xlamrg', 'xlamrg', None)], &
