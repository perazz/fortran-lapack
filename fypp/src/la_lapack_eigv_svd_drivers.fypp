#:include "common.fypp"
!> SVD drivers: QR iteration and the rank-revealing preconditioned variant
module la_lapack_eigv_svd_drivers
     use la_constants
     use la_blas_aux
     use la_blas_level1
     use la_blas_level3_gen
     use la_lapack_aux
     use la_lapack_auxiliary
     use la_lapack_blas_like_base
     use la_lapack_blas_like_l2
     use la_lapack_blas_like_mnorm
     use la_lapack_cosine_sine
     use la_lapack_orthogonal_factors_ql
     use la_lapack_orthogonal_factors_qr
     use la_lapack_solve_chol_comp
     use la_lapack_solve_lu_comp
     use la_lapack_svd_bidiag_qr
     use la_lapack_svd_comp
     implicit none(type,external)
     private

     public :: sp,dp,qp,lk,ilp
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     public :: la_${ri}$gesvd
     public :: la_${ri}$gesvdq
#:endfor
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     public :: la_${ri}$gesvd
     public :: la_${ri}$gesvdq
#:endfor

     contains

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GESVD: computes the singular value decomposition (SVD) of a real
     !> M-by-N matrix A, optionally computing the left and/or right singular
     !> vectors. The SVD is written
     !> A = U * SIGMA * transpose(V)
     !> where SIGMA is an M-by-N matrix which is zero except for its
     !> min(m,n) diagonal elements, U is an M-by-M orthogonal matrix, and
     !> V is an N-by-N orthogonal matrix.  The diagonal elements of SIGMA
     !> are the singular values of A; they are real and non-negative, and
     !> are returned in descending order.  The first min(m,n) columns of
     !> U and V are the left and right singular vectors of A.
     !> Note that the routine returns V**T, not V.

     subroutine la_${ri}$gesvd(jobu,jobvt,m,n,a,lda,s,u,ldu,vt,ldvt,work,lwork,info)
        use la_constants_${rk}$,only:zero,one

        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu,jobvt
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldu,ldvt,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: s(*),u(ldu,*),vt(ldvt,*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,wntua,wntuas,wntun,wntuo,wntus,wntva,wntvas,wntvn,wntvo, &
                      wntvs
           integer(ilp) :: bdspac,blk,chunk,i,ie,ierr,ir,iscl,itau,itaup,itauq,iu, &
           iwork,ldwrkr,ldwrku,maxwrk,minmn,minwrk,mnthr,ncu,ncvt,nru,nrvt, &
                     wrkbl
           integer(ilp) :: lwork_${ri}$geqrf,lwork_${ri}$orgqr_n,lwork_${ri}$orgqr_m,lwork_${ri}$gebrd, &
                     lwork_${ri}$orgbr_p,lwork_${ri}$orgbr_q,lwork_${ri}$gelqf,lwork_${ri}$orglq_n,lwork_${ri}$orglq_m
           real(${rk}$) :: anrm,bignum,eps,smlnum
           ! Local Arrays
           real(${rk}$) :: dum(1)
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input arguments
           info = 0
           minmn = min(m,n)
           wntua = la_lsame(jobu,'A')
           wntus = la_lsame(jobu,'S')
           wntuas = wntua .or. wntus
           wntuo = la_lsame(jobu,'O')
           wntun = la_lsame(jobu,'N')
           wntva = la_lsame(jobvt,'A')
           wntvs = la_lsame(jobvt,'S')
           wntvas = wntva .or. wntvs
           wntvo = la_lsame(jobvt,'O')
           wntvn = la_lsame(jobvt,'N')
           lquery = (lwork == -1)
           if (.not. (wntua .or. wntus .or. wntuo .or. wntun)) then
              info = -1
           else if (.not. (wntva .or. wntvs .or. wntvo .or. wntvn) .or. (wntvo .and. wntuo)) &
                     then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,m)) then
              info = -6
           else if (ldu < 1 .or. (wntuas .and. ldu < m)) then
              info = -9
           else if (ldvt < 1 .or. (wntva .and. ldvt < n) .or. (wntvs .and. ldvt < minmn)) &
                     then
              info = -11
           end if
           ! compute workspace
            ! (note: comments in the code beginning "workspace:" describe the
             ! minimal amount of workspace needed at that point in the code,
             ! as well as the preferred amount for good performance.
             ! nb refers to the optimal block size for the immediately
             ! following subroutine, as returned by la_ilaenv.)
           if (info == 0) then
              minwrk = 1
              maxwrk = 1
              if (m >= n .and. minmn > 0) then
                 ! compute space needed for la_${ri}$bdsqr
                 mnthr = la_ilaenv(6,'${ri.upper()}$GESVD',jobu//jobvt,m,n,0,0)
                 bdspac = 5*n
                 ! compute space needed for la_${ri}$geqrf
                 call la_${ri}$geqrf(m,n,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$geqrf = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$orgqr
                 call la_${ri}$orgqr(m,n,n,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgqr_n = int(dum(1),KIND=ilp)
                 call la_${ri}$orgqr(m,m,n,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgqr_m = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$gebrd
                 call la_${ri}$gebrd(n,n,a,lda,s,dum(1),dum(1),dum(1),dum(1),-1,ierr)

                 lwork_${ri}$gebrd = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$orgbr p
                 call la_${ri}$orgbr('P',n,n,n,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgbr_p = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$orgbr q
                 call la_${ri}$orgbr('Q',n,n,n,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgbr_q = int(dum(1),KIND=ilp)
                 if (m >= mnthr) then
                    if (wntun) then
                       ! path 1 (m much larger than n, jobu='n')
                       maxwrk = n + lwork_${ri}$geqrf
                       maxwrk = max(maxwrk,3*n + lwork_${ri}$gebrd)
                       if (wntvo .or. wntvas) maxwrk = max(maxwrk,3*n + lwork_${ri}$orgbr_p)
                       maxwrk = max(maxwrk,bdspac)
                       minwrk = max(4*n,bdspac)
                    else if (wntuo .and. wntvn) then
                       ! path 2 (m much larger than n, jobu='o', jobvt='n')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_n)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = max(n*n + wrkbl,n*n + m*n + n)
                       minwrk = max(3*n + m,bdspac)
                    else if (wntuo .and. wntvas) then
                       ! path 3 (m much larger than n, jobu='o', jobvt='s' or
                       ! 'a')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_n)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = max(n*n + wrkbl,n*n + m*n + n)
                       minwrk = max(3*n + m,bdspac)
                    else if (wntus .and. wntvn) then
                       ! path 4 (m much larger than n, jobu='s', jobvt='n')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_n)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = n*n + wrkbl
                       minwrk = max(3*n + m,bdspac)
                    else if (wntus .and. wntvo) then
                       ! path 5 (m much larger than n, jobu='s', jobvt='o')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_n)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = 2*n*n + wrkbl
                       minwrk = max(3*n + m,bdspac)
                    else if (wntus .and. wntvas) then
                       ! path 6 (m much larger than n, jobu='s', jobvt='s' or
                       ! 'a')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_n)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = n*n + wrkbl
                       minwrk = max(3*n + m,bdspac)
                    else if (wntua .and. wntvn) then
                       ! path 7 (m much larger than n, jobu='a', jobvt='n')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_m)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = n*n + wrkbl
                       minwrk = max(3*n + m,bdspac)
                    else if (wntua .and. wntvo) then
                       ! path 8 (m much larger than n, jobu='a', jobvt='o')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_m)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = 2*n*n + wrkbl
                       minwrk = max(3*n + m,bdspac)
                    else if (wntua .and. wntvas) then
                       ! path 9 (m much larger than n, jobu='a', jobvt='s' or
                       ! 'a')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_m)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = n*n + wrkbl
                       minwrk = max(3*n + m,bdspac)
                    end if
                 else
                    ! path 10 (m at least n, but not much larger)
                    call la_${ri}$gebrd(m,n,a,lda,s,dum(1),dum(1),dum(1),dum(1),-1,ierr)

                    lwork_${ri}$gebrd = int(dum(1),KIND=ilp)
                    maxwrk = 3*n + lwork_${ri}$gebrd
                    if (wntus .or. wntuo) then
                       call la_${ri}$orgbr('Q',m,n,n,a,lda,dum(1),dum(1),-1,ierr)
                       lwork_${ri}$orgbr_q = int(dum(1),KIND=ilp)
                       maxwrk = max(maxwrk,3*n + lwork_${ri}$orgbr_q)
                    end if
                    if (wntua) then
                       call la_${ri}$orgbr('Q',m,m,n,a,lda,dum(1),dum(1),-1,ierr)
                       lwork_${ri}$orgbr_q = int(dum(1),KIND=ilp)
                       maxwrk = max(maxwrk,3*n + lwork_${ri}$orgbr_q)
                    end if
                    if (.not. wntvn) then
                      maxwrk = max(maxwrk,3*n + lwork_${ri}$orgbr_p)
                    end if
                    maxwrk = max(maxwrk,bdspac)
                    minwrk = max(3*n + m,bdspac)
                 end if
              else if (minmn > 0) then
                 ! compute space needed for la_${ri}$bdsqr
                 mnthr = la_ilaenv(6,'${ri.upper()}$GESVD',jobu//jobvt,m,n,0,0)
                 bdspac = 5*m
                 ! compute space needed for la_${ri}$gelqf
                 call la_${ri}$gelqf(m,n,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$gelqf = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$orglq
                 call la_${ri}$orglq(n,n,m,dum(1),n,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orglq_n = int(dum(1),KIND=ilp)
                 call la_${ri}$orglq(m,n,m,a,lda,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orglq_m = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$gebrd
                 call la_${ri}$gebrd(m,m,a,lda,s,dum(1),dum(1),dum(1),dum(1),-1,ierr)

                 lwork_${ri}$gebrd = int(dum(1),KIND=ilp)
                  ! compute space needed for la_${ri}$orgbr p
                 call la_${ri}$orgbr('P',m,m,m,a,n,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgbr_p = int(dum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$orgbr q
                 call la_${ri}$orgbr('Q',m,m,m,a,n,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgbr_q = int(dum(1),KIND=ilp)
                 if (n >= mnthr) then
                    if (wntvn) then
                       ! path 1t(n much larger than m, jobvt='n')
                       maxwrk = m + lwork_${ri}$gelqf
                       maxwrk = max(maxwrk,3*m + lwork_${ri}$gebrd)
                       if (wntuo .or. wntuas) maxwrk = max(maxwrk,3*m + lwork_${ri}$orgbr_q)
                       maxwrk = max(maxwrk,bdspac)
                       minwrk = max(4*m,bdspac)
                    else if (wntvo .and. wntun) then
                       ! path 2t(n much larger than m, jobu='n', jobvt='o')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_m)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = max(m*m + wrkbl,m*m + m*n + m)
                       minwrk = max(3*m + n,bdspac)
                    else if (wntvo .and. wntuas) then
                       ! path 3t(n much larger than m, jobu='s' or 'a',
                       ! jobvt='o')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_m)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = max(m*m + wrkbl,m*m + m*n + m)
                       minwrk = max(3*m + n,bdspac)
                    else if (wntvs .and. wntun) then
                       ! path 4t(n much larger than m, jobu='n', jobvt='s')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_m)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = m*m + wrkbl
                       minwrk = max(3*m + n,bdspac)
                    else if (wntvs .and. wntuo) then
                       ! path 5t(n much larger than m, jobu='o', jobvt='s')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_m)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = 2*m*m + wrkbl
                       minwrk = max(3*m + n,bdspac)
#:if rk == "sp"
                       maxwrk = max(maxwrk,minwrk)
#:endif
                    else if (wntvs .and. wntuas) then
                       ! path 6t(n much larger than m, jobu='s' or 'a',
                       ! jobvt='s')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_m)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = m*m + wrkbl
                       minwrk = max(3*m + n,bdspac)
                    else if (wntva .and. wntun) then
                       ! path 7t(n much larger than m, jobu='n', jobvt='a')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_n)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = m*m + wrkbl
                       minwrk = max(3*m + n,bdspac)
                    else if (wntva .and. wntuo) then
                       ! path 8t(n much larger than m, jobu='o', jobvt='a')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_n)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = 2*m*m + wrkbl
                       minwrk = max(3*m + n,bdspac)
                    else if (wntva .and. wntuas) then
                       ! path 9t(n much larger than m, jobu='s' or 'a',
                       ! jobvt='a')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_n)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_p)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$orgbr_q)
                       wrkbl = max(wrkbl,bdspac)
                       maxwrk = m*m + wrkbl
                       minwrk = max(3*m + n,bdspac)
                    end if
                 else
                    ! path 10t(n greater than m, but not much larger)
                    call la_${ri}$gebrd(m,n,a,lda,s,dum(1),dum(1),dum(1),dum(1),-1,ierr)

                    lwork_${ri}$gebrd = int(dum(1),KIND=ilp)
                    maxwrk = 3*m + lwork_${ri}$gebrd
                    if (wntvs .or. wntvo) then
                      ! compute space needed for la_${ri}$orgbr p
                      call la_${ri}$orgbr('P',m,n,m,a,n,dum(1),dum(1),-1,ierr)
                      lwork_${ri}$orgbr_p = int(dum(1),KIND=ilp)
                      maxwrk = max(maxwrk,3*m + lwork_${ri}$orgbr_p)
                    end if
                    if (wntva) then
                      call la_${ri}$orgbr('P',n,n,m,a,n,dum(1),dum(1),-1,ierr)
                      lwork_${ri}$orgbr_p = int(dum(1),KIND=ilp)
                      maxwrk = max(maxwrk,3*m + lwork_${ri}$orgbr_p)
                    end if
                    if (.not. wntun) then
                       maxwrk = max(maxwrk,3*m + lwork_${ri}$orgbr_q)
                    end if
                    maxwrk = max(maxwrk,bdspac)
                    minwrk = max(3*m + n,bdspac)
                 end if
              end if
              maxwrk = max(maxwrk,minwrk)
              work(1) = maxwrk
              if (lwork < minwrk .and. .not. lquery) then
                 info = -13
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) then
              return
           end if
           ! get machine constants
           eps = la_${ri}$lamch('P')
           smlnum = sqrt(la_${ri}$lamch('S'))/eps
           bignum = one/smlnum
           ! scale a if max element outside range [smlnum,bignum]
           anrm = la_${ri}$lange('M',m,n,a,lda,dum)
           iscl = 0
           if (anrm > zero .and. anrm < smlnum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,smlnum,m,n,a,lda,ierr)
           else if (anrm > bignum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,bignum,m,n,a,lda,ierr)
           end if
           if (m >= n) then
              ! a has at least as many rows as columns. if a has sufficiently
              ! more rows than columns, first reduce using the qr
              ! decomposition (if sufficient workspace available)
              if (m >= mnthr) then
                 if (wntun) then
                    ! path 1 (m much larger than n, jobu='n')
                    ! no left singular vectors to be computed
                    itau = 1
                    iwork = itau + n
                    ! compute a=q*r
#:if rk == "sp"
                    ! (workspace: need 2*n, prefer n+n*nb)
#:else
                    ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + 1, &
                              ierr)
                    ! zero out below r
                    if (n > 1) then
                       call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)
                    end if
                    ie = 1
                    itauq = ie + n
                    itaup = itauq + n
                    iwork = itaup + n
                    ! bidiagonalize r in a
#:if rk == "sp"
                    ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                    ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                    call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                              work(iwork),lwork - iwork + 1,ierr)
                    ncvt = 0
                    if (wntvo .or. wntvas) then
                       ! if right singular vectors desired, generate p'.
#:if rk == "sp"
                       ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                       ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                       call la_${ri}$orgbr('P',n,n,n,a,lda,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       ncvt = n
                    end if
                    iwork = ie + n
                    ! perform bidiagonal qr iteration, computing right
                    ! singular vectors of a in a if desired
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,0,0,s,work(ie),a,lda,dum,1,dum,1, &
                              work(iwork),info)
                    ! if right singular vectors desired in vt, copy them there
                    if (wntvas) call la_${ri}$lacpy('F',n,n,a,lda,vt,ldvt)
                 else if (wntuo .and. wntvn) then
                    ! path 2 (m much larger than n, jobu='o', jobvt='n')
                    ! n left singular vectors to be overwritten on a and
                    ! no right singular vectors to be computed
                    if (lwork >= n*n + max(4*n,bdspac)) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n + n) + lda*n) then
                          ! work(iu) is lda by n, work(ir) is lda by n
                          ldwrku = lda
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n + n) + n*n) then
                          ! work(iu) is lda by n, work(ir) is n by n
                          ldwrku = lda
                          ldwrkr = n
                       else
                          ! work(iu) is ldwrku by n, work(ir) is n by n
                          ldwrku = (lwork - n*n - n)/n
                          ldwrkr = n
                       end if
                       itau = ir + ldwrkr*n
                       iwork = itau + n
                       ! compute a=q*r
#:if rk == "sp"
                       ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                       ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                       call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy r to work(ir) and zero out below it
                       call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                       call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(ir + 1),ldwrkr)

                       ! generate q in a
#:if rk == "sp"
                       ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                       ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                       call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = itau
                       itauq = ie + n
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize r in work(ir)
#:if rk == "sp"
                       ! (workspace: need n*n+4*n, prefer n*n+3*n+2*n*nb)
#:else
                       ! (workspace: need n*n + 4*n, prefer n*n + 3*n + 2*n*nb)
#:endif
                       call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,work(ie),work(itauq), &
                                 work(itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing r
#:if rk == "sp"
                       ! (workspace: need n*n+4*n, prefer n*n+3*n+n*nb)
#:else
                       ! (workspace: need n*n + 4*n, prefer n*n + 3*n + n*nb)
#:endif
                       call la_${ri}$orgbr('Q',n,n,n,work(ir),ldwrkr,work(itauq),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       iwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of r in work(ir)
#:if rk == "sp"
                       ! (workspace: need n*n+bdspac)
#:else
                       ! (workspace: need n*n + bdspac)
#:endif
                       call la_${ri}$bdsqr('U',n,0,n,0,s,work(ie),dum,1,work(ir), &
                                 ldwrkr,dum,1,work(iwork),info)
                       iu = ie + n
                       ! multiply q in a by left singular vectors of r in
                       ! work(ir), storing result in work(iu) and copying to a
#:if rk == "sp"
                       ! (workspace: need n*n+2*n, prefer n*n+m*n+n)
#:else
                       ! (workspace: need n*n + 2*n, prefer n*n + m*n + n)
#:endif
                       do i = 1,m,ldwrku
                          chunk = min(m - i + 1,ldwrku)
                          call la_${ri}$gemm('N','N',chunk,n,n,one,a(i,1),lda,work(ir) &
                                    ,ldwrkr,zero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',chunk,n,work(iu),ldwrku,a(i,1),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       ie = 1
                       itauq = ie + n
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize a
#:if rk == "sp"
                       ! (workspace: need 3*n+m, prefer 3*n+(m+n)*nb)
#:else
                       ! (workspace: need 3*n + m, prefer 3*n + (m + n)*nb)
#:endif
                       call la_${ri}$gebrd(m,n,a,lda,s,work(ie),work(itauq),work(itaup &
                                 ),work(iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing a
#:if rk == "sp"
                       ! (workspace: need 4*n, prefer 3*n+n*nb)
#:else
                       ! (workspace: need 4*n, prefer 3*n + n*nb)
#:endif
                       call la_${ri}$orgbr('Q',m,n,n,a,lda,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       iwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of a in a
                       ! (workspace: need bdspac)
                       call la_${ri}$bdsqr('U',n,0,m,0,s,work(ie),dum,1,a,lda,dum,1, &
                                 work(iwork),info)
                    end if
                 else if (wntuo .and. wntvas) then
                    ! path 3 (m much larger than n, jobu='o', jobvt='s' or 'a')
                    ! n left singular vectors to be overwritten on a and
                    ! n right singular vectors to be computed in vt
                    if (lwork >= n*n + max(4*n,bdspac)) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n + n) + lda*n) then
                          ! work(iu) is lda by n and work(ir) is lda by n
                          ldwrku = lda
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n + n) + n*n) then
                          ! work(iu) is lda by n and work(ir) is n by n
                          ldwrku = lda
                          ldwrkr = n
                       else
                          ! work(iu) is ldwrku by n and work(ir) is n by n
                          ldwrku = (lwork - n*n - n)/n
                          ldwrkr = n
                       end if
                       itau = ir + ldwrkr*n
                       iwork = itau + n
                       ! compute a=q*r
#:if rk == "sp"
                       ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                       ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                       call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy r to vt, zeroing out below it
                       call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                       if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,zero,zero,vt(2,1),ldvt)

                       ! generate q in a
#:if rk == "sp"
                       ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                       ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                       call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = itau
                       itauq = ie + n
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize r in vt, copying result to work(ir)
#:if rk == "sp"
                       ! (workspace: need n*n+4*n, prefer n*n+3*n+2*n*nb)
#:else
                       ! (workspace: need n*n + 4*n, prefer n*n + 3*n + 2*n*nb)
#:endif
                       call la_${ri}$gebrd(n,n,vt,ldvt,s,work(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       call la_${ri}$lacpy('L',n,n,vt,ldvt,work(ir),ldwrkr)
                       ! generate left vectors bidiagonalizing r in work(ir)
#:if rk == "sp"
                       ! (workspace: need n*n+4*n, prefer n*n+3*n+n*nb)
#:else
                       ! (workspace: need n*n + 4*n, prefer n*n + 3*n + n*nb)
#:endif
                       call la_${ri}$orgbr('Q',n,n,n,work(ir),ldwrkr,work(itauq),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing r in vt
#:if rk == "sp"
                       ! (workspace: need n*n+4*n-1, prefer n*n+3*n+(n-1)*nb)
#:else
                       ! (workspace: need n*n + 4*n-1, prefer n*n + 3*n + (n-1)*nb)
#:endif
                       call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       iwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of r in work(ir) and computing right
                       ! singular vectors of r in vt
#:if rk == "sp"
                       ! (workspace: need n*n+bdspac)
#:else
                       ! (workspace: need n*n + bdspac)
#:endif
                       call la_${ri}$bdsqr('U',n,n,n,0,s,work(ie),vt,ldvt,work(ir), &
                                 ldwrkr,dum,1,work(iwork),info)
                       iu = ie + n
                       ! multiply q in a by left singular vectors of r in
                       ! work(ir), storing result in work(iu) and copying to a
#:if rk == "sp"
                       ! (workspace: need n*n+2*n, prefer n*n+m*n+n)
#:else
                       ! (workspace: need n*n + 2*n, prefer n*n + m*n + n)
#:endif
                       do i = 1,m,ldwrku
                          chunk = min(m - i + 1,ldwrku)
                          call la_${ri}$gemm('N','N',chunk,n,n,one,a(i,1),lda,work(ir) &
                                    ,ldwrkr,zero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',chunk,n,work(iu),ldwrku,a(i,1),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       itau = 1
                       iwork = itau + n
                       ! compute a=q*r
#:if rk == "sp"
                       ! (workspace: need 2*n, prefer n+n*nb)
#:else
                       ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                       call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy r to vt, zeroing out below it
                       call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                       if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,zero,zero,vt(2,1),ldvt)

                       ! generate q in a
#:if rk == "sp"
                       ! (workspace: need 2*n, prefer n+n*nb)
#:else
                       ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                       call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = itau
                       itauq = ie + n
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize r in vt
#:if rk == "sp"
                       ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                       ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                       call la_${ri}$gebrd(n,n,vt,ldvt,s,work(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! multiply q in a by left vectors bidiagonalizing r
#:if rk == "sp"
                       ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                       ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                       call la_${ri}$ormbr('Q','R','N',m,n,n,vt,ldvt,work(itauq),a,lda, &
                                  work(iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing r in vt
#:if rk == "sp"
                       ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                       ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                       call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       iwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of a in a and computing right
                       ! singular vectors of a in vt
                       ! (workspace: need bdspac)
                       call la_${ri}$bdsqr('U',n,n,m,0,s,work(ie),vt,ldvt,a,lda,dum, &
                                 1,work(iwork),info)
                    end if
                 else if (wntus) then
                    if (wntvn) then
                       ! path 4 (m much larger than n, jobu='s', jobvt='n')
                       ! n left singular vectors to be computed in u and
                       ! no right singular vectors to be computed
                       if (lwork >= n*n + max(4*n,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(ir) is lda by n
                             ldwrkr = lda
                          else
                             ! work(ir) is n by n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r
#:if rk == "sp"
                          ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                          ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(ir), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(ir + 1),ldwrkr)

                          ! generate q in a
#:if rk == "sp"
                          ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                          ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                          call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(ir)
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+2*n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate left vectors bidiagonalizing r in work(ir)
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + n*nb)
#:endif
                          call la_${ri}$orgbr('Q',n,n,n,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(ir)
#:if rk == "sp"
                          ! (workspace: need n*n+bdspac)
#:else
                          ! (workspace: need n*n + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',n,0,n,0,s,work(ie),dum,1,work(ir), &
                                    ldwrkr,dum,1,work(iwork),info)
                          ! multiply q in a by left singular vectors of r in
                          ! work(ir), storing result in u
                          ! (workspace: need n*n)
                          call la_${ri}$gemm('N','N',m,n,n,one,a,lda,work(ir),ldwrkr, &
                                    zero,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$orgqr(m,n,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
#:if rk == "sp"
                          ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                          ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left vectors bidiagonalizing r
#:if rk == "sp"
                          ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                          ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                          call la_${ri}$ormbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,0,m,0,s,work(ie),dum,1,u,ldu,dum, &
                                    1,work(iwork),info)
                       end if
                    else if (wntvo) then
                       ! path 5 (m much larger than n, jobu='s', jobvt='o')
                       ! n left singular vectors to be computed in u and
                       ! n right singular vectors to be overwritten on a
                       if (lwork >= 2*n*n + max(4*n,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*n) then
                             ! work(iu) is lda by n and work(ir) is lda by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + n)*n) then
                             ! work(iu) is lda by n and work(ir) is n by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          else
                             ! work(iu) is n by n and work(ir) is n by n
                             ldwrku = n
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r
#:if rk == "sp"
                          ! (workspace: need 2*n*n+2*n, prefer 2*n*n+n+n*nb)
#:else
                          ! (workspace: need 2*n*n + 2*n, prefer 2*n*n + n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(iu + 1),ldwrku)

                          ! generate q in a
#:if rk == "sp"
                          ! (workspace: need 2*n*n+2*n, prefer 2*n*n+n+n*nb)
#:else
                          ! (workspace: need 2*n*n + 2*n, prefer 2*n*n + n + n*nb)
#:endif
                          call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to
                          ! work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+4*n,
#:else
                          ! (workspace: need 2*n*n + 4*n,
#:endif
                                      ! prefer 2*n*n+3*n+2*n*nb)
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate left bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+4*n, prefer 2*n*n+3*n+n*nb)
#:else
                          ! (workspace: need 2*n*n + 4*n, prefer 2*n*n + 3*n + n*nb)
#:endif
                          call la_${ri}$orgbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+4*n-1,
#:else
                          ! (workspace: need 2*n*n + 4*n-1,
#:endif
                                      ! prefer 2*n*n+3*n+(n-1)*nb)
                          call la_${ri}$orgbr('P',n,n,n,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+bdspac)
#:else
                          ! (workspace: need 2*n*n + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',n,n,n,0,s,work(ie),work(ir),ldwrkr, &
                                    work(iu),ldwrku,dum,1,work(iwork),info)
                          ! multiply q in a by left singular vectors of r in
                          ! work(iu), storing result in u
                          ! (workspace: need n*n)
                          call la_${ri}$gemm('N','N',m,n,n,one,a,lda,work(iu),ldwrku, &
                                    zero,u,ldu)
                          ! copy right singular vectors of r to a
                          ! (workspace: need n*n)
                          call la_${ri}$lacpy('F',n,n,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$orgqr(m,n,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
#:if rk == "sp"
                          ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                          ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left vectors bidiagonalizing r
#:if rk == "sp"
                          ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                          ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                          call la_${ri}$ormbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right vectors bidiagonalizing r in a
#:if rk == "sp"
                          ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                          ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                          call la_${ri}$orgbr('P',n,n,n,a,lda,work(itaup),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in a
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,work(ie),a,lda,u,ldu,dum, &
                                    1,work(iwork),info)
                       end if
                    else if (wntvas) then
                       ! path 6 (m much larger than n, jobu='s', jobvt='s'
                               ! or 'a')
                       ! n left singular vectors to be computed in u and
                       ! n right singular vectors to be computed in vt
                       if (lwork >= n*n + max(4*n,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(iu) is lda by n
                             ldwrku = lda
                          else
                             ! work(iu) is n by n
                             ldwrku = n
                          end if
                          itau = iu + ldwrku*n
                          iwork = itau + n
                          ! compute a=q*r
#:if rk == "sp"
                          ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                          ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(iu + 1),ldwrku)

                          ! generate q in a
#:if rk == "sp"
                          ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                          ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                          call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to vt
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+2*n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,vt,ldvt)
                          ! generate left bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + n*nb)
#:endif
                          call la_${ri}$orgbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
#:if rk == "sp"
                          ! (workspace: need n*n+4*n-1,
#:else
                          ! (workspace: need n*n + 4*n-1,
#:endif
                                      ! prefer n*n+3*n+(n-1)*nb)
                          call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in vt
#:if rk == "sp"
                          ! (workspace: need n*n+bdspac)
#:else
                          ! (workspace: need n*n + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',n,n,n,0,s,work(ie),vt,ldvt,work(iu), &
                                     ldwrku,dum,1,work(iwork),info)
                          ! multiply q in a by left singular vectors of r in
                          ! work(iu), storing result in u
                          ! (workspace: need n*n)
                          call la_${ri}$gemm('N','N',m,n,n,one,a,lda,work(iu),ldwrku, &
                                    zero,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$orgqr(m,n,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to vt, zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                          if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,zero,zero,vt(2,1),ldvt &
                                    )
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in vt
#:if rk == "sp"
                          ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                          ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,vt,ldvt,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in vt
#:if rk == "sp"
                          ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                          ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                          call la_${ri}$ormbr('Q','R','N',m,n,n,vt,ldvt,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
#:if rk == "sp"
                          ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                          ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                          call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,work(ie),vt,ldvt,u,ldu, &
                                    dum,1,work(iwork),info)
                       end if
                    end if
                 else if (wntua) then
                    if (wntvn) then
                       ! path 7 (m much larger than n, jobu='a', jobvt='n')
                       ! m left singular vectors to be computed in u and
                       ! no right singular vectors to be computed
                       if (lwork >= n*n + max(n + m,4*n,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(ir) is lda by n
                             ldwrkr = lda
                          else
                             ! work(ir) is n by n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                          ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! copy r to work(ir), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(ir + 1),ldwrkr)

                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need n*n+n+m, prefer n*n+n+m*nb)
#:else
                          ! (workspace: need n*n + n + m, prefer n*n + n + m*nb)
#:endif
                          call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(ir)
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+2*n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in work(ir)
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + n*nb)
#:endif
                          call la_${ri}$orgbr('Q',n,n,n,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(ir)
#:if rk == "sp"
                          ! (workspace: need n*n+bdspac)
#:else
                          ! (workspace: need n*n + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',n,0,n,0,s,work(ie),dum,1,work(ir), &
                                    ldwrkr,dum,1,work(iwork),info)
                          ! multiply q in u by left singular vectors of r in
                          ! work(ir), storing result in a
                          ! (workspace: need n*n)
                          call la_${ri}$gemm('N','N',m,n,n,one,u,ldu,work(ir),ldwrkr, &
                                    zero,a,lda)
                          ! copy left singular vectors of a from a to u
                          call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need n+m, prefer n+m*nb)
#:else
                          ! (workspace: need n + m, prefer n + m*nb)
#:endif
                          call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
#:if rk == "sp"
                          ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                          ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in a
#:if rk == "sp"
                          ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                          ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                          call la_${ri}$ormbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,0,m,0,s,work(ie),dum,1,u,ldu,dum, &
                                    1,work(iwork),info)
                       end if
                    else if (wntvo) then
                       ! path 8 (m much larger than n, jobu='a', jobvt='o')
                       ! m left singular vectors to be computed in u and
                       ! n right singular vectors to be overwritten on a
                       if (lwork >= 2*n*n + max(n + m,4*n,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*n) then
                             ! work(iu) is lda by n and work(ir) is lda by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + n)*n) then
                             ! work(iu) is lda by n and work(ir) is n by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          else
                             ! work(iu) is n by n and work(ir) is n by n
                             ldwrku = n
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n*n+2*n, prefer 2*n*n+n+n*nb)
#:else
                          ! (workspace: need 2*n*n + 2*n, prefer 2*n*n + n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need 2*n*n+n+m, prefer 2*n*n+n+m*nb)
#:else
                          ! (workspace: need 2*n*n + n + m, prefer 2*n*n + n + m*nb)
#:endif
                          call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(iu + 1),ldwrku)

                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to
                          ! work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+4*n,
#:else
                          ! (workspace: need 2*n*n + 4*n,
#:endif
                                      ! prefer 2*n*n+3*n+2*n*nb)
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate left bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+4*n, prefer 2*n*n+3*n+n*nb)
#:else
                          ! (workspace: need 2*n*n + 4*n, prefer 2*n*n + 3*n + n*nb)
#:endif
                          call la_${ri}$orgbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+4*n-1,
#:else
                          ! (workspace: need 2*n*n + 4*n-1,
#:endif
                                      ! prefer 2*n*n+3*n+(n-1)*nb)
                          call la_${ri}$orgbr('P',n,n,n,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*n*n+bdspac)
#:else
                          ! (workspace: need 2*n*n + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',n,n,n,0,s,work(ie),work(ir),ldwrkr, &
                                    work(iu),ldwrku,dum,1,work(iwork),info)
                          ! multiply q in u by left singular vectors of r in
                          ! work(iu), storing result in a
                          ! (workspace: need n*n)
                          call la_${ri}$gemm('N','N',m,n,n,one,u,ldu,work(iu),ldwrku, &
                                    zero,a,lda)
                          ! copy left singular vectors of a from a to u
                          call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                          ! copy right singular vectors of r from work(ir) to a
                          call la_${ri}$lacpy('F',n,n,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need n+m, prefer n+m*nb)
#:else
                          ! (workspace: need n + m, prefer n + m*nb)
#:endif
                          call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
#:if rk == "sp"
                          ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                          ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in a
#:if rk == "sp"
                          ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                          ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                          call la_${ri}$ormbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in a
#:if rk == "sp"
                          ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                          ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                          call la_${ri}$orgbr('P',n,n,n,a,lda,work(itaup),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in a
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,work(ie),a,lda,u,ldu,dum, &
                                    1,work(iwork),info)
                       end if
                    else if (wntvas) then
                       ! path 9 (m much larger than n, jobu='a', jobvt='s'
                               ! or 'a')
                       ! m left singular vectors to be computed in u and
                       ! n right singular vectors to be computed in vt
                       if (lwork >= n*n + max(n + m,4*n,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(iu) is lda by n
                             ldwrku = lda
                          else
                             ! work(iu) is n by n
                             ldwrku = n
                          end if
                          itau = iu + ldwrku*n
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need n*n+2*n, prefer n*n+n+n*nb)
#:else
                          ! (workspace: need n*n + 2*n, prefer n*n + n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need n*n+n+m, prefer n*n+n+m*nb)
#:else
                          ! (workspace: need n*n + n + m, prefer n*n + n + m*nb)
#:endif
                          call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(iu + 1),ldwrku)

                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to vt
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+2*n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,vt,ldvt)
                          ! generate left bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need n*n+4*n, prefer n*n+3*n+n*nb)
#:else
                          ! (workspace: need n*n + 4*n, prefer n*n + 3*n + n*nb)
#:endif
                          call la_${ri}$orgbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
#:if rk == "sp"
                          ! (workspace: need n*n+4*n-1,
#:else
                          ! (workspace: need n*n + 4*n-1,
#:endif
                                      ! prefer n*n+3*n+(n-1)*nb)
                          call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in vt
#:if rk == "sp"
                          ! (workspace: need n*n+bdspac)
#:else
                          ! (workspace: need n*n + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',n,n,n,0,s,work(ie),vt,ldvt,work(iu), &
                                     ldwrku,dum,1,work(iwork),info)
                          ! multiply q in u by left singular vectors of r in
                          ! work(iu), storing result in a
                          ! (workspace: need n*n)
                          call la_${ri}$gemm('N','N',m,n,n,one,u,ldu,work(iu),ldwrku, &
                                    zero,a,lda)
                          ! copy left singular vectors of a from a to u
                          call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
#:if rk == "sp"
                          ! (workspace: need 2*n, prefer n+n*nb)
#:else
                          ! (workspace: need 2*n, prefer n + n*nb)
#:endif
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
#:if rk == "sp"
                          ! (workspace: need n+m, prefer n+m*nb)
#:else
                          ! (workspace: need n + m, prefer n + m*nb)
#:endif
                          call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r from a to vt, zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                          if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,zero,zero,vt(2,1),ldvt &
                                    )
                          ie = itau
                          itauq = ie + n
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in vt
#:if rk == "sp"
                          ! (workspace: need 4*n, prefer 3*n+2*n*nb)
#:else
                          ! (workspace: need 4*n, prefer 3*n + 2*n*nb)
#:endif
                          call la_${ri}$gebrd(n,n,vt,ldvt,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in vt
#:if rk == "sp"
                          ! (workspace: need 3*n+m, prefer 3*n+m*nb)
#:else
                          ! (workspace: need 3*n + m, prefer 3*n + m*nb)
#:endif
                          call la_${ri}$ormbr('Q','R','N',m,n,n,vt,ldvt,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
#:if rk == "sp"
                          ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                          ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                          call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          iwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,work(ie),vt,ldvt,u,ldu, &
                                    dum,1,work(iwork),info)
                       end if
                    end if
                 end if
              else
                 ! m < mnthr
                 ! path 10 (m at least n, but not much larger)
                 ! reduce to bidiagonal form without qr decomposition
                 ie = 1
                 itauq = ie + n
                 itaup = itauq + n
                 iwork = itaup + n
                 ! bidiagonalize a
#:if rk == "sp"
                 ! (workspace: need 3*n+m, prefer 3*n+(m+n)*nb)
#:else
                 ! (workspace: need 3*n + m, prefer 3*n + (m + n)*nb)
#:endif
                 call la_${ri}$gebrd(m,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                           work(iwork),lwork - iwork + 1,ierr)
                 if (wntuas) then
                    ! if left singular vectors desired in u, copy result to u
                    ! and generate left bidiagonalizing vectors in u
#:if rk == "sp"
                    ! (workspace: need 3*n+ncu, prefer 3*n+ncu*nb)
#:else
                    ! (workspace: need 3*n + ncu, prefer 3*n + ncu*nb)
#:endif
                    call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                    if (wntus) ncu = n
                    if (wntua) ncu = m
                    call la_${ri}$orgbr('Q',m,ncu,n,u,ldu,work(itauq),work(iwork), &
                              lwork - iwork + 1,ierr)
                 end if
                 if (wntvas) then
                    ! if right singular vectors desired in vt, copy result to
                    ! vt and generate right bidiagonalizing vectors in vt
#:if rk == "sp"
                    ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                    ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                    call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                    call la_${ri}$orgbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                              lwork - iwork + 1,ierr)
                 end if
                 if (wntuo) then
                    ! if left singular vectors desired in a, generate left
                    ! bidiagonalizing vectors in a
#:if rk == "sp"
                    ! (workspace: need 4*n, prefer 3*n+n*nb)
#:else
                    ! (workspace: need 4*n, prefer 3*n + n*nb)
#:endif
                    call la_${ri}$orgbr('Q',m,n,n,a,lda,work(itauq),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 if (wntvo) then
                    ! if right singular vectors desired in a, generate right
                    ! bidiagonalizing vectors in a
#:if rk == "sp"
                    ! (workspace: need 4*n-1, prefer 3*n+(n-1)*nb)
#:else
                    ! (workspace: need 4*n-1, prefer 3*n + (n-1)*nb)
#:endif
                    call la_${ri}$orgbr('P',n,n,n,a,lda,work(itaup),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 iwork = ie + n
                 if (wntuas .or. wntuo) nru = m
                 if (wntun) nru = 0
                 if (wntvas .or. wntvo) ncvt = n
                 if (wntvn) ncvt = 0
                 if ((.not. wntuo) .and. (.not. wntvo)) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in vt
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,nru,0,s,work(ie),vt,ldvt,u,ldu,dum, &
                               1,work(iwork),info)
                 else if ((.not. wntuo) .and. wntvo) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in a
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,nru,0,s,work(ie),a,lda,u,ldu,dum, &
                              1,work(iwork),info)
                 else
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in a and computing right singular
                    ! vectors in vt
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,nru,0,s,work(ie),vt,ldvt,a,lda,dum, &
                               1,work(iwork),info)
                 end if
              end if
           else
              ! a has more columns than rows. if a has sufficiently more
              ! columns than rows, first reduce using the lq decomposition (if
              ! sufficient workspace available)
              if (n >= mnthr) then
                 if (wntvn) then
                    ! path 1t(n much larger than m, jobvt='n')
                    ! no right singular vectors to be computed
                    itau = 1
                    iwork = itau + m
                    ! compute a=l*q
#:if rk == "sp"
                    ! (workspace: need 2*m, prefer m+m*nb)
#:else
                    ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + 1, &
                              ierr)
                    ! zero out above l
                    call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                    ie = 1
                    itauq = ie + m
                    itaup = itauq + m
                    iwork = itaup + m
                    ! bidiagonalize l in a
#:if rk == "sp"
                    ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                    ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                    call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work(itaup), &
                              work(iwork),lwork - iwork + 1,ierr)
                    if (wntuo .or. wntuas) then
                       ! if left singular vectors desired, generate q
#:if rk == "sp"
                       ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                       ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                       call la_${ri}$orgbr('Q',m,m,m,a,lda,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                    end if
                    iwork = ie + m
                    nru = 0
                    if (wntuo .or. wntuas) nru = m
                    ! perform bidiagonal qr iteration, computing left singular
                    ! vectors of a in a if desired
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('U',m,0,nru,0,s,work(ie),dum,1,a,lda,dum,1, &
                              work(iwork),info)
                    ! if left singular vectors desired in u, copy them there
                    if (wntuas) call la_${ri}$lacpy('F',m,m,a,lda,u,ldu)
                 else if (wntvo .and. wntun) then
                    ! path 2t(n much larger than m, jobu='n', jobvt='o')
                    ! m right singular vectors to be overwritten on a and
                    ! no left singular vectors to be computed
                    if (lwork >= m*m + max(4*m,bdspac)) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n + m) + lda*m) then
                          ! work(iu) is lda by n and work(ir) is lda by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n + m) + m*m) then
                          ! work(iu) is lda by n and work(ir) is m by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = m
                       else
                          ! work(iu) is m by chunk and work(ir) is m by m
                          ldwrku = m
                          chunk = (lwork - m*m - m)/m
                          ldwrkr = m
                       end if
                       itau = ir + ldwrkr*m
                       iwork = itau + m
                       ! compute a=l*q
#:if rk == "sp"
                       ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                       ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                       call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy l to work(ir) and zero out above it
                       call la_${ri}$lacpy('L',m,m,a,lda,work(ir),ldwrkr)
                       call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(ir + ldwrkr),ldwrkr)

                       ! generate q in a
#:if rk == "sp"
                       ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                       ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                       call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = itau
                       itauq = ie + m
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize l in work(ir)
#:if rk == "sp"
                       ! (workspace: need m*m+4*m, prefer m*m+3*m+2*m*nb)
#:else
                       ! (workspace: need m*m + 4*m, prefer m*m + 3*m + 2*m*nb)
#:endif
                       call la_${ri}$gebrd(m,m,work(ir),ldwrkr,s,work(ie),work(itauq), &
                                 work(itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing l
#:if rk == "sp"
                       ! (workspace: need m*m+4*m-1, prefer m*m+3*m+(m-1)*nb)
#:else
                       ! (workspace: need m*m + 4*m-1, prefer m*m + 3*m + (m-1)*nb)
#:endif
                       call la_${ri}$orgbr('P',m,m,m,work(ir),ldwrkr,work(itaup),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       iwork = ie + m
                       ! perform bidiagonal qr iteration, computing right
                       ! singular vectors of l in work(ir)
#:if rk == "sp"
                       ! (workspace: need m*m+bdspac)
#:else
                       ! (workspace: need m*m + bdspac)
#:endif
                       call la_${ri}$bdsqr('U',m,m,0,0,s,work(ie),work(ir),ldwrkr,dum, &
                                  1,dum,1,work(iwork),info)
                       iu = ie + m
                       ! multiply right singular vectors of l in work(ir) by q
                       ! in a, storing result in work(iu) and copying to a
#:if rk == "sp"
                       ! (workspace: need m*m+2*m, prefer m*m+m*n+m)
#:else
                       ! (workspace: need m*m + 2*m, prefer m*m + m*n + m)
#:endif
                       do i = 1,n,chunk
                          blk = min(n - i + 1,chunk)
                          call la_${ri}$gemm('N','N',m,blk,m,one,work(ir),ldwrkr,a(1,i &
                                    ),lda,zero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',m,blk,work(iu),ldwrku,a(1,i),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       ie = 1
                       itauq = ie + m
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize a
#:if rk == "sp"
                       ! (workspace: need 3*m+n, prefer 3*m+(m+n)*nb)
#:else
                       ! (workspace: need 3*m + n, prefer 3*m + (m + n)*nb)
#:endif
                       call la_${ri}$gebrd(m,n,a,lda,s,work(ie),work(itauq),work(itaup &
                                 ),work(iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing a
#:if rk == "sp"
                       ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                       ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                       call la_${ri}$orgbr('P',m,n,m,a,lda,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       iwork = ie + m
                       ! perform bidiagonal qr iteration, computing right
                       ! singular vectors of a in a
                       ! (workspace: need bdspac)
                       call la_${ri}$bdsqr('L',m,n,0,0,s,work(ie),a,lda,dum,1,dum,1, &
                                 work(iwork),info)
                    end if
                 else if (wntvo .and. wntuas) then
                    ! path 3t(n much larger than m, jobu='s' or 'a', jobvt='o')
                    ! m right singular vectors to be overwritten on a and
                    ! m left singular vectors to be computed in u
                    if (lwork >= m*m + max(4*m,bdspac)) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n + m) + lda*m) then
                          ! work(iu) is lda by n and work(ir) is lda by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n + m) + m*m) then
                          ! work(iu) is lda by n and work(ir) is m by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = m
                       else
                          ! work(iu) is m by chunk and work(ir) is m by m
                          ldwrku = m
                          chunk = (lwork - m*m - m)/m
                          ldwrkr = m
                       end if
                       itau = ir + ldwrkr*m
                       iwork = itau + m
                       ! compute a=l*q
#:if rk == "sp"
                       ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                       ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                       call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy l to u, zeroing about above it
                       call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                       call la_${ri}$laset('U',m - 1,m - 1,zero,zero,u(1,2),ldu)
                       ! generate q in a
#:if rk == "sp"
                       ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                       ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                       call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = itau
                       itauq = ie + m
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize l in u, copying result to work(ir)
#:if rk == "sp"
                       ! (workspace: need m*m+4*m, prefer m*m+3*m+2*m*nb)
#:else
                       ! (workspace: need m*m + 4*m, prefer m*m + 3*m + 2*m*nb)
#:endif
                       call la_${ri}$gebrd(m,m,u,ldu,s,work(ie),work(itauq),work(itaup &
                                 ),work(iwork),lwork - iwork + 1,ierr)
                       call la_${ri}$lacpy('U',m,m,u,ldu,work(ir),ldwrkr)
                       ! generate right vectors bidiagonalizing l in work(ir)
#:if rk == "sp"
                       ! (workspace: need m*m+4*m-1, prefer m*m+3*m+(m-1)*nb)
#:else
                       ! (workspace: need m*m + 4*m-1, prefer m*m + 3*m + (m-1)*nb)
#:endif
                       call la_${ri}$orgbr('P',m,m,m,work(ir),ldwrkr,work(itaup),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing l in u
#:if rk == "sp"
                       ! (workspace: need m*m+4*m, prefer m*m+3*m+m*nb)
#:else
                       ! (workspace: need m*m + 4*m, prefer m*m + 3*m + m*nb)
#:endif
                       call la_${ri}$orgbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       iwork = ie + m
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of l in u, and computing right
                       ! singular vectors of l in work(ir)
#:if rk == "sp"
                       ! (workspace: need m*m+bdspac)
#:else
                       ! (workspace: need m*m + bdspac)
#:endif
                       call la_${ri}$bdsqr('U',m,m,m,0,s,work(ie),work(ir),ldwrkr,u, &
                                 ldu,dum,1,work(iwork),info)
                       iu = ie + m
                       ! multiply right singular vectors of l in work(ir) by q
                       ! in a, storing result in work(iu) and copying to a
#:if rk == "sp"
                       ! (workspace: need m*m+2*m, prefer m*m+m*n+m))
#:else
                       ! (workspace: need m*m + 2*m, prefer m*m + m*n + m))
#:endif
                       do i = 1,n,chunk
                          blk = min(n - i + 1,chunk)
                          call la_${ri}$gemm('N','N',m,blk,m,one,work(ir),ldwrkr,a(1,i &
                                    ),lda,zero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',m,blk,work(iu),ldwrku,a(1,i),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       itau = 1
                       iwork = itau + m
                       ! compute a=l*q
#:if rk == "sp"
                       ! (workspace: need 2*m, prefer m+m*nb)
#:else
                       ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                       call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy l to u, zeroing out above it
                       call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                       call la_${ri}$laset('U',m - 1,m - 1,zero,zero,u(1,2),ldu)
                       ! generate q in a
#:if rk == "sp"
                       ! (workspace: need 2*m, prefer m+m*nb)
#:else
                       ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                       call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = itau
                       itauq = ie + m
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize l in u
#:if rk == "sp"
                       ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                       ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                       call la_${ri}$gebrd(m,m,u,ldu,s,work(ie),work(itauq),work(itaup &
                                 ),work(iwork),lwork - iwork + 1,ierr)
                       ! multiply right vectors bidiagonalizing l by q in a
#:if rk == "sp"
                       ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                       ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                       call la_${ri}$ormbr('P','L','T',m,n,m,u,ldu,work(itaup),a,lda, &
                                 work(iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing l in u
#:if rk == "sp"
                       ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                       ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                       call la_${ri}$orgbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       iwork = ie + m
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of a in u and computing right
                       ! singular vectors of a in a
                       ! (workspace: need bdspac)
                       call la_${ri}$bdsqr('U',m,n,m,0,s,work(ie),a,lda,u,ldu,dum,1, &
                                 work(iwork),info)
                    end if
                 else if (wntvs) then
                    if (wntun) then
                       ! path 4t(n much larger than m, jobu='n', jobvt='s')
                       ! m right singular vectors to be computed in vt and
                       ! no left singular vectors to be computed
                       if (lwork >= m*m + max(4*m,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(ir) is lda by m
                             ldwrkr = lda
                          else
                             ! work(ir) is m by m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q
#:if rk == "sp"
                          ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                          ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy l to work(ir), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(ir + ldwrkr),ldwrkr &
                                    )
                          ! generate q in a
#:if rk == "sp"
                          ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                          ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                          call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(ir)
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+2*m*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,work(ir),ldwrkr,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate right vectors bidiagonalizing l in
                          ! work(ir)
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+(m-1)*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + (m-1)*nb)
#:endif
                          call la_${ri}$orgbr('P',m,m,m,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of l in work(ir)
#:if rk == "sp"
                          ! (workspace: need m*m+bdspac)
#:else
                          ! (workspace: need m*m + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',m,m,0,0,s,work(ie),work(ir),ldwrkr, &
                                    dum,1,dum,1,work(iwork),info)
                          ! multiply right singular vectors of l in work(ir) by
                          ! q in a, storing result in vt
                          ! (workspace: need m*m)
                          call la_${ri}$gemm('N','N',m,n,m,one,work(ir),ldwrkr,a,lda, &
                                    zero,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy result to vt
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$orglq(m,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                          ! bidiagonalize l in a
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right vectors bidiagonalizing l by q in vt
#:if rk == "sp"
                          ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                          ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                          call la_${ri}$ormbr('P','L','T',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,0,0,s,work(ie),vt,ldvt,dum,1, &
                                    dum,1,work(iwork),info)
                       end if
                    else if (wntuo) then
                       ! path 5t(n much larger than m, jobu='o', jobvt='s')
                       ! m right singular vectors to be computed in vt and
                       ! m left singular vectors to be overwritten on a
                       if (lwork >= 2*m*m + max(4*m,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*m) then
                             ! work(iu) is lda by m and work(ir) is lda by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + m)*m) then
                             ! work(iu) is lda by m and work(ir) is m by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          else
                             ! work(iu) is m by m and work(ir) is m by m
                             ldwrku = m
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q
#:if rk == "sp"
                          ! (workspace: need 2*m*m+2*m, prefer 2*m*m+m+m*nb)
#:else
                          ! (workspace: need 2*m*m + 2*m, prefer 2*m*m + m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out below it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(iu + ldwrku),ldwrku &
                                    )
                          ! generate q in a
#:if rk == "sp"
                          ! (workspace: need 2*m*m+2*m, prefer 2*m*m+m+m*nb)
#:else
                          ! (workspace: need 2*m*m + 2*m, prefer 2*m*m + m + m*nb)
#:endif
                          call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to
                          ! work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+4*m,
#:else
                          ! (workspace: need 2*m*m + 4*m,
#:endif
                                      ! prefer 2*m*m+3*m+2*m*nb)
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate right bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+4*m-1,
#:else
                          ! (workspace: need 2*m*m + 4*m-1,
#:endif
                                      ! prefer 2*m*m+3*m+(m-1)*nb)
                          call la_${ri}$orgbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+4*m, prefer 2*m*m+3*m+m*nb)
#:else
                          ! (workspace: need 2*m*m + 4*m, prefer 2*m*m + 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in work(ir) and computing
                          ! right singular vectors of l in work(iu)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+bdspac)
#:else
                          ! (workspace: need 2*m*m + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',m,m,m,0,s,work(ie),work(iu),ldwrku, &
                                    work(ir),ldwrkr,dum,1,work(iwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in a, storing result in vt
                          ! (workspace: need m*m)
                          call la_${ri}$gemm('N','N',m,n,m,one,work(iu),ldwrku,a,lda, &
                                    zero,vt,ldvt)
                          ! copy left singular vectors of l to a
                          ! (workspace: need m*m)
                          call la_${ri}$lacpy('F',m,m,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$orglq(m,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                          ! bidiagonalize l in a
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right vectors bidiagonalizing l by q in vt
#:if rk == "sp"
                          ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                          ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                          call la_${ri}$ormbr('P','L','T',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors of l in a
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,a,lda,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, compute left
                          ! singular vectors of a in a and compute right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,work(ie),vt,ldvt,a,lda, &
                                    dum,1,work(iwork),info)
                       end if
                    else if (wntuas) then
                       ! path 6t(n much larger than m, jobu='s' or 'a',
                               ! jobvt='s')
                       ! m right singular vectors to be computed in vt and
                       ! m left singular vectors to be computed in u
                       if (lwork >= m*m + max(4*m,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(iu) is lda by n
                             ldwrku = lda
                          else
                             ! work(iu) is lda by m
                             ldwrku = m
                          end if
                          itau = iu + ldwrku*m
                          iwork = itau + m
                          ! compute a=l*q
#:if rk == "sp"
                          ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                          ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(iu + ldwrku),ldwrku &
                                    )
                          ! generate q in a
#:if rk == "sp"
                          ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                          ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                          call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to u
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+2*m*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,u,ldu)
                          ! generate right bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need m*m+4*m-1,
#:else
                          ! (workspace: need m*m + 4*m-1,
#:endif
                                      ! prefer m*m+3*m+(m-1)*nb)
                          call la_${ri}$orgbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+m*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in u and computing right
                          ! singular vectors of l in work(iu)
#:if rk == "sp"
                          ! (workspace: need m*m+bdspac)
#:else
                          ! (workspace: need m*m + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',m,m,m,0,s,work(ie),work(iu),ldwrku, &
                                    u,ldu,dum,1,work(iwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in a, storing result in vt
                          ! (workspace: need m*m)
                          call la_${ri}$gemm('N','N',m,n,m,one,work(iu),ldwrku,a,lda, &
                                    zero,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$orglq(m,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to u, zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,u(1,2),ldu)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in u
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,u,ldu,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in u by q
                          ! in vt
#:if rk == "sp"
                          ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                          ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                          call la_${ri}$ormbr('P','L','T',m,n,m,u,ldu,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,work(ie),vt,ldvt,u,ldu, &
                                    dum,1,work(iwork),info)
                       end if
                    end if
                 else if (wntva) then
                    if (wntun) then
                       ! path 7t(n much larger than m, jobu='n', jobvt='a')
                       ! n right singular vectors to be computed in vt and
                       ! no left singular vectors to be computed
                       if (lwork >= m*m + max(n + m,4*m,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(ir) is lda by m
                             ldwrkr = lda
                          else
                             ! work(ir) is m by m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                          ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! copy l to work(ir), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(ir + ldwrkr),ldwrkr &
                                    )
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need m*m+m+n, prefer m*m+m+n*nb)
#:else
                          ! (workspace: need m*m + m + n, prefer m*m + m + n*nb)
#:endif
                          call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(ir)
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+2*m*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,work(ir),ldwrkr,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in work(ir)
#:if rk == "sp"
                          ! (workspace: need m*m+4*m-1,
#:else
                          ! (workspace: need m*m + 4*m-1,
#:endif
                                      ! prefer m*m+3*m+(m-1)*nb)
                          call la_${ri}$orgbr('P',m,m,m,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of l in work(ir)
#:if rk == "sp"
                          ! (workspace: need m*m+bdspac)
#:else
                          ! (workspace: need m*m + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',m,m,0,0,s,work(ie),work(ir),ldwrkr, &
                                    dum,1,dum,1,work(iwork),info)
                          ! multiply right singular vectors of l in work(ir) by
                          ! q in vt, storing result in a
                          ! (workspace: need m*m)
                          call la_${ri}$gemm('N','N',m,n,m,one,work(ir),ldwrkr,vt,ldvt, &
                                    zero,a,lda)
                          ! copy right singular vectors of a from a to vt
                          call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need m+n, prefer m+n*nb)
#:else
                          ! (workspace: need m + n, prefer m + n*nb)
#:endif
                          call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                          ! bidiagonalize l in a
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in a by q
                          ! in vt
#:if rk == "sp"
                          ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                          ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                          call la_${ri}$ormbr('P','L','T',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,0,0,s,work(ie),vt,ldvt,dum,1, &
                                    dum,1,work(iwork),info)
                       end if
                    else if (wntuo) then
                       ! path 8t(n much larger than m, jobu='o', jobvt='a')
                       ! n right singular vectors to be computed in vt and
                       ! m left singular vectors to be overwritten on a
                       if (lwork >= 2*m*m + max(n + m,4*m,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*m) then
                             ! work(iu) is lda by m and work(ir) is lda by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + m)*m) then
                             ! work(iu) is lda by m and work(ir) is m by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          else
                             ! work(iu) is m by m and work(ir) is m by m
                             ldwrku = m
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need 2*m*m+2*m, prefer 2*m*m+m+m*nb)
#:else
                          ! (workspace: need 2*m*m + 2*m, prefer 2*m*m + m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need 2*m*m+m+n, prefer 2*m*m+m+n*nb)
#:else
                          ! (workspace: need 2*m*m + m + n, prefer 2*m*m + m + n*nb)
#:endif
                          call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(iu + ldwrku),ldwrku &
                                    )
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to
                          ! work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+4*m,
#:else
                          ! (workspace: need 2*m*m + 4*m,
#:endif
                                      ! prefer 2*m*m+3*m+2*m*nb)
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate right bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+4*m-1,
#:else
                          ! (workspace: need 2*m*m + 4*m-1,
#:endif
                                      ! prefer 2*m*m+3*m+(m-1)*nb)
                          call la_${ri}$orgbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in work(ir)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+4*m, prefer 2*m*m+3*m+m*nb)
#:else
                          ! (workspace: need 2*m*m + 4*m, prefer 2*m*m + 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in work(ir) and computing
                          ! right singular vectors of l in work(iu)
#:if rk == "sp"
                          ! (workspace: need 2*m*m+bdspac)
#:else
                          ! (workspace: need 2*m*m + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',m,m,m,0,s,work(ie),work(iu),ldwrku, &
                                    work(ir),ldwrkr,dum,1,work(iwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in vt, storing result in a
                          ! (workspace: need m*m)
                          call la_${ri}$gemm('N','N',m,n,m,one,work(iu),ldwrku,vt,ldvt, &
                                    zero,a,lda)
                          ! copy right singular vectors of a from a to vt
                          call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                          ! copy left singular vectors of a from work(ir) to a
                          call la_${ri}$lacpy('F',m,m,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need m+n, prefer m+n*nb)
#:else
                          ! (workspace: need m + n, prefer m + n*nb)
#:endif
                          call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                          ! bidiagonalize l in a
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in a by q
                          ! in vt
#:if rk == "sp"
                          ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                          ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                          call la_${ri}$ormbr('P','L','T',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in a
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,a,lda,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in a and computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,work(ie),vt,ldvt,a,lda, &
                                    dum,1,work(iwork),info)
                       end if
                    else if (wntuas) then
                       ! path 9t(n much larger than m, jobu='s' or 'a',
                               ! jobvt='a')
                       ! n right singular vectors to be computed in vt and
                       ! m left singular vectors to be computed in u
                       if (lwork >= m*m + max(n + m,4*m,bdspac)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(iu) is lda by m
                             ldwrku = lda
                          else
                             ! work(iu) is m by m
                             ldwrku = m
                          end if
                          itau = iu + ldwrku*m
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need m*m+2*m, prefer m*m+m+m*nb)
#:else
                          ! (workspace: need m*m + 2*m, prefer m*m + m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need m*m+m+n, prefer m*m+m+n*nb)
#:else
                          ! (workspace: need m*m + m + n, prefer m*m + m + n*nb)
#:endif
                          call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(iu + ldwrku),ldwrku &
                                    )
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to u
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+2*m*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,work(ie),work(itauq &
                                    ),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,u,ldu)
                          ! generate right bidiagonalizing vectors in work(iu)
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+(m-1)*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + (m-1)*nb)
#:endif
                          call la_${ri}$orgbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
#:if rk == "sp"
                          ! (workspace: need m*m+4*m, prefer m*m+3*m+m*nb)
#:else
                          ! (workspace: need m*m + 4*m, prefer m*m + 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in u and computing right
                          ! singular vectors of l in work(iu)
#:if rk == "sp"
                          ! (workspace: need m*m+bdspac)
#:else
                          ! (workspace: need m*m + bdspac)
#:endif
                          call la_${ri}$bdsqr('U',m,m,m,0,s,work(ie),work(iu),ldwrku, &
                                    u,ldu,dum,1,work(iwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in vt, storing result in a
                          ! (workspace: need m*m)
                          call la_${ri}$gemm('N','N',m,n,m,one,work(iu),ldwrku,vt,ldvt, &
                                    zero,a,lda)
                          ! copy right singular vectors of a from a to vt
                          call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
#:if rk == "sp"
                          ! (workspace: need 2*m, prefer m+m*nb)
#:else
                          ! (workspace: need 2*m, prefer m + m*nb)
#:endif
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
#:if rk == "sp"
                          ! (workspace: need m+n, prefer m+n*nb)
#:else
                          ! (workspace: need m + n, prefer m + n*nb)
#:endif
                          call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to u, zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                          call la_${ri}$laset('U',m - 1,m - 1,zero,zero,u(1,2),ldu)
                          ie = itau
                          itauq = ie + m
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in u
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+2*m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + 2*m*nb)
#:endif
                          call la_${ri}$gebrd(m,m,u,ldu,s,work(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in u by q
                          ! in vt
#:if rk == "sp"
                          ! (workspace: need 3*m+n, prefer 3*m+n*nb)
#:else
                          ! (workspace: need 3*m + n, prefer 3*m + n*nb)
#:endif
                          call la_${ri}$ormbr('P','L','T',m,n,m,u,ldu,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
#:if rk == "sp"
                          ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                          ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                          call la_${ri}$orgbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          iwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (workspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,work(ie),vt,ldvt,u,ldu, &
                                    dum,1,work(iwork),info)
                       end if
                    end if
                 end if
              else
                 ! n < mnthr
                 ! path 10t(n greater than m, but not much larger)
                 ! reduce to bidiagonal form without lq decomposition
                 ie = 1
                 itauq = ie + m
                 itaup = itauq + m
                 iwork = itaup + m
                 ! bidiagonalize a
#:if rk == "sp"
                 ! (workspace: need 3*m+n, prefer 3*m+(m+n)*nb)
#:else
                 ! (workspace: need 3*m + n, prefer 3*m + (m + n)*nb)
#:endif
                 call la_${ri}$gebrd(m,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                           work(iwork),lwork - iwork + 1,ierr)
                 if (wntuas) then
                    ! if left singular vectors desired in u, copy result to u
                    ! and generate left bidiagonalizing vectors in u
#:if rk == "sp"
                    ! (workspace: need 4*m-1, prefer 3*m+(m-1)*nb)
#:else
                    ! (workspace: need 4*m-1, prefer 3*m + (m-1)*nb)
#:endif
                    call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                    call la_${ri}$orgbr('Q',m,m,n,u,ldu,work(itauq),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 if (wntvas) then
                    ! if right singular vectors desired in vt, copy result to
                    ! vt and generate right bidiagonalizing vectors in vt
#:if rk == "sp"
                    ! (workspace: need 3*m+nrvt, prefer 3*m+nrvt*nb)
#:else
                    ! (workspace: need 3*m + nrvt, prefer 3*m + nrvt*nb)
#:endif
                    call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                    if (wntva) nrvt = n
                    if (wntvs) nrvt = m
                    call la_${ri}$orgbr('P',nrvt,n,m,vt,ldvt,work(itaup),work(iwork), &
                              lwork - iwork + 1,ierr)
                 end if
                 if (wntuo) then
                    ! if left singular vectors desired in a, generate left
                    ! bidiagonalizing vectors in a
#:if rk == "sp"
                    ! (workspace: need 4*m-1, prefer 3*m+(m-1)*nb)
#:else
                    ! (workspace: need 4*m-1, prefer 3*m + (m-1)*nb)
#:endif
                    call la_${ri}$orgbr('Q',m,m,n,a,lda,work(itauq),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 if (wntvo) then
                    ! if right singular vectors desired in a, generate right
                    ! bidiagonalizing vectors in a
#:if rk == "sp"
                    ! (workspace: need 4*m, prefer 3*m+m*nb)
#:else
                    ! (workspace: need 4*m, prefer 3*m + m*nb)
#:endif
                    call la_${ri}$orgbr('P',m,n,m,a,lda,work(itaup),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 iwork = ie + m
                 if (wntuas .or. wntuo) nru = m
                 if (wntun) nru = 0
                 if (wntvas .or. wntvo) ncvt = n
                 if (wntvn) ncvt = 0
                 if ((.not. wntuo) .and. (.not. wntvo)) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in vt
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('L',m,ncvt,nru,0,s,work(ie),vt,ldvt,u,ldu,dum, &
                               1,work(iwork),info)
                 else if ((.not. wntuo) .and. wntvo) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in a
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('L',m,ncvt,nru,0,s,work(ie),a,lda,u,ldu,dum, &
                              1,work(iwork),info)
                 else
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in a and computing right singular
                    ! vectors in vt
                    ! (workspace: need bdspac)
                    call la_${ri}$bdsqr('L',m,ncvt,nru,0,s,work(ie),vt,ldvt,a,lda,dum, &
                               1,work(iwork),info)
                 end if
              end if
           end if
           ! if la_${ri}$bdsqr failed to converge, copy unconverged superdiagonals
           ! to work( 2:minmn )
           if (info /= 0) then
              if (ie > 2) then
                 do i = 1,minmn - 1
                    work(i + 1) = work(i + ie - 1)
                 end do
              end if
              if (ie < 2) then
                 do i = minmn - 1,1,-1
                    work(i + 1) = work(i + ie - 1)
                 end do
              end if
           end if
           ! undo scaling if necessary
           if (iscl == 1) then
              if (anrm > bignum) call la_${ri}$lascl('G',0,0,bignum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (info /= 0 .and. anrm > bignum) call la_${ri}$lascl('G',0,0,bignum,anrm,minmn - 1, &
                         1,work(2),minmn,ierr)
              if (anrm < smlnum) call la_${ri}$lascl('G',0,0,smlnum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (info /= 0 .and. anrm < smlnum) call la_${ri}$lascl('G',0,0,smlnum,anrm,minmn - 1, &
                         1,work(2),minmn,ierr)
           end if
           ! return optimal workspace in work(1)
           work(1) = maxwrk
           return
     end subroutine la_${ri}$gesvd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GESVDQ: computes the singular value decomposition (SVD) of a real
     !> M-by-N matrix A, where M >= N. The SVD of A is written as
     !> [++]   [xx]   [x0]   [xx]
     !> A = U * SIGMA * V^*,  [++] = [xx] * [ox] * [xx]
     !> [++]   [xx]
     !> where SIGMA is an N-by-N diagonal matrix, U is an M-by-N orthonormal
     !> matrix, and V is an N-by-N orthogonal matrix. The diagonal elements
     !> of SIGMA are the singular values of A. The columns of U and V are the
     !> left and the right singular vectors of A, respectively.

     subroutine la_${ri}$gesvdq(joba,jobp,jobr,jobu,jobv,m,n,a,lda,s,u,ldu,v,ldv, &
               numrank,iwork,liwork,work,lwork,rwork,lrwork,info)
        use la_constants_${rk}$
           ! Scalar Arguments
           character,intent(in) :: joba,jobp,jobr,jobu,jobv
           integer(ilp),intent(in) :: m,n,lda,ldu,ldv,liwork,lrwork
           integer(ilp),intent(out) :: numrank,info
           integer(ilp),intent(inout) :: lwork
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: u(ldu,*),v(ldv,*),work(*)
           real(${rk}$),intent(out) :: s(*),rwork(*)
           integer(ilp),intent(out) :: iwork(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: ierr,iwoff,nr,n1,optratio,p,q
           integer(ilp) :: lwcon,lwqp3,lwrk_${ri}$gelqf,lwrk_${ri}$gesvd,lwrk_${ri}$gesvd2,lwrk_${ri}$geqp3, &
           lwrk_${ri}$geqrf,lwrk_${ri}$ormlq,lwrk_${ri}$ormqr,lwrk_${ri}$ormqr2,lwlqf,lwqrf,lwsvd,lwsvd2, &
#:if rk == "sp"
                     lworq,lworq2,lwunlq,minwrk,minwrk2,optwrk,optwrk2,iminwrk,rminwrk
#:else
                     lworq,lworq2,lworlq,minwrk,minwrk2,optwrk,optwrk2,iminwrk,rminwrk
#:endif
           logical(lk) :: accla,acclm,acclh,ascaled,conda,dntwu,dntwv,lquery,lsvc0,lsvec, &
                      rowprm,rsvec,rtrans,wntua,wntuf,wntur,wntus,wntva,wntvr
           real(${rk}$) :: big,epsln,rtmp,sconda,sfmin
           ! Local Arrays
           real(${rk}$) :: rdummy(1)
           ! Intrinsic Functions
           intrinsic :: abs,max,min,real,sqrt
#:if rk == "sp"
           ! Executable Statements
#:endif
           ! test the input arguments
           wntus = la_lsame(jobu,'S') .or. la_lsame(jobu,'U')
           wntur = la_lsame(jobu,'R')
           wntua = la_lsame(jobu,'A')
           wntuf = la_lsame(jobu,'F')
           lsvc0 = wntus .or. wntur .or. wntua
           lsvec = lsvc0 .or. wntuf
           dntwu = la_lsame(jobu,'N')
           wntvr = la_lsame(jobv,'R')
           wntva = la_lsame(jobv,'A') .or. la_lsame(jobv,'V')
           rsvec = wntvr .or. wntva
           dntwv = la_lsame(jobv,'N')
           accla = la_lsame(joba,'A')
           acclm = la_lsame(joba,'M')
           conda = la_lsame(joba,'E')
           acclh = la_lsame(joba,'H') .or. conda
           rowprm = la_lsame(jobp,'P')
           rtrans = la_lsame(jobr,'T')
           if (rowprm) then
              if (conda) then
                 iminwrk = max(1,n + m - 1 + n)
              else
                 iminwrk = max(1,n + m - 1)
              end if
              rminwrk = max(2,m)
           else
              if (conda) then
                 iminwrk = max(1,n + n)
              else
                 iminwrk = max(1,n)
              end if
              rminwrk = 2
           end if
           lquery = (liwork == -1 .or. lwork == -1 .or. lrwork == -1)
           info = 0
           if (.not. (accla .or. acclm .or. acclh)) then
              info = -1
           else if (.not. (rowprm .or. la_lsame(jobp,'N'))) then
               info = -2
           else if (.not. (rtrans .or. la_lsame(jobr,'N'))) then
               info = -3
           else if (.not. (lsvec .or. dntwu)) then
              info = -4
           else if (wntur .and. wntva) then
              info = -5
           else if (.not. (rsvec .or. dntwv)) then
              info = -5
           else if (m < 0) then
              info = -6
           else if ((n < 0) .or. (n > m)) then
              info = -7
           else if (lda < max(1,m)) then
              info = -9
           else if (ldu < 1 .or. (lsvc0 .and. ldu < m) .or. (wntuf .and. ldu < n)) then
              info = -12
           else if (ldv < 1 .or. (rsvec .and. ldv < n) .or. (conda .and. ldv < n)) then
              info = -14
           else if (liwork < iminwrk .and. .not. lquery) then
              info = -17
           end if
           if (info == 0) then
              ! Compute The Minimal And The Optimal Workspace Lengths
              ! [[the expressions for computing the minimal and the optimal
              ! values of lwork are written with a lot of redundancy and
              ! can be simplified. however, this detailed form is easier for
              ! maintenance and modifications of the code.]]
              ! Minimal Workspace Length For la_${ri}$geqp3 Of An M X N Matrix
              lwqp3 = 3*n + 1
              ! Minimal Workspace Length For la_${ri}$ormqr To Build Left Singular Vectors
              if (wntus .or. wntur) then
                  lworq = max(n,1)
              else if (wntua) then
                  lworq = max(m,1)
              end if
              ! Minimal Workspace Length For la_${ri}$pocon Of An N X N Matrix
              lwcon = 3*n
              ! la_${ri}$gesvd Of An N X N Matrix
              lwsvd = max(5*n,1)
              if (lquery) then
                  call la_${ri}$geqp3(m,n,a,lda,iwork,rdummy,rdummy,-1,ierr)
                  lwrk_${ri}$geqp3 = int(rdummy(1),KIND=ilp)
                  if (wntus .or. wntur) then
                      call la_${ri}$ormqr('L','N',m,n,n,a,lda,rdummy,u,ldu,rdummy,-1, &
                                ierr)
                      lwrk_${ri}$ormqr = int(rdummy(1),KIND=ilp)
                  else if (wntua) then
                      call la_${ri}$ormqr('L','N',m,m,n,a,lda,rdummy,u,ldu,rdummy,-1, &
                                ierr)
                      lwrk_${ri}$ormqr = int(rdummy(1),KIND=ilp)
                  else
                      lwrk_${ri}$ormqr = 0
                  end if
              end if
              minwrk = 2
              optwrk = 2
              if (.not. (lsvec .or. rsvec)) then
                  ! Minimal And Optimal Sizes Of The Workspace If
                  ! only the singular values are requested
                  if (conda) then
                     minwrk = max(n + lwqp3,lwcon,lwsvd)
                  else
                     minwrk = max(n + lwqp3,lwsvd)
                  end if
                  if (lquery) then
                      call la_${ri}$gesvd('N','N',n,n,a,lda,s,u,ldu,v,ldv,rdummy,-1, &
                                ierr)
                      lwrk_${ri}$gesvd = int(rdummy(1),KIND=ilp)
                      if (conda) then
                         optwrk = max(n + lwrk_${ri}$geqp3,n + lwcon,lwrk_${ri}$gesvd)
                      else
                         optwrk = max(n + lwrk_${ri}$geqp3,lwrk_${ri}$gesvd)
                      end if
                  end if
              else if (lsvec .and. (.not. rsvec)) then
                  ! Minimal And Optimal Sizes Of The Workspace If The
                  ! singular values and the left singular vectors are requested
                  if (conda) then
                      minwrk = n + max(lwqp3,lwcon,lwsvd,lworq)
                  else
                      minwrk = n + max(lwqp3,lwsvd,lworq)
                  end if
                  if (lquery) then
                     if (rtrans) then
                        call la_${ri}$gesvd('N','O',n,n,a,lda,s,u,ldu,v,ldv,rdummy,-1, &
                                  ierr)
                     else
                        call la_${ri}$gesvd('O','N',n,n,a,lda,s,u,ldu,v,ldv,rdummy,-1, &
                                  ierr)
                     end if
                     lwrk_${ri}$gesvd = int(rdummy(1),KIND=ilp)
                     if (conda) then
                         optwrk = n + max(lwrk_${ri}$geqp3,lwcon,lwrk_${ri}$gesvd,lwrk_${ri}$ormqr)
                     else
                         optwrk = n + max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd,lwrk_${ri}$ormqr)
                     end if
                  end if
              else if (rsvec .and. (.not. lsvec)) then
                  ! Minimal And Optimal Sizes Of The Workspace If The
                  ! singular values and the right singular vectors are requested
                  if (conda) then
                      minwrk = n + max(lwqp3,lwcon,lwsvd)
                  else
                      minwrk = n + max(lwqp3,lwsvd)
                  end if
                  if (lquery) then
                      if (rtrans) then
                          call la_${ri}$gesvd('O','N',n,n,a,lda,s,u,ldu,v,ldv,rdummy,- &
                                    1,ierr)
                      else
                          call la_${ri}$gesvd('N','O',n,n,a,lda,s,u,ldu,v,ldv,rdummy,- &
                                    1,ierr)
                      end if
                      lwrk_${ri}$gesvd = int(rdummy(1),KIND=ilp)
                      if (conda) then
                          optwrk = n + max(lwrk_${ri}$geqp3,lwcon,lwrk_${ri}$gesvd)
                      else
                          optwrk = n + max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd)
                      end if
                  end if
              else
                  ! Minimal And Optimal Sizes Of The Workspace If The
                  ! full svd is requested
                  if (rtrans) then
                      minwrk = max(lwqp3,lwsvd,lworq)
                      if (conda) minwrk = max(minwrk,lwcon)
                      minwrk = minwrk + n
                      if (wntva) then
                         ! .. minimal workspace length for n x n/2 la_${ri}$geqrf
                         lwqrf = max(n/2,1)
                         ! .. minimal workspace length for n/2 x n/2 la_${ri}$gesvd
                         lwsvd2 = max(5*(n/2),1)
                         lworq2 = max(n,1)
                         minwrk2 = max(lwqp3,n/2 + lwqrf,n/2 + lwsvd2,n/2 + lworq2,lworq)
                         if (conda) minwrk2 = max(minwrk2,lwcon)
                         minwrk2 = n + minwrk2
                         minwrk = max(minwrk,minwrk2)
                      end if
                  else
                      minwrk = max(lwqp3,lwsvd,lworq)
                      if (conda) minwrk = max(minwrk,lwcon)
                      minwrk = minwrk + n
                      if (wntva) then
                         ! .. minimal workspace length for n/2 x n la_${ri}$gelqf
                         lwlqf = max(n/2,1)
                         lwsvd2 = max(5*(n/2),1)
#:if rk == "sp"
                         lwunlq = max(n,1)
                         minwrk2 = max(lwqp3,n/2 + lwlqf,n/2 + lwsvd2,n/2 + lwunlq,lworq)
#:else
                         lworlq = max(n,1)
                         minwrk2 = max(lwqp3,n/2 + lwlqf,n/2 + lwsvd2,n/2 + lworlq,lworq)
#:endif
                         if (conda) minwrk2 = max(minwrk2,lwcon)
                         minwrk2 = n + minwrk2
                         minwrk = max(minwrk,minwrk2)
                      end if
                  end if
                  if (lquery) then
                     if (rtrans) then
                        call la_${ri}$gesvd('O','A',n,n,a,lda,s,u,ldu,v,ldv,rdummy,-1, &
                                  ierr)
                        lwrk_${ri}$gesvd = int(rdummy(1),KIND=ilp)
                        optwrk = max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd,lwrk_${ri}$ormqr)
                        if (conda) optwrk = max(optwrk,lwcon)
                        optwrk = n + optwrk
                        if (wntva) then
                            call la_${ri}$geqrf(n,n/2,u,ldu,rdummy,rdummy,-1,ierr)
                            lwrk_${ri}$geqrf = int(rdummy(1),KIND=ilp)
                            call la_${ri}$gesvd('S','O',n/2,n/2,v,ldv,s,u,ldu,v,ldv,rdummy, &
                                       -1,ierr)
                            lwrk_${ri}$gesvd2 = int(rdummy(1),KIND=ilp)
                            call la_${ri}$ormqr('R','C',n,n,n/2,u,ldu,rdummy,v,ldv, &
                                      rdummy,-1,ierr)
                            lwrk_${ri}$ormqr2 = int(rdummy(1),KIND=ilp)
                            optwrk2 = max(lwrk_${ri}$geqp3,n/2 + lwrk_${ri}$geqrf,n/2 + lwrk_${ri}$gesvd2,n/2 + &
                                      lwrk_${ri}$ormqr2)
                            if (conda) optwrk2 = max(optwrk2,lwcon)
                            optwrk2 = n + optwrk2
                            optwrk = max(optwrk,optwrk2)
                        end if
                     else
                        call la_${ri}$gesvd('S','O',n,n,a,lda,s,u,ldu,v,ldv,rdummy,-1, &
                                  ierr)
                        lwrk_${ri}$gesvd = int(rdummy(1),KIND=ilp)
                        optwrk = max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd,lwrk_${ri}$ormqr)
                        if (conda) optwrk = max(optwrk,lwcon)
                        optwrk = n + optwrk
                        if (wntva) then
                           call la_${ri}$gelqf(n/2,n,u,ldu,rdummy,rdummy,-1,ierr)
                           lwrk_${ri}$gelqf = int(rdummy(1),KIND=ilp)
                           call la_${ri}$gesvd('S','O',n/2,n/2,v,ldv,s,u,ldu,v,ldv,rdummy, &
                                      -1,ierr)
                           lwrk_${ri}$gesvd2 = int(rdummy(1),KIND=ilp)
                           call la_${ri}$ormlq('R','N',n,n,n/2,u,ldu,rdummy,v,ldv,rdummy, &
                                     -1,ierr)
                           lwrk_${ri}$ormlq = int(rdummy(1),KIND=ilp)
                           optwrk2 = max(lwrk_${ri}$geqp3,n/2 + lwrk_${ri}$gelqf,n/2 + lwrk_${ri}$gesvd2,n/2 + &
                                     lwrk_${ri}$ormlq)
                            if (conda) optwrk2 = max(optwrk2,lwcon)
                            optwrk2 = n + optwrk2
                            optwrk = max(optwrk,optwrk2)
                        end if
                     end if
                  end if
              end if
              minwrk = max(2,minwrk)
              optwrk = max(2,optwrk)
              if (lwork < minwrk .and. (.not. lquery)) info = -19
           end if
           if (info == 0 .and. lrwork < rminwrk .and. .not. lquery) then
              info = -21
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESVDQ',-info)
              return
           else if (lquery) then
           ! return optimal workspace
               iwork(1) = iminwrk
               work(1) = optwrk
               work(2) = minwrk
               rwork(1) = rminwrk
               return
           end if
           ! quick return if the matrix is void.
           if ((m == 0) .or. (n == 0)) then
           ! All Output Is Void
              return
           end if
           big = la_${ri}$lamch('O')
           ascaled = .false.
           iwoff = 1
           if (rowprm) then
                 iwoff = m
                 ! Reordering The Rows In Decreasing Sequence In The
                 ! ell-infinity norm - this enhances numerical robustness in
                 ! the case of differently scaled rows.
                 do p = 1,m
#:if rk == "sp"
                     ! rwork(p) = abs( a(p,la_i${ci}$amax(n,a(p,1),lda)) )
#:else
                     ! rwork(p) = abs( a(p,la_i${cil}$amax(n,a(p,1),lda)) )
#:endif
                     ! [[la_${ri}$lange will return nan if an entry of the p-th row is nan]]
                     rwork(p) = la_${ri}$lange('M',1,n,a(p,1),lda,rdummy)
                     ! .. check for nan's and inf's
                     if ((rwork(p) /= rwork(p)) .or. ((rwork(p)*zero) /= zero)) then
                         info = -8
                         call la_xerbla('${ri.upper()}$GESVDQ',-info)
                         return
                     end if
                 end do
                 do p = 1,m - 1
                 q = la_i${ri}$amax(m - p + 1,rwork(p),1) + p - 1
                 iwork(n + p) = q
                 if (p /= q) then
                    rtmp = rwork(p)
                    rwork(p) = rwork(q)
                    rwork(q) = rtmp
                 end if
                 end do
                 if (rwork(1) == zero) then
                    ! quick return: a is the m x n zero matrix.
                    numrank = 0
                    call la_${ri}$laset('G',n,1,zero,zero,s,n)
                    if (wntus) call la_${ri}$laset('G',m,n,zero,one,u,ldu)
                    if (wntua) call la_${ri}$laset('G',m,m,zero,one,u,ldu)
                    if (wntva) call la_${ri}$laset('G',n,n,zero,one,v,ldv)
                    if (wntuf) then
                        call la_${ri}$laset('G',n,1,zero,zero,work,n)
                        call la_${ri}$laset('G',m,n,zero,one,u,ldu)
                    end if
                    do p = 1,n
                        iwork(p) = p
                    end do
                    if (rowprm) then
                        do p = n + 1,n + m - 1
                            iwork(p) = p - n
                        end do
                    end if
                    if (conda) rwork(1) = -1
                    rwork(2) = -1
                    return
                 end if
                 if (rwork(1) > big/sqrt(real(m,KIND=${rk}$))) then
                     ! .. to prevent overflow in the qr factorization, scale the
                     ! matrix by 1/sqrt(m) if too large entry detected
                     call la_${ri}$lascl('G',0,0,sqrt(real(m,KIND=${rk}$)),one,m,n,a,lda,ierr)

                     ascaled = .true.
                 end if
                 call la_${ri}$laswp(n,a,lda,1,m - 1,iwork(n + 1),1)
           end if
          ! .. at this stage, preemptive scaling is done only to avoid column
          ! norms overflows during the qr factorization. the svd procedure should
          ! have its own scaling to save the singular values from overflows and
          ! underflows. that depends on the svd procedure.
           if (.not. rowprm) then
               rtmp = la_${ri}$lange('M',m,n,a,lda,rdummy)
               if ((rtmp /= rtmp) .or. ((rtmp*zero) /= zero)) then
                    info = -8
                    call la_xerbla('${ri.upper()}$GESVDQ',-info)
                    return
               end if
               if (rtmp > big/sqrt(real(m,KIND=${rk}$))) then
                   ! .. to prevent overflow in the qr factorization, scale the
                   ! matrix by 1/sqrt(m) if too large entry detected
                   call la_${ri}$lascl('G',0,0,sqrt(real(m,KIND=${rk}$)),one,m,n,a,lda,ierr)

                   ascaled = .true.
               end if
           end if
           ! Qr Factorization With Column Pivoting
           ! a * p = q * [ r ]
                       ! [ 0 ]
           do p = 1,n
              ! All Columns Are Free Columns
              iwork(p) = 0
           end do
           call la_${ri}$geqp3(m,n,a,lda,iwork,work,work(n + 1),lwork - n,ierr)
          ! if the user requested accuracy level allows truncation in the
          ! computed upper triangular factor, the matrix r is examined and,
          ! if possible, replaced with its leading upper trapezoidal part.
           epsln = la_${ri}$lamch('E')
           sfmin = la_${ri}$lamch('S')
           ! small = sfmin / epsln
           nr = n
           if (accla) then
              ! standard absolute error bound suffices. all sigma_i with
              ! sigma_i < n*eps*||a||_f are flushed to zero. this is an
              ! aggressive enforcement of lower numerical rank by introducing a
              ! backward error of the order of n*eps*||a||_f.
              nr = 1
              rtmp = sqrt(real(n,KIND=${rk}$))*epsln
              do p = 2,n
                 if (abs(a(p,p)) < (rtmp*abs(a(1,1)))) go to 3002
                    nr = nr + 1
              end do
              3002 continue
           elseif (acclm) then
              ! .. similarly as above, only slightly more gentle (less aggressive).
              ! sudden drop on the diagonal of r is used as the criterion for being
              ! close-to-rank-deficient. the threshold is set to epsln=la_${ri}$lamch('e').
              ! [[this can be made more flexible by replacing this hard-coded value
              ! with a user specified threshold.]] also, the values that underflow
              ! will be truncated.
              nr = 1
              do p = 2,n
                 if ((abs(a(p,p)) < (epsln*abs(a(p - 1,p - 1)))) .or. (abs(a(p,p)) < sfmin)) go &
                           to 3402
                 nr = nr + 1
              end do
              3402 continue
           else
              ! Rrqr Not Authorized To Determine Numerical Rank Except In The
              ! obvious case of zero pivots.
              ! .. inspect r for exact zeros on the diagonal;
              ! r(i,i)=0 => r(i:n,i:n)=0.
              nr = 1
              do p = 2,n
                 if (abs(a(p,p)) == zero) go to 3502
                 nr = nr + 1
              end do
              3502 continue
              if (conda) then
                 ! estimate the scaled condition number of a. use the fact that it is
                 ! the same as the scaled condition number of r.
                    ! V Is Used As Workspace
                    call la_${ri}$lacpy('U',n,n,a,lda,v,ldv)
                    ! only the leading nr x nr submatrix of the triangular factor
                    ! is considered. only if nr=n will this give a reliable error
                    ! bound. however, even for nr < n, this can be used on an
                    ! expert level and obtain useful information in the sense of
                    ! perturbation theory.
                    do p = 1,nr
                       rtmp = la_${ri}$nrm2(p,v(1,p),1)
                       call la_${ri}$scal(p,one/rtmp,v(1,p),1)
                    end do
                    if (.not. (lsvec .or. rsvec)) then
                        call la_${ri}$pocon('U',nr,v,ldv,one,rtmp,work,iwork(n + iwoff),ierr &
                                  )
                    else
                        call la_${ri}$pocon('U',nr,v,ldv,one,rtmp,work(n + 1),iwork(n + iwoff), &
                                  ierr)
                    end if
                    sconda = one/sqrt(rtmp)
                 ! for nr=n, sconda is an estimate of sqrt(||(r^* * r)^(-1)||_1),
                 ! n^(-1/4) * sconda <= ||r^(-1)||_2 <= n^(1/4) * sconda
                 ! see the reference [1] for more details.
              end if
           end if
           if (wntur) then
               n1 = nr
           else if (wntus .or. wntuf) then
               n1 = n
           else if (wntua) then
               n1 = m
           end if
           if (.not. (rsvec .or. lsvec)) then
      ! .......................................................................
              ! Only The Singular Values Are Requested
      ! .......................................................................
              if (rtrans) then
               ! .. compute the singular values of r**t = [a](1:nr,1:n)**t
                 ! .. set the lower triangle of [a] to [a](1:nr,1:n)**t and
                 ! the upper triangle of [a] to zero.
                 do p = 1,min(n,nr)
                    do q = p + 1,n
                       a(q,p) = a(p,q)
                       if (q <= nr) a(p,q) = zero
                    end do
                 end do
                 call la_${ri}$gesvd('N','N',n,nr,a,lda,s,u,ldu,v,ldv,work,lwork,info &
                           )
              else
                 ! .. compute the singular values of r = [a](1:nr,1:n)
                 if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,a(2,1),lda)
                 call la_${ri}$gesvd('N','N',nr,n,a,lda,s,u,ldu,v,ldv,work,lwork,info &
                           )
              end if
           else if (lsvec .and. (.not. rsvec)) then
      ! .......................................................................
             ! The Singular Values And The Left Singular Vectors Requested
      ! .......................................................................""""""""
              if (rtrans) then
                  ! .. apply la_${ri}$gesvd to r**t
                  ! .. copy r**t into [u] and overwrite [u] with the right singular
                  ! vectors of r
                 do p = 1,nr
                    do q = p,n
                       u(q,p) = a(p,q)
                    end do
                 end do
                 if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,u(1,2),ldu)
                 ! .. the left singular vectors not computed, the nr right singular
                 ! vectors overwrite [u](1:nr,1:nr) as transposed. these
                 ! will be pre-multiplied by q to build the left singular vectors of a.
                    call la_${ri}$gesvd('N','O',n,nr,u,ldu,s,u,ldu,u,ldu,work(n + 1), &
                              lwork - n,info)
                    do p = 1,nr
                        do q = p + 1,nr
                           rtmp = u(q,p)
                           u(q,p) = u(p,q)
                           u(p,q) = rtmp
                        end do
                    end do
              else
                  ! Apply la_${ri}$gesvd To R
                  ! .. copy r into [u] and overwrite [u] with the left singular vectors
                  call la_${ri}$lacpy('U',nr,n,a,lda,u,ldu)
                  if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,u(2,1),ldu)

                  ! .. the right singular vectors not computed, the nr left singular
                  ! vectors overwrite [u](1:nr,1:nr)
                     call la_${ri}$gesvd('O','N',nr,n,u,ldu,s,u,ldu,v,ldv,work(n + 1), &
                               lwork - n,info)
                     ! .. now [u](1:nr,1:nr) contains the nr left singular vectors of
                     ! r. these will be pre-multiplied by q to build the left singular
                     ! vectors of a.
              end if
                 ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x nr) or (m x n) or (m x m).
              if ((nr < m) .and. (.not. wntuf)) then
                  call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                  if (nr < n1) then
                     call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                     call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                  end if
              end if
                 ! the q matrix from the first qrf is built into the left singular
                 ! vectors matrix u.
              if (.not. wntuf) call la_${ri}$ormqr('L','N',m,n1,n,a,lda,work,u,ldu,work( &
                        n + 1),lwork - n,ierr)
              if (rowprm .and. .not. wntuf) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(n + 1),- &
                        1)
           else if (rsvec .and. (.not. lsvec)) then
      ! .......................................................................
             ! The Singular Values And The Right Singular Vectors Requested
      ! .......................................................................
               if (rtrans) then
                  ! .. apply la_${ri}$gesvd to r**t
                  ! .. copy r**t into v and overwrite v with the left singular vectors
                 do p = 1,nr
                    do q = p,n
                       v(q,p) = (a(p,q))
                    end do
                 end do
                 if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 ! .. the left singular vectors of r**t overwrite v, the right singular
                 ! vectors not computed
                 if (wntvr .or. (nr == n)) then
                    call la_${ri}$gesvd('O','N',n,nr,v,ldv,s,u,ldu,u,ldu,work(n + 1), &
                              lwork - n,info)
                    do p = 1,nr
                        do q = p + 1,nr
                           rtmp = v(q,p)
                           v(q,p) = v(p,q)
                           v(p,q) = rtmp
                        end do
                    end do
                    if (nr < n) then
                        do p = 1,nr
                           do q = nr + 1,n
                               v(p,q) = v(q,p)
                           end do
                        end do
                    end if
                    call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                 else
                     ! .. need all n right singular vectors and nr < n
                     ! [!] this is simple implementation that augments [v](1:n,1:nr)
                     ! by padding a zero block. in the case nr << n, a more efficient
                     ! way is to first use the qr factorization. for more details
                     ! how to implement this, see the " full svd " branch.
                     call la_${ri}$laset('G',n,n - nr,zero,zero,v(1,nr + 1),ldv)
                     call la_${ri}$gesvd('O','N',n,n,v,ldv,s,u,ldu,u,ldu,work(n + 1), &
                               lwork - n,info)
                     do p = 1,n
                        do q = p + 1,n
                           rtmp = v(q,p)
                           v(q,p) = v(p,q)
                           v(p,q) = rtmp
                        end do
                     end do
                     call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                 end if
               else
                  ! Aply la_${ri}$gesvd To R
                  ! Copy R Into V And Overwrite V With The Right Singular Vectors
                  call la_${ri}$lacpy('U',nr,n,a,lda,v,ldv)
                  if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,v(2,1),ldv)

                  ! .. the right singular vectors overwrite v, the nr left singular
                  ! vectors stored in u(1:nr,1:nr)
                  if (wntvr .or. (nr == n)) then
                     call la_${ri}$gesvd('N','O',nr,n,v,ldv,s,u,ldu,v,ldv,work(n + 1), &
                               lwork - n,info)
                     call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                     ! .. now [v](1:nr,1:n) contains v(1:n,1:nr)**t
                  else
                     ! .. need all n right singular vectors and nr < n
                     ! [!] this is simple implementation that augments [v](1:nr,1:n)
                     ! by padding a zero block. in the case nr << n, a more efficient
                     ! way is to first use the lq factorization. for more details
                     ! how to implement this, see the " full svd " branch.
                      call la_${ri}$laset('G',n - nr,n,zero,zero,v(nr + 1,1),ldv)
                      call la_${ri}$gesvd('N','O',n,n,v,ldv,s,u,ldu,v,ldv,work(n + 1), &
                                lwork - n,info)
                      call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                  end if
                  ! .. now [v] contains the transposed matrix of the right singular
                  ! vectors of a.
               end if
           else
      ! .......................................................................
             ! Full Svd Requested
      ! .......................................................................
              if (rtrans) then
                  ! .. apply la_${ri}$gesvd to r**t [[this option is left for r
                 if (wntvr .or. (nr == n)) then
                  ! .. copy r**t into [v] and overwrite [v] with the left singular
                  ! vectors of r**t
                 do p = 1,nr
                    do q = p,n
                       v(q,p) = a(p,q)
                    end do
                 end do
                 if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 ! .. the left singular vectors of r**t overwrite [v], the nr right
                 ! singular vectors of r**t stored in [u](1:nr,1:nr) as transposed
                    call la_${ri}$gesvd('O','A',n,nr,v,ldv,s,v,ldv,u,ldu,work(n + 1), &
                              lwork - n,info)
                    ! Assemble V
                    do p = 1,nr
                       do q = p + 1,nr
                          rtmp = v(q,p)
                          v(q,p) = v(p,q)
                          v(p,q) = rtmp
                       end do
                    end do
                    if (nr < n) then
                        do p = 1,nr
                           do q = nr + 1,n
                              v(p,q) = v(q,p)
                           end do
                        end do
                    end if
                    call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                     do p = 1,nr
                        do q = p + 1,nr
                           rtmp = u(q,p)
                           u(q,p) = u(p,q)
                           u(p,q) = rtmp
                        end do
                     end do
                     if ((nr < m) .and. .not. (wntuf)) then
                       call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                       if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                       end if
                    end if
                 else
                     ! .. need all n right singular vectors and nr < n
                  ! .. copy r**t into [v] and overwrite [v] with the left singular
                  ! vectors of r**t
                     ! [[the optimal ratio n/nr for using qrf instead of padding
                       ! with zeros. here hard coded to 2; it must be at least
                       ! two due to work space constraints.]]
                     ! optratio = la_ilaenv(6, '${ri}$gesvd', 's' // 'o', nr,n,0,0)
                     ! optratio = max( optratio, 2 )
                     optratio = 2
                     if (optratio*nr > n) then
                        do p = 1,nr
                           do q = p,n
                              v(q,p) = a(p,q)
                           end do
                        end do
                        if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)

                        call la_${ri}$laset('A',n,n - nr,zero,zero,v(1,nr + 1),ldv)
                        call la_${ri}$gesvd('O','A',n,n,v,ldv,s,v,ldv,u,ldu,work(n + 1), &
                                  lwork - n,info)
                        do p = 1,n
                           do q = p + 1,n
                              rtmp = v(q,p)
                              v(q,p) = v(p,q)
                              v(p,q) = rtmp
                           end do
                        end do
                        call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                    ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x n1), i.e. (m x n) or (m x m).
                        do p = 1,n
                           do q = p + 1,n
                              rtmp = u(q,p)
                              u(q,p) = u(p,q)
                              u(p,q) = rtmp
                           end do
                        end do
                        if ((n < m) .and. .not. (wntuf)) then
                           call la_${ri}$laset('A',m - n,n,zero,zero,u(n + 1,1),ldu)
                           if (n < n1) then
                             call la_${ri}$laset('A',n,n1 - n,zero,zero,u(1,n + 1),ldu)
                             call la_${ri}$laset('A',m - n,n1 - n,zero,one,u(n + 1,n + 1),ldu)
                           end if
                        end if
                     else
                        ! .. copy r**t into [u] and overwrite [u] with the right
                        ! singular vectors of r
                        do p = 1,nr
                           do q = p,n
                              u(q,nr + p) = a(p,q)
                           end do
                        end do
                        if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,u(1,nr + 2),ldu)

                        call la_${ri}$geqrf(n,nr,u(1,nr + 1),ldu,work(n + 1),work(n + nr + 1),lwork - &
                                  n - nr,ierr)
                        do p = 1,nr
                            do q = 1,n
                                v(q,p) = u(p,nr + q)
                            end do
                        end do
                       call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                       call la_${ri}$gesvd('S','O',nr,nr,v,ldv,s,u,ldu,v,ldv,work(n + nr + 1) &
                                 ,lwork - n - nr,info)
                       call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
                       call la_${ri}$ormqr('R','C',n,n,nr,u(1,nr + 1),ldu,work(n + 1),v,ldv,work( &
                                 n + nr + 1),lwork - n - nr,ierr)
                       call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                       ! Assemble The Left Singular Vector Matrix U Of Dimensions
                       ! (m x nr) or (m x n) or (m x m).
                       if ((nr < m) .and. .not. (wntuf)) then
                          call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                          if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                          end if
                       end if
                     end if
                 end if
              else
                  ! .. apply la_${ri}$gesvd to r [[this is the recommended option]]
                  if (wntvr .or. (nr == n)) then
                      ! .. copy r into [v] and overwrite v with the right singular vectors
                      call la_${ri}$lacpy('U',nr,n,a,lda,v,ldv)
                     if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,v(2,1),ldv)

                     ! .. the right singular vectors of r overwrite [v], the nr left
                     ! singular vectors of r stored in [u](1:nr,1:nr)
                     call la_${ri}$gesvd('S','O',nr,n,v,ldv,s,u,ldu,v,ldv,work(n + 1), &
                               lwork - n,info)
                     call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                     ! .. now [v](1:nr,1:n) contains v(1:n,1:nr)**t
                     ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x nr) or (m x n) or (m x m).
                    if ((nr < m) .and. .not. (wntuf)) then
                       call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                       if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                       end if
                    end if
                  else
                    ! .. need all n right singular vectors and nr < n
                    ! The Requested Number Of The Left Singular Vectors
                     ! is then n1 (n or m)
                     ! [[the optimal ratio n/nr for using lq instead of padding
                       ! with zeros. here hard coded to 2; it must be at least
                       ! two due to work space constraints.]]
                     ! optratio = la_ilaenv(6, '${ri}$gesvd', 's' // 'o', nr,n,0,0)
                     ! optratio = max( optratio, 2 )
                    optratio = 2
                    if (optratio*nr > n) then
                       call la_${ri}$lacpy('U',nr,n,a,lda,v,ldv)
                       if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,v(2,1),ldv)

                    ! .. the right singular vectors of r overwrite [v], the nr left
                       ! singular vectors of r stored in [u](1:nr,1:nr)
                       call la_${ri}$laset('A',n - nr,n,zero,zero,v(nr + 1,1),ldv)
                       call la_${ri}$gesvd('S','O',n,n,v,ldv,s,u,ldu,v,ldv,work(n + 1), &
                                 lwork - n,info)
                       call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                       ! .. now [v] contains the transposed matrix of the right
                       ! singular vectors of a. the leading n left singular vectors
                       ! are in [u](1:n,1:n)
                       ! Assemble The Left Singular Vector Matrix U Of Dimensions
                       ! (m x n1), i.e. (m x n) or (m x m).
                       if ((n < m) .and. .not. (wntuf)) then
                           call la_${ri}$laset('A',m - n,n,zero,zero,u(n + 1,1),ldu)
                           if (n < n1) then
                             call la_${ri}$laset('A',n,n1 - n,zero,zero,u(1,n + 1),ldu)
                             call la_${ri}$laset('A',m - n,n1 - n,zero,one,u(n + 1,n + 1),ldu)
                           end if
                       end if
                    else
                       call la_${ri}$lacpy('U',nr,n,a,lda,u(nr + 1,1),ldu)
                       if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,u(nr + 2,1),ldu)

                       call la_${ri}$gelqf(nr,n,u(nr + 1,1),ldu,work(n + 1),work(n + nr + 1),lwork - n - &
                                 nr,ierr)
                       call la_${ri}$lacpy('L',nr,nr,u(nr + 1,1),ldu,v,ldv)
                       if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                       call la_${ri}$gesvd('S','O',nr,nr,v,ldv,s,u,ldu,v,ldv,work(n + nr + &
                                 1),lwork - n - nr,info)
                       call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
                       call la_${ri}$ormlq('R','N',n,n,nr,u(nr + 1,1),ldu,work(n + 1),v,ldv,work(n + &
                                 nr + 1),lwork - n - nr,ierr)
                       call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                     ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x nr) or (m x n) or (m x m).
                       if ((nr < m) .and. .not. (wntuf)) then
                          call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                          if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                          end if
                       end if
                    end if
                  end if
              ! .. end of the "r**t or r" branch
              end if
                 ! the q matrix from the first qrf is built into the left singular
                 ! vectors matrix u.
              if (.not. wntuf) call la_${ri}$ormqr('L','N',m,n1,n,a,lda,work,u,ldu,work( &
                        n + 1),lwork - n,ierr)
              if (rowprm .and. .not. wntuf) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(n + 1),- &
                        1)
           ! ... end of the "full svd" branch
           end if
           ! check whether some singular values are returned as zeros, e.g.
           ! due to underflow, and update the numerical rank.
           p = nr
           do q = p,1,-1
               if (s(q) > zero) go to 4002
               nr = nr - 1
           end do
           4002 continue
           ! .. if numerical rank deficiency is detected, the truncated
           ! singular values are set to zero.
           if (nr < n) call la_${ri}$laset('G',n - nr,1,zero,zero,s(nr + 1),n)
           ! .. undo scaling; this may cause overflow in the largest singular
           ! values.
           if (ascaled) call la_${ri}$lascl('G',0,0,one,sqrt(real(m,KIND=${rk}$)),nr,1,s,n,ierr &
                     )
           if (conda) rwork(1) = sconda
           rwork(2) = p - nr
           ! .. p-nr is the number of singular values that are computed as
           ! exact zeros in la_${ri}$gesvd() applied to the (possibly truncated)
           ! full row rank triangular (trapezoidal) factor of a.
           numrank = nr
           return
     end subroutine la_${ri}$gesvdq
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GESVD: computes the singular value decomposition (SVD) of a complex
     !> M-by-N matrix A, optionally computing the left and/or right singular
     !> vectors. The SVD is written
     !> A = U * SIGMA * conjugate-transpose(V)
     !> where SIGMA is an M-by-N matrix which is zero except for its
     !> min(m,n) diagonal elements, U is an M-by-M unitary matrix, and
     !> V is an N-by-N unitary matrix.  The diagonal elements of SIGMA
     !> are the singular values of A; they are real and non-negative, and
     !> are returned in descending order.  The first min(m,n) columns of
     !> U and V are the left and right singular vectors of A.
     !> Note that the routine returns V**H, not V.

     subroutine la_${ri}$gesvd(jobu,jobvt,m,n,a,lda,s,u,ldu,vt,ldvt,work,lwork,rwork, &
               info)
        use la_constants_${rk}$,only:zero,one,czero,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu,jobvt
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldu,ldvt,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*),s(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: u(ldu,*),vt(ldvt,*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,wntua,wntuas,wntun,wntuo,wntus,wntva,wntvas,wntvn,wntvo, &
                      wntvs
           integer(ilp) :: blk,chunk,i,ie,ierr,ir,irwork,iscl,itau,itaup,itauq,iu, &
           iwork,ldwrkr,ldwrku,maxwrk,minmn,minwrk,mnthr,ncu,ncvt,nru,nrvt, &
                     wrkbl
           integer(ilp) :: lwork_${ri}$geqrf,lwork_${ri}$ungqr_n,lwork_${ri}$ungqr_m,lwork_${ri}$gebrd, &
                     lwork_${ri}$ungbr_p,lwork_${ri}$ungbr_q,lwork_${ri}$gelqf,lwork_${ri}$unglq_n,lwork_${ri}$unglq_m
           real(${rk}$) :: anrm,bignum,eps,smlnum
           ! Local Arrays
           real(${rk}$) :: dum(1)
           complex(${rk}$) :: cdum(1)
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input arguments
           info = 0
           minmn = min(m,n)
           wntua = la_lsame(jobu,'A')
           wntus = la_lsame(jobu,'S')
           wntuas = wntua .or. wntus
           wntuo = la_lsame(jobu,'O')
           wntun = la_lsame(jobu,'N')
           wntva = la_lsame(jobvt,'A')
           wntvs = la_lsame(jobvt,'S')
           wntvas = wntva .or. wntvs
           wntvo = la_lsame(jobvt,'O')
           wntvn = la_lsame(jobvt,'N')
           lquery = (lwork == -1)
           if (.not. (wntua .or. wntus .or. wntuo .or. wntun)) then
              info = -1
           else if (.not. (wntva .or. wntvs .or. wntvo .or. wntvn) .or. (wntvo .and. wntuo)) &
                     then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (lda < max(1,m)) then
              info = -6
           else if (ldu < 1 .or. (wntuas .and. ldu < m)) then
              info = -9
           else if (ldvt < 1 .or. (wntva .and. ldvt < n) .or. (wntvs .and. ldvt < minmn)) &
                     then
              info = -11
           end if
           ! compute workspace
            ! (note: comments in the code beginning "workspace:" describe the
             ! minimal amount of workspace needed at that point in the code,
             ! as well as the preferred amount for good performance.
             ! cworkspace refers to complex workspace, and rworkspace to
             ! real workspace. nb refers to the optimal block size for the
             ! immediately following subroutine, as returned by la_ilaenv.)
           if (info == 0) then
              minwrk = 1
              maxwrk = 1
              if (m >= n .and. minmn > 0) then
#:if rk == "sp"
                 ! space needed for la_${riu}$bdsqr is bdspac = 5*n
#:else
                 ! space needed for la_${ri}$bdsqr is bdspac = 5*n
#:endif
                 mnthr = la_ilaenv(6,'${ri.upper()}$GESVD',jobu//jobvt,m,n,0,0)
                 ! compute space needed for la_${ri}$geqrf
                 call la_${ri}$geqrf(m,n,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$geqrf = int(cdum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$ungqr
                 call la_${ri}$ungqr(m,n,n,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungqr_n = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungqr(m,m,n,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungqr_m = int(cdum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$gebrd
                 call la_${ri}$gebrd(n,n,a,lda,s,dum(1),cdum(1),cdum(1),cdum(1),-1,ierr)

                 lwork_${ri}$gebrd = int(cdum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$ungbr
                 call la_${ri}$ungbr('P',n,n,n,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_p = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('Q',n,n,n,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_q = int(cdum(1),KIND=ilp)
#:if rk == "sp"
                 mnthr = la_ilaenv(6,'${ri.upper()}$GESVD',jobu//jobvt,m,n,0,0)
#:endif
                 if (m >= mnthr) then
                    if (wntun) then
                       ! path 1 (m much larger than n, jobu='n')
                       maxwrk = n + lwork_${ri}$geqrf
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$gebrd)
                       if (wntvo .or. wntvas) maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_p)
                       minwrk = 3*n
                    else if (wntuo .and. wntvn) then
                       ! path 2 (m much larger than n, jobu='o', jobvt='n')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_n)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       maxwrk = max(n*n + wrkbl,n*n + m*n)
                       minwrk = 2*n + m
                    else if (wntuo .and. wntvas) then
                       ! path 3 (m much larger than n, jobu='o', jobvt='s' or
                       ! 'a')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_n)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_p)
                       maxwrk = max(n*n + wrkbl,n*n + m*n)
                       minwrk = 2*n + m
                    else if (wntus .and. wntvn) then
                       ! path 4 (m much larger than n, jobu='s', jobvt='n')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_n)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       maxwrk = n*n + wrkbl
                       minwrk = 2*n + m
                    else if (wntus .and. wntvo) then
                       ! path 5 (m much larger than n, jobu='s', jobvt='o')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_n)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_p)
                       maxwrk = 2*n*n + wrkbl
                       minwrk = 2*n + m
                    else if (wntus .and. wntvas) then
                       ! path 6 (m much larger than n, jobu='s', jobvt='s' or
                       ! 'a')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_n)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_p)
                       maxwrk = n*n + wrkbl
                       minwrk = 2*n + m
                    else if (wntua .and. wntvn) then
                       ! path 7 (m much larger than n, jobu='a', jobvt='n')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_m)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       maxwrk = n*n + wrkbl
                       minwrk = 2*n + m
                    else if (wntua .and. wntvo) then
                       ! path 8 (m much larger than n, jobu='a', jobvt='o')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_m)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_p)
                       maxwrk = 2*n*n + wrkbl
                       minwrk = 2*n + m
                    else if (wntua .and. wntvas) then
                       ! path 9 (m much larger than n, jobu='a', jobvt='s' or
                       ! 'a')
                       wrkbl = n + lwork_${ri}$geqrf
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_m)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_q)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$ungbr_p)
                       maxwrk = n*n + wrkbl
                       minwrk = 2*n + m
                    end if
                 else
                    ! path 10 (m at least n, but not much larger)
                    call la_${ri}$gebrd(m,n,a,lda,s,dum(1),cdum(1),cdum(1),cdum(1),-1, &
                              ierr)
                    lwork_${ri}$gebrd = int(cdum(1),KIND=ilp)
                    maxwrk = 2*n + lwork_${ri}$gebrd
                    if (wntus .or. wntuo) then
                       call la_${ri}$ungbr('Q',m,n,n,a,lda,cdum(1),cdum(1),-1,ierr)

                       lwork_${ri}$ungbr_q = int(cdum(1),KIND=ilp)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_q)
                    end if
                    if (wntua) then
                       call la_${ri}$ungbr('Q',m,m,n,a,lda,cdum(1),cdum(1),-1,ierr)

                       lwork_${ri}$ungbr_q = int(cdum(1),KIND=ilp)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_q)
                    end if
                    if (.not. wntvn) then
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_p)
                    end if
                    minwrk = 2*n + m
                 end if
              else if (minmn > 0) then
                 ! space needed for la_${ri}$bdsqr is bdspac = 5*m
                 mnthr = la_ilaenv(6,'${ri.upper()}$GESVD',jobu//jobvt,m,n,0,0)
                 ! compute space needed for la_${ri}$gelqf
                 call la_${ri}$gelqf(m,n,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$gelqf = int(cdum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$unglq
                 call la_${ri}$unglq(n,n,m,cdum(1),n,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$unglq_n = int(cdum(1),KIND=ilp)
                 call la_${ri}$unglq(m,n,m,a,lda,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$unglq_m = int(cdum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$gebrd
                 call la_${ri}$gebrd(m,m,a,lda,s,dum(1),cdum(1),cdum(1),cdum(1),-1,ierr)

                 lwork_${ri}$gebrd = int(cdum(1),KIND=ilp)
                  ! compute space needed for la_${ri}$ungbr p
                 call la_${ri}$ungbr('P',m,m,m,a,n,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_p = int(cdum(1),KIND=ilp)
                 ! compute space needed for la_${ri}$ungbr q
                 call la_${ri}$ungbr('Q',m,m,m,a,n,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_q = int(cdum(1),KIND=ilp)
                 if (n >= mnthr) then
                    if (wntvn) then
                       ! path 1t(n much larger than m, jobvt='n')
                       maxwrk = m + lwork_${ri}$gelqf
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$gebrd)
                       if (wntuo .or. wntuas) maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_q)
                       minwrk = 3*m
                    else if (wntvo .and. wntun) then
                       ! path 2t(n much larger than m, jobu='n', jobvt='o')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_m)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       maxwrk = max(m*m + wrkbl,m*m + m*n)
                       minwrk = 2*m + n
                    else if (wntvo .and. wntuas) then
                       ! path 3t(n much larger than m, jobu='s' or 'a',
                       ! jobvt='o')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_m)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_q)
                       maxwrk = max(m*m + wrkbl,m*m + m*n)
                       minwrk = 2*m + n
                    else if (wntvs .and. wntun) then
                       ! path 4t(n much larger than m, jobu='n', jobvt='s')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_m)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       maxwrk = m*m + wrkbl
                       minwrk = 2*m + n
                    else if (wntvs .and. wntuo) then
                       ! path 5t(n much larger than m, jobu='o', jobvt='s')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_m)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_q)
                       maxwrk = 2*m*m + wrkbl
                       minwrk = 2*m + n
                    else if (wntvs .and. wntuas) then
                       ! path 6t(n much larger than m, jobu='s' or 'a',
                       ! jobvt='s')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_m)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_q)
                       maxwrk = m*m + wrkbl
                       minwrk = 2*m + n
                    else if (wntva .and. wntun) then
                       ! path 7t(n much larger than m, jobu='n', jobvt='a')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_n)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       maxwrk = m*m + wrkbl
                       minwrk = 2*m + n
                    else if (wntva .and. wntuo) then
                       ! path 8t(n much larger than m, jobu='o', jobvt='a')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_n)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_q)
                       maxwrk = 2*m*m + wrkbl
                       minwrk = 2*m + n
                    else if (wntva .and. wntuas) then
                       ! path 9t(n much larger than m, jobu='s' or 'a',
                       ! jobvt='a')
                       wrkbl = m + lwork_${ri}$gelqf
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_n)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_p)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$ungbr_q)
                       maxwrk = m*m + wrkbl
                       minwrk = 2*m + n
                    end if
                 else
                    ! path 10t(n greater than m, but not much larger)
                    call la_${ri}$gebrd(m,n,a,lda,s,dum(1),cdum(1),cdum(1),cdum(1),-1, &
                              ierr)
                    lwork_${ri}$gebrd = int(cdum(1),KIND=ilp)
                    maxwrk = 2*m + lwork_${ri}$gebrd
                    if (wntvs .or. wntvo) then
                      ! compute space needed for la_${ri}$ungbr p
                      call la_${ri}$ungbr('P',m,n,m,a,n,cdum(1),cdum(1),-1,ierr)
                      lwork_${ri}$ungbr_p = int(cdum(1),KIND=ilp)
                      maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_p)
                    end if
                    if (wntva) then
                      call la_${ri}$ungbr('P',n,n,m,a,n,cdum(1),cdum(1),-1,ierr)
                      lwork_${ri}$ungbr_p = int(cdum(1),KIND=ilp)
                      maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_p)
                    end if
                    if (.not. wntun) then
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_q)
                    end if
                    minwrk = 2*m + n
                 end if
              end if
#:if rk == "sp"
              maxwrk = max(minwrk,maxwrk)
#:else
              maxwrk = max(maxwrk,minwrk)
#:endif
              work(1) = maxwrk
              if (lwork < minwrk .and. .not. lquery) then
                 info = -13
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESVD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) then
              return
           end if
           ! get machine constants
           eps = la_${ci}$lamch('P')
           smlnum = sqrt(la_${ci}$lamch('S'))/eps
           bignum = one/smlnum
           ! scale a if max element outside range [smlnum,bignum]
           anrm = la_${ri}$lange('M',m,n,a,lda,dum)
           iscl = 0
           if (anrm > zero .and. anrm < smlnum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,smlnum,m,n,a,lda,ierr)
           else if (anrm > bignum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,bignum,m,n,a,lda,ierr)
           end if
           if (m >= n) then
              ! a has at least as many rows as columns. if a has sufficiently
              ! more rows than columns, first reduce using the qr
              ! decomposition (if sufficient workspace available)
              if (m >= mnthr) then
                 if (wntun) then
                    ! path 1 (m much larger than n, jobu='n')
                    ! no left singular vectors to be computed
                    itau = 1
                    iwork = itau + n
                    ! compute a=q*r
                    ! (cworkspace: need 2*n, prefer n+n*nb)
                    ! (rworkspace: need 0)
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + 1, &
                              ierr)
                    ! zero out below r
                    if (n > 1) then
                       call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)
                    end if
                    ie = 1
                    itauq = 1
                    itaup = itauq + n
                    iwork = itaup + n
                    ! bidiagonalize r in a
                    ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                    ! (rworkspace: need n)
                    call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                               work(iwork),lwork - iwork + 1,ierr)
                    ncvt = 0
                    if (wntvo .or. wntvas) then
                       ! if right singular vectors desired, generate p'.
                       ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('P',n,n,n,a,lda,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       ncvt = n
                    end if
                    irwork = ie + n
                    ! perform bidiagonal qr iteration, computing right
                    ! singular vectors of a in a if desired
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,0,0,s,rwork(ie),a,lda,cdum,1,cdum, &
                              1,rwork(irwork),info)
                    ! if right singular vectors desired in vt, copy them there
                    if (wntvas) call la_${ri}$lacpy('F',n,n,a,lda,vt,ldvt)
                 else if (wntuo .and. wntvn) then
                    ! path 2 (m much larger than n, jobu='o', jobvt='n')
                    ! n left singular vectors to be overwritten on a and
                    ! no right singular vectors to be computed
                    if (lwork >= n*n + 3*n) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n) + lda*n) then
                          ! work(iu) is lda by n, work(ir) is lda by n
                          ldwrku = lda
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n) + n*n) then
                          ! work(iu) is lda by n, work(ir) is n by n
                          ldwrku = lda
                          ldwrkr = n
                       else
                          ! work(iu) is ldwrku by n, work(ir) is n by n
                          ldwrku = (lwork - n*n)/n
                          ldwrkr = n
                       end if
                       itau = ir + ldwrkr*n
                       iwork = itau + n
                       ! compute a=q*r
                       ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy r to work(ir) and zero out below it
                       call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                       call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(ir + 1),ldwrkr)

                       ! generate q in a
                       ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = 1
                       itauq = itau
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize r in work(ir)
                       ! (cworkspace: need n*n+3*n, prefer n*n+2*n+2*n*nb)
                       ! (rworkspace: need n)
                       call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,rwork(ie),work(itauq), &
                                  work(itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing r
                       ! (cworkspace: need n*n+3*n, prefer n*n+2*n+n*nb)
                       ! (rworkspace: need 0)
                       call la_${ri}$ungbr('Q',n,n,n,work(ir),ldwrkr,work(itauq),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       irwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of r in work(ir)
                       ! (cworkspace: need n*n)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',n,0,n,0,s,rwork(ie),cdum,1,work(ir), &
                                 ldwrkr,cdum,1,rwork(irwork),info)
                       iu = itauq
                       ! multiply q in a by left singular vectors of r in
                       ! work(ir), storing result in work(iu) and copying to a
                       ! (cworkspace: need n*n+n, prefer n*n+m*n)
                       ! (rworkspace: 0)
                       do i = 1,m,ldwrku
                          chunk = min(m - i + 1,ldwrku)
                          call la_${ri}$gemm('N','N',chunk,n,n,cone,a(i,1),lda,work(ir &
                                    ),ldwrkr,czero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',chunk,n,work(iu),ldwrku,a(i,1),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       ie = 1
                       itauq = 1
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize a
                       ! (cworkspace: need 2*n+m, prefer 2*n+(m+n)*nb)
                       ! (rworkspace: n)
                       call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing a
                       ! (cworkspace: need 3*n, prefer 2*n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('Q',m,n,n,a,lda,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       irwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of a in a
                       ! (cworkspace: need 0)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',n,0,m,0,s,rwork(ie),cdum,1,a,lda,cdum, &
                                 1,rwork(irwork),info)
                    end if
                 else if (wntuo .and. wntvas) then
                    ! path 3 (m much larger than n, jobu='o', jobvt='s' or 'a')
                    ! n left singular vectors to be overwritten on a and
                    ! n right singular vectors to be computed in vt
                    if (lwork >= n*n + 3*n) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n) + lda*n) then
                          ! work(iu) is lda by n and work(ir) is lda by n
                          ldwrku = lda
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n) + n*n) then
                          ! work(iu) is lda by n and work(ir) is n by n
                          ldwrku = lda
                          ldwrkr = n
                       else
                          ! work(iu) is ldwrku by n and work(ir) is n by n
                          ldwrku = (lwork - n*n)/n
                          ldwrkr = n
                       end if
                       itau = ir + ldwrkr*n
                       iwork = itau + n
                       ! compute a=q*r
                       ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy r to vt, zeroing out below it
                       call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                       if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,czero,czero,vt(2,1),ldvt)

                       ! generate q in a
                       ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = 1
                       itauq = itau
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize r in vt, copying result to work(ir)
                       ! (cworkspace: need n*n+3*n, prefer n*n+2*n+2*n*nb)
                       ! (rworkspace: need n)
                       call la_${ri}$gebrd(n,n,vt,ldvt,s,rwork(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       call la_${ri}$lacpy('L',n,n,vt,ldvt,work(ir),ldwrkr)
                       ! generate left vectors bidiagonalizing r in work(ir)
                       ! (cworkspace: need n*n+3*n, prefer n*n+2*n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('Q',n,n,n,work(ir),ldwrkr,work(itauq),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing r in vt
                       ! (cworkspace: need n*n+3*n-1, prefer n*n+2*n+(n-1)*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       irwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of r in work(ir) and computing right
                       ! singular vectors of r in vt
                       ! (cworkspace: need n*n)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',n,n,n,0,s,rwork(ie),vt,ldvt,work(ir), &
                                 ldwrkr,cdum,1,rwork(irwork),info)
                       iu = itauq
                       ! multiply q in a by left singular vectors of r in
                       ! work(ir), storing result in work(iu) and copying to a
                       ! (cworkspace: need n*n+n, prefer n*n+m*n)
                       ! (rworkspace: 0)
                       do i = 1,m,ldwrku
                          chunk = min(m - i + 1,ldwrku)
                          call la_${ri}$gemm('N','N',chunk,n,n,cone,a(i,1),lda,work(ir &
                                    ),ldwrkr,czero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',chunk,n,work(iu),ldwrku,a(i,1),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       itau = 1
                       iwork = itau + n
                       ! compute a=q*r
                       ! (cworkspace: need 2*n, prefer n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy r to vt, zeroing out below it
                       call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                       if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,czero,czero,vt(2,1),ldvt)

                       ! generate q in a
                       ! (cworkspace: need 2*n, prefer n+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = 1
                       itauq = itau
                       itaup = itauq + n
                       iwork = itaup + n
                       ! bidiagonalize r in vt
                       ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                       ! (rworkspace: n)
                       call la_${ri}$gebrd(n,n,vt,ldvt,s,rwork(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! multiply q in a by left vectors bidiagonalizing r
                       ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$unmbr('Q','R','N',m,n,n,vt,ldvt,work(itauq),a,lda, &
                                  work(iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing r in vt
                       ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       irwork = ie + n
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of a in a and computing right
                       ! singular vectors of a in vt
                       ! (cworkspace: 0)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',n,n,m,0,s,rwork(ie),vt,ldvt,a,lda,cdum, &
                                  1,rwork(irwork),info)
                    end if
                 else if (wntus) then
                    if (wntvn) then
                       ! path 4 (m much larger than n, jobu='s', jobvt='n')
                       ! n left singular vectors to be computed in u and
                       ! no right singular vectors to be computed
                       if (lwork >= n*n + 3*n) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(ir) is lda by n
                             ldwrkr = lda
                          else
                             ! work(ir) is n by n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r
                          ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(ir), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(ir + 1),ldwrkr)

                          ! generate q in a
                          ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(ir)
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate left vectors bidiagonalizing r in work(ir)
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',n,n,n,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(ir)
                          ! (cworkspace: need n*n)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,0,n,0,s,rwork(ie),cdum,1,work(ir), &
                                     ldwrkr,cdum,1,rwork(irwork),info)
                          ! multiply q in a by left singular vectors of r in
                          ! work(ir), storing result in u
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,n,cone,a,lda,work(ir),ldwrkr, &
                                    czero,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,n,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
                          ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left vectors bidiagonalizing r
                          ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,0,m,0,s,rwork(ie),cdum,1,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntvo) then
                       ! path 5 (m much larger than n, jobu='s', jobvt='o')
                       ! n left singular vectors to be computed in u and
                       ! n right singular vectors to be overwritten on a
                       if (lwork >= 2*n*n + 3*n) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*n) then
                             ! work(iu) is lda by n and work(ir) is lda by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + n)*n) then
                             ! work(iu) is lda by n and work(ir) is n by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          else
                             ! work(iu) is n by n and work(ir) is n by n
                             ldwrku = n
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r
                          ! (cworkspace: need 2*n*n+2*n, prefer 2*n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(iu + 1),ldwrku)

                          ! generate q in a
                          ! (cworkspace: need 2*n*n+2*n, prefer 2*n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to
                          ! work(ir)
                          ! (cworkspace: need   2*n*n+3*n,
                                       ! prefer 2*n*n+2*n+2*n*nb)
                          ! (rworkspace: need   n)
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate left bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need 2*n*n+3*n, prefer 2*n*n+2*n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in work(ir)
                          ! (cworkspace: need   2*n*n+3*n-1,
                                       ! prefer 2*n*n+2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in work(ir)
                          ! (cworkspace: need 2*n*n)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,n,0,s,rwork(ie),work(ir),ldwrkr, &
                                    work(iu),ldwrku,cdum,1,rwork(irwork),info)
                          ! multiply q in a by left singular vectors of r in
                          ! work(iu), storing result in u
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,n,cone,a,lda,work(iu),ldwrku, &
                                    czero,u,ldu)
                          ! copy right singular vectors of r to a
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$lacpy('F',n,n,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,n,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
                          ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left vectors bidiagonalizing r
                          ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right vectors bidiagonalizing r in a
                          ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,a,lda,work(itaup),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in a
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,rwork(ie),a,lda,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntvas) then
                       ! path 6 (m much larger than n, jobu='s', jobvt='s'
                               ! or 'a')
                       ! n left singular vectors to be computed in u and
                       ! n right singular vectors to be computed in vt
                       if (lwork >= n*n + 3*n) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(iu) is lda by n
                             ldwrku = lda
                          else
                             ! work(iu) is n by n
                             ldwrku = n
                          end if
                          itau = iu + ldwrku*n
                          iwork = itau + n
                          ! compute a=q*r
                          ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(iu + 1),ldwrku)

                          ! generate q in a
                          ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to vt
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,vt,ldvt)
                          ! generate left bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
                          ! (cworkspace: need   n*n+3*n-1,
                                       ! prefer n*n+2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in vt
                          ! (cworkspace: need n*n)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,n,0,s,rwork(ie),vt,ldvt,work(iu) &
                                    ,ldwrku,cdum,1,rwork(irwork),info)
                          ! multiply q in a by left singular vectors of r in
                          ! work(iu), storing result in u
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,n,cone,a,lda,work(iu),ldwrku, &
                                    czero,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,n,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to vt, zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                          if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,czero,czero,vt(2,1), &
                                    ldvt)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in vt
                          ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,vt,ldvt,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in vt
                          ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('Q','R','N',m,n,n,vt,ldvt,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
                          ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,rwork(ie),vt,ldvt,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    end if
                 else if (wntua) then
                    if (wntvn) then
                       ! path 7 (m much larger than n, jobu='a', jobvt='n')
                       ! m left singular vectors to be computed in u and
                       ! no right singular vectors to be computed
                       if (lwork >= n*n + max(n + m,3*n)) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(ir) is lda by n
                             ldwrkr = lda
                          else
                             ! work(ir) is n by n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! copy r to work(ir), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(ir + 1),ldwrkr)

                          ! generate q in u
                          ! (cworkspace: need n*n+n+m, prefer n*n+n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(ir)
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in work(ir)
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',n,n,n,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(ir)
                          ! (cworkspace: need n*n)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,0,n,0,s,rwork(ie),cdum,1,work(ir), &
                                     ldwrkr,cdum,1,rwork(irwork),info)
                          ! multiply q in u by left singular vectors of r in
                          ! work(ir), storing result in a
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,n,cone,u,ldu,work(ir),ldwrkr, &
                                    czero,a,lda)
                          ! copy left singular vectors of a from a to u
                          call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need n+m, prefer n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
                          ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in a
                          ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,0,m,0,s,rwork(ie),cdum,1,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntvo) then
                       ! path 8 (m much larger than n, jobu='a', jobvt='o')
                       ! m left singular vectors to be computed in u and
                       ! n right singular vectors to be overwritten on a
                       if (lwork >= 2*n*n + max(n + m,3*n)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*n) then
                             ! work(iu) is lda by n and work(ir) is lda by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + n)*n) then
                             ! work(iu) is lda by n and work(ir) is n by n
                             ldwrku = lda
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          else
                             ! work(iu) is n by n and work(ir) is n by n
                             ldwrku = n
                             ir = iu + ldwrku*n
                             ldwrkr = n
                          end if
                          itau = ir + ldwrkr*n
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n*n+2*n, prefer 2*n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need 2*n*n+n+m, prefer 2*n*n+n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(iu + 1),ldwrku)

                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to
                          ! work(ir)
                          ! (cworkspace: need   2*n*n+3*n,
                                       ! prefer 2*n*n+2*n+2*n*nb)
                          ! (rworkspace: need   n)
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate left bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need 2*n*n+3*n, prefer 2*n*n+2*n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in work(ir)
                          ! (cworkspace: need   2*n*n+3*n-1,
                                       ! prefer 2*n*n+2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in work(ir)
                          ! (cworkspace: need 2*n*n)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,n,0,s,rwork(ie),work(ir),ldwrkr, &
                                    work(iu),ldwrku,cdum,1,rwork(irwork),info)
                          ! multiply q in u by left singular vectors of r in
                          ! work(iu), storing result in a
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,n,cone,u,ldu,work(iu),ldwrku, &
                                    czero,a,lda)
                          ! copy left singular vectors of a from a to u
                          call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                          ! copy right singular vectors of r from work(ir) to a
                          call la_${ri}$lacpy('F',n,n,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need n+m, prefer n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! zero out below r in a
                          if (n > 1) then
                             call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)

                          end if
                          ! bidiagonalize r in a
                          ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in a
                          ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('Q','R','N',m,n,n,a,lda,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in a
                          ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,a,lda,work(itaup),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in a
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,rwork(ie),a,lda,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntvas) then
                       ! path 9 (m much larger than n, jobu='a', jobvt='s'
                               ! or 'a')
                       ! m left singular vectors to be computed in u and
                       ! n right singular vectors to be computed in vt
                       if (lwork >= n*n + max(n + m,3*n)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*n) then
                             ! work(iu) is lda by n
                             ldwrku = lda
                          else
                             ! work(iu) is n by n
                             ldwrku = n
                          end if
                          itau = iu + ldwrku*n
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need n*n+2*n, prefer n*n+n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need n*n+n+m, prefer n*n+n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r to work(iu), zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(iu + 1),ldwrku)

                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in work(iu), copying result to vt
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('U',n,n,work(iu),ldwrku,vt,ldvt)
                          ! generate left bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need n*n+3*n, prefer n*n+2*n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',n,n,n,work(iu),ldwrku,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
                          ! (cworkspace: need   n*n+3*n-1,
                                       ! prefer n*n+2*n+(n-1)*nb)
                          ! (rworkspace: need   0)
                          call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of r in work(iu) and computing
                          ! right singular vectors of r in vt
                          ! (cworkspace: need n*n)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,n,0,s,rwork(ie),vt,ldvt,work(iu) &
                                    ,ldwrku,cdum,1,rwork(irwork),info)
                          ! multiply q in u by left singular vectors of r in
                          ! work(iu), storing result in a
                          ! (cworkspace: need n*n)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,n,cone,u,ldu,work(iu),ldwrku, &
                                    czero,a,lda)
                          ! copy left singular vectors of a from a to u
                          call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + n
                          ! compute a=q*r, copying result to u
                          ! (cworkspace: need 2*n, prefer n+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$geqrf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                          ! generate q in u
                          ! (cworkspace: need n+m, prefer n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy r from a to vt, zeroing out below it
                          call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                          if (n > 1) call la_${ri}$laset('L',n - 1,n - 1,czero,czero,vt(2,1), &
                                    ldvt)
                          ie = 1
                          itauq = itau
                          itaup = itauq + n
                          iwork = itaup + n
                          ! bidiagonalize r in vt
                          ! (cworkspace: need 3*n, prefer 2*n+2*n*nb)
                          ! (rworkspace: need n)
                          call la_${ri}$gebrd(n,n,vt,ldvt,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply q in u by left bidiagonalizing vectors
                          ! in vt
                          ! (cworkspace: need 2*n+m, prefer 2*n+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('Q','R','N',m,n,n,vt,ldvt,work(itauq),u, &
                                    ldu,work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in vt
                          ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                                     lwork - iwork + 1,ierr)
                          irwork = ie + n
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',n,n,m,0,s,rwork(ie),vt,ldvt,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    end if
                 end if
              else
                 ! m < mnthr
                 ! path 10 (m at least n, but not much larger)
                 ! reduce to bidiagonal form without qr decomposition
                 ie = 1
                 itauq = 1
                 itaup = itauq + n
                 iwork = itaup + n
                 ! bidiagonalize a
                 ! (cworkspace: need 2*n+m, prefer 2*n+(m+n)*nb)
                 ! (rworkspace: need n)
                 call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                           work(iwork),lwork - iwork + 1,ierr)
                 if (wntuas) then
                    ! if left singular vectors desired in u, copy result to u
                    ! and generate left bidiagonalizing vectors in u
                    ! (cworkspace: need 2*n+ncu, prefer 2*n+ncu*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                    if (wntus) ncu = n
                    if (wntua) ncu = m
                    call la_${ri}$ungbr('Q',m,ncu,n,u,ldu,work(itauq),work(iwork), &
                              lwork - iwork + 1,ierr)
                 end if
                 if (wntvas) then
                    ! if right singular vectors desired in vt, copy result to
                    ! vt and generate right bidiagonalizing vectors in vt
                    ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                    call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(iwork), &
                              lwork - iwork + 1,ierr)
                 end if
                 if (wntuo) then
                    ! if left singular vectors desired in a, generate left
                    ! bidiagonalizing vectors in a
                    ! (cworkspace: need 3*n, prefer 2*n+n*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$ungbr('Q',m,n,n,a,lda,work(itauq),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 if (wntvo) then
                    ! if right singular vectors desired in a, generate right
                    ! bidiagonalizing vectors in a
                    ! (cworkspace: need 3*n-1, prefer 2*n+(n-1)*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$ungbr('P',n,n,n,a,lda,work(itaup),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 irwork = ie + n
                 if (wntuas .or. wntuo) nru = m
                 if (wntun) nru = 0
                 if (wntvas .or. wntvo) ncvt = n
                 if (wntvn) ncvt = 0
                 if ((.not. wntuo) .and. (.not. wntvo)) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in vt
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,nru,0,s,rwork(ie),vt,ldvt,u,ldu, &
                              cdum,1,rwork(irwork),info)
                 else if ((.not. wntuo) .and. wntvo) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in a
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,nru,0,s,rwork(ie),a,lda,u,ldu,cdum, &
                               1,rwork(irwork),info)
                 else
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in a and computing right singular
                    ! vectors in vt
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('U',n,ncvt,nru,0,s,rwork(ie),vt,ldvt,a,lda, &
                              cdum,1,rwork(irwork),info)
                 end if
              end if
           else
              ! a has more columns than rows. if a has sufficiently more
              ! columns than rows, first reduce using the lq decomposition (if
              ! sufficient workspace available)
              if (n >= mnthr) then
                 if (wntvn) then
                    ! path 1t(n much larger than m, jobvt='n')
                    ! no right singular vectors to be computed
                    itau = 1
                    iwork = itau + m
                    ! compute a=l*q
                    ! (cworkspace: need 2*m, prefer m+m*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + 1, &
                              ierr)
                    ! zero out above l
                    call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                    ie = 1
                    itauq = 1
                    itaup = itauq + m
                    iwork = itaup + m
                    ! bidiagonalize l in a
                    ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                    ! (rworkspace: need m)
                    call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                               work(iwork),lwork - iwork + 1,ierr)
                    if (wntuo .or. wntuas) then
                       ! if left singular vectors desired, generate q
                       ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('Q',m,m,m,a,lda,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                    end if
                    irwork = ie + m
                    nru = 0
                    if (wntuo .or. wntuas) nru = m
                    ! perform bidiagonal qr iteration, computing left singular
                    ! vectors of a in a if desired
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('U',m,0,nru,0,s,rwork(ie),cdum,1,a,lda,cdum, &
                              1,rwork(irwork),info)
                    ! if left singular vectors desired in u, copy them there
                    if (wntuas) call la_${ri}$lacpy('F',m,m,a,lda,u,ldu)
                 else if (wntvo .and. wntun) then
                    ! path 2t(n much larger than m, jobu='n', jobvt='o')
                    ! m right singular vectors to be overwritten on a and
                    ! no left singular vectors to be computed
                    if (lwork >= m*m + 3*m) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n) + lda*m) then
                          ! work(iu) is lda by n and work(ir) is lda by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n) + m*m) then
                          ! work(iu) is lda by n and work(ir) is m by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = m
                       else
                          ! work(iu) is m by chunk and work(ir) is m by m
                          ldwrku = m
                          chunk = (lwork - m*m)/m
                          ldwrkr = m
                       end if
                       itau = ir + ldwrkr*m
                       iwork = itau + m
                       ! compute a=l*q
                       ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy l to work(ir) and zero out above it
                       call la_${ri}$lacpy('L',m,m,a,lda,work(ir),ldwrkr)
                       call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(ir + ldwrkr),ldwrkr)

                       ! generate q in a
                       ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = 1
                       itauq = itau
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize l in work(ir)
                       ! (cworkspace: need m*m+3*m, prefer m*m+2*m+2*m*nb)
                       ! (rworkspace: need m)
                       call la_${ri}$gebrd(m,m,work(ir),ldwrkr,s,rwork(ie),work(itauq), &
                                  work(itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing l
                       ! (cworkspace: need m*m+3*m-1, prefer m*m+2*m+(m-1)*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('P',m,m,m,work(ir),ldwrkr,work(itaup),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       irwork = ie + m
                       ! perform bidiagonal qr iteration, computing right
                       ! singular vectors of l in work(ir)
                       ! (cworkspace: need m*m)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',m,m,0,0,s,rwork(ie),work(ir),ldwrkr, &
                                 cdum,1,cdum,1,rwork(irwork),info)
                       iu = itauq
                       ! multiply right singular vectors of l in work(ir) by q
                       ! in a, storing result in work(iu) and copying to a
                       ! (cworkspace: need m*m+m, prefer m*m+m*n)
                       ! (rworkspace: 0)
                       do i = 1,n,chunk
                          blk = min(n - i + 1,chunk)
                          call la_${ri}$gemm('N','N',m,blk,m,cone,work(ir),ldwrkr,a(1, &
                                    i),lda,czero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',m,blk,work(iu),ldwrku,a(1,i),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       ie = 1
                       itauq = 1
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize a
                       ! (cworkspace: need 2*m+n, prefer 2*m+(m+n)*nb)
                       ! (rworkspace: need m)
                       call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! generate right vectors bidiagonalizing a
                       ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('P',m,n,m,a,lda,work(itaup),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       irwork = ie + m
                       ! perform bidiagonal qr iteration, computing right
                       ! singular vectors of a in a
                       ! (cworkspace: 0)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('L',m,n,0,0,s,rwork(ie),a,lda,cdum,1,cdum, &
                                 1,rwork(irwork),info)
                    end if
                 else if (wntvo .and. wntuas) then
                    ! path 3t(n much larger than m, jobu='s' or 'a', jobvt='o')
                    ! m right singular vectors to be overwritten on a and
                    ! m left singular vectors to be computed in u
                    if (lwork >= m*m + 3*m) then
                       ! sufficient workspace for a fast algorithm
                       ir = 1
                       if (lwork >= max(wrkbl,lda*n) + lda*m) then
                          ! work(iu) is lda by n and work(ir) is lda by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = lda
                       else if (lwork >= max(wrkbl,lda*n) + m*m) then
                          ! work(iu) is lda by n and work(ir) is m by m
                          ldwrku = lda
                          chunk = n
                          ldwrkr = m
                       else
                          ! work(iu) is m by chunk and work(ir) is m by m
                          ldwrku = m
                          chunk = (lwork - m*m)/m
                          ldwrkr = m
                       end if
                       itau = ir + ldwrkr*m
                       iwork = itau + m
                       ! compute a=l*q
                       ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy l to u, zeroing about above it
                       call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                       call la_${ri}$laset('U',m - 1,m - 1,czero,czero,u(1,2),ldu)
                       ! generate q in a
                       ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = 1
                       itauq = itau
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize l in u, copying result to work(ir)
                       ! (cworkspace: need m*m+3*m, prefer m*m+2*m+2*m*nb)
                       ! (rworkspace: need m)
                       call la_${ri}$gebrd(m,m,u,ldu,s,rwork(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       call la_${ri}$lacpy('U',m,m,u,ldu,work(ir),ldwrkr)
                       ! generate right vectors bidiagonalizing l in work(ir)
                       ! (cworkspace: need m*m+3*m-1, prefer m*m+2*m+(m-1)*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('P',m,m,m,work(ir),ldwrkr,work(itaup),work( &
                                 iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing l in u
                       ! (cworkspace: need m*m+3*m, prefer m*m+2*m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       irwork = ie + m
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of l in u, and computing right
                       ! singular vectors of l in work(ir)
                       ! (cworkspace: need m*m)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',m,m,m,0,s,rwork(ie),work(ir),ldwrkr,u, &
                                 ldu,cdum,1,rwork(irwork),info)
                       iu = itauq
                       ! multiply right singular vectors of l in work(ir) by q
                       ! in a, storing result in work(iu) and copying to a
                       ! (cworkspace: need m*m+m, prefer m*m+m*n))
                       ! (rworkspace: 0)
                       do i = 1,n,chunk
                          blk = min(n - i + 1,chunk)
                          call la_${ri}$gemm('N','N',m,blk,m,cone,work(ir),ldwrkr,a(1, &
                                    i),lda,czero,work(iu),ldwrku)
                          call la_${ri}$lacpy('F',m,blk,work(iu),ldwrku,a(1,i),lda)

                       end do
                    else
                       ! insufficient workspace for a fast algorithm
                       itau = 1
                       iwork = itau + m
                       ! compute a=l*q
                       ! (cworkspace: need 2*m, prefer m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - iwork + &
                                 1,ierr)
                       ! copy l to u, zeroing out above it
                       call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                       call la_${ri}$laset('U',m - 1,m - 1,czero,czero,u(1,2),ldu)
                       ! generate q in a
                       ! (cworkspace: need 2*m, prefer m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                 iwork + 1,ierr)
                       ie = 1
                       itauq = itau
                       itaup = itauq + m
                       iwork = itaup + m
                       ! bidiagonalize l in u
                       ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                       ! (rworkspace: need m)
                       call la_${ri}$gebrd(m,m,u,ldu,s,rwork(ie),work(itauq),work( &
                                 itaup),work(iwork),lwork - iwork + 1,ierr)
                       ! multiply right vectors bidiagonalizing l by q in a
                       ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$unmbr('P','L','C',m,n,m,u,ldu,work(itaup),a,lda, &
                                 work(iwork),lwork - iwork + 1,ierr)
                       ! generate left vectors bidiagonalizing l in u
                       ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                       ! (rworkspace: 0)
                       call la_${ri}$ungbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                 lwork - iwork + 1,ierr)
                       irwork = ie + m
                       ! perform bidiagonal qr iteration, computing left
                       ! singular vectors of a in u and computing right
                       ! singular vectors of a in a
                       ! (cworkspace: 0)
                       ! (rworkspace: need bdspac)
                       call la_${ri}$bdsqr('U',m,n,m,0,s,rwork(ie),a,lda,u,ldu,cdum, &
                                 1,rwork(irwork),info)
                    end if
                 else if (wntvs) then
                    if (wntun) then
                       ! path 4t(n much larger than m, jobu='n', jobvt='s')
                       ! m right singular vectors to be computed in vt and
                       ! no left singular vectors to be computed
                       if (lwork >= m*m + 3*m) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(ir) is lda by m
                             ldwrkr = lda
                          else
                             ! work(ir) is m by m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q
                          ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy l to work(ir), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(ir + ldwrkr), &
                                    ldwrkr)
                          ! generate q in a
                          ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(ir)
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,work(ir),ldwrkr,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate right vectors bidiagonalizing l in
                          ! work(ir)
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+(m-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',m,m,m,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of l in work(ir)
                          ! (cworkspace: need m*m)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,m,0,0,s,rwork(ie),work(ir),ldwrkr, &
                                    cdum,1,cdum,1,rwork(irwork),info)
                          ! multiply right singular vectors of l in work(ir) by
                          ! q in a, storing result in vt
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,m,cone,work(ir),ldwrkr,a,lda, &
                                    czero,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy result to vt
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(m,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                          ! bidiagonalize l in a
                          ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right vectors bidiagonalizing l by q in vt
                          ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('P','L','C',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,0,0,s,rwork(ie),vt,ldvt,cdum,1, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntuo) then
                       ! path 5t(n much larger than m, jobu='o', jobvt='s')
                       ! m right singular vectors to be computed in vt and
                       ! m left singular vectors to be overwritten on a
                       if (lwork >= 2*m*m + 3*m) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*m) then
                             ! work(iu) is lda by m and work(ir) is lda by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + m)*m) then
                             ! work(iu) is lda by m and work(ir) is m by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          else
                             ! work(iu) is m by m and work(ir) is m by m
                             ldwrku = m
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q
                          ! (cworkspace: need 2*m*m+2*m, prefer 2*m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out below it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(iu + ldwrku), &
                                    ldwrku)
                          ! generate q in a
                          ! (cworkspace: need 2*m*m+2*m, prefer 2*m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to
                          ! work(ir)
                          ! (cworkspace: need   2*m*m+3*m,
                                       ! prefer 2*m*m+2*m+2*m*nb)
                          ! (rworkspace: need   m)
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate right bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need   2*m*m+3*m-1,
                                       ! prefer 2*m*m+2*m+(m-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in work(ir)
                          ! (cworkspace: need 2*m*m+3*m, prefer 2*m*m+2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in work(ir) and computing
                          ! right singular vectors of l in work(iu)
                          ! (cworkspace: need 2*m*m)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,m,m,0,s,rwork(ie),work(iu),ldwrku, &
                                    work(ir),ldwrkr,cdum,1,rwork(irwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in a, storing result in vt
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,m,cone,work(iu),ldwrku,a,lda, &
                                    czero,vt,ldvt)
                          ! copy left singular vectors of l to a
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$lacpy('F',m,m,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(m,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                          ! bidiagonalize l in a
                          ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right vectors bidiagonalizing l by q in vt
                          ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('P','L','C',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors of l in a
                          ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,a,lda,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in a and computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,rwork(ie),vt,ldvt,a,lda, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntuas) then
                       ! path 6t(n much larger than m, jobu='s' or 'a',
                               ! jobvt='s')
                       ! m right singular vectors to be computed in vt and
                       ! m left singular vectors to be computed in u
                       if (lwork >= m*m + 3*m) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(iu) is lda by n
                             ldwrku = lda
                          else
                             ! work(iu) is lda by m
                             ldwrku = m
                          end if
                          itau = iu + ldwrku*m
                          iwork = itau + m
                          ! compute a=l*q
                          ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(iu + ldwrku), &
                                    ldwrku)
                          ! generate q in a
                          ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to u
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,u,ldu)
                          ! generate right bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need   m*m+3*m-1,
                                       ! prefer m*m+2*m+(m-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in u and computing right
                          ! singular vectors of l in work(iu)
                          ! (cworkspace: need m*m)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,m,m,0,s,rwork(ie),work(iu),ldwrku, &
                                    u,ldu,cdum,1,rwork(irwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in a, storing result in vt
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,m,cone,work(iu),ldwrku,a,lda, &
                                    czero,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(m,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to u, zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,u(1,2),ldu)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in u
                          ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,u,ldu,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in u by q
                          ! in vt
                          ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('P','L','C',m,n,m,u,ldu,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
                          ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,rwork(ie),vt,ldvt,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    end if
                 else if (wntva) then
                    if (wntun) then
                       ! path 7t(n much larger than m, jobu='n', jobvt='a')
                       ! n right singular vectors to be computed in vt and
                       ! no left singular vectors to be computed
                       if (lwork >= m*m + max(n + m,3*m)) then
                          ! sufficient workspace for a fast algorithm
                          ir = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(ir) is lda by m
                             ldwrkr = lda
                          else
                             ! work(ir) is m by m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! copy l to work(ir), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(ir),ldwrkr)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(ir + ldwrkr), &
                                    ldwrkr)
                          ! generate q in vt
                          ! (cworkspace: need m*m+m+n, prefer m*m+m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(ir)
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,work(ir),ldwrkr,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! generate right bidiagonalizing vectors in work(ir)
                          ! (cworkspace: need   m*m+3*m-1,
                                       ! prefer m*m+2*m+(m-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',m,m,m,work(ir),ldwrkr,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of l in work(ir)
                          ! (cworkspace: need m*m)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,m,0,0,s,rwork(ie),work(ir),ldwrkr, &
                                    cdum,1,cdum,1,rwork(irwork),info)
                          ! multiply right singular vectors of l in work(ir) by
                          ! q in vt, storing result in a
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,m,cone,work(ir),ldwrkr,vt,ldvt, &
                                     czero,a,lda)
                          ! copy right singular vectors of a from a to vt
                          call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need m+n, prefer m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                          ! bidiagonalize l in a
                          ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in a by q
                          ! in vt
                          ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('P','L','C',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,0,0,s,rwork(ie),vt,ldvt,cdum,1, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntuo) then
                       ! path 8t(n much larger than m, jobu='o', jobvt='a')
                       ! n right singular vectors to be computed in vt and
                       ! m left singular vectors to be overwritten on a
                       if (lwork >= 2*m*m + max(n + m,3*m)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + 2*lda*m) then
                             ! work(iu) is lda by m and work(ir) is lda by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = lda
                          else if (lwork >= wrkbl + (lda + m)*m) then
                             ! work(iu) is lda by m and work(ir) is m by m
                             ldwrku = lda
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          else
                             ! work(iu) is m by m and work(ir) is m by m
                             ldwrku = m
                             ir = iu + ldwrku*m
                             ldwrkr = m
                          end if
                          itau = ir + ldwrkr*m
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need 2*m*m+2*m, prefer 2*m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need 2*m*m+m+n, prefer 2*m*m+m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(iu + ldwrku), &
                                    ldwrku)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to
                          ! work(ir)
                          ! (cworkspace: need   2*m*m+3*m,
                                       ! prefer 2*m*m+2*m+2*m*nb)
                          ! (rworkspace: need   m)
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,work(ir),ldwrkr)

                          ! generate right bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need   2*m*m+3*m-1,
                                       ! prefer 2*m*m+2*m+(m-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in work(ir)
                          ! (cworkspace: need 2*m*m+3*m, prefer 2*m*m+2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,work(ir),ldwrkr,work(itauq), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in work(ir) and computing
                          ! right singular vectors of l in work(iu)
                          ! (cworkspace: need 2*m*m)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,m,m,0,s,rwork(ie),work(iu),ldwrku, &
                                    work(ir),ldwrkr,cdum,1,rwork(irwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in vt, storing result in a
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,m,cone,work(iu),ldwrku,vt,ldvt, &
                                     czero,a,lda)
                          ! copy right singular vectors of a from a to vt
                          call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                          ! copy left singular vectors of a from work(ir) to a
                          call la_${ri}$lacpy('F',m,m,work(ir),ldwrkr,a,lda)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need m+n, prefer m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! zero out above l in a
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                          ! bidiagonalize l in a
                          ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in a by q
                          ! in vt
                          ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('P','L','C',m,n,m,a,lda,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in a
                          ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,a,lda,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in a and computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,rwork(ie),vt,ldvt,a,lda, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    else if (wntuas) then
                       ! path 9t(n much larger than m, jobu='s' or 'a',
                               ! jobvt='a')
                       ! n right singular vectors to be computed in vt and
                       ! m left singular vectors to be computed in u
                       if (lwork >= m*m + max(n + m,3*m)) then
                          ! sufficient workspace for a fast algorithm
                          iu = 1
                          if (lwork >= wrkbl + lda*m) then
                             ! work(iu) is lda by m
                             ldwrku = lda
                          else
                             ! work(iu) is m by m
                             ldwrku = m
                          end if
                          itau = iu + ldwrku*m
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need m*m+2*m, prefer m*m+m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need m*m+m+n, prefer m*m+m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to work(iu), zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,work(iu),ldwrku)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(iu + ldwrku), &
                                    ldwrku)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in work(iu), copying result to u
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,work(iu),ldwrku,s,rwork(ie),work( &
                                    itauq),work(itaup),work(iwork),lwork - iwork + 1,ierr)
                          call la_${ri}$lacpy('L',m,m,work(iu),ldwrku,u,ldu)
                          ! generate right bidiagonalizing vectors in work(iu)
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+(m-1)*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('P',m,m,m,work(iu),ldwrku,work(itaup), &
                                    work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
                          ! (cworkspace: need m*m+3*m, prefer m*m+2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of l in u and computing right
                          ! singular vectors of l in work(iu)
                          ! (cworkspace: need m*m)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,m,m,0,s,rwork(ie),work(iu),ldwrku, &
                                    u,ldu,cdum,1,rwork(irwork),info)
                          ! multiply right singular vectors of l in work(iu) by
                          ! q in vt, storing result in a
                          ! (cworkspace: need m*m)
                          ! (rworkspace: 0)
                          call la_${ri}$gemm('N','N',m,n,m,cone,work(iu),ldwrku,vt,ldvt, &
                                     czero,a,lda)
                          ! copy right singular vectors of a from a to vt
                          call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                       else
                          ! insufficient workspace for a fast algorithm
                          itau = 1
                          iwork = itau + m
                          ! compute a=l*q, copying result to vt
                          ! (cworkspace: need 2*m, prefer m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$gelqf(m,n,a,lda,work(itau),work(iwork),lwork - &
                                    iwork + 1,ierr)
                          call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                          ! generate q in vt
                          ! (cworkspace: need m+n, prefer m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          ! copy l to u, zeroing out above it
                          call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                          call la_${ri}$laset('U',m - 1,m - 1,czero,czero,u(1,2),ldu)
                          ie = 1
                          itauq = itau
                          itaup = itauq + m
                          iwork = itaup + m
                          ! bidiagonalize l in u
                          ! (cworkspace: need 3*m, prefer 2*m+2*m*nb)
                          ! (rworkspace: need m)
                          call la_${ri}$gebrd(m,m,u,ldu,s,rwork(ie),work(itauq),work( &
                                    itaup),work(iwork),lwork - iwork + 1,ierr)
                          ! multiply right bidiagonalizing vectors in u by q
                          ! in vt
                          ! (cworkspace: need 2*m+n, prefer 2*m+n*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$unmbr('P','L','C',m,n,m,u,ldu,work(itaup),vt, &
                                    ldvt,work(iwork),lwork - iwork + 1,ierr)
                          ! generate left bidiagonalizing vectors in u
                          ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                          ! (rworkspace: 0)
                          call la_${ri}$ungbr('Q',m,m,m,u,ldu,work(itauq),work(iwork), &
                                    lwork - iwork + 1,ierr)
                          irwork = ie + m
                          ! perform bidiagonal qr iteration, computing left
                          ! singular vectors of a in u and computing right
                          ! singular vectors of a in vt
                          ! (cworkspace: 0)
                          ! (rworkspace: need bdspac)
                          call la_${ri}$bdsqr('U',m,n,m,0,s,rwork(ie),vt,ldvt,u,ldu, &
                                    cdum,1,rwork(irwork),info)
                       end if
                    end if
                 end if
              else
                 ! n < mnthr
                 ! path 10t(n greater than m, but not much larger)
                 ! reduce to bidiagonal form without lq decomposition
                 ie = 1
                 itauq = 1
                 itaup = itauq + m
                 iwork = itaup + m
                 ! bidiagonalize a
                 ! (cworkspace: need 2*m+n, prefer 2*m+(m+n)*nb)
                 ! (rworkspace: m)
                 call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                           work(iwork),lwork - iwork + 1,ierr)
                 if (wntuas) then
                    ! if left singular vectors desired in u, copy result to u
                    ! and generate left bidiagonalizing vectors in u
                    ! (cworkspace: need 3*m-1, prefer 2*m+(m-1)*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                    call la_${ri}$ungbr('Q',m,m,n,u,ldu,work(itauq),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 if (wntvas) then
                    ! if right singular vectors desired in vt, copy result to
                    ! vt and generate right bidiagonalizing vectors in vt
                    ! (cworkspace: need 2*m+nrvt, prefer 2*m+nrvt*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                    if (wntva) nrvt = n
                    if (wntvs) nrvt = m
                    call la_${ri}$ungbr('P',nrvt,n,m,vt,ldvt,work(itaup),work(iwork), &
                              lwork - iwork + 1,ierr)
                 end if
                 if (wntuo) then
                    ! if left singular vectors desired in a, generate left
                    ! bidiagonalizing vectors in a
                    ! (cworkspace: need 3*m-1, prefer 2*m+(m-1)*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$ungbr('Q',m,m,n,a,lda,work(itauq),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 if (wntvo) then
                    ! if right singular vectors desired in a, generate right
                    ! bidiagonalizing vectors in a
                    ! (cworkspace: need 3*m, prefer 2*m+m*nb)
                    ! (rworkspace: 0)
                    call la_${ri}$ungbr('P',m,n,m,a,lda,work(itaup),work(iwork),lwork - &
                              iwork + 1,ierr)
                 end if
                 irwork = ie + m
                 if (wntuas .or. wntuo) nru = m
                 if (wntun) nru = 0
                 if (wntvas .or. wntvo) ncvt = n
                 if (wntvn) ncvt = 0
                 if ((.not. wntuo) .and. (.not. wntvo)) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in vt
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('L',m,ncvt,nru,0,s,rwork(ie),vt,ldvt,u,ldu, &
                              cdum,1,rwork(irwork),info)
                 else if ((.not. wntuo) .and. wntvo) then
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in u and computing right singular
                    ! vectors in a
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('L',m,ncvt,nru,0,s,rwork(ie),a,lda,u,ldu,cdum, &
                               1,rwork(irwork),info)
                 else
                    ! perform bidiagonal qr iteration, if desired, computing
                    ! left singular vectors in a and computing right singular
                    ! vectors in vt
                    ! (cworkspace: 0)
                    ! (rworkspace: need bdspac)
                    call la_${ri}$bdsqr('L',m,ncvt,nru,0,s,rwork(ie),vt,ldvt,a,lda, &
                              cdum,1,rwork(irwork),info)
                 end if
              end if
           end if
           ! undo scaling if necessary
           if (iscl == 1) then
              if (anrm > bignum) call la_${ci}$lascl('G',0,0,bignum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (info /= 0 .and. anrm > bignum) call la_${ci}$lascl('G',0,0,bignum,anrm,minmn - 1, &
                         1,rwork(ie),minmn,ierr)
              if (anrm < smlnum) call la_${ci}$lascl('G',0,0,smlnum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (info /= 0 .and. anrm < smlnum) call la_${ci}$lascl('G',0,0,smlnum,anrm,minmn - 1, &
                         1,rwork(ie),minmn,ierr)
           end if
           ! return optimal workspace in work(1)
           work(1) = maxwrk
           return
     end subroutine la_${ri}$gesvd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if rk == "sp"
     !> ${ri.upper()}$GESVDQ: computes the singular value decomposition (SVD) of a complex
#:else
     !> ZCGESVDQ computes the singular value decomposition (SVD) of a complex
#:endif
     !> M-by-N matrix A, where M >= N. The SVD of A is written as
     !> [++]   [xx]   [x0]   [xx]
     !> A = U * SIGMA * V^*,  [++] = [xx] * [ox] * [xx]
     !> [++]   [xx]
     !> where SIGMA is an N-by-N diagonal matrix, U is an M-by-N orthonormal
     !> matrix, and V is an N-by-N unitary matrix. The diagonal elements
     !> of SIGMA are the singular values of A. The columns of U and V are the
     !> left and the right singular vectors of A, respectively.

     subroutine la_${ri}$gesvdq(joba,jobp,jobr,jobu,jobv,m,n,a,lda,s,u,ldu,v,ldv, &
               numrank,iwork,liwork,cwork,lcwork,rwork,lrwork,info)
        use la_constants_${rk}$
           ! Scalar Arguments
           character,intent(in) :: joba,jobp,jobr,jobu,jobv
           integer(ilp),intent(in) :: m,n,lda,ldu,ldv,liwork,lrwork
           integer(ilp),intent(out) :: numrank,info
           integer(ilp),intent(inout) :: lcwork
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: u(ldu,*),v(ldv,*),cwork(*)
           real(${rk}$),intent(out) :: s(*),rwork(*)
           integer(ilp),intent(out) :: iwork(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: ierr,nr,n1,optratio,p,q
           integer(ilp) :: lwcon,lwqp3,lwrk_${ri}$gelqf,lwrk_${ri}$gesvd,lwrk_${ri}$gesvd2,lwrk_${ri}$geqp3, &
           lwrk_${ri}$geqrf,lwrk_${ri}$unmlq,lwrk_${ri}$unmqr,lwrk_${ri}$unmqr2,lwlqf,lwqrf,lwsvd,lwsvd2, &
                     lwunq,lwunq2,lwunlq,minwrk,minwrk2,optwrk,optwrk2,iminwrk,rminwrk
           logical(lk) :: accla,acclm,acclh,ascaled,conda,dntwu,dntwv,lquery,lsvc0,lsvec, &
                      rowprm,rsvec,rtrans,wntua,wntuf,wntur,wntus,wntva,wntvr
           real(${rk}$) :: big,epsln,rtmp,sconda,sfmin
           complex(${rk}$) :: ctmp
           ! Local Arrays
           complex(${rk}$) :: cdummy(1)
           real(${rk}$) :: rdummy(1)
           ! Intrinsic Functions
           intrinsic :: abs,conjg,max,min,real,sqrt
           ! Executable Statements
           ! test the input arguments
           wntus = la_lsame(jobu,'S') .or. la_lsame(jobu,'U')
           wntur = la_lsame(jobu,'R')
           wntua = la_lsame(jobu,'A')
           wntuf = la_lsame(jobu,'F')
           lsvc0 = wntus .or. wntur .or. wntua
           lsvec = lsvc0 .or. wntuf
           dntwu = la_lsame(jobu,'N')
           wntvr = la_lsame(jobv,'R')
           wntva = la_lsame(jobv,'A') .or. la_lsame(jobv,'V')
           rsvec = wntvr .or. wntva
           dntwv = la_lsame(jobv,'N')
           accla = la_lsame(joba,'A')
           acclm = la_lsame(joba,'M')
           conda = la_lsame(joba,'E')
           acclh = la_lsame(joba,'H') .or. conda
           rowprm = la_lsame(jobp,'P')
           rtrans = la_lsame(jobr,'T')
           if (rowprm) then
              iminwrk = max(1,n + m - 1)
              rminwrk = max(2,m,5*n)
           else
              iminwrk = max(1,n)
              rminwrk = max(2,5*n)
           end if
           lquery = (liwork == -1 .or. lcwork == -1 .or. lrwork == -1)
           info = 0
           if (.not. (accla .or. acclm .or. acclh)) then
              info = -1
           else if (.not. (rowprm .or. la_lsame(jobp,'N'))) then
               info = -2
           else if (.not. (rtrans .or. la_lsame(jobr,'N'))) then
               info = -3
           else if (.not. (lsvec .or. dntwu)) then
              info = -4
           else if (wntur .and. wntva) then
              info = -5
           else if (.not. (rsvec .or. dntwv)) then
              info = -5
           else if (m < 0) then
              info = -6
           else if ((n < 0) .or. (n > m)) then
              info = -7
           else if (lda < max(1,m)) then
              info = -9
           else if (ldu < 1 .or. (lsvc0 .and. ldu < m) .or. (wntuf .and. ldu < n)) then
              info = -12
           else if (ldv < 1 .or. (rsvec .and. ldv < n) .or. (conda .and. ldv < n)) then
              info = -14
           else if (liwork < iminwrk .and. .not. lquery) then
              info = -17
           end if
           if (info == 0) then
#:if rk == "sp"
           ! compute workspace
#:endif
              ! Compute The Minimal And The Optimal Workspace Lengths
              ! [[the expressions for computing the minimal and the optimal
              ! values of lcwork are written with a lot of redundancy and
              ! can be simplified. however, this detailed form is easier for
              ! maintenance and modifications of the code.]]
              ! Minimal Workspace Length For la_${ri}$geqp3 Of An M X N Matrix
              lwqp3 = n + 1
              ! Minimal Workspace Length For la_${ri}$unmqr To Build Left Singular Vectors
              if (wntus .or. wntur) then
                  lwunq = max(n,1)
              else if (wntua) then
                  lwunq = max(m,1)
              end if
              ! Minimal Workspace Length For la_${ri}$pocon Of An N X N Matrix
              lwcon = 2*n
              ! la_${ri}$gesvd Of An N X N Matrix
              lwsvd = max(3*n,1)
              if (lquery) then
                  call la_${ri}$geqp3(m,n,a,lda,iwork,cdummy,cdummy,-1,rdummy,ierr)

                  lwrk_${ri}$geqp3 = int(cdummy(1),KIND=ilp)
                  if (wntus .or. wntur) then
                      call la_${ri}$unmqr('L','N',m,n,n,a,lda,cdummy,u,ldu,cdummy,-1, &
                                ierr)
                      lwrk_${ri}$unmqr = int(cdummy(1),KIND=ilp)
                  else if (wntua) then
                      call la_${ri}$unmqr('L','N',m,m,n,a,lda,cdummy,u,ldu,cdummy,-1, &
                                ierr)
                      lwrk_${ri}$unmqr = int(cdummy(1),KIND=ilp)
                  else
                      lwrk_${ri}$unmqr = 0
                  end if
              end if
              minwrk = 2
              optwrk = 2
              if (.not. (lsvec .or. rsvec)) then
                  ! Minimal And Optimal Sizes Of The Complex Workspace If
                  ! only the singular values are requested
                  if (conda) then
                     minwrk = max(n + lwqp3,lwcon,lwsvd)
                  else
                     minwrk = max(n + lwqp3,lwsvd)
                  end if
                  if (lquery) then
                      call la_${ri}$gesvd('N','N',n,n,a,lda,s,u,ldu,v,ldv,cdummy,-1, &
                                rdummy,ierr)
                      lwrk_${ri}$gesvd = int(cdummy(1),KIND=ilp)
                      if (conda) then
                         optwrk = max(n + lwrk_${ri}$geqp3,n + lwcon,lwrk_${ri}$gesvd)
                      else
                         optwrk = max(n + lwrk_${ri}$geqp3,lwrk_${ri}$gesvd)
                      end if
                  end if
              else if (lsvec .and. (.not. rsvec)) then
                  ! Minimal And Optimal Sizes Of The Complex Workspace If The
                  ! singular values and the left singular vectors are requested
                  if (conda) then
                      minwrk = n + max(lwqp3,lwcon,lwsvd,lwunq)
                  else
                      minwrk = n + max(lwqp3,lwsvd,lwunq)
                  end if
                  if (lquery) then
                     if (rtrans) then
                        call la_${ri}$gesvd('N','O',n,n,a,lda,s,u,ldu,v,ldv,cdummy,-1, &
                                  rdummy,ierr)
                     else
                        call la_${ri}$gesvd('O','N',n,n,a,lda,s,u,ldu,v,ldv,cdummy,-1, &
                                  rdummy,ierr)
                     end if
                     lwrk_${ri}$gesvd = int(cdummy(1),KIND=ilp)
                     if (conda) then
                         optwrk = n + max(lwrk_${ri}$geqp3,lwcon,lwrk_${ri}$gesvd,lwrk_${ri}$unmqr)
                     else
                         optwrk = n + max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd,lwrk_${ri}$unmqr)
                     end if
                  end if
              else if (rsvec .and. (.not. lsvec)) then
                  ! Minimal And Optimal Sizes Of The Complex Workspace If The
                  ! singular values and the right singular vectors are requested
                  if (conda) then
                      minwrk = n + max(lwqp3,lwcon,lwsvd)
                  else
                      minwrk = n + max(lwqp3,lwsvd)
                  end if
                  if (lquery) then
                      if (rtrans) then
                          call la_${ri}$gesvd('O','N',n,n,a,lda,s,u,ldu,v,ldv,cdummy,- &
                                    1,rdummy,ierr)
                      else
                          call la_${ri}$gesvd('N','O',n,n,a,lda,s,u,ldu,v,ldv,cdummy,- &
                                    1,rdummy,ierr)
                      end if
                      lwrk_${ri}$gesvd = int(cdummy(1),KIND=ilp)
                      if (conda) then
                          optwrk = n + max(lwrk_${ri}$geqp3,lwcon,lwrk_${ri}$gesvd)
                      else
                          optwrk = n + max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd)
                      end if
                  end if
              else
                  ! Minimal And Optimal Sizes Of The Complex Workspace If The
                  ! full svd is requested
                  if (rtrans) then
                      minwrk = max(lwqp3,lwsvd,lwunq)
                      if (conda) minwrk = max(minwrk,lwcon)
                      minwrk = minwrk + n
                      if (wntva) then
                         ! .. minimal workspace length for n x n/2 la_${ri}$geqrf
                         lwqrf = max(n/2,1)
                         ! .. minimal workspace length for n/2 x n/2 la_${ri}$gesvd
                         lwsvd2 = max(3*(n/2),1)
                         lwunq2 = max(n,1)
                         minwrk2 = max(lwqp3,n/2 + lwqrf,n/2 + lwsvd2,n/2 + lwunq2,lwunq)
                         if (conda) minwrk2 = max(minwrk2,lwcon)
                         minwrk2 = n + minwrk2
                         minwrk = max(minwrk,minwrk2)
                      end if
                  else
                      minwrk = max(lwqp3,lwsvd,lwunq)
                      if (conda) minwrk = max(minwrk,lwcon)
                      minwrk = minwrk + n
                      if (wntva) then
                         ! .. minimal workspace length for n/2 x n la_${ri}$gelqf
                         lwlqf = max(n/2,1)
                         lwsvd2 = max(3*(n/2),1)
                         lwunlq = max(n,1)
                         minwrk2 = max(lwqp3,n/2 + lwlqf,n/2 + lwsvd2,n/2 + lwunlq,lwunq)
                         if (conda) minwrk2 = max(minwrk2,lwcon)
                         minwrk2 = n + minwrk2
                         minwrk = max(minwrk,minwrk2)
                      end if
                  end if
                  if (lquery) then
                     if (rtrans) then
                        call la_${ri}$gesvd('O','A',n,n,a,lda,s,u,ldu,v,ldv,cdummy,-1, &
                                  rdummy,ierr)
                        lwrk_${ri}$gesvd = int(cdummy(1),KIND=ilp)
                        optwrk = max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd,lwrk_${ri}$unmqr)
                        if (conda) optwrk = max(optwrk,lwcon)
                        optwrk = n + optwrk
                        if (wntva) then
                            call la_${ri}$geqrf(n,n/2,u,ldu,cdummy,cdummy,-1,ierr)
                            lwrk_${ri}$geqrf = int(cdummy(1),KIND=ilp)
                            call la_${ri}$gesvd('S','O',n/2,n/2,v,ldv,s,u,ldu,v,ldv,cdummy, &
                                       -1,rdummy,ierr)
                            lwrk_${ri}$gesvd2 = int(cdummy(1),KIND=ilp)
                            call la_${ri}$unmqr('R','C',n,n,n/2,u,ldu,cdummy,v,ldv, &
                                      cdummy,-1,ierr)
                            lwrk_${ri}$unmqr2 = int(cdummy(1),KIND=ilp)
                            optwrk2 = max(lwrk_${ri}$geqp3,n/2 + lwrk_${ri}$geqrf,n/2 + lwrk_${ri}$gesvd2,n/2 + &
                                      lwrk_${ri}$unmqr2)
                            if (conda) optwrk2 = max(optwrk2,lwcon)
                            optwrk2 = n + optwrk2
                            optwrk = max(optwrk,optwrk2)
                        end if
                     else
                        call la_${ri}$gesvd('S','O',n,n,a,lda,s,u,ldu,v,ldv,cdummy,-1, &
                                  rdummy,ierr)
                        lwrk_${ri}$gesvd = int(cdummy(1),KIND=ilp)
                        optwrk = max(lwrk_${ri}$geqp3,lwrk_${ri}$gesvd,lwrk_${ri}$unmqr)
                        if (conda) optwrk = max(optwrk,lwcon)
                        optwrk = n + optwrk
                        if (wntva) then
                           call la_${ri}$gelqf(n/2,n,u,ldu,cdummy,cdummy,-1,ierr)
                           lwrk_${ri}$gelqf = int(cdummy(1),KIND=ilp)
                           call la_${ri}$gesvd('S','O',n/2,n/2,v,ldv,s,u,ldu,v,ldv,cdummy, &
                                      -1,rdummy,ierr)
                           lwrk_${ri}$gesvd2 = int(cdummy(1),KIND=ilp)
                           call la_${ri}$unmlq('R','N',n,n,n/2,u,ldu,cdummy,v,ldv,cdummy, &
                                     -1,ierr)
                           lwrk_${ri}$unmlq = int(cdummy(1),KIND=ilp)
                           optwrk2 = max(lwrk_${ri}$geqp3,n/2 + lwrk_${ri}$gelqf,n/2 + lwrk_${ri}$gesvd2,n/2 + &
                                     lwrk_${ri}$unmlq)
                            if (conda) optwrk2 = max(optwrk2,lwcon)
                            optwrk2 = n + optwrk2
                            optwrk = max(optwrk,optwrk2)
                        end if
                     end if
                  end if
              end if
              minwrk = max(2,minwrk)
              optwrk = max(2,optwrk)
              if (lcwork < minwrk .and. (.not. lquery)) info = -19
           end if
           if (info == 0 .and. lrwork < rminwrk .and. .not. lquery) then
              info = -21
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESVDQ',-info)
              return
           else if (lquery) then
           ! return optimal workspace
               iwork(1) = iminwrk
               cwork(1) = optwrk
               cwork(2) = minwrk
               rwork(1) = rminwrk
               return
           end if
           ! quick return if the matrix is void.
           if ((m == 0) .or. (n == 0)) then
           ! All Output Is Void
              return
           end if
           big = la_${ci}$lamch('O')
           ascaled = .false.
           if (rowprm) then
                 ! Reordering The Rows In Decreasing Sequence In The
                 ! ell-infinity norm - this enhances numerical robustness in
                 ! the case of differently scaled rows.
                 do p = 1,m
                     ! rwork(p) = abs( a(p,la_i${ri}$amax(n,a(p,1),lda)) )
                     ! [[la_${ri}$lange will return nan if an entry of the p-th row is nan]]
                     rwork(p) = la_${ri}$lange('M',1,n,a(p,1),lda,rdummy)
                     ! .. check for nan's and inf's
                     if ((rwork(p) /= rwork(p)) .or. ((rwork(p)*zero) /= zero)) then
                         info = -8
                         call la_xerbla('${ri.upper()}$GESVDQ',-info)
                         return
                     end if
                 end do
                 do p = 1,m - 1
                 q = la_i${ci}$amax(m - p + 1,rwork(p),1) + p - 1
                 iwork(n + p) = q
                 if (p /= q) then
                    rtmp = rwork(p)
                    rwork(p) = rwork(q)
                    rwork(q) = rtmp
                 end if
                 end do
                 if (rwork(1) == zero) then
                    ! quick return: a is the m x n zero matrix.
                    numrank = 0
                    call la_${ci}$laset('G',n,1,zero,zero,s,n)
                    if (wntus) call la_${ri}$laset('G',m,n,czero,cone,u,ldu)
                    if (wntua) call la_${ri}$laset('G',m,m,czero,cone,u,ldu)
                    if (wntva) call la_${ri}$laset('G',n,n,czero,cone,v,ldv)
                    if (wntuf) then
                        call la_${ri}$laset('G',n,1,czero,czero,cwork,n)
                        call la_${ri}$laset('G',m,n,czero,cone,u,ldu)
                    end if
                    do p = 1,n
                        iwork(p) = p
                    end do
                    if (rowprm) then
                        do p = n + 1,n + m - 1
                            iwork(p) = p - n
                        end do
                    end if
                    if (conda) rwork(1) = -1
                    rwork(2) = -1
                    return
                 end if
                 if (rwork(1) > big/sqrt(real(m,KIND=${rk}$))) then
                     ! .. to prevent overflow in the qr factorization, scale the
                     ! matrix by 1/sqrt(m) if too large entry detected
                     call la_${ri}$lascl('G',0,0,sqrt(real(m,KIND=${rk}$)),one,m,n,a,lda,ierr)

                     ascaled = .true.
                 end if
                 call la_${ri}$laswp(n,a,lda,1,m - 1,iwork(n + 1),1)
           end if
          ! .. at this stage, preemptive scaling is done only to avoid column
          ! norms overflows during the qr factorization. the svd procedure should
          ! have its own scaling to save the singular values from overflows and
          ! underflows. that depends on the svd procedure.
           if (.not. rowprm) then
               rtmp = la_${ri}$lange('M',m,n,a,lda,rwork)
               if ((rtmp /= rtmp) .or. ((rtmp*zero) /= zero)) then
                    info = -8
                    call la_xerbla('${ri.upper()}$GESVDQ',-info)
                    return
               end if
               if (rtmp > big/sqrt(real(m,KIND=${rk}$))) then
                   ! .. to prevent overflow in the qr factorization, scale the
                   ! matrix by 1/sqrt(m) if too large entry detected
                   call la_${ri}$lascl('G',0,0,sqrt(real(m,KIND=${rk}$)),one,m,n,a,lda,ierr)

                   ascaled = .true.
               end if
           end if
           ! Qr Factorization With Column Pivoting
           ! a * p = q * [ r ]
                       ! [ 0 ]
           do p = 1,n
              ! All Columns Are Free Columns
              iwork(p) = 0
           end do
           call la_${ri}$geqp3(m,n,a,lda,iwork,cwork,cwork(n + 1),lcwork - n,rwork,ierr)

          ! if the user requested accuracy level allows truncation in the
          ! computed upper triangular factor, the matrix r is examined and,
          ! if possible, replaced with its leading upper trapezoidal part.
           epsln = la_${ci}$lamch('E')
           sfmin = la_${ci}$lamch('S')
           ! small = sfmin / epsln
           nr = n
           if (accla) then
              ! standard absolute error bound suffices. all sigma_i with
              ! sigma_i < n*eps*||a||_f are flushed to zero. this is an
              ! aggressive enforcement of lower numerical rank by introducing a
              ! backward error of the order of n*eps*||a||_f.
              nr = 1
              rtmp = sqrt(real(n,KIND=${rk}$))*epsln
              do p = 2,n
                 if (abs(a(p,p)) < (rtmp*abs(a(1,1)))) go to 3002
                    nr = nr + 1
              end do
              3002 continue
           elseif (acclm) then
              ! .. similarly as above, only slightly more gentle (less aggressive).
              ! sudden drop on the diagonal of r is used as the criterion for being
              ! close-to-rank-deficient. the threshold is set to epsln=la_${ci}$lamch('e').
              ! [[this can be made more flexible by replacing this hard-coded value
              ! with a user specified threshold.]] also, the values that underflow
              ! will be truncated.
              nr = 1
              do p = 2,n
                 if ((abs(a(p,p)) < (epsln*abs(a(p - 1,p - 1)))) .or. (abs(a(p,p)) < sfmin)) go &
                           to 3402
                 nr = nr + 1
              end do
              3402 continue
           else
              ! Rrqr Not Authorized To Determine Numerical Rank Except In The
              ! obvious case of zero pivots.
              ! .. inspect r for exact zeros on the diagonal;
              ! r(i,i)=0 => r(i:n,i:n)=0.
              nr = 1
              do p = 2,n
                 if (abs(a(p,p)) == zero) go to 3502
                 nr = nr + 1
              end do
              3502 continue
              if (conda) then
                 ! estimate the scaled condition number of a. use the fact that it is
                 ! the same as the scaled condition number of r.
                    ! V Is Used As Workspace
                    call la_${ri}$lacpy('U',n,n,a,lda,v,ldv)
                    ! only the leading nr x nr submatrix of the triangular factor
                    ! is considered. only if nr=n will this give a reliable error
                    ! bound. however, even for nr < n, this can be used on an
                    ! expert level and obtain useful information in the sense of
                    ! perturbation theory.
                    do p = 1,nr
                       rtmp = la_${ci}$${ri}$nrm2(p,v(1,p),1)
                       call la_${ri}$${ci}$scal(p,one/rtmp,v(1,p),1)
                    end do
                    if (.not. (lsvec .or. rsvec)) then
                        call la_${ri}$pocon('U',nr,v,ldv,one,rtmp,cwork,rwork,ierr)

                    else
                        call la_${ri}$pocon('U',nr,v,ldv,one,rtmp,cwork(n + 1),rwork,ierr)

                    end if
                    sconda = one/sqrt(rtmp)
                 ! for nr=n, sconda is an estimate of sqrt(||(r^* * r)^(-1)||_1),
                 ! n^(-1/4) * sconda <= ||r^(-1)||_2 <= n^(1/4) * sconda
                 ! see the reference [1] for more details.
              end if
           end if
           if (wntur) then
               n1 = nr
           else if (wntus .or. wntuf) then
               n1 = n
           else if (wntua) then
               n1 = m
           end if
           if (.not. (rsvec .or. lsvec)) then
      ! .......................................................................
              ! Only The Singular Values Are Requested
      ! .......................................................................
              if (rtrans) then
               ! .. compute the singular values of r**h = [a](1:nr,1:n)**h
                 ! .. set the lower triangle of [a] to [a](1:nr,1:n)**h and
                 ! the upper triangle of [a] to zero.
                 do p = 1,min(n,nr)
                    a(p,p) = conjg(a(p,p))
                    do q = p + 1,n
                       a(q,p) = conjg(a(p,q))
                       if (q <= nr) a(p,q) = czero
                    end do
                 end do
                 call la_${ri}$gesvd('N','N',n,nr,a,lda,s,u,ldu,v,ldv,cwork,lcwork, &
                           rwork,info)
              else
                 ! .. compute the singular values of r = [a](1:nr,1:n)
                 if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,a(2,1),lda)

                 call la_${ri}$gesvd('N','N',nr,n,a,lda,s,u,ldu,v,ldv,cwork,lcwork, &
                           rwork,info)
              end if
           else if (lsvec .and. (.not. rsvec)) then
      ! .......................................................................
             ! The Singular Values And The Left Singular Vectors Requested
      ! .......................................................................""""""""
              if (rtrans) then
                  ! .. apply la_${ri}$gesvd to r**h
                  ! .. copy r**h into [u] and overwrite [u] with the right singular
                  ! vectors of r
                 do p = 1,nr
                    do q = p,n
                       u(q,p) = conjg(a(p,q))
                    end do
                 end do
                 if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,u(1,2),ldu)

                 ! .. the left singular vectors not computed, the nr right singular
                 ! vectors overwrite [u](1:nr,1:nr) as conjugate transposed. these
                 ! will be pre-multiplied by q to build the left singular vectors of a.
                    call la_${ri}$gesvd('N','O',n,nr,u,ldu,s,u,ldu,u,ldu,cwork(n + 1), &
                              lcwork - n,rwork,info)
                    do p = 1,nr
                        u(p,p) = conjg(u(p,p))
                        do q = p + 1,nr
                           ctmp = conjg(u(q,p))
                           u(q,p) = conjg(u(p,q))
                           u(p,q) = ctmp
                        end do
                    end do
              else
                  ! Apply la_${ri}$gesvd To R
                  ! .. copy r into [u] and overwrite [u] with the left singular vectors
                  call la_${ri}$lacpy('U',nr,n,a,lda,u,ldu)
                  if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,u(2,1),ldu)

                  ! .. the right singular vectors not computed, the nr left singular
                  ! vectors overwrite [u](1:nr,1:nr)
                     call la_${ri}$gesvd('O','N',nr,n,u,ldu,s,u,ldu,v,ldv,cwork(n + 1), &
                               lcwork - n,rwork,info)
                     ! .. now [u](1:nr,1:nr) contains the nr left singular vectors of
                     ! r. these will be pre-multiplied by q to build the left singular
                     ! vectors of a.
              end if
                 ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x nr) or (m x n) or (m x m).
              if ((nr < m) .and. (.not. wntuf)) then
                  call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                  if (nr < n1) then
                     call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                     call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)
                  end if
              end if
                 ! the q matrix from the first qrf is built into the left singular
                 ! vectors matrix u.
              if (.not. wntuf) call la_${ri}$unmqr('L','N',m,n1,n,a,lda,cwork,u,ldu, &
                        cwork(n + 1),lcwork - n,ierr)
              if (rowprm .and. .not. wntuf) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(n + 1),- &
                        1)
           else if (rsvec .and. (.not. lsvec)) then
      ! .......................................................................
             ! The Singular Values And The Right Singular Vectors Requested
      ! .......................................................................
               if (rtrans) then
                  ! .. apply la_${ri}$gesvd to r**h
                  ! .. copy r**h into v and overwrite v with the left singular vectors
                 do p = 1,nr
                    do q = p,n
                       v(q,p) = conjg(a(p,q))
                    end do
                 end do
                 if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)

                 ! .. the left singular vectors of r**h overwrite v, the right singular
                 ! vectors not computed
                 if (wntvr .or. (nr == n)) then
                    call la_${ri}$gesvd('O','N',n,nr,v,ldv,s,u,ldu,u,ldu,cwork(n + 1), &
                              lcwork - n,rwork,info)
                    do p = 1,nr
                        v(p,p) = conjg(v(p,p))
                        do q = p + 1,nr
                           ctmp = conjg(v(q,p))
                           v(q,p) = conjg(v(p,q))
                           v(p,q) = ctmp
                        end do
                    end do
                    if (nr < n) then
                        do p = 1,nr
                           do q = nr + 1,n
                               v(p,q) = conjg(v(q,p))
                           end do
                        end do
                    end if
                    call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                 else
                     ! .. need all n right singular vectors and nr < n
                     ! [!] this is simple implementation that augments [v](1:n,1:nr)
                     ! by padding a zero block. in the case nr << n, a more efficient
                     ! way is to first use the qr factorization. for more details
                     ! how to implement this, see the " full svd " branch.
                     call la_${ri}$laset('G',n,n - nr,czero,czero,v(1,nr + 1),ldv)
                     call la_${ri}$gesvd('O','N',n,n,v,ldv,s,u,ldu,u,ldu,cwork(n + 1), &
                               lcwork - n,rwork,info)
                     do p = 1,n
                        v(p,p) = conjg(v(p,p))
                        do q = p + 1,n
                           ctmp = conjg(v(q,p))
                           v(q,p) = conjg(v(p,q))
                           v(p,q) = ctmp
                        end do
                     end do
                     call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                 end if
               else
                  ! Aply la_${ri}$gesvd To R
                  ! Copy R Into V And Overwrite V With The Right Singular Vectors
                  call la_${ri}$lacpy('U',nr,n,a,lda,v,ldv)
                  if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,v(2,1),ldv)

                  ! .. the right singular vectors overwrite v, the nr left singular
                  ! vectors stored in u(1:nr,1:nr)
                  if (wntvr .or. (nr == n)) then
                     call la_${ri}$gesvd('N','O',nr,n,v,ldv,s,u,ldu,v,ldv,cwork(n + 1), &
                               lcwork - n,rwork,info)
                     call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                     ! .. now [v](1:nr,1:n) contains v(1:n,1:nr)**h
                  else
                     ! .. need all n right singular vectors and nr < n
                     ! [!] this is simple implementation that augments [v](1:nr,1:n)
                     ! by padding a zero block. in the case nr << n, a more efficient
                     ! way is to first use the lq factorization. for more details
                     ! how to implement this, see the " full svd " branch.
                      call la_${ri}$laset('G',n - nr,n,czero,czero,v(nr + 1,1),ldv)
                      call la_${ri}$gesvd('N','O',n,n,v,ldv,s,u,ldu,v,ldv,cwork(n + 1), &
                                lcwork - n,rwork,info)
                      call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                  end if
                  ! .. now [v] contains the adjoint of the matrix of the right singular
                  ! vectors of a.
               end if
           else
      ! .......................................................................
             ! Full Svd Requested
      ! .......................................................................
              if (rtrans) then
                  ! .. apply la_${ri}$gesvd to r**h [[this option is left for r
                 if (wntvr .or. (nr == n)) then
                  ! .. copy r**h into [v] and overwrite [v] with the left singular
                  ! vectors of r**h
                 do p = 1,nr
                    do q = p,n
                       v(q,p) = conjg(a(p,q))
                    end do
                 end do
                 if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)

                 ! .. the left singular vectors of r**h overwrite [v], the nr right
                 ! singular vectors of r**h stored in [u](1:nr,1:nr) as conjugate
                 ! transposed
                    call la_${ri}$gesvd('O','A',n,nr,v,ldv,s,v,ldv,u,ldu,cwork(n + 1), &
                              lcwork - n,rwork,info)
                    ! Assemble V
                    do p = 1,nr
                       v(p,p) = conjg(v(p,p))
                       do q = p + 1,nr
                          ctmp = conjg(v(q,p))
                          v(q,p) = conjg(v(p,q))
                          v(p,q) = ctmp
                       end do
                    end do
                    if (nr < n) then
                        do p = 1,nr
                           do q = nr + 1,n
                              v(p,q) = conjg(v(q,p))
                           end do
                        end do
                    end if
                    call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                     do p = 1,nr
                        u(p,p) = conjg(u(p,p))
                        do q = p + 1,nr
                           ctmp = conjg(u(q,p))
                           u(q,p) = conjg(u(p,q))
                           u(p,q) = ctmp
                        end do
                     end do
                     if ((nr < m) .and. .not. (wntuf)) then
                       call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                       if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)

                       end if
                    end if
                 else
                     ! .. need all n right singular vectors and nr < n
                  ! .. copy r**h into [v] and overwrite [v] with the left singular
                  ! vectors of r**h
                     ! [[the optimal ratio n/nr for using qrf instead of padding
                       ! with zeros. here hard coded to 2; it must be at least
                       ! two due to work space constraints.]]
                     ! optratio = la_ilaenv(6, '${ri}$gesvd', 's' // 'o', nr,n,0,0)
                     ! optratio = max( optratio, 2 )
                     optratio = 2
                     if (optratio*nr > n) then
                        do p = 1,nr
                           do q = p,n
                              v(q,p) = conjg(a(p,q))
                           end do
                        end do
                        if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)

                        call la_${ri}$laset('A',n,n - nr,czero,czero,v(1,nr + 1),ldv)
                        call la_${ri}$gesvd('O','A',n,n,v,ldv,s,v,ldv,u,ldu,cwork(n + 1), &
                                  lcwork - n,rwork,info)
                        do p = 1,n
                           v(p,p) = conjg(v(p,p))
                           do q = p + 1,n
                              ctmp = conjg(v(q,p))
                              v(q,p) = conjg(v(p,q))
                              v(p,q) = ctmp
                           end do
                        end do
                        call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                    ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x n1), i.e. (m x n) or (m x m).
                        do p = 1,n
                           u(p,p) = conjg(u(p,p))
                           do q = p + 1,n
                              ctmp = conjg(u(q,p))
                              u(q,p) = conjg(u(p,q))
                              u(p,q) = ctmp
                           end do
                        end do
                        if ((n < m) .and. .not. (wntuf)) then
                           call la_${ri}$laset('A',m - n,n,czero,czero,u(n + 1,1),ldu)
                           if (n < n1) then
                             call la_${ri}$laset('A',n,n1 - n,czero,czero,u(1,n + 1),ldu)
                             call la_${ri}$laset('A',m - n,n1 - n,czero,cone,u(n + 1,n + 1),ldu)
                           end if
                        end if
                     else
                        ! .. copy r**h into [u] and overwrite [u] with the right
                        ! singular vectors of r
                        do p = 1,nr
                           do q = p,n
                              u(q,nr + p) = conjg(a(p,q))
                           end do
                        end do
                        if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,u(1,nr + 2),ldu)

                        call la_${ri}$geqrf(n,nr,u(1,nr + 1),ldu,cwork(n + 1),cwork(n + nr + 1), &
                                  lcwork - n - nr,ierr)
                        do p = 1,nr
                            do q = 1,n
                                v(q,p) = conjg(u(p,nr + q))
                            end do
                        end do
                       call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
                       call la_${ri}$gesvd('S','O',nr,nr,v,ldv,s,u,ldu,v,ldv,cwork(n + nr + &
                                 1),lcwork - n - nr,rwork,info)
                       call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
                       call la_${ri}$unmqr('R','C',n,n,nr,u(1,nr + 1),ldu,cwork(n + 1),v,ldv, &
                                 cwork(n + nr + 1),lcwork - n - nr,ierr)
                       call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                       ! Assemble The Left Singular Vector Matrix U Of Dimensions
                       ! (m x nr) or (m x n) or (m x m).
                       if ((nr < m) .and. .not. (wntuf)) then
                          call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                          if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)
                          end if
                       end if
                     end if
                 end if
              else
                  ! .. apply la_${ri}$gesvd to r [[this is the recommended option]]
                  if (wntvr .or. (nr == n)) then
                      ! .. copy r into [v] and overwrite v with the right singular vectors
                      call la_${ri}$lacpy('U',nr,n,a,lda,v,ldv)
                     if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,v(2,1),ldv)

                     ! .. the right singular vectors of r overwrite [v], the nr left
                     ! singular vectors of r stored in [u](1:nr,1:nr)
                     call la_${ri}$gesvd('S','O',nr,n,v,ldv,s,u,ldu,v,ldv,cwork(n + 1), &
                               lcwork - n,rwork,info)
                     call la_${ri}$lapmt(.false.,nr,n,v,ldv,iwork)
                     ! .. now [v](1:nr,1:n) contains v(1:n,1:nr)**h
                     ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x nr) or (m x n) or (m x m).
                    if ((nr < m) .and. .not. (wntuf)) then
                       call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                       if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)

                       end if
                    end if
                  else
                    ! .. need all n right singular vectors and nr < n
                    ! The Requested Number Of The Left Singular Vectors
                     ! is then n1 (n or m)
                     ! [[the optimal ratio n/nr for using lq instead of padding
                       ! with zeros. here hard coded to 2; it must be at least
                       ! two due to work space constraints.]]
                     ! optratio = la_ilaenv(6, '${ri}$gesvd', 's' // 'o', nr,n,0,0)
                     ! optratio = max( optratio, 2 )
                    optratio = 2
                    if (optratio*nr > n) then
                       call la_${ri}$lacpy('U',nr,n,a,lda,v,ldv)
                       if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,v(2,1),ldv)

                    ! .. the right singular vectors of r overwrite [v], the nr left
                       ! singular vectors of r stored in [u](1:nr,1:nr)
                       call la_${ri}$laset('A',n - nr,n,czero,czero,v(nr + 1,1),ldv)
                       call la_${ri}$gesvd('S','O',n,n,v,ldv,s,u,ldu,v,ldv,cwork(n + 1), &
                                 lcwork - n,rwork,info)
                       call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                       ! .. now [v] contains the adjoint of the matrix of the right
                       ! singular vectors of a. the leading n left singular vectors
                       ! are in [u](1:n,1:n)
                       ! Assemble The Left Singular Vector Matrix U Of Dimensions
                       ! (m x n1), i.e. (m x n) or (m x m).
                       if ((n < m) .and. .not. (wntuf)) then
                           call la_${ri}$laset('A',m - n,n,czero,czero,u(n + 1,1),ldu)
                           if (n < n1) then
                             call la_${ri}$laset('A',n,n1 - n,czero,czero,u(1,n + 1),ldu)
                             call la_${ri}$laset('A',m - n,n1 - n,czero,cone,u(n + 1,n + 1),ldu)
                           end if
                       end if
                    else
                       call la_${ri}$lacpy('U',nr,n,a,lda,u(nr + 1,1),ldu)
                       if (nr > 1) call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,u(nr + 2,1),ldu)

                       call la_${ri}$gelqf(nr,n,u(nr + 1,1),ldu,cwork(n + 1),cwork(n + nr + 1), &
                                 lcwork - n - nr,ierr)
                       call la_${ri}$lacpy('L',nr,nr,u(nr + 1,1),ldu,v,ldv)
                       if (nr > 1) call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)

                       call la_${ri}$gesvd('S','O',nr,nr,v,ldv,s,u,ldu,v,ldv,cwork(n + nr + &
                                 1),lcwork - n - nr,rwork,info)
                       call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
                       call la_${ri}$unmlq('R','N',n,n,nr,u(nr + 1,1),ldu,cwork(n + 1),v,ldv,cwork(n + &
                                 nr + 1),lcwork - n - nr,ierr)
                       call la_${ri}$lapmt(.false.,n,n,v,ldv,iwork)
                     ! Assemble The Left Singular Vector Matrix U Of Dimensions
                    ! (m x nr) or (m x n) or (m x m).
                       if ((nr < m) .and. .not. (wntuf)) then
                          call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                          if (nr < n1) then
                          call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                          call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)

                          end if
                       end if
                    end if
                  end if
              ! .. end of the "r**h or r" branch
              end if
                 ! the q matrix from the first qrf is built into the left singular
                 ! vectors matrix u.
              if (.not. wntuf) call la_${ri}$unmqr('L','N',m,n1,n,a,lda,cwork,u,ldu, &
                        cwork(n + 1),lcwork - n,ierr)
              if (rowprm .and. .not. wntuf) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(n + 1),- &
                        1)
           ! ... end of the "full svd" branch
           end if
           ! check whether some singular values are returned as zeros, e.g.
           ! due to underflow, and update the numerical rank.
           p = nr
           do q = p,1,-1
               if (s(q) > zero) go to 4002
               nr = nr - 1
           end do
           4002 continue
           ! .. if numerical rank deficiency is detected, the truncated
           ! singular values are set to zero.
           if (nr < n) call la_${ci}$laset('G',n - nr,1,zero,zero,s(nr + 1),n)
           ! .. undo scaling; this may cause overflow in the largest singular
           ! values.
           if (ascaled) call la_${ci}$lascl('G',0,0,one,sqrt(real(m,KIND=${rk}$)),nr,1,s,n,ierr &
                     )
           if (conda) rwork(1) = sconda
           rwork(2) = p - nr
           ! .. p-nr is the number of singular values that are computed as
           ! exact zeros in la_${ri}$gesvd() applied to the (possibly truncated)
           ! full row rank triangular (trapezoidal) factor of a.
           numrank = nr
           return
     end subroutine la_${ri}$gesvdq
#:endfor

end module la_lapack_eigv_svd_drivers
