    &  {'complex': '               pure subroutine {ri}laqsb(uplo,n,kd,ab,ldab,s,scond,amax,equed)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(out) :: equed\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: kd,ldab,n\n                    real({rk}),intent(in) :: amax,scond,s(*)\n                    {rt},intent(inout) :: ab(ldab,*)\n               end subroutine {ri}laqsb', 'real': '               pure subroutine {ri}laqsb(uplo,n,kd,ab,ldab,s,scond,amax,equed)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(out) :: equed\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: kd,ldab,n\n                    {rt},intent(in) :: amax,scond,s(*)\n                    {rt},intent(inout) :: ab(ldab,*)\n               end subroutine {ri}laqsb'}), &
    & ('laqsp', ['LAQSP: equilibrates a symmetric matrix A using the scaling factors', 'in the vector S.'], &
