    & ('hfrk', ['Level 3 BLAS like routine for C in RFP Format.', 'HFRK: performs one of the Hermitian rank--k operations', 'C := alpha*A*A**H + beta*C,', 'or', 'C := alpha*A**H*A + beta*C,', 'where alpha and beta are real scalars, C is an n--by--n Hermitian', 'matrix and A is an n--by--k matrix in the first case and a k--by--n', 'matrix in the second case.'], &
    &  [('chfrk', 'chfrk', 'complex'), ('whfrk', 'whfrk', None), ('yhfrk', 'yhfrk', None), ('zhfrk', 'zhfrk', 'complex')], &
    &  {'complex': '               pure subroutine {ri}hfrk(transr,uplo,trans,n,k,alpha,a,lda,beta,c)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    real({rk}),intent(in) :: alpha,beta\n                    integer(ilp),intent(in) :: k,lda,n\n                    character,intent(in) :: trans,transr,uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: c(*)\n               end subroutine {ri}hfrk'}), &
    & ('hgeqz', ['HGEQZ: computes the eigenvalues of a complex matrix pair (H,T),', 'where H is an upper Hessenberg matrix and T is upper triangular,', 'using the single-shift QZ method.', 'Matrix pairs of this type are produced by the reduction to', 'generalized upper Hessenberg form of a complex matrix pair (A,B):', 'A = Q1*H*Z1**H,  B = Q1*T*Z1**H,', 'as computed by CGGHRD.', "If JOB='S', then the Hessenberg-triangular pair (H,T) is", 'also reduced to generalized Schur form,', 'H = Q*S*Z**H,  T = Q*P*Z**H,', 'where Q and Z are unitary matrices and S and P are upper triangular.', 'Optionally, the unitary matrix Q from the generalized Schur', 'factorization may be postmultiplied into an input matrix Q1, and the', 'unitary matrix Z may be postmultiplied into an input matrix Z1.', 'If Q1 and Z1 are the unitary matrices from CGGHRD that reduced', 'the matrix pair (A,B) to generalized Hessenberg form, then the output', 'matrices Q1*Q and Z1*Z are the unitary factors from the generalized', 'Schur factorization of (A,B):', 'A = (Q1*Q)*S*(Z1*Z)**H,  B = (Q1*Q)*P*(Z1*Z)**H.', 'To avoid overflow, eigenvalues of the matrix pair (H,T)', '(equivalently, of (A,B)) are computed as a pair of complex values', '(alpha,beta).  If beta is nonzero, lambda = alpha / beta is an', 'eigenvalue of the generalized nonsymmetric eigenvalue problem (GNEP)', 'A*x = lambda*B*x', 'and if alpha is nonzero, mu = beta / alpha is an eigenvalue of the', 'alternate form of the GNEP', 'mu*A*y = B*y.', 'The values of alpha and beta for the i-th eigenvalue can be read', 'directly from the generalized Schur form:  alpha = S(i,i),', 'beta = P(i,i).', 'Ref: C.B. Moler', 'Eigenvalue Problems", SIAM J. Numer. Anal., 10(1973),', 'pp. 241--256.'], &
    &  [('chgeqz', 'chgeqz', 'complex'), ('dhgeqz', 'dhgeqz', 'real'), ('qhgeqz', 'qhgeqz', None), ('shgeqz', 'shgeqz', 'real'), ('whgeqz', 'whgeqz', None), ('xhgeqz', 'xhgeqz', None), ('yhgeqz', 'yhgeqz', None), ('zhgeqz', 'zhgeqz', 'complex')], &
    &  {'complex': '               subroutine {ri}hgeqz(job,compq,compz,n,ilo,ihi,h,ldh,t,ldt,alpha,beta,q, &\n                         ldq,z,ldz,work,lwork,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compq,compz,job\n                    integer(ilp),intent(in) :: ihi,ilo,ldh,ldq,ldt,ldz,lwork,n\n                    integer(ilp),intent(out) :: info\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(out) :: alpha(*),beta(*),work(*)\n                    {rt},intent(inout) :: h(ldh,*),q(ldq,*),t(ldt,*),z(ldz,*)\n               end subroutine {ri}hgeqz', 'real': '               subroutine {ri}hgeqz(job,compq,compz,n,ilo,ihi,h,ldh,t,ldt,alphar,alphai, &\n                         beta,q,ldq,z,ldz,work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compq,compz,job\n                    integer(ilp),intent(in) :: ihi,ilo,ldh,ldq,ldt,ldz,lwork,n\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(out) :: alphai(*),alphar(*),beta(*),work(*)\n                    {rt},intent(inout) :: h(ldh,*),q(ldq,*),t(ldt,*),z(ldz,*)\n               end subroutine {ri}hgeqz'}), &
    & ('hpcon', ['HPCON: estimates the reciprocal of the condition number of a complex', 'Hermitian packed matrix A using the factorization A = U*D*U**H or', 'A = L*D*L**H computed by CHPTRF.', 'An estimate is obtained for norm(inv(A)), and the reciprocal of the', 'condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).'], &
    &  [('chpcon', 'chpcon', 'complex'), ('whpcon', 'whpcon', None), ('yhpcon', 'yhpcon', None), ('zhpcon', 'zhpcon', 'complex')], &
    &  {'complex': '               pure subroutine {ri}hpcon(uplo,n,ap,ipiv,anorm,rcond,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,ipiv(*)\n                    real({rk}),intent(in) :: anorm\n                    real({rk}),intent(out) :: rcond\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}hpcon'}), &
    & ('hpev', ['HPEV: computes all the eigenvalues and, optionally, eigenvectors of a', 'complex Hermitian matrix in packed storage.'], &
    &  [('chpev', 'chpev', 'complex'), ('whpev', 'whpev', None), ('yhpev', 'yhpev', None), ('zhpev', 'zhpev', 'complex')], &
    &  {'complex': '               subroutine {ri}hpev(jobz,uplo,n,ap,w,z,ldz,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldz,n\n                    real({rk}),intent(out) :: rwork(*),w(*)\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}hpev'}), &
    & ('hpevd', ['HPEVD: computes all the eigenvalues and, optionally, eigenvectors of', 'a complex Hermitian matrix A in packed storage.  If eigenvectors are', 'desired, it uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('chpevd', 'chpevd', 'complex'), ('whpevd', 'whpevd', None), ('yhpevd', 'yhpevd', None), ('zhpevd', 'zhpevd', 'complex')], &
    &  {'complex': '               subroutine {ri}hpevd(jobz,uplo,n,ap,w,z,ldz,work,lwork,rwork,lrwork,iwork, &\n                         liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldz,liwork,lrwork,lwork,n\n                    real({rk}),intent(out) :: rwork(*),w(*)\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}hpevd'}), &
    & ('hpgst', ['HPGST: reduces a complex Hermitian-definite generalized', 'eigenproblem to standard form, using packed storage.', 'If ITYPE = 1, the problem is A*x = lambda*B*x,', 'and A is overwritten by inv(U**H)*A*inv(U) or inv(L)*A*inv(L**H)', 'If ITYPE = 2 or 3, the problem is A*B*x = lambda*x or', 'B*A*x = lambda*x, and A is overwritten by U*A*U**H or L**H*A*L.', 'B must have been previously factorized as U**H*U or L*L**H by CPPTRF.'], &
    &  [('chpgst', 'chpgst', 'complex'), ('whpgst', 'whpgst', None), ('yhpgst', 'yhpgst', None), ('zhpgst', 'zhpgst', 'complex')], &
    &  {'complex': '               pure subroutine {ri}hpgst(itype,uplo,n,ap,bp,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: itype,n\n                    {rt},intent(inout) :: ap(*)\n                    {rt},intent(in) :: bp(*)\n               end subroutine {ri}hpgst'}), &
    & ('hpgv', ['HPGV: computes all the eigenvalues and, optionally, the eigenvectors', 'of a complex generalized Hermitian-definite eigenproblem, of the form', 'A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.', 'Here A and B are assumed to be Hermitian, stored in packed format,', 'and B is also positive definite.'], &
    &  [('chpgv', 'chpgv', 'complex'), ('whpgv', 'whpgv', None), ('yhpgv', 'yhpgv', None), ('zhpgv', 'zhpgv', 'complex')], &
    &  {'complex': '               subroutine {ri}hpgv(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,rwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: itype,ldz,n\n                    real({rk}),intent(out) :: rwork(*),w(*)\n                    {rt},intent(inout) :: ap(*),bp(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}hpgv'}), &
    & ('hpgvd', ['HPGVD: computes all the eigenvalues and, optionally, the eigenvectors', 'of a complex generalized Hermitian-definite eigenproblem, of the form', 'A*x=(lambda)*B*x,  A*Bx=(lambda)*x,  or B*A*x=(lambda)*x.  Here A and', 'B are assumed to be Hermitian, stored in packed format, and B is also', 'positive definite.', 'If eigenvectors are desired, it uses a divide and conquer algorithm.', 'The divide and conquer algorithm makes very mild assumptions about', 'floating point arithmetic. It will work on machines with a guard', 'digit in add/subtract, or on those binary machines without guard', 'digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or', 'Cray-2. It could conceivably fail on hexadecimal or decimal machines', 'without guard digits, but we know of none.'], &
    &  [('chpgvd', 'chpgvd', 'complex'), ('whpgvd', 'whpgvd', None), ('yhpgvd', 'yhpgvd', None), ('zhpgvd', 'zhpgvd', 'complex')], &
    &  {'complex': '               subroutine {ri}hpgvd(itype,jobz,uplo,n,ap,bp,w,z,ldz,work,lwork,rwork, &\n                         lrwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobz,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: itype,ldz,liwork,lrwork,lwork,n\n                    real({rk}),intent(out) :: rwork(*),w(*)\n                    {rt},intent(inout) :: ap(*),bp(*)\n                    {rt},intent(out) :: work(*),z(ldz,*)\n               end subroutine {ri}hpgvd'}), &
    & ('hprfs', ['HPRFS: improves the computed solution to a system of linear', 'equations when the coefficient matrix is Hermitian indefinite', 'and packed, and provides error bounds and backward error estimates', 'for the solution.'], &
    &  [('chprfs', 'chprfs', 'complex'), ('whprfs', 'whprfs', None), ('yhprfs', 'yhprfs', None), ('zhprfs', 'zhprfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}hprfs(uplo,n,nrhs,ap,afp,ipiv,b,ldb,x,ldx,ferr,berr, &\n                         work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs,ipiv(*)\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    {rt},intent(in) :: afp(*),ap(*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n                    {rt},intent(inout) :: x(ldx,*)\n               end subroutine {ri}hprfs'}), &
    & ('hpsv', ['HPSV: computes the solution to a complex system of linear equations', 'A * X = B,', 'where A is an N-by-N Hermitian matrix stored in packed format and X', 'and B are N-by-NRHS matrices.', 'The diagonal pivoting method is used to factor A as', "A = U * D * U**H,  if UPLO = 'U', or", "A = L * D * L**H,  if UPLO = 'L',", 'where U (or L) is a product of permutation and unit upper (lower)', 'triangular matrices, D is Hermitian and block diagonal with 1-by-1', 'and 2-by-2 diagonal blocks.  The factored form of A is then used to', 'solve the system of equations A * X = B.'], &
    &  [('chpsv', 'chpsv', 'complex'), ('whpsv', 'whpsv', None), ('yhpsv', 'yhpsv', None), ('zhpsv', 'zhpsv', 'complex')], &
