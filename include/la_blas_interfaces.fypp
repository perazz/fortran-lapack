    &  {'complex': '               pure subroutine {ri}trmv(uplo,trans,diag,n,a,lda,x,incx)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,lda,n\n                    character,intent(in) :: diag,trans,uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: x(*)\n               end subroutine {ri}trmv', 'real': '               pure subroutine {ri}trmv(uplo,trans,diag,n,a,lda,x,incx)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,lda,n\n                    character,intent(in) :: diag,trans,uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: x(*)\n               end subroutine {ri}trmv'}), &
    & ('trsm', ['TRSM:  solves one of the matrix equations', 'op( A )*X = alpha*B,   or   X*op( A ) = alpha*B,', 'where alpha is a scalar, X and B are m by n matrices, A is a unit, or', 'non-unit,  upper or lower triangular matrix  and  op( A )  is one  of', 'op( A ) = A   or   op( A ) = A**T   or   op( A ) = A**H.', 'The matrix X is overwritten on B.'], &
    &  [('ctrsm', 'ctrsm', True), ('dtrsm', 'dtrsm', True), ('qtrsm', 'qtrsm', False), ('strsm', 'strsm', True), ('wtrsm', 'wtrsm', False), ('ztrsm', 'ztrsm', True)], &
    &  {'complex': '               pure subroutine {ri}trsm(side,uplo,transa,diag,m,n,alpha,a,lda,b,ldb)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,a(lda,*)\n                    integer(ilp),intent(in) :: lda,ldb,m,n\n                    character,intent(in) :: diag,side,transa,uplo\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}trsm', 'real': '               pure subroutine {ri}trsm(side,uplo,transa,diag,m,n,alpha,a,lda,b,ldb)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(in) :: alpha,a(lda,*)\n                    integer(ilp),intent(in) :: lda,ldb,m,n\n                    character,intent(in) :: diag,side,transa,uplo\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}trsm'}), &
    & ('trsv', ['TRSV:  solves one of the systems of equations', 'A*x = b,   or   A**T*x = b,   or   A**H*x = b,', 'where b and x are n element vectors and A is an n by n unit, or', 'non-unit, upper or lower triangular matrix.', 'No test for singularity or near-singularity is included in this', 'routine. Such tests must be performed before calling this routine.'], &
    &  [('ctrsv', 'ctrsv', True), ('dtrsv', 'dtrsv', True), ('qtrsv', 'qtrsv', False), ('strsv', 'strsv', True), ('wtrsv', 'wtrsv', False), ('ztrsv', 'ztrsv', True)], &
    &  {'complex': '               pure subroutine {ri}trsv(uplo,trans,diag,n,a,lda,x,incx)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,lda,n\n                    character,intent(in) :: diag,trans,uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: x(*)\n               end subroutine {ri}trsv', 'real': '               pure subroutine {ri}trsv(uplo,trans,diag,n,a,lda,x,incx)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,lda,n\n                    character,intent(in) :: diag,trans,uplo\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: x(*)\n               end subroutine {ri}trsv'}), &
    & ]

#:endmute
