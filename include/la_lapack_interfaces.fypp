    &  {'complex': '               pure subroutine {ri}laqr5(wantt,wantz,kacc22,n,ktop,kbot,nshfts,s,h,ldh, &\n                         iloz,ihiz,z,ldz,v,ldv,u,ldu,nv,wv,ldwv,nh,wh,ldwh)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: ihiz,iloz,kacc22,kbot,ktop,ldh,ldu,ldv,ldwh,ldwv, &\n                              ldz,n,nh,nshfts,nv\n                    logical(lk),intent(in) :: wantt,wantz\n                    {rt},intent(inout) :: h(ldh,*),s(*),z(ldz,*)\n                    {rt},intent(out) :: u(ldu,*),v(ldv,*),wh(ldwh,*),wv(ldwv,*)\n               end subroutine {ri}laqr5', 'real': '               pure subroutine {ri}laqr5(wantt,wantz,kacc22,n,ktop,kbot,nshfts,sr,si,h,ldh, &\n                          iloz,ihiz,z,ldz,v,ldv,u,ldu,nv,wv,ldwv,nh,wh,ldwh)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: ihiz,iloz,kacc22,kbot,ktop,ldh,ldu,ldv,ldwh,ldwv, &\n                              ldz,n,nh,nshfts,nv\n                    logical(lk),intent(in) :: wantt,wantz\n                    {rt},intent(inout) :: h(ldh,*),si(*),sr(*),z(ldz,*)\n                    {rt},intent(out) :: u(ldu,*),v(ldv,*),wh(ldwh,*),wv(ldwv,*)\n               end subroutine {ri}laqr5'}), &
    & ('laqsb', ['LAQSB: equilibrates a symmetric band matrix A using the scaling', 'factors in the vector S.'], &
