     contains

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LAQSP: equilibrates a symmetric matrix A using the scaling factors
     !> in the vector S.

     pure subroutine la_${ri}$laqsp(uplo,n,ap,s,scond,amax,equed)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(inout) :: ap(*)
           real(${rk}$),intent(in) :: s(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j,jc
           real(${rk}$) :: cj,large,small
           ! Executable Statements
           ! quick return if possible
           if (n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ri}$lamch('SAFE MINIMUM')/la_${ri}$lamch('PRECISION')
           large = one/small
           if (scond >= thresh .and. amax >= small .and. amax <= large) then
              ! no equilibration
              equed = 'N'
           else
              ! replace a by diag(s) * a * diag(s).
              if (la_lsame(uplo,'U')) then
                 ! upper triangle of a is stored.
                 jc = 1
                 do j = 1,n
                    cj = s(j)
                    do i = 1,j
                       ap(jc + i - 1) = cj*s(i)*ap(jc + i - 1)
                    end do
                    jc = jc + j
                 end do
              else
                 ! lower triangle of a is stored.
                 jc = 1
                 do j = 1,n
                    cj = s(j)
                    do i = j,n
                       ap(jc + i - j) = cj*s(i)*ap(jc + i - j)
                    end do
                    jc = jc + n - j + 1
                 end do
              end if
              equed = 'Y'
           end if
           return
     end subroutine la_${ri}$laqsp
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBEQU: computes row and column scalings intended to equilibrate a
     !> symmetric positive definite band matrix A and reduce its condition
     !> number (with respect to the two-norm).  S contains the scale factors,
     !> S(i) = 1/sqrt(A(i,i)), chosen so that the scaled matrix B with
     !> elements B(i,j) = S(i)*A(i,j)*S(j) has ones on the diagonal.  This
     !> choice of S puts the condition number of B within a factor N of the
     !> smallest possible condition number over all possible diagonal
     !> scalings.

     pure subroutine la_${ri}$pbequ(uplo,n,kd,ab,ldab,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: ab(ldab,*)
           real(${rk}$),intent(out) :: s(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i,j
           real(${rk}$) :: smin
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBEQU',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           if (upper) then
              j = kd + 1
           else
              j = 1
           end if
           ! initialize smin and amax.
           s(1) = ab(j,1)
           smin = s(1)
           amax = s(1)
           ! find the minimum and maximum diagonal elements.
           do i = 2,n
              s(i) = ab(j,i)
              smin = min(smin,s(i))
              amax = max(amax,s(i))
           end do
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = one/sqrt(s(i))
              end do
              ! compute scond = min(s(i)) / max(s(i))
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$pbequ
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBTF2: computes the Cholesky factorization of a real symmetric
     !> positive definite band matrix A.
     !> The factorization has the form
     !> A = U**T * U ,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix, U**T is the transpose of U, and
     !> L is lower triangular.
     !> This is the unblocked version of the algorithm, calling Level 2 BLAS.

     pure subroutine la_${ri}$pbtf2(uplo,n,kd,ab,ldab,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,kld,kn
           real(${rk}$) :: ajj
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBTF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           kld = max(1,ldab - 1)
           if (upper) then
              ! compute the cholesky factorization a = u**t*u.
              do j = 1,n
                 ! compute u(j,j) and test for non-positive-definiteness.
                 ajj = ab(kd + 1,j)
                 if (ajj <= zero) go to 30
                 ajj = sqrt(ajj)
                 ab(kd + 1,j) = ajj
                 ! compute elements j+1:j+kn of row j and update the
                 ! trailing submatrix within the band.
                 kn = min(kd,n - j)
                 if (kn > 0) then
                    call la_${ri}$scal(kn,one/ajj,ab(kd,j + 1),kld)
                    call la_${ri}$syr('UPPER',kn,-one,ab(kd,j + 1),kld,ab(kd + 1,j + 1),kld)

                 end if
              end do
           else
              ! compute the cholesky factorization a = l*l**t.
              do j = 1,n
                 ! compute l(j,j) and test for non-positive-definiteness.
                 ajj = ab(1,j)
                 if (ajj <= zero) go to 30
                 ajj = sqrt(ajj)
                 ab(1,j) = ajj
                 ! compute elements j+1:j+kn of column j and update the
                 ! trailing submatrix within the band.
                 kn = min(kd,n - j)
                 if (kn > 0) then
                    call la_${ri}$scal(kn,one/ajj,ab(2,j),1)
                    call la_${ri}$syr('LOWER',kn,-one,ab(2,j),1,ab(1,j + 1),kld)
                 end if
              end do
           end if
           return
           30 continue
           info = j
           return
     end subroutine la_${ri}$pbtf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBTRS: solves a system of linear equations A*X = B with a symmetric
     !> positive definite band matrix A using the Cholesky factorization
     !> A = U**T*U or A = L*L**T computed by ${ri.upper()}$PBTRF.

     pure subroutine la_${ri}$pbtrs(uplo,n,kd,nrhs,ab,ldab,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: ab(ldab,*)
           real(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (nrhs < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (upper) then
              ! solve a*x = b where a = u**t *u.
              do j = 1,nrhs
                 ! solve u**t *x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b(1,j), &
                           1)
                 ! solve u*x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','NO TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b(1,j) &
                           ,1)
              end do
           else
              ! solve a*x = b where a = l*l**t.
              do j = 1,nrhs
                 ! solve l*x = b, overwriting b with x.
                 call la_${ri}$tbsv('LOWER','NO TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b(1,j) &
                           ,1)
                 ! solve l**t *x = b, overwriting b with x.
                 call la_${ri}$tbsv('LOWER','TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b(1,j), &
                           1)
              end do
           end if
           return
     end subroutine la_${ri}$pbtrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POEQU: computes row and column scalings intended to equilibrate a
     !> symmetric positive definite matrix A and reduce its condition number
     !> (with respect to the two-norm).  S contains the scale factors,
     !> S(i) = 1/sqrt(A(i,i)), chosen so that the scaled matrix B with
     !> elements B(i,j) = S(i)*A(i,j)*S(j) has ones on the diagonal.  This
     !> choice of S puts the condition number of B within a factor N of the
     !> smallest possible condition number over all possible diagonal
     !> scalings.

     pure subroutine la_${ri}$poequ(n,a,lda,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: a(lda,*)
           real(${rk}$),intent(out) :: s(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i
           real(${rk}$) :: smin
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (n < 0) then
              info = -1
           else if (lda < max(1,n)) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POEQU',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           ! find the minimum and maximum diagonal elements.
           s(1) = a(1,1)
           smin = s(1)
           amax = s(1)
           do i = 2,n
              s(i) = a(i,i)
              smin = min(smin,s(i))
              amax = max(amax,s(i))
           end do
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = one/sqrt(s(i))
              end do
              ! compute scond = min(s(i)) / max(s(i))
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$poequ
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POEQUB: computes row and column scalings intended to equilibrate a
     !> symmetric positive definite matrix A and reduce its condition number
     !> (with respect to the two-norm).  S contains the scale factors,
     !> S(i) = 1/sqrt(A(i,i)), chosen so that the scaled matrix B with
     !> elements B(i,j) = S(i)*A(i,j)*S(j) has ones on the diagonal.  This
     !> choice of S puts the condition number of B within a factor N of the
     !> smallest possible condition number over all possible diagonal
     !> scalings.
     !> This routine differs from ${ri.upper()}$POEQU by restricting the scaling factors
     !> to a power of the radix.  Barring over- and underflow, scaling by
     !> these factors introduces no additional rounding errors.  However, the
     !> scaled diagonal entries are no longer approximately 1 but lie
     !> between sqrt(radix) and 1/sqrt(radix).

     pure subroutine la_${ri}$poequb(n,a,lda,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: a(lda,*)
           real(${rk}$),intent(out) :: s(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i
           real(${rk}$) :: smin,base,tmp
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt,log,int
           ! Executable Statements
           ! test the input parameters.
           ! positive definite only performs 1 pass of equilibration.
           info = 0
           if (n < 0) then
              info = -1
           else if (lda < max(1,n)) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POEQUB',-info)
              return
           end if
           ! quick return if possible.
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           base = la_${ri}$lamch('B')
#:if rk == "sp"
           tmp = -0.5_${rk}$/log(base)
#:else
           tmp = -0.5e+0_${rk}$/log(base)
#:endif
           ! find the minimum and maximum diagonal elements.
           s(1) = a(1,1)
           smin = s(1)
           amax = s(1)
           do i = 2,n
              s(i) = a(i,i)
              smin = min(smin,s(i))
              amax = max(amax,s(i))
           end do
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = base**int(tmp*log(s(i)),KIND=ilp)
              end do
              ! compute scond = min(s(i)) / max(s(i)).
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$poequb
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRS: solves a system of linear equations A*X = B with a symmetric
     !> positive definite matrix A using the Cholesky factorization
     !> A = U**T*U or A = L*L**T computed by ${ri.upper()}$POTRF.

     pure subroutine la_${ri}$potrs(uplo,n,nrhs,a,lda,b,ldb,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: a(lda,*)
           real(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (upper) then
              ! solve a*x = b where a = u**t *u.
              ! solve u**t *x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','UPPER','TRANSPOSE','NON-UNIT',n,nrhs,one,a,lda,b, &
                         ldb)
              ! solve u*x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','UPPER','NO TRANSPOSE','NON-UNIT',n,nrhs,one,a,lda, &
                         b,ldb)
           else
              ! solve a*x = b where a = l*l**t.
              ! solve l*x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','NON-UNIT',n,nrhs,one,a,lda, &
                         b,ldb)
              ! solve l**t *x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','LOWER','TRANSPOSE','NON-UNIT',n,nrhs,one,a,lda,b, &
                         ldb)
           end if
           return
     end subroutine la_${ri}$potrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPEQU: computes row and column scalings intended to equilibrate a
     !> symmetric positive definite matrix A in packed storage and reduce
     !> its condition number (with respect to the two-norm).  S contains the
     !> scale factors, S(i)=1/sqrt(A(i,i)), chosen so that the scaled matrix
     !> B with elements B(i,j)=S(i)*A(i,j)*S(j) has ones on the diagonal.
     !> This choice of S puts the condition number of B within a factor N of
     !> the smallest possible condition number over all possible diagonal
     !> scalings.

     pure subroutine la_${ri}$ppequ(uplo,n,ap,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: ap(*)
           real(${rk}$),intent(out) :: s(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i,jj
           real(${rk}$) :: smin
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPEQU',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           ! initialize smin and amax.
           s(1) = ap(1)
           smin = s(1)
           amax = s(1)
           if (upper) then
              ! uplo = 'u':  upper triangle of a is stored.
              ! find the minimum and maximum diagonal elements.
              jj = 1
              do i = 2,n
                 jj = jj + i
                 s(i) = ap(jj)
                 smin = min(smin,s(i))
                 amax = max(amax,s(i))
              end do
           else
              ! uplo = 'l':  lower triangle of a is stored.
              ! find the minimum and maximum diagonal elements.
              jj = 1
              do i = 2,n
                 jj = jj + n - i + 2
                 s(i) = ap(jj)
                 smin = min(smin,s(i))
                 amax = max(amax,s(i))
              end do
           end if
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = one/sqrt(s(i))
              end do
              ! compute scond = min(s(i)) / max(s(i))
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$ppequ
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPTRF: computes the Cholesky factorization of a real symmetric
     !> positive definite matrix A stored in packed format.
     !> The factorization has the form
     !> A = U**T * U,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.

     pure subroutine la_${ri}$pptrf(uplo,n,ap,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ap(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,jc,jj
           real(${rk}$) :: ajj
           ! Intrinsic Functions
           intrinsic :: sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (upper) then
              ! compute the cholesky factorization a = u**t*u.
              jj = 0
              do j = 1,n
                 jc = jj + 1
                 jj = jj + j
                 ! compute elements 1:j-1 of column j.
                 if (j > 1) call la_${ri}$tpsv('UPPER','TRANSPOSE','NON-UNIT',j - 1,ap,ap(jc), &
                           1)
                 ! compute u(j,j) and test for non-positive-definiteness.
                 ajj = ap(jj) - la_${ri}$dot(j - 1,ap(jc),1,ap(jc),1)
                 if (ajj <= zero) then
                    ap(jj) = ajj
                    go to 30
                 end if
                 ap(jj) = sqrt(ajj)
              end do
           else
              ! compute the cholesky factorization a = l*l**t.
              jj = 1
              do j = 1,n
                 ! compute l(j,j) and test for non-positive-definiteness.
                 ajj = ap(jj)
                 if (ajj <= zero) then
                    ap(jj) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 ap(jj) = ajj
                 ! compute elements j+1:n of column j and update the trailing
                 ! submatrix.
                 if (j < n) then
                    call la_${ri}$scal(n - j,one/ajj,ap(jj + 1),1)
                    call la_${ri}$spr('LOWER',n - j,-one,ap(jj + 1),1,ap(jj + n - j + 1))
                    jj = jj + n - j + 1
                 end if
              end do
           end if
           go to 40
           30 continue
           info = j
           40 continue
           return
     end subroutine la_${ri}$pptrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPTRS: solves a system of linear equations A*X = B with a symmetric
     !> positive definite matrix A in packed storage using the Cholesky
     !> factorization A = U**T*U or A = L*L**T computed by ${ri.upper()}$PPTRF.

     pure subroutine la_${ri}$pptrs(uplo,n,nrhs,ap,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: ap(*)
           real(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (upper) then
              ! solve a*x = b where a = u**t * u.
              do i = 1,nrhs
                 ! solve u**t *x = b, overwriting b with x.
                 call la_${ri}$tpsv('UPPER','TRANSPOSE','NON-UNIT',n,ap,b(1,i),1)
                 ! solve u*x = b, overwriting b with x.
                 call la_${ri}$tpsv('UPPER','NO TRANSPOSE','NON-UNIT',n,ap,b(1,i),1)

              end do
           else
              ! solve a*x = b where a = l * l**t.
              do i = 1,nrhs
                 ! solve l*y = b, overwriting b with x.
                 call la_${ri}$tpsv('LOWER','NO TRANSPOSE','NON-UNIT',n,ap,b(1,i),1)

                 ! solve l**t *x = y, overwriting b with x.
                 call la_${ri}$tpsv('LOWER','TRANSPOSE','NON-UNIT',n,ap,b(1,i),1)
              end do
           end if
           return
     end subroutine la_${ri}$pptrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTCON: computes the reciprocal of the condition number (in the
     !> 1-norm) of a real symmetric positive definite tridiagonal matrix
     !> using the factorization A = L*D*L**T or A = U**T*D*U computed by
     !> ${ri.upper()}$PTTRF.
     !> Norm(inv(A)) is computed by a direct method, and the reciprocal of
     !> the condition number is computed as
     !> RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$ptcon(n,d,e,anorm,rcond,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           real(${rk}$),intent(in) :: d(*),e(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,ix
           real(${rk}$) :: ainvnm
           ! Intrinsic Functions
           intrinsic :: abs
           ! Executable Statements
           ! test the input arguments.
           info = 0
           if (n < 0) then
              info = -1
           else if (anorm < zero) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PTCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           ! check that d(1:n) is positive.
           do i = 1,n
              if (d(i) <= zero) return
           end do
           ! solve m(a) * x = e, where m(a) = (m(i,j)) is given by
              ! m(i,j) =  abs(a(i,j)), i = j,
              ! m(i,j) = -abs(a(i,j)), i .ne. j,
           ! and e = [ 1, 1, ..., 1 ]**t.  note m(a) = m(l)*d*m(l)**t.
           ! solve m(l) * x = e.
           work(1) = one
           do i = 2,n
              work(i) = one + work(i - 1)*abs(e(i - 1))
           end do
           ! solve d * m(l)**t * x = b.
           work(n) = work(n)/d(n)
           do i = n - 1,1,-1
              work(i) = work(i)/d(i) + work(i + 1)*abs(e(i))
           end do
           ! compute ainvnm = max(x(i)), 1<=i<=n.
           ix = la_i${ri}$amax(n,work,1)
           ainvnm = abs(work(ix))
           ! compute the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           return
     end subroutine la_${ri}$ptcon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTTRF: computes the L*D*L**T factorization of a real symmetric
     !> positive definite tridiagonal matrix A.  The factorization may also
     !> be regarded as having the form A = U**T*D*U.

     pure subroutine la_${ri}$pttrf(n,d,e,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           real(${rk}$),intent(inout) :: d(*),e(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,i4
           real(${rk}$) :: ei
           ! Intrinsic Functions
           intrinsic :: mod
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (n < 0) then
              info = -1
              call la_xerbla('${ri.upper()}$PTTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! compute the l*d*l**t (or u**t*d*u) factorization of a.
           i4 = mod(n - 1,4)
           do i = 1,i4
              if (d(i) <= zero) then
                 info = i
                 go to 30
              end if
              ei = e(i)
              e(i) = ei/d(i)
              d(i + 1) = d(i + 1) - e(i)*ei
           end do
           loop_20: do i = i4 + 1,n - 4,4
              ! drop out of the loop if d(i) <= 0: the matrix is not positive
              ! definite.
              if (d(i) <= zero) then
                 info = i
                 go to 30
              end if
              ! solve for e(i) and d(i+1).
              ei = e(i)
              e(i) = ei/d(i)
              d(i + 1) = d(i + 1) - e(i)*ei
              if (d(i + 1) <= zero) then
                 info = i + 1
                 go to 30
              end if
              ! solve for e(i+1) and d(i+2).
              ei = e(i + 1)
              e(i + 1) = ei/d(i + 1)
              d(i + 2) = d(i + 2) - e(i + 1)*ei
              if (d(i + 2) <= zero) then
                 info = i + 2
                 go to 30
              end if
              ! solve for e(i+2) and d(i+3).
              ei = e(i + 2)
              e(i + 2) = ei/d(i + 2)
              d(i + 3) = d(i + 3) - e(i + 2)*ei
              if (d(i + 3) <= zero) then
                 info = i + 3
                 go to 30
              end if
              ! solve for e(i+3) and d(i+4).
              ei = e(i + 3)
              e(i + 3) = ei/d(i + 3)
              d(i + 4) = d(i + 4) - e(i + 3)*ei
           end do loop_20
           ! check d(n) for positive definiteness.
           if (d(n) <= zero) info = n
           30 continue
           return
     end subroutine la_${ri}$pttrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTTS2: solves a tridiagonal system of the form
     !> A * X = B
     !> using the L*D*L**T factorization of A computed by ${ri.upper()}$PTTRF.  D is a
     !> diagonal matrix specified in the vector D, L is a unit bidiagonal
     !> matrix whose subdiagonal is specified in the vector E, and X and B
     !> are N by NRHS matrices.

     pure subroutine la_${ri}$ptts2(n,nrhs,d,e,b,ldb)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(inout) :: b(ldb,*)
           real(${rk}$),intent(in) :: d(*),e(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,j
           ! Executable Statements
           ! quick return if possible
           if (n <= 1) then
#:if rk == "sp"
              if (n == 1) call la_${ri}$scal(nrhs,1./d(1),b,ldb)
#:else
              if (n == 1) call la_${ri}$scal(nrhs,1._${rk}$/d(1),b,ldb)
#:endif
              return
           end if
           ! solve a * x = b using the factorization a = l*d*l**t,
           ! overwriting each right hand side vector with its solution.
           do j = 1,nrhs
                 ! solve l * x = b.
              do i = 2,n
                 b(i,j) = b(i,j) - b(i - 1,j)*e(i - 1)
              end do
                 ! solve d * l**t * x = b.
              b(n,j) = b(n,j)/d(n)
              do i = n - 1,1,-1
                 b(i,j) = b(i,j)/d(i) - b(i + 1,j)*e(i)
              end do
           end do
           return
     end subroutine la_${ri}$ptts2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LA_PORCOND: Estimates the Skeel condition number of  op(A) * op2(C)
     !> where op2 is determined by CMODE as follows
     !> CMODE =  1    op2(C) = C
     !> CMODE =  0    op2(C) = I
     !> CMODE = -1    op2(C) = inv(C)
     !> The Skeel condition number  cond(A) = norminf( |inv(A)||A| )
     !> is computed by computing scaling factors R such that
     !> diag(R)*A*op2(C) is row equilibrated and computing the standard
     !> infinity-norm condition number.

     real(${rk}$) function la_${ri}$la_porcond(uplo,n,a,lda,af,ldaf,cmode,c,info,work,iwork)
        use la_constants_${rk}$

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: n,lda,ldaf,cmode
           integer(ilp),intent(out) :: info
           real(${rk}$),intent(in) :: a(lda,*),af(ldaf,*),c(*)
           real(${rk}$),intent(out) :: work(*)
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: kase,i,j
           real(${rk}$) :: ainvnm,tmp
           logical(lk) :: up
           ! Array Arguments
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs,max
           ! Executable Statements
           la_${ri}$la_porcond = zero
           info = 0
           if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$LA_PORCOND',-info)
              return
           end if
           if (n == 0) then
              la_${ri}$la_porcond = one
              return
           end if
           up = .false.
           if (la_lsame(uplo,'U')) up = .true.
           ! compute the equilibration matrix r such that
           ! inv(r)*a*c has unit 1-norm.
           if (up) then
              do i = 1,n
                 tmp = zero
                 if (cmode == 1) then
                    do j = 1,i
                       tmp = tmp + abs(a(j,i)*c(j))
                    end do
                    do j = i + 1,n
                       tmp = tmp + abs(a(i,j)*c(j))
                    end do
                 else if (cmode == 0) then
                    do j = 1,i
                       tmp = tmp + abs(a(j,i))
                    end do
                    do j = i + 1,n
                       tmp = tmp + abs(a(i,j))
                    end do
                 else
                    do j = 1,i
                       tmp = tmp + abs(a(j,i)/c(j))
                    end do
                    do j = i + 1,n
                       tmp = tmp + abs(a(i,j)/c(j))
                    end do
                 end if
                 work(2*n + i) = tmp
              end do
           else
              do i = 1,n
                 tmp = zero
                 if (cmode == 1) then
                    do j = 1,i
                       tmp = tmp + abs(a(i,j)*c(j))
                    end do
                    do j = i + 1,n
                       tmp = tmp + abs(a(j,i)*c(j))
                    end do
                 else if (cmode == 0) then
                    do j = 1,i
                       tmp = tmp + abs(a(i,j))
                    end do
                    do j = i + 1,n
                       tmp = tmp + abs(a(j,i))
                    end do
                 else
                    do j = 1,i
                       tmp = tmp + abs(a(i,j)/c(j))
                    end do
                    do j = i + 1,n
                       tmp = tmp + abs(a(j,i)/c(j))
                    end do
                 end if
                 work(2*n + i) = tmp
              end do
           end if
           ! estimate the norm of inv(op(a)).
           ainvnm = zero
           kase = 0
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,iwork,ainvnm,kase,isave)
           if (kase /= 0) then
              if (kase == 2) then
                 ! multiply by r.
                 do i = 1,n
                    work(i) = work(i)*work(2*n + i)
                 end do
                 if (up) then
                    call la_${ri}$potrs('UPPER',n,1,af,ldaf,work,n,info)
                 else
                    call la_${ri}$potrs('LOWER',n,1,af,ldaf,work,n,info)
                 end if
                 ! multiply by inv(c).
                 if (cmode == 1) then
                    do i = 1,n
                       work(i) = work(i)/c(i)
                    end do
                 else if (cmode == -1) then
                    do i = 1,n
                       work(i) = work(i)*c(i)
                    end do
                 end if
              else
                 ! multiply by inv(c**t).
                 if (cmode == 1) then
                    do i = 1,n
                       work(i) = work(i)/c(i)
                    end do
                 else if (cmode == -1) then
                    do i = 1,n
                       work(i) = work(i)*c(i)
                    end do
                 end if
                 if (up) then
                    call la_${ri}$potrs('UPPER',n,1,af,ldaf,work,n,info)
                 else
                    call la_${ri}$potrs('LOWER',n,1,af,ldaf,work,n,info)
                 end if
                 ! multiply by r.
                 do i = 1,n
                    work(i) = work(i)*work(2*n + i)
                 end do
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
#:if rk == "sp"
           if (ainvnm /= 0.0_${rk}$) la_${ri}$la_porcond = (1.0_${rk}$/ainvnm)
#:else
           if (ainvnm /= zero) la_${ri}$la_porcond = (one/ainvnm)
#:endif
           return
     end function la_${ri}$la_porcond
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBCON: estimates the reciprocal of the condition number (in the
     !> 1-norm) of a real symmetric positive definite band matrix using the
     !> Cholesky factorization A = U**T*U or A = L*L**T computed by ${ri.upper()}$PBTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$pbcon(uplo,n,kd,ab,ldab,anorm,rcond,work,iwork,info)
        use la_constants_${rk}$,only:zero,one

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(in) :: ab(ldab,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           character :: normin
           integer(ilp) :: ix,kase
           real(${rk}$) :: ainvnm,scale,scalel,scaleu,smlnum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           else if (anorm < zero) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ri}$lamch('SAFE MINIMUM')
           ! estimate the 1-norm of the inverse.
           kase = 0
           normin = 'N'
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,iwork,ainvnm,kase,isave)
           if (kase /= 0) then
              if (upper) then
                 ! multiply by inv(u**t).
                 call la_${ri}$latbs('UPPER','TRANSPOSE','NON-UNIT',normin,n,kd,ab,ldab, &
                           work,scalel,work(2*n + 1),info)
                 normin = 'Y'
                 ! multiply by inv(u).
                 call la_${ri}$latbs('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,kd,ab,ldab, &
                           work,scaleu,work(2*n + 1),info)
              else
                 ! multiply by inv(l).
                 call la_${ri}$latbs('LOWER','NO TRANSPOSE','NON-UNIT',normin,n,kd,ab,ldab, &
                           work,scalel,work(2*n + 1),info)
                 normin = 'Y'
                 ! multiply by inv(l**t).
                 call la_${ri}$latbs('LOWER','TRANSPOSE','NON-UNIT',normin,n,kd,ab,ldab, &
                           work,scaleu,work(2*n + 1),info)
              end if
              ! multiply by 1/scale if doing so will not cause overflow.
              scale = scalel*scaleu
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < abs(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$pbcon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is symmetric positive definite
     !> and banded, and provides error bounds and backward error estimates
     !> for the solution.

     pure subroutine la_${ri}$pbrfs(uplo,n,kd,nrhs,ab,ldab,afb,ldafb,b,ldb,x,ldx,ferr, &
               berr,work,iwork,info)
        use la_constants_${rk}$,only:zero,one,two,three
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldafb,ldb,ldx,n,nrhs
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(in) :: ab(ldab,*),afb(ldafb,*),b(ldb,*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),work(*)
           real(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,j,k,kase,l,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs,max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (nrhs < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldafb < kd + 1) then
              info = -8
           else if (ldb < max(1,n)) then
              info = -10
           else if (ldx < max(1,n)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = min(n + 1,2*kd + 2)
           eps = la_${ri}$lamch('EPSILON')
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x
              call la_${ri}$copy(n,b(1,j),1,work(n + 1),1)
              call la_${ri}$sbmv(uplo,n,kd,-one,ab,ldab,x(1,j),1,one,work(n + 1),1)

              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 work(i) = abs(b(i,j))
              end do
              ! compute abs(a)*abs(x) + abs(b).
              if (upper) then
                 do k = 1,n
                    s = zero
                    xk = abs(x(k,j))
                    l = kd + 1 - k
                    do i = max(1,k - kd),k - 1
                       work(i) = work(i) + abs(ab(l + i,k))*xk
                       s = s + abs(ab(l + i,k))*abs(x(i,j))
                    end do
                    work(k) = work(k) + abs(ab(kd + 1,k))*xk + s
                 end do
              else
                 do k = 1,n
                    s = zero
                    xk = abs(x(k,j))
                    work(k) = work(k) + abs(ab(1,k))*xk
                    l = 1 - k
                    do i = k + 1,min(n,k + kd)
                       work(i) = work(i) + abs(ab(l + i,k))*xk
                       s = s + abs(ab(l + i,k))*abs(x(i,j))
                    end do
                    work(k) = work(k) + s
                 end do
              end if
              s = zero
              do i = 1,n
                 if (work(i) > safe2) then
                    s = max(s,abs(work(n + i))/work(i))
                 else
                    s = max(s, (abs(work(n + i)) + safe1)/(work(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$pbtrs(uplo,n,kd,1,afb,ldafb,work(n + 1),n,info)
                 call la_${ri}$axpy(n,one,work(n + 1),1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(a) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) )))
              do i = 1,n
                 if (work(i) > safe2) then
                    work(i) = abs(work(n + i)) + nz*eps*work(i)
                 else
                    work(i) = abs(work(n + i)) + nz*eps*work(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(2*n + 1),work(n + 1),iwork,ferr(j),kase,isave)

              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(a**t).
                    call la_${ri}$pbtrs(uplo,n,kd,1,afb,ldafb,work(n + 1),n,info)
                    do i = 1,n
                       work(n + i) = work(n + i)*work(i)
                    end do
                 else if (kase == 2) then
                    ! multiply by inv(a)*diag(w).
                    do i = 1,n
                       work(n + i) = work(n + i)*work(i)
                    end do
                    call la_${ri}$pbtrs(uplo,n,kd,1,afb,ldafb,work(n + 1),n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,abs(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$pbrfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PFTRS: solves a system of linear equations A*X = B with a symmetric
     !> positive definite matrix A using the Cholesky factorization
     !> A = U**T*U or A = L*L**T computed by ${ri.upper()}$PFTRF.

     pure subroutine la_${ri}$pftrs(transr,uplo,n,nrhs,a,b,ldb,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: transr,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: a(0:*)
           real(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,normaltransr
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           normaltransr = la_lsame(transr,'N')
           lower = la_lsame(uplo,'L')
           if (.not. normaltransr .and. .not. la_lsame(transr,'T')) then
              info = -1
           else if (.not. lower .and. .not. la_lsame(uplo,'U')) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (nrhs < 0) then
              info = -4
           else if (ldb < max(1,n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PFTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           ! start execution: there are two triangular solves
           if (lower) then
              call la_${ri}$tfsm(transr,'L',uplo,'N','N',n,nrhs,one,a,b,ldb)
              call la_${ri}$tfsm(transr,'L',uplo,'T','N',n,nrhs,one,a,b,ldb)
           else
              call la_${ri}$tfsm(transr,'L',uplo,'T','N',n,nrhs,one,a,b,ldb)
              call la_${ri}$tfsm(transr,'L',uplo,'N','N',n,nrhs,one,a,b,ldb)
           end if
           return
     end subroutine la_${ri}$pftrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POCON: estimates the reciprocal of the condition number (in the
     !> 1-norm) of a real symmetric positive definite matrix using the
     !> Cholesky factorization A = U**T*U or A = L*L**T computed by ${ri.upper()}$POTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$pocon(uplo,n,a,lda,anorm,rcond,work,iwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           character :: normin
           integer(ilp) :: ix,kase
           real(${rk}$) :: ainvnm,scale,scalel,scaleu,smlnum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs,max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (anorm < zero) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ri}$lamch('SAFE MINIMUM')
           ! estimate the 1-norm of inv(a).
           kase = 0
           normin = 'N'
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,iwork,ainvnm,kase,isave)
           if (kase /= 0) then
              if (upper) then
                 ! multiply by inv(u**t).
                 call la_${ri}$latrs('UPPER','TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           scalel,work(2*n + 1),info)
                 normin = 'Y'
                 ! multiply by inv(u).
                 call la_${ri}$latrs('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           scaleu,work(2*n + 1),info)
              else
                 ! multiply by inv(l).
                 call la_${ri}$latrs('LOWER','NO TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           scalel,work(2*n + 1),info)
                 normin = 'Y'
                 ! multiply by inv(l**t).
                 call la_${ri}$latrs('LOWER','TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           scaleu,work(2*n + 1),info)
              end if
              ! multiply by 1/scale if doing so will not cause overflow.
              scale = scalel*scaleu
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < abs(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$pocon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PORFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is symmetric positive definite,
     !> and provides error bounds and backward error estimates for the
     !> solution.

     pure subroutine la_${ri}$porfs(uplo,n,nrhs,a,lda,af,ldaf,b,ldb,x,ldx,ferr,berr, &
               work,iwork,info)
        use la_constants_${rk}$,only:zero,one,two,three
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldaf,ldb,ldx,n,nrhs
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(in) :: a(lda,*),af(ldaf,*),b(ldb,*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),work(*)
           real(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,j,k,kase,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs,max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldaf < max(1,n)) then
              info = -7
           else if (ldb < max(1,n)) then
              info = -9
           else if (ldx < max(1,n)) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PORFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = n + 1
           eps = la_${ri}$lamch('EPSILON')
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x
              call la_${ri}$copy(n,b(1,j),1,work(n + 1),1)
              call la_${ri}$symv(uplo,n,-one,a,lda,x(1,j),1,one,work(n + 1),1)
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 work(i) = abs(b(i,j))
              end do
              ! compute abs(a)*abs(x) + abs(b).
              if (upper) then
                 do k = 1,n
                    s = zero
                    xk = abs(x(k,j))
                    do i = 1,k - 1
                       work(i) = work(i) + abs(a(i,k))*xk
                       s = s + abs(a(i,k))*abs(x(i,j))
                    end do
                    work(k) = work(k) + abs(a(k,k))*xk + s
                 end do
              else
                 do k = 1,n
                    s = zero
                    xk = abs(x(k,j))
                    work(k) = work(k) + abs(a(k,k))*xk
                    do i = k + 1,n
                       work(i) = work(i) + abs(a(i,k))*xk
                       s = s + abs(a(i,k))*abs(x(i,j))
                    end do
                    work(k) = work(k) + s
                 end do
              end if
              s = zero
              do i = 1,n
                 if (work(i) > safe2) then
                    s = max(s,abs(work(n + i))/work(i))
                 else
                    s = max(s, (abs(work(n + i)) + safe1)/(work(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$potrs(uplo,n,1,af,ldaf,work(n + 1),n,info)
                 call la_${ri}$axpy(n,one,work(n + 1),1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(a) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) )))
              do i = 1,n
                 if (work(i) > safe2) then
                    work(i) = abs(work(n + i)) + nz*eps*work(i)
                 else
                    work(i) = abs(work(n + i)) + nz*eps*work(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(2*n + 1),work(n + 1),iwork,ferr(j),kase,isave)

              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(a**t).
                    call la_${ri}$potrs(uplo,n,1,af,ldaf,work(n + 1),n,info)
                    do i = 1,n
                       work(n + i) = work(i)*work(n + i)
                    end do
                 else if (kase == 2) then
                    ! multiply by inv(a)*diag(w).
                    do i = 1,n
                       work(n + i) = work(i)*work(n + i)
                    end do
                    call la_${ri}$potrs(uplo,n,1,af,ldaf,work(n + 1),n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,abs(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$porfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTF2: computes the Cholesky factorization of a real symmetric
     !> positive definite matrix A.
     !> The factorization has the form
     !> A = U**T * U ,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the unblocked version of the algorithm, calling Level 2 BLAS.

     pure subroutine la_${ri}$potf2(uplo,n,a,lda,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j
           real(${rk}$) :: ajj
           ! Intrinsic Functions
           intrinsic :: max,sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (upper) then
              ! compute the cholesky factorization a = u**t *u.
              do j = 1,n
                 ! compute u(j,j) and test for non-positive-definiteness.
                 ajj = a(j,j) - la_${ri}$dot(j - 1,a(1,j),1,a(1,j),1)
                 if (ajj <= zero .or. la_${ri}$isnan(ajj)) then
                    a(j,j) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of row j.
                 if (j < n) then
                    call la_${ri}$gemv('TRANSPOSE',j - 1,n - j,-one,a(1,j + 1),lda,a(1,j),1, &
                               one,a(j,j + 1),lda)
                    call la_${ri}$scal(n - j,one/ajj,a(j,j + 1),lda)
                 end if
              end do
           else
              ! compute the cholesky factorization a = l*l**t.
              do j = 1,n
                 ! compute l(j,j) and test for non-positive-definiteness.
                 ajj = a(j,j) - la_${ri}$dot(j - 1,a(j,1),lda,a(j,1),lda)
                 if (ajj <= zero .or. la_${ri}$isnan(ajj)) then
                    a(j,j) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of column j.
                 if (j < n) then
                    call la_${ri}$gemv('NO TRANSPOSE',n - j,j - 1,-one,a(j + 1,1),lda,a(j,1), &
                               lda,one,a(j + 1,j),1)
                    call la_${ri}$scal(n - j,one/ajj,a(j + 1,j),1)
                 end if
              end do
           end if
           go to 40
           30 continue
           info = j
           40 continue
           return
     end subroutine la_${ri}$potf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRF2: computes the Cholesky factorization of a real symmetric
     !> positive definite matrix A using the recursive algorithm.
     !> The factorization has the form
     !> A = U**T * U,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the recursive version of the algorithm. It divides
     !> the matrix into four submatrices:
     !> [  A11 | A12  ]  where A11 is n1 by n1 and A22 is n2 by n2
     !> A = [ -----|----- ]  with n1 = n/2
     !> [  A21 | A22  ]       n2 = n-n1
     !> The subroutine calls itself to factor A11. Update and scale A21
#:if rk == "sp"
     !> or A12, update A22 then call itself to factor A22.
#:else
     !> or A12, update A22 then calls itself to factor A22.
#:endif

     pure recursive subroutine la_${ri}$potrf2(uplo,n,a,lda,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: n1,n2,iinfo
           ! Intrinsic Functions
           intrinsic :: max,sqrt
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! n=1 case
           if (n == 1) then
              ! test for non-positive-definiteness
              if (a(1,1) <= zero .or. la_${ri}$isnan(a(1,1))) then
                 info = 1
                 return
              end if
              ! factor
              a(1,1) = sqrt(a(1,1))
           ! use recursive code
           else
              n1 = n/2
              n2 = n - n1
              ! factor a11
              call la_${ri}$potrf2(uplo,n1,a(1,1),lda,iinfo)
              if (iinfo /= 0) then
                 info = iinfo
                 return
              end if
              ! compute the cholesky factorization a = u**t*u
              if (upper) then
                 ! update and scale a12
                 call la_${ri}$trsm('L','U','T','N',n1,n2,one,a(1,1),lda,a(1,n1 + 1), &
                           lda)
                 ! update and factor a22
                 call la_${ri}$syrk(uplo,'T',n2,n1,-one,a(1,n1 + 1),lda,one,a(n1 + 1,n1 + 1 &
                           ),lda)
                 call la_${ri}$potrf2(uplo,n2,a(n1 + 1,n1 + 1),lda,iinfo)
                 if (iinfo /= 0) then
                    info = iinfo + n1
                    return
                 end if
              ! compute the cholesky factorization a = l*l**t
              else
                 ! update and scale a21
                 call la_${ri}$trsm('R','L','T','N',n2,n1,one,a(1,1),lda,a(n1 + 1,1), &
                           lda)
                 ! update and factor a22
                 call la_${ri}$syrk(uplo,'N',n2,n1,-one,a(n1 + 1,1),lda,one,a(n1 + 1,n1 + 1 &
                           ),lda)
                 call la_${ri}$potrf2(uplo,n2,a(n1 + 1,n1 + 1),lda,iinfo)
                 if (iinfo /= 0) then
                    info = iinfo + n1
                    return
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$potrf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRI: computes the inverse of a real symmetric positive definite
     !> matrix A using the Cholesky factorization A = U**T*U or A = L*L**T
     !> computed by ${ri.upper()}$POTRF.

     pure subroutine la_${ri}$potri(uplo,n,a,lda,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (.not. la_lsame(uplo,'U') .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRI',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! invert the triangular cholesky factor u or l.
           call la_${ri}$trtri(uplo,'NON-UNIT',n,a,lda,info)
           if (info > 0) return
           ! form inv(u) * inv(u)**t or inv(l)**t * inv(l).
           call la_${ri}$lauum(uplo,n,a,lda,info)
           return
     end subroutine la_${ri}$potri
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPCON: estimates the reciprocal of the condition number (in the
     !> 1-norm) of a real symmetric positive definite packed matrix using
     !> the Cholesky factorization A = U**T*U or A = L*L**T computed by
     !> ${ri.upper()}$PPTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$ppcon(uplo,n,ap,anorm,rcond,work,iwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(in) :: ap(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           character :: normin
           integer(ilp) :: ix,kase
           real(${rk}$) :: ainvnm,scale,scalel,scaleu,smlnum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (anorm < zero) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ri}$lamch('SAFE MINIMUM')
           ! estimate the 1-norm of the inverse.
           kase = 0
           normin = 'N'
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,iwork,ainvnm,kase,isave)
           if (kase /= 0) then
              if (upper) then
                 ! multiply by inv(u**t).
                 call la_${ri}$latps('UPPER','TRANSPOSE','NON-UNIT',normin,n,ap,work,scalel, &
                            work(2*n + 1),info)
                 normin = 'Y'
                 ! multiply by inv(u).
                 call la_${ri}$latps('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,ap,work, &
                           scaleu,work(2*n + 1),info)
              else
                 ! multiply by inv(l).
                 call la_${ri}$latps('LOWER','NO TRANSPOSE','NON-UNIT',normin,n,ap,work, &
                           scalel,work(2*n + 1),info)
                 normin = 'Y'
                 ! multiply by inv(l**t).
                 call la_${ri}$latps('LOWER','TRANSPOSE','NON-UNIT',normin,n,ap,work,scaleu, &
                            work(2*n + 1),info)
              end if
              ! multiply by 1/scale if doing so will not cause overflow.
              scale = scalel*scaleu
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < abs(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$ppcon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is symmetric positive definite
     !> and packed, and provides error bounds and backward error estimates
     !> for the solution.

     pure subroutine la_${ri}$pprfs(uplo,n,nrhs,ap,afp,b,ldb,x,ldx,ferr,berr,work, &
               iwork,info)
        use la_constants_${rk}$,only:zero,one,two,three
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,ldx,n,nrhs
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(in) :: afp(*),ap(*),b(ldb,*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),work(*)
           real(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,ik,j,k,kase,kk,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
           intrinsic :: abs,max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -7
           else if (ldx < max(1,n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = n + 1
           eps = la_${ri}$lamch('EPSILON')
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x
              call la_${ri}$copy(n,b(1,j),1,work(n + 1),1)
              call la_${ri}$spmv(uplo,n,-one,ap,x(1,j),1,one,work(n + 1),1)
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 work(i) = abs(b(i,j))
              end do
              ! compute abs(a)*abs(x) + abs(b).
              kk = 1
              if (upper) then
                 do k = 1,n
                    s = zero
                    xk = abs(x(k,j))
                    ik = kk
                    do i = 1,k - 1
                       work(i) = work(i) + abs(ap(ik))*xk
                       s = s + abs(ap(ik))*abs(x(i,j))
                       ik = ik + 1
                    end do
                    work(k) = work(k) + abs(ap(kk + k - 1))*xk + s
                    kk = kk + k
                 end do
              else
                 do k = 1,n
                    s = zero
                    xk = abs(x(k,j))
                    work(k) = work(k) + abs(ap(kk))*xk
                    ik = kk + 1
                    do i = k + 1,n
                       work(i) = work(i) + abs(ap(ik))*xk
                       s = s + abs(ap(ik))*abs(x(i,j))
                       ik = ik + 1
                    end do
                    work(k) = work(k) + s
                    kk = kk + (n - k + 1)
                 end do
              end if
              s = zero
              do i = 1,n
                 if (work(i) > safe2) then
                    s = max(s,abs(work(n + i))/work(i))
                 else
                    s = max(s, (abs(work(n + i)) + safe1)/(work(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$pptrs(uplo,n,1,afp,work(n + 1),n,info)
                 call la_${ri}$axpy(n,one,work(n + 1),1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(a) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) )))
              do i = 1,n
                 if (work(i) > safe2) then
                    work(i) = abs(work(n + i)) + nz*eps*work(i)
                 else
                    work(i) = abs(work(n + i)) + nz*eps*work(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(2*n + 1),work(n + 1),iwork,ferr(j),kase,isave)

              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(a**t).
                    call la_${ri}$pptrs(uplo,n,1,afp,work(n + 1),n,info)
                    do i = 1,n
                       work(n + i) = work(i)*work(n + i)
                    end do
                 else if (kase == 2) then
                    ! multiply by inv(a)*diag(w).
                    do i = 1,n
                       work(n + i) = work(i)*work(n + i)
                    end do
                    call la_${ri}$pptrs(uplo,n,1,afp,work(n + 1),n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,abs(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$pprfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPTRI: computes the inverse of a real symmetric positive definite
     !> matrix A using the Cholesky factorization A = U**T*U or A = L*L**T
     !> computed by ${ri.upper()}$PPTRF.

     pure subroutine la_${ri}$pptri(uplo,n,ap,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ap(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,jc,jj,jjn
           real(${rk}$) :: ajj
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPTRI',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! invert the triangular cholesky factor u or l.
           call la_${ri}$tptri(uplo,'NON-UNIT',n,ap,info)
           if (info > 0) return
           if (upper) then
              ! compute the product inv(u) * inv(u)**t.
              jj = 0
              do j = 1,n
                 jc = jj + 1
                 jj = jj + j
                 if (j > 1) call la_${ri}$spr('UPPER',j - 1,one,ap(jc),1,ap)
                 ajj = ap(jj)
                 call la_${ri}$scal(j,ajj,ap(jc),1)
              end do
           else
              ! compute the product inv(l)**t * inv(l).
              jj = 1
              do j = 1,n
                 jjn = jj + n - j + 1
                 ap(jj) = la_${ri}$dot(n - j + 1,ap(jj),1,ap(jj),1)
                 if (j < n) call la_${ri}$tpmv('LOWER','TRANSPOSE','NON-UNIT',n - j,ap(jjn),ap( &
                           jj + 1),1)
                 jj = jjn
              end do
           end if
           return
     end subroutine la_${ri}$pptri
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PSTF2: computes the Cholesky factorization with complete
     !> pivoting of a real symmetric positive semidefinite matrix A.
     !> The factorization has the form
     !> P**T * A * P = U**T * U ,  if UPLO = 'U',
     !> P**T * A * P = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular, and
     !> P is stored as vector PIV.
     !> This algorithm does not attempt to check that A is positive
     !> semidefinite. This version of the algorithm calls level 2 BLAS.

     pure subroutine la_${ri}$pstf2(uplo,n,a,lda,piv,rank,tol,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           real(${rk}$),intent(in) :: tol
           integer(ilp),intent(out) :: info,rank
           integer(ilp),intent(in) :: lda,n
           character,intent(in) :: uplo
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: work(2*n)
           integer(ilp),intent(out) :: piv(n)
        ! =====================================================================

           ! Local Scalars
           real(${rk}$) :: ajj,${ri}$stop,${ri}$temp
           integer(ilp) :: i,itemp,j,pvt
           logical(lk) :: upper
           ! Intrinsic Functions
           intrinsic :: max,sqrt,maxloc
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PSTF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! initialize piv
           do i = 1,n
              piv(i) = i
           end do
           ! compute stopping value
           pvt = 1
           ajj = a(pvt,pvt)
           do i = 2,n
              if (a(i,i) > ajj) then
                 pvt = i
                 ajj = a(pvt,pvt)
              end if
           end do
           if (ajj <= zero .or. la_${ri}$isnan(ajj)) then
              rank = 0
              info = 1
              go to 170
           end if
           ! compute stopping value if not supplied
           if (tol < zero) then
              ${ri}$stop = n*la_${ri}$lamch('EPSILON')*ajj
           else
              ${ri}$stop = tol
           end if
           ! set first half of work to zero, holds dot products
           do i = 1,n
              work(i) = 0
           end do
           if (upper) then
              ! compute the cholesky factorization p**t * a * p = u**t * u
              loop_130: do j = 1,n
              ! find pivot, test for exit, else swap rows and columns
              ! update dot products, compute possible pivots which are
              ! stored in the second half of work
                 do i = j,n
                    if (j > 1) then
                       work(i) = work(i) + a(j - 1,i)**2
                    end if
                    work(n + i) = a(i,i) - work(i)
                 end do
                 if (j > 1) then
                    itemp = maxloc(work((n + j):(2*n)),1)
                    pvt = itemp + j - 1
                    ajj = work(n + pvt)
                    if (ajj <= ${ri}$stop .or. la_${ri}$isnan(ajj)) then
                       a(j,j) = ajj
                       go to 160
                    end if
                 end if
                 if (j /= pvt) then
                    ! pivot ok, so can now swap pivot rows and columns
                    a(pvt,pvt) = a(j,j)
                    call la_${ri}$swap(j - 1,a(1,j),1,a(1,pvt),1)
                    if (pvt < n) call la_${ri}$swap(n - pvt,a(j,pvt + 1),lda,a(pvt,pvt + 1),lda)

                    call la_${ri}$swap(pvt - j - 1,a(j,j + 1),lda,a(j + 1,pvt),1)
                    ! swap dot products and piv
                    ${ri}$temp = work(j)
                    work(j) = work(pvt)
                    work(pvt) = ${ri}$temp
                    itemp = piv(pvt)
                    piv(pvt) = piv(j)
                    piv(j) = itemp
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of row j
                 if (j < n) then
                    call la_${ri}$gemv('TRANS',j - 1,n - j,-one,a(1,j + 1),lda,a(1,j),1, &
                              one,a(j,j + 1),lda)
                    call la_${ri}$scal(n - j,one/ajj,a(j,j + 1),lda)
                 end if
              end do loop_130
           else
              ! compute the cholesky factorization p**t * a * p = l * l**t
              loop_150: do j = 1,n
              ! find pivot, test for exit, else swap rows and columns
              ! update dot products, compute possible pivots which are
              ! stored in the second half of work
                 do i = j,n
                    if (j > 1) then
                       work(i) = work(i) + a(i,j - 1)**2
                    end if
                    work(n + i) = a(i,i) - work(i)
                 end do
                 if (j > 1) then
                    itemp = maxloc(work((n + j):(2*n)),1)
                    pvt = itemp + j - 1
                    ajj = work(n + pvt)
                    if (ajj <= ${ri}$stop .or. la_${ri}$isnan(ajj)) then
                       a(j,j) = ajj
                       go to 160
                    end if
                 end if
                 if (j /= pvt) then
                    ! pivot ok, so can now swap pivot rows and columns
                    a(pvt,pvt) = a(j,j)
                    call la_${ri}$swap(j - 1,a(j,1),lda,a(pvt,1),lda)
                    if (pvt < n) call la_${ri}$swap(n - pvt,a(pvt + 1,j),1,a(pvt + 1,pvt),1)

                    call la_${ri}$swap(pvt - j - 1,a(j + 1,j),1,a(pvt,j + 1),lda)
                    ! swap dot products and piv
                    ${ri}$temp = work(j)
                    work(j) = work(pvt)
                    work(pvt) = ${ri}$temp
                    itemp = piv(pvt)
                    piv(pvt) = piv(j)
                    piv(j) = itemp
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of column j
                 if (j < n) then
                    call la_${ri}$gemv('NO TRANS',n - j,j - 1,-one,a(j + 1,1),lda,a(j,1), &
                              lda,one,a(j + 1,j),1)
                    call la_${ri}$scal(n - j,one/ajj,a(j + 1,j),1)
                 end if
              end do loop_150
           end if
           ! ran to completion, a has full rank
           rank = n
           go to 170
           160 continue
           ! rank is number of steps completed.  set info = 1 to signal
           ! that the factorization cannot be used to solve a system.
           rank = j - 1
           info = 1
           170 continue
           return
     end subroutine la_${ri}$pstf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PSTRF: computes the Cholesky factorization with complete
     !> pivoting of a real symmetric positive semidefinite matrix A.
     !> The factorization has the form
     !> P**T * A * P = U**T * U ,  if UPLO = 'U',
     !> P**T * A * P = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular, and
     !> P is stored as vector PIV.
     !> This algorithm does not attempt to check that A is positive
     !> semidefinite. This version of the algorithm calls level 3 BLAS.

     pure subroutine la_${ri}$pstrf(uplo,n,a,lda,piv,rank,tol,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           real(${rk}$),intent(in) :: tol
           integer(ilp),intent(out) :: info,rank
           integer(ilp),intent(in) :: lda,n
           character,intent(in) :: uplo
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: work(2*n)
           integer(ilp),intent(out) :: piv(n)
        ! =====================================================================

           ! Local Scalars
           real(${rk}$) :: ajj,${ri}$stop,${ri}$temp
           integer(ilp) :: i,itemp,j,jb,k,nb,pvt
           logical(lk) :: upper
           ! Intrinsic Functions
           intrinsic :: max,min,sqrt,maxloc
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PSTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! get block size
           nb = la_ilaenv(1,'${ri.upper()}$POTRF',uplo,n,-1,-1,-1)
           if (nb <= 1 .or. nb >= n) then
              ! use unblocked code
              call la_${ri}$pstf2(uplo,n,a(1,1),lda,piv,rank,tol,work,info)
              go to 200
           else
           ! initialize piv
              do i = 1,n
                 piv(i) = i
              end do
           ! compute stopping value
              pvt = 1
              ajj = a(pvt,pvt)
              do i = 2,n
                 if (a(i,i) > ajj) then
                    pvt = i
                    ajj = a(pvt,pvt)
                 end if
              end do
              if (ajj <= zero .or. la_${ri}$isnan(ajj)) then
                 rank = 0
                 info = 1
                 go to 200
              end if
           ! compute stopping value if not supplied
              if (tol < zero) then
                 ${ri}$stop = n*la_${ri}$lamch('EPSILON')*ajj
              else
                 ${ri}$stop = tol
              end if
              if (upper) then
                 ! compute the cholesky factorization p**t * a * p = u**t * u
                 loop_140: do k = 1,n,nb
                    ! account for last block not being nb wide
                    jb = min(nb,n - k + 1)
                    ! set relevant part of first half of work to zero,
                    ! holds dot products
                    do i = k,n
                       work(i) = 0
                    end do
                    loop_130: do j = k,k + jb - 1
                    ! find pivot, test for exit, else swap rows and columns
                    ! update dot products, compute possible pivots which are
                    ! stored in the second half of work
                       do i = j,n
                          if (j > k) then
                             work(i) = work(i) + a(j - 1,i)**2
                          end if
                          work(n + i) = a(i,i) - work(i)
                       end do
                       if (j > 1) then
                          itemp = maxloc(work((n + j):(2*n)),1)
                          pvt = itemp + j - 1
                          ajj = work(n + pvt)
                          if (ajj <= ${ri}$stop .or. la_${ri}$isnan(ajj)) then
                             a(j,j) = ajj
                             go to 190
                          end if
                       end if
                       if (j /= pvt) then
                          ! pivot ok, so can now swap pivot rows and columns
                          a(pvt,pvt) = a(j,j)
                          call la_${ri}$swap(j - 1,a(1,j),1,a(1,pvt),1)
                          if (pvt < n) call la_${ri}$swap(n - pvt,a(j,pvt + 1),lda,a(pvt,pvt + 1), &
                                     lda)
                          call la_${ri}$swap(pvt - j - 1,a(j,j + 1),lda,a(j + 1,pvt),1)
                          ! swap dot products and piv
                          ${ri}$temp = work(j)
                          work(j) = work(pvt)
                          work(pvt) = ${ri}$temp
                          itemp = piv(pvt)
                          piv(pvt) = piv(j)
                          piv(j) = itemp
                       end if
                       ajj = sqrt(ajj)
                       a(j,j) = ajj
                       ! compute elements j+1:n of row j.
                       if (j < n) then
                          call la_${ri}$gemv('TRANS',j - k,n - j,-one,a(k,j + 1),lda,a(k,j), &
                                    1,one,a(j,j + 1),lda)
                          call la_${ri}$scal(n - j,one/ajj,a(j,j + 1),lda)
                       end if
                    end do loop_130
                    ! update trailing matrix, j already incremented
                    if (k + jb <= n) then
                       call la_${ri}$syrk('UPPER','TRANS',n - j + 1,jb,-one,a(k,j),lda,one, &
                                 a(j,j),lda)
                    end if
                 end do loop_140
              else
              ! compute the cholesky factorization p**t * a * p = l * l**t
                 loop_180: do k = 1,n,nb
                    ! account for last block not being nb wide
                    jb = min(nb,n - k + 1)
                    ! set relevant part of first half of work to zero,
                    ! holds dot products
                    do i = k,n
                       work(i) = 0
                    end do
                    loop_170: do j = k,k + jb - 1
                    ! find pivot, test for exit, else swap rows and columns
                    ! update dot products, compute possible pivots which are
                    ! stored in the second half of work
                       do i = j,n
                          if (j > k) then
                             work(i) = work(i) + a(i,j - 1)**2
                          end if
                          work(n + i) = a(i,i) - work(i)
                       end do
                       if (j > 1) then
                          itemp = maxloc(work((n + j):(2*n)),1)
                          pvt = itemp + j - 1
                          ajj = work(n + pvt)
                          if (ajj <= ${ri}$stop .or. la_${ri}$isnan(ajj)) then
                             a(j,j) = ajj
                             go to 190
                          end if
                       end if
                       if (j /= pvt) then
                          ! pivot ok, so can now swap pivot rows and columns
                          a(pvt,pvt) = a(j,j)
                          call la_${ri}$swap(j - 1,a(j,1),lda,a(pvt,1),lda)
                          if (pvt < n) call la_${ri}$swap(n - pvt,a(pvt + 1,j),1,a(pvt + 1,pvt), &
                                    1)
                          call la_${ri}$swap(pvt - j - 1,a(j + 1,j),1,a(pvt,j + 1),lda)
                          ! swap dot products and piv
                          ${ri}$temp = work(j)
                          work(j) = work(pvt)
                          work(pvt) = ${ri}$temp
                          itemp = piv(pvt)
                          piv(pvt) = piv(j)
                          piv(j) = itemp
                       end if
                       ajj = sqrt(ajj)
                       a(j,j) = ajj
                       ! compute elements j+1:n of column j.
                       if (j < n) then
                          call la_${ri}$gemv('NO TRANS',n - j,j - k,-one,a(j + 1,k),lda,a(j,k &
                                    ),lda,one,a(j + 1,j),1)
                          call la_${ri}$scal(n - j,one/ajj,a(j + 1,j),1)
                       end if
                    end do loop_170
                    ! update trailing matrix, j already incremented
                    if (k + jb <= n) then
                       call la_${ri}$syrk('LOWER','NO TRANS',n - j + 1,jb,-one,a(j,k),lda, &
                                 one,a(j,j),lda)
                    end if
                 end do loop_180
              end if
           end if
           ! ran to completion, a has full rank
           rank = n
           go to 200
           190 continue
           ! rank is the number of steps completed.  set info = 1 to signal
           ! that the factorization cannot be used to solve a system.
           rank = j - 1
           info = 1
           200 continue
           return
     end subroutine la_${ri}$pstrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTTRS: solves a tridiagonal system of the form
     !> A * X = B
     !> using the L*D*L**T factorization of A computed by ${ri.upper()}$PTTRF.  D is a
     !> diagonal matrix specified in the vector D, L is a unit bidiagonal
     !> matrix whose subdiagonal is specified in the vector E, and X and B
     !> are N by NRHS matrices.

     pure subroutine la_${ri}$pttrs(n,nrhs,d,e,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(inout) :: b(ldb,*)
           real(${rk}$),intent(in) :: d(*),e(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments.
           info = 0
           if (n < 0) then
              info = -1
           else if (nrhs < 0) then
              info = -2
           else if (ldb < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PTTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           ! determine the number of right-hand sides to solve at a time.
           if (nrhs == 1) then
              nb = 1
           else
              nb = max(1,la_ilaenv(1,'${ri.upper()}$PTTRS',' ',n,nrhs,-1,-1))
           end if
           if (nb >= nrhs) then
              call la_${ri}$ptts2(n,nrhs,d,e,b,ldb)
           else
              do j = 1,nrhs,nb
                 jb = min(nrhs - j + 1,nb)
                 call la_${ri}$ptts2(n,jb,d,e,b(1,j),ldb)
              end do
           end if
           return
     end subroutine la_${ri}$pttrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBTRF: computes the Cholesky factorization of a real symmetric
     !> positive definite band matrix A.
     !> The factorization has the form
     !> A = U**T * U,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.

     pure subroutine la_${ri}$pbtrf(uplo,n,kd,ab,ldab,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 32
           integer(ilp),parameter :: ldwork = nbmax + 1

           ! Local Scalars
           integer(ilp) :: i,i2,i3,ib,ii,j,jj,nb
           ! Local Arrays
           real(${rk}$) :: work(ldwork,nbmax)
           ! Intrinsic Functions
           intrinsic :: min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if ((.not. la_lsame(uplo,'U')) .and. (.not. la_lsame(uplo,'L'))) &
                     then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! determine the block size for this environment
           nb = la_ilaenv(1,'${ri.upper()}$PBTRF',uplo,n,kd,-1,-1)
           ! the block size must not exceed the semi-bandwidth kd, and must not
           ! exceed the limit set by the size of the local array work.
           nb = min(nb,nbmax)
           if (nb <= 1 .or. nb > kd) then
              ! use unblocked code
              call la_${ri}$pbtf2(uplo,n,kd,ab,ldab,info)
           else
              ! use blocked code
              if (la_lsame(uplo,'U')) then
                 ! compute the cholesky factorization of a symmetric band
                 ! matrix, given the upper triangle of the matrix in band
                 ! storage.
                 ! zero the upper triangle of the work array.
                 do j = 1,nb
                    do i = 1,j - 1
                       work(i,j) = zero
                    end do
                 end do
                 ! process the band matrix one diagonal block at a time.
                 loop_70: do i = 1,n,nb
                    ib = min(nb,n - i + 1)
                    ! factorize the diagonal block
                    call la_${ri}$potf2(uplo,ib,ab(kd + 1,i),ldab - 1,ii)
                    if (ii /= 0) then
                       info = i + ii - 1
                       go to 150
                    end if
                    if (i + ib <= n) then
                       ! update the relevant part of the trailing submatrix.
                       ! if a11 denotes the diagonal block which has just been
                       ! factorized, then we need to update the remaining
                       ! blocks in the diagram:
                          ! a11   a12   a13
                                ! a22   a23
                                      ! a33
                       ! the numbers of rows and columns in the partitioning
                       ! are ib, i2, i3 respectively. the blocks a12, a22 and
                       ! a23 are empty if ib = kd. the upper triangle of a13
                       ! lies outside the band.
                       i2 = min(kd - ib,n - i - ib + 1)
                       i3 = min(ib,n - i - kd + 1)
                       if (i2 > 0) then
                          ! update a12
                          call la_${ri}$trsm('LEFT','UPPER','TRANSPOSE','NON-UNIT',ib,i2,one, &
                                     ab(kd + 1,i),ldab - 1,ab(kd + 1 - ib,i + ib),ldab - 1)
                          ! update a22
                          call la_${ri}$syrk('UPPER','TRANSPOSE',i2,ib,-one,ab(kd + 1 - ib,i + ib &
                                    ),ldab - 1,one,ab(kd + 1,i + ib),ldab - 1)
                       end if
                       if (i3 > 0) then
                          ! copy the lower triangle of a13 into the work array.
                          do jj = 1,i3
                             do ii = jj,ib
                                work(ii,jj) = ab(ii - jj + 1,jj + i + kd - 1)
                             end do
                          end do
                          ! update a13 (in the work array).
                          call la_${ri}$trsm('LEFT','UPPER','TRANSPOSE','NON-UNIT',ib,i3,one, &
                                     ab(kd + 1,i),ldab - 1,work,ldwork)
                          ! update a23
                          if (i2 > 0) call la_${ri}$gemm('TRANSPOSE','NO TRANSPOSE',i2,i3,ib,- &
                          one,ab(kd + 1 - ib,i + ib),ldab - 1,work,ldwork,one,ab(1 + ib,i + kd), &
                                    ldab - 1)
                          ! update a33
                          call la_${ri}$syrk('UPPER','TRANSPOSE',i3,ib,-one,work,ldwork,one, &
                                     ab(kd + 1,i + kd),ldab - 1)
                          ! copy the lower triangle of a13 back into place.
                          do jj = 1,i3
                             do ii = jj,ib
                                ab(ii - jj + 1,jj + i + kd - 1) = work(ii,jj)
                             end do
                          end do
                       end if
                    end if
                 end do loop_70
              else
                 ! compute the cholesky factorization of a symmetric band
                 ! matrix, given the lower triangle of the matrix in band
                 ! storage.
                 ! zero the lower triangle of the work array.
                 do j = 1,nb
                    do i = j + 1,nb
                       work(i,j) = zero
                    end do
                 end do
                 ! process the band matrix one diagonal block at a time.
                 loop_140: do i = 1,n,nb
                    ib = min(nb,n - i + 1)
                    ! factorize the diagonal block
                    call la_${ri}$potf2(uplo,ib,ab(1,i),ldab - 1,ii)
                    if (ii /= 0) then
                       info = i + ii - 1
                       go to 150
                    end if
                    if (i + ib <= n) then
                       ! update the relevant part of the trailing submatrix.
                       ! if a11 denotes the diagonal block which has just been
                       ! factorized, then we need to update the remaining
                       ! blocks in the diagram:
                          ! a11
                          ! a21   a22
                          ! a31   a32   a33
                       ! the numbers of rows and columns in the partitioning
                       ! are ib, i2, i3 respectively. the blocks a21, a22 and
                       ! a32 are empty if ib = kd. the lower triangle of a31
                       ! lies outside the band.
                       i2 = min(kd - ib,n - i - ib + 1)
                       i3 = min(ib,n - i - kd + 1)
                       if (i2 > 0) then
                          ! update a21
                          call la_${ri}$trsm('RIGHT','LOWER','TRANSPOSE','NON-UNIT',i2,ib, &
                                    one,ab(1,i),ldab - 1,ab(1 + ib,i),ldab - 1)
                          ! update a22
                          call la_${ri}$syrk('LOWER','NO TRANSPOSE',i2,ib,-one,ab(1 + ib,i), &
                                    ldab - 1,one,ab(1,i + ib),ldab - 1)
                       end if
                       if (i3 > 0) then
                          ! copy the upper triangle of a31 into the work array.
                          do jj = 1,ib
                             do ii = 1,min(jj,i3)
                                work(ii,jj) = ab(kd + 1 - jj + ii,jj + i - 1)
                             end do
                          end do
                          ! update a31 (in the work array).
                          call la_${ri}$trsm('RIGHT','LOWER','TRANSPOSE','NON-UNIT',i3,ib, &
                                    one,ab(1,i),ldab - 1,work,ldwork)
                          ! update a32
                          if (i2 > 0) call la_${ri}$gemm('NO TRANSPOSE','TRANSPOSE',i3,i2,ib,- &
                          one,work,ldwork,ab(1 + ib,i),ldab - 1,one,ab(1 + kd - ib,i + ib),ldab - &
                                    1)
                          ! update a33
                          call la_${ri}$syrk('LOWER','NO TRANSPOSE',i3,ib,-one,work,ldwork, &
                                    one,ab(1,i + kd),ldab - 1)
                          ! copy the upper triangle of a31 back into place.
                          do jj = 1,ib
                             do ii = 1,min(jj,i3)
                                ab(kd + 1 - jj + ii,jj + i - 1) = work(ii,jj)
                             end do
                          end do
                       end if
                    end if
                 end do loop_140
              end if
           end if
           return
           150 continue
           return
     end subroutine la_${ri}$pbtrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
#:if rk == "sp"
     !> ${ri.upper()}$PFTRI: computes the inverse of a real (symmetric) positive definite
#:else
     !> ${ri.upper()}$PFTRI: computes the inverse of a (real) symmetric positive definite
#:endif
     !> matrix A using the Cholesky factorization A = U**T*U or A = L*L**T
     !> computed by ${ri.upper()}$PFTRF.

     pure subroutine la_${ri}$pftri(transr,uplo,n,a,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: transr,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(0:*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,nisodd,normaltransr
           integer(ilp) :: n1,n2,k
           ! Intrinsic Functions
           intrinsic :: mod
           ! Executable Statements
           ! test the input parameters.
           info = 0
           normaltransr = la_lsame(transr,'N')
           lower = la_lsame(uplo,'L')
           if (.not. normaltransr .and. .not. la_lsame(transr,'T')) then
              info = -1
           else if (.not. lower .and. .not. la_lsame(uplo,'U')) then
              info = -2
           else if (n < 0) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PFTRI',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! invert the triangular cholesky factor u or l.
           call la_${ri}$tftri(transr,uplo,'N',n,a,info)
           if (info > 0) return
           ! if n is odd, set nisodd = .true.
           ! if n is even, set k = n/2 and nisodd = .false.
           if (mod(n,2) == 0) then
              k = n/2
              nisodd = .false.
           else
              nisodd = .true.
           end if
           ! set n1 and n2 depending on lower
           if (lower) then
              n2 = n/2
              n1 = n - n2
           else
              n1 = n/2
              n2 = n - n1
           end if
           ! start execution of triangular matrix multiply: inv(u)*inv(u)^c or
           ! inv(l)^c*inv(l). there are eight cases.
           if (nisodd) then
              ! n is odd
              if (normaltransr) then
                 ! n is odd and transr = 'n'
                 if (lower) then
                    ! srpa for lower, normal and n is odd ( a(0:n-1,0:n1-1) )
                    ! t1 -> a(0,0), t2 -> a(0,1), s -> a(n1,0)
                    ! t1 -> a(0), t2 -> a(n), s -> a(n1)
                    call la_${ri}$lauum('L',n1,a(0),n,info)
                    call la_${ri}$syrk('L','T',n1,n2,one,a(n1),n,one,a(0),n)
                    call la_${ri}$trmm('L','U','N','N',n2,n1,one,a(n),n,a(n1),n)

                    call la_${ri}$lauum('U',n2,a(n),n,info)
                 else
                    ! srpa for upper, normal and n is odd ( a(0:n-1,0:n2-1)
                    ! t1 -> a(n1+1,0), t2 -> a(n1,0), s -> a(0,0)
                    ! t1 -> a(n2), t2 -> a(n1), s -> a(0)
                    call la_${ri}$lauum('L',n1,a(n2),n,info)
                    call la_${ri}$syrk('L','N',n1,n2,one,a(0),n,one,a(n2),n)
                    call la_${ri}$trmm('R','U','T','N',n1,n2,one,a(n1),n,a(0),n)

                    call la_${ri}$lauum('U',n2,a(n1),n,info)
                 end if
              else
                 ! n is odd and transr = 't'
                 if (lower) then
                    ! srpa for lower, transpose, and n is odd
                    ! t1 -> a(0), t2 -> a(1), s -> a(0+n1*n1)
                    call la_${ri}$lauum('U',n1,a(0),n1,info)
                    call la_${ri}$syrk('U','N',n1,n2,one,a(n1*n1),n1,one,a(0),n1)

                    call la_${ri}$trmm('R','L','N','N',n1,n2,one,a(1),n1,a(n1*n1),n1 &
                              )
                    call la_${ri}$lauum('L',n2,a(1),n1,info)
                 else
                    ! srpa for upper, transpose, and n is odd
                    ! t1 -> a(0+n2*n2), t2 -> a(0+n1*n2), s -> a(0)
                    call la_${ri}$lauum('U',n1,a(n2*n2),n2,info)
                    call la_${ri}$syrk('U','T',n1,n2,one,a(0),n2,one,a(n2*n2),n2)

                    call la_${ri}$trmm('L','L','T','N',n2,n1,one,a(n1*n2),n2,a(0),n2 &
                              )
                    call la_${ri}$lauum('L',n2,a(n1*n2),n2,info)
                 end if
              end if
           else
              ! n is even
              if (normaltransr) then
                 ! n is even and transr = 'n'
                 if (lower) then
                    ! srpa for lower, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(1,0), t2 -> a(0,0), s -> a(k+1,0)
                    ! t1 -> a(1), t2 -> a(0), s -> a(k+1)
                    call la_${ri}$lauum('L',k,a(1),n + 1,info)
                    call la_${ri}$syrk('L','T',k,k,one,a(k + 1),n + 1,one,a(1),n + 1)

                    call la_${ri}$trmm('L','U','N','N',k,k,one,a(0),n + 1,a(k + 1),n + 1)

                    call la_${ri}$lauum('U',k,a(0),n + 1,info)
                 else
                    ! srpa for upper, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(k+1,0) ,  t2 -> a(k,0),   s -> a(0,0)
                    ! t1 -> a(k+1), t2 -> a(k), s -> a(0)
                    call la_${ri}$lauum('L',k,a(k + 1),n + 1,info)
                    call la_${ri}$syrk('L','N',k,k,one,a(0),n + 1,one,a(k + 1),n + 1)

                    call la_${ri}$trmm('R','U','T','N',k,k,one,a(k),n + 1,a(0),n + 1)

                    call la_${ri}$lauum('U',k,a(k),n + 1,info)
                 end if
              else
                 ! n is even and transr = 't'
                 if (lower) then
                    ! srpa for lower, transpose, and n is even (see paper)
                    ! t1 -> b(0,1), t2 -> b(0,0), s -> b(0,k+1),
                    ! t1 -> a(0+k), t2 -> a(0+0), s -> a(0+k*(k+1)); lda=k
                    call la_${ri}$lauum('U',k,a(k),k,info)
                    call la_${ri}$syrk('U','N',k,k,one,a(k*(k + 1)),k,one,a(k),k)

                    call la_${ri}$trmm('R','L','N','N',k,k,one,a(0),k,a(k*(k + 1)),k &
                              )
                    call la_${ri}$lauum('L',k,a(0),k,info)
                 else
                    ! srpa for upper, transpose, and n is even (see paper)
                    ! t1 -> b(0,k+1),     t2 -> b(0,k),   s -> b(0,0),
                    ! t1 -> a(0+k*(k+1)), t2 -> a(0+k*k), s -> a(0+0)); lda=k
                    call la_${ri}$lauum('U',k,a(k*(k + 1)),k,info)
                    call la_${ri}$syrk('U','T',k,k,one,a(0),k,one,a(k*(k + 1)),k)

                    call la_${ri}$trmm('L','L','T','N',k,k,one,a(k*k),k,a(0),k)

                    call la_${ri}$lauum('L',k,a(k*k),k,info)
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$pftri
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRF: computes the Cholesky factorization of a real symmetric
     !> positive definite matrix A.
     !> The factorization has the form
     !> A = U**T * U,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the block version of the algorithm, calling Level 3 BLAS.

     pure subroutine la_${ri}$potrf(uplo,n,a,lda,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! determine the block size for this environment.
           nb = la_ilaenv(1,'${ri.upper()}$POTRF',uplo,n,-1,-1,-1)
           if (nb <= 1 .or. nb >= n) then
              ! use unblocked code.
              call la_${ri}$potrf2(uplo,n,a,lda,info)
           else
              ! use blocked code.
              if (upper) then
                 ! compute the cholesky factorization a = u**t*u.
                 do j = 1,n,nb
                    ! update and factorize the current diagonal block and test
                    ! for non-positive-definiteness.
                    jb = min(nb,n - j + 1)
                    call la_${ri}$syrk('UPPER','TRANSPOSE',jb,j - 1,-one,a(1,j),lda,one,a( &
                               j,j),lda)
                    call la_${ri}$potrf2('UPPER',jb,a(j,j),lda,info)
                    if (info /= 0) go to 30
                    if (j + jb <= n) then
                       ! compute the current block row.
                       call la_${ri}$gemm('TRANSPOSE','NO TRANSPOSE',jb,n - j - jb + 1,j - 1,-one,a( &
                                 1,j),lda,a(1,j + jb),lda,one,a(j,j + jb),lda)
                       call la_${ri}$trsm('LEFT','UPPER','TRANSPOSE','NON-UNIT',jb,n - j - jb + 1, &
                                 one,a(j,j),lda,a(j,j + jb),lda)
                    end if
                 end do
              else
                 ! compute the cholesky factorization a = l*l**t.
                 do j = 1,n,nb
                    ! update and factorize the current diagonal block and test
                    ! for non-positive-definiteness.
                    jb = min(nb,n - j + 1)
                    call la_${ri}$syrk('LOWER','NO TRANSPOSE',jb,j - 1,-one,a(j,1),lda,one, &
                               a(j,j),lda)
                    call la_${ri}$potrf2('LOWER',jb,a(j,j),lda,info)
                    if (info /= 0) go to 30
                    if (j + jb <= n) then
                       ! compute the current block column.
                       call la_${ri}$gemm('NO TRANSPOSE','TRANSPOSE',n - j - jb + 1,jb,j - 1,-one,a( &
                                 j + jb,1),lda,a(j,1),lda,one,a(j + jb,j),lda)
                       call la_${ri}$trsm('RIGHT','LOWER','TRANSPOSE','NON-UNIT',n - j - jb + 1,jb, &
                                 one,a(j,j),lda,a(j + jb,j),lda)
                    end if
                 end do
              end if
           end if
           go to 40
           30 continue
           info = info + j - 1
           40 continue
           return
     end subroutine la_${ri}$potrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is symmetric positive definite
     !> and tridiagonal, and provides error bounds and backward error
     !> estimates for the solution.

     pure subroutine la_${ri}$ptrfs(n,nrhs,d,e,df,ef,b,ldb,x,ldx,ferr,berr,work,info)
        use la_constants_${rk}$,only:zero,one,two,three

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,ldx,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: b(ldb,*),d(*),df(*),e(*),ef(*)
           real(${rk}$),intent(out) :: berr(*),ferr(*),work(*)
           real(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           integer(ilp) :: count,i,ix,j,nz
           real(${rk}$) :: bi,cx,dx,eps,ex,lstres,s,safe1,safe2,safmin
           ! Intrinsic Functions
           intrinsic :: abs,max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (n < 0) then
              info = -1
           else if (nrhs < 0) then
              info = -2
           else if (ldb < max(1,n)) then
              info = -8
           else if (ldx < max(1,n)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PTRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = 4
           eps = la_${ri}$lamch('EPSILON')
           safmin = la_${ri}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_90: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x.  also compute
              ! abs(a)*abs(x) + abs(b) for use in the backward error bound.
              if (n == 1) then
                 bi = b(1,j)
                 dx = d(1)*x(1,j)
                 work(n + 1) = bi - dx
                 work(1) = abs(bi) + abs(dx)
              else
                 bi = b(1,j)
                 dx = d(1)*x(1,j)
                 ex = e(1)*x(2,j)
                 work(n + 1) = bi - dx - ex
                 work(1) = abs(bi) + abs(dx) + abs(ex)
                 do i = 2,n - 1
                    bi = b(i,j)
                    cx = e(i - 1)*x(i - 1,j)
                    dx = d(i)*x(i,j)
                    ex = e(i)*x(i + 1,j)
                    work(n + i) = bi - cx - dx - ex
                    work(i) = abs(bi) + abs(cx) + abs(dx) + abs(ex)
                 end do
                 bi = b(n,j)
                 cx = e(n - 1)*x(n - 1,j)
                 dx = d(n)*x(n,j)
                 work(n + n) = bi - cx - dx
                 work(n) = abs(bi) + abs(cx) + abs(dx)
              end if
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              s = zero
              do i = 1,n
                 if (work(i) > safe2) then
                    s = max(s,abs(work(n + i))/work(i))
                 else
                    s = max(s, (abs(work(n + i)) + safe1)/(work(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$pttrs(n,1,df,ef,work(n + 1),n,info)
                 call la_${ri}$axpy(n,one,work(n + 1),1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              do i = 1,n
                 if (work(i) > safe2) then
                    work(i) = abs(work(n + i)) + nz*eps*work(i)
                 else
                    work(i) = abs(work(n + i)) + nz*eps*work(i) + safe1
                 end if
              end do
              ix = la_i${ri}$amax(n,work,1)
              ferr(j) = work(ix)
              ! estimate the norm of inv(a).
              ! solve m(a) * x = e, where m(a) = (m(i,j)) is given by
                 ! m(i,j) =  abs(a(i,j)), i = j,
                 ! m(i,j) = -abs(a(i,j)), i .ne. j,
              ! and e = [ 1, 1, ..., 1 ]**t.  note m(a) = m(l)*d*m(l)**t.
              ! solve m(l) * x = e.
              work(1) = one
              do i = 2,n
                 work(i) = one + work(i - 1)*abs(ef(i - 1))
              end do
              ! solve d * m(l)**t * x = b.
              work(n) = work(n)/df(n)
              do i = n - 1,1,-1
                 work(i) = work(i)/df(i) + work(i + 1)*abs(ef(i))
              end do
              ! compute norm(inv(a)) = max(x(i)), 1<=i<=n.
              ix = la_i${ri}$amax(n,work,1)
              ferr(j) = ferr(j)*abs(work(ix))
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,abs(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_90
           return
     end subroutine la_${ri}$ptrfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LA_PORPVGRW: computes the reciprocal pivot growth factor
     !> norm(A)/norm(U). The "max absolute element" norm is used. If this is
     !> much less than 1, the stability of the LU factorization of the
     !> (equilibrated) matrix A could be poor. This also means that the
     !> solution X, estimated condition numbers, and error bounds could be
     !> unreliable.

     real(${rk}$) function la_${ri}$la_porpvgrw(uplo,ncols,a,lda,af,ldaf,work)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: ncols,lda,ldaf
           ! Array Arguments
           real(${rk}$),intent(in) :: a(lda,*),af(ldaf,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: amax,umax,rpvgrw
           logical(lk) :: upper
           ! Intrinsic Functions
           intrinsic :: abs,max,min
           ! Executable Statements
           upper = la_lsame('UPPER',uplo)
           ! la_${ri}$potrf will have factored only the ncolsxncols leading minor, so
           ! we restrict the growth search to that minor and use only the first
           ! 2*ncols workspace entries.
           rpvgrw = one
           do i = 1,2*ncols
              work(i) = zero
           end do
           ! find the max magnitude entry of each column.
           if (upper) then
              do j = 1,ncols
                 do i = 1,j
                    work(ncols + j) = max(abs(a(i,j)),work(ncols + j))
                 end do
              end do
           else
              do j = 1,ncols
                 do i = j,ncols
                    work(ncols + j) = max(abs(a(i,j)),work(ncols + j))
                 end do
              end do
           end if
           ! now find the max magnitude entry of each column of the factor in
           ! af.  no pivoting, so no permutations.
           if (la_lsame('UPPER',uplo)) then
              do j = 1,ncols
                 do i = 1,j
                    work(j) = max(abs(af(i,j)),work(j))
                 end do
              end do
           else
              do j = 1,ncols
                 do i = j,ncols
                    work(j) = max(abs(af(i,j)),work(j))
                 end do
              end do
           end if
           ! compute the *inverse* of the max element growth factor.  dividing
           ! by zero would imply the largest entry of the factor's column is
           ! zero.  than can happen when either the column of a is zero or
           ! massive pivots made the factor underflow to zero.  neither counts
           ! as growth in itself, so simply ignore terms with zero
           ! denominators.
           if (la_lsame('UPPER',uplo)) then
              do i = 1,ncols
                 umax = work(i)
                 amax = work(ncols + i)
#:if rk == "sp"
                 if (umax /= 0.0_${rk}$) then
#:else
                 if (umax /= zero) then
#:endif
                    rpvgrw = min(amax/umax,rpvgrw)
                 end if
              end do
           else
              do i = 1,ncols
                 umax = work(i)
                 amax = work(ncols + i)
#:if rk == "sp"
                 if (umax /= 0.0_${rk}$) then
#:else
                 if (umax /= zero) then
#:endif
                    rpvgrw = min(amax/umax,rpvgrw)
                 end if
              end do
           end if
           la_${ri}$la_porpvgrw = rpvgrw
     end function la_${ri}$la_porpvgrw
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PFTRF: computes the Cholesky factorization of a real symmetric
     !> positive definite matrix A.
     !> The factorization has the form
     !> A = U**T * U,  if UPLO = 'U', or
     !> A = L  * L**T,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the block version of the algorithm, calling Level 3 BLAS.

     pure subroutine la_${ri}$pftrf(transr,uplo,n,a,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: transr,uplo
           integer(ilp),intent(in) :: n
           integer(ilp),intent(out) :: info
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(0:*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,nisodd,normaltransr
           integer(ilp) :: n1,n2,k
           ! Intrinsic Functions
           intrinsic :: mod
           ! Executable Statements
           ! test the input parameters.
           info = 0
           normaltransr = la_lsame(transr,'N')
           lower = la_lsame(uplo,'L')
           if (.not. normaltransr .and. .not. la_lsame(transr,'T')) then
              info = -1
           else if (.not. lower .and. .not. la_lsame(uplo,'U')) then
              info = -2
           else if (n < 0) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PFTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! if n is odd, set nisodd = .true.
           ! if n is even, set k = n/2 and nisodd = .false.
           if (mod(n,2) == 0) then
              k = n/2
              nisodd = .false.
           else
              nisodd = .true.
           end if
           ! set n1 and n2 depending on lower
           if (lower) then
              n2 = n/2
              n1 = n - n2
           else
              n1 = n/2
              n2 = n - n1
           end if
           ! start execution: there are eight cases
           if (nisodd) then
              ! n is odd
              if (normaltransr) then
                 ! n is odd and transr = 'n'
                 if (lower) then
                   ! srpa for lower, normal and n is odd ( a(0:n-1,0:n1-1) )
                   ! t1 -> a(0,0), t2 -> a(0,1), s -> a(n1,0)
                   ! t1 -> a(0), t2 -> a(n), s -> a(n1)
                    call la_${ri}$potrf('L',n1,a(0),n,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','L','T','N',n2,n1,one,a(0),n,a(n1),n)

                    call la_${ri}$syrk('U','N',n2,n1,-one,a(n1),n,one,a(n),n)
                    call la_${ri}$potrf('U',n2,a(n),n,info)
                    if (info > 0) info = info + n1
                 else
                   ! srpa for upper, normal and n is odd ( a(0:n-1,0:n2-1)
                   ! t1 -> a(n1+1,0), t2 -> a(n1,0), s -> a(0,0)
                   ! t1 -> a(n2), t2 -> a(n1), s -> a(0)
                    call la_${ri}$potrf('L',n1,a(n2),n,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','L','N','N',n1,n2,one,a(n2),n,a(0),n)

                    call la_${ri}$syrk('U','T',n2,n1,-one,a(0),n,one,a(n1),n)
                    call la_${ri}$potrf('U',n2,a(n1),n,info)
                    if (info > 0) info = info + n1
                 end if
              else
                 ! n is odd and transr = 't'
                 if (lower) then
                    ! srpa for lower, transpose and n is odd
                    ! t1 -> a(0,0) , t2 -> a(1,0) , s -> a(0,n1)
                    ! t1 -> a(0+0) , t2 -> a(1+0) , s -> a(0+n1*n1); lda=n1
                    call la_${ri}$potrf('U',n1,a(0),n1,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','U','T','N',n1,n2,one,a(0),n1,a(n1*n1),n1 &
                              )
                    call la_${ri}$syrk('L','T',n2,n1,-one,a(n1*n1),n1,one,a(1),n1)

                    call la_${ri}$potrf('L',n2,a(1),n1,info)
                    if (info > 0) info = info + n1
                 else
                    ! srpa for upper, transpose and n is odd
                    ! t1 -> a(0,n1+1), t2 -> a(0,n1), s -> a(0,0)
                    ! t1 -> a(n2*n2), t2 -> a(n1*n2), s -> a(0); lda = n2
                    call la_${ri}$potrf('U',n1,a(n2*n2),n2,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','U','N','N',n2,n1,one,a(n2*n2),n2,a(0),n2 &
                              )
                    call la_${ri}$syrk('L','N',n2,n1,-one,a(0),n2,one,a(n1*n2),n2)

                    call la_${ri}$potrf('L',n2,a(n1*n2),n2,info)
                    if (info > 0) info = info + n1
                 end if
              end if
           else
              ! n is even
              if (normaltransr) then
                 ! n is even and transr = 'n'
                 if (lower) then
                    ! srpa for lower, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(1,0), t2 -> a(0,0), s -> a(k+1,0)
                    ! t1 -> a(1), t2 -> a(0), s -> a(k+1)
                    call la_${ri}$potrf('L',k,a(1),n + 1,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','L','T','N',k,k,one,a(1),n + 1,a(k + 1),n + 1)

                    call la_${ri}$syrk('U','N',k,k,-one,a(k + 1),n + 1,one,a(0),n + 1)

                    call la_${ri}$potrf('U',k,a(0),n + 1,info)
                    if (info > 0) info = info + k
                 else
                    ! srpa for upper, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(k+1,0) ,  t2 -> a(k,0),   s -> a(0,0)
                    ! t1 -> a(k+1), t2 -> a(k), s -> a(0)
                    call la_${ri}$potrf('L',k,a(k + 1),n + 1,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','L','N','N',k,k,one,a(k + 1),n + 1,a(0),n + 1)

                    call la_${ri}$syrk('U','T',k,k,-one,a(0),n + 1,one,a(k),n + 1)

                    call la_${ri}$potrf('U',k,a(k),n + 1,info)
                    if (info > 0) info = info + k
                 end if
              else
                 ! n is even and transr = 't'
                 if (lower) then
                    ! srpa for lower, transpose and n is even (see paper)
                    ! t1 -> b(0,1), t2 -> b(0,0), s -> b(0,k+1)
                    ! t1 -> a(0+k), t2 -> a(0+0), s -> a(0+k*(k+1)); lda=k
                    call la_${ri}$potrf('U',k,a(0 + k),k,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','U','T','N',k,k,one,a(k),n1,a(k*(k + 1)), &
                              k)
                    call la_${ri}$syrk('L','T',k,k,-one,a(k*(k + 1)),k,one,a(0),k)

                    call la_${ri}$potrf('L',k,a(0),k,info)
                    if (info > 0) info = info + k
                 else
                    ! srpa for upper, transpose and n is even (see paper)
                    ! t1 -> b(0,k+1),     t2 -> b(0,k),   s -> b(0,0)
                    ! t1 -> a(0+k*(k+1)), t2 -> a(0+k*k), s -> a(0+0)); lda=k
                    call la_${ri}$potrf('U',k,a(k*(k + 1)),k,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','U','N','N',k,k,one,a(k*(k + 1)),k,a(0),k &
                              )
                    call la_${ri}$syrk('L','N',k,k,-one,a(0),k,one,a(k*k),k)
                    call la_${ri}$potrf('L',k,a(k*k),k,info)
                    if (info > 0) info = info + k
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$pftrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LA_PORPVGRW: computes the reciprocal pivot growth factor
     !> norm(A)/norm(U). The "max absolute element" norm is used. If this is
     !> much less than 1, the stability of the LU factorization of the
     !> (equilibrated) matrix A could be poor. This also means that the
     !> solution X, estimated condition numbers, and error bounds could be
     !> unreliable.

     real(${rk}$) function la_${ri}$la_porpvgrw(uplo,ncols,a,lda,af,ldaf,work)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: ncols,lda,ldaf
           ! Array Arguments
           complex(${rk}$),intent(in) :: a(lda,*),af(ldaf,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: amax,umax,rpvgrw
           logical(lk) :: upper
           complex(${rk}$) :: zdum
           ! Intrinsic Functions
           intrinsic :: abs,max,min,real,aimag
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           upper = la_lsame('UPPER',uplo)
           ! la_${ci}$potrf will have factored only the ncolsxncols leading minor, so
           ! we restrict the growth search to that minor and use only the first
           ! 2*ncols workspace entries.
           rpvgrw = one
           do i = 1,2*ncols
              work(i) = zero
           end do
           ! find the max magnitude entry of each column.
           if (upper) then
              do j = 1,ncols
                 do i = 1,j
                    work(ncols + j) = max(cabs1(a(i,j)),work(ncols + j))
                 end do
              end do
           else
              do j = 1,ncols
                 do i = j,ncols
                    work(ncols + j) = max(cabs1(a(i,j)),work(ncols + j))
                 end do
              end do
           end if
           ! now find the max magnitude entry of each column of the factor in
           ! af.  no pivoting, so no permutations.
           if (la_lsame('UPPER',uplo)) then
              do j = 1,ncols
                 do i = 1,j
                    work(j) = max(cabs1(af(i,j)),work(j))
                 end do
              end do
           else
              do j = 1,ncols
                 do i = j,ncols
                    work(j) = max(cabs1(af(i,j)),work(j))
                 end do
              end do
           end if
           ! compute the *inverse* of the max element growth factor.  dividing
           ! by zero would imply the largest entry of the factor's column is
           ! zero.  than can happen when either the column of a is zero or
           ! massive pivots made the factor underflow to zero.  neither counts
           ! as growth in itself, so simply ignore terms with zero
           ! denominators.
           if (la_lsame('UPPER',uplo)) then
              do i = 1,ncols
                 umax = work(i)
                 amax = work(ncols + i)
#:if rk == "sp"
                 if (umax /= 0.0_${rk}$) then
#:else
                 if (umax /= zero) then
#:endif
                    rpvgrw = min(amax/umax,rpvgrw)
                 end if
              end do
           else
              do i = 1,ncols
                 umax = work(i)
                 amax = work(ncols + i)
#:if rk == "sp"
                 if (umax /= 0.0_${rk}$) then
#:else
                 if (umax /= zero) then
#:endif
                    rpvgrw = min(amax/umax,rpvgrw)
                 end if
              end do
           end if
           la_${ri}$la_porpvgrw = rpvgrw
     end function la_${ri}$la_porpvgrw
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
#:if rk == "sp"
     !> ${ri.upper()}$LAQHB: equilibrates an Hermitian band matrix A using the scaling
     !> factors in the vector S.
#:else
     !> ${ri.upper()}$LAQHB: equilibrates a Hermitian band matrix A
     !> using the scaling factors in the vector S.
#:endif

     pure subroutine la_${ri}$laqhb(uplo,n,kd,ab,ldab,s,scond,amax,equed)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: kd,ldab,n
           real(${rk}$),intent(in) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(out) :: s(*)
           complex(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: cj,large,small
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real
#:else
           intrinsic :: real,max,min
#:endif
           ! Executable Statements
           ! quick return if possible
           if (n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ci}$lamch('SAFE MINIMUM')/la_${ci}$lamch('PRECISION')
           large = one/small
           if (scond >= thresh .and. amax >= small .and. amax <= large) then
              ! no equilibration
              equed = 'N'
           else
              ! replace a by diag(s) * a * diag(s).
              if (la_lsame(uplo,'U')) then
                 ! upper triangle of a is stored in band format.
                 do j = 1,n
                    cj = s(j)
                    do i = max(1,j - kd),j - 1
                       ab(kd + 1 + i - j,j) = cj*s(i)*ab(kd + 1 + i - j,j)
                    end do
                    ab(kd + 1,j) = cj*cj*real(ab(kd + 1,j),KIND=${rk}$)
                 end do
              else
                 ! lower triangle of a is stored.
                 do j = 1,n
                    cj = s(j)
                    ab(1,j) = cj*cj*real(ab(1,j),KIND=${rk}$)
                    do i = j + 1,min(n,j + kd)
                       ab(1 + i - j,j) = cj*s(i)*ab(1 + i - j,j)
                    end do
                 end do
              end if
              equed = 'Y'
           end if
           return
     end subroutine la_${ri}$laqhb
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LAQHE: equilibrates a Hermitian matrix A using the scaling factors
     !> in the vector S.

     pure subroutine la_${ri}$laqhe(uplo,n,a,lda,s,scond,amax,equed)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(in) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: s(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j
           real(${rk}$) :: cj,large,small
           ! Intrinsic Functions
           intrinsic :: real
           ! Executable Statements
           ! quick return if possible
           if (n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ci}$lamch('SAFE MINIMUM')/la_${ci}$lamch('PRECISION')
           large = one/small
           if (scond >= thresh .and. amax >= small .and. amax <= large) then
              ! no equilibration
              equed = 'N'
           else
              ! replace a by diag(s) * a * diag(s).
              if (la_lsame(uplo,'U')) then
                 ! upper triangle of a is stored.
                 do j = 1,n
                    cj = s(j)
                    do i = 1,j - 1
                       a(i,j) = cj*s(i)*a(i,j)
                    end do
                    a(j,j) = cj*cj*real(a(j,j),KIND=${rk}$)
                 end do
              else
                 ! lower triangle of a is stored.
                 do j = 1,n
                    cj = s(j)
                    a(j,j) = cj*cj*real(a(j,j),KIND=${rk}$)
                    do i = j + 1,n
                       a(i,j) = cj*s(i)*a(i,j)
                    end do
                 end do
              end if
              equed = 'Y'
           end if
           return
     end subroutine la_${ri}$laqhe
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LAQHP: equilibrates a Hermitian matrix A using the scaling factors
     !> in the vector S.

     pure subroutine la_${ri}$laqhp(uplo,n,ap,s,scond,amax,equed)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: s(*)
           complex(${rk}$),intent(inout) :: ap(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j,jc
           real(${rk}$) :: cj,large,small
           ! Intrinsic Functions
           intrinsic :: real
           ! Executable Statements
           ! quick return if possible
           if (n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ci}$lamch('SAFE MINIMUM')/la_${ci}$lamch('PRECISION')
           large = one/small
           if (scond >= thresh .and. amax >= small .and. amax <= large) then
              ! no equilibration
              equed = 'N'
           else
              ! replace a by diag(s) * a * diag(s).
              if (la_lsame(uplo,'U')) then
                 ! upper triangle of a is stored.
                 jc = 1
                 do j = 1,n
                    cj = s(j)
                    do i = 1,j - 1
                       ap(jc + i - 1) = cj*s(i)*ap(jc + i - 1)
                    end do
                    ap(jc + j - 1) = cj*cj*real(ap(jc + j - 1),KIND=${rk}$)
                    jc = jc + j
                 end do
              else
                 ! lower triangle of a is stored.
                 jc = 1
                 do j = 1,n
                    cj = s(j)
                    ap(jc) = cj*cj*real(ap(jc),KIND=${rk}$)
                    do i = j + 1,n
                       ap(jc + i - j) = cj*s(i)*ap(jc + i - j)
                    end do
                    jc = jc + n - j + 1
                 end do
              end if
              equed = 'Y'
           end if
           return
     end subroutine la_${ri}$laqhp
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$LAQSP: equilibrates a symmetric matrix A using the scaling factors
     !> in the vector S.

     pure subroutine la_${ri}$laqsp(uplo,n,ap,s,scond,amax,equed)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(out) :: equed
           character,intent(in) :: uplo
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(in) :: s(*)
           complex(${rk}$),intent(inout) :: ap(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: thresh = 0.1e+0_${rk}$

           ! Local Scalars
           integer(ilp) :: i,j,jc
           real(${rk}$) :: cj,large,small
           ! Executable Statements
           ! quick return if possible
           if (n <= 0) then
              equed = 'N'
              return
           end if
           ! initialize large and small.
           small = la_${ci}$lamch('SAFE MINIMUM')/la_${ci}$lamch('PRECISION')
           large = one/small
           if (scond >= thresh .and. amax >= small .and. amax <= large) then
              ! no equilibration
              equed = 'N'
           else
              ! replace a by diag(s) * a * diag(s).
              if (la_lsame(uplo,'U')) then
                 ! upper triangle of a is stored.
                 jc = 1
                 do j = 1,n
                    cj = s(j)
                    do i = 1,j
                       ap(jc + i - 1) = cj*s(i)*ap(jc + i - 1)
                    end do
                    jc = jc + j
                 end do
              else
                 ! lower triangle of a is stored.
                 jc = 1
                 do j = 1,n
                    cj = s(j)
                    do i = j,n
                       ap(jc + i - j) = cj*s(i)*ap(jc + i - j)
                    end do
                    jc = jc + n - j + 1
                 end do
              end if
              equed = 'Y'
           end if
           return
     end subroutine la_${ri}$laqsp
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBCON: estimates the reciprocal of the condition number (in the
     !> 1-norm) of a complex Hermitian positive definite band matrix using
     !> the Cholesky factorization A = U**H*U or A = L*L**H computed by
     !> ${ri.upper()}$PBTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$pbcon(uplo,n,kd,ab,ldab,anorm,rcond,work,rwork,info)
        use la_constants_${rk}$,only:zero,one

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(in) :: ab(ldab,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           character :: normin
           integer(ilp) :: ix,kase
           real(${rk}$) :: ainvnm,scale,scalel,scaleu,smlnum
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,real
#:else
           intrinsic :: abs,real,aimag
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           else if (anorm < zero) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ci}$lamch('SAFE MINIMUM')
           ! estimate the 1-norm of the inverse.
           kase = 0
           normin = 'N'
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,ainvnm,kase,isave)
           if (kase /= 0) then
              if (upper) then
                 ! multiply by inv(u**h).
                 call la_${ri}$latbs('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,kd,ab, &
                            ldab,work,scalel,rwork,info)
                 normin = 'Y'
                 ! multiply by inv(u).
                 call la_${ri}$latbs('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,kd,ab,ldab, &
                           work,scaleu,rwork,info)
              else
                 ! multiply by inv(l).
                 call la_${ri}$latbs('LOWER','NO TRANSPOSE','NON-UNIT',normin,n,kd,ab,ldab, &
                           work,scalel,rwork,info)
                 normin = 'Y'
                 ! multiply by inv(l**h).
                 call la_${ri}$latbs('LOWER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,kd,ab, &
                            ldab,work,scaleu,rwork,info)
              end if
              ! multiply by 1/scale if doing so will not cause overflow.
              scale = scalel*scaleu
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < cabs1(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$${ci}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$pbcon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBEQU: computes row and column scalings intended to equilibrate a
     !> Hermitian positive definite band matrix A and reduce its condition
     !> number (with respect to the two-norm).  S contains the scale factors,
     !> S(i) = 1/sqrt(A(i,i)), chosen so that the scaled matrix B with
     !> elements B(i,j) = S(i)*A(i,j)*S(j) has ones on the diagonal.  This
     !> choice of S puts the condition number of B within a factor N of the
     !> smallest possible condition number over all possible diagonal
     !> scalings.

     pure subroutine la_${ri}$pbequ(uplo,n,kd,ab,ldab,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(out) :: s(*)
           complex(${rk}$),intent(in) :: ab(ldab,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i,j
           real(${rk}$) :: smin
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBEQU',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           if (upper) then
              j = kd + 1
           else
              j = 1
           end if
           ! initialize smin and amax.
           s(1) = real(ab(j,1),KIND=${rk}$)
           smin = s(1)
           amax = s(1)
           ! find the minimum and maximum diagonal elements.
           do i = 2,n
              s(i) = real(ab(j,i),KIND=${rk}$)
              smin = min(smin,s(i))
              amax = max(amax,s(i))
           end do
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = one/sqrt(s(i))
              end do
              ! compute scond = min(s(i)) / max(s(i))
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$pbequ
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBTF2: computes the Cholesky factorization of a complex Hermitian
     !> positive definite band matrix A.
     !> The factorization has the form
     !> A = U**H * U ,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix, U**H is the conjugate transpose
     !> of U, and L is lower triangular.
     !> This is the unblocked version of the algorithm, calling Level 2 BLAS.

     pure subroutine la_${ri}$pbtf2(uplo,n,kd,ab,ldab,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,kld,kn
           real(${rk}$) :: ajj
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBTF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           kld = max(1,ldab - 1)
           if (upper) then
              ! compute the cholesky factorization a = u**h * u.
              do j = 1,n
                 ! compute u(j,j) and test for non-positive-definiteness.
                 ajj = real(ab(kd + 1,j),KIND=${rk}$)
                 if (ajj <= zero) then
                    ab(kd + 1,j) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 ab(kd + 1,j) = ajj
                 ! compute elements j+1:j+kn of row j and update the
                 ! trailing submatrix within the band.
                 kn = min(kd,n - j)
                 if (kn > 0) then
                    call la_${ri}$${ci}$scal(kn,one/ajj,ab(kd,j + 1),kld)
                    call la_${ri}$lacgv(kn,ab(kd,j + 1),kld)
                    call la_${ri}$her('UPPER',kn,-one,ab(kd,j + 1),kld,ab(kd + 1,j + 1),kld)

                    call la_${ri}$lacgv(kn,ab(kd,j + 1),kld)
                 end if
              end do
           else
              ! compute the cholesky factorization a = l*l**h.
              do j = 1,n
                 ! compute l(j,j) and test for non-positive-definiteness.
                 ajj = real(ab(1,j),KIND=${rk}$)
                 if (ajj <= zero) then
                    ab(1,j) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 ab(1,j) = ajj
                 ! compute elements j+1:j+kn of column j and update the
                 ! trailing submatrix within the band.
                 kn = min(kd,n - j)
                 if (kn > 0) then
                    call la_${ri}$${ci}$scal(kn,one/ajj,ab(2,j),1)
                    call la_${ri}$her('LOWER',kn,-one,ab(2,j),1,ab(1,j + 1),kld)
                 end if
              end do
           end if
           return
           30 continue
           info = j
           return
     end subroutine la_${ri}$pbtf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBTRS: solves a system of linear equations A*X = B with a Hermitian
     !> positive definite band matrix A using the Cholesky factorization
#:if rk == "sp"
     !> A = U**H*U or A = L*L**H computed by ${ri.upper()}$PBTRF.
#:else
     !> A = U**H *U or A = L*L**H computed by ${ri.upper()}$PBTRF.
#:endif

     pure subroutine la_${ri}$pbtrs(uplo,n,kd,nrhs,ab,ldab,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldb,n,nrhs
           ! Array Arguments
           complex(${rk}$),intent(in) :: ab(ldab,*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (nrhs < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldb < max(1,n)) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (upper) then
              ! solve a*x = b where a = u**h *u.
              do j = 1,nrhs
                 ! solve u**h *x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b( &
                            1,j),1)
                 ! solve u*x = b, overwriting b with x.
                 call la_${ri}$tbsv('UPPER','NO TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b(1,j) &
                           ,1)
              end do
           else
              ! solve a*x = b where a = l*l**h.
              do j = 1,nrhs
                 ! solve l*x = b, overwriting b with x.
                 call la_${ri}$tbsv('LOWER','NO TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b(1,j) &
                           ,1)
                 ! solve l**h *x = b, overwriting b with x.
                 call la_${ri}$tbsv('LOWER','CONJUGATE TRANSPOSE','NON-UNIT',n,kd,ab,ldab,b( &
                            1,j),1)
              end do
           end if
           return
     end subroutine la_${ri}$pbtrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POCON: estimates the reciprocal of the condition number (in the
     !> 1-norm) of a complex Hermitian positive definite matrix using the
     !> Cholesky factorization A = U**H*U or A = L*L**H computed by ${ri.upper()}$POTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$pocon(uplo,n,a,lda,anorm,rcond,work,rwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           character :: normin
           integer(ilp) :: ix,kase
           real(${rk}$) :: ainvnm,scale,scalel,scaleu,smlnum
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,real
#:else
           intrinsic :: abs,real,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           else if (anorm < zero) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ci}$lamch('SAFE MINIMUM')
           ! estimate the 1-norm of inv(a).
           kase = 0
           normin = 'N'
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,ainvnm,kase,isave)
           if (kase /= 0) then
              if (upper) then
                 ! multiply by inv(u**h).
                 call la_${ri}$latrs('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,a,lda, &
                            work,scalel,rwork,info)
                 normin = 'Y'
                 ! multiply by inv(u).
                 call la_${ri}$latrs('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           scaleu,rwork,info)
              else
                 ! multiply by inv(l).
                 call la_${ri}$latrs('LOWER','NO TRANSPOSE','NON-UNIT',normin,n,a,lda,work, &
                           scalel,rwork,info)
                 normin = 'Y'
                 ! multiply by inv(l**h).
                 call la_${ri}$latrs('LOWER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,a,lda, &
                            work,scaleu,rwork,info)
              end if
              ! multiply by 1/scale if doing so will not cause overflow.
              scale = scalel*scaleu
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < cabs1(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$${ci}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$pocon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POEQU: computes row and column scalings intended to equilibrate a
     !> Hermitian positive definite matrix A and reduce its condition number
     !> (with respect to the two-norm).  S contains the scale factors,
     !> S(i) = 1/sqrt(A(i,i)), chosen so that the scaled matrix B with
     !> elements B(i,j) = S(i)*A(i,j)*S(j) has ones on the diagonal.  This
     !> choice of S puts the condition number of B within a factor N of the
     !> smallest possible condition number over all possible diagonal
     !> scalings.

     pure subroutine la_${ri}$poequ(n,a,lda,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(out) :: s(*)
           complex(${rk}$),intent(in) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i
           real(${rk}$) :: smin
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (n < 0) then
              info = -1
           else if (lda < max(1,n)) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POEQU',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           ! find the minimum and maximum diagonal elements.
           s(1) = real(a(1,1),KIND=${rk}$)
           smin = s(1)
           amax = s(1)
           do i = 2,n
              s(i) = real(a(i,i),KIND=${rk}$)
              smin = min(smin,s(i))
              amax = max(amax,s(i))
           end do
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = one/sqrt(s(i))
              end do
              ! compute scond = min(s(i)) / max(s(i))
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$poequ
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POEQUB: computes row and column scalings intended to equilibrate a
     !> Hermitian positive definite matrix A and reduce its condition number
     !> (with respect to the two-norm).  S contains the scale factors,
     !> S(i) = 1/sqrt(A(i,i)), chosen so that the scaled matrix B with
     !> elements B(i,j) = S(i)*A(i,j)*S(j) has ones on the diagonal.  This
     !> choice of S puts the condition number of B within a factor N of the
     !> smallest possible condition number over all possible diagonal
     !> scalings.
     !> This routine differs from ${ri.upper()}$POEQU by restricting the scaling factors
     !> to a power of the radix.  Barring over- and underflow, scaling by
     !> these factors introduces no additional rounding errors.  However, the
     !> scaled diagonal entries are no longer approximately 1 but lie
     !> between sqrt(radix) and 1/sqrt(radix).

     pure subroutine la_${ri}$poequb(n,a,lda,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           complex(${rk}$),intent(in) :: a(lda,*)
           real(${rk}$),intent(out) :: s(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i
           real(${rk}$) :: smin,base,tmp
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,sqrt,log,int
#:else
           intrinsic :: max,min,sqrt,log,int,real,aimag
#:endif
           ! Executable Statements
           ! test the input parameters.
           ! positive definite only performs 1 pass of equilibration.
           info = 0
           if (n < 0) then
              info = -1
           else if (lda < max(1,n)) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POEQUB',-info)
              return
           end if
           ! quick return if possible.
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           base = la_${ci}$lamch('B')
#:if rk == "sp"
           tmp = -0.5_${rk}$/log(base)
#:else
           tmp = -0.5e+0_${rk}$/log(base)
#:endif
           ! find the minimum and maximum diagonal elements.
           s(1) = real(a(1,1),KIND=${rk}$)
           smin = s(1)
           amax = s(1)
           do i = 2,n
              s(i) = real(a(i,i),KIND=${rk}$)
              smin = min(smin,s(i))
              amax = max(amax,s(i))
           end do
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = base**int(tmp*log(s(i)),KIND=ilp)
              end do
              ! compute scond = min(s(i)) / max(s(i)).
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$poequb
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTF2: computes the Cholesky factorization of a complex Hermitian
     !> positive definite matrix A.
     !> The factorization has the form
     !> A = U**H * U ,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the unblocked version of the algorithm, calling Level 2 BLAS.

     pure subroutine la_${ri}$potf2(uplo,n,a,lda,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j
           real(${rk}$) :: ajj
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,real,sqrt
#:else
           intrinsic :: real,max,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (upper) then
              ! compute the cholesky factorization a = u**h *u.
              do j = 1,n
                 ! compute u(j,j) and test for non-positive-definiteness.
#:if rk == "sp"
                 ajj = real(real(a(j,j),KIND=${rk}$) - la_${ri}$dotc(j - 1,a(1,j),1,a(1,j), &
#:else
                 ajj = real(a(j,j),KIND=${rk}$) - real(la_${ri}$dotc(j - 1,a(1,j),1,a(1,j), &
#:endif
                            1),KIND=${rk}$)
                 if (ajj <= zero .or. la_${ci}$isnan(ajj)) then
                    a(j,j) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of row j.
                 if (j < n) then
                    call la_${ri}$lacgv(j - 1,a(1,j),1)
                    call la_${ri}$gemv('TRANSPOSE',j - 1,n - j,-cone,a(1,j + 1),lda,a(1,j), &
                              1,cone,a(j,j + 1),lda)
                    call la_${ri}$lacgv(j - 1,a(1,j),1)
                    call la_${ri}$${ci}$scal(n - j,one/ajj,a(j,j + 1),lda)
                 end if
              end do
           else
              ! compute the cholesky factorization a = l*l**h.
              do j = 1,n
                 ! compute l(j,j) and test for non-positive-definiteness.
#:if rk == "sp"
                 ajj = real(real(a(j,j),KIND=${rk}$) - la_${ri}$dotc(j - 1,a(j,1),lda,a(j,1 &
#:else
                 ajj = real(a(j,j),KIND=${rk}$) - real(la_${ri}$dotc(j - 1,a(j,1),lda,a(j,1 &
#:endif
                           ),lda),KIND=${rk}$)
                 if (ajj <= zero .or. la_${ci}$isnan(ajj)) then
                    a(j,j) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of column j.
                 if (j < n) then
                    call la_${ri}$lacgv(j - 1,a(j,1),lda)
                    call la_${ri}$gemv('NO TRANSPOSE',n - j,j - 1,-cone,a(j + 1,1),lda,a(j,1) &
                              ,lda,cone,a(j + 1,j),1)
                    call la_${ri}$lacgv(j - 1,a(j,1),lda)
                    call la_${ri}$${ci}$scal(n - j,one/ajj,a(j + 1,j),1)
                 end if
              end do
           end if
           go to 40
           30 continue
           info = j
           40 continue
           return
     end subroutine la_${ri}$potf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRF2: computes the Cholesky factorization of a Hermitian
     !> positive definite matrix A using the recursive algorithm.
     !> The factorization has the form
     !> A = U**H * U,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the recursive version of the algorithm. It divides
     !> the matrix into four submatrices:
     !> [  A11 | A12  ]  where A11 is n1 by n1 and A22 is n2 by n2
     !> A = [ -----|----- ]  with n1 = n/2
     !> [  A21 | A22  ]       n2 = n-n1
     !> The subroutine calls itself to factor A11. Update and scale A21
#:if rk == "sp"
     !> or A12, update A22 then calls itself to factor A22.
#:else
     !> or A12, update A22 then call itself to factor A22.
#:endif

     pure recursive subroutine la_${ri}$potrf2(uplo,n,a,lda,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: n1,n2,iinfo
           real(${rk}$) :: ajj
           ! Intrinsic Functions
           intrinsic :: max,real,sqrt
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! n=1 case
           if (n == 1) then
              ! test for non-positive-definiteness
              ajj = real(a(1,1),KIND=${rk}$)
              if (ajj <= zero .or. la_${ci}$isnan(ajj)) then
                 info = 1
                 return
              end if
              ! factor
              a(1,1) = sqrt(ajj)
           ! use recursive code
           else
              n1 = n/2
              n2 = n - n1
              ! factor a11
              call la_${ri}$potrf2(uplo,n1,a(1,1),lda,iinfo)
              if (iinfo /= 0) then
                 info = iinfo
                 return
              end if
              ! compute the cholesky factorization a = u**h*u
              if (upper) then
                 ! update and scale a12
                 call la_${ri}$trsm('L','U','C','N',n1,n2,cone,a(1,1),lda,a(1,n1 + 1), &
                            lda)
                 ! update and factor a22
                 call la_${ri}$herk(uplo,'C',n2,n1,-one,a(1,n1 + 1),lda,one,a(n1 + 1,n1 + 1 &
                           ),lda)
                 call la_${ri}$potrf2(uplo,n2,a(n1 + 1,n1 + 1),lda,iinfo)
                 if (iinfo /= 0) then
                    info = iinfo + n1
                    return
                 end if
              ! compute the cholesky factorization a = l*l**h
              else
                 ! update and scale a21
                 call la_${ri}$trsm('R','L','C','N',n2,n1,cone,a(1,1),lda,a(n1 + 1,1), &
                            lda)
                 ! update and factor a22
                 call la_${ri}$herk(uplo,'N',n2,n1,-one,a(n1 + 1,1),lda,one,a(n1 + 1,n1 + 1 &
                           ),lda)
                 call la_${ri}$potrf2(uplo,n2,a(n1 + 1,n1 + 1),lda,iinfo)
                 if (iinfo /= 0) then
                    info = iinfo + n1
                    return
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$potrf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRS: solves a system of linear equations A*X = B with a Hermitian
     !> positive definite matrix A using the Cholesky factorization
#:if rk == "sp"
     !> A = U**H*U or A = L*L**H computed by ${ri.upper()}$POTRF.
#:else
     !> A = U**H * U or A = L * L**H computed by ${ri.upper()}$POTRF.
#:endif

     pure subroutine la_${ri}$potrs(uplo,n,nrhs,a,lda,b,ldb,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,n,nrhs
           ! Array Arguments
           complex(${rk}$),intent(in) :: a(lda,*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (upper) then
              ! solve a*x = b where a = u**h *u.
              ! solve u**h *x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','UPPER','CONJUGATE TRANSPOSE','NON-UNIT',n,nrhs,cone, &
                         a,lda,b,ldb)
              ! solve u*x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','UPPER','NO TRANSPOSE','NON-UNIT',n,nrhs,cone,a, &
                        lda,b,ldb)
           else
              ! solve a*x = b where a = l*l**h.
              ! solve l*x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','NON-UNIT',n,nrhs,cone,a, &
                        lda,b,ldb)
              ! solve l**h *x = b, overwriting b with x.
              call la_${ri}$trsm('LEFT','LOWER','CONJUGATE TRANSPOSE','NON-UNIT',n,nrhs,cone, &
                         a,lda,b,ldb)
           end if
           return
     end subroutine la_${ri}$potrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPCON: estimates the reciprocal of the condition number (in the
     !> 1-norm) of a complex Hermitian positive definite packed matrix using
     !> the Cholesky factorization A = U**H*U or A = L*L**H computed by
     !> ${ri.upper()}$PPTRF.
     !> An estimate is obtained for norm(inv(A)), and the reciprocal of the
     !> condition number is computed as RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$ppcon(uplo,n,ap,anorm,rcond,work,rwork,info)
        use la_constants_${rk}$,only:zero,one
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(in) :: ap(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           character :: normin
           integer(ilp) :: ix,kase
           real(${rk}$) :: ainvnm,scale,scalel,scaleu,smlnum
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,real
#:else
           intrinsic :: abs,real,aimag
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (anorm < zero) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           smlnum = la_${ci}$lamch('SAFE MINIMUM')
           ! estimate the 1-norm of the inverse.
           kase = 0
           normin = 'N'
           10 continue
           call la_${ri}$lacn2(n,work(n + 1),work,ainvnm,kase,isave)
           if (kase /= 0) then
              if (upper) then
                 ! multiply by inv(u**h).
                 call la_${ri}$latps('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,ap, &
                           work,scalel,rwork,info)
                 normin = 'Y'
                 ! multiply by inv(u).
                 call la_${ri}$latps('UPPER','NO TRANSPOSE','NON-UNIT',normin,n,ap,work, &
                           scaleu,rwork,info)
              else
                 ! multiply by inv(l).
                 call la_${ri}$latps('LOWER','NO TRANSPOSE','NON-UNIT',normin,n,ap,work, &
                           scalel,rwork,info)
                 normin = 'Y'
                 ! multiply by inv(l**h).
                 call la_${ri}$latps('LOWER','CONJUGATE TRANSPOSE','NON-UNIT',normin,n,ap, &
                           work,scaleu,rwork,info)
              end if
              ! multiply by 1/scale if doing so will not cause overflow.
              scale = scalel*scaleu
              if (scale /= one) then
                 ix = la_i${ri}$amax(n,work,1)
                 if (scale < cabs1(work(ix))*smlnum .or. scale == zero) go to 20
                 call la_${ri}$${ci}$rscl(n,scale,work,1)
              end if
              go to 10
           end if
           ! compute the estimate of the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           20 continue
           return
     end subroutine la_${ri}$ppcon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPEQU: computes row and column scalings intended to equilibrate a
     !> Hermitian positive definite matrix A in packed storage and reduce
     !> its condition number (with respect to the two-norm).  S contains the
     !> scale factors, S(i)=1/sqrt(A(i,i)), chosen so that the scaled matrix
     !> B with elements B(i,j)=S(i)*A(i,j)*S(j) has ones on the diagonal.
     !> This choice of S puts the condition number of B within a factor N of
     !> the smallest possible condition number over all possible diagonal
     !> scalings.

     pure subroutine la_${ri}$ppequ(uplo,n,ap,s,scond,amax,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(out) :: amax,scond
           ! Array Arguments
           real(${rk}$),intent(out) :: s(*)
           complex(${rk}$),intent(in) :: ap(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i,jj
           real(${rk}$) :: smin
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: max,min,real,sqrt
#:else
           intrinsic :: real,max,min,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPEQU',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) then
              scond = one
              amax = zero
              return
           end if
           ! initialize smin and amax.
           s(1) = real(ap(1),KIND=${rk}$)
           smin = s(1)
           amax = s(1)
           if (upper) then
              ! uplo = 'u':  upper triangle of a is stored.
              ! find the minimum and maximum diagonal elements.
              jj = 1
              do i = 2,n
                 jj = jj + i
                 s(i) = real(ap(jj),KIND=${rk}$)
                 smin = min(smin,s(i))
                 amax = max(amax,s(i))
              end do
           else
              ! uplo = 'l':  lower triangle of a is stored.
              ! find the minimum and maximum diagonal elements.
              jj = 1
              do i = 2,n
                 jj = jj + n - i + 2
                 s(i) = real(ap(jj),KIND=${rk}$)
                 smin = min(smin,s(i))
                 amax = max(amax,s(i))
              end do
           end if
           if (smin <= zero) then
              ! find the first non-positive diagonal element and return.
              do i = 1,n
                 if (s(i) <= zero) then
                    info = i
                    return
                 end if
              end do
           else
              ! set the scale factors to the reciprocals
              ! of the diagonal elements.
              do i = 1,n
                 s(i) = one/sqrt(s(i))
              end do
              ! compute scond = min(s(i)) / max(s(i))
              scond = sqrt(smin)/sqrt(amax)
           end if
           return
     end subroutine la_${ri}$ppequ
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPTRF: computes the Cholesky factorization of a complex Hermitian
     !> positive definite matrix A stored in packed format.
     !> The factorization has the form
     !> A = U**H * U,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.

     pure subroutine la_${ri}$pptrf(uplo,n,ap,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ap(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,jc,jj
           real(${rk}$) :: ajj
           ! Intrinsic Functions
           intrinsic :: real,sqrt
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           if (upper) then
              ! compute the cholesky factorization a = u**h * u.
              jj = 0
              do j = 1,n
                 jc = jj + 1
                 jj = jj + j
                 ! compute elements 1:j-1 of column j.
                 if (j > 1) call la_${ri}$tpsv('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',j - 1,ap, &
                           ap(jc),1)
                 ! compute u(j,j) and test for non-positive-definiteness.
#:if rk == "sp"
                 ajj = real(real(ap(jj),KIND=${rk}$) - la_${ri}$dotc(j - 1,ap(jc),1,ap(jc),1 &
#:else
                 ajj = real(ap(jj),KIND=${rk}$) - real(la_${ri}$dotc(j - 1,ap(jc),1,ap(jc),1 &
#:endif
                           ),KIND=${rk}$)
                 if (ajj <= zero) then
                    ap(jj) = ajj
                    go to 30
                 end if
                 ap(jj) = sqrt(ajj)
              end do
           else
              ! compute the cholesky factorization a = l * l**h.
              jj = 1
              do j = 1,n
                 ! compute l(j,j) and test for non-positive-definiteness.
                 ajj = real(ap(jj),KIND=${rk}$)
                 if (ajj <= zero) then
                    ap(jj) = ajj
                    go to 30
                 end if
                 ajj = sqrt(ajj)
                 ap(jj) = ajj
                 ! compute elements j+1:n of column j and update the trailing
                 ! submatrix.
                 if (j < n) then
                    call la_${ri}$${ci}$scal(n - j,one/ajj,ap(jj + 1),1)
                    call la_${ri}$hpr('LOWER',n - j,-one,ap(jj + 1),1,ap(jj + n - j + 1))
                    jj = jj + n - j + 1
                 end if
              end do
           end if
           go to 40
           30 continue
           info = j
           40 continue
           return
     end subroutine la_${ri}$pptrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPTRS: solves a system of linear equations A*X = B with a Hermitian
     !> positive definite matrix A in packed storage using the Cholesky
#:if rk == "sp"
     !> factorization A = U**H*U or A = L*L**H computed by ${ri.upper()}$PPTRF.
#:else
     !> factorization A = U**H * U or A = L * L**H computed by ${ri.upper()}$PPTRF.
#:endif

     pure subroutine la_${ri}$pptrs(uplo,n,nrhs,ap,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           complex(${rk}$),intent(in) :: ap(*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: i
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           if (upper) then
              ! solve a*x = b where a = u**h * u.
              do i = 1,nrhs
                 ! solve u**h *x = b, overwriting b with x.
                 call la_${ri}$tpsv('UPPER','CONJUGATE TRANSPOSE','NON-UNIT',n,ap,b(1,i), &
                           1)
                 ! solve u*x = b, overwriting b with x.
                 call la_${ri}$tpsv('UPPER','NO TRANSPOSE','NON-UNIT',n,ap,b(1,i),1)

              end do
           else
              ! solve a*x = b where a = l * l**h.
              do i = 1,nrhs
                 ! solve l*y = b, overwriting b with x.
                 call la_${ri}$tpsv('LOWER','NO TRANSPOSE','NON-UNIT',n,ap,b(1,i),1)

                 ! solve l**h *x = y, overwriting b with x.
                 call la_${ri}$tpsv('LOWER','CONJUGATE TRANSPOSE','NON-UNIT',n,ap,b(1,i), &
                           1)
              end do
           end if
           return
     end subroutine la_${ri}$pptrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PSTF2: computes the Cholesky factorization with complete
     !> pivoting of a complex Hermitian positive semidefinite matrix A.
     !> The factorization has the form
     !> P**T * A * P = U**H * U ,  if UPLO = 'U',
     !> P**T * A * P = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular, and
     !> P is stored as vector PIV.
     !> This algorithm does not attempt to check that A is positive
     !> semidefinite. This version of the algorithm calls level 2 BLAS.

     pure subroutine la_${ri}$pstf2(uplo,n,a,lda,piv,rank,tol,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           real(${rk}$),intent(in) :: tol
           integer(ilp),intent(out) :: info,rank
           integer(ilp),intent(in) :: lda,n
           character,intent(in) :: uplo
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: work(2*n)
           integer(ilp),intent(out) :: piv(n)
        ! =====================================================================

           ! Local Scalars
           complex(${rk}$) :: ${ri}$temp
           real(${rk}$) :: ajj,${ci}$stop,${ci}$temp
           integer(ilp) :: i,itemp,j,pvt
           logical(lk) :: upper
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: conjg,max,real,sqrt
#:else
           intrinsic :: real,conjg,max,sqrt
#:endif
           ! Executable Statements
           ! test the input parameters
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PSTF2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! initialize piv
           do i = 1,n
              piv(i) = i
           end do
           ! compute stopping value
           do i = 1,n
              work(i) = real(a(i,i),KIND=${rk}$)
           end do
           pvt = maxloc(work(1:n),1)
           ajj = real(a(pvt,pvt),KIND=${rk}$)
           if (ajj <= zero .or. la_${ci}$isnan(ajj)) then
              rank = 0
              info = 1
              go to 200
           end if
           ! compute stopping value if not supplied
           if (tol < zero) then
              ${ci}$stop = n*la_${ci}$lamch('EPSILON')*ajj
           else
              ${ci}$stop = tol
           end if
           ! set first chalf of work to zero, holds dot products
           do i = 1,n
              work(i) = 0
           end do
           if (upper) then
#:if rk == "sp"
              ! compute the cholesky factorization p**t * a * p = u**h * u
#:else
              ! compute the cholesky factorization p**t * a * p = u**h* u
#:endif
              loop_150: do j = 1,n
              ! find pivot, test for exit, else swap rows and columns
              ! update dot products, compute possible pivots which are
              ! stored in the second chalf of work
                 do i = j,n
                    if (j > 1) then
                       work(i) = work(i) + real(conjg(a(j - 1,i))*a(j - 1,i),KIND=${rk}$)

                    end if
                    work(n + i) = real(a(i,i),KIND=${rk}$) - work(i)
                 end do
                 if (j > 1) then
                    itemp = maxloc(work((n + j):(2*n)),1)
                    pvt = itemp + j - 1
                    ajj = work(n + pvt)
                    if (ajj <= ${ci}$stop .or. la_${ci}$isnan(ajj)) then
                       a(j,j) = ajj
                       go to 190
                    end if
                 end if
                 if (j /= pvt) then
                    ! pivot ok, so can now swap pivot rows and columns
                    a(pvt,pvt) = a(j,j)
                    call la_${ri}$swap(j - 1,a(1,j),1,a(1,pvt),1)
                    if (pvt < n) call la_${ri}$swap(n - pvt,a(j,pvt + 1),lda,a(pvt,pvt + 1),lda)

                    do i = j + 1,pvt - 1
                       ${ri}$temp = conjg(a(j,i))
                       a(j,i) = conjg(a(i,pvt))
                       a(i,pvt) = ${ri}$temp
                    end do
                    a(j,pvt) = conjg(a(j,pvt))
                    ! swap dot products and piv
                    ${ci}$temp = work(j)
                    work(j) = work(pvt)
                    work(pvt) = ${ci}$temp
                    itemp = piv(pvt)
                    piv(pvt) = piv(j)
                    piv(j) = itemp
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of row j
                 if (j < n) then
                    call la_${ri}$lacgv(j - 1,a(1,j),1)
                    call la_${ri}$gemv('TRANS',j - 1,n - j,-cone,a(1,j + 1),lda,a(1,j),1, &
                              cone,a(j,j + 1),lda)
                    call la_${ri}$lacgv(j - 1,a(1,j),1)
                    call la_${ri}$${ci}$scal(n - j,one/ajj,a(j,j + 1),lda)
                 end if
              end do loop_150
           else
              ! compute the cholesky factorization p**t * a * p = l * l**h
              loop_180: do j = 1,n
              ! find pivot, test for exit, else swap rows and columns
              ! update dot products, compute possible pivots which are
              ! stored in the second chalf of work
                 do i = j,n
                    if (j > 1) then
                       work(i) = work(i) + real(conjg(a(i,j - 1))*a(i,j - 1),KIND=${rk}$)

                    end if
                    work(n + i) = real(a(i,i),KIND=${rk}$) - work(i)
                 end do
                 if (j > 1) then
                    itemp = maxloc(work((n + j):(2*n)),1)
                    pvt = itemp + j - 1
                    ajj = work(n + pvt)
                    if (ajj <= ${ci}$stop .or. la_${ci}$isnan(ajj)) then
                       a(j,j) = ajj
                       go to 190
                    end if
                 end if
                 if (j /= pvt) then
                    ! pivot ok, so can now swap pivot rows and columns
                    a(pvt,pvt) = a(j,j)
                    call la_${ri}$swap(j - 1,a(j,1),lda,a(pvt,1),lda)
                    if (pvt < n) call la_${ri}$swap(n - pvt,a(pvt + 1,j),1,a(pvt + 1,pvt),1)

                    do i = j + 1,pvt - 1
                       ${ri}$temp = conjg(a(i,j))
                       a(i,j) = conjg(a(pvt,i))
                       a(pvt,i) = ${ri}$temp
                    end do
                    a(pvt,j) = conjg(a(pvt,j))
                    ! swap dot products and piv
                    ${ci}$temp = work(j)
                    work(j) = work(pvt)
                    work(pvt) = ${ci}$temp
                    itemp = piv(pvt)
                    piv(pvt) = piv(j)
                    piv(j) = itemp
                 end if
                 ajj = sqrt(ajj)
                 a(j,j) = ajj
                 ! compute elements j+1:n of column j
                 if (j < n) then
                    call la_${ri}$lacgv(j - 1,a(j,1),lda)
                    call la_${ri}$gemv('NO TRANS',n - j,j - 1,-cone,a(j + 1,1),lda,a(j,1), &
                              lda,cone,a(j + 1,j),1)
                    call la_${ri}$lacgv(j - 1,a(j,1),lda)
                    call la_${ri}$${ci}$scal(n - j,one/ajj,a(j + 1,j),1)
                 end if
              end do loop_180
           end if
           ! ran to completion, a has full rank
           rank = n
           go to 200
           190 continue
           ! rank is number of steps completed.  set info = 1 to signal
           ! that the factorization cannot be used to solve a system.
           rank = j - 1
           info = 1
           200 continue
           return
     end subroutine la_${ri}$pstf2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PSTRF: computes the Cholesky factorization with complete
     !> pivoting of a complex Hermitian positive semidefinite matrix A.
     !> The factorization has the form
     !> P**T * A * P = U**H * U ,  if UPLO = 'U',
     !> P**T * A * P = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular, and
     !> P is stored as vector PIV.
     !> This algorithm does not attempt to check that A is positive
     !> semidefinite. This version of the algorithm calls level 3 BLAS.

     pure subroutine la_${ri}$pstrf(uplo,n,a,lda,piv,rank,tol,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           real(${rk}$),intent(in) :: tol
           integer(ilp),intent(out) :: info,rank
           integer(ilp),intent(in) :: lda,n
           character,intent(in) :: uplo
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: work(2*n)
           integer(ilp),intent(out) :: piv(n)
        ! =====================================================================

           ! Local Scalars
           complex(${rk}$) :: ${ri}$temp
           real(${rk}$) :: ajj,${ci}$stop,${ci}$temp
           integer(ilp) :: i,itemp,j,jb,k,nb,pvt
           logical(lk) :: upper
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: conjg,max,min,real,sqrt,maxloc
#:else
           intrinsic :: real,conjg,max,min,sqrt,maxloc
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PSTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! get block size
           nb = la_ilaenv(1,'${ri.upper()}$POTRF',uplo,n,-1,-1,-1)
           if (nb <= 1 .or. nb >= n) then
              ! use unblocked code
              call la_${ri}$pstf2(uplo,n,a(1,1),lda,piv,rank,tol,work,info)
              go to 230
           else
           ! initialize piv
              do i = 1,n
                 piv(i) = i
              end do
           ! compute stopping value
              do i = 1,n
                 work(i) = real(a(i,i),KIND=${rk}$)
              end do
              pvt = maxloc(work(1:n),1)
              ajj = real(a(pvt,pvt),KIND=${rk}$)
              if (ajj <= zero .or. la_${ci}$isnan(ajj)) then
                 rank = 0
                 info = 1
                 go to 230
              end if
           ! compute stopping value if not supplied
              if (tol < zero) then
                 ${ci}$stop = n*la_${ci}$lamch('EPSILON')*ajj
              else
                 ${ci}$stop = tol
              end if
              if (upper) then
                 ! compute the cholesky factorization p**t * a * p = u**h * u
                 loop_160: do k = 1,n,nb
                    ! account for last block not being nb wide
                    jb = min(nb,n - k + 1)
                    ! set relevant part of first chalf of work to zero,
                    ! holds dot products
                    do i = k,n
                       work(i) = 0
                    end do
                    loop_150: do j = k,k + jb - 1
                    ! find pivot, test for exit, else swap rows and columns
                    ! update dot products, compute possible pivots which are
                    ! stored in the second chalf of work
                       do i = j,n
                          if (j > k) then
                             work(i) = work(i) + real(conjg(a(j - 1,i))*a(j - 1,i), &
                                       KIND=${rk}$)
                          end if
                          work(n + i) = real(a(i,i),KIND=${rk}$) - work(i)
                       end do
                       if (j > 1) then
                          itemp = maxloc(work((n + j):(2*n)),1)
                          pvt = itemp + j - 1
                          ajj = work(n + pvt)
                          if (ajj <= ${ci}$stop .or. la_${ci}$isnan(ajj)) then
                             a(j,j) = ajj
                             go to 220
                          end if
                       end if
                       if (j /= pvt) then
                          ! pivot ok, so can now swap pivot rows and columns
                          a(pvt,pvt) = a(j,j)
                          call la_${ri}$swap(j - 1,a(1,j),1,a(1,pvt),1)
                          if (pvt < n) call la_${ri}$swap(n - pvt,a(j,pvt + 1),lda,a(pvt,pvt + 1), &
                                     lda)
                          do i = j + 1,pvt - 1
                             ${ri}$temp = conjg(a(j,i))
                             a(j,i) = conjg(a(i,pvt))
                             a(i,pvt) = ${ri}$temp
                          end do
                          a(j,pvt) = conjg(a(j,pvt))
                          ! swap dot products and piv
                          ${ci}$temp = work(j)
                          work(j) = work(pvt)
                          work(pvt) = ${ci}$temp
                          itemp = piv(pvt)
                          piv(pvt) = piv(j)
                          piv(j) = itemp
                       end if
                       ajj = sqrt(ajj)
                       a(j,j) = ajj
                       ! compute elements j+1:n of row j.
                       if (j < n) then
                          call la_${ri}$lacgv(j - 1,a(1,j),1)
                          call la_${ri}$gemv('TRANS',j - k,n - j,-cone,a(k,j + 1),lda,a(k,j), &
                                     1,cone,a(j,j + 1),lda)
                          call la_${ri}$lacgv(j - 1,a(1,j),1)
                          call la_${ri}$${ci}$scal(n - j,one/ajj,a(j,j + 1),lda)
                       end if
                    end do loop_150
                    ! update trailing matrix, j already incremented
                    if (k + jb <= n) then
                       call la_${ri}$herk('UPPER','CONJ TRANS',n - j + 1,jb,-one,a(k,j),lda, &
                                 one,a(j,j),lda)
                    end if
                 end do loop_160
              else
              ! compute the cholesky factorization p**t * a * p = l * l**h
                 loop_210: do k = 1,n,nb
                    ! account for last block not being nb wide
                    jb = min(nb,n - k + 1)
                    ! set relevant part of first chalf of work to zero,
                    ! holds dot products
                    do i = k,n
                       work(i) = 0
                    end do
                    loop_200: do j = k,k + jb - 1
                    ! find pivot, test for exit, else swap rows and columns
                    ! update dot products, compute possible pivots which are
                    ! stored in the second chalf of work
                       do i = j,n
                          if (j > k) then
                             work(i) = work(i) + real(conjg(a(i,j - 1))*a(i,j - 1), &
                                       KIND=${rk}$)
                          end if
                          work(n + i) = real(a(i,i),KIND=${rk}$) - work(i)
                       end do
                       if (j > 1) then
                          itemp = maxloc(work((n + j):(2*n)),1)
                          pvt = itemp + j - 1
                          ajj = work(n + pvt)
                          if (ajj <= ${ci}$stop .or. la_${ci}$isnan(ajj)) then
                             a(j,j) = ajj
                             go to 220
                          end if
                       end if
                       if (j /= pvt) then
                          ! pivot ok, so can now swap pivot rows and columns
                          a(pvt,pvt) = a(j,j)
                          call la_${ri}$swap(j - 1,a(j,1),lda,a(pvt,1),lda)
                          if (pvt < n) call la_${ri}$swap(n - pvt,a(pvt + 1,j),1,a(pvt + 1,pvt), &
                                    1)
                          do i = j + 1,pvt - 1
                             ${ri}$temp = conjg(a(i,j))
                             a(i,j) = conjg(a(pvt,i))
                             a(pvt,i) = ${ri}$temp
                          end do
                          a(pvt,j) = conjg(a(pvt,j))
                          ! swap dot products and piv
                          ${ci}$temp = work(j)
                          work(j) = work(pvt)
                          work(pvt) = ${ci}$temp
                          itemp = piv(pvt)
                          piv(pvt) = piv(j)
                          piv(j) = itemp
                       end if
                       ajj = sqrt(ajj)
                       a(j,j) = ajj
                       ! compute elements j+1:n of column j.
                       if (j < n) then
                          call la_${ri}$lacgv(j - 1,a(j,1),lda)
                          call la_${ri}$gemv('NO TRANS',n - j,j - k,-cone,a(j + 1,k),lda,a(j, &
                                    k),lda,cone,a(j + 1,j),1)
                          call la_${ri}$lacgv(j - 1,a(j,1),lda)
                          call la_${ri}$${ci}$scal(n - j,one/ajj,a(j + 1,j),1)
                       end if
                    end do loop_200
                    ! update trailing matrix, j already incremented
                    if (k + jb <= n) then
                       call la_${ri}$herk('LOWER','NO TRANS',n - j + 1,jb,-one,a(j,k),lda, &
                                 one,a(j,j),lda)
                    end if
                 end do loop_210
              end if
           end if
           ! ran to completion, a has full rank
           rank = n
           go to 230
           220 continue
           ! rank is the number of steps completed.  set info = 1 to signal
           ! that the factorization cannot be used to solve a system.
           rank = j - 1
           info = 1
           230 continue
           return
     end subroutine la_${ri}$pstrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTCON: computes the reciprocal of the condition number (in the
     !> 1-norm) of a complex Hermitian positive definite tridiagonal matrix
     !> using the factorization A = L*D*L**H or A = U**H*D*U computed by
     !> ${ri.upper()}$PTTRF.
     !> Norm(inv(A)) is computed by a direct method, and the reciprocal of
     !> the condition number is computed as
     !> RCOND = 1 / (ANORM * norm(inv(A))).

     pure subroutine la_${ri}$ptcon(n,d,e,anorm,rcond,rwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           real(${rk}$),intent(in) :: anorm
           real(${rk}$),intent(out) :: rcond
           ! Array Arguments
           real(${rk}$),intent(in) :: d(*)
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(in) :: e(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,ix
           real(${rk}$) :: ainvnm
           ! Intrinsic Functions
           intrinsic :: abs
           ! Executable Statements
           ! test the input arguments.
           info = 0
           if (n < 0) then
              info = -1
           else if (anorm < zero) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PTCON',-info)
              return
           end if
           ! quick return if possible
           rcond = zero
           if (n == 0) then
              rcond = one
              return
           else if (anorm == zero) then
              return
           end if
           ! check that d(1:n) is positive.
           do i = 1,n
              if (d(i) <= zero) return
           end do
           ! solve m(a) * x = e, where m(a) = (m(i,j)) is given by
              ! m(i,j) =  abs(a(i,j)), i = j,
              ! m(i,j) = -abs(a(i,j)), i .ne. j,
           ! and e = [ 1, 1, ..., 1 ]**t.  note m(a) = m(l)*d*m(l)**h.
           ! solve m(l) * x = e.
           rwork(1) = one
           do i = 2,n
              rwork(i) = one + rwork(i - 1)*abs(e(i - 1))
           end do
           ! solve d * m(l)**h * x = b.
           rwork(n) = rwork(n)/d(n)
           do i = n - 1,1,-1
              rwork(i) = rwork(i)/d(i) + rwork(i + 1)*abs(e(i))
           end do
           ! compute ainvnm = max(x(i)), 1<=i<=n.
           ix = la_i${ci}$amax(n,rwork,1)
           ainvnm = abs(rwork(ix))
           ! compute the reciprocal condition number.
           if (ainvnm /= zero) rcond = (one/ainvnm)/anorm
           return
     end subroutine la_${ri}$ptcon
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTTRF: computes the L*D*L**H factorization of a complex Hermitian
     !> positive definite tridiagonal matrix A.  The factorization may also
     !> be regarded as having the form A = U**H *D*U.

     pure subroutine la_${ri}$pttrf(n,d,e,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           real(${rk}$),intent(inout) :: d(*)
           complex(${rk}$),intent(inout) :: e(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,i4
           real(${rk}$) :: eii,eir,f,g
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: aimag,cmplx,mod,real
#:else
           intrinsic :: real,cmplx,aimag,mod
#:endif
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (n < 0) then
              info = -1
              call la_xerbla('${ri.upper()}$PTTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! compute the l*d*l**h (or u**h *d*u) factorization of a.
           i4 = mod(n - 1,4)
           do i = 1,i4
              if (d(i) <= zero) then
                 info = i
#:if rk == "sp"
                 go to 20
#:else
                 go to 30
#:endif
              end if
              eir = real(e(i),KIND=${rk}$)
              eii = aimag(e(i))
              f = eir/d(i)
              g = eii/d(i)
              e(i) = cmplx(f,g,KIND=${rk}$)
              d(i + 1) = d(i + 1) - f*eir - g*eii
           end do
#:if rk == "sp"
           loop_110: do i = i4 + 1,n - 4,4
#:else
           loop_20: do i = i4 + 1,n - 4,4
#:endif
              ! drop out of the loop if d(i) <= 0: the matrix is not positive
              ! definite.
              if (d(i) <= zero) then
                 info = i
#:if rk == "sp"
                 go to 20
#:else
                 go to 30
#:endif
              end if
              ! solve for e(i) and d(i+1).
              eir = real(e(i),KIND=${rk}$)
              eii = aimag(e(i))
              f = eir/d(i)
              g = eii/d(i)
              e(i) = cmplx(f,g,KIND=${rk}$)
              d(i + 1) = d(i + 1) - f*eir - g*eii
              if (d(i + 1) <= zero) then
                 info = i + 1
#:if rk == "sp"
                 go to 20
#:else
                 go to 30
#:endif
              end if
              ! solve for e(i+1) and d(i+2).
              eir = real(e(i + 1),KIND=${rk}$)
              eii = aimag(e(i + 1))
              f = eir/d(i + 1)
              g = eii/d(i + 1)
              e(i + 1) = cmplx(f,g,KIND=${rk}$)
              d(i + 2) = d(i + 2) - f*eir - g*eii
              if (d(i + 2) <= zero) then
                 info = i + 2
#:if rk == "sp"
                 go to 20
#:else
                 go to 30
#:endif
              end if
              ! solve for e(i+2) and d(i+3).
              eir = real(e(i + 2),KIND=${rk}$)
              eii = aimag(e(i + 2))
              f = eir/d(i + 2)
              g = eii/d(i + 2)
              e(i + 2) = cmplx(f,g,KIND=${rk}$)
              d(i + 3) = d(i + 3) - f*eir - g*eii
              if (d(i + 3) <= zero) then
                 info = i + 3
#:if rk == "sp"
                 go to 20
#:else
                 go to 30
#:endif
              end if
              ! solve for e(i+3) and d(i+4).
              eir = real(e(i + 3),KIND=${rk}$)
              eii = aimag(e(i + 3))
              f = eir/d(i + 3)
              g = eii/d(i + 3)
              e(i + 3) = cmplx(f,g,KIND=${rk}$)
              d(i + 4) = d(i + 4) - f*eir - g*eii
#:if rk == "sp"
           end do loop_110
#:else
           end do loop_20
#:endif
           ! check d(n) for positive definiteness.
           if (d(n) <= zero) info = n
#:if rk == "sp"
           20 continue
#:else
           30 continue
#:endif
           return
     end subroutine la_${ri}$pttrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTTS2: solves a tridiagonal system of the form
     !> A * X = B
#:if rk == "sp"
     !> using the factorization A = U**H*D*U or A = L*D*L**H computed by ${ri.upper()}$PTTRF.
#:else
     !> using the factorization A = U**H *D*U or A = L*D*L**H computed by ${ri.upper()}$PTTRF.
#:endif
     !> D is a diagonal matrix specified in the vector D, U (or L) is a unit
     !> bidiagonal matrix whose superdiagonal (subdiagonal) is specified in
     !> the vector E, and X and B are N by NRHS matrices.

     pure subroutine la_${ri}$ptts2(iuplo,n,nrhs,d,e,b,ldb)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: iuplo,ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: d(*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
           complex(${rk}$),intent(in) :: e(*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,j
           ! Intrinsic Functions
           intrinsic :: conjg
           ! Executable Statements
           ! quick return if possible
           if (n <= 1) then
#:if rk == "sp"
              if (n == 1) call la_${ri}$${ci}$scal(nrhs,1./d(1),b,ldb)
#:else
              if (n == 1) call la_${ri}$${ci}$scal(nrhs,1._${rk}$/d(1),b,ldb)
#:endif
              return
           end if
           if (iuplo == 1) then
              ! solve a * x = b using the factorization a = u**h *d*u,
              ! overwriting each right hand side vector with its solution.
              if (nrhs <= 2) then
                 j = 1
#:if rk == "sp"
                 5 continue
#:else
                 10 continue
#:endif
                 ! solve u**h * x = b.
                 do i = 2,n
                    b(i,j) = b(i,j) - b(i - 1,j)*conjg(e(i - 1))
                 end do
                 ! solve d * u * x = b.
                 do i = 1,n
                    b(i,j) = b(i,j)/d(i)
                 end do
                 do i = n - 1,1,-1
                    b(i,j) = b(i,j) - b(i + 1,j)*e(i)
                 end do
                 if (j < nrhs) then
                    j = j + 1
#:if rk == "sp"
                    go to 5
#:else
                    go to 10
#:endif
                 end if
              else
                 do j = 1,nrhs
                    ! solve u**h * x = b.
                    do i = 2,n
                       b(i,j) = b(i,j) - b(i - 1,j)*conjg(e(i - 1))
                    end do
                    ! solve d * u * x = b.
                    b(n,j) = b(n,j)/d(n)
                    do i = n - 1,1,-1
                       b(i,j) = b(i,j)/d(i) - b(i + 1,j)*e(i)
                    end do
                 end do
              end if
           else
              ! solve a * x = b using the factorization a = l*d*l**h,
              ! overwriting each right hand side vector with its solution.
              if (nrhs <= 2) then
                 j = 1
#:if rk == "sp"
                 65 continue
#:else
                 80 continue
#:endif
                 ! solve l * x = b.
                 do i = 2,n
                    b(i,j) = b(i,j) - b(i - 1,j)*e(i - 1)
                 end do
                 ! solve d * l**h * x = b.
                 do i = 1,n
                    b(i,j) = b(i,j)/d(i)
                 end do
                 do i = n - 1,1,-1
                    b(i,j) = b(i,j) - b(i + 1,j)*conjg(e(i))
                 end do
                 if (j < nrhs) then
                    j = j + 1
#:if rk == "sp"
                    go to 65
#:else
                    go to 80
#:endif
                 end if
              else
                 do j = 1,nrhs
                    ! solve l * x = b.
                    do i = 2,n
                       b(i,j) = b(i,j) - b(i - 1,j)*e(i - 1)
                    end do
                    ! solve d * l**h * x = b.
                    b(n,j) = b(n,j)/d(n)
                    do i = n - 1,1,-1
                       b(i,j) = b(i,j)/d(i) - b(i + 1,j)*conjg(e(i))
                    end do
                 end do
              end if
           end if
           return
     end subroutine la_${ri}$ptts2
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is Hermitian positive definite
     !> and banded, and provides error bounds and backward error estimates
     !> for the solution.

     pure subroutine la_${ri}$pbrfs(uplo,n,kd,nrhs,ab,ldab,afb,ldafb,b,ldb,x,ldx,ferr, &
               berr,work,rwork,info)
        use la_constants_${rk}$,only:zero,two,three,cone
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,ldafb,ldb,ldx,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           complex(${rk}$),intent(in) :: ab(ldab,*),afb(ldafb,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,j,k,kase,l,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,min,real
#:else
           intrinsic :: abs,real,aimag,max,min
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (nrhs < 0) then
              info = -4
           else if (ldab < kd + 1) then
              info = -6
           else if (ldafb < kd + 1) then
              info = -8
           else if (ldb < max(1,n)) then
              info = -10
           else if (ldx < max(1,n)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = min(n + 1,2*kd + 2)
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x
              call la_${ri}$copy(n,b(1,j),1,work,1)
              call la_${ri}$hbmv(uplo,n,kd,-cone,ab,ldab,x(1,j),1,cone,work,1)

              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 rwork(i) = cabs1(b(i,j))
              end do
              ! compute abs(a)*abs(x) + abs(b).
              if (upper) then
                 do k = 1,n
                    s = zero
                    xk = cabs1(x(k,j))
                    l = kd + 1 - k
                    do i = max(1,k - kd),k - 1
                       rwork(i) = rwork(i) + cabs1(ab(l + i,k))*xk
                       s = s + cabs1(ab(l + i,k))*cabs1(x(i,j))
                    end do
                    rwork(k) = rwork(k) + abs(real(ab(kd + 1,k),KIND=${rk}$))*xk + s
                 end do
              else
                 do k = 1,n
                    s = zero
                    xk = cabs1(x(k,j))
                    rwork(k) = rwork(k) + abs(real(ab(1,k),KIND=${rk}$))*xk
                    l = 1 - k
                    do i = k + 1,min(n,k + kd)
                       rwork(i) = rwork(i) + cabs1(ab(l + i,k))*xk
                       s = s + cabs1(ab(l + i,k))*cabs1(x(i,j))
                    end do
                    rwork(k) = rwork(k) + s
                 end do
              end if
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$pbtrs(uplo,n,kd,1,afb,ldafb,work,n,info)
                 call la_${ri}$axpy(n,cone,work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(a) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) )))
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(n + 1),work,ferr(j),kase,isave)
              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(a**h).
                    call la_${ri}$pbtrs(uplo,n,kd,1,afb,ldafb,work,n,info)
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                 else if (kase == 2) then
                    ! multiply by inv(a)*diag(w).
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                    call la_${ri}$pbtrs(uplo,n,kd,1,afb,ldafb,work,n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,cabs1(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$pbrfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PBTRF: computes the Cholesky factorization of a complex Hermitian
     !> positive definite band matrix A.
     !> The factorization has the form
     !> A = U**H * U,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.

     pure subroutine la_${ri}$pbtrf(uplo,n,kd,ab,ldab,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: kd,ldab,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ab(ldab,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 32
           integer(ilp),parameter :: ldwork = nbmax + 1

           ! Local Scalars
           integer(ilp) :: i,i2,i3,ib,ii,j,jj,nb
           ! Local Arrays
           complex(${rk}$) :: work(ldwork,nbmax)
           ! Intrinsic Functions
           intrinsic :: min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if ((.not. la_lsame(uplo,'U')) .and. (.not. la_lsame(uplo,'L'))) &
                     then
              info = -1
           else if (n < 0) then
              info = -2
           else if (kd < 0) then
              info = -3
           else if (ldab < kd + 1) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PBTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! determine the block size for this environment
           nb = la_ilaenv(1,'${ri.upper()}$PBTRF',uplo,n,kd,-1,-1)
           ! the block size must not exceed the semi-bandwidth kd, and must not
           ! exceed the limit set by the size of the local array work.
           nb = min(nb,nbmax)
           if (nb <= 1 .or. nb > kd) then
              ! use unblocked code
              call la_${ri}$pbtf2(uplo,n,kd,ab,ldab,info)
           else
              ! use blocked code
              if (la_lsame(uplo,'U')) then
                 ! compute the cholesky factorization of a hermitian band
                 ! matrix, given the upper triangle of the matrix in band
                 ! storage.
                 ! zero the upper triangle of the work array.
                 do j = 1,nb
                    do i = 1,j - 1
                       work(i,j) = zero
                    end do
                 end do
                 ! process the band matrix one diagonal block at a time.
                 loop_70: do i = 1,n,nb
                    ib = min(nb,n - i + 1)
                    ! factorize the diagonal block
                    call la_${ri}$potf2(uplo,ib,ab(kd + 1,i),ldab - 1,ii)
                    if (ii /= 0) then
                       info = i + ii - 1
                       go to 150
                    end if
                    if (i + ib <= n) then
                       ! update the relevant part of the trailing submatrix.
                       ! if a11 denotes the diagonal block which has just been
                       ! factorized, then we need to update the remaining
                       ! blocks in the diagram:
                          ! a11   a12   a13
                                ! a22   a23
                                      ! a33
                       ! the numbers of rows and columns in the partitioning
                       ! are ib, i2, i3 respectively. the blocks a12, a22 and
                       ! a23 are empty if ib = kd. the upper triangle of a13
                       ! lies outside the band.
                       i2 = min(kd - ib,n - i - ib + 1)
                       i3 = min(ib,n - i - kd + 1)
                       if (i2 > 0) then
                          ! update a12
                          call la_${ri}$trsm('LEFT','UPPER','CONJUGATE TRANSPOSE','NON-UNIT', &
                                    ib,i2,cone,ab(kd + 1,i),ldab - 1,ab(kd + 1 - ib,i + ib),ldab - 1)
                          ! update a22
                          call la_${ri}$herk('UPPER','CONJUGATE TRANSPOSE',i2,ib,-one,ab(kd + &
                                    1 - ib,i + ib),ldab - 1,one,ab(kd + 1,i + ib),ldab - 1)
                       end if
                       if (i3 > 0) then
                          ! copy the lower triangle of a13 into the work array.
                          do jj = 1,i3
                             do ii = jj,ib
                                work(ii,jj) = ab(ii - jj + 1,jj + i + kd - 1)
                             end do
                          end do
                          ! update a13 (in the work array).
                          call la_${ri}$trsm('LEFT','UPPER','CONJUGATE TRANSPOSE','NON-UNIT', &
                                    ib,i3,cone,ab(kd + 1,i),ldab - 1,work,ldwork)
                          ! update a23
                          if (i2 > 0) call la_${ri}$gemm('CONJUGATE TRANSPOSE','NO TRANSPOSE',i2, &
                          i3,ib,-cone,ab(kd + 1 - ib,i + ib),ldab - 1,work,ldwork,cone,ab(1 + ib, &
                                    i + kd),ldab - 1)
                          ! update a33
                          call la_${ri}$herk('UPPER','CONJUGATE TRANSPOSE',i3,ib,-one,work, &
                                    ldwork,one,ab(kd + 1,i + kd),ldab - 1)
                          ! copy the lower triangle of a13 back into place.
                          do jj = 1,i3
                             do ii = jj,ib
                                ab(ii - jj + 1,jj + i + kd - 1) = work(ii,jj)
                             end do
                          end do
                       end if
                    end if
                 end do loop_70
              else
                 ! compute the cholesky factorization of a hermitian band
                 ! matrix, given the lower triangle of the matrix in band
                 ! storage.
                 ! zero the lower triangle of the work array.
                 do j = 1,nb
                    do i = j + 1,nb
                       work(i,j) = zero
                    end do
                 end do
                 ! process the band matrix one diagonal block at a time.
                 loop_140: do i = 1,n,nb
                    ib = min(nb,n - i + 1)
                    ! factorize the diagonal block
                    call la_${ri}$potf2(uplo,ib,ab(1,i),ldab - 1,ii)
                    if (ii /= 0) then
                       info = i + ii - 1
                       go to 150
                    end if
                    if (i + ib <= n) then
                       ! update the relevant part of the trailing submatrix.
                       ! if a11 denotes the diagonal block which has just been
                       ! factorized, then we need to update the remaining
                       ! blocks in the diagram:
                          ! a11
                          ! a21   a22
                          ! a31   a32   a33
                       ! the numbers of rows and columns in the partitioning
                       ! are ib, i2, i3 respectively. the blocks a21, a22 and
                       ! a32 are empty if ib = kd. the lower triangle of a31
                       ! lies outside the band.
                       i2 = min(kd - ib,n - i - ib + 1)
                       i3 = min(ib,n - i - kd + 1)
                       if (i2 > 0) then
                          ! update a21
                          call la_${ri}$trsm('RIGHT','LOWER','CONJUGATE TRANSPOSE','NON-UNIT', &
                                    i2,ib,cone,ab(1,i),ldab - 1,ab(1 + ib,i),ldab - 1)
                          ! update a22
                          call la_${ri}$herk('LOWER','NO TRANSPOSE',i2,ib,-one,ab(1 + ib,i), &
                                    ldab - 1,one,ab(1,i + ib),ldab - 1)
                       end if
                       if (i3 > 0) then
                          ! copy the upper triangle of a31 into the work array.
                          do jj = 1,ib
                             do ii = 1,min(jj,i3)
                                work(ii,jj) = ab(kd + 1 - jj + ii,jj + i - 1)
                             end do
                          end do
                          ! update a31 (in the work array).
                          call la_${ri}$trsm('RIGHT','LOWER','CONJUGATE TRANSPOSE','NON-UNIT', &
                                    i3,ib,cone,ab(1,i),ldab - 1,work,ldwork)
                          ! update a32
                          if (i2 > 0) call la_${ri}$gemm('NO TRANSPOSE','CONJUGATE TRANSPOSE',i3, &
                          i2,ib,-cone,work,ldwork,ab(1 + ib,i),ldab - 1,cone,ab(1 + kd - ib,i + &
                                    ib),ldab - 1)
                          ! update a33
                          call la_${ri}$herk('LOWER','NO TRANSPOSE',i3,ib,-one,work,ldwork, &
                                    one,ab(1,i + kd),ldab - 1)
                          ! copy the upper triangle of a31 back into place.
                          do jj = 1,ib
                             do ii = 1,min(jj,i3)
                                ab(kd + 1 - jj + ii,jj + i - 1) = work(ii,jj)
                             end do
                          end do
                       end if
                    end if
                 end do loop_140
              end if
           end if
           return
           150 continue
           return
     end subroutine la_${ri}$pbtrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PFTRS: solves a system of linear equations A*X = B with a Hermitian
     !> positive definite matrix A using the Cholesky factorization
     !> A = U**H*U or A = L*L**H computed by ${ri.upper()}$PFTRF.

     pure subroutine la_${ri}$pftrs(transr,uplo,n,nrhs,a,b,ldb,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: transr,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           complex(${rk}$),intent(in) :: a(0:*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,normaltransr
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           normaltransr = la_lsame(transr,'N')
           lower = la_lsame(uplo,'L')
           if (.not. normaltransr .and. .not. la_lsame(transr,'C')) then
              info = -1
           else if (.not. lower .and. .not. la_lsame(uplo,'U')) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (nrhs < 0) then
              info = -4
           else if (ldb < max(1,n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PFTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           ! start execution: there are two triangular solves
           if (lower) then
              call la_${ri}$tfsm(transr,'L',uplo,'N','N',n,nrhs,cone,a,b,ldb)
              call la_${ri}$tfsm(transr,'L',uplo,'C','N',n,nrhs,cone,a,b,ldb)
           else
              call la_${ri}$tfsm(transr,'L',uplo,'C','N',n,nrhs,cone,a,b,ldb)
              call la_${ri}$tfsm(transr,'L',uplo,'N','N',n,nrhs,cone,a,b,ldb)
           end if
           return
     end subroutine la_${ri}$pftrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PORFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is Hermitian positive definite,
     !> and provides error bounds and backward error estimates for the
     !> solution.

     pure subroutine la_${ri}$porfs(uplo,n,nrhs,a,lda,af,ldaf,b,ldb,x,ldx,ferr,berr, &
               work,rwork,info)
        use la_constants_${rk}$,only:zero,two,three,cone
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldaf,ldb,ldx,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           complex(${rk}$),intent(in) :: a(lda,*),af(ldaf,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! ====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,j,k,kase,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,real
#:else
           intrinsic :: abs,real,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldaf < max(1,n)) then
              info = -7
           else if (ldb < max(1,n)) then
              info = -9
           else if (ldx < max(1,n)) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PORFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = n + 1
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x
              call la_${ri}$copy(n,b(1,j),1,work,1)
              call la_${ri}$hemv(uplo,n,-cone,a,lda,x(1,j),1,cone,work,1)
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 rwork(i) = cabs1(b(i,j))
              end do
              ! compute abs(a)*abs(x) + abs(b).
              if (upper) then
                 do k = 1,n
                    s = zero
                    xk = cabs1(x(k,j))
                    do i = 1,k - 1
                       rwork(i) = rwork(i) + cabs1(a(i,k))*xk
                       s = s + cabs1(a(i,k))*cabs1(x(i,j))
                    end do
                    rwork(k) = rwork(k) + abs(real(a(k,k),KIND=${rk}$))*xk + s
                 end do
              else
                 do k = 1,n
                    s = zero
                    xk = cabs1(x(k,j))
                    rwork(k) = rwork(k) + abs(real(a(k,k),KIND=${rk}$))*xk
                    do i = k + 1,n
                       rwork(i) = rwork(i) + cabs1(a(i,k))*xk
                       s = s + cabs1(a(i,k))*cabs1(x(i,j))
                    end do
                    rwork(k) = rwork(k) + s
                 end do
              end if
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$potrs(uplo,n,1,af,ldaf,work,n,info)
                 call la_${ri}$axpy(n,cone,work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(a) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) )))
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(n + 1),work,ferr(j),kase,isave)
              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(a**h).
                    call la_${ri}$potrs(uplo,n,1,af,ldaf,work,n,info)
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                 else if (kase == 2) then
                    ! multiply by inv(a)*diag(w).
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                    call la_${ri}$potrs(uplo,n,1,af,ldaf,work,n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,cabs1(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$porfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRF: computes the Cholesky factorization of a complex Hermitian
     !> positive definite matrix A.
     !> The factorization has the form
     !> A = U**H * U,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the block version of the algorithm, calling Level 3 BLAS.

     pure subroutine la_${ri}$potrf(uplo,n,a,lda,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! determine the block size for this environment.
           nb = la_ilaenv(1,'${ri.upper()}$POTRF',uplo,n,-1,-1,-1)
           if (nb <= 1 .or. nb >= n) then
              ! use unblocked code.
              call la_${ri}$potrf2(uplo,n,a,lda,info)
           else
              ! use blocked code.
              if (upper) then
                 ! compute the cholesky factorization a = u**h *u.
                 do j = 1,n,nb
                    ! update and factorize the current diagonal block and test
                    ! for non-positive-definiteness.
                    jb = min(nb,n - j + 1)
                    call la_${ri}$herk('UPPER','CONJUGATE TRANSPOSE',jb,j - 1,-one,a(1,j), &
                              lda,one,a(j,j),lda)
                    call la_${ri}$potrf2('UPPER',jb,a(j,j),lda,info)
                    if (info /= 0) go to 30
                    if (j + jb <= n) then
                       ! compute the current block row.
                       call la_${ri}$gemm('CONJUGATE TRANSPOSE','NO TRANSPOSE',jb,n - j - jb + 1,j - 1, &
                                  -cone,a(1,j),lda,a(1,j + jb),lda,cone,a(j,j + jb),lda)
                       call la_${ri}$trsm('LEFT','UPPER','CONJUGATE TRANSPOSE','NON-UNIT',jb, &
                                 n - j - jb + 1,cone,a(j,j),lda,a(j,j + jb),lda)
                    end if
                 end do
              else
                 ! compute the cholesky factorization a = l*l**h.
                 do j = 1,n,nb
                    ! update and factorize the current diagonal block and test
                    ! for non-positive-definiteness.
                    jb = min(nb,n - j + 1)
                    call la_${ri}$herk('LOWER','NO TRANSPOSE',jb,j - 1,-one,a(j,1),lda,one, &
                               a(j,j),lda)
                    call la_${ri}$potrf2('LOWER',jb,a(j,j),lda,info)
                    if (info /= 0) go to 30
                    if (j + jb <= n) then
                       ! compute the current block column.
                       call la_${ri}$gemm('NO TRANSPOSE','CONJUGATE TRANSPOSE',n - j - jb + 1,jb,j - 1, &
                                  -cone,a(j + jb,1),lda,a(j,1),lda,cone,a(j + jb,j),lda)
                       call la_${ri}$trsm('RIGHT','LOWER','CONJUGATE TRANSPOSE','NON-UNIT',n - j - &
                                 jb + 1,jb,cone,a(j,j),lda,a(j + jb,j),lda)
                    end if
                 end do
              end if
           end if
           go to 40
           30 continue
           info = info + j - 1
           40 continue
           return
     end subroutine la_${ri}$potrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$POTRI: computes the inverse of a complex Hermitian positive definite
     !> matrix A using the Cholesky factorization A = U**H*U or A = L*L**H
     !> computed by ${ri.upper()}$POTRF.

     pure subroutine la_${ri}$potri(uplo,n,a,lda,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
        ! =====================================================================
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (.not. la_lsame(uplo,'U') .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,n)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$POTRI',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! invert the triangular cholesky factor u or l.
           call la_${ri}$trtri(uplo,'NON-UNIT',n,a,lda,info)
           if (info > 0) return
           ! form inv(u) * inv(u)**h or inv(l)**h * inv(l).
           call la_${ri}$lauum(uplo,n,a,lda,info)
           return
     end subroutine la_${ri}$potri
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is Hermitian positive definite
     !> and packed, and provides error bounds and backward error estimates
     !> for the solution.

     pure subroutine la_${ri}$pprfs(uplo,n,nrhs,ap,afp,b,ldb,x,ldx,ferr,berr,work, &
               rwork,info)
        use la_constants_${rk}$,only:zero,two,three,cone
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,ldx,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           complex(${rk}$),intent(in) :: afp(*),ap(*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! ====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,ik,j,k,kase,kk,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin,xk
           complex(${rk}$) :: zdum
           ! Local Arrays
           integer(ilp) :: isave(3)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,max,real
#:else
           intrinsic :: abs,real,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -7
           else if (ldx < max(1,n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = n + 1
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_140: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x
              call la_${ri}$copy(n,b(1,j),1,work,1)
              call la_${ri}$hpmv(uplo,n,-cone,ap,x(1,j),1,cone,work,1)
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              do i = 1,n
                 rwork(i) = cabs1(b(i,j))
              end do
              ! compute abs(a)*abs(x) + abs(b).
              kk = 1
              if (upper) then
                 do k = 1,n
                    s = zero
                    xk = cabs1(x(k,j))
                    ik = kk
                    do i = 1,k - 1
                       rwork(i) = rwork(i) + cabs1(ap(ik))*xk
                       s = s + cabs1(ap(ik))*cabs1(x(i,j))
                       ik = ik + 1
                    end do
                    rwork(k) = rwork(k) + abs(real(ap(kk + k - 1),KIND=${rk}$))*xk + s
                    kk = kk + k
                 end do
              else
                 do k = 1,n
                    s = zero
                    xk = cabs1(x(k,j))
                    rwork(k) = rwork(k) + abs(real(ap(kk),KIND=${rk}$))*xk
                    ik = kk + 1
                    do i = k + 1,n
                       rwork(i) = rwork(i) + cabs1(ap(ik))*xk
                       s = s + cabs1(ap(ik))*cabs1(x(i,j))
                       ik = ik + 1
                    end do
                    rwork(k) = rwork(k) + s
                    kk = kk + (n - k + 1)
                 end do
              end if
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$pptrs(uplo,n,1,afp,work,n,info)
                 call la_${ri}$axpy(n,cone,work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              ! use la_${ri}$lacn2 to estimate the infinity-norm of the matrix
                 ! inv(a) * diag(w),
              ! where w = abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) )))
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              kase = 0
              100 continue
              call la_${ri}$lacn2(n,work(n + 1),work,ferr(j),kase,isave)
              if (kase /= 0) then
                 if (kase == 1) then
                    ! multiply by diag(w)*inv(a**h).
                    call la_${ri}$pptrs(uplo,n,1,afp,work,n,info)
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                 else if (kase == 2) then
                    ! multiply by inv(a)*diag(w).
                    do i = 1,n
                       work(i) = rwork(i)*work(i)
                    end do
                    call la_${ri}$pptrs(uplo,n,1,afp,work,n,info)
                 end if
                 go to 100
              end if
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,cabs1(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_140
           return
     end subroutine la_${ri}$pprfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PPTRI: computes the inverse of a complex Hermitian positive definite
     !> matrix A using the Cholesky factorization A = U**H*U or A = L*L**H
     !> computed by ${ri.upper()}$PPTRF.

     pure subroutine la_${ri}$pptri(uplo,n,ap,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: ap(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: j,jc,jj,jjn
           real(${rk}$) :: ajj
           ! Intrinsic Functions
           intrinsic :: real
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PPTRI',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! invert the triangular cholesky factor u or l.
           call la_${ri}$tptri(uplo,'NON-UNIT',n,ap,info)
           if (info > 0) return
           if (upper) then
              ! compute the product inv(u) * inv(u)**h.
              jj = 0
              do j = 1,n
                 jc = jj + 1
                 jj = jj + j
                 if (j > 1) call la_${ri}$hpr('UPPER',j - 1,one,ap(jc),1,ap)
                 ajj = real(ap(jj),KIND=${rk}$)
                 call la_${ri}$${ci}$scal(j,ajj,ap(jc),1)
              end do
           else
              ! compute the product inv(l)**h * inv(l).
              jj = 1
              do j = 1,n
                 jjn = jj + n - j + 1
                 ap(jj) = real(la_${ri}$dotc(n - j + 1,ap(jj),1,ap(jj),1),KIND=${rk}$)
                 if (j < n) call la_${ri}$tpmv('LOWER','CONJUGATE TRANSPOSE','NON-UNIT',n - j,ap( &
                           jjn),ap(jj + 1),1)
                 jj = jjn
              end do
           end if
           return
     end subroutine la_${ri}$pptri
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTTRS: solves a tridiagonal system of the form
     !> A * X = B
#:if rk == "sp"
     !> using the factorization A = U**H*D*U or A = L*D*L**H computed by ${ri.upper()}$PTTRF.
#:else
     !> using the factorization A = U**H *D* U or A = L*D*L**H computed by ${ri.upper()}$PTTRF.
#:endif
     !> D is a diagonal matrix specified in the vector D, U (or L) is a unit
     !> bidiagonal matrix whose superdiagonal (subdiagonal) is specified in
     !> the vector E, and X and B are N by NRHS matrices.

     pure subroutine la_${ri}$pttrs(uplo,n,nrhs,d,e,b,ldb,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(in) :: d(*)
           complex(${rk}$),intent(inout) :: b(ldb,*)
           complex(${rk}$),intent(in) :: e(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: iuplo,j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments.
           info = 0
           upper = (uplo == 'U' .or. uplo == 'U')
           if (.not. upper .and. .not. (uplo == 'L' .or. uplo == 'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PTTRS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) return
           ! determine the number of right-hand sides to solve at a time.
           if (nrhs == 1) then
              nb = 1
           else
              nb = max(1,la_ilaenv(1,'${ri.upper()}$PTTRS',uplo,n,nrhs,-1,-1))
           end if
           ! decode uplo
           if (upper) then
              iuplo = 1
           else
              iuplo = 0
           end if
           if (nb >= nrhs) then
              call la_${ri}$ptts2(iuplo,n,nrhs,d,e,b,ldb)
           else
              do j = 1,nrhs,nb
                 jb = min(nrhs - j + 1,nb)
                 call la_${ri}$ptts2(iuplo,n,jb,d,e,b(1,j),ldb)
              end do
           end if
           return
     end subroutine la_${ri}$pttrs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PFTRF: computes the Cholesky factorization of a complex Hermitian
     !> positive definite matrix A.
     !> The factorization has the form
     !> A = U**H * U,  if UPLO = 'U', or
     !> A = L  * L**H,  if UPLO = 'L',
     !> where U is an upper triangular matrix and L is lower triangular.
     !> This is the block version of the algorithm, calling Level 3 BLAS.

     pure subroutine la_${ri}$pftrf(transr,uplo,n,a,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: transr,uplo
           integer(ilp),intent(in) :: n
           integer(ilp),intent(out) :: info
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(0:*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,nisodd,normaltransr
           integer(ilp) :: n1,n2,k
           ! Intrinsic Functions
           intrinsic :: mod
           ! Executable Statements
           ! test the input parameters.
           info = 0
           normaltransr = la_lsame(transr,'N')
           lower = la_lsame(uplo,'L')
           if (.not. normaltransr .and. .not. la_lsame(transr,'C')) then
              info = -1
           else if (.not. lower .and. .not. la_lsame(uplo,'U')) then
              info = -2
           else if (n < 0) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PFTRF',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! if n is odd, set nisodd = .true.
           ! if n is even, set k = n/2 and nisodd = .false.
           if (mod(n,2) == 0) then
              k = n/2
              nisodd = .false.
           else
              nisodd = .true.
           end if
           ! set n1 and n2 depending on lower
           if (lower) then
              n2 = n/2
              n1 = n - n2
           else
              n1 = n/2
              n2 = n - n1
           end if
           ! start execution: there are eight cases
           if (nisodd) then
              ! n is odd
              if (normaltransr) then
                 ! n is odd and transr = 'n'
                 if (lower) then
                   ! srpa for lower, normal and n is odd ( a(0:n-1,0:n1-1) )
                   ! t1 -> a(0,0), t2 -> a(0,1), s -> a(n1,0)
                   ! t1 -> a(0), t2 -> a(n), s -> a(n1)
                    call la_${ri}$potrf('L',n1,a(0),n,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','L','C','N',n2,n1,cone,a(0),n,a(n1),n)

                    call la_${ri}$herk('U','N',n2,n1,-one,a(n1),n,one,a(n),n)
                    call la_${ri}$potrf('U',n2,a(n),n,info)
                    if (info > 0) info = info + n1
                 else
                   ! srpa for upper, normal and n is odd ( a(0:n-1,0:n2-1)
                   ! t1 -> a(n1+1,0), t2 -> a(n1,0), s -> a(0,0)
                   ! t1 -> a(n2), t2 -> a(n1), s -> a(0)
                    call la_${ri}$potrf('L',n1,a(n2),n,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','L','N','N',n1,n2,cone,a(n2),n,a(0),n)

                    call la_${ri}$herk('U','C',n2,n1,-one,a(0),n,one,a(n1),n)
                    call la_${ri}$potrf('U',n2,a(n1),n,info)
                    if (info > 0) info = info + n1
                 end if
              else
                 ! n is odd and transr = 'c'
                 if (lower) then
                    ! srpa for lower, transpose and n is odd
                    ! t1 -> a(0,0) , t2 -> a(1,0) , s -> a(0,n1)
                    ! t1 -> a(0+0) , t2 -> a(1+0) , s -> a(0+n1*n1); lda=n1
                    call la_${ri}$potrf('U',n1,a(0),n1,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','U','C','N',n1,n2,cone,a(0),n1,a(n1*n1), &
                              n1)
                    call la_${ri}$herk('L','C',n2,n1,-one,a(n1*n1),n1,one,a(1),n1)

                    call la_${ri}$potrf('L',n2,a(1),n1,info)
                    if (info > 0) info = info + n1
                 else
                    ! srpa for upper, transpose and n is odd
                    ! t1 -> a(0,n1+1), t2 -> a(0,n1), s -> a(0,0)
                    ! t1 -> a(n2*n2), t2 -> a(n1*n2), s -> a(0); lda = n2
                    call la_${ri}$potrf('U',n1,a(n2*n2),n2,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','U','N','N',n2,n1,cone,a(n2*n2),n2,a(0), &
                              n2)
                    call la_${ri}$herk('L','N',n2,n1,-one,a(0),n2,one,a(n1*n2),n2)

                    call la_${ri}$potrf('L',n2,a(n1*n2),n2,info)
                    if (info > 0) info = info + n1
                 end if
              end if
           else
              ! n is even
              if (normaltransr) then
                 ! n is even and transr = 'n'
                 if (lower) then
                    ! srpa for lower, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(1,0), t2 -> a(0,0), s -> a(k+1,0)
                    ! t1 -> a(1), t2 -> a(0), s -> a(k+1)
                    call la_${ri}$potrf('L',k,a(1),n + 1,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','L','C','N',k,k,cone,a(1),n + 1,a(k + 1),n + 1)

                    call la_${ri}$herk('U','N',k,k,-one,a(k + 1),n + 1,one,a(0),n + 1)

                    call la_${ri}$potrf('U',k,a(0),n + 1,info)
                    if (info > 0) info = info + k
                 else
                    ! srpa for upper, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(k+1,0) ,  t2 -> a(k,0),   s -> a(0,0)
                    ! t1 -> a(k+1), t2 -> a(k), s -> a(0)
                    call la_${ri}$potrf('L',k,a(k + 1),n + 1,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','L','N','N',k,k,cone,a(k + 1),n + 1,a(0),n + 1)

                    call la_${ri}$herk('U','C',k,k,-one,a(0),n + 1,one,a(k),n + 1)

                    call la_${ri}$potrf('U',k,a(k),n + 1,info)
                    if (info > 0) info = info + k
                 end if
              else
                 ! n is even and transr = 'c'
                 if (lower) then
                    ! srpa for lower, transpose and n is even (see paper)
                    ! t1 -> b(0,1), t2 -> b(0,0), s -> b(0,k+1)
                    ! t1 -> a(0+k), t2 -> a(0+0), s -> a(0+k*(k+1)); lda=k
                    call la_${ri}$potrf('U',k,a(0 + k),k,info)
                    if (info > 0) return
                    call la_${ri}$trsm('L','U','C','N',k,k,cone,a(k),n1,a(k*(k + 1)), &
                              k)
                    call la_${ri}$herk('L','C',k,k,-one,a(k*(k + 1)),k,one,a(0),k)

                    call la_${ri}$potrf('L',k,a(0),k,info)
                    if (info > 0) info = info + k
                 else
                    ! srpa for upper, transpose and n is even (see paper)
                    ! t1 -> b(0,k+1),     t2 -> b(0,k),   s -> b(0,0)
                    ! t1 -> a(0+k*(k+1)), t2 -> a(0+k*k), s -> a(0+0)); lda=k
                    call la_${ri}$potrf('U',k,a(k*(k + 1)),k,info)
                    if (info > 0) return
                    call la_${ri}$trsm('R','U','N','N',k,k,cone,a(k*(k + 1)),k,a(0), &
                              k)
                    call la_${ri}$herk('L','N',k,k,-one,a(0),k,one,a(k*k),k)
                    call la_${ri}$potrf('L',k,a(k*k),k,info)
                    if (info > 0) info = info + k
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$pftrf
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PFTRI: computes the inverse of a complex Hermitian positive definite
     !> matrix A using the Cholesky factorization A = U**H*U or A = L*L**H
     !> computed by ${ri.upper()}$PFTRF.

     pure subroutine la_${ri}$pftri(transr,uplo,n,a,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: transr,uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(0:*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lower,nisodd,normaltransr
           integer(ilp) :: n1,n2,k
           ! Intrinsic Functions
           intrinsic :: mod
           ! Executable Statements
           ! test the input parameters.
           info = 0
           normaltransr = la_lsame(transr,'N')
           lower = la_lsame(uplo,'L')
           if (.not. normaltransr .and. .not. la_lsame(transr,'C')) then
              info = -1
           else if (.not. lower .and. .not. la_lsame(uplo,'U')) then
              info = -2
           else if (n < 0) then
              info = -3
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PFTRI',-info)
              return
           end if
           ! quick return if possible
           if (n == 0) return
           ! invert the triangular cholesky factor u or l.
           call la_${ri}$tftri(transr,uplo,'N',n,a,info)
           if (info > 0) return
           ! if n is odd, set nisodd = .true.
           ! if n is even, set k = n/2 and nisodd = .false.
           if (mod(n,2) == 0) then
              k = n/2
              nisodd = .false.
           else
              nisodd = .true.
           end if
           ! set n1 and n2 depending on lower
           if (lower) then
              n2 = n/2
              n1 = n - n2
           else
              n1 = n/2
              n2 = n - n1
           end if
           ! start execution of triangular matrix multiply: inv(u)*inv(u)^c or
           ! inv(l)^c*inv(l). there are eight cases.
           if (nisodd) then
              ! n is odd
              if (normaltransr) then
                 ! n is odd and transr = 'n'
                 if (lower) then
                    ! srpa for lower, normal and n is odd ( a(0:n-1,0:n1-1) )
                    ! t1 -> a(0,0), t2 -> a(0,1), s -> a(n1,0)
                    ! t1 -> a(0), t2 -> a(n), s -> a(n1)
                    call la_${ri}$lauum('L',n1,a(0),n,info)
                    call la_${ri}$herk('L','C',n1,n2,one,a(n1),n,one,a(0),n)
                    call la_${ri}$trmm('L','U','N','N',n2,n1,cone,a(n),n,a(n1),n)

                    call la_${ri}$lauum('U',n2,a(n),n,info)
                 else
                    ! srpa for upper, normal and n is odd ( a(0:n-1,0:n2-1)
                    ! t1 -> a(n1+1,0), t2 -> a(n1,0), s -> a(0,0)
                    ! t1 -> a(n2), t2 -> a(n1), s -> a(0)
                    call la_${ri}$lauum('L',n1,a(n2),n,info)
                    call la_${ri}$herk('L','N',n1,n2,one,a(0),n,one,a(n2),n)
                    call la_${ri}$trmm('R','U','C','N',n1,n2,cone,a(n1),n,a(0),n)

                    call la_${ri}$lauum('U',n2,a(n1),n,info)
                 end if
              else
                 ! n is odd and transr = 'c'
                 if (lower) then
                    ! srpa for lower, transpose, and n is odd
                    ! t1 -> a(0), t2 -> a(1), s -> a(0+n1*n1)
                    call la_${ri}$lauum('U',n1,a(0),n1,info)
                    call la_${ri}$herk('U','N',n1,n2,one,a(n1*n1),n1,one,a(0),n1)

                    call la_${ri}$trmm('R','L','N','N',n1,n2,cone,a(1),n1,a(n1*n1), &
                              n1)
                    call la_${ri}$lauum('L',n2,a(1),n1,info)
                 else
                    ! srpa for upper, transpose, and n is odd
                    ! t1 -> a(0+n2*n2), t2 -> a(0+n1*n2), s -> a(0)
                    call la_${ri}$lauum('U',n1,a(n2*n2),n2,info)
                    call la_${ri}$herk('U','C',n1,n2,one,a(0),n2,one,a(n2*n2),n2)

                    call la_${ri}$trmm('L','L','C','N',n2,n1,cone,a(n1*n2),n2,a(0), &
                              n2)
                    call la_${ri}$lauum('L',n2,a(n1*n2),n2,info)
                 end if
              end if
           else
              ! n is even
              if (normaltransr) then
                 ! n is even and transr = 'n'
                 if (lower) then
                    ! srpa for lower, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(1,0), t2 -> a(0,0), s -> a(k+1,0)
                    ! t1 -> a(1), t2 -> a(0), s -> a(k+1)
                    call la_${ri}$lauum('L',k,a(1),n + 1,info)
                    call la_${ri}$herk('L','C',k,k,one,a(k + 1),n + 1,one,a(1),n + 1)

                    call la_${ri}$trmm('L','U','N','N',k,k,cone,a(0),n + 1,a(k + 1),n + 1)

                    call la_${ri}$lauum('U',k,a(0),n + 1,info)
                 else
                    ! srpa for upper, normal, and n is even ( a(0:n,0:k-1) )
                    ! t1 -> a(k+1,0) ,  t2 -> a(k,0),   s -> a(0,0)
                    ! t1 -> a(k+1), t2 -> a(k), s -> a(0)
                    call la_${ri}$lauum('L',k,a(k + 1),n + 1,info)
                    call la_${ri}$herk('L','N',k,k,one,a(0),n + 1,one,a(k + 1),n + 1)

                    call la_${ri}$trmm('R','U','C','N',k,k,cone,a(k),n + 1,a(0),n + 1)

                    call la_${ri}$lauum('U',k,a(k),n + 1,info)
                 end if
              else
                 ! n is even and transr = 'c'
                 if (lower) then
                    ! srpa for lower, transpose, and n is even (see paper)
                    ! t1 -> b(0,1), t2 -> b(0,0), s -> b(0,k+1),
                    ! t1 -> a(0+k), t2 -> a(0+0), s -> a(0+k*(k+1)); lda=k
                    call la_${ri}$lauum('U',k,a(k),k,info)
                    call la_${ri}$herk('U','N',k,k,one,a(k*(k + 1)),k,one,a(k),k)

                    call la_${ri}$trmm('R','L','N','N',k,k,cone,a(0),k,a(k*(k + 1)), &
                              k)
                    call la_${ri}$lauum('L',k,a(0),k,info)
                 else
                    ! srpa for upper, transpose, and n is even (see paper)
                    ! t1 -> b(0,k+1),     t2 -> b(0,k),   s -> b(0,0),
                    ! t1 -> a(0+k*(k+1)), t2 -> a(0+k*k), s -> a(0+0)); lda=k
                    call la_${ri}$lauum('U',k,a(k*(k + 1)),k,info)
                    call la_${ri}$herk('U','C',k,k,one,a(0),k,one,a(k*(k + 1)),k)

                    call la_${ri}$trmm('L','L','C','N',k,k,cone,a(k*k),k,a(0),k)

                    call la_${ri}$lauum('L',k,a(k*k),k,info)
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$pftri
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if LA_GUARD[rk]
#ifdef ${LA_GUARD[rk]}$
#:endif
     !> ${ri.upper()}$PTRFS: improves the computed solution to a system of linear
     !> equations when the coefficient matrix is Hermitian positive definite
     !> and tridiagonal, and provides error bounds and backward error
     !> estimates for the solution.

     pure subroutine la_${ri}$ptrfs(uplo,n,nrhs,d,e,df,ef,b,ldb,x,ldx,ferr,berr,work, &
               rwork,info)
        use la_constants_${rk}$,only:zero,one,two,three
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: uplo
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldb,ldx,n,nrhs
           ! Array Arguments
           real(${rk}$),intent(out) :: berr(*),ferr(*),rwork(*)
           real(${rk}$),intent(in) :: d(*),df(*)
           complex(${rk}$),intent(in) :: b(ldb,*),e(*),ef(*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: itmax = 5

           ! Local Scalars
           logical(lk) :: upper
           integer(ilp) :: count,i,ix,j,nz
           real(${rk}$) :: eps,lstres,s,safe1,safe2,safmin
           complex(${rk}$) :: bi,cx,dx,ex,zdum
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,aimag,cmplx,conjg,max,real
#:else
           intrinsic :: abs,real,cmplx,conjg,aimag,max
#:endif
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(zdum) = abs(real(zdum,KIND=${rk}$)) + abs(aimag(zdum))
           ! Executable Statements
           ! test the input parameters.
           info = 0
           upper = la_lsame(uplo,'U')
           if (.not. upper .and. .not. la_lsame(uplo,'L')) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nrhs < 0) then
              info = -3
           else if (ldb < max(1,n)) then
              info = -9
           else if (ldx < max(1,n)) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$PTRFS',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. nrhs == 0) then
              do j = 1,nrhs
                 ferr(j) = zero
                 berr(j) = zero
              end do
              return
           end if
           ! nz = maximum number of nonzero elements in each row of a, plus 1
           nz = 4
           eps = la_${ci}$lamch('EPSILON')
           safmin = la_${ci}$lamch('SAFE MINIMUM')
           safe1 = nz*safmin
           safe2 = safe1/eps
           ! do for each right hand side
           loop_100: do j = 1,nrhs
              count = 1
              lstres = three
              20 continue
              ! loop until stopping criterion is satisfied.
              ! compute residual r = b - a * x.  also compute
              ! abs(a)*abs(x) + abs(b) for use in the backward error bound.
              if (upper) then
                 if (n == 1) then
                    bi = b(1,j)
                    dx = d(1)*x(1,j)
                    work(1) = bi - dx
                    rwork(1) = cabs1(bi) + cabs1(dx)
                 else
                    bi = b(1,j)
                    dx = d(1)*x(1,j)
                    ex = e(1)*x(2,j)
                    work(1) = bi - dx - ex
                    rwork(1) = cabs1(bi) + cabs1(dx) + cabs1(e(1))*cabs1(x(2,j))

                    do i = 2,n - 1
                       bi = b(i,j)
                       cx = conjg(e(i - 1))*x(i - 1,j)
                       dx = d(i)*x(i,j)
                       ex = e(i)*x(i + 1,j)
                       work(i) = bi - cx - dx - ex
                       rwork(i) = cabs1(bi) + cabs1(e(i - 1))*cabs1(x(i - 1,j)) + cabs1( &
                                 dx) + cabs1(e(i))*cabs1(x(i + 1,j))
                    end do
                    bi = b(n,j)
                    cx = conjg(e(n - 1))*x(n - 1,j)
                    dx = d(n)*x(n,j)
                    work(n) = bi - cx - dx
                    rwork(n) = cabs1(bi) + cabs1(e(n - 1))*cabs1(x(n - 1,j)) + cabs1(dx &
                              )
                 end if
              else
                 if (n == 1) then
                    bi = b(1,j)
                    dx = d(1)*x(1,j)
                    work(1) = bi - dx
                    rwork(1) = cabs1(bi) + cabs1(dx)
                 else
                    bi = b(1,j)
                    dx = d(1)*x(1,j)
                    ex = conjg(e(1))*x(2,j)
                    work(1) = bi - dx - ex
                    rwork(1) = cabs1(bi) + cabs1(dx) + cabs1(e(1))*cabs1(x(2,j))

                    do i = 2,n - 1
                       bi = b(i,j)
                       cx = e(i - 1)*x(i - 1,j)
                       dx = d(i)*x(i,j)
                       ex = conjg(e(i))*x(i + 1,j)
                       work(i) = bi - cx - dx - ex
                       rwork(i) = cabs1(bi) + cabs1(e(i - 1))*cabs1(x(i - 1,j)) + cabs1( &
                                 dx) + cabs1(e(i))*cabs1(x(i + 1,j))
                    end do
                    bi = b(n,j)
                    cx = e(n - 1)*x(n - 1,j)
                    dx = d(n)*x(n,j)
                    work(n) = bi - cx - dx
                    rwork(n) = cabs1(bi) + cabs1(e(n - 1))*cabs1(x(n - 1,j)) + cabs1(dx &
                              )
                 end if
              end if
              ! compute componentwise relative backward error from formula
              ! max(i) ( abs(r(i)) / ( abs(a)*abs(x) + abs(b) )(i) )
              ! where abs(z) is the componentwise absolute value of the matrix
              ! or vector z.  if the i-th component of the denominator is less
              ! than safe2, then safe1 is added to the i-th components of the
              ! numerator and denominator before dividing.
              s = zero
              do i = 1,n
                 if (rwork(i) > safe2) then
                    s = max(s,cabs1(work(i))/rwork(i))
                 else
                    s = max(s, (cabs1(work(i)) + safe1)/(rwork(i) + safe1))
                 end if
              end do
              berr(j) = s
              ! test stopping criterion. continue iterating if
                 ! 1) the residual berr(j) is larger than machine epsilon, and
                 ! 2) berr(j) decreased by at least a factor of 2 during the
                    ! last iteration, and
                 ! 3) at most itmax iterations tried.
              if (berr(j) > eps .and. two*berr(j) <= lstres .and. count <= itmax) then
                 ! update solution and try again.
                 call la_${ri}$pttrs(uplo,n,1,df,ef,work,n,info)
                 call la_${ri}$axpy(n,cmplx(one,KIND=${rk}$),work,1,x(1,j),1)
                 lstres = berr(j)
                 count = count + 1
                 go to 20
              end if
              ! bound error from formula
              ! norm(x - xtrue) / norm(x) .le. ferr =
              ! norm( abs(inv(a))*
                 ! ( abs(r) + nz*eps*( abs(a)*abs(x)+abs(b) ))) / norm(x)
              ! where
                ! norm(z) is the magnitude of the largest component of z
                ! inv(a) is the inverse of a
                ! abs(z) is the componentwise absolute value of the matrix or
                   ! vector z
                ! nz is the maximum number of nonzeros in any row of a, plus 1
                ! eps is machine epsilon
              ! the i-th component of abs(r)+nz*eps*(abs(a)*abs(x)+abs(b))
              ! is incremented by safe1 if the i-th component of
              ! abs(a)*abs(x) + abs(b) is less than safe2.
              do i = 1,n
                 if (rwork(i) > safe2) then
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i)
                 else
                    rwork(i) = cabs1(work(i)) + nz*eps*rwork(i) + safe1
                 end if
              end do
              ix = la_i${ci}$amax(n,rwork,1)
              ferr(j) = rwork(ix)
              ! estimate the norm of inv(a).
              ! solve m(a) * x = e, where m(a) = (m(i,j)) is given by
                 ! m(i,j) =  abs(a(i,j)), i = j,
                 ! m(i,j) = -abs(a(i,j)), i .ne. j,
              ! and e = [ 1, 1, ..., 1 ]**t.  note m(a) = m(l)*d*m(l)**h.
              ! solve m(l) * x = e.
              rwork(1) = one
              do i = 2,n
                 rwork(i) = one + rwork(i - 1)*abs(ef(i - 1))
              end do
              ! solve d * m(l)**h * x = b.
              rwork(n) = rwork(n)/df(n)
              do i = n - 1,1,-1
                 rwork(i) = rwork(i)/df(i) + rwork(i + 1)*abs(ef(i))
              end do
              ! compute norm(inv(a)) = max(x(i)), 1<=i<=n.
              ix = la_i${ci}$amax(n,rwork,1)
              ferr(j) = ferr(j)*abs(rwork(ix))
              ! normalize error.
              lstres = zero
              do i = 1,n
                 lstres = max(lstres,abs(x(i,j)))
              end do
              if (lstres /= zero) ferr(j) = ferr(j)/lstres
           end do loop_100
           return
     end subroutine la_${ri}$ptrfs
#:if LA_GUARD[rk]
#endif
#:endif
#:endfor

end module la_lapack_solve_chol_comp
