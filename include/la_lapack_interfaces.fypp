    &  {'complex': '               pure subroutine {ri}laqsy(uplo,n,a,lda,s,scond,amax,equed)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(out) :: equed\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: lda,n\n                    real({rk}),intent(in) :: amax,scond,s(*)\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}laqsy', 'real': '               pure subroutine {ri}laqsy(uplo,n,a,lda,s,scond,amax,equed)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(out) :: equed\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(in) :: amax,scond,s(*)\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}laqsy'}), &
    & ('laqtr', ['LAQTR: solves the real quasi-triangular system', 'op(T)*p = scale*c,               if LREAL = .TRUE.', 'or the complex quasi-triangular systems', 'op(T + iB)*(p+iq) = scale*(c+id),  if LREAL = .FALSE.', 'in real arithmetic, where T is upper quasi-triangular.', 'If LREAL = .FALSE., then the first diagonal block of T must be', '1 by 1, B is the specially structured matrix', 'B = [ b(1) b(2) ... b(n) ]', '[       w            ]', '[           w        ]', '[              .     ]', '[                 w  ]', 'op(A) = A or A**T, A**T denotes the transpose of', 'matrix A.', 'On input, X = [ c ].  On output, X = [ p ].', '[ d ]                  [ q ]', 'This subroutine is designed for the condition number estimation', 'in routine DTRSNA.'], &
    &  [('dlaqtr', 'dlaqtr', 'real'), ('qlaqtr', 'qlaqtr', None), ('slaqtr', 'slaqtr', 'real'), ('xlaqtr', 'xlaqtr', None)], &
    &  {'real': '               subroutine {ri}laqtr(ltran,lreal,n,t,ldt,b,w,scale,x,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: lreal,ltran\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldt,n\n                    {rt},intent(out) :: scale,work(*)\n                    {rt},intent(in) :: w,b(*),t(ldt,*)\n                    {rt},intent(inout) :: x(*)\n               end subroutine {ri}laqtr'}), &
    & ('laqz0', ['LAQZ0: computes the eigenvalues of a matrix pair (H,T),', 'where H is an upper Hessenberg matrix and T is upper triangular,', 'using the double-shift QZ method.', 'Matrix pairs of this type are produced by the reduction to', 'generalized upper Hessenberg form of a matrix pair (A,B):', 'A = Q1*H*Z1**H,  B = Q1*T*Z1**H,', 'as computed by CGGHRD.', "If JOB='S', then the Hessenberg-triangular pair (H,T) is", 'also reduced to generalized Schur form,', 'H = Q*S*Z**H,  T = Q*P*Z**H,', 'where Q and Z are unitary matrices, P and S are an upper triangular', 'matrices.', 'Optionally, the unitary matrix Q from the generalized Schur', 'factorization may be postmultiplied into an input matrix Q1, and the', 'unitary matrix Z may be postmultiplied into an input matrix Z1.', 'If Q1 and Z1 are the unitary matrices from CGGHRD that reduced', 'the matrix pair (A,B) to generalized upper Hessenberg form, then the', 'output matrices Q1*Q and Z1*Z are the unitary factors from the', 'generalized Schur factorization of (A,B):', 'A = (Q1*Q)*S*(Z1*Z)**H,  B = (Q1*Q)*P*(Z1*Z)**H.', 'To avoid overflow, eigenvalues of the matrix pair (H,T) (equivalently,', 'of (A,B)) are computed as a pair of values (alpha,beta), where alpha is', 'complex and beta real.', 'If beta is nonzero, lambda = alpha / beta is an eigenvalue of the', 'generalized nonsymmetric eigenvalue problem (GNEP)', 'A*x = lambda*B*x', 'and if alpha is nonzero, mu = beta / alpha is an eigenvalue of the', 'alternate form of the GNEP', 'mu*A*y = B*y.', 'Eigenvalues can be read directly from the generalized Schur', 'form:', 'alpha = S(i,i), beta = P(i,i).', 'Ref: C.B. Moler', 'Eigenvalue Problems", SIAM J. Numer. Anal., 10(1973),', 'pp. 241--256.', 'Ref: B. Kagstrom, D. Kressner, "Multishift Variants of the QZ', 'Algorithm with Aggressive Early Deflation", SIAM J. Numer.', 'Anal., 29(2006), pp. 199--227.', 'Ref: T. Steel, D. Camps, K. Meerbergen, R. Vandebril "A multishift,', 'multipole rational QZ method with agressive early deflation"'], &
    &  [('claqz0', 'claqz0', 'complex'), ('dlaqz0', 'dlaqz0', 'real'), ('qlaqz0', 'qlaqz0', None), ('slaqz0', 'slaqz0', 'real'), ('wlaqz0', 'wlaqz0', None), ('xlaqz0', 'xlaqz0', None), ('ylaqz0', 'ylaqz0', None), ('zlaqz0', 'zlaqz0', 'complex')], &
    &  {'complex': '               recursive subroutine {ri}laqz0(wants,wantq,wantz,n,ilo,ihi,a,lda,b,ldb, &\n                         alpha,beta,q,ldq,z,ldz,work,lwork,rwork,rec,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: wants,wantq,wantz\n                    integer(ilp),intent(in) :: n,ilo,ihi,lda,ldb,ldq,ldz,lwork,rec\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n                    {rt},intent(inout) :: alpha(*),beta(*),work(*)\n                    real({rk}),intent(out) :: rwork(*)\n               end subroutine {ri}laqz0', 'real': '               recursive subroutine {ri}laqz0(wants,wantq,wantz,n,ilo,ihi,a,lda,b,ldb, &\n                         alphar,alphai,beta,q,ldq,z,ldz,work,lwork,rec,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: wants,wantq,wantz\n                    integer(ilp),intent(in) :: n,ilo,ihi,lda,ldb,ldq,ldz,lwork,rec\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n                    {rt},intent(inout) :: alphar(*),alphai(*),beta(*),work(*)\n               end subroutine {ri}laqz0'}), &
    & ('laqz1', ['LAQZ1: chases a 1x1 shift bulge in a matrix pencil down a single position'], &
    &  [('claqz1', 'claqz1', 'complex'), ('dlaqz1', 'dlaqz1', 'real'), ('qlaqz1', 'qlaqz1', None), ('slaqz1', 'slaqz1', 'real'), ('wlaqz1', 'wlaqz1', None), ('xlaqz1', 'xlaqz1', None), ('ylaqz1', 'ylaqz1', None), ('zlaqz1', 'zlaqz1', 'complex')], &
    &  {'complex': '               pure subroutine {ri}laqz1(ilq,ilz,k,istartm,istopm,ihi,a,lda,b,ldb,nq, &\n                         qstart,q,ldq,nz,zstart,z,ldz)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: ilq,ilz\n                    integer(ilp),intent(in) :: k,lda,ldb,ldq,ldz,istartm,istopm,nq,nz,qstart, &\n                              zstart,ihi\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n               end subroutine {ri}laqz1', 'real': '               pure subroutine {ri}laqz1(a,lda,b,ldb,sr1,sr2,si,beta1,beta2,v)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: lda,ldb\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),sr1,sr2,si,beta1,beta2\n                    {rt},intent(out) :: v(*)\n               end subroutine {ri}laqz1'}), &
    & ('laqz4', ['LAQZ4: Executes a single multishift QZ sweep'], &
    &  [('dlaqz4', 'dlaqz4', 'real'), ('qlaqz4', 'qlaqz4', None), ('slaqz4', 'slaqz4', 'real'), ('xlaqz4', 'xlaqz4', None)], &
    &  {'real': '               pure subroutine {ri}laqz4(ilschur,ilq,ilz,n,ilo,ihi,nshifts,nblock_desired,sr, &\n                si,ss,a,lda,b,ldb,q,ldq,z,ldz,qc,ldqc,zc,ldzc,work,lwork,info)\n                          \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: ilschur,ilq,ilz\n                    integer(ilp),intent(in) :: n,ilo,ihi,lda,ldb,ldq,ldz,lwork,nshifts, &\n                              nblock_desired,ldqc,ldzc\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*),qc(ldqc,*),zc( &\n                              ldzc,*)\n                    {rt},intent(inout) :: work(*)\n                    {rt},intent(inout) :: sr(*),si(*),ss(*)\n                    integer(ilp),intent(out) :: info\n               end subroutine {ri}laqz4'}), &
    & ('lar1v', ['LAR1V: computes the (scaled) r-th column of the inverse of', 'the sumbmatrix in rows B1 through BN of the tridiagonal matrix', 'L D L**T - sigma I. When sigma is close to an eigenvalue, the', 'computed vector is an accurate eigenvector. Usually, r corresponds', 'to the index where the eigenvector is largest in magnitude.', 'The following steps accomplish this computation :', '(a) Stationary qd transform,  L D L**T - sigma I = L(+) D(+) L(+)**T,', '(b) Progressive qd transform, L D L**T - sigma I = U(-) D(-) U(-)**T,', '(c) Computation of the diagonal elements of the inverse of', 'L D L**T - sigma I by combining the above transforms, and choosing', 'r as the index where the diagonal of the inverse is (one of the)', 'largest in magnitude.', '(d) Computation of the (scaled) r-th column of the inverse using the', 'twisted factorization obtained by combining the top part of the', 'the stationary and the bottom part of the progressive transform.'], &
    &  [('clar1v', 'clar1v', 'complex'), ('dlar1v', 'dlar1v', 'real'), ('qlar1v', 'qlar1v', None), ('slar1v', 'slar1v', 'real'), ('wlar1v', 'wlar1v', None), ('xlar1v', 'xlar1v', None), ('ylar1v', 'ylar1v', None), ('zlar1v', 'zlar1v', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lar1v(n,b1,bn,lambda,d,l,ld,lld,pivmin,gaptol,z,wantnc, &\n                          negcnt,ztz,mingma,r,isuppz,nrminv,resid,rqcorr,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantnc\n                    integer(ilp),intent(in) :: b1,bn,n\n                    integer(ilp),intent(out) :: negcnt,isuppz(*)\n                    integer(ilp),intent(inout) :: r\n                    real({rk}),intent(in) :: gaptol,lambda,pivmin,d(*),l(*),ld(*),lld(*)\n                    real({rk}),intent(out) :: mingma,nrminv,resid,rqcorr,ztz,work(*)\n                    {rt},intent(inout) :: z(*)\n               end subroutine {ri}lar1v', 'real': '               pure subroutine {ri}lar1v(n,b1,bn,lambda,d,l,ld,lld,pivmin,gaptol,z,wantnc, &\n                          negcnt,ztz,mingma,r,isuppz,nrminv,resid,rqcorr,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantnc\n                    integer(ilp),intent(in) :: b1,bn,n\n                    integer(ilp),intent(out) :: negcnt,isuppz(*)\n                    integer(ilp),intent(inout) :: r\n                    {rt},intent(in) :: gaptol,lambda,pivmin,d(*),l(*),ld(*),lld(*)\n                    {rt},intent(out) :: mingma,nrminv,resid,rqcorr,ztz,work(*)\n                    {rt},intent(inout) :: z(*)\n               end subroutine {ri}lar1v'}), &
    & ('lar2v', ['LAR2V: applies a vector of complex plane rotations with real cosines', 'from both sides to a sequence of 2-by-2 complex Hermitian matrices,', 'defined by the elements of the vectors x, y and z. For i = 1,2,...,n', '(       x(i)  z(i) ) :=', '( conjg(z(i)) y(i) )', '(  c(i) conjg(s(i)) ) (       x(i)  z(i) ) ( c(i) -conjg(s(i)) )', '( -s(i)       c(i)  ) ( conjg(z(i)) y(i) ) ( s(i)        c(i)  )'], &
    &  [('clar2v', 'clar2v', 'complex'), ('dlar2v', 'dlar2v', 'real'), ('qlar2v', 'qlar2v', None), ('slar2v', 'slar2v', 'real'), ('wlar2v', 'wlar2v', None), ('xlar2v', 'xlar2v', None), ('ylar2v', 'ylar2v', None), ('zlar2v', 'zlar2v', 'complex')], &
    &  {'complex': '               pure subroutine {ri}lar2v(n,x,y,z,incx,c,s,incc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incc,incx,n\n                    real({rk}),intent(in) :: c(*)\n                    {rt},intent(in) :: s(*)\n                    {rt},intent(inout) :: x(*),y(*),z(*)\n               end subroutine {ri}lar2v', 'real': '               pure subroutine {ri}lar2v(n,x,y,z,incx,c,s,incc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incc,incx,n\n                    {rt},intent(in) :: c(*),s(*)\n                    {rt},intent(inout) :: x(*),y(*),z(*)\n               end subroutine {ri}lar2v'}), &
    & ('larcm', ['LARCM: performs a very simple matrix-matrix multiplication:', 'C := A * B,', 'where A is M by M and real; B is M by N and complex;', 'C is M by N and complex.'], &
    &  [('clarcm', 'clarcm', 'complex'), ('wlarcm', 'wlarcm', None), ('ylarcm', 'ylarcm', None), ('zlarcm', 'zlarcm', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larcm(m,n,a,lda,b,ldb,c,ldc,rwork)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: lda,ldb,ldc,m,n\n                    real({rk}),intent(in) :: a(lda,*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(in) :: b(ldb,*)\n                    {rt},intent(out) :: c(ldc,*)\n               end subroutine {ri}larcm'}), &
    & ('larf', ['LARF: applies a complex elementary reflector H to a complex M-by-N', 'matrix C, from either the left or the right. H is represented in the', 'form', 'H = I - tau * v * v**H', 'where tau is a complex scalar and v is a complex vector.', 'If tau = 0, then H is taken to be the unit matrix.', 'To apply H**H (the conjugate transpose of H), supply conjg(tau) instead', 'tau.'], &
    &  [('clarf', 'clarf', 'complex'), ('dlarf', 'dlarf', 'real'), ('qlarf', 'qlarf', None), ('slarf', 'slarf', 'real'), ('wlarf', 'wlarf', None), ('xlarf', 'xlarf', None), ('ylarf', 'ylarf', None), ('zlarf', 'zlarf', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larf(side,m,n,v,incv,tau,c,ldc,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: side\n                    integer(ilp),intent(in) :: incv,ldc,m,n\n                    {rt},intent(in) :: tau,v(*)\n                    {rt},intent(inout) :: c(ldc,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}larf', 'real': '               pure subroutine {ri}larf(side,m,n,v,incv,tau,c,ldc,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: side\n                    integer(ilp),intent(in) :: incv,ldc,m,n\n                    {rt},intent(in) :: tau,v(*)\n                    {rt},intent(inout) :: c(ldc,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}larf'}), &
    & ('larfb', ['LARFB: applies a complex block reflector H or its transpose H**H to a', 'complex M-by-N matrix C, from either the left or the right.'], &
    &  [('clarfb', 'clarfb', 'complex'), ('dlarfb', 'dlarfb', 'real'), ('qlarfb', 'qlarfb', None), ('slarfb', 'slarfb', 'real'), ('wlarfb', 'wlarfb', None), ('xlarfb', 'xlarfb', None), ('ylarfb', 'ylarfb', None), ('zlarfb', 'zlarfb', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larfb(side,trans,direct,storev,m,n,k,v,ldv,t,ldt,c, &\n                         ldc,work,ldwork)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: direct,side,storev,trans\n                    integer(ilp),intent(in) :: k,ldc,ldt,ldv,ldwork,m,n\n                    {rt},intent(inout) :: c(ldc,*)\n                    {rt},intent(in) :: t(ldt,*),v(ldv,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}larfb', 'real': '               pure subroutine {ri}larfb(side,trans,direct,storev,m,n,k,v,ldv,t,ldt,c, &\n                         ldc,work,ldwork)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: direct,side,storev,trans\n                    integer(ilp),intent(in) :: k,ldc,ldt,ldv,ldwork,m,n\n                    {rt},intent(inout) :: c(ldc,*)\n                    {rt},intent(in) :: t(ldt,*),v(ldv,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}larfb'}), &
    & ('larfb_gett', ['LARFB_GETT: applies a complex Householder block reflector H from the', 'left to a complex (K+M)-by-N  "triangular-pentagonal" matrix', 'composed of two block matrices: an upper trapezoidal K-by-N matrix A', 'stored in the array A, and a rectangular M-by-(N-K) matrix B, stored', 'in the array B. The block reflector H is stored in a compact', 'WY-representation, where the elementary reflectors are in the', 'arrays A, B and T. See Further Details section.'], &
    &  [('clarfb_gett', 'clarfb_gett', 'complex'), ('dlarfb_gett', 'dlarfb_gett', 'real'), ('qlarfb_gett', 'qlarfb_gett', None), ('slarfb_gett', 'slarfb_gett', 'real'), ('wlarfb_gett', 'wlarfb_gett', None), ('xlarfb_gett', 'xlarfb_gett', None), ('ylarfb_gett', 'ylarfb_gett', None), ('zlarfb_gett', 'zlarfb_gett', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larfb_gett(ident,m,n,k,t,ldt,a,lda,b,ldb,work,ldwork)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: ident\n                    integer(ilp),intent(in) :: k,lda,ldb,ldt,ldwork,m,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(in) :: t(ldt,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}larfb_gett', 'real': '               pure subroutine {ri}larfb_gett(ident,m,n,k,t,ldt,a,lda,b,ldb,work,ldwork)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: ident\n                    integer(ilp),intent(in) :: k,lda,ldb,ldt,ldwork,m,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(in) :: t(ldt,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}larfb_gett'}), &
    & ('larfg', ['LARFG: generates a complex elementary reflector H of order n, such', 'that', 'H**H * ( alpha ) = ( beta ),   H**H * H = I.', '(   x   )   (   0  )', 'where alpha and beta are scalars, with beta real, and x is an', '(n-1)-element complex vector. H is represented in the form', 'H = I - tau * ( 1 ) * ( 1 v**H ) ,', '( v )', 'where tau is a complex scalar and v is a complex (n-1)-element', 'vector. Note that H is not hermitian.', 'If the elements of x are all zero and alpha is real, then tau = 0', 'and H is taken to be the unit matrix.', 'Otherwise  1 <= real(tau) <= 2  and  abs(tau-1) <= 1 .'], &
    &  [('clarfg', 'clarfg', 'complex'), ('dlarfg', 'dlarfg', 'real'), ('qlarfg', 'qlarfg', None), ('slarfg', 'slarfg', 'real'), ('wlarfg', 'wlarfg', None), ('xlarfg', 'xlarfg', None), ('ylarfg', 'ylarfg', None), ('zlarfg', 'zlarfg', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larfg(n,alpha,x,incx,tau)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(inout) :: alpha,x(*)\n                    {rt},intent(out) :: tau\n               end subroutine {ri}larfg', 'real': '               pure subroutine {ri}larfg(n,alpha,x,incx,tau)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(inout) :: alpha,x(*)\n                    {rt},intent(out) :: tau\n               end subroutine {ri}larfg'}), &
    & ('larfgp', ['LARFGP: generates a complex elementary reflector H of order n, such', 'that', 'H**H * ( alpha ) = ( beta ),   H**H * H = I.', '(   x   )   (   0  )', 'where alpha and beta are scalars, beta is real and non-negative, and', 'x is an (n-1)-element complex vector.  H is represented in the form', 'H = I - tau * ( 1 ) * ( 1 v**H ) ,', '( v )', 'where tau is a complex scalar and v is a complex (n-1)-element', 'vector. Note that H is not hermitian.', 'If the elements of x are all zero and alpha is real, then tau = 0', 'and H is taken to be the unit matrix.'], &
    &  [('clarfgp', 'clarfgp', 'complex'), ('dlarfgp', 'dlarfgp', 'real'), ('qlarfgp', 'qlarfgp', None), ('slarfgp', 'slarfgp', 'real'), ('wlarfgp', 'wlarfgp', None), ('xlarfgp', 'xlarfgp', None), ('ylarfgp', 'ylarfgp', None), ('zlarfgp', 'zlarfgp', 'complex')], &
    &  {'complex': '               subroutine {ri}larfgp(n,alpha,x,incx,tau)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(inout) :: alpha,x(*)\n                    {rt},intent(out) :: tau\n               end subroutine {ri}larfgp', 'real': '               subroutine {ri}larfgp(n,alpha,x,incx,tau)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incx,n\n                    {rt},intent(inout) :: alpha,x(*)\n                    {rt},intent(out) :: tau\n               end subroutine {ri}larfgp'}), &
    & ('larft', ['LARFT: forms the triangular factor T of a complex block reflector H', 'of order n, which is defined as a product of k elementary reflectors.', "If DIRECT = 'F', H = H(1) H(2) . . . H(k) and T is upper triangular;", "If DIRECT = 'B', H = H(k) . . . H(2) H(1) and T is lower triangular.", "If STOREV = 'C', the vector which defines the elementary reflector", 'H(i) is stored in the i-th column of the array V, and', 'H  =  I - V * T * V**H', "If STOREV = 'R', the vector which defines the elementary reflector", 'H(i) is stored in the i-th row of the array V, and', 'H  =  I - V**H * T * V'], &
    &  [('clarft', 'clarft', 'complex'), ('dlarft', 'dlarft', 'real'), ('qlarft', 'qlarft', None), ('slarft', 'slarft', 'real'), ('wlarft', 'wlarft', None), ('xlarft', 'xlarft', None), ('ylarft', 'ylarft', None), ('zlarft', 'zlarft', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larft(direct,storev,n,k,v,ldv,tau,t,ldt)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: direct,storev\n                    integer(ilp),intent(in) :: k,ldt,ldv,n\n                    {rt},intent(out) :: t(ldt,*)\n                    {rt},intent(in) :: tau(*),v(ldv,*)\n               end subroutine {ri}larft', 'real': '               pure subroutine {ri}larft(direct,storev,n,k,v,ldv,tau,t,ldt)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: direct,storev\n                    integer(ilp),intent(in) :: k,ldt,ldv,n\n                    {rt},intent(out) :: t(ldt,*)\n                    {rt},intent(in) :: tau(*),v(ldv,*)\n               end subroutine {ri}larft'}), &
    & ('larfy', ['LARFY: applies an elementary reflector, or Householder matrix, H,', 'to an n x n Hermitian matrix C, from both the left and the right.', 'H is represented in the form', "H = I - tau * v * v'", 'where  tau  is a scalar and  v  is a vector.', 'If  tau  is  zero, then  H  is taken to be the unit matrix.'], &
    &  [('clarfy', 'clarfy', 'complex'), ('dlarfy', 'dlarfy', 'real'), ('qlarfy', 'qlarfy', None), ('slarfy', 'slarfy', 'real'), ('wlarfy', 'wlarfy', None), ('xlarfy', 'xlarfy', None), ('ylarfy', 'ylarfy', None), ('zlarfy', 'zlarfy', 'complex')], &
    &  {'complex': '               pure subroutine {ri}larfy(uplo,n,v,incv,tau,c,ldc,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: incv,ldc,n\n                    {rt},intent(in) :: tau,v(*)\n                    {rt},intent(inout) :: c(ldc,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}larfy', 'real': '               pure subroutine {ri}larfy(uplo,n,v,incv,tau,c,ldc,work)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: incv,ldc,n\n                    {rt},intent(in) :: tau,v(*)\n                    {rt},intent(inout) :: c(ldc,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}larfy'}), &
    & ('largv', ['LARGV: generates a vector of complex plane rotations with real', 'cosines, determined by elements of the complex vectors x and y.', 'For i = 1,2,...,n', '(        c(i)   s(i) ) ( x(i) ) = ( r(i) )', '( -conjg(s(i))  c(i) ) ( y(i) ) = (   0  )', 'where c(i)**2 + ABS(s(i))**2 = 1', 'The following conventions are used (these are the same as in CLARTG,', 'but differ from the BLAS1 routine CROTG):', 'If y(i)=0, then c(i)=1 and s(i)=0.', 'If x(i)=0, then c(i)=0 and s(i) is chosen so that r(i) is real.'], &
    &  [('clargv', 'clargv', 'complex'), ('dlargv', 'dlargv', 'real'), ('qlargv', 'qlargv', None), ('slargv', 'slargv', 'real'), ('wlargv', 'wlargv', None), ('xlargv', 'xlargv', None), ('ylargv', 'ylargv', None), ('zlargv', 'zlargv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}largv(n,x,incx,y,incy,c,incc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incc,incx,incy,n\n                    real({rk}),intent(out) :: c(*)\n                    {rt},intent(inout) :: x(*),y(*)\n               end subroutine {ri}largv', 'real': '               pure subroutine {ri}largv(n,x,incx,y,incy,c,incc)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: incc,incx,incy,n\n                    {rt},intent(out) :: c(*)\n                    {rt},intent(inout) :: x(*),y(*)\n               end subroutine {ri}largv'}), &
    & ('larnv', ['LARNV: returns a vector of n random complex numbers from a uniform or', 'normal distribution.'], &
