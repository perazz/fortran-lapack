#:include "common.fypp"
!> Cosine-sine decomposition: bidiagonal block form, simultaneous bidiagonalization, row and column permutations
module la_lapack_cosine_sine
     use la_constants
     use la_blas_aux
     use la_blas_level1
     use la_blas_level2_gen
     use la_lapack_auxiliary
     use la_lapack_blas_like_base
     use la_lapack_blas_like_l1
     use la_lapack_givens_jacobi_rot
     use la_lapack_householder_reflectors
     use la_lapack_orthogonal_factors_ql
     use la_lapack_orthogonal_factors_qr
     use la_lapack_svd_comp2
     implicit none(type,external)
     private

     public :: sp,dp,qp,lk,ilp
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     public :: la_${ri}$lapmr
     public :: la_${ri}$lapmt
     public :: la_${ri}$orbdb6
     public :: la_${ri}$bbcsd
     public :: la_${ri}$orbdb
     public :: la_${ri}$orbdb5
     public :: la_${ri}$orcsd
     public :: la_${ri}$orbdb1
     public :: la_${ri}$orbdb2
     public :: la_${ri}$orbdb3
     public :: la_${ri}$orbdb4
     public :: la_${ri}$orcsd2by1
#:endfor
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     public :: la_${ri}$lapmr
     public :: la_${ri}$lapmt
     public :: la_${ri}$unbdb
     public :: la_${ri}$unbdb6
     public :: la_${ri}$bbcsd
     public :: la_${ri}$unbdb5
     public :: la_${ri}$uncsd
     public :: la_${ri}$unbdb1
     public :: la_${ri}$unbdb2
     public :: la_${ri}$unbdb3
     public :: la_${ri}$unbdb4
     public :: la_${ri}$uncsd2by1
#:endfor

     contains

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAPMR: rearranges the rows of the M by N matrix X as specified
     !> by the permutation K(1),K(2),...,K(M) of the integers 1,...,M.
     !> If FORWRD = .TRUE.,  forward permutation:
     !> X(K(I),*) is moved X(I,*) for I = 1,2,...,M.
     !> If FORWRD = .FALSE., backward permutation:
     !> X(I,*) is moved to X(K(I),*) for I = 1,2,...,M.

     pure subroutine la_${ri}$lapmr(forwrd,m,n,x,ldx,k)
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           logical(lk),intent(in) :: forwrd
           integer(ilp),intent(in) :: ldx,m,n
           ! Array Arguments
           integer(ilp),intent(inout) :: k(*)
           real(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,in,j,jj
           real(${rk}$) :: temp
           ! Executable Statements
           if (m <= 1) return
           do i = 1,m
              k(i) = -k(i)
           end do
           if (forwrd) then
              ! forward permutation
              do i = 1,m
                 if (k(i) > 0) go to 40
                 j = i
                 k(j) = -k(j)
                 in = k(j)
                 20 continue
                 if (k(in) > 0) go to 40
                 do jj = 1,n
                    temp = x(j,jj)
                    x(j,jj) = x(in,jj)
                    x(in,jj) = temp
                 end do
                 k(in) = -k(in)
                 j = in
                 in = k(in)
                 go to 20
                 40 continue
              end do
           else
              ! backward permutation
              do i = 1,m
                 if (k(i) > 0) go to 80
                 k(i) = -k(i)
                 j = k(i)
                 60 continue
                 if (j == i) go to 80
                 do jj = 1,n
                    temp = x(i,jj)
                    x(i,jj) = x(j,jj)
                    x(j,jj) = temp
                 end do
                 k(j) = -k(j)
                 j = k(j)
                 go to 60
                 80 continue
              end do
           end if
           return
     end subroutine la_${ri}$lapmr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAPMT: rearranges the columns of the M by N matrix X as specified
     !> by the permutation K(1),K(2),...,K(N) of the integers 1,...,N.
     !> If FORWRD = .TRUE.,  forward permutation:
     !> X(*,K(J)) is moved X(*,J) for J = 1,2,...,N.
     !> If FORWRD = .FALSE., backward permutation:
     !> X(*,J) is moved to X(*,K(J)) for J = 1,2,...,N.

     pure subroutine la_${ri}$lapmt(forwrd,m,n,x,ldx,k)
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           logical(lk),intent(in) :: forwrd
           integer(ilp),intent(in) :: ldx,m,n
           ! Array Arguments
           integer(ilp),intent(inout) :: k(*)
           real(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Local Scalars
#:if rk == "sp"
           integer(ilp) :: i,ii,j,in
#:else
           integer(ilp) :: i,ii,in,j
#:endif
           real(${rk}$) :: temp
           ! Executable Statements
           if (n <= 1) return
           do i = 1,n
              k(i) = -k(i)
           end do
           if (forwrd) then
              ! forward permutation
              do i = 1,n
                 if (k(i) > 0) go to 40
                 j = i
                 k(j) = -k(j)
                 in = k(j)
                 20 continue
                 if (k(in) > 0) go to 40
                 do ii = 1,m
                    temp = x(ii,j)
                    x(ii,j) = x(ii,in)
                    x(ii,in) = temp
                 end do
                 k(in) = -k(in)
                 j = in
                 in = k(in)
                 go to 20
                 40 continue
              end do
           else
              ! backward permutation
              do i = 1,n
#:if rk == "sp"
                 if (k(i) > 0) go to 100
#:else
                 if (k(i) > 0) go to 80
#:endif
                 k(i) = -k(i)
                 j = k(i)
#:if rk == "sp"
                 80 continue
                 if (j == i) go to 100
#:else
                 60 continue
                 if (j == i) go to 80
#:endif
                 do ii = 1,m
                    temp = x(ii,i)
                    x(ii,i) = x(ii,j)
                    x(ii,j) = temp
                 end do
                 k(j) = -k(j)
                 j = k(j)
#:if rk == "sp"
                 go to 80
                 100 continue
#:else
                 go to 60
                 80 continue
#:endif
              end do
           end if
           return
     end subroutine la_${ri}$lapmt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB6: orthogonalizes the column vector
     !> X = [ X1 ]
     !> [ X2 ]
     !> with respect to the columns of
     !> Q = [ Q1 ] .
     !> [ Q2 ]
     !> The columns of Q must be orthonormal.
     !> If the projection is zero according to Kahan's "twice is enough"
     !> criterion, then the zero vector is returned.

     pure subroutine la_${ri}$orbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
               lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx1,incx2,ldq1,ldq2,lwork,m1,m2,n
           integer(ilp),intent(out) :: info
           ! Array Arguments
           real(${rk}$),intent(in) :: q1(ldq1,*),q2(ldq2,*)
           real(${rk}$),intent(out) :: work(*)
           real(${rk}$),intent(inout) :: x1(*),x2(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: alphasq = 0.01_${rk}$
           real(${rk}$),parameter :: realone = 1.0_${rk}$
           real(${rk}$),parameter :: realzero = 0.0_${rk}$

           ! Local Scalars
           integer(ilp) :: i
           real(${rk}$) :: normsq1,normsq2,scl1,scl2,ssq1,ssq2
           ! Intrinsic Function
           intrinsic :: max
           ! Executable Statements
           ! test input arguments
           info = 0
           if (m1 < 0) then
              info = -1
           else if (m2 < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (incx1 < 1) then
              info = -5
           else if (incx2 < 1) then
              info = -7
           else if (ldq1 < max(1,m1)) then
              info = -9
           else if (ldq2 < max(1,m2)) then
              info = -11
           else if (lwork < n) then
              info = -13
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORBDB6',-info)
              return
           end if
           ! first, project x onto the orthogonal complement of q's column
           ! space
           scl1 = realzero
           ssq1 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           scl2 = realzero
           ssq2 = realone
           call la_${ri}$lassq(m2,x2,incx2,scl2,ssq2)
           normsq1 = scl1**2*ssq1 + scl2**2*ssq2
           if (m1 == 0) then
              do i = 1,n
                 work(i) = zero
              end do
           else
              call la_${ri}$gemv('C',m1,n,one,q1,ldq1,x1,incx1,zero,work,1)
           end if
           call la_${ri}$gemv('C',m2,n,one,q2,ldq2,x2,incx2,one,work,1)
           call la_${ri}$gemv('N',m1,n,negone,q1,ldq1,work,1,one,x1,incx1)
           call la_${ri}$gemv('N',m2,n,negone,q2,ldq2,work,1,one,x2,incx2)
           scl1 = realzero
           ssq1 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           scl2 = realzero
           ssq2 = realone
           call la_${ri}$lassq(m2,x2,incx2,scl2,ssq2)
           normsq2 = scl1**2*ssq1 + scl2**2*ssq2
           ! if projection is sufficiently large in norm, then stop.
           ! if projection is zero, then stop.
           ! otherwise, project again.
           if (normsq2 >= alphasq*normsq1) then
              return
           end if
           if (normsq2 == zero) then
              return
           end if
           normsq1 = normsq2
           do i = 1,n
              work(i) = zero
           end do
           if (m1 == 0) then
              do i = 1,n
                 work(i) = zero
              end do
           else
              call la_${ri}$gemv('C',m1,n,one,q1,ldq1,x1,incx1,zero,work,1)
           end if
           call la_${ri}$gemv('C',m2,n,one,q2,ldq2,x2,incx2,one,work,1)
           call la_${ri}$gemv('N',m1,n,negone,q1,ldq1,work,1,one,x1,incx1)
           call la_${ri}$gemv('N',m2,n,negone,q2,ldq2,work,1,one,x2,incx2)
           scl1 = realzero
           ssq1 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           scl2 = realzero
           ssq2 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           normsq2 = scl1**2*ssq1 + scl2**2*ssq2
           ! if second projection is sufficiently large in norm, then do
           ! nothing more. alternatively, if it shrunk significantly, then
           ! truncate it to zero.
           if (normsq2 < alphasq*normsq1) then
              do i = 1,m1
                 x1(i) = zero
              end do
              do i = 1,m2
                 x2(i) = zero
              end do
           end if
           return
     end subroutine la_${ri}$orbdb6
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$BBCSD: computes the CS decomposition of an orthogonal matrix in
     !> bidiagonal-block form,
     !> [ B11 | B12 0  0 ]
     !> [  0  |  0 -I  0 ]
     !> X = [----------------]
     !> [ B21 | B22 0  0 ]
     !> [  0  |  0  0  I ]
     !> [  C | -S  0  0 ]
     !> [ U1 |    ] [  0 |  0 -I  0 ] [ V1 |    ]**T
     !> = [---------] [---------------] [---------]   .
     !> [    | U2 ] [  S |  C  0  0 ] [    | V2 ]
     !> [  0 |  0  0  I ]
     !> X is M-by-M, its top-left block is P-by-Q, and Q must be no larger
     !> than P, M-P, or M-Q. (If Q is not the smallest index, then X must be
     !> transposed and/or permuted. This can be done in constant time using
     !> the TRANS and SIGNS options. See ${ri.upper()}$ORCSD for details.)
     !> The bidiagonal matrices B11, B12, B21, and B22 are represented
     !> implicitly by angles THETA(1:Q) and PHI(1:Q-1).
     !> The orthogonal matrices U1, U2, V1T, and V2T are input/output.
     !> The input matrices are pre- or post-multiplied by the appropriate
     !> singular vector matrices.

     pure subroutine la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,theta,phi,u1, &
     ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,b11d,b11e,b12d,b12e,b21d,b21e,b22d,b22e,work, &
               lwork,info)
        use la_constants_${rk}$,only:negone,zero,one,ten
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu1,jobu2,jobv1t,jobv2t,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldu1,ldu2,ldv1t,ldv2t,lwork,m,p,q
           ! Array Arguments
           real(${rk}$),intent(out) :: b11d(*),b11e(*),b12d(*),b12e(*),b21d(*),b21e(*),b22d(*), &
                      b22e(*),work(*)
           real(${rk}$),intent(inout) :: phi(*),theta(*)
           real(${rk}$),intent(inout) :: u1(ldu1,*),u2(ldu2,*),v1t(ldv1t,*),v2t(ldv2t,*)
        ! ===================================================================
           ! Parameters
           integer(ilp),parameter :: maxitr = 6
           real(${rk}$),parameter :: hundred = 100.0_${rk}$
           real(${rk}$),parameter :: meighth = -0.125_${rk}$
           real(${rk}$),parameter :: piover2 = 1.57079632679489661923132169163975144210_${rk}$

           ! Local Scalars
           logical(lk) :: colmajor,lquery,restart11,restart12,restart21,restart22,wantu1, &
                     wantu2,wantv1t,wantv2t
           integer(ilp) :: i,imin,imax,iter,iu1cs,iu1sn,iu2cs,iu2sn,iv1tcs,iv1tsn, &
                     iv2tcs,iv2tsn,j,lworkmin,lworkopt,maxit,mini
           real(${rk}$) :: b11bulge,b12bulge,b21bulge,b22bulge,dummy,eps,mu,nu,r,sigma11, &
                     sigma21,temp,thetamax,thetamin,thresh,tol,tolmul,unfl,x1,x2,y1,y2
           ! Intrinsic Functions
           intrinsic :: abs,atan2,cos,max,min,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           wantu1 = la_lsame(jobu1,'Y')
           wantu2 = la_lsame(jobu2,'Y')
           wantv1t = la_lsame(jobv1t,'Y')
           wantv2t = la_lsame(jobv2t,'Y')
           colmajor = .not. la_lsame(trans,'T')
           if (m < 0) then
              info = -6
           else if (p < 0 .or. p > m) then
              info = -7
           else if (q < 0 .or. q > m) then
              info = -8
           else if (q > p .or. q > m - p .or. q > m - q) then
              info = -8
           else if (wantu1 .and. ldu1 < p) then
              info = -12
           else if (wantu2 .and. ldu2 < m - p) then
              info = -14
           else if (wantv1t .and. ldv1t < q) then
              info = -16
           else if (wantv2t .and. ldv2t < m - q) then
              info = -18
           end if
           ! quick return if q = 0
           if (info == 0 .and. q == 0) then
              lworkmin = 1
              work(1) = lworkmin
              return
           end if
           ! compute workspace
           if (info == 0) then
              iu1cs = 1
              iu1sn = iu1cs + q
              iu2cs = iu1sn + q
              iu2sn = iu2cs + q
              iv1tcs = iu2sn + q
              iv1tsn = iv1tcs + q
              iv2tcs = iv1tsn + q
              iv2tsn = iv2tcs + q
              lworkopt = iv2tsn + q - 1
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                 info = -28
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$BBCSD',-info)
              return
           else if (lquery) then
              return
           end if
           ! get machine constants
           eps = la_${ri}$lamch('EPSILON')
           unfl = la_${ri}$lamch('SAFE MINIMUM')
           tolmul = max(ten,min(hundred,eps**meighth))
           tol = tolmul*eps
           thresh = max(tol,maxitr*q*q*unfl)
           ! test for negligible sines or cosines
           do i = 1,q
              if (theta(i) < thresh) then
                 theta(i) = zero
              else if (theta(i) > piover2 - thresh) then
                 theta(i) = piover2
              end if
           end do
           do i = 1,q - 1
              if (phi(i) < thresh) then
                 phi(i) = zero
              else if (phi(i) > piover2 - thresh) then
                 phi(i) = piover2
              end if
           end do
           ! initial deflation
           imax = q
           do while (imax > 1)
              if (phi(imax - 1) /= zero) then
                 exit
              end if
              imax = imax - 1
           end do
           imin = imax - 1
           if (imin > 1) then
              do while (phi(imin - 1) /= zero)
                 imin = imin - 1
                 if (imin <= 1) exit
              end do
           end if
           ! initialize iteration counter
           maxit = maxitr*q*q
           iter = 0
           ! begin main iteration loop
           do while (imax > 1)
              ! compute the matrix entries
              b11d(imin) = cos(theta(imin))
              b21d(imin) = -sin(theta(imin))
              do i = imin,imax - 1
                 b11e(i) = -sin(theta(i))*sin(phi(i))
                 b11d(i + 1) = cos(theta(i + 1))*cos(phi(i))
                 b12d(i) = sin(theta(i))*cos(phi(i))
                 b12e(i) = cos(theta(i + 1))*sin(phi(i))
                 b21e(i) = -cos(theta(i))*sin(phi(i))
                 b21d(i + 1) = -sin(theta(i + 1))*cos(phi(i))
                 b22d(i) = cos(theta(i))*cos(phi(i))
                 b22e(i) = -sin(theta(i + 1))*sin(phi(i))
              end do
              b12d(imax) = sin(theta(imax))
              b22d(imax) = cos(theta(imax))
              ! abort if not converging; otherwise, increment iter
              if (iter > maxit) then
                 info = 0
                 do i = 1,q
                    if (phi(i) /= zero) info = info + 1
                 end do
                 return
              end if
              iter = iter + imax - imin
              ! compute shifts
              thetamax = theta(imin)
              thetamin = theta(imin)
              do i = imin + 1,imax
                 if (theta(i) > thetamax) thetamax = theta(i)
                 if (theta(i) < thetamin) thetamin = theta(i)
              end do
              if (thetamax > piover2 - thresh) then
                 ! zero on diagonals of b11 and b22; induce deflation with a
                 ! zero shift
                 mu = zero
                 nu = one
              else if (thetamin < thresh) then
                 ! zero on diagonals of b12 and b22; induce deflation with a
                 ! zero shift
                 mu = one
                 nu = zero
              else
                 ! compute shifts for b11 and b21 and use the lesser
                 call la_${ri}$las2(b11d(imax - 1),b11e(imax - 1),b11d(imax),sigma11,dummy)

                 call la_${ri}$las2(b21d(imax - 1),b21e(imax - 1),b21d(imax),sigma21,dummy)

                 if (sigma11 <= sigma21) then
                    mu = sigma11
                    nu = sqrt(one - mu**2)
                    if (mu < thresh) then
                       mu = zero
                       nu = one
                    end if
                 else
                    nu = sigma21
                    mu = sqrt(1.0_${rk}$ - nu**2)
                    if (nu < thresh) then
                       mu = one
                       nu = zero
                    end if
                 end if
              end if
              ! rotate to produce bulges in b11 and b21
              if (mu <= nu) then
                 call la_${ri}$lartgs(b11d(imin),b11e(imin),mu,work(iv1tcs + imin - 1),work(iv1tsn + &
                           imin - 1))
              else
                 call la_${ri}$lartgs(b21d(imin),b21e(imin),nu,work(iv1tcs + imin - 1),work(iv1tsn + &
                           imin - 1))
              end if
              temp = work(iv1tcs + imin - 1)*b11d(imin) + work(iv1tsn + imin - 1)*b11e(imin)
              b11e(imin) = work(iv1tcs + imin - 1)*b11e(imin) - work(iv1tsn + imin - 1)*b11d(imin)
              b11d(imin) = temp
              b11bulge = work(iv1tsn + imin - 1)*b11d(imin + 1)
              b11d(imin + 1) = work(iv1tcs + imin - 1)*b11d(imin + 1)
              temp = work(iv1tcs + imin - 1)*b21d(imin) + work(iv1tsn + imin - 1)*b21e(imin)
              b21e(imin) = work(iv1tcs + imin - 1)*b21e(imin) - work(iv1tsn + imin - 1)*b21d(imin)
              b21d(imin) = temp
              b21bulge = work(iv1tsn + imin - 1)*b21d(imin + 1)
              b21d(imin + 1) = work(iv1tcs + imin - 1)*b21d(imin + 1)
              ! compute theta(imin)
              theta(imin) = atan2(sqrt(b21d(imin)**2 + b21bulge**2),sqrt(b11d(imin)**2 + &
                        b11bulge**2))
              ! chase the bulges in b11(imin+1,imin) and b21(imin+1,imin)
              if (b11d(imin)**2 + b11bulge**2 > thresh**2) then
                 call la_${ri}$lartgp(b11bulge,b11d(imin),work(iu1sn + imin - 1),work(iu1cs + imin - 1), &
                            r)
              else if (mu <= nu) then
                 call la_${ri}$lartgs(b11e(imin),b11d(imin + 1),mu,work(iu1cs + imin - 1),work( &
                           iu1sn + imin - 1))
              else
                 call la_${ri}$lartgs(b12d(imin),b12e(imin),nu,work(iu1cs + imin - 1),work( &
                           iu1sn + imin - 1))
              end if
              if (b21d(imin)**2 + b21bulge**2 > thresh**2) then
                 call la_${ri}$lartgp(b21bulge,b21d(imin),work(iu2sn + imin - 1),work(iu2cs + imin - 1), &
                            r)
              else if (nu < mu) then
                 call la_${ri}$lartgs(b21e(imin),b21d(imin + 1),nu,work(iu2cs + imin - 1),work( &
                           iu2sn + imin - 1))
              else
                 call la_${ri}$lartgs(b22d(imin),b22e(imin),mu,work(iu2cs + imin - 1),work(iu2sn + &
                           imin - 1))
              end if
              work(iu2cs + imin - 1) = -work(iu2cs + imin - 1)
              work(iu2sn + imin - 1) = -work(iu2sn + imin - 1)
              temp = work(iu1cs + imin - 1)*b11e(imin) + work(iu1sn + imin - 1)*b11d(imin + 1)
              b11d(imin + 1) = work(iu1cs + imin - 1)*b11d(imin + 1) - work(iu1sn + imin - 1)*b11e(imin)

              b11e(imin) = temp
              if (imax > imin + 1) then
                 b11bulge = work(iu1sn + imin - 1)*b11e(imin + 1)
                 b11e(imin + 1) = work(iu1cs + imin - 1)*b11e(imin + 1)
              end if
              temp = work(iu1cs + imin - 1)*b12d(imin) + work(iu1sn + imin - 1)*b12e(imin)
              b12e(imin) = work(iu1cs + imin - 1)*b12e(imin) - work(iu1sn + imin - 1)*b12d(imin)
              b12d(imin) = temp
              b12bulge = work(iu1sn + imin - 1)*b12d(imin + 1)
              b12d(imin + 1) = work(iu1cs + imin - 1)*b12d(imin + 1)
              temp = work(iu2cs + imin - 1)*b21e(imin) + work(iu2sn + imin - 1)*b21d(imin + 1)
              b21d(imin + 1) = work(iu2cs + imin - 1)*b21d(imin + 1) - work(iu2sn + imin - 1)*b21e(imin)

              b21e(imin) = temp
              if (imax > imin + 1) then
                 b21bulge = work(iu2sn + imin - 1)*b21e(imin + 1)
                 b21e(imin + 1) = work(iu2cs + imin - 1)*b21e(imin + 1)
              end if
              temp = work(iu2cs + imin - 1)*b22d(imin) + work(iu2sn + imin - 1)*b22e(imin)
              b22e(imin) = work(iu2cs + imin - 1)*b22e(imin) - work(iu2sn + imin - 1)*b22d(imin)
              b22d(imin) = temp
              b22bulge = work(iu2sn + imin - 1)*b22d(imin + 1)
              b22d(imin + 1) = work(iu2cs + imin - 1)*b22d(imin + 1)
              ! inner loop: chase bulges from b11(imin,imin+2),
              ! b12(imin,imin+1), b21(imin,imin+2), and b22(imin,imin+1) to
              ! bottom-right
              do i = imin + 1,imax - 1
                 ! compute phi(i-1)
                 x1 = sin(theta(i - 1))*b11e(i - 1) + cos(theta(i - 1))*b21e(i - 1)
                 x2 = sin(theta(i - 1))*b11bulge + cos(theta(i - 1))*b21bulge
                 y1 = sin(theta(i - 1))*b12d(i - 1) + cos(theta(i - 1))*b22d(i - 1)
                 y2 = sin(theta(i - 1))*b12bulge + cos(theta(i - 1))*b22bulge
                 phi(i - 1) = atan2(sqrt(x1**2 + x2**2),sqrt(y1**2 + y2**2))
                 ! determine if there are bulges to chase or if a new direct
                 ! summand has been reached
                 restart11 = b11e(i - 1)**2 + b11bulge**2 <= thresh**2
                 restart21 = b21e(i - 1)**2 + b21bulge**2 <= thresh**2
                 restart12 = b12d(i - 1)**2 + b12bulge**2 <= thresh**2
                 restart22 = b22d(i - 1)**2 + b22bulge**2 <= thresh**2
                 ! if possible, chase bulges from b11(i-1,i+1), b12(i-1,i),
                 ! b21(i-1,i+1), and b22(i-1,i). if necessary, restart bulge-
                 ! chasing by applying the original shift again.
                 if (.not. restart11 .and. .not. restart21) then
                    call la_${ri}$lartgp(x2,x1,work(iv1tsn + i - 1),work(iv1tcs + i - 1),r)
                 else if (.not. restart11 .and. restart21) then
                    call la_${ri}$lartgp(b11bulge,b11e(i - 1),work(iv1tsn + i - 1),work(iv1tcs + i - 1), &
                              r)
                 else if (restart11 .and. .not. restart21) then
                    call la_${ri}$lartgp(b21bulge,b21e(i - 1),work(iv1tsn + i - 1),work(iv1tcs + i - 1), &
                              r)
                 else if (mu <= nu) then
                    call la_${ri}$lartgs(b11d(i),b11e(i),mu,work(iv1tcs + i - 1),work(iv1tsn + i - 1))

                 else
                    call la_${ri}$lartgs(b21d(i),b21e(i),nu,work(iv1tcs + i - 1),work(iv1tsn + i - 1))

                 end if
                 work(iv1tcs + i - 1) = -work(iv1tcs + i - 1)
                 work(iv1tsn + i - 1) = -work(iv1tsn + i - 1)
                 if (.not. restart12 .and. .not. restart22) then
                    call la_${ri}$lartgp(y2,y1,work(iv2tsn + i - 1 - 1),work(iv2tcs + i - 1 - 1),r)

                 else if (.not. restart12 .and. restart22) then
                    call la_${ri}$lartgp(b12bulge,b12d(i - 1),work(iv2tsn + i - 1 - 1),work(iv2tcs + i - 1 - &
                              1),r)
                 else if (restart12 .and. .not. restart22) then
                    call la_${ri}$lartgp(b22bulge,b22d(i - 1),work(iv2tsn + i - 1 - 1),work(iv2tcs + i - 1 - &
                              1),r)
                 else if (nu < mu) then
                    call la_${ri}$lartgs(b12e(i - 1),b12d(i),nu,work(iv2tcs + i - 1 - 1),work(iv2tsn + i - &
                              1 - 1))
                 else
                    call la_${ri}$lartgs(b22e(i - 1),b22d(i),mu,work(iv2tcs + i - 1 - 1),work(iv2tsn + i - &
                              1 - 1))
                 end if
                 temp = work(iv1tcs + i - 1)*b11d(i) + work(iv1tsn + i - 1)*b11e(i)
                 b11e(i) = work(iv1tcs + i - 1)*b11e(i) - work(iv1tsn + i - 1)*b11d(i)
                 b11d(i) = temp
                 b11bulge = work(iv1tsn + i - 1)*b11d(i + 1)
                 b11d(i + 1) = work(iv1tcs + i - 1)*b11d(i + 1)
                 temp = work(iv1tcs + i - 1)*b21d(i) + work(iv1tsn + i - 1)*b21e(i)
                 b21e(i) = work(iv1tcs + i - 1)*b21e(i) - work(iv1tsn + i - 1)*b21d(i)
                 b21d(i) = temp
                 b21bulge = work(iv1tsn + i - 1)*b21d(i + 1)
                 b21d(i + 1) = work(iv1tcs + i - 1)*b21d(i + 1)
                 temp = work(iv2tcs + i - 1 - 1)*b12e(i - 1) + work(iv2tsn + i - 1 - 1)*b12d(i)
                 b12d(i) = work(iv2tcs + i - 1 - 1)*b12d(i) - work(iv2tsn + i - 1 - 1)*b12e(i - 1)
                 b12e(i - 1) = temp
                 b12bulge = work(iv2tsn + i - 1 - 1)*b12e(i)
                 b12e(i) = work(iv2tcs + i - 1 - 1)*b12e(i)
                 temp = work(iv2tcs + i - 1 - 1)*b22e(i - 1) + work(iv2tsn + i - 1 - 1)*b22d(i)
                 b22d(i) = work(iv2tcs + i - 1 - 1)*b22d(i) - work(iv2tsn + i - 1 - 1)*b22e(i - 1)
                 b22e(i - 1) = temp
                 b22bulge = work(iv2tsn + i - 1 - 1)*b22e(i)
                 b22e(i) = work(iv2tcs + i - 1 - 1)*b22e(i)
                 ! compute theta(i)
                 x1 = cos(phi(i - 1))*b11d(i) + sin(phi(i - 1))*b12e(i - 1)
                 x2 = cos(phi(i - 1))*b11bulge + sin(phi(i - 1))*b12bulge
                 y1 = cos(phi(i - 1))*b21d(i) + sin(phi(i - 1))*b22e(i - 1)
                 y2 = cos(phi(i - 1))*b21bulge + sin(phi(i - 1))*b22bulge
                 theta(i) = atan2(sqrt(y1**2 + y2**2),sqrt(x1**2 + x2**2))
                 ! determine if there are bulges to chase or if a new direct
                 ! summand has been reached
                 restart11 = b11d(i)**2 + b11bulge**2 <= thresh**2
                 restart12 = b12e(i - 1)**2 + b12bulge**2 <= thresh**2
                 restart21 = b21d(i)**2 + b21bulge**2 <= thresh**2
                 restart22 = b22e(i - 1)**2 + b22bulge**2 <= thresh**2
                 ! if possible, chase bulges from b11(i+1,i), b12(i+1,i-1),
                 ! b21(i+1,i), and b22(i+1,i-1). if necessary, restart bulge-
                 ! chasing by applying the original shift again.
                 if (.not. restart11 .and. .not. restart12) then
                    call la_${ri}$lartgp(x2,x1,work(iu1sn + i - 1),work(iu1cs + i - 1),r)
                 else if (.not. restart11 .and. restart12) then
                    call la_${ri}$lartgp(b11bulge,b11d(i),work(iu1sn + i - 1),work(iu1cs + i - 1),r)

                 else if (restart11 .and. .not. restart12) then
                    call la_${ri}$lartgp(b12bulge,b12e(i - 1),work(iu1sn + i - 1),work(iu1cs + i - 1),r)

                 else if (mu <= nu) then
                    call la_${ri}$lartgs(b11e(i),b11d(i + 1),mu,work(iu1cs + i - 1),work(iu1sn + i - 1))

                 else
                    call la_${ri}$lartgs(b12d(i),b12e(i),nu,work(iu1cs + i - 1),work(iu1sn + i - 1))

                 end if
                 if (.not. restart21 .and. .not. restart22) then
                    call la_${ri}$lartgp(y2,y1,work(iu2sn + i - 1),work(iu2cs + i - 1),r)
                 else if (.not. restart21 .and. restart22) then
                    call la_${ri}$lartgp(b21bulge,b21d(i),work(iu2sn + i - 1),work(iu2cs + i - 1),r)

                 else if (restart21 .and. .not. restart22) then
                    call la_${ri}$lartgp(b22bulge,b22e(i - 1),work(iu2sn + i - 1),work(iu2cs + i - 1),r)

                 else if (nu < mu) then
                    call la_${ri}$lartgs(b21e(i),b21e(i + 1),nu,work(iu2cs + i - 1),work(iu2sn + i - 1))

                 else
                    call la_${ri}$lartgs(b22d(i),b22e(i),mu,work(iu2cs + i - 1),work(iu2sn + i - 1))

                 end if
                 work(iu2cs + i - 1) = -work(iu2cs + i - 1)
                 work(iu2sn + i - 1) = -work(iu2sn + i - 1)
                 temp = work(iu1cs + i - 1)*b11e(i) + work(iu1sn + i - 1)*b11d(i + 1)
                 b11d(i + 1) = work(iu1cs + i - 1)*b11d(i + 1) - work(iu1sn + i - 1)*b11e(i)
                 b11e(i) = temp
                 if (i < imax - 1) then
                    b11bulge = work(iu1sn + i - 1)*b11e(i + 1)
                    b11e(i + 1) = work(iu1cs + i - 1)*b11e(i + 1)
                 end if
                 temp = work(iu2cs + i - 1)*b21e(i) + work(iu2sn + i - 1)*b21d(i + 1)
                 b21d(i + 1) = work(iu2cs + i - 1)*b21d(i + 1) - work(iu2sn + i - 1)*b21e(i)
                 b21e(i) = temp
                 if (i < imax - 1) then
                    b21bulge = work(iu2sn + i - 1)*b21e(i + 1)
                    b21e(i + 1) = work(iu2cs + i - 1)*b21e(i + 1)
                 end if
                 temp = work(iu1cs + i - 1)*b12d(i) + work(iu1sn + i - 1)*b12e(i)
                 b12e(i) = work(iu1cs + i - 1)*b12e(i) - work(iu1sn + i - 1)*b12d(i)
                 b12d(i) = temp
                 b12bulge = work(iu1sn + i - 1)*b12d(i + 1)
                 b12d(i + 1) = work(iu1cs + i - 1)*b12d(i + 1)
                 temp = work(iu2cs + i - 1)*b22d(i) + work(iu2sn + i - 1)*b22e(i)
                 b22e(i) = work(iu2cs + i - 1)*b22e(i) - work(iu2sn + i - 1)*b22d(i)
                 b22d(i) = temp
                 b22bulge = work(iu2sn + i - 1)*b22d(i + 1)
                 b22d(i + 1) = work(iu2cs + i - 1)*b22d(i + 1)
              end do
              ! compute phi(imax-1)
              x1 = sin(theta(imax - 1))*b11e(imax - 1) + cos(theta(imax - 1))*b21e(imax - 1)
              y1 = sin(theta(imax - 1))*b12d(imax - 1) + cos(theta(imax - 1))*b22d(imax - 1)
              y2 = sin(theta(imax - 1))*b12bulge + cos(theta(imax - 1))*b22bulge
              phi(imax - 1) = atan2(abs(x1),sqrt(y1**2 + y2**2))
              ! chase bulges from b12(imax-1,imax) and b22(imax-1,imax)
              restart12 = b12d(imax - 1)**2 + b12bulge**2 <= thresh**2
              restart22 = b22d(imax - 1)**2 + b22bulge**2 <= thresh**2
              if (.not. restart12 .and. .not. restart22) then
                 call la_${ri}$lartgp(y2,y1,work(iv2tsn + imax - 1 - 1),work(iv2tcs + imax - 1 - 1),r)

              else if (.not. restart12 .and. restart22) then
                 call la_${ri}$lartgp(b12bulge,b12d(imax - 1),work(iv2tsn + imax - 1 - 1),work(iv2tcs + &
                           imax - 1 - 1),r)
              else if (restart12 .and. .not. restart22) then
                 call la_${ri}$lartgp(b22bulge,b22d(imax - 1),work(iv2tsn + imax - 1 - 1),work(iv2tcs + &
                           imax - 1 - 1),r)
              else if (nu < mu) then
                 call la_${ri}$lartgs(b12e(imax - 1),b12d(imax),nu,work(iv2tcs + imax - 1 - 1),work( &
                           iv2tsn + imax - 1 - 1))
              else
                 call la_${ri}$lartgs(b22e(imax - 1),b22d(imax),mu,work(iv2tcs + imax - 1 - 1),work( &
                           iv2tsn + imax - 1 - 1))
              end if
              temp = work(iv2tcs + imax - 1 - 1)*b12e(imax - 1) + work(iv2tsn + imax - 1 - 1)*b12d(imax)
              b12d(imax) = work(iv2tcs + imax - 1 - 1)*b12d(imax) - work(iv2tsn + imax - 1 - 1)*b12e(imax - 1)

              b12e(imax - 1) = temp
              temp = work(iv2tcs + imax - 1 - 1)*b22e(imax - 1) + work(iv2tsn + imax - 1 - 1)*b22d(imax)
              b22d(imax) = work(iv2tcs + imax - 1 - 1)*b22d(imax) - work(iv2tsn + imax - 1 - 1)*b22e(imax - 1)

              b22e(imax - 1) = temp
              ! update singular vectors
              if (wantu1) then
                 if (colmajor) then
                    call la_${ri}$lasr('R','V','F',p,imax - imin + 1,work(iu1cs + imin - 1),work( &
                              iu1sn + imin - 1),u1(1,imin),ldu1)
                 else
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,p,work(iu1cs + imin - 1),work( &
                              iu1sn + imin - 1),u1(imin,1),ldu1)
                 end if
              end if
              if (wantu2) then
                 if (colmajor) then
                    call la_${ri}$lasr('R','V','F',m - p,imax - imin + 1,work(iu2cs + imin - 1),work( &
                              iu2sn + imin - 1),u2(1,imin),ldu2)
                 else
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,m - p,work(iu2cs + imin - 1),work( &
                              iu2sn + imin - 1),u2(imin,1),ldu2)
                 end if
              end if
              if (wantv1t) then
                 if (colmajor) then
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,q,work(iv1tcs + imin - 1),work( &
                              iv1tsn + imin - 1),v1t(imin,1),ldv1t)
                 else
                    call la_${ri}$lasr('R','V','F',q,imax - imin + 1,work(iv1tcs + imin - 1),work( &
                              iv1tsn + imin - 1),v1t(1,imin),ldv1t)
                 end if
              end if
              if (wantv2t) then
                 if (colmajor) then
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,m - q,work(iv2tcs + imin - 1),work( &
                              iv2tsn + imin - 1),v2t(imin,1),ldv2t)
                 else
                    call la_${ri}$lasr('R','V','F',m - q,imax - imin + 1,work(iv2tcs + imin - 1),work( &
                              iv2tsn + imin - 1),v2t(1,imin),ldv2t)
                 end if
              end if
              ! fix signs on b11(imax-1,imax) and b21(imax-1,imax)
              if (b11e(imax - 1) + b21e(imax - 1) > 0) then
                 b11d(imax) = -b11d(imax)
                 b21d(imax) = -b21d(imax)
                 if (wantv1t) then
                    if (colmajor) then
                       call la_${ri}$scal(q,negone,v1t(imax,1),ldv1t)
                    else
                       call la_${ri}$scal(q,negone,v1t(1,imax),1)
                    end if
                 end if
              end if
              ! compute theta(imax)
              x1 = cos(phi(imax - 1))*b11d(imax) + sin(phi(imax - 1))*b12e(imax - 1)
              y1 = cos(phi(imax - 1))*b21d(imax) + sin(phi(imax - 1))*b22e(imax - 1)
              theta(imax) = atan2(abs(y1),abs(x1))
              ! fix signs on b11(imax,imax), b12(imax,imax-1), b21(imax,imax),
              ! and b22(imax,imax-1)
              if (b11d(imax) + b12e(imax - 1) < 0) then
                 b12d(imax) = -b12d(imax)
                 if (wantu1) then
                    if (colmajor) then
                       call la_${ri}$scal(p,negone,u1(1,imax),1)
                    else
                       call la_${ri}$scal(p,negone,u1(imax,1),ldu1)
                    end if
                 end if
              end if
              if (b21d(imax) + b22e(imax - 1) > 0) then
                 b22d(imax) = -b22d(imax)
                 if (wantu2) then
                    if (colmajor) then
                       call la_${ri}$scal(m - p,negone,u2(1,imax),1)
                    else
                       call la_${ri}$scal(m - p,negone,u2(imax,1),ldu2)
                    end if
                 end if
              end if
              ! fix signs on b12(imax,imax) and b22(imax,imax)
              if (b12d(imax) + b22d(imax) < 0) then
                 if (wantv2t) then
                    if (colmajor) then
                       call la_${ri}$scal(m - q,negone,v2t(imax,1),ldv2t)
                    else
                       call la_${ri}$scal(m - q,negone,v2t(1,imax),1)
                    end if
                 end if
              end if
              ! test for negligible sines or cosines
              do i = imin,imax
                 if (theta(i) < thresh) then
                    theta(i) = zero
                 else if (theta(i) > piover2 - thresh) then
                    theta(i) = piover2
                 end if
              end do
              do i = imin,imax - 1
                 if (phi(i) < thresh) then
                    phi(i) = zero
                 else if (phi(i) > piover2 - thresh) then
                    phi(i) = piover2
                 end if
              end do
              ! deflate
              if (imax > 1) then
                 do while (phi(imax - 1) == zero)
                    imax = imax - 1
                    if (imax <= 1) exit
                 end do
              end if
              if (imin > imax - 1) imin = imax - 1
              if (imin > 1) then
                 do while (phi(imin - 1) /= zero)
                     imin = imin - 1
                     if (imin <= 1) exit
                 end do
              end if
              ! repeat main iteration loop
           end do
           ! postprocessing: order theta from least to greatest
           do i = 1,q
              mini = i
              thetamin = theta(i)
              do j = i + 1,q
                 if (theta(j) < thetamin) then
                    mini = j
                    thetamin = theta(j)
                 end if
              end do
              if (mini /= i) then
                 theta(mini) = theta(i)
                 theta(i) = thetamin
                 if (colmajor) then
                    if (wantu1) call la_${ri}$swap(p,u1(1,i),1,u1(1,mini),1)
                    if (wantu2) call la_${ri}$swap(m - p,u2(1,i),1,u2(1,mini),1)
                    if (wantv1t) call la_${ri}$swap(q,v1t(i,1),ldv1t,v1t(mini,1),ldv1t)

                    if (wantv2t) call la_${ri}$swap(m - q,v2t(i,1),ldv2t,v2t(mini,1),ldv2t)

                 else
                    if (wantu1) call la_${ri}$swap(p,u1(i,1),ldu1,u1(mini,1),ldu1)
                    if (wantu2) call la_${ri}$swap(m - p,u2(i,1),ldu2,u2(mini,1),ldu2)
                    if (wantv1t) call la_${ri}$swap(q,v1t(1,i),1,v1t(1,mini),1)
                    if (wantv2t) call la_${ri}$swap(m - q,v2t(1,i),1,v2t(1,mini),1)
                 end if
              end if
           end do
           return
     end subroutine la_${ri}$bbcsd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB: simultaneously bidiagonalizes the blocks of an M-by-M
     !> partitioned orthogonal matrix X:
     !> [ B11 | B12 0  0 ]
     !> [ X11 | X12 ]   [ P1 |    ] [  0  |  0 -I  0 ] [ Q1 |    ]**T
     !> X = [-----------] = [---------] [----------------] [---------]   .
     !> [ X21 | X22 ]   [    | P2 ] [ B21 | B22 0  0 ] [    | Q2 ]
     !> [  0  |  0  0  I ]
     !> X11 is P-by-Q. Q must be no larger than P, M-P, or M-Q. (If this is
     !> not the case, then X must be transposed and/or permuted. This can be
     !> done in constant time using the TRANS and SIGNS options. See ${ri.upper()}$ORCSD
     !> for details.)
     !> The orthogonal matrices P1, P2, Q1, and Q2 are P-by-P, (M-P)-by-
     !> (M-P), Q-by-Q, and (M-Q)-by-(M-Q), respectively. They are
     !> represented implicitly by Householder vectors.
     !> B11, B12, B21, and B22 are Q-by-Q bidiagonal matrices represented
     !> implicitly by angles THETA, PHI.

     subroutine la_${ri}$orbdb(trans,signs,m,p,q,x11,ldx11,x12,ldx12,x21,ldx21,x22, &
               ldx22,theta,phi,taup1,taup2,tauq1,tauq2,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: signs,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldx11,ldx12,ldx21,ldx22,lwork,m,p,q
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           real(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),tauq2(*),work(*)
           real(${rk}$),intent(inout) :: x11(ldx11,*),x12(ldx12,*),x21(ldx21,*),x22(ldx22,*)

        ! ====================================================================
           ! Parameters
           real(${rk}$),parameter :: realone = 1.0_${rk}$

           ! Local Scalars
           logical(lk) :: colmajor,lquery
           integer(ilp) :: i,lworkmin,lworkopt
           real(${rk}$) :: z1,z2,z3,z4
           ! Intrinsic Functions
           intrinsic :: atan2,cos,max,sin
           ! Executable Statements
           ! test input arguments
           info = 0
           colmajor = .not. la_lsame(trans,'T')
           if (.not. la_lsame(signs,'O')) then
              z1 = realone
              z2 = realone
              z3 = realone
              z4 = realone
           else
              z1 = realone
              z2 = -realone
              z3 = realone
              z4 = -realone
           end if
           lquery = lwork == -1
           if (m < 0) then
              info = -3
           else if (p < 0 .or. p > m) then
              info = -4
           else if (q < 0 .or. q > p .or. q > m - p .or. q > m - q) then
              info = -5
           else if (colmajor .and. ldx11 < max(1,p)) then
              info = -7
           else if (.not. colmajor .and. ldx11 < max(1,q)) then
              info = -7
           else if (colmajor .and. ldx12 < max(1,p)) then
              info = -9
           else if (.not. colmajor .and. ldx12 < max(1,m - q)) then
              info = -9
           else if (colmajor .and. ldx21 < max(1,m - p)) then
              info = -11
           else if (.not. colmajor .and. ldx21 < max(1,q)) then
              info = -11
           else if (colmajor .and. ldx22 < max(1,m - p)) then
              info = -13
           else if (.not. colmajor .and. ldx22 < max(1,m - q)) then
              info = -13
           end if
           ! compute workspace
           if (info == 0) then
              lworkopt = m - q
              lworkmin = m - q
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                 info = -21
              end if
           end if
           if (info /= 0) then
              call la_xerbla('XORBDB',-info)
              return
           else if (lquery) then
              return
           end if
           ! handle column-major and row-major separately
           if (colmajor) then
              ! reduce columns 1, ..., q of x11, x12, x21, and x22
              do i = 1,q
                 if (i == 1) then
                    call la_${ri}$scal(p - i + 1,z1,x11(i,i),1)
                 else
                    call la_${ri}$scal(p - i + 1,z1*cos(phi(i - 1)),x11(i,i),1)
                    call la_${ri}$axpy(p - i + 1,-z1*z3*z4*sin(phi(i - 1)),x12(i,i - 1),1,x11(i,i),1)

                 end if
                 if (i == 1) then
                    call la_${ri}$scal(m - p - i + 1,z2,x21(i,i),1)
                 else
                    call la_${ri}$scal(m - p - i + 1,z2*cos(phi(i - 1)),x21(i,i),1)
                    call la_${ri}$axpy(m - p - i + 1,-z2*z3*z4*sin(phi(i - 1)),x22(i,i - 1),1,x21(i,i), &
                              1)
                 end if
                 theta(i) = atan2(la_${ri}$nrm2(m - p - i + 1,x21(i,i),1),la_${ri}$nrm2(p - i + 1,x11( &
                           i,i),1))
                 if (p > i) then
                    call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
                 else if (p == i) then
                    call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i,i),1,taup1(i))
                 end if
                 x11(i,i) = one
                 if (m - p > i) then
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
                 else if (m - p == i) then
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i,i),1,taup2(i))
                 end if
                 x21(i,i) = one
                 if (q > i) then
                    call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,taup1(i),x11(i,i + 1),ldx11, &
                              work)
                 end if
                 if (m - q + 1 > i) then
                    call la_${ri}$larf('L',p - i + 1,m - q - i + 1,x11(i,i),1,taup1(i),x12(i,i),ldx12, &
                               work)
                 end if
                 if (q > i) then
                    call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,taup2(i),x21(i,i + 1),ldx21, &
                               work)
                 end if
                 if (m - q + 1 > i) then
                    call la_${ri}$larf('L',m - p - i + 1,m - q - i + 1,x21(i,i),1,taup2(i),x22(i,i), &
                              ldx22,work)
                 end if
                 if (i < q) then
                    call la_${ri}$scal(q - i,-z1*z3*sin(theta(i)),x11(i,i + 1),ldx11)
                    call la_${ri}$axpy(q - i,z2*z3*cos(theta(i)),x21(i,i + 1),ldx21,x11(i,i + 1), &
                              ldx11)
                 end if
                 call la_${ri}$scal(m - q - i + 1,-z1*z4*sin(theta(i)),x12(i,i),ldx12)
                 call la_${ri}$axpy(m - q - i + 1,z2*z4*cos(theta(i)),x22(i,i),ldx22,x12(i,i),ldx12 &
                           )
                 if (i < q) phi(i) = atan2(la_${ri}$nrm2(q - i,x11(i,i + 1),ldx11),la_${ri}$nrm2( &
                           m - q - i + 1,x12(i,i),ldx12))
                 if (i < q) then
                    if (q - i == 1) then
                       call la_${ri}$larfgp(q - i,x11(i,i + 1),x11(i,i + 1),ldx11,tauq1(i))
                    else
                       call la_${ri}$larfgp(q - i,x11(i,i + 1),x11(i,i + 2),ldx11,tauq1(i))
                    end if
                    x11(i,i + 1) = one
                 end if
                 if (q + i - 1 < m) then
                    if (m - q == i) then
                       call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i),ldx12,tauq2(i))
                    else
                       call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i + 1),ldx12,tauq2(i))

                    end if
                 end if
                 x12(i,i) = one
                 if (i < q) then
                    call la_${ri}$larf('R',p - i,q - i,x11(i,i + 1),ldx11,tauq1(i),x11(i + 1,i + 1), &
                              ldx11,work)
                    call la_${ri}$larf('R',m - p - i,q - i,x11(i,i + 1),ldx11,tauq1(i),x21(i + 1,i + 1), &
                              ldx21,work)
                 end if
                 if (p > i) then
                    call la_${ri}$larf('R',p - i,m - q - i + 1,x12(i,i),ldx12,tauq2(i),x12(i + 1,i), &
                              ldx12,work)
                 end if
                 if (m - p > i) then
                    call la_${ri}$larf('R',m - p - i,m - q - i + 1,x12(i,i),ldx12,tauq2(i),x22(i + 1,i), &
                              ldx22,work)
                 end if
              end do
              ! reduce columns q + 1, ..., p of x12, x22
              do i = q + 1,p
                 call la_${ri}$scal(m - q - i + 1,-z1*z4,x12(i,i),ldx12)
                 if (i >= m - q) then
                    call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i),ldx12,tauq2(i))
                 else
                    call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i + 1),ldx12,tauq2(i))
                 end if
                 x12(i,i) = one
                 if (p > i) then
                    call la_${ri}$larf('R',p - i,m - q - i + 1,x12(i,i),ldx12,tauq2(i),x12(i + 1,i), &
                              ldx12,work)
                 end if
                 if (m - p - q >= 1) call la_${ri}$larf('R',m - p - q,m - q - i + 1,x12(i,i),ldx12,tauq2(i), &
                            x22(q + 1,i),ldx22,work)
              end do
              ! reduce columns p + 1, ..., m - q of x12, x22
              do i = 1,m - p - q
                 call la_${ri}$scal(m - p - q - i + 1,z2*z4,x22(q + i,p + i),ldx22)
                 if (i == m - p - q) then
                    call la_${ri}$larfgp(m - p - q - i + 1,x22(q + i,p + i),x22(q + i,p + i),ldx22,tauq2(p + i))

                 else
                    call la_${ri}$larfgp(m - p - q - i + 1,x22(q + i,p + i),x22(q + i,p + i + 1),ldx22,tauq2(p + i) &
                               )
                 end if
                 x22(q + i,p + i) = one
                 if (i < m - p - q) then
                    call la_${ri}$larf('R',m - p - q - i,m - p - q - i + 1,x22(q + i,p + i),ldx22,tauq2(p + i), &
                              x22(q + i + 1,p + i),ldx22,work)
                 end if
              end do
           else
              ! reduce columns 1, ..., q of x11, x12, x21, x22
              do i = 1,q
                 if (i == 1) then
                    call la_${ri}$scal(p - i + 1,z1,x11(i,i),ldx11)
                 else
                    call la_${ri}$scal(p - i + 1,z1*cos(phi(i - 1)),x11(i,i),ldx11)
                    call la_${ri}$axpy(p - i + 1,-z1*z3*z4*sin(phi(i - 1)),x12(i - 1,i),ldx12,x11(i,i), &
                               ldx11)
                 end if
                 if (i == 1) then
                    call la_${ri}$scal(m - p - i + 1,z2,x21(i,i),ldx21)
                 else
                    call la_${ri}$scal(m - p - i + 1,z2*cos(phi(i - 1)),x21(i,i),ldx21)
                    call la_${ri}$axpy(m - p - i + 1,-z2*z3*z4*sin(phi(i - 1)),x22(i - 1,i),ldx22,x21(i, &
                              i),ldx21)
                 end if
                 theta(i) = atan2(la_${ri}$nrm2(m - p - i + 1,x21(i,i),ldx21),la_${ri}$nrm2(p - i + 1, &
                           x11(i,i),ldx11))
                 call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i,i + 1),ldx11,taup1(i))
                 x11(i,i) = one
                 if (i == m - p) then
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i,i),ldx21,taup2(i))
                 else
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i,i + 1),ldx21,taup2(i))
                 end if
                 x21(i,i) = one
                 if (q > i) then
                    call la_${ri}$larf('R',q - i,p - i + 1,x11(i,i),ldx11,taup1(i),x11(i + 1,i), &
                              ldx11,work)
                 end if
                 if (m - q + 1 > i) then
                    call la_${ri}$larf('R',m - q - i + 1,p - i + 1,x11(i,i),ldx11,taup1(i),x12(i,i), &
                              ldx12,work)
                 end if
                 if (q > i) then
                    call la_${ri}$larf('R',q - i,m - p - i + 1,x21(i,i),ldx21,taup2(i),x21(i + 1,i), &
                              ldx21,work)
                 end if
                 if (m - q + 1 > i) then
                    call la_${ri}$larf('R',m - q - i + 1,m - p - i + 1,x21(i,i),ldx21,taup2(i),x22(i,i), &
                              ldx22,work)
                 end if
                 if (i < q) then
                    call la_${ri}$scal(q - i,-z1*z3*sin(theta(i)),x11(i + 1,i),1)
                    call la_${ri}$axpy(q - i,z2*z3*cos(theta(i)),x21(i + 1,i),1,x11(i + 1,i),1)

                 end if
                 call la_${ri}$scal(m - q - i + 1,-z1*z4*sin(theta(i)),x12(i,i),1)
                 call la_${ri}$axpy(m - q - i + 1,z2*z4*cos(theta(i)),x22(i,i),1,x12(i,i),1)

                 if (i < q) phi(i) = atan2(la_${ri}$nrm2(q - i,x11(i + 1,i),1),la_${ri}$nrm2(m - q - &
                           i + 1,x12(i,i),1))
                 if (i < q) then
                    if (q - i == 1) then
                       call la_${ri}$larfgp(q - i,x11(i + 1,i),x11(i + 1,i),1,tauq1(i))
                    else
                       call la_${ri}$larfgp(q - i,x11(i + 1,i),x11(i + 2,i),1,tauq1(i))
                    end if
                    x11(i + 1,i) = one
                 end if
                 if (m - q > i) then
                    call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i + 1,i),1,tauq2(i))
                 else
                    call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i),1,tauq2(i))
                 end if
                 x12(i,i) = one
                 if (i < q) then
                    call la_${ri}$larf('L',q - i,p - i,x11(i + 1,i),1,tauq1(i),x11(i + 1,i + 1),ldx11, &
                               work)
                    call la_${ri}$larf('L',q - i,m - p - i,x11(i + 1,i),1,tauq1(i),x21(i + 1,i + 1), &
                              ldx21,work)
                 end if
                 call la_${ri}$larf('L',m - q - i + 1,p - i,x12(i,i),1,tauq2(i),x12(i,i + 1),ldx12, &
                           work)
                 if (m - p - i > 0) then
                    call la_${ri}$larf('L',m - q - i + 1,m - p - i,x12(i,i),1,tauq2(i),x22(i,i + 1), &
                              ldx22,work)
                 end if
              end do
              ! reduce columns q + 1, ..., p of x12, x22
              do i = q + 1,p
                 call la_${ri}$scal(m - q - i + 1,-z1*z4,x12(i,i),1)
                 call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i + 1,i),1,tauq2(i))
                 x12(i,i) = one
                 if (p > i) then
                    call la_${ri}$larf('L',m - q - i + 1,p - i,x12(i,i),1,tauq2(i),x12(i,i + 1),ldx12, &
                               work)
                 end if
                 if (m - p - q >= 1) call la_${ri}$larf('L',m - q - i + 1,m - p - q,x12(i,i),1,tauq2(i), &
                           x22(i,q + 1),ldx22,work)
              end do
              ! reduce columns p + 1, ..., m - q of x12, x22
              do i = 1,m - p - q
                 call la_${ri}$scal(m - p - q - i + 1,z2*z4,x22(p + i,q + i),1)
                 if (m - p - q == i) then
                    call la_${ri}$larfgp(m - p - q - i + 1,x22(p + i,q + i),x22(p + i,q + i),1,tauq2(p + i))

#:if rk == "sp"
                    x22(p + i,q + i) = one
#:endif
                 else
                    call la_${ri}$larfgp(m - p - q - i + 1,x22(p + i,q + i),x22(p + i + 1,q + i),1,tauq2(p + i))

#:if rk == "sp"
                    x22(p + i,q + i) = one
#:endif
                    call la_${ri}$larf('L',m - p - q - i + 1,m - p - q - i,x22(p + i,q + i),1,tauq2(p + i),x22(p + &
                              i,q + i + 1),ldx22,work)
                 end if
#:if rk != "sp"
                 x22(p + i,q + i) = one
#:endif
              end do
           end if
           return
     end subroutine la_${ri}$orbdb
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB5: orthogonalizes the column vector
     !> X = [ X1 ]
     !> [ X2 ]
     !> with respect to the columns of
     !> Q = [ Q1 ] .
     !> [ Q2 ]
     !> The columns of Q must be orthonormal.
     !> If the projection is zero according to Kahan's "twice is enough"
     !> criterion, then some other vector from the orthogonal complement
     !> is returned. This vector is chosen in an arbitrary but deterministic
     !> way.

     pure subroutine la_${ri}$orbdb5(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
               lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx1,incx2,ldq1,ldq2,lwork,m1,m2,n
           integer(ilp),intent(out) :: info
           ! Array Arguments
           real(${rk}$),intent(in) :: q1(ldq1,*),q2(ldq2,*)
           real(${rk}$),intent(out) :: work(*)
           real(${rk}$),intent(inout) :: x1(*),x2(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: childinfo,i,j
           ! Intrinsic Function
           intrinsic :: max
           ! Executable Statements
           ! test input arguments
           info = 0
           if (m1 < 0) then
              info = -1
           else if (m2 < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (incx1 < 1) then
              info = -5
           else if (incx2 < 1) then
              info = -7
           else if (ldq1 < max(1,m1)) then
              info = -9
           else if (ldq2 < max(1,m2)) then
              info = -11
           else if (lwork < n) then
              info = -13
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORBDB5',-info)
              return
           end if
           ! project x onto the orthogonal complement of q
           call la_${ri}$orbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work,lwork, &
                     childinfo)
           ! if the projection is nonzero, then return
           if (la_${ri}$nrm2(m1,x1,incx1) /= zero .or. la_${ri}$nrm2(m2,x2,incx2) /= zero) &
                     then
              return
           end if
           ! project each standard basis vector e_1,...,e_m1 in turn, stopping
           ! when a nonzero projection is found
           do i = 1,m1
              do j = 1,m1
                 x1(j) = zero
              end do
              x1(i) = one
              do j = 1,m2
                 x2(j) = zero
              end do
              call la_${ri}$orbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
                        lwork,childinfo)
              if (la_${ri}$nrm2(m1,x1,incx1) /= zero .or. la_${ri}$nrm2(m2,x2,incx2) /= zero) &
                        then
                 return
              end if
           end do
           ! project each standard basis vector e_(m1+1),...,e_(m1+m2) in turn,
           ! stopping when a nonzero projection is found
           do i = 1,m2
              do j = 1,m1
                 x1(j) = zero
              end do
              do j = 1,m2
                 x2(j) = zero
              end do
              x2(i) = one
              call la_${ri}$orbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
                        lwork,childinfo)
              if (la_${ri}$nrm2(m1,x1,incx1) /= zero .or. la_${ri}$nrm2(m2,x2,incx2) /= zero) &
                        then
                 return
              end if
           end do
           return
     end subroutine la_${ri}$orbdb5
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORCSD: computes the CS decomposition of an M-by-M partitioned
     !> orthogonal matrix X:
     !> [  I  0  0 |  0  0  0 ]
     !> [  0  C  0 |  0 -S  0 ]
     !> [ X11 | X12 ]   [ U1 |    ] [  0  0  0 |  0  0 -I ] [ V1 |    ]**T
     !> X = [-----------] = [---------] [---------------------] [---------]   .
     !> [ X21 | X22 ]   [    | U2 ] [  0  0  0 |  I  0  0 ] [    | V2 ]
     !> [  0  S  0 |  0  C  0 ]
     !> [  0  0  I |  0  0  0 ]
     !> X11 is P-by-Q. The orthogonal matrices U1, U2, V1, and V2 are P-by-P,
     !> (M-P)-by-(M-P), Q-by-Q, and (M-Q)-by-(M-Q), respectively. C and S are
     !> R-by-R nonnegative diagonal matrices satisfying C^2 + S^2 = I, in
     !> which R = MIN(P,M-P,Q,M-Q).

     recursive subroutine la_${ri}$orcsd(jobu1,jobu2,jobv1t,jobv2t,trans,signs,m,p,q,x11, &
     ldx11,x12,ldx12,x21,ldx21,x22,ldx22,theta,u1,ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t, &
               work,lwork,iwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu1,jobu2,jobv1t,jobv2t,signs,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldu1,ldu2,ldv1t,ldv2t,ldx11,ldx12,ldx21,ldx22, &
                     lwork,m,p,q
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: theta(*)
           real(${rk}$),intent(out) :: u1(ldu1,*),u2(ldu2,*),v1t(ldv1t,*),v2t(ldv2t,*),work(*)

           real(${rk}$),intent(inout) :: x11(ldx11,*),x12(ldx12,*),x21(ldx21,*),x22(ldx22,*)

        ! ===================================================================

#:if rk == "sp"
           ! Local Arrays
           real(${rk}$) :: dummy(1)
#:endif
           ! Local Scalars
           character :: transt,signst
           integer(ilp) :: childinfo,i,ib11d,ib11e,ib12d,ib12e,ib21d,ib21e,ib22d,ib22e, &
           ibbcsd,iorbdb,iorglq,iorgqr,iphi,itaup1,itaup2,itauq1,itauq2,j,lbbcsdwork, &
           lbbcsdworkmin,lbbcsdworkopt,lorbdbwork,lorbdbworkmin,lorbdbworkopt,lorglqwork, &
           lorglqworkmin,lorglqworkopt,lorgqrwork,lorgqrworkmin,lorgqrworkopt,lworkmin, &
                     lworkopt
           logical(lk) :: colmajor,defaultsigns,lquery,wantu1,wantu2,wantv1t,wantv2t
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test input arguments
           info = 0
           wantu1 = la_lsame(jobu1,'Y')
           wantu2 = la_lsame(jobu2,'Y')
           wantv1t = la_lsame(jobv1t,'Y')
           wantv2t = la_lsame(jobv2t,'Y')
           colmajor = .not. la_lsame(trans,'T')
           defaultsigns = .not. la_lsame(signs,'O')
           lquery = lwork == -1
           if (m < 0) then
              info = -7
           else if (p < 0 .or. p > m) then
              info = -8
           else if (q < 0 .or. q > m) then
              info = -9
           else if (colmajor .and. ldx11 < max(1,p)) then
             info = -11
           else if (.not. colmajor .and. ldx11 < max(1,q)) then
             info = -11
           else if (colmajor .and. ldx12 < max(1,p)) then
             info = -13
           else if (.not. colmajor .and. ldx12 < max(1,m - q)) then
             info = -13
           else if (colmajor .and. ldx21 < max(1,m - p)) then
             info = -15
           else if (.not. colmajor .and. ldx21 < max(1,q)) then
             info = -15
           else if (colmajor .and. ldx22 < max(1,m - p)) then
             info = -17
           else if (.not. colmajor .and. ldx22 < max(1,m - q)) then
             info = -17
           else if (wantu1 .and. ldu1 < p) then
              info = -20
           else if (wantu2 .and. ldu2 < m - p) then
              info = -22
           else if (wantv1t .and. ldv1t < q) then
              info = -24
           else if (wantv2t .and. ldv2t < m - q) then
              info = -26
           end if
           ! work with transpose if convenient
           if (info == 0 .and. min(p,m - p) < min(q,m - q)) then
              if (colmajor) then
                 transt = 'T'
              else
                 transt = 'N'
              end if
              if (defaultsigns) then
                 signst = 'O'
              else
                 signst = 'D'
              end if
              call la_${ri}$orcsd(jobv1t,jobv2t,jobu1,jobu2,transt,signst,m,q,p,x11, &
              ldx11,x21,ldx21,x12,ldx12,x22,ldx22,theta,v1t,ldv1t,v2t,ldv2t,u1,ldu1, &
                        u2,ldu2,work,lwork,iwork,info)
              return
           end if
           ! work with permutation [ 0 i; i 0 ] * x * [ 0 i; i 0 ] if
           ! convenient
           if (info == 0 .and. m - q < q) then
              if (defaultsigns) then
                 signst = 'O'
              else
                 signst = 'D'
              end if
              call la_${ri}$orcsd(jobu2,jobu1,jobv2t,jobv1t,trans,signst,m,m - p,m - q,x22, &
              ldx22,x21,ldx21,x12,ldx12,x11,ldx11,theta,u2,ldu2,u1,ldu1,v2t,ldv2t, &
                        v1t,ldv1t,work,lwork,iwork,info)
              return
           end if
           ! compute workspace
           if (info == 0) then
              iphi = 2
              itaup1 = iphi + max(1,q - 1)
              itaup2 = itaup1 + max(1,p)
              itauq1 = itaup2 + max(1,m - p)
              itauq2 = itauq1 + max(1,q)
              iorgqr = itauq2 + max(1,m - q)
#:if rk == "sp"
              call la_${ri}$orgqr(m - q,m - q,m - q,dummy,max(1,m - q),dummy,work,-1,childinfo)

#:else
              call la_${ri}$orgqr(m - q,m - q,m - q,u1,max(1,m - q),u1,work,-1,childinfo)
#:endif
              lorgqrworkopt = int(work(1),KIND=ilp)
              lorgqrworkmin = max(1,m - q)
              iorglq = itauq2 + max(1,m - q)
#:if rk == "sp"
              call la_${ri}$orglq(m - q,m - q,m - q,dummy,max(1,m - q),dummy,work,-1,childinfo)

#:else
              call la_${ri}$orglq(m - q,m - q,m - q,u1,max(1,m - q),u1,work,-1,childinfo)
#:endif
              lorglqworkopt = int(work(1),KIND=ilp)
              lorglqworkmin = max(1,m - q)
              iorbdb = itauq2 + max(1,m - q)
              call la_${ri}$orbdb(trans,signs,m,p,q,x11,ldx11,x12,ldx12,x21,ldx21,x22, &
#:if rk == "sp"
                        ldx22,dummy,dummy,dummy,dummy,dummy,dummy,work,-1,childinfo)
#:else
                        ldx22,theta,v1t,u1,u2,v1t,v2t,work,-1,childinfo)
#:endif
              lorbdbworkopt = int(work(1),KIND=ilp)
              lorbdbworkmin = lorbdbworkopt
              ib11d = itauq2 + max(1,m - q)
              ib11e = ib11d + max(1,q)
              ib12d = ib11e + max(1,q - 1)
              ib12e = ib12d + max(1,q)
              ib21d = ib12e + max(1,q - 1)
              ib21e = ib21d + max(1,q)
              ib22d = ib21e + max(1,q - 1)
              ib22e = ib22d + max(1,q)
              ibbcsd = ib22e + max(1,q - 1)
#:if rk == "sp"
              call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,dummy,dummy,u1, &
              ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,dummy,dummy,dummy,dummy,dummy,dummy, &
                        dummy,dummy,work,-1,childinfo)
#:else
              call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,theta,theta,u1, &
              ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,u1,u1,u1,u1,u1,u1,u1,u1,work,-1, &
                        childinfo)
#:endif
              lbbcsdworkopt = int(work(1),KIND=ilp)
              lbbcsdworkmin = lbbcsdworkopt
              lworkopt = max(iorgqr + lorgqrworkopt,iorglq + lorglqworkopt,iorbdb + &
                        lorbdbworkopt,ibbcsd + lbbcsdworkopt) - 1
              lworkmin = max(iorgqr + lorgqrworkmin,iorglq + lorglqworkmin,iorbdb + &
                        lorbdbworkopt,ibbcsd + lbbcsdworkmin) - 1
              work(1) = max(lworkopt,lworkmin)
              if (lwork < lworkmin .and. .not. lquery) then
                 info = -22
              else
                 lorgqrwork = lwork - iorgqr + 1
                 lorglqwork = lwork - iorglq + 1
                 lorbdbwork = lwork - iorbdb + 1
                 lbbcsdwork = lwork - ibbcsd + 1
              end if
           end if
           ! abort if any illegal arguments
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORCSD',-info)
              return
           else if (lquery) then
              return
           end if
           ! transform to bidiagonal block form
           call la_${ri}$orbdb(trans,signs,m,p,q,x11,ldx11,x12,ldx12,x21,ldx21,x22, &
           ldx22,theta,work(iphi),work(itaup1),work(itaup2),work(itauq1),work(itauq2),work( &
                     iorbdb),lorbdbwork,childinfo)
           ! accumulate householder reflectors
           if (colmajor) then
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('L',p,q,x11,ldx11,u1,ldu1)
                 call la_${ri}$orgqr(p,p,q,u1,ldu1,work(itaup1),work(iorgqr),lorgqrwork, &
                           info)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('L',m - p,q,x21,ldx21,u2,ldu2)
                 call la_${ri}$orgqr(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorgqr),lorgqrwork, &
                            info)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',q - 1,q - 1,x11(1,2),ldx11,v1t(2,2),ldv1t)
                 v1t(1,1) = one
                 do j = 2,q
                    v1t(1,j) = zero
                    v1t(j,1) = zero
                 end do
                 call la_${ri}$orglq(q - 1,q - 1,q - 1,v1t(2,2),ldv1t,work(itauq1),work(iorglq), &
                           lorglqwork,info)
              end if
              if (wantv2t .and. m - q > 0) then
                 call la_${ri}$lacpy('U',p,m - q,x12,ldx12,v2t,ldv2t)
#:if rk == "sp"
                 call la_${ri}$lacpy('U',m - p - q,m - p - q,x22(q + 1,p + 1),ldx22,v2t(p + 1,p + 1),ldv2t)

#:else
                 if (m - p > q) then
                    call la_${ri}$lacpy('U',m - p - q,m - p - q,x22(q + 1,p + 1),ldx22,v2t(p + 1,p + 1), &
                              ldv2t)
                 end if
                 if (m > q) then
#:endif
                    call la_${ri}$orglq(m - q,m - q,m - q,v2t,ldv2t,work(itauq2),work(iorglq), &
                              lorglqwork,info)
#:if rk != "sp"
                 end if
#:endif
              end if
           else
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('U',q,p,x11,ldx11,u1,ldu1)
                 call la_${ri}$orglq(p,p,q,u1,ldu1,work(itaup1),work(iorglq),lorglqwork, &
                           info)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('U',q,m - p,x21,ldx21,u2,ldu2)
                 call la_${ri}$orglq(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorglq),lorglqwork, &
                            info)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('L',q - 1,q - 1,x11(2,1),ldx11,v1t(2,2),ldv1t)
                 v1t(1,1) = one
                 do j = 2,q
                    v1t(1,j) = zero
                    v1t(j,1) = zero
                 end do
                 call la_${ri}$orgqr(q - 1,q - 1,q - 1,v1t(2,2),ldv1t,work(itauq1),work(iorgqr), &
                           lorgqrwork,info)
              end if
              if (wantv2t .and. m - q > 0) then
                 call la_${ri}$lacpy('L',m - q,p,x12,ldx12,v2t,ldv2t)
                 call la_${ri}$lacpy('L',m - p - q,m - p - q,x22(p + 1,q + 1),ldx22,v2t(p + 1,p + 1),ldv2t)

                 call la_${ri}$orgqr(m - q,m - q,m - q,v2t,ldv2t,work(itauq2),work(iorgqr), &
                           lorgqrwork,info)
              end if
           end if
           ! compute the csd of the matrix in bidiagonal-block form
           call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,theta,work(iphi),u1, &
            ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,work(ib11d),work(ib11e),work(ib12d),work( &
            ib12e),work(ib21d),work(ib21e),work(ib22d),work(ib22e),work(ibbcsd),lbbcsdwork, &
                      info)
           ! permute rows and columns to place identity submatrices in top-
           ! left corner of (1,1)-block and/or bottom-right corner of (1,2)-
           ! block and/or bottom-right corner of (2,1)-block and/or top-left
           ! corner of (2,2)-block
           if (q > 0 .and. wantu2) then
              do i = 1,q
                 iwork(i) = m - p - q + i
              end do
              do i = q + 1,m - p
                 iwork(i) = i - q
              end do
              if (colmajor) then
                 call la_${ri}$lapmt(.false.,m - p,m - p,u2,ldu2,iwork)
              else
                 call la_${ri}$lapmr(.false.,m - p,m - p,u2,ldu2,iwork)
              end if
           end if
           if (m > 0 .and. wantv2t) then
              do i = 1,p
                 iwork(i) = m - p - q + i
              end do
              do i = p + 1,m - q
                 iwork(i) = i - p
              end do
              if (.not. colmajor) then
                 call la_${ri}$lapmt(.false.,m - q,m - q,v2t,ldv2t,iwork)
              else
                 call la_${ri}$lapmr(.false.,m - q,m - q,v2t,ldv2t,iwork)
              end if
           end if
           return
           ! end la_${ri}$orcsd
     end subroutine la_${ri}$orcsd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB1: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. Q must be no larger than P,
     !> M-P, or M-Q. Routines ${ri.upper()}$ORBDB2, ${ri.upper()}$ORBDB3, and ${ri.upper()}$ORBDB4 handle cases in
     !> which Q is not the minimum dimension.
     !> The orthogonal matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are Q-by-Q bidiagonal matrices represented implicitly by
     !> angles THETA, PHI.

     subroutine la_${ri}$orbdb1(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           real(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),work(*)
           real(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (p < q .or. m - p < q) then
              info = -2
           else if (q < 0 .or. m - q < q) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(p - 1,m - p - 1,q - 1)
              iorbdb5 = 2
              lorbdb5 = q - 2
              lworkopt = max(ilarf + llarf - 1,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORBDB1',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce columns 1, ..., q of x11 and x21
           do i = 1,q
              call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
              call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
              theta(i) = atan2(x21(i,i),x11(i,i))
              c = cos(theta(i))
              s = sin(theta(i))
              x11(i,i) = one
              x21(i,i) = one
              call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,taup1(i),x11(i,i + 1),ldx11,work( &
                        ilarf))
              call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,taup2(i),x21(i,i + 1),ldx21,work( &
                        ilarf))
              if (i < q) then
                 call la_${ri}$rot(q - i,x11(i,i + 1),ldx11,x21(i,i + 1),ldx21,c,s)
                 call la_${ri}$larfgp(q - i,x21(i,i + 1),x21(i,i + 2),ldx21,tauq1(i))
                 s = x21(i,i + 1)
                 x21(i,i + 1) = one
                 call la_${ri}$larf('R',p - i,q - i,x21(i,i + 1),ldx21,tauq1(i),x11(i + 1,i + 1), &
                           ldx11,work(ilarf))
                 call la_${ri}$larf('R',m - p - i,q - i,x21(i,i + 1),ldx21,tauq1(i),x21(i + 1,i + 1), &
                           ldx21,work(ilarf))
                 c = sqrt(la_${ri}$nrm2(p - i,x11(i + 1,i + 1),1)**2 + la_${ri}$nrm2(m - p - i,x21(i + 1, &
                           i + 1),1)**2)
                 phi(i) = atan2(s,c)
                 call la_${ri}$orbdb5(p - i,m - p - i,q - i - 1,x11(i + 1,i + 1),1,x21(i + 1,i + 1),1,x11(i + 1, &
                           i + 2),ldx11,x21(i + 1,i + 2),ldx21,work(iorbdb5),lorbdb5,childinfo)
              end if
           end do
           return
     end subroutine la_${ri}$orbdb1
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB2: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. P must be no larger than M-P,
     !> Q, or M-Q. Routines ${ri.upper()}$ORBDB1, ${ri.upper()}$ORBDB3, and ${ri.upper()}$ORBDB4 handle cases in
     !> which P is not the minimum dimension.
     !> The orthogonal matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are P-by-P bidiagonal matrices represented implicitly by
     !> angles THETA, PHI.

     subroutine la_${ri}$orbdb2(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           real(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),work(*)
           real(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (p < 0 .or. p > m - p) then
              info = -2
           else if (q < 0 .or. q < p .or. m - q < p) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(p - 1,m - p,q - 1)
              iorbdb5 = 2
              lorbdb5 = q - 1
              lworkopt = max(ilarf + llarf - 1,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORBDB2',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce rows 1, ..., p of x11 and x21
           do i = 1,p
              if (i > 1) then
                 call la_${ri}$rot(q - i + 1,x11(i,i),ldx11,x21(i - 1,i),ldx21,c,s)
              end if
              call la_${ri}$larfgp(q - i + 1,x11(i,i),x11(i,i + 1),ldx11,tauq1(i))
              c = x11(i,i)
              x11(i,i) = one
              call la_${ri}$larf('R',p - i,q - i + 1,x11(i,i),ldx11,tauq1(i),x11(i + 1,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',m - p - i + 1,q - i + 1,x11(i,i),ldx11,tauq1(i),x21(i,i),ldx21, &
                        work(ilarf))
              s = sqrt(la_${ri}$nrm2(p - i,x11(i + 1,i),1)**2 + la_${ri}$nrm2(m - p - i + 1,x21(i,i),1 &
                        )**2)
              theta(i) = atan2(s,c)
              call la_${ri}$orbdb5(p - i,m - p - i + 1,q - i,x11(i + 1,i),1,x21(i,i),1,x11(i + 1,i + 1), &
                        ldx11,x21(i,i + 1),ldx21,work(iorbdb5),lorbdb5,childinfo)
              call la_${ri}$scal(p - i,negone,x11(i + 1,i),1)
              call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
              if (i < p) then
                 call la_${ri}$larfgp(p - i,x11(i + 1,i),x11(i + 2,i),1,taup1(i))
                 phi(i) = atan2(x11(i + 1,i),x21(i,i))
                 c = cos(phi(i))
                 s = sin(phi(i))
                 x11(i + 1,i) = one
                 call la_${ri}$larf('L',p - i,q - i,x11(i + 1,i),1,taup1(i),x11(i + 1,i + 1),ldx11, &
                           work(ilarf))
              end if
              x21(i,i) = one
              call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,taup2(i),x21(i,i + 1),ldx21,work( &
                        ilarf))
           end do
           ! reduce the bottom-right portion of x21 to the identity matrix
           do i = p + 1,q
              call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
              x21(i,i) = one
              call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,taup2(i),x21(i,i + 1),ldx21,work( &
                        ilarf))
           end do
           return
     end subroutine la_${ri}$orbdb2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB3: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. M-P must be no larger than P,
     !> Q, or M-Q. Routines ${ri.upper()}$ORBDB1, ${ri.upper()}$ORBDB2, and ${ri.upper()}$ORBDB4 handle cases in
     !> which M-P is not the minimum dimension.
     !> The orthogonal matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are (M-P)-by-(M-P) bidiagonal matrices represented
     !> implicitly by angles THETA, PHI.

     subroutine la_${ri}$orbdb3(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           real(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),work(*)
           real(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (2*p < m .or. p > m) then
              info = -2
           else if (q < m - p .or. m - q < m - p) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(p,m - p - 1,q - 1)
              iorbdb5 = 2
              lorbdb5 = q - 1
              lworkopt = max(ilarf + llarf - 1,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORBDB3',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce rows 1, ..., m-p of x11 and x21
           do i = 1,m - p
              if (i > 1) then
                 call la_${ri}$rot(q - i + 1,x11(i - 1,i),ldx11,x21(i,i),ldx11,c,s)
              end if
              call la_${ri}$larfgp(q - i + 1,x21(i,i),x21(i,i + 1),ldx21,tauq1(i))
              s = x21(i,i)
              x21(i,i) = one
              call la_${ri}$larf('R',p - i + 1,q - i + 1,x21(i,i),ldx21,tauq1(i),x11(i,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',m - p - i,q - i + 1,x21(i,i),ldx21,tauq1(i),x21(i + 1,i),ldx21, &
                        work(ilarf))
              c = sqrt(la_${ri}$nrm2(p - i + 1,x11(i,i),1)**2 + la_${ri}$nrm2(m - p - i,x21(i + 1,i),1 &
                        )**2)
              theta(i) = atan2(s,c)
              call la_${ri}$orbdb5(p - i + 1,m - p - i,q - i,x11(i,i),1,x21(i + 1,i),1,x11(i,i + 1), &
                        ldx11,x21(i + 1,i + 1),ldx21,work(iorbdb5),lorbdb5,childinfo)
              call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
              if (i < m - p) then
                 call la_${ri}$larfgp(m - p - i,x21(i + 1,i),x21(i + 2,i),1,taup2(i))
                 phi(i) = atan2(x21(i + 1,i),x11(i,i))
                 c = cos(phi(i))
                 s = sin(phi(i))
                 x21(i + 1,i) = one
                 call la_${ri}$larf('L',m - p - i,q - i,x21(i + 1,i),1,taup2(i),x21(i + 1,i + 1),ldx21, &
                           work(ilarf))
              end if
              x11(i,i) = one
              call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,taup1(i),x11(i,i + 1),ldx11,work( &
                        ilarf))
           end do
           ! reduce the bottom-right portion of x11 to the identity matrix
           do i = m - p + 1,q
              call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
              x11(i,i) = one
              call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,taup1(i),x11(i,i + 1),ldx11,work( &
                        ilarf))
           end do
           return
     end subroutine la_${ri}$orbdb3
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORBDB4: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. M-Q must be no larger than P,
     !> M-P, or Q. Routines ${ri.upper()}$ORBDB1, ${ri.upper()}$ORBDB2, and ${ri.upper()}$ORBDB3 handle cases in
     !> which M-Q is not the minimum dimension.
     !> The orthogonal matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are (M-Q)-by-(M-Q) bidiagonal matrices represented
     !> implicitly by angles THETA, PHI.

     subroutine la_${ri}$orbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               phantom,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           real(${rk}$),intent(out) :: phantom(*),taup1(*),taup2(*),tauq1(*),work(*)
           real(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,j,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (p < m - q .or. m - p < m - q) then
              info = -2
           else if (q < m - q .or. q > m) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(q - 1,p - 1,m - p - 1)
              iorbdb5 = 2
              lorbdb5 = q
              lworkopt = ilarf + llarf - 1
              lworkopt = max(lworkopt,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORBDB4',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce columns 1, ..., m-q of x11 and x21
           do i = 1,m - q
              if (i == 1) then
                 do j = 1,m
                    phantom(j) = zero
                 end do
                 call la_${ri}$orbdb5(p,m - p,q,phantom(1),1,phantom(p + 1),1,x11,ldx11,x21, &
                           ldx21,work(iorbdb5),lorbdb5,childinfo)
                 call la_${ri}$scal(p,negone,phantom(1),1)
                 call la_${ri}$larfgp(p,phantom(1),phantom(2),1,taup1(1))
                 call la_${ri}$larfgp(m - p,phantom(p + 1),phantom(p + 2),1,taup2(1))
                 theta(i) = atan2(phantom(1),phantom(p + 1))
                 c = cos(theta(i))
                 s = sin(theta(i))
                 phantom(1) = one
                 phantom(p + 1) = one
                 call la_${ri}$larf('L',p,q,phantom(1),1,taup1(1),x11,ldx11,work(ilarf))

                 call la_${ri}$larf('L',m - p,q,phantom(p + 1),1,taup2(1),x21,ldx21,work(ilarf) &
                            )
              else
                 call la_${ri}$orbdb5(p - i + 1,m - p - i + 1,q - i + 1,x11(i,i - 1),1,x21(i,i - 1),1,x11(i,i) &
                           ,ldx11,x21(i,i),ldx21,work(iorbdb5),lorbdb5,childinfo)
                 call la_${ri}$scal(p - i + 1,negone,x11(i,i - 1),1)
                 call la_${ri}$larfgp(p - i + 1,x11(i,i - 1),x11(i + 1,i - 1),1,taup1(i))
                 call la_${ri}$larfgp(m - p - i + 1,x21(i,i - 1),x21(i + 1,i - 1),1,taup2(i))
                 theta(i) = atan2(x11(i,i - 1),x21(i,i - 1))
                 c = cos(theta(i))
                 s = sin(theta(i))
                 x11(i,i - 1) = one
                 x21(i,i - 1) = one
                 call la_${ri}$larf('L',p - i + 1,q - i + 1,x11(i,i - 1),1,taup1(i),x11(i,i),ldx11, &
                           work(ilarf))
                 call la_${ri}$larf('L',m - p - i + 1,q - i + 1,x21(i,i - 1),1,taup2(i),x21(i,i),ldx21, &
                           work(ilarf))
              end if
              call la_${ri}$rot(q - i + 1,x11(i,i),ldx11,x21(i,i),ldx21,s,-c)
              call la_${ri}$larfgp(q - i + 1,x21(i,i),x21(i,i + 1),ldx21,tauq1(i))
              c = x21(i,i)
              x21(i,i) = one
              call la_${ri}$larf('R',p - i,q - i + 1,x21(i,i),ldx21,tauq1(i),x11(i + 1,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',m - p - i,q - i + 1,x21(i,i),ldx21,tauq1(i),x21(i + 1,i),ldx21, &
                        work(ilarf))
              if (i < m - q) then
                 s = sqrt(la_${ri}$nrm2(p - i,x11(i + 1,i),1)**2 + la_${ri}$nrm2(m - p - i,x21(i + 1,i), &
                            1)**2)
                 phi(i) = atan2(s,c)
              end if
           end do
           ! reduce the bottom-right portion of x11 to [ i 0 ]
           do i = m - q + 1,p
              call la_${ri}$larfgp(q - i + 1,x11(i,i),x11(i,i + 1),ldx11,tauq1(i))
              x11(i,i) = one
              call la_${ri}$larf('R',p - i,q - i + 1,x11(i,i),ldx11,tauq1(i),x11(i + 1,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',q - p,q - i + 1,x11(i,i),ldx11,tauq1(i),x21(m - q + 1,i),ldx21, &
                        work(ilarf))
           end do
           ! reduce the bottom-right portion of x21 to [ 0 i ]
           do i = p + 1,q
              call la_${ri}$larfgp(q - i + 1,x21(m - q + i - p,i),x21(m - q + i - p,i + 1),ldx21,tauq1(i))

              x21(m - q + i - p,i) = one
              call la_${ri}$larf('R',q - i,q - i + 1,x21(m - q + i - p,i),ldx21,tauq1(i),x21(m - q + i - p + 1,i) &
                        ,ldx21,work(ilarf))
           end do
           return
     end subroutine la_${ri}$orbdb4
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORCSD2BY1: computes the CS decomposition of an M-by-Q matrix X with
     !> orthonormal columns that has been partitioned into a 2-by-1 block
     !> structure:
     !> [  I1 0  0 ]
     !> [  0  C  0 ]
     !> [ X11 ]   [ U1 |    ] [  0  0  0 ]
     !> X = [-----] = [---------] [----------] V1**T .
     !> [ X21 ]   [    | U2 ] [  0  0  0 ]
     !> [  0  S  0 ]
     !> [  0  0  I2]
     !> X11 is P-by-Q. The orthogonal matrices U1, U2, and V1 are P-by-P,
     !> (M-P)-by-(M-P), and Q-by-Q, respectively. C and S are R-by-R
     !> nonnegative diagonal matrices satisfying C^2 + S^2 = I, in which
     !> R = MIN(P,M-P,Q,M-Q). I1 is a K1-by-K1 identity matrix and I2 is a
     !> K2-by-K2 identity matrix, where K1 = MAX(Q+P-M,0), K2 = MAX(Q-P,0).

     subroutine la_${ri}$orcsd2by1(jobu1,jobu2,jobv1t,m,p,q,x11,ldx11,x21,ldx21,theta, &
               u1,ldu1,u2,ldu2,v1t,ldv1t,work,lwork,iwork,info)
        use la_constants_${rk}$
#:if rk == "sp"
        ! -- lapack computational routine --
#:else
        ! -- lapack computational routine (3.5.0_${rk}$) --
#:endif
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu1,jobu2,jobv1t
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldu1,ldu2,ldv1t,lwork,ldx11,ldx21,m,p,q
           ! Array Arguments
           real(${rk}$),intent(out) :: theta(*)
           real(${rk}$),intent(out) :: u1(ldu1,*),u2(ldu2,*),v1t(ldv1t,*),work(*)
           real(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
           integer(ilp),intent(out) :: iwork(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: childinfo,i,ib11d,ib11e,ib12d,ib12e,ib21d,ib21e,ib22d,ib22e, &
           ibbcsd,iorbdb,iorglq,iorgqr,iphi,itaup1,itaup2,itauq1,j,lbbcsd,lorbdb, &
           lorglq,lorglqmin,lorglqopt,lorgqr,lorgqrmin,lorgqropt,lworkmin,lworkopt, &
                     r
           logical(lk) :: lquery,wantu1,wantu2,wantv1t
           ! Local Arrays
           real(${rk}$) :: dum1(1),dum2(1,1)
           ! Intrinsic Function
           intrinsic :: int,max,min
           ! Executable Statements
           ! test input arguments
           info = 0
           wantu1 = la_lsame(jobu1,'Y')
           wantu2 = la_lsame(jobu2,'Y')
           wantv1t = la_lsame(jobv1t,'Y')
           lquery = lwork == -1
           if (m < 0) then
              info = -4
           else if (p < 0 .or. p > m) then
              info = -5
           else if (q < 0 .or. q > m) then
              info = -6
           else if (ldx11 < max(1,p)) then
              info = -8
           else if (ldx21 < max(1,m - p)) then
              info = -10
           else if (wantu1 .and. ldu1 < max(1,p)) then
              info = -13
           else if (wantu2 .and. ldu2 < max(1,m - p)) then
              info = -15
           else if (wantv1t .and. ldv1t < max(1,q)) then
              info = -17
           end if
           r = min(p,m - p,q,m - q)
           ! compute workspace
             ! work layout:
           ! |-------------------------------------------------------|
           ! | lworkopt (1)                                          |
           ! |-------------------------------------------------------|
           ! | phi (max(1,r-1))                                      |
           ! |-------------------------------------------------------|
           ! | taup1 (max(1,p))                        | b11d (r)    |
           ! | taup2 (max(1,m-p))                      | b11e (r-1)  |
           ! | tauq1 (max(1,q))                        | b12d (r)    |
           ! |-----------------------------------------| b12e (r-1)  |
           ! | la_${ri}$orbdb work | la_${ri}$orgqr work | la_${ri}$orglq work | b21d (r)    |
           ! |             |             |             | b21e (r-1)  |
           ! |             |             |             | b22d (r)    |
           ! |             |             |             | b22e (r-1)  |
           ! |             |             |             | la_${ri}$bbcsd work |
           ! |-------------------------------------------------------|
           if (info == 0) then
              iphi = 2
              ib11d = iphi + max(1,r - 1)
              ib11e = ib11d + max(1,r)
              ib12d = ib11e + max(1,r - 1)
              ib12e = ib12d + max(1,r)
              ib21d = ib12e + max(1,r - 1)
              ib21e = ib21d + max(1,r)
              ib22d = ib21e + max(1,r - 1)
              ib22e = ib22d + max(1,r)
              ibbcsd = ib22e + max(1,r - 1)
              itaup1 = iphi + max(1,r - 1)
              itaup2 = itaup1 + max(1,p)
              itauq1 = itaup2 + max(1,m - p)
              iorbdb = itauq1 + max(1,q)
              iorgqr = itauq1 + max(1,q)
              iorglq = itauq1 + max(1,q)
              lorgqrmin = 1
              lorgqropt = 1
              lorglqmin = 1
              lorglqopt = 1
              if (r == q) then
                 call la_${ri}$orbdb1(m,p,q,x11,ldx11,x21,ldx21,theta,dum1,dum1,dum1, &
                           dum1,work,-1,childinfo)
                 lorbdb = int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$orgqr(p,p,q,u1,ldu1,dum1,work(1),-1,childinfo)
                    lorgqrmin = max(lorgqrmin,p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$orgqr(m - p,m - p,q,u2,ldu2,dum1,work(1),-1,childinfo)

                    lorgqrmin = max(lorgqrmin,m - p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$orglq(q - 1,q - 1,q - 1,v1t,ldv1t,dum1,work(1),-1,childinfo)

                    lorglqmin = max(lorglqmin,q - 1)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,'N','N',m,p,q,theta,dum1,u1, &
#:if rk == "sp"
                 ldu1,u2,ldu2,v1t,ldv1t,dum2,1,dum1,dum1,dum1,dum1,dum1,dum1,dum1, &
                           dum1,work(1),-1,childinfo)
#:else
                 ldu1,u2,ldu2,v1t,ldv1t,dum2,1,dum1,dum1,dum1,dum1,dum1,dum1,dum1,dum1, &
                            work(1),-1,childinfo)
#:endif
                 lbbcsd = int(work(1),KIND=ilp)
              else if (r == p) then
                 call la_${ri}$orbdb2(m,p,q,x11,ldx11,x21,ldx21,theta,dum1,dum1,dum1, &
                           dum1,work(1),-1,childinfo)
                 lorbdb = int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$orgqr(p - 1,p - 1,p - 1,u1(2,2),ldu1,dum1,work(1),-1,childinfo &
                              )
                    lorgqrmin = max(lorgqrmin,p - 1)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$orgqr(m - p,m - p,q,u2,ldu2,dum1,work(1),-1,childinfo)

                    lorgqrmin = max(lorgqrmin,m - p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$orglq(q,q,r,v1t,ldv1t,dum1,work(1),-1,childinfo)
                    lorglqmin = max(lorglqmin,q)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd(jobv1t,'N',jobu1,jobu2,'T',m,q,p,theta,dum1,v1t, &
                 ldv1t,dum2,1,u1,ldu1,u2,ldu2,dum1,dum1,dum1,dum1,dum1,dum1,dum1,dum1, &
                           work(1),-1,childinfo)
                 lbbcsd = int(work(1),KIND=ilp)
              else if (r == m - p) then
                 call la_${ri}$orbdb3(m,p,q,x11,ldx11,x21,ldx21,theta,dum1,dum1,dum1, &
                           dum1,work(1),-1,childinfo)
                 lorbdb = int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$orgqr(p,p,q,u1,ldu1,dum1,work(1),-1,childinfo)
                    lorgqrmin = max(lorgqrmin,p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$orgqr(m - p - 1,m - p - 1,m - p - 1,u2(2,2),ldu2,dum1,work(1),-1, &
                              childinfo)
                    lorgqrmin = max(lorgqrmin,m - p - 1)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$orglq(q,q,r,v1t,ldv1t,dum1,work(1),-1,childinfo)
                    lorglqmin = max(lorglqmin,q)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd('N',jobv1t,jobu2,jobu1,'T',m,m - q,m - p,theta,dum1, &
                 dum2,1,v1t,ldv1t,u2,ldu2,u1,ldu1,dum1,dum1,dum1,dum1,dum1,dum1,dum1, &
                           dum1,work(1),-1,childinfo)
                 lbbcsd = int(work(1),KIND=ilp)
              else
                 call la_${ri}$orbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,dum1,dum1,dum1, &
                           dum1,dum1,work(1),-1,childinfo)
                 lorbdb = m + int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$orgqr(p,p,m - q,u1,ldu1,dum1,work(1),-1,childinfo)
                    lorgqrmin = max(lorgqrmin,p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$orgqr(m - p,m - p,m - q,u2,ldu2,dum1,work(1),-1,childinfo)

                    lorgqrmin = max(lorgqrmin,m - p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$orglq(q,q,q,v1t,ldv1t,dum1,work(1),-1,childinfo)
                    lorglqmin = max(lorglqmin,q)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd(jobu2,jobu1,'N',jobv1t,'N',m,m - p,m - q,theta,dum1,u2, &
#:if rk == "sp"
                 ldu2,u1,ldu1,dum2,1,v1t,ldv1t,dum1,dum1,dum1,dum1,dum1,dum1,dum1, &
                           dum1,work(1),-1,childinfo)
#:else
                 ldu2,u1,ldu1,dum2,1,v1t,ldv1t,dum1,dum1,dum1,dum1,dum1,dum1,dum1,dum1, &
                            work(1),-1,childinfo)
#:endif
                 lbbcsd = int(work(1),KIND=ilp)
              end if
              lworkmin = max(iorbdb + lorbdb - 1,iorgqr + lorgqrmin - 1,iorglq + lorglqmin - 1,ibbcsd + lbbcsd - &
                        1)
              lworkopt = max(iorbdb + lorbdb - 1,iorgqr + lorgqropt - 1,iorglq + lorglqopt - 1,ibbcsd + lbbcsd - &
                        1)
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                 info = -19
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORCSD2BY1',-info)
              return
           else if (lquery) then
              return
           end if
           lorgqr = lwork - iorgqr + 1
           lorglq = lwork - iorglq + 1
           ! handle four cases separately: r = q, r = p, r = m-p, and r = m-q,
           ! in which r = min(p,m-p,q,m-q)
           if (r == q) then
              ! case 1: r = q
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$orbdb1(m,p,q,x11,ldx11,x21,ldx21,theta,work(iphi),work(itaup1) &
                        ,work(itaup2),work(itauq1),work(iorbdb),lorbdb,childinfo)
              ! accumulate householder reflectors
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('L',p,q,x11,ldx11,u1,ldu1)
                 call la_${ri}$orgqr(p,p,q,u1,ldu1,work(itaup1),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('L',m - p,q,x21,ldx21,u2,ldu2)
                 call la_${ri}$orgqr(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 v1t(1,1) = one
                 do j = 2,q
                    v1t(1,j) = zero
                    v1t(j,1) = zero
                 end do
                 call la_${ri}$lacpy('U',q - 1,q - 1,x21(1,2),ldx21,v1t(2,2),ldv1t)
                 call la_${ri}$orglq(q - 1,q - 1,q - 1,v1t(2,2),ldv1t,work(itauq1),work(iorglq), &
                           lorglq,childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,'N','N',m,p,q,theta,work(iphi),u1, &
              ldu1,u2,ldu2,v1t,ldv1t,dum2,1,work(ib11d),work(ib11e),work(ib12d),work( &
              ib12e),work(ib21d),work(ib21e),work(ib22d),work(ib22e),work(ibbcsd),lbbcsd, &
                        childinfo)
              ! permute rows and columns to place zero submatrices in
              ! preferred positions
              if (q > 0 .and. wantu2) then
                 do i = 1,q
                    iwork(i) = m - p - q + i
                 end do
                 do i = q + 1,m - p
                    iwork(i) = i - q
                 end do
                 call la_${ri}$lapmt(.false.,m - p,m - p,u2,ldu2,iwork)
              end if
           else if (r == p) then
              ! case 2: r = p
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$orbdb2(m,p,q,x11,ldx11,x21,ldx21,theta,work(iphi),work(itaup1) &
                        ,work(itaup2),work(itauq1),work(iorbdb),lorbdb,childinfo)
              ! accumulate householder reflectors
              if (wantu1 .and. p > 0) then
                 u1(1,1) = one
                 do j = 2,p
                    u1(1,j) = zero
                    u1(j,1) = zero
                 end do
                 call la_${ri}$lacpy('L',p - 1,p - 1,x11(2,1),ldx11,u1(2,2),ldu1)
                 call la_${ri}$orgqr(p - 1,p - 1,p - 1,u1(2,2),ldu1,work(itaup1),work(iorgqr), &
                           lorgqr,childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('L',m - p,q,x21,ldx21,u2,ldu2)
                 call la_${ri}$orgqr(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',p,q,x11,ldx11,v1t,ldv1t)
                 call la_${ri}$orglq(q,q,r,v1t,ldv1t,work(itauq1),work(iorglq),lorglq, &
                           childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd(jobv1t,'N',jobu1,jobu2,'T',m,q,p,theta,work(iphi),v1t, &
#:if rk == "sp"
              ldv1t,dum1,1,u1,ldu1,u2,ldu2,work(ib11d),work(ib11e),work(ib12d),work(ib12e) &
#:else
              ldv1t,dum2,1,u1,ldu1,u2,ldu2,work(ib11d),work(ib11e),work(ib12d),work(ib12e) &
#:endif
              ,work(ib21d),work(ib21e),work(ib22d),work(ib22e),work(ibbcsd),lbbcsd,childinfo &
                        )
              ! permute rows and columns to place identity submatrices in
              ! preferred positions
              if (q > 0 .and. wantu2) then
                 do i = 1,q
                    iwork(i) = m - p - q + i
                 end do
                 do i = q + 1,m - p
                    iwork(i) = i - q
                 end do
                 call la_${ri}$lapmt(.false.,m - p,m - p,u2,ldu2,iwork)
              end if
           else if (r == m - p) then
              ! case 3: r = m-p
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$orbdb3(m,p,q,x11,ldx11,x21,ldx21,theta,work(iphi),work(itaup1) &
                        ,work(itaup2),work(itauq1),work(iorbdb),lorbdb,childinfo)
              ! accumulate householder reflectors
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('L',p,q,x11,ldx11,u1,ldu1)
                 call la_${ri}$orgqr(p,p,q,u1,ldu1,work(itaup1),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 u2(1,1) = one
                 do j = 2,m - p
                    u2(1,j) = zero
                    u2(j,1) = zero
                 end do
                 call la_${ri}$lacpy('L',m - p - 1,m - p - 1,x21(2,1),ldx21,u2(2,2),ldu2)
                 call la_${ri}$orgqr(m - p - 1,m - p - 1,m - p - 1,u2(2,2),ldu2,work(itaup2),work(iorgqr) &
                           ,lorgqr,childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',m - p,q,x21,ldx21,v1t,ldv1t)
                 call la_${ri}$orglq(q,q,r,v1t,ldv1t,work(itauq1),work(iorglq),lorglq, &
                           childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd('N',jobv1t,jobu2,jobu1,'T',m,m - q,m - p,theta,work(iphi), &
#:if rk == "sp"
              dum1,1,v1t,ldv1t,u2,ldu2,u1,ldu1,work(ib11d),work(ib11e),work(ib12d),work( &
#:else
              dum2,1,v1t,ldv1t,u2,ldu2,u1,ldu1,work(ib11d),work(ib11e),work(ib12d),work( &
#:endif
              ib12e),work(ib21d),work(ib21e),work(ib22d),work(ib22e),work(ibbcsd),lbbcsd, &
                        childinfo)
              ! permute rows and columns to place identity submatrices in
              ! preferred positions
              if (q > r) then
                 do i = 1,r
                    iwork(i) = q - r + i
                 end do
                 do i = r + 1,q
                    iwork(i) = i - r
                 end do
                 if (wantu1) then
                    call la_${ri}$lapmt(.false.,p,q,u1,ldu1,iwork)
                 end if
                 if (wantv1t) then
                    call la_${ri}$lapmr(.false.,q,q,v1t,ldv1t,iwork)
                 end if
              end if
           else
              ! case 4: r = m-q
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$orbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,work(iphi),work(itaup1) &
              ,work(itaup2),work(itauq1),work(iorbdb),work(iorbdb + m),lorbdb - m,childinfo)

              ! accumulate householder reflectors
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$copy(m - p,work(iorbdb + p),1,u2,1)
              end if
              if (wantu1 .and. p > 0) then
                 call la_${ri}$copy(p,work(iorbdb),1,u1,1)
                 do j = 2,p
                    u1(1,j) = zero
                 end do
                 call la_${ri}$lacpy('L',p - 1,m - q - 1,x11(2,1),ldx11,u1(2,2),ldu1)
                 call la_${ri}$orgqr(p,p,m - q,u1,ldu1,work(itaup1),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 do j = 2,m - p
                    u2(1,j) = zero
                 end do
                 call la_${ri}$lacpy('L',m - p - 1,m - q - 1,x21(2,1),ldx21,u2(2,2),ldu2)
                 call la_${ri}$orgqr(m - p,m - p,m - q,u2,ldu2,work(itaup2),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',m - q,q,x21,ldx21,v1t,ldv1t)
                 call la_${ri}$lacpy('U',p - (m - q),q - (m - q),x11(m - q + 1,m - q + 1),ldx11,v1t(m - q + 1,m - q + &
                           1),ldv1t)
                 call la_${ri}$lacpy('U',-p + q,q - p,x21(m - q + 1,p + 1),ldx21,v1t(p + 1,p + 1),ldv1t)

                 call la_${ri}$orglq(q,q,q,v1t,ldv1t,work(itauq1),work(iorglq),lorglq, &
                           childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd(jobu2,jobu1,'N',jobv1t,'N',m,m - p,m - q,theta,work(iphi), &
#:if rk == "sp"
              u2,ldu2,u1,ldu1,dum1,1,v1t,ldv1t,work(ib11d),work(ib11e),work(ib12d),work( &
#:else
              u2,ldu2,u1,ldu1,dum2,1,v1t,ldv1t,work(ib11d),work(ib11e),work(ib12d),work( &
#:endif
              ib12e),work(ib21d),work(ib21e),work(ib22d),work(ib22e),work(ibbcsd),lbbcsd, &
                        childinfo)
              ! permute rows and columns to place identity submatrices in
              ! preferred positions
              if (p > r) then
                 do i = 1,r
                    iwork(i) = p - r + i
                 end do
                 do i = r + 1,p
                    iwork(i) = i - r
                 end do
                 if (wantu1) then
                    call la_${ri}$lapmt(.false.,p,p,u1,ldu1,iwork)
                 end if
                 if (wantv1t) then
                    call la_${ri}$lapmr(.false.,p,q,v1t,ldv1t,iwork)
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$orcsd2by1
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAPMR: rearranges the rows of the M by N matrix X as specified
     !> by the permutation K(1),K(2),...,K(M) of the integers 1,...,M.
     !> If FORWRD = .TRUE.,  forward permutation:
     !> X(K(I),*) is moved X(I,*) for I = 1,2,...,M.
     !> If FORWRD = .FALSE., backward permutation:
     !> X(I,*) is moved to X(K(I),*) for I = 1,2,...,M.

     pure subroutine la_${ri}$lapmr(forwrd,m,n,x,ldx,k)
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           logical(lk),intent(in) :: forwrd
           integer(ilp),intent(in) :: ldx,m,n
           ! Array Arguments
           integer(ilp),intent(inout) :: k(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,in,j,jj
           complex(${rk}$) :: temp
           ! Executable Statements
           if (m <= 1) return
           do i = 1,m
              k(i) = -k(i)
           end do
           if (forwrd) then
              ! forward permutation
              do i = 1,m
                 if (k(i) > 0) go to 40
                 j = i
                 k(j) = -k(j)
                 in = k(j)
                 20 continue
                 if (k(in) > 0) go to 40
                 do jj = 1,n
                    temp = x(j,jj)
                    x(j,jj) = x(in,jj)
                    x(in,jj) = temp
                 end do
                 k(in) = -k(in)
                 j = in
                 in = k(in)
                 go to 20
                 40 continue
              end do
           else
              ! backward permutation
              do i = 1,m
                 if (k(i) > 0) go to 80
                 k(i) = -k(i)
                 j = k(i)
                 60 continue
                 if (j == i) go to 80
                 do jj = 1,n
                    temp = x(i,jj)
                    x(i,jj) = x(j,jj)
                    x(j,jj) = temp
                 end do
                 k(j) = -k(j)
                 j = k(j)
                 go to 60
                 80 continue
              end do
           end if
           return
     end subroutine la_${ri}$lapmr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAPMT: rearranges the columns of the M by N matrix X as specified
     !> by the permutation K(1),K(2),...,K(N) of the integers 1,...,N.
     !> If FORWRD = .TRUE.,  forward permutation:
     !> X(*,K(J)) is moved X(*,J) for J = 1,2,...,N.
     !> If FORWRD = .FALSE., backward permutation:
     !> X(*,J) is moved to X(*,K(J)) for J = 1,2,...,N.

     pure subroutine la_${ri}$lapmt(forwrd,m,n,x,ldx,k)
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           logical(lk),intent(in) :: forwrd
           integer(ilp),intent(in) :: ldx,m,n
           ! Array Arguments
           integer(ilp),intent(inout) :: k(*)
           complex(${rk}$),intent(inout) :: x(ldx,*)
        ! =====================================================================
           ! Local Scalars
#:if rk == "sp"
           integer(ilp) :: i,ii,j,in
#:else
           integer(ilp) :: i,ii,in,j
#:endif
           complex(${rk}$) :: temp
           ! Executable Statements
           if (n <= 1) return
           do i = 1,n
              k(i) = -k(i)
           end do
           if (forwrd) then
              ! forward permutation
              do i = 1,n
                 if (k(i) > 0) go to 40
                 j = i
                 k(j) = -k(j)
                 in = k(j)
                 20 continue
                 if (k(in) > 0) go to 40
                 do ii = 1,m
                    temp = x(ii,j)
                    x(ii,j) = x(ii,in)
                    x(ii,in) = temp
                 end do
                 k(in) = -k(in)
                 j = in
                 in = k(in)
                 go to 20
                 40 continue
              end do
           else
              ! backward permutation
              do i = 1,n
#:if rk == "sp"
                 if (k(i) > 0) go to 100
#:else
                 if (k(i) > 0) go to 80
#:endif
                 k(i) = -k(i)
                 j = k(i)
#:if rk == "sp"
                 80 continue
                 if (j == i) go to 100
#:else
                 60 continue
                 if (j == i) go to 80
#:endif
                 do ii = 1,m
                    temp = x(ii,i)
                    x(ii,i) = x(ii,j)
                    x(ii,j) = temp
                 end do
                 k(j) = -k(j)
                 j = k(j)
#:if rk == "sp"
                 go to 80
                 100 continue
#:else
                 go to 60
                 80 continue
#:endif
              end do
           end if
           return
     end subroutine la_${ri}$lapmt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB: simultaneously bidiagonalizes the blocks of an M-by-M
     !> partitioned unitary matrix X:
     !> [ B11 | B12 0  0 ]
     !> [ X11 | X12 ]   [ P1 |    ] [  0  |  0 -I  0 ] [ Q1 |    ]**H
     !> X = [-----------] = [---------] [----------------] [---------]   .
     !> [ X21 | X22 ]   [    | P2 ] [ B21 | B22 0  0 ] [    | Q2 ]
     !> [  0  |  0  0  I ]
     !> X11 is P-by-Q. Q must be no larger than P, M-P, or M-Q. (If this is
     !> not the case, then X must be transposed and/or permuted. This can be
     !> done in constant time using the TRANS and SIGNS options. See ${ri.upper()}$UNCSD
     !> for details.)
     !> The unitary matrices P1, P2, Q1, and Q2 are P-by-P, (M-P)-by-
     !> (M-P), Q-by-Q, and (M-Q)-by-(M-Q), respectively. They are
     !> represented implicitly by Householder vectors.
     !> B11, B12, B21, and B22 are Q-by-Q bidiagonal matrices represented
     !> implicitly by angles THETA, PHI.

     subroutine la_${ri}$unbdb(trans,signs,m,p,q,x11,ldx11,x12,ldx12,x21,ldx21,x22, &
               ldx22,theta,phi,taup1,taup2,tauq1,tauq2,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: signs,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldx11,ldx12,ldx21,ldx22,lwork,m,p,q
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           complex(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),tauq2(*),work(*)
           complex(${rk}$),intent(inout) :: x11(ldx11,*),x12(ldx12,*),x21(ldx21,*),x22(ldx22,*)

        ! ====================================================================
           ! Parameters
           real(${rk}$),parameter :: realone = 1.0_${rk}$

           ! Local Scalars
           logical(lk) :: colmajor,lquery
           integer(ilp) :: i,lworkmin,lworkopt
           real(${rk}$) :: z1,z2,z3,z4
           ! Intrinsic Functions
           intrinsic :: atan2,cos,max,min,sin
           intrinsic :: cmplx,conjg
           ! Executable Statements
           ! test input arguments
           info = 0
           colmajor = .not. la_lsame(trans,'T')
           if (.not. la_lsame(signs,'O')) then
              z1 = realone
              z2 = realone
              z3 = realone
              z4 = realone
           else
              z1 = realone
              z2 = -realone
              z3 = realone
              z4 = -realone
           end if
           lquery = lwork == -1
           if (m < 0) then
              info = -3
           else if (p < 0 .or. p > m) then
              info = -4
           else if (q < 0 .or. q > p .or. q > m - p .or. q > m - q) then
              info = -5
           else if (colmajor .and. ldx11 < max(1,p)) then
              info = -7
           else if (.not. colmajor .and. ldx11 < max(1,q)) then
              info = -7
           else if (colmajor .and. ldx12 < max(1,p)) then
              info = -9
           else if (.not. colmajor .and. ldx12 < max(1,m - q)) then
              info = -9
           else if (colmajor .and. ldx21 < max(1,m - p)) then
              info = -11
           else if (.not. colmajor .and. ldx21 < max(1,q)) then
              info = -11
           else if (colmajor .and. ldx22 < max(1,m - p)) then
              info = -13
           else if (.not. colmajor .and. ldx22 < max(1,m - q)) then
              info = -13
           end if
           ! compute workspace
           if (info == 0) then
              lworkopt = m - q
              lworkmin = m - q
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                 info = -21
              end if
           end if
           if (info /= 0) then
              call la_xerbla('XORBDB',-info)
              return
           else if (lquery) then
              return
           end if
           ! handle column-major and row-major separately
           if (colmajor) then
              ! reduce columns 1, ..., q of x11, x12, x21, and x22
              do i = 1,q
                 if (i == 1) then
                    call la_${ri}$scal(p - i + 1,cmplx(z1,0.0_${rk}$,KIND=${rk}$),x11(i,i),1)
                 else
                    call la_${ri}$scal(p - i + 1,cmplx(z1*cos(phi(i - 1)),0.0_${rk}$,KIND=${rk}$),x11(i,i), &
                              1)
                    call la_${ri}$axpy(p - i + 1,cmplx(-z1*z3*z4*sin(phi(i - 1)),0.0_${rk}$,KIND=${rk}$),x12( &
                              i,i - 1),1,x11(i,i),1)
                 end if
                 if (i == 1) then
                    call la_${ri}$scal(m - p - i + 1,cmplx(z2,0.0_${rk}$,KIND=${rk}$),x21(i,i),1)
                 else
                    call la_${ri}$scal(m - p - i + 1,cmplx(z2*cos(phi(i - 1)),0.0_${rk}$,KIND=${rk}$),x21(i,i), &
                               1)
                    call la_${ri}$axpy(m - p - i + 1,cmplx(-z2*z3*z4*sin(phi(i - 1)),0.0_${rk}$,KIND=${rk}$), &
                              x22(i,i - 1),1,x21(i,i),1)
                 end if
                 theta(i) = atan2(la_${ci}$${ri}$nrm2(m - p - i + 1,x21(i,i),1),la_${ci}$${ri}$nrm2(p - i + 1, &
                           x11(i,i),1))
                 if (p > i) then
                    call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
                 else if (p == i) then
                    call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i,i),1,taup1(i))
                 end if
                 x11(i,i) = cone
                 if (m - p > i) then
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
                 else if (m - p == i) then
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i,i),1,taup2(i))
                 end if
                 x21(i,i) = cone
                 if (q > i) then
                    call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,conjg(taup1(i)),x11(i,i + 1), &
                              ldx11,work)
                    call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,conjg(taup2(i)),x21(i,i + 1), &
                               ldx21,work)
                 end if
                 if (m - q + 1 > i) then
                    call la_${ri}$larf('L',p - i + 1,m - q - i + 1,x11(i,i),1,conjg(taup1(i)),x12(i,i), &
                               ldx12,work)
                    call la_${ri}$larf('L',m - p - i + 1,m - q - i + 1,x21(i,i),1,conjg(taup2(i)),x22(i, &
                              i),ldx22,work)
                 end if
                 if (i < q) then
                    call la_${ri}$scal(q - i,cmplx(-z1*z3*sin(theta(i)),0.0_${rk}$,KIND=${rk}$),x11(i,i + &
                              1),ldx11)
                    call la_${ri}$axpy(q - i,cmplx(z2*z3*cos(theta(i)),0.0_${rk}$,KIND=${rk}$),x21(i,i + 1) &
                              ,ldx21,x11(i,i + 1),ldx11)
                 end if
                 call la_${ri}$scal(m - q - i + 1,cmplx(-z1*z4*sin(theta(i)),0.0_${rk}$,KIND=${rk}$),x12(i,i) &
                           ,ldx12)
                 call la_${ri}$axpy(m - q - i + 1,cmplx(z2*z4*cos(theta(i)),0.0_${rk}$,KIND=${rk}$),x22(i,i), &
                            ldx22,x12(i,i),ldx12)
                 if (i < q) phi(i) = atan2(la_${ci}$${ri}$nrm2(q - i,x11(i,i + 1),ldx11),la_${ci}$${ri}$nrm2( &
                            m - q - i + 1,x12(i,i),ldx12))
                 if (i < q) then
                    call la_${ri}$lacgv(q - i,x11(i,i + 1),ldx11)
                    if (i == q - 1) then
                       call la_${ri}$larfgp(q - i,x11(i,i + 1),x11(i,i + 1),ldx11,tauq1(i))
                    else
                       call la_${ri}$larfgp(q - i,x11(i,i + 1),x11(i,i + 2),ldx11,tauq1(i))
                    end if
                    x11(i,i + 1) = cone
                 end if
                 if (m - q + 1 > i) then
                    call la_${ri}$lacgv(m - q - i + 1,x12(i,i),ldx12)
                    if (m - q == i) then
                       call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i),ldx12,tauq2(i))
                    else
                       call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i + 1),ldx12,tauq2(i))

                    end if
                 end if
                 x12(i,i) = cone
                 if (i < q) then
                    call la_${ri}$larf('R',p - i,q - i,x11(i,i + 1),ldx11,tauq1(i),x11(i + 1,i + 1), &
                              ldx11,work)
                    call la_${ri}$larf('R',m - p - i,q - i,x11(i,i + 1),ldx11,tauq1(i),x21(i + 1,i + 1), &
                              ldx21,work)
                 end if
                 if (p > i) then
                    call la_${ri}$larf('R',p - i,m - q - i + 1,x12(i,i),ldx12,tauq2(i),x12(i + 1,i), &
                              ldx12,work)
                 end if
                 if (m - p > i) then
                    call la_${ri}$larf('R',m - p - i,m - q - i + 1,x12(i,i),ldx12,tauq2(i),x22(i + 1,i), &
                              ldx22,work)
                 end if
                 if (i < q) call la_${ri}$lacgv(q - i,x11(i,i + 1),ldx11)
                 call la_${ri}$lacgv(m - q - i + 1,x12(i,i),ldx12)
              end do
              ! reduce columns q + 1, ..., p of x12, x22
              do i = q + 1,p
                 call la_${ri}$scal(m - q - i + 1,cmplx(-z1*z4,0.0_${rk}$,KIND=${rk}$),x12(i,i),ldx12)

                 call la_${ri}$lacgv(m - q - i + 1,x12(i,i),ldx12)
                 if (i >= m - q) then
                    call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i),ldx12,tauq2(i))
                 else
                    call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i,i + 1),ldx12,tauq2(i))
                 end if
                 x12(i,i) = cone
                 if (p > i) then
                    call la_${ri}$larf('R',p - i,m - q - i + 1,x12(i,i),ldx12,tauq2(i),x12(i + 1,i), &
                              ldx12,work)
                 end if
                 if (m - p - q >= 1) call la_${ri}$larf('R',m - p - q,m - q - i + 1,x12(i,i),ldx12,tauq2(i), &
                            x22(q + 1,i),ldx22,work)
                 call la_${ri}$lacgv(m - q - i + 1,x12(i,i),ldx12)
              end do
              ! reduce columns p + 1, ..., m - q of x12, x22
              do i = 1,m - p - q
                 call la_${ri}$scal(m - p - q - i + 1,cmplx(z2*z4,0.0_${rk}$,KIND=${rk}$),x22(q + i,p + i),ldx22)

                 call la_${ri}$lacgv(m - p - q - i + 1,x22(q + i,p + i),ldx22)
                 call la_${ri}$larfgp(m - p - q - i + 1,x22(q + i,p + i),x22(q + i,p + i + 1),ldx22,tauq2(p + i))

                 x22(q + i,p + i) = cone
                 call la_${ri}$larf('R',m - p - q - i,m - p - q - i + 1,x22(q + i,p + i),ldx22,tauq2(p + i),x22( &
                           q + i + 1,p + i),ldx22,work)
                 call la_${ri}$lacgv(m - p - q - i + 1,x22(q + i,p + i),ldx22)
              end do
           else
              ! reduce columns 1, ..., q of x11, x12, x21, x22
              do i = 1,q
                 if (i == 1) then
                    call la_${ri}$scal(p - i + 1,cmplx(z1,0.0_${rk}$,KIND=${rk}$),x11(i,i),ldx11)
                 else
                    call la_${ri}$scal(p - i + 1,cmplx(z1*cos(phi(i - 1)),0.0_${rk}$,KIND=${rk}$),x11(i,i), &
                              ldx11)
                    call la_${ri}$axpy(p - i + 1,cmplx(-z1*z3*z4*sin(phi(i - 1)),0.0_${rk}$,KIND=${rk}$),x12( &
                              i - 1,i),ldx12,x11(i,i),ldx11)
                 end if
                 if (i == 1) then
                    call la_${ri}$scal(m - p - i + 1,cmplx(z2,0.0_${rk}$,KIND=${rk}$),x21(i,i),ldx21)

                 else
                    call la_${ri}$scal(m - p - i + 1,cmplx(z2*cos(phi(i - 1)),0.0_${rk}$,KIND=${rk}$),x21(i,i), &
                               ldx21)
                    call la_${ri}$axpy(m - p - i + 1,cmplx(-z2*z3*z4*sin(phi(i - 1)),0.0_${rk}$,KIND=${rk}$), &
                              x22(i - 1,i),ldx22,x21(i,i),ldx21)
                 end if
                 theta(i) = atan2(la_${ci}$${ri}$nrm2(m - p - i + 1,x21(i,i),ldx21),la_${ci}$${ri}$nrm2(p - i + 1, &
                            x11(i,i),ldx11))
                 call la_${ri}$lacgv(p - i + 1,x11(i,i),ldx11)
                 call la_${ri}$lacgv(m - p - i + 1,x21(i,i),ldx21)
                 call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i,i + 1),ldx11,taup1(i))
                 x11(i,i) = cone
                 if (i == m - p) then
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i,i),ldx21,taup2(i))
                 else
                    call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i,i + 1),ldx21,taup2(i))
                 end if
                 x21(i,i) = cone
                 call la_${ri}$larf('R',q - i,p - i + 1,x11(i,i),ldx11,taup1(i),x11(i + 1,i),ldx11, &
                           work)
                 call la_${ri}$larf('R',m - q - i + 1,p - i + 1,x11(i,i),ldx11,taup1(i),x12(i,i), &
                           ldx12,work)
                 call la_${ri}$larf('R',q - i,m - p - i + 1,x21(i,i),ldx21,taup2(i),x21(i + 1,i), &
                           ldx21,work)
                 call la_${ri}$larf('R',m - q - i + 1,m - p - i + 1,x21(i,i),ldx21,taup2(i),x22(i,i), &
                           ldx22,work)
                 call la_${ri}$lacgv(p - i + 1,x11(i,i),ldx11)
                 call la_${ri}$lacgv(m - p - i + 1,x21(i,i),ldx21)
                 if (i < q) then
                    call la_${ri}$scal(q - i,cmplx(-z1*z3*sin(theta(i)),0.0_${rk}$,KIND=${rk}$),x11(i + 1, &
                              i),1)
                    call la_${ri}$axpy(q - i,cmplx(z2*z3*cos(theta(i)),0.0_${rk}$,KIND=${rk}$),x21(i + 1,i) &
                              ,1,x11(i + 1,i),1)
                 end if
                 call la_${ri}$scal(m - q - i + 1,cmplx(-z1*z4*sin(theta(i)),0.0_${rk}$,KIND=${rk}$),x12(i,i) &
                           ,1)
                 call la_${ri}$axpy(m - q - i + 1,cmplx(z2*z4*cos(theta(i)),0.0_${rk}$,KIND=${rk}$),x22(i,i), &
                            1,x12(i,i),1)
                 if (i < q) phi(i) = atan2(la_${ci}$${ri}$nrm2(q - i,x11(i + 1,i),1),la_${ci}$${ri}$nrm2(m - &
                           q - i + 1,x12(i,i),1))
                 if (i < q) then
                    call la_${ri}$larfgp(q - i,x11(i + 1,i),x11(i + 2,i),1,tauq1(i))
                    x11(i + 1,i) = cone
                 end if
                 call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i + 1,i),1,tauq2(i))
                 x12(i,i) = cone
                 if (i < q) then
                    call la_${ri}$larf('L',q - i,p - i,x11(i + 1,i),1,conjg(tauq1(i)),x11(i + 1,i + 1), &
                               ldx11,work)
                    call la_${ri}$larf('L',q - i,m - p - i,x11(i + 1,i),1,conjg(tauq1(i)),x21(i + 1,i + &
                              1),ldx21,work)
                 end if
                 call la_${ri}$larf('L',m - q - i + 1,p - i,x12(i,i),1,conjg(tauq2(i)),x12(i,i + 1), &
                           ldx12,work)
                 if (m - p > i) then
                    call la_${ri}$larf('L',m - q - i + 1,m - p - i,x12(i,i),1,conjg(tauq2(i)),x22(i,i + &
                              1),ldx22,work)
                 end if
              end do
              ! reduce columns q + 1, ..., p of x12, x22
              do i = q + 1,p
                 call la_${ri}$scal(m - q - i + 1,cmplx(-z1*z4,0.0_${rk}$,KIND=${rk}$),x12(i,i),1)
                 call la_${ri}$larfgp(m - q - i + 1,x12(i,i),x12(i + 1,i),1,tauq2(i))
                 x12(i,i) = cone
                 if (p > i) then
                    call la_${ri}$larf('L',m - q - i + 1,p - i,x12(i,i),1,conjg(tauq2(i)),x12(i,i + 1), &
                               ldx12,work)
                 end if
                 if (m - p - q >= 1) call la_${ri}$larf('L',m - q - i + 1,m - p - q,x12(i,i),1,conjg(tauq2( &
                           i)),x22(i,q + 1),ldx22,work)
              end do
              ! reduce columns p + 1, ..., m - q of x12, x22
              do i = 1,m - p - q
                 call la_${ri}$scal(m - p - q - i + 1,cmplx(z2*z4,0.0_${rk}$,KIND=${rk}$),x22(p + i,q + i),1)

                 call la_${ri}$larfgp(m - p - q - i + 1,x22(p + i,q + i),x22(p + i + 1,q + i),1,tauq2(p + i))

                 x22(p + i,q + i) = cone
                 if (m - p - q /= i) then
                    call la_${ri}$larf('L',m - p - q - i + 1,m - p - q - i,x22(p + i,q + i),1,conjg(tauq2(p + i)), &
                               x22(p + i,q + i + 1),ldx22,work)
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$unbdb
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB6: orthogonalizes the column vector
     !> X = [ X1 ]
     !> [ X2 ]
     !> with respect to the columns of
     !> Q = [ Q1 ] .
     !> [ Q2 ]
     !> The columns of Q must be orthonormal.
     !> If the projection is zero according to Kahan's "twice is enough"
     !> criterion, then the zero vector is returned.

     pure subroutine la_${ri}$unbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
               lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx1,incx2,ldq1,ldq2,lwork,m1,m2,n
           integer(ilp),intent(out) :: info
           ! Array Arguments
           complex(${rk}$),intent(in) :: q1(ldq1,*),q2(ldq2,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x1(*),x2(*)
        ! =====================================================================
           ! Parameters
           real(${rk}$),parameter :: alphasq = 0.01_${rk}$
           real(${rk}$),parameter :: realone = 1.0_${rk}$
           real(${rk}$),parameter :: realzero = 0.0_${rk}$

           ! Local Scalars
           integer(ilp) :: i
           real(${rk}$) :: normsq1,normsq2,scl1,scl2,ssq1,ssq2
           ! Intrinsic Function
           intrinsic :: max
           ! Executable Statements
           ! test input arguments
           info = 0
           if (m1 < 0) then
              info = -1
           else if (m2 < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (incx1 < 1) then
              info = -5
           else if (incx2 < 1) then
              info = -7
           else if (ldq1 < max(1,m1)) then
              info = -9
           else if (ldq2 < max(1,m2)) then
              info = -11
           else if (lwork < n) then
              info = -13
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNBDB6',-info)
              return
           end if
           ! first, project x onto the orthogonal complement of q's column
           ! space
           scl1 = realzero
           ssq1 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           scl2 = realzero
           ssq2 = realone
           call la_${ri}$lassq(m2,x2,incx2,scl2,ssq2)
           normsq1 = scl1**2*ssq1 + scl2**2*ssq2
           if (m1 == 0) then
              do i = 1,n
                 work(i) = czero
              end do
           else
              call la_${ri}$gemv('C',m1,n,cone,q1,ldq1,x1,incx1,czero,work,1)
           end if
           call la_${ri}$gemv('C',m2,n,cone,q2,ldq2,x2,incx2,cone,work,1)
           call la_${ri}$gemv('N',m1,n,cnegone,q1,ldq1,work,1,cone,x1,incx1)
           call la_${ri}$gemv('N',m2,n,cnegone,q2,ldq2,work,1,cone,x2,incx2)
           scl1 = realzero
           ssq1 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           scl2 = realzero
           ssq2 = realone
           call la_${ri}$lassq(m2,x2,incx2,scl2,ssq2)
           normsq2 = scl1**2*ssq1 + scl2**2*ssq2
           ! if projection is sufficiently large in norm, then stop.
           ! if projection is czero, then stop.
           ! otherwise, project again.
           if (normsq2 >= alphasq*normsq1) then
              return
           end if
           if (normsq2 == czero) then
              return
           end if
           normsq1 = normsq2
           do i = 1,n
              work(i) = czero
           end do
           if (m1 == 0) then
              do i = 1,n
                 work(i) = czero
              end do
           else
              call la_${ri}$gemv('C',m1,n,cone,q1,ldq1,x1,incx1,czero,work,1)
           end if
           call la_${ri}$gemv('C',m2,n,cone,q2,ldq2,x2,incx2,cone,work,1)
           call la_${ri}$gemv('N',m1,n,cnegone,q1,ldq1,work,1,cone,x1,incx1)
           call la_${ri}$gemv('N',m2,n,cnegone,q2,ldq2,work,1,cone,x2,incx2)
           scl1 = realzero
           ssq1 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           scl2 = realzero
           ssq2 = realone
           call la_${ri}$lassq(m1,x1,incx1,scl1,ssq1)
           normsq2 = scl1**2*ssq1 + scl2**2*ssq2
           ! if second projection is sufficiently large in norm, then do
           ! nothing more. alternatively, if it shrunk significantly, then
           ! truncate it to czero.
           if (normsq2 < alphasq*normsq1) then
              do i = 1,m1
                 x1(i) = czero
              end do
              do i = 1,m2
                 x2(i) = czero
              end do
           end if
           return
     end subroutine la_${ri}$unbdb6
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$BBCSD: computes the CS decomposition of a unitary matrix in
     !> bidiagonal-block form,
     !> [ B11 | B12 0  0 ]
     !> [  0  |  0 -I  0 ]
     !> X = [----------------]
     !> [ B21 | B22 0  0 ]
     !> [  0  |  0  0  I ]
     !> [  C | -S  0  0 ]
     !> [ U1 |    ] [  0 |  0 -I  0 ] [ V1 |    ]**H
     !> = [---------] [---------------] [---------]   .
     !> [    | U2 ] [  S |  C  0  0 ] [    | V2 ]
     !> [  0 |  0  0  I ]
     !> X is M-by-M, its top-left block is P-by-Q, and Q must be no larger
     !> than P, M-P, or M-Q. (If Q is not the smallest index, then X must be
     !> transposed and/or permuted. This can be done in constant time using
     !> the TRANS and SIGNS options. See ${ri.upper()}$UNCSD for details.)
     !> The bidiagonal matrices B11, B12, B21, and B22 are represented
     !> implicitly by angles THETA(1:Q) and PHI(1:Q-1).
     !> The unitary matrices U1, U2, V1T, and V2T are input/output.
     !> The input matrices are pre- or post-multiplied by the appropriate
     !> singular vector matrices.

     pure subroutine la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,theta,phi,u1, &
     ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,b11d,b11e,b12d,b12e,b21d,b21e,b22d,b22e,rwork, &
               lrwork,info)
        use la_constants_${rk}$,only:zero,one,ten,cnegone
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu1,jobu2,jobv1t,jobv2t,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldu1,ldu2,ldv1t,ldv2t,lrwork,m,p,q
           ! Array Arguments
           real(${rk}$),intent(out) :: b11d(*),b11e(*),b12d(*),b12e(*),b21d(*),b21e(*),b22d(*), &
                      b22e(*),rwork(*)
           real(${rk}$),intent(inout) :: phi(*),theta(*)
           complex(${rk}$),intent(inout) :: u1(ldu1,*),u2(ldu2,*),v1t(ldv1t,*),v2t(ldv2t,*)

        ! ===================================================================
           ! Parameters
           integer(ilp),parameter :: maxitr = 6
           real(${rk}$),parameter :: hundred = 100.0_${rk}$
           real(${rk}$),parameter :: meighth = -0.125_${rk}$
           real(${rk}$),parameter :: piover2 = 1.57079632679489661923132169163975144210_${rk}$

           ! Local Scalars
           logical(lk) :: colmajor,lquery,restart11,restart12,restart21,restart22,wantu1, &
                     wantu2,wantv1t,wantv2t
           integer(ilp) :: i,imin,imax,iter,iu1cs,iu1sn,iu2cs,iu2sn,iv1tcs,iv1tsn, &
                     iv2tcs,iv2tsn,j,lrworkmin,lrworkopt,maxit,mini
           real(${rk}$) :: b11bulge,b12bulge,b21bulge,b22bulge,dummy,eps,mu,nu,r,sigma11, &
                     sigma21,temp,thetamax,thetamin,thresh,tol,tolmul,unfl,x1,x2,y1,y2
           ! Intrinsic Functions
           intrinsic :: abs,atan2,cos,max,min,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lrwork == -1
           wantu1 = la_lsame(jobu1,'Y')
           wantu2 = la_lsame(jobu2,'Y')
           wantv1t = la_lsame(jobv1t,'Y')
           wantv2t = la_lsame(jobv2t,'Y')
           colmajor = .not. la_lsame(trans,'T')
           if (m < 0) then
              info = -6
           else if (p < 0 .or. p > m) then
              info = -7
           else if (q < 0 .or. q > m) then
              info = -8
           else if (q > p .or. q > m - p .or. q > m - q) then
              info = -8
           else if (wantu1 .and. ldu1 < p) then
              info = -12
           else if (wantu2 .and. ldu2 < m - p) then
              info = -14
           else if (wantv1t .and. ldv1t < q) then
              info = -16
           else if (wantv2t .and. ldv2t < m - q) then
              info = -18
           end if
           ! quick return if q = 0
           if (info == 0 .and. q == 0) then
              lrworkmin = 1
              rwork(1) = lrworkmin
              return
           end if
           ! compute workspace
           if (info == 0) then
              iu1cs = 1
              iu1sn = iu1cs + q
              iu2cs = iu1sn + q
              iu2sn = iu2cs + q
              iv1tcs = iu2sn + q
              iv1tsn = iv1tcs + q
              iv2tcs = iv1tsn + q
              iv2tsn = iv2tcs + q
              lrworkopt = iv2tsn + q - 1
              lrworkmin = lrworkopt
              rwork(1) = lrworkopt
              if (lrwork < lrworkmin .and. .not. lquery) then
                 info = -28
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$BBCSD',-info)
              return
           else if (lquery) then
              return
           end if
           ! get machine constants
           eps = la_${ci}$lamch('EPSILON')
           unfl = la_${ci}$lamch('SAFE MINIMUM')
           tolmul = max(ten,min(hundred,eps**meighth))
           tol = tolmul*eps
           thresh = max(tol,maxitr*q*q*unfl)
           ! test for negligible sines or cosines
           do i = 1,q
              if (theta(i) < thresh) then
                 theta(i) = zero
              else if (theta(i) > piover2 - thresh) then
                 theta(i) = piover2
              end if
           end do
           do i = 1,q - 1
              if (phi(i) < thresh) then
                 phi(i) = zero
              else if (phi(i) > piover2 - thresh) then
                 phi(i) = piover2
              end if
           end do
           ! initial deflation
           imax = q
           do while (imax > 1)
              if (phi(imax - 1) /= zero) then
                 exit
              end if
              imax = imax - 1
           end do
           imin = imax - 1
           if (imin > 1) then
              do while (phi(imin - 1) /= zero)
                 imin = imin - 1
                 if (imin <= 1) exit
              end do
           end if
           ! initialize iteration counter
           maxit = maxitr*q*q
           iter = 0
           ! begin main iteration loop
           do while (imax > 1)
              ! compute the matrix entries
              b11d(imin) = cos(theta(imin))
              b21d(imin) = -sin(theta(imin))
              do i = imin,imax - 1
                 b11e(i) = -sin(theta(i))*sin(phi(i))
                 b11d(i + 1) = cos(theta(i + 1))*cos(phi(i))
                 b12d(i) = sin(theta(i))*cos(phi(i))
                 b12e(i) = cos(theta(i + 1))*sin(phi(i))
                 b21e(i) = -cos(theta(i))*sin(phi(i))
                 b21d(i + 1) = -sin(theta(i + 1))*cos(phi(i))
                 b22d(i) = cos(theta(i))*cos(phi(i))
                 b22e(i) = -sin(theta(i + 1))*sin(phi(i))
              end do
              b12d(imax) = sin(theta(imax))
              b22d(imax) = cos(theta(imax))
              ! abort if not converging; otherwise, increment iter
              if (iter > maxit) then
                 info = 0
                 do i = 1,q
                    if (phi(i) /= zero) info = info + 1
                 end do
                 return
              end if
              iter = iter + imax - imin
              ! compute shifts
              thetamax = theta(imin)
              thetamin = theta(imin)
              do i = imin + 1,imax
                 if (theta(i) > thetamax) thetamax = theta(i)
                 if (theta(i) < thetamin) thetamin = theta(i)
              end do
              if (thetamax > piover2 - thresh) then
                 ! zero on diagonals of b11 and b22; induce deflation with a
                 ! zero shift
                 mu = zero
                 nu = one
              else if (thetamin < thresh) then
                 ! zero on diagonals of b12 and b22; induce deflation with a
                 ! zero shift
                 mu = one
                 nu = zero
              else
                 ! compute shifts for b11 and b21 and use the lesser
                 call la_${ci}$las2(b11d(imax - 1),b11e(imax - 1),b11d(imax),sigma11,dummy)

                 call la_${ci}$las2(b21d(imax - 1),b21e(imax - 1),b21d(imax),sigma21,dummy)

                 if (sigma11 <= sigma21) then
                    mu = sigma11
                    nu = sqrt(one - mu**2)
                    if (mu < thresh) then
                       mu = zero
                       nu = one
                    end if
                 else
                    nu = sigma21
                    mu = sqrt(1.0_${rk}$ - nu**2)
                    if (nu < thresh) then
                       mu = one
                       nu = zero
                    end if
                 end if
              end if
              ! rotate to produce bulges in b11 and b21
              if (mu <= nu) then
                 call la_${ci}$lartgs(b11d(imin),b11e(imin),mu,rwork(iv1tcs + imin - 1),rwork( &
                           iv1tsn + imin - 1))
              else
                 call la_${ci}$lartgs(b21d(imin),b21e(imin),nu,rwork(iv1tcs + imin - 1),rwork( &
                           iv1tsn + imin - 1))
              end if
              temp = rwork(iv1tcs + imin - 1)*b11d(imin) + rwork(iv1tsn + imin - 1)*b11e(imin)
              b11e(imin) = rwork(iv1tcs + imin - 1)*b11e(imin) - rwork(iv1tsn + imin - 1)*b11d(imin)

              b11d(imin) = temp
              b11bulge = rwork(iv1tsn + imin - 1)*b11d(imin + 1)
              b11d(imin + 1) = rwork(iv1tcs + imin - 1)*b11d(imin + 1)
              temp = rwork(iv1tcs + imin - 1)*b21d(imin) + rwork(iv1tsn + imin - 1)*b21e(imin)
              b21e(imin) = rwork(iv1tcs + imin - 1)*b21e(imin) - rwork(iv1tsn + imin - 1)*b21d(imin)

              b21d(imin) = temp
              b21bulge = rwork(iv1tsn + imin - 1)*b21d(imin + 1)
              b21d(imin + 1) = rwork(iv1tcs + imin - 1)*b21d(imin + 1)
              ! compute theta(imin)
              theta(imin) = atan2(sqrt(b21d(imin)**2 + b21bulge**2),sqrt(b11d(imin)**2 + &
                        b11bulge**2))
              ! chase the bulges in b11(imin+1,imin) and b21(imin+1,imin)
              if (b11d(imin)**2 + b11bulge**2 > thresh**2) then
                 call la_${ci}$lartgp(b11bulge,b11d(imin),rwork(iu1sn + imin - 1),rwork(iu1cs + imin - &
                           1),r)
              else if (mu <= nu) then
                 call la_${ci}$lartgs(b11e(imin),b11d(imin + 1),mu,rwork(iu1cs + imin - 1), &
                           rwork(iu1sn + imin - 1))
              else
                 call la_${ci}$lartgs(b12d(imin),b12e(imin),nu,rwork(iu1cs + imin - 1),rwork( &
                           iu1sn + imin - 1))
              end if
              if (b21d(imin)**2 + b21bulge**2 > thresh**2) then
                 call la_${ci}$lartgp(b21bulge,b21d(imin),rwork(iu2sn + imin - 1),rwork(iu2cs + imin - &
                           1),r)
              else if (nu < mu) then
                 call la_${ci}$lartgs(b21e(imin),b21d(imin + 1),nu,rwork(iu2cs + imin - 1), &
                           rwork(iu2sn + imin - 1))
              else
                 call la_${ci}$lartgs(b22d(imin),b22e(imin),mu,rwork(iu2cs + imin - 1),rwork(iu2sn + &
                           imin - 1))
              end if
              rwork(iu2cs + imin - 1) = -rwork(iu2cs + imin - 1)
              rwork(iu2sn + imin - 1) = -rwork(iu2sn + imin - 1)
              temp = rwork(iu1cs + imin - 1)*b11e(imin) + rwork(iu1sn + imin - 1)*b11d(imin + 1)
              b11d(imin + 1) = rwork(iu1cs + imin - 1)*b11d(imin + 1) - rwork(iu1sn + imin - 1)*b11e(imin)

              b11e(imin) = temp
              if (imax > imin + 1) then
                 b11bulge = rwork(iu1sn + imin - 1)*b11e(imin + 1)
                 b11e(imin + 1) = rwork(iu1cs + imin - 1)*b11e(imin + 1)
              end if
              temp = rwork(iu1cs + imin - 1)*b12d(imin) + rwork(iu1sn + imin - 1)*b12e(imin)
              b12e(imin) = rwork(iu1cs + imin - 1)*b12e(imin) - rwork(iu1sn + imin - 1)*b12d(imin)
              b12d(imin) = temp
              b12bulge = rwork(iu1sn + imin - 1)*b12d(imin + 1)
              b12d(imin + 1) = rwork(iu1cs + imin - 1)*b12d(imin + 1)
              temp = rwork(iu2cs + imin - 1)*b21e(imin) + rwork(iu2sn + imin - 1)*b21d(imin + 1)
              b21d(imin + 1) = rwork(iu2cs + imin - 1)*b21d(imin + 1) - rwork(iu2sn + imin - 1)*b21e(imin)

              b21e(imin) = temp
              if (imax > imin + 1) then
                 b21bulge = rwork(iu2sn + imin - 1)*b21e(imin + 1)
                 b21e(imin + 1) = rwork(iu2cs + imin - 1)*b21e(imin + 1)
              end if
              temp = rwork(iu2cs + imin - 1)*b22d(imin) + rwork(iu2sn + imin - 1)*b22e(imin)
              b22e(imin) = rwork(iu2cs + imin - 1)*b22e(imin) - rwork(iu2sn + imin - 1)*b22d(imin)
              b22d(imin) = temp
              b22bulge = rwork(iu2sn + imin - 1)*b22d(imin + 1)
              b22d(imin + 1) = rwork(iu2cs + imin - 1)*b22d(imin + 1)
              ! inner loop: chase bulges from b11(imin,imin+2),
              ! b12(imin,imin+1), b21(imin,imin+2), and b22(imin,imin+1) to
              ! bottom-right
              do i = imin + 1,imax - 1
                 ! compute phi(i-1)
                 x1 = sin(theta(i - 1))*b11e(i - 1) + cos(theta(i - 1))*b21e(i - 1)
                 x2 = sin(theta(i - 1))*b11bulge + cos(theta(i - 1))*b21bulge
                 y1 = sin(theta(i - 1))*b12d(i - 1) + cos(theta(i - 1))*b22d(i - 1)
                 y2 = sin(theta(i - 1))*b12bulge + cos(theta(i - 1))*b22bulge
                 phi(i - 1) = atan2(sqrt(x1**2 + x2**2),sqrt(y1**2 + y2**2))
                 ! determine if there are bulges to chase or if a new direct
                 ! summand has been reached
                 restart11 = b11e(i - 1)**2 + b11bulge**2 <= thresh**2
                 restart21 = b21e(i - 1)**2 + b21bulge**2 <= thresh**2
                 restart12 = b12d(i - 1)**2 + b12bulge**2 <= thresh**2
                 restart22 = b22d(i - 1)**2 + b22bulge**2 <= thresh**2
                 ! if possible, chase bulges from b11(i-1,i+1), b12(i-1,i),
                 ! b21(i-1,i+1), and b22(i-1,i). if necessary, restart bulge-
                 ! chasing by applying the original shift again.
                 if (.not. restart11 .and. .not. restart21) then
                    call la_${ci}$lartgp(x2,x1,rwork(iv1tsn + i - 1),rwork(iv1tcs + i - 1),r)
                 else if (.not. restart11 .and. restart21) then
                    call la_${ci}$lartgp(b11bulge,b11e(i - 1),rwork(iv1tsn + i - 1),rwork(iv1tcs + i - 1), &
                               r)
                 else if (restart11 .and. .not. restart21) then
                    call la_${ci}$lartgp(b21bulge,b21e(i - 1),rwork(iv1tsn + i - 1),rwork(iv1tcs + i - 1), &
                               r)
                 else if (mu <= nu) then
                    call la_${ci}$lartgs(b11d(i),b11e(i),mu,rwork(iv1tcs + i - 1),rwork(iv1tsn + i - 1) &
                               )
                 else
                    call la_${ci}$lartgs(b21d(i),b21e(i),nu,rwork(iv1tcs + i - 1),rwork(iv1tsn + i - 1) &
                               )
                 end if
                 rwork(iv1tcs + i - 1) = -rwork(iv1tcs + i - 1)
                 rwork(iv1tsn + i - 1) = -rwork(iv1tsn + i - 1)
                 if (.not. restart12 .and. .not. restart22) then
                    call la_${ci}$lartgp(y2,y1,rwork(iv2tsn + i - 1 - 1),rwork(iv2tcs + i - 1 - 1),r)

                 else if (.not. restart12 .and. restart22) then
                    call la_${ci}$lartgp(b12bulge,b12d(i - 1),rwork(iv2tsn + i - 1 - 1),rwork(iv2tcs + i - &
                              1 - 1),r)
                 else if (restart12 .and. .not. restart22) then
                    call la_${ci}$lartgp(b22bulge,b22d(i - 1),rwork(iv2tsn + i - 1 - 1),rwork(iv2tcs + i - &
                              1 - 1),r)
                 else if (nu < mu) then
                    call la_${ci}$lartgs(b12e(i - 1),b12d(i),nu,rwork(iv2tcs + i - 1 - 1),rwork(iv2tsn + &
                              i - 1 - 1))
                 else
                    call la_${ci}$lartgs(b22e(i - 1),b22d(i),mu,rwork(iv2tcs + i - 1 - 1),rwork(iv2tsn + &
                              i - 1 - 1))
                 end if
                 temp = rwork(iv1tcs + i - 1)*b11d(i) + rwork(iv1tsn + i - 1)*b11e(i)
                 b11e(i) = rwork(iv1tcs + i - 1)*b11e(i) - rwork(iv1tsn + i - 1)*b11d(i)
                 b11d(i) = temp
                 b11bulge = rwork(iv1tsn + i - 1)*b11d(i + 1)
                 b11d(i + 1) = rwork(iv1tcs + i - 1)*b11d(i + 1)
                 temp = rwork(iv1tcs + i - 1)*b21d(i) + rwork(iv1tsn + i - 1)*b21e(i)
                 b21e(i) = rwork(iv1tcs + i - 1)*b21e(i) - rwork(iv1tsn + i - 1)*b21d(i)
                 b21d(i) = temp
                 b21bulge = rwork(iv1tsn + i - 1)*b21d(i + 1)
                 b21d(i + 1) = rwork(iv1tcs + i - 1)*b21d(i + 1)
                 temp = rwork(iv2tcs + i - 1 - 1)*b12e(i - 1) + rwork(iv2tsn + i - 1 - 1)*b12d(i)
                 b12d(i) = rwork(iv2tcs + i - 1 - 1)*b12d(i) - rwork(iv2tsn + i - 1 - 1)*b12e(i - 1)
                 b12e(i - 1) = temp
                 b12bulge = rwork(iv2tsn + i - 1 - 1)*b12e(i)
                 b12e(i) = rwork(iv2tcs + i - 1 - 1)*b12e(i)
                 temp = rwork(iv2tcs + i - 1 - 1)*b22e(i - 1) + rwork(iv2tsn + i - 1 - 1)*b22d(i)
                 b22d(i) = rwork(iv2tcs + i - 1 - 1)*b22d(i) - rwork(iv2tsn + i - 1 - 1)*b22e(i - 1)
                 b22e(i - 1) = temp
                 b22bulge = rwork(iv2tsn + i - 1 - 1)*b22e(i)
                 b22e(i) = rwork(iv2tcs + i - 1 - 1)*b22e(i)
                 ! compute theta(i)
                 x1 = cos(phi(i - 1))*b11d(i) + sin(phi(i - 1))*b12e(i - 1)
                 x2 = cos(phi(i - 1))*b11bulge + sin(phi(i - 1))*b12bulge
                 y1 = cos(phi(i - 1))*b21d(i) + sin(phi(i - 1))*b22e(i - 1)
                 y2 = cos(phi(i - 1))*b21bulge + sin(phi(i - 1))*b22bulge
                 theta(i) = atan2(sqrt(y1**2 + y2**2),sqrt(x1**2 + x2**2))
                 ! determine if there are bulges to chase or if a new direct
                 ! summand has been reached
                 restart11 = b11d(i)**2 + b11bulge**2 <= thresh**2
                 restart12 = b12e(i - 1)**2 + b12bulge**2 <= thresh**2
                 restart21 = b21d(i)**2 + b21bulge**2 <= thresh**2
                 restart22 = b22e(i - 1)**2 + b22bulge**2 <= thresh**2
                 ! if possible, chase bulges from b11(i+1,i), b12(i+1,i-1),
                 ! b21(i+1,i), and b22(i+1,i-1). if necessary, restart bulge-
                 ! chasing by applying the original shift again.
                 if (.not. restart11 .and. .not. restart12) then
                    call la_${ci}$lartgp(x2,x1,rwork(iu1sn + i - 1),rwork(iu1cs + i - 1),r)
                 else if (.not. restart11 .and. restart12) then
                    call la_${ci}$lartgp(b11bulge,b11d(i),rwork(iu1sn + i - 1),rwork(iu1cs + i - 1),r)

                 else if (restart11 .and. .not. restart12) then
                    call la_${ci}$lartgp(b12bulge,b12e(i - 1),rwork(iu1sn + i - 1),rwork(iu1cs + i - 1), &
                              r)
                 else if (mu <= nu) then
                    call la_${ci}$lartgs(b11e(i),b11d(i + 1),mu,rwork(iu1cs + i - 1),rwork(iu1sn + i - 1) &
                               )
                 else
                    call la_${ci}$lartgs(b12d(i),b12e(i),nu,rwork(iu1cs + i - 1),rwork(iu1sn + i - 1))

                 end if
                 if (.not. restart21 .and. .not. restart22) then
                    call la_${ci}$lartgp(y2,y1,rwork(iu2sn + i - 1),rwork(iu2cs + i - 1),r)
                 else if (.not. restart21 .and. restart22) then
                    call la_${ci}$lartgp(b21bulge,b21d(i),rwork(iu2sn + i - 1),rwork(iu2cs + i - 1),r)

                 else if (restart21 .and. .not. restart22) then
                    call la_${ci}$lartgp(b22bulge,b22e(i - 1),rwork(iu2sn + i - 1),rwork(iu2cs + i - 1), &
                              r)
                 else if (nu < mu) then
                    call la_${ci}$lartgs(b21e(i),b21e(i + 1),nu,rwork(iu2cs + i - 1),rwork(iu2sn + i - 1) &
                               )
                 else
                    call la_${ci}$lartgs(b22d(i),b22e(i),mu,rwork(iu2cs + i - 1),rwork(iu2sn + i - 1))

                 end if
                 rwork(iu2cs + i - 1) = -rwork(iu2cs + i - 1)
                 rwork(iu2sn + i - 1) = -rwork(iu2sn + i - 1)
                 temp = rwork(iu1cs + i - 1)*b11e(i) + rwork(iu1sn + i - 1)*b11d(i + 1)
                 b11d(i + 1) = rwork(iu1cs + i - 1)*b11d(i + 1) - rwork(iu1sn + i - 1)*b11e(i)
                 b11e(i) = temp
                 if (i < imax - 1) then
                    b11bulge = rwork(iu1sn + i - 1)*b11e(i + 1)
                    b11e(i + 1) = rwork(iu1cs + i - 1)*b11e(i + 1)
                 end if
                 temp = rwork(iu2cs + i - 1)*b21e(i) + rwork(iu2sn + i - 1)*b21d(i + 1)
                 b21d(i + 1) = rwork(iu2cs + i - 1)*b21d(i + 1) - rwork(iu2sn + i - 1)*b21e(i)
                 b21e(i) = temp
                 if (i < imax - 1) then
                    b21bulge = rwork(iu2sn + i - 1)*b21e(i + 1)
                    b21e(i + 1) = rwork(iu2cs + i - 1)*b21e(i + 1)
                 end if
                 temp = rwork(iu1cs + i - 1)*b12d(i) + rwork(iu1sn + i - 1)*b12e(i)
                 b12e(i) = rwork(iu1cs + i - 1)*b12e(i) - rwork(iu1sn + i - 1)*b12d(i)
                 b12d(i) = temp
                 b12bulge = rwork(iu1sn + i - 1)*b12d(i + 1)
                 b12d(i + 1) = rwork(iu1cs + i - 1)*b12d(i + 1)
                 temp = rwork(iu2cs + i - 1)*b22d(i) + rwork(iu2sn + i - 1)*b22e(i)
                 b22e(i) = rwork(iu2cs + i - 1)*b22e(i) - rwork(iu2sn + i - 1)*b22d(i)
                 b22d(i) = temp
                 b22bulge = rwork(iu2sn + i - 1)*b22d(i + 1)
                 b22d(i + 1) = rwork(iu2cs + i - 1)*b22d(i + 1)
              end do
              ! compute phi(imax-1)
              x1 = sin(theta(imax - 1))*b11e(imax - 1) + cos(theta(imax - 1))*b21e(imax - 1)
              y1 = sin(theta(imax - 1))*b12d(imax - 1) + cos(theta(imax - 1))*b22d(imax - 1)
              y2 = sin(theta(imax - 1))*b12bulge + cos(theta(imax - 1))*b22bulge
              phi(imax - 1) = atan2(abs(x1),sqrt(y1**2 + y2**2))
              ! chase bulges from b12(imax-1,imax) and b22(imax-1,imax)
              restart12 = b12d(imax - 1)**2 + b12bulge**2 <= thresh**2
              restart22 = b22d(imax - 1)**2 + b22bulge**2 <= thresh**2
              if (.not. restart12 .and. .not. restart22) then
                 call la_${ci}$lartgp(y2,y1,rwork(iv2tsn + imax - 1 - 1),rwork(iv2tcs + imax - 1 - 1),r)

              else if (.not. restart12 .and. restart22) then
                 call la_${ci}$lartgp(b12bulge,b12d(imax - 1),rwork(iv2tsn + imax - 1 - 1),rwork(iv2tcs + &
                           imax - 1 - 1),r)
              else if (restart12 .and. .not. restart22) then
                 call la_${ci}$lartgp(b22bulge,b22d(imax - 1),rwork(iv2tsn + imax - 1 - 1),rwork(iv2tcs + &
                           imax - 1 - 1),r)
              else if (nu < mu) then
                 call la_${ci}$lartgs(b12e(imax - 1),b12d(imax),nu,rwork(iv2tcs + imax - 1 - 1),rwork( &
                           iv2tsn + imax - 1 - 1))
              else
                 call la_${ci}$lartgs(b22e(imax - 1),b22d(imax),mu,rwork(iv2tcs + imax - 1 - 1),rwork( &
                           iv2tsn + imax - 1 - 1))
              end if
              temp = rwork(iv2tcs + imax - 1 - 1)*b12e(imax - 1) + rwork(iv2tsn + imax - 1 - 1)*b12d(imax)

              b12d(imax) = rwork(iv2tcs + imax - 1 - 1)*b12d(imax) - rwork(iv2tsn + imax - 1 - 1)*b12e(imax - 1)

              b12e(imax - 1) = temp
              temp = rwork(iv2tcs + imax - 1 - 1)*b22e(imax - 1) + rwork(iv2tsn + imax - 1 - 1)*b22d(imax)

              b22d(imax) = rwork(iv2tcs + imax - 1 - 1)*b22d(imax) - rwork(iv2tsn + imax - 1 - 1)*b22e(imax - 1)

              b22e(imax - 1) = temp
              ! update singular vectors
              if (wantu1) then
                 if (colmajor) then
                    call la_${ri}$lasr('R','V','F',p,imax - imin + 1,rwork(iu1cs + imin - 1),rwork( &
                              iu1sn + imin - 1),u1(1,imin),ldu1)
                 else
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,p,rwork(iu1cs + imin - 1),rwork( &
                              iu1sn + imin - 1),u1(imin,1),ldu1)
                 end if
              end if
              if (wantu2) then
                 if (colmajor) then
                    call la_${ri}$lasr('R','V','F',m - p,imax - imin + 1,rwork(iu2cs + imin - 1),rwork( &
                              iu2sn + imin - 1),u2(1,imin),ldu2)
                 else
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,m - p,rwork(iu2cs + imin - 1),rwork( &
                              iu2sn + imin - 1),u2(imin,1),ldu2)
                 end if
              end if
              if (wantv1t) then
                 if (colmajor) then
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,q,rwork(iv1tcs + imin - 1),rwork( &
                              iv1tsn + imin - 1),v1t(imin,1),ldv1t)
                 else
                    call la_${ri}$lasr('R','V','F',q,imax - imin + 1,rwork(iv1tcs + imin - 1),rwork( &
                              iv1tsn + imin - 1),v1t(1,imin),ldv1t)
                 end if
              end if
              if (wantv2t) then
                 if (colmajor) then
                    call la_${ri}$lasr('L','V','F',imax - imin + 1,m - q,rwork(iv2tcs + imin - 1), &
                              rwork(iv2tsn + imin - 1),v2t(imin,1),ldv2t)
                 else
                    call la_${ri}$lasr('R','V','F',m - q,imax - imin + 1,rwork(iv2tcs + imin - 1), &
                              rwork(iv2tsn + imin - 1),v2t(1,imin),ldv2t)
                 end if
              end if
              ! fix signs on b11(imax-1,imax) and b21(imax-1,imax)
              if (b11e(imax - 1) + b21e(imax - 1) > 0) then
                 b11d(imax) = -b11d(imax)
                 b21d(imax) = -b21d(imax)
                 if (wantv1t) then
                    if (colmajor) then
                       call la_${ri}$scal(q,cnegone,v1t(imax,1),ldv1t)
                    else
                       call la_${ri}$scal(q,cnegone,v1t(1,imax),1)
                    end if
                 end if
              end if
              ! compute theta(imax)
              x1 = cos(phi(imax - 1))*b11d(imax) + sin(phi(imax - 1))*b12e(imax - 1)
              y1 = cos(phi(imax - 1))*b21d(imax) + sin(phi(imax - 1))*b22e(imax - 1)
              theta(imax) = atan2(abs(y1),abs(x1))
              ! fix signs on b11(imax,imax), b12(imax,imax-1), b21(imax,imax),
              ! and b22(imax,imax-1)
              if (b11d(imax) + b12e(imax - 1) < 0) then
                 b12d(imax) = -b12d(imax)
                 if (wantu1) then
                    if (colmajor) then
                       call la_${ri}$scal(p,cnegone,u1(1,imax),1)
                    else
                       call la_${ri}$scal(p,cnegone,u1(imax,1),ldu1)
                    end if
                 end if
              end if
              if (b21d(imax) + b22e(imax - 1) > 0) then
                 b22d(imax) = -b22d(imax)
                 if (wantu2) then
                    if (colmajor) then
                       call la_${ri}$scal(m - p,cnegone,u2(1,imax),1)
                    else
                       call la_${ri}$scal(m - p,cnegone,u2(imax,1),ldu2)
                    end if
                 end if
              end if
              ! fix signs on b12(imax,imax) and b22(imax,imax)
              if (b12d(imax) + b22d(imax) < 0) then
                 if (wantv2t) then
                    if (colmajor) then
                       call la_${ri}$scal(m - q,cnegone,v2t(imax,1),ldv2t)
                    else
                       call la_${ri}$scal(m - q,cnegone,v2t(1,imax),1)
                    end if
                 end if
              end if
              ! test for negligible sines or cosines
              do i = imin,imax
                 if (theta(i) < thresh) then
                    theta(i) = zero
                 else if (theta(i) > piover2 - thresh) then
                    theta(i) = piover2
                 end if
              end do
              do i = imin,imax - 1
                 if (phi(i) < thresh) then
                    phi(i) = zero
                 else if (phi(i) > piover2 - thresh) then
                    phi(i) = piover2
                 end if
              end do
              ! deflate
              if (imax > 1) then
                 do while (phi(imax - 1) == zero)
                    imax = imax - 1
                    if (imax <= 1) exit
                 end do
              end if
              if (imin > imax - 1) imin = imax - 1
              if (imin > 1) then
                 do while (phi(imin - 1) /= zero)
                     imin = imin - 1
                     if (imin <= 1) exit
                 end do
              end if
              ! repeat main iteration loop
           end do
           ! postprocessing: order theta from least to greatest
           do i = 1,q
              mini = i
              thetamin = theta(i)
              do j = i + 1,q
                 if (theta(j) < thetamin) then
                    mini = j
                    thetamin = theta(j)
                 end if
              end do
              if (mini /= i) then
                 theta(mini) = theta(i)
                 theta(i) = thetamin
                 if (colmajor) then
                    if (wantu1) call la_${ri}$swap(p,u1(1,i),1,u1(1,mini),1)
                    if (wantu2) call la_${ri}$swap(m - p,u2(1,i),1,u2(1,mini),1)
                    if (wantv1t) call la_${ri}$swap(q,v1t(i,1),ldv1t,v1t(mini,1),ldv1t)

                    if (wantv2t) call la_${ri}$swap(m - q,v2t(i,1),ldv2t,v2t(mini,1),ldv2t)

                 else
                    if (wantu1) call la_${ri}$swap(p,u1(i,1),ldu1,u1(mini,1),ldu1)
                    if (wantu2) call la_${ri}$swap(m - p,u2(i,1),ldu2,u2(mini,1),ldu2)
                    if (wantv1t) call la_${ri}$swap(q,v1t(1,i),1,v1t(1,mini),1)
                    if (wantv2t) call la_${ri}$swap(m - q,v2t(1,i),1,v2t(1,mini),1)
                 end if
              end if
           end do
           return
     end subroutine la_${ri}$bbcsd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB5: orthogonalizes the column vector
     !> X = [ X1 ]
     !> [ X2 ]
     !> with respect to the columns of
     !> Q = [ Q1 ] .
     !> [ Q2 ]
     !> The columns of Q must be orthonormal.
     !> If the projection is zero according to Kahan's "twice is enough"
     !> criterion, then some other vector from the orthogonal complement
     !> is returned. This vector is chosen in an arbitrary but deterministic
     !> way.

     pure subroutine la_${ri}$unbdb5(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
               lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: incx1,incx2,ldq1,ldq2,lwork,m1,m2,n
           integer(ilp),intent(out) :: info
           ! Array Arguments
           complex(${rk}$),intent(in) :: q1(ldq1,*),q2(ldq2,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: x1(*),x2(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: childinfo,i,j
           ! Intrinsic Function
           intrinsic :: max
           ! Executable Statements
           ! test input arguments
           info = 0
           if (m1 < 0) then
              info = -1
           else if (m2 < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (incx1 < 1) then
              info = -5
           else if (incx2 < 1) then
              info = -7
           else if (ldq1 < max(1,m1)) then
              info = -9
           else if (ldq2 < max(1,m2)) then
              info = -11
           else if (lwork < n) then
              info = -13
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNBDB5',-info)
              return
           end if
           ! project x onto the orthogonal complement of q
           call la_${ri}$unbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work,lwork, &
                     childinfo)
           ! if the projection is nonzero, then return
           if (la_${ci}$${ri}$nrm2(m1,x1,incx1) /= czero .or. la_${ci}$${ri}$nrm2(m2,x2,incx2) /= czero) &
                     then
              return
           end if
           ! project each standard basis vector e_1,...,e_m1 in turn, stopping
           ! when a nonzero projection is found
           do i = 1,m1
              do j = 1,m1
                 x1(j) = czero
              end do
              x1(i) = cone
              do j = 1,m2
                 x2(j) = czero
              end do
              call la_${ri}$unbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
                        lwork,childinfo)
              if (la_${ci}$${ri}$nrm2(m1,x1,incx1) /= czero .or. la_${ci}$${ri}$nrm2(m2,x2,incx2) /= czero) &
                        then
                 return
              end if
           end do
           ! project each standard basis vector e_(m1+1),...,e_(m1+m2) in turn,
           ! stopping when a nonzero projection is found
           do i = 1,m2
              do j = 1,m1
                 x1(j) = czero
              end do
              do j = 1,m2
                 x2(j) = czero
              end do
              x2(i) = cone
              call la_${ri}$unbdb6(m1,m2,n,x1,incx1,x2,incx2,q1,ldq1,q2,ldq2,work, &
                        lwork,childinfo)
              if (la_${ci}$${ri}$nrm2(m1,x1,incx1) /= czero .or. la_${ci}$${ri}$nrm2(m2,x2,incx2) /= czero) &
                        then
                 return
              end if
           end do
           return
     end subroutine la_${ri}$unbdb5
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNCSD: computes the CS decomposition of an M-by-M partitioned
     !> unitary matrix X:
     !> [  I  0  0 |  0  0  0 ]
     !> [  0  C  0 |  0 -S  0 ]
     !> [ X11 | X12 ]   [ U1 |    ] [  0  0  0 |  0  0 -I ] [ V1 |    ]**H
     !> X = [-----------] = [---------] [---------------------] [---------]   .
     !> [ X21 | X22 ]   [    | U2 ] [  0  0  0 |  I  0  0 ] [    | V2 ]
     !> [  0  S  0 |  0  C  0 ]
     !> [  0  0  I |  0  0  0 ]
     !> X11 is P-by-Q. The unitary matrices U1, U2, V1, and V2 are P-by-P,
     !> (M-P)-by-(M-P), Q-by-Q, and (M-Q)-by-(M-Q), respectively. C and S are
     !> R-by-R nonnegative diagonal matrices satisfying C^2 + S^2 = I, in
     !> which R = MIN(P,M-P,Q,M-Q).

     recursive subroutine la_${ri}$uncsd(jobu1,jobu2,jobv1t,jobv2t,trans,signs,m,p,q,x11, &
     ldx11,x12,ldx12,x21,ldx21,x22,ldx22,theta,u1,ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t, &
               work,lwork,rwork,lrwork,iwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu1,jobu2,jobv1t,jobv2t,signs,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldu1,ldu2,ldv1t,ldv2t,ldx11,ldx12,ldx21,ldx22, &
                     lrwork,lwork,m,p,q
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: theta(*)
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(out) :: u1(ldu1,*),u2(ldu2,*),v1t(ldv1t,*),v2t(ldv2t,*),work(*)

           complex(${rk}$),intent(inout) :: x11(ldx11,*),x12(ldx12,*),x21(ldx21,*),x22(ldx22,*)

        ! ===================================================================

           ! Local Scalars
           character :: transt,signst
           integer(ilp) :: childinfo,i,ib11d,ib11e,ib12d,ib12e,ib21d,ib21e,ib22d,ib22e, &
           ibbcsd,iorbdb,iorglq,iorgqr,iphi,itaup1,itaup2,itauq1,itauq2,j,lbbcsdwork, &
           lbbcsdworkmin,lbbcsdworkopt,lorbdbwork,lorbdbworkmin,lorbdbworkopt,lorglqwork, &
           lorglqworkmin,lorglqworkopt,lorgqrwork,lorgqrworkmin,lorgqrworkopt,lworkmin, &
                     lworkopt,p1,q1
           logical(lk) :: colmajor,defaultsigns,lquery,wantu1,wantu2,wantv1t,wantv2t
           integer(ilp) :: lrworkmin,lrworkopt
           logical(lk) :: lrquery
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test input arguments
           info = 0
           wantu1 = la_lsame(jobu1,'Y')
           wantu2 = la_lsame(jobu2,'Y')
           wantv1t = la_lsame(jobv1t,'Y')
           wantv2t = la_lsame(jobv2t,'Y')
           colmajor = .not. la_lsame(trans,'T')
           defaultsigns = .not. la_lsame(signs,'O')
           lquery = lwork == -1
           lrquery = lrwork == -1
           if (m < 0) then
              info = -7
           else if (p < 0 .or. p > m) then
              info = -8
           else if (q < 0 .or. q > m) then
              info = -9
           else if (colmajor .and. ldx11 < max(1,p)) then
             info = -11
           else if (.not. colmajor .and. ldx11 < max(1,q)) then
             info = -11
           else if (colmajor .and. ldx12 < max(1,p)) then
             info = -13
           else if (.not. colmajor .and. ldx12 < max(1,m - q)) then
             info = -13
           else if (colmajor .and. ldx21 < max(1,m - p)) then
             info = -15
           else if (.not. colmajor .and. ldx21 < max(1,q)) then
             info = -15
           else if (colmajor .and. ldx22 < max(1,m - p)) then
             info = -17
           else if (.not. colmajor .and. ldx22 < max(1,m - q)) then
             info = -17
           else if (wantu1 .and. ldu1 < p) then
              info = -20
           else if (wantu2 .and. ldu2 < m - p) then
              info = -22
           else if (wantv1t .and. ldv1t < q) then
              info = -24
           else if (wantv2t .and. ldv2t < m - q) then
              info = -26
           end if
           ! work with transpose if convenient
           if (info == 0 .and. min(p,m - p) < min(q,m - q)) then
              if (colmajor) then
                 transt = 'T'
              else
                 transt = 'N'
              end if
              if (defaultsigns) then
                 signst = 'O'
              else
                 signst = 'D'
              end if
              call la_${ri}$uncsd(jobv1t,jobv2t,jobu1,jobu2,transt,signst,m,q,p,x11, &
              ldx11,x21,ldx21,x12,ldx12,x22,ldx22,theta,v1t,ldv1t,v2t,ldv2t,u1,ldu1, &
                        u2,ldu2,work,lwork,rwork,lrwork,iwork,info)
              return
           end if
           ! work with permutation [ 0 i; i 0 ] * x * [ 0 i; i 0 ] if
           ! convenient
           if (info == 0 .and. m - q < q) then
              if (defaultsigns) then
                 signst = 'O'
              else
                 signst = 'D'
              end if
              call la_${ri}$uncsd(jobu2,jobu1,jobv2t,jobv1t,trans,signst,m,m - p,m - q,x22, &
              ldx22,x21,ldx21,x12,ldx12,x11,ldx11,theta,u2,ldu2,u1,ldu1,v2t,ldv2t, &
                        v1t,ldv1t,work,lwork,rwork,lrwork,iwork,info)
              return
           end if
           ! compute workspace
           if (info == 0) then
              ! real workspace
              iphi = 2
              ib11d = iphi + max(1,q - 1)
              ib11e = ib11d + max(1,q)
              ib12d = ib11e + max(1,q - 1)
              ib12e = ib12d + max(1,q)
              ib21d = ib12e + max(1,q - 1)
              ib21e = ib21d + max(1,q)
              ib22d = ib21e + max(1,q - 1)
              ib22e = ib22d + max(1,q)
              ibbcsd = ib22e + max(1,q - 1)
              call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,theta,theta,u1, &
              ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,theta,theta,theta,theta,theta,theta, &
                        theta,theta,rwork,-1,childinfo)
              lbbcsdworkopt = int(rwork(1),KIND=ilp)
              lbbcsdworkmin = lbbcsdworkopt
              lrworkopt = ibbcsd + lbbcsdworkopt - 1
              lrworkmin = ibbcsd + lbbcsdworkmin - 1
              rwork(1) = lrworkopt
              ! complex workspace
              itaup1 = 2
              itaup2 = itaup1 + max(1,p)
              itauq1 = itaup2 + max(1,m - p)
              itauq2 = itauq1 + max(1,q)
              iorgqr = itauq2 + max(1,m - q)
              call la_${ri}$ungqr(m - q,m - q,m - q,u1,max(1,m - q),u1,work,-1,childinfo)
              lorgqrworkopt = int(work(1),KIND=ilp)
              lorgqrworkmin = max(1,m - q)
              iorglq = itauq2 + max(1,m - q)
              call la_${ri}$unglq(m - q,m - q,m - q,u1,max(1,m - q),u1,work,-1,childinfo)
              lorglqworkopt = int(work(1),KIND=ilp)
              lorglqworkmin = max(1,m - q)
              iorbdb = itauq2 + max(1,m - q)
              call la_${ri}$unbdb(trans,signs,m,p,q,x11,ldx11,x12,ldx12,x21,ldx21,x22, &
                        ldx22,theta,theta,u1,u2,v1t,v2t,work,-1,childinfo)
              lorbdbworkopt = int(work(1),KIND=ilp)
              lorbdbworkmin = lorbdbworkopt
              lworkopt = max(iorgqr + lorgqrworkopt,iorglq + lorglqworkopt,iorbdb + &
                        lorbdbworkopt) - 1
              lworkmin = max(iorgqr + lorgqrworkmin,iorglq + lorglqworkmin,iorbdb + &
                        lorbdbworkmin) - 1
              work(1) = max(lworkopt,lworkmin)
              if (lwork < lworkmin .and. .not. (lquery .or. lrquery)) then
                 info = -22
              else if (lrwork < lrworkmin .and. .not. (lquery .or. lrquery)) then
                 info = -24
              else
                 lorgqrwork = lwork - iorgqr + 1
                 lorglqwork = lwork - iorglq + 1
                 lorbdbwork = lwork - iorbdb + 1
                 lbbcsdwork = lrwork - ibbcsd + 1
              end if
           end if
           ! abort if any illegal arguments
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNCSD',-info)
              return
           else if (lquery .or. lrquery) then
              return
           end if
           ! transform to bidiagonal block form
           call la_${ri}$unbdb(trans,signs,m,p,q,x11,ldx11,x12,ldx12,x21,ldx21,x22, &
           ldx22,theta,rwork(iphi),work(itaup1),work(itaup2),work(itauq1),work(itauq2),work( &
                     iorbdb),lorbdbwork,childinfo)
           ! accumulate householder reflectors
           if (colmajor) then
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('L',p,q,x11,ldx11,u1,ldu1)
                 call la_${ri}$ungqr(p,p,q,u1,ldu1,work(itaup1),work(iorgqr),lorgqrwork, &
                           info)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('L',m - p,q,x21,ldx21,u2,ldu2)
                 call la_${ri}$ungqr(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorgqr),lorgqrwork, &
                            info)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',q - 1,q - 1,x11(1,2),ldx11,v1t(2,2),ldv1t)
                 v1t(1,1) = cone
                 do j = 2,q
                    v1t(1,j) = czero
                    v1t(j,1) = czero
                 end do
                 call la_${ri}$unglq(q - 1,q - 1,q - 1,v1t(2,2),ldv1t,work(itauq1),work(iorglq), &
                           lorglqwork,info)
              end if
              if (wantv2t .and. m - q > 0) then
                 call la_${ri}$lacpy('U',p,m - q,x12,ldx12,v2t,ldv2t)
                 if (m - p > q) then
                    call la_${ri}$lacpy('U',m - p - q,m - p - q,x22(q + 1,p + 1),ldx22,v2t(p + 1,p + 1), &
                              ldv2t)
                 end if
                 if (m > q) then
                    call la_${ri}$unglq(m - q,m - q,m - q,v2t,ldv2t,work(itauq2),work(iorglq), &
                              lorglqwork,info)
                 end if
              end if
           else
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('U',q,p,x11,ldx11,u1,ldu1)
                 call la_${ri}$unglq(p,p,q,u1,ldu1,work(itaup1),work(iorglq),lorglqwork, &
                           info)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('U',q,m - p,x21,ldx21,u2,ldu2)
                 call la_${ri}$unglq(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorglq),lorglqwork, &
                            info)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('L',q - 1,q - 1,x11(2,1),ldx11,v1t(2,2),ldv1t)
                 v1t(1,1) = cone
                 do j = 2,q
                    v1t(1,j) = czero
                    v1t(j,1) = czero
                 end do
                 call la_${ri}$ungqr(q - 1,q - 1,q - 1,v1t(2,2),ldv1t,work(itauq1),work(iorgqr), &
                           lorgqrwork,info)
              end if
              if (wantv2t .and. m - q > 0) then
                 p1 = min(p + 1,m)
                 q1 = min(q + 1,m)
                 call la_${ri}$lacpy('L',m - q,p,x12,ldx12,v2t,ldv2t)
                 if (m > p + q) then
                    call la_${ri}$lacpy('L',m - p - q,m - p - q,x22(p1,q1),ldx22,v2t(p + 1,p + 1),ldv2t)

                 end if
                 call la_${ri}$ungqr(m - q,m - q,m - q,v2t,ldv2t,work(itauq2),work(iorgqr), &
                           lorgqrwork,info)
              end if
           end if
           ! compute the csd of the matrix in bidiagonal-block form
           call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,jobv2t,trans,m,p,q,theta,rwork(iphi), &
           u1,ldu1,u2,ldu2,v1t,ldv1t,v2t,ldv2t,rwork(ib11d),rwork(ib11e),rwork(ib12d), &
           rwork(ib12e),rwork(ib21d),rwork(ib21e),rwork(ib22d),rwork(ib22e),rwork(ibbcsd), &
                     lbbcsdwork,info)
           ! permute rows and columns to place identity submatrices in top-
           ! left corner of (1,1)-block and/or bottom-right corner of (1,2)-
           ! block and/or bottom-right corner of (2,1)-block and/or top-left
           ! corner of (2,2)-block
           if (q > 0 .and. wantu2) then
              do i = 1,q
                 iwork(i) = m - p - q + i
              end do
              do i = q + 1,m - p
                 iwork(i) = i - q
              end do
              if (colmajor) then
                 call la_${ri}$lapmt(.false.,m - p,m - p,u2,ldu2,iwork)
              else
                 call la_${ri}$lapmr(.false.,m - p,m - p,u2,ldu2,iwork)
              end if
           end if
           if (m > 0 .and. wantv2t) then
              do i = 1,p
                 iwork(i) = m - p - q + i
              end do
              do i = p + 1,m - q
                 iwork(i) = i - p
              end do
              if (.not. colmajor) then
                 call la_${ri}$lapmt(.false.,m - q,m - q,v2t,ldv2t,iwork)
              else
                 call la_${ri}$lapmr(.false.,m - q,m - q,v2t,ldv2t,iwork)
              end if
           end if
           return
           ! end la_${ri}$uncsd
     end subroutine la_${ri}$uncsd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB1: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. Q must be no larger than P,
     !> M-P, or M-Q. Routines ${ri.upper()}$UNBDB2, ${ri.upper()}$UNBDB3, and ${ri.upper()}$UNBDB4 handle cases in
     !> which Q is not the minimum dimension.
     !> The unitary matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are Q-by-Q bidiagonal matrices represented implicitly by
     !> angles THETA, PHI.

     subroutine la_${ri}$unbdb1(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           complex(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),work(*)
           complex(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (p < q .or. m - p < q) then
              info = -2
           else if (q < 0 .or. m - q < q) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(p - 1,m - p - 1,q - 1)
              iorbdb5 = 2
              lorbdb5 = q - 2
              lworkopt = max(ilarf + llarf - 1,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNBDB1',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce columns 1, ..., q of x11 and x21
           do i = 1,q
              call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
              call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
              theta(i) = atan2(real(x21(i,i),KIND=${rk}$),real(x11(i,i),KIND=${rk}$))
              c = cos(theta(i))
              s = sin(theta(i))
              x11(i,i) = cone
              x21(i,i) = cone
              call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,conjg(taup1(i)),x11(i,i + 1),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,conjg(taup2(i)),x21(i,i + 1), &
                        ldx21,work(ilarf))
              if (i < q) then
                 call la_${ri}$${ci}$rot(q - i,x11(i,i + 1),ldx11,x21(i,i + 1),ldx21,c,s)
                 call la_${ri}$lacgv(q - i,x21(i,i + 1),ldx21)
                 call la_${ri}$larfgp(q - i,x21(i,i + 1),x21(i,i + 2),ldx21,tauq1(i))
                 s = real(x21(i,i + 1),KIND=${rk}$)
                 x21(i,i + 1) = cone
                 call la_${ri}$larf('R',p - i,q - i,x21(i,i + 1),ldx21,tauq1(i),x11(i + 1,i + 1), &
                           ldx11,work(ilarf))
                 call la_${ri}$larf('R',m - p - i,q - i,x21(i,i + 1),ldx21,tauq1(i),x21(i + 1,i + 1), &
                           ldx21,work(ilarf))
                 call la_${ri}$lacgv(q - i,x21(i,i + 1),ldx21)
                 c = sqrt(la_${ci}$${ri}$nrm2(p - i,x11(i + 1,i + 1),1)**2 + la_${ci}$${ri}$nrm2(m - p - i,x21(i + &
                           1,i + 1),1)**2)
                 phi(i) = atan2(s,c)
                 call la_${ri}$unbdb5(p - i,m - p - i,q - i - 1,x11(i + 1,i + 1),1,x21(i + 1,i + 1),1,x11(i + 1, &
                           i + 2),ldx11,x21(i + 1,i + 2),ldx21,work(iorbdb5),lorbdb5,childinfo)
              end if
           end do
           return
     end subroutine la_${ri}$unbdb1
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB2: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. P must be no larger than M-P,
     !> Q, or M-Q. Routines ${ri.upper()}$UNBDB1, ${ri.upper()}$UNBDB3, and ${ri.upper()}$UNBDB4 handle cases in
     !> which P is not the minimum dimension.
     !> The unitary matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are P-by-P bidiagonal matrices represented implicitly by
     !> angles THETA, PHI.

     subroutine la_${ri}$unbdb2(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           complex(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),work(*)
           complex(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (p < 0 .or. p > m - p) then
              info = -2
           else if (q < 0 .or. q < p .or. m - q < p) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(p - 1,m - p,q - 1)
              iorbdb5 = 2
              lorbdb5 = q - 1
              lworkopt = max(ilarf + llarf - 1,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNBDB2',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce rows 1, ..., p of x11 and x21
           do i = 1,p
              if (i > 1) then
                 call la_${ri}$${ci}$rot(q - i + 1,x11(i,i),ldx11,x21(i - 1,i),ldx21,c,s)
              end if
              call la_${ri}$lacgv(q - i + 1,x11(i,i),ldx11)
              call la_${ri}$larfgp(q - i + 1,x11(i,i),x11(i,i + 1),ldx11,tauq1(i))
              c = real(x11(i,i),KIND=${rk}$)
              x11(i,i) = cone
              call la_${ri}$larf('R',p - i,q - i + 1,x11(i,i),ldx11,tauq1(i),x11(i + 1,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',m - p - i + 1,q - i + 1,x11(i,i),ldx11,tauq1(i),x21(i,i),ldx21, &
                        work(ilarf))
              call la_${ri}$lacgv(q - i + 1,x11(i,i),ldx11)
              s = sqrt(la_${ci}$${ri}$nrm2(p - i,x11(i + 1,i),1)**2 + la_${ci}$${ri}$nrm2(m - p - i + 1,x21(i,i), &
                        1)**2)
              theta(i) = atan2(s,c)
              call la_${ri}$unbdb5(p - i,m - p - i + 1,q - i,x11(i + 1,i),1,x21(i,i),1,x11(i + 1,i + 1), &
                        ldx11,x21(i,i + 1),ldx21,work(iorbdb5),lorbdb5,childinfo)
              call la_${ri}$scal(p - i,cnegone,x11(i + 1,i),1)
              call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
              if (i < p) then
                 call la_${ri}$larfgp(p - i,x11(i + 1,i),x11(i + 2,i),1,taup1(i))
                 phi(i) = atan2(real(x11(i + 1,i),KIND=${rk}$),real(x21(i,i),KIND=${rk}$))
                 c = cos(phi(i))
                 s = sin(phi(i))
                 x11(i + 1,i) = cone
                 call la_${ri}$larf('L',p - i,q - i,x11(i + 1,i),1,conjg(taup1(i)),x11(i + 1,i + 1), &
                           ldx11,work(ilarf))
              end if
              x21(i,i) = cone
              call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,conjg(taup2(i)),x21(i,i + 1), &
                        ldx21,work(ilarf))
           end do
           ! reduce the bottom-right portion of x21 to the identity matrix
           do i = p + 1,q
              call la_${ri}$larfgp(m - p - i + 1,x21(i,i),x21(i + 1,i),1,taup2(i))
              x21(i,i) = cone
              call la_${ri}$larf('L',m - p - i + 1,q - i,x21(i,i),1,conjg(taup2(i)),x21(i,i + 1), &
                        ldx21,work(ilarf))
           end do
           return
     end subroutine la_${ri}$unbdb2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB3: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. M-P must be no larger than P,
     !> Q, or M-Q. Routines ${ri.upper()}$UNBDB1, ${ri.upper()}$UNBDB2, and ${ri.upper()}$UNBDB4 handle cases in
     !> which M-P is not the minimum dimension.
     !> The unitary matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are (M-P)-by-(M-P) bidiagonal matrices represented
     !> implicitly by angles THETA, PHI.

     subroutine la_${ri}$unbdb3(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           complex(${rk}$),intent(out) :: taup1(*),taup2(*),tauq1(*),work(*)
           complex(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (2*p < m .or. p > m) then
              info = -2
           else if (q < m - p .or. m - q < m - p) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(p,m - p - 1,q - 1)
              iorbdb5 = 2
              lorbdb5 = q - 1
              lworkopt = max(ilarf + llarf - 1,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNBDB3',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce rows 1, ..., m-p of x11 and x21
           do i = 1,m - p
              if (i > 1) then
                 call la_${ri}$${ci}$rot(q - i + 1,x11(i - 1,i),ldx11,x21(i,i),ldx11,c,s)
              end if
              call la_${ri}$lacgv(q - i + 1,x21(i,i),ldx21)
              call la_${ri}$larfgp(q - i + 1,x21(i,i),x21(i,i + 1),ldx21,tauq1(i))
              s = real(x21(i,i),KIND=${rk}$)
              x21(i,i) = cone
              call la_${ri}$larf('R',p - i + 1,q - i + 1,x21(i,i),ldx21,tauq1(i),x11(i,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',m - p - i,q - i + 1,x21(i,i),ldx21,tauq1(i),x21(i + 1,i),ldx21, &
                        work(ilarf))
              call la_${ri}$lacgv(q - i + 1,x21(i,i),ldx21)
              c = sqrt(la_${ci}$${ri}$nrm2(p - i + 1,x11(i,i),1)**2 + la_${ci}$${ri}$nrm2(m - p - i,x21(i + 1,i), &
                        1)**2)
              theta(i) = atan2(s,c)
              call la_${ri}$unbdb5(p - i + 1,m - p - i,q - i,x11(i,i),1,x21(i + 1,i),1,x11(i,i + 1), &
                        ldx11,x21(i + 1,i + 1),ldx21,work(iorbdb5),lorbdb5,childinfo)
              call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
              if (i < m - p) then
                 call la_${ri}$larfgp(m - p - i,x21(i + 1,i),x21(i + 2,i),1,taup2(i))
                 phi(i) = atan2(real(x21(i + 1,i),KIND=${rk}$),real(x11(i,i),KIND=${rk}$))
                 c = cos(phi(i))
                 s = sin(phi(i))
                 x21(i + 1,i) = cone
                 call la_${ri}$larf('L',m - p - i,q - i,x21(i + 1,i),1,conjg(taup2(i)),x21(i + 1,i + 1), &
                           ldx21,work(ilarf))
              end if
              x11(i,i) = cone
              call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,conjg(taup1(i)),x11(i,i + 1),ldx11, &
                        work(ilarf))
           end do
           ! reduce the bottom-right portion of x11 to the identity matrix
           do i = m - p + 1,q
              call la_${ri}$larfgp(p - i + 1,x11(i,i),x11(i + 1,i),1,taup1(i))
              x11(i,i) = cone
              call la_${ri}$larf('L',p - i + 1,q - i,x11(i,i),1,conjg(taup1(i)),x11(i,i + 1),ldx11, &
                        work(ilarf))
           end do
           return
     end subroutine la_${ri}$unbdb3
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNBDB4: simultaneously bidiagonalizes the blocks of a tall and skinny
     !> matrix X with orthonomal columns:
     !> [ B11 ]
     !> [ X11 ]   [ P1 |    ] [  0  ]
     !> [-----] = [---------] [-----] Q1**T .
     !> [ X21 ]   [    | P2 ] [ B21 ]
     !> [  0  ]
     !> X11 is P-by-Q, and X21 is (M-P)-by-Q. M-Q must be no larger than P,
     !> M-P, or Q. Routines ${ri.upper()}$UNBDB1, ${ri.upper()}$UNBDB2, and ${ri.upper()}$UNBDB3 handle cases in
     !> which M-Q is not the minimum dimension.
     !> The unitary matrices P1, P2, and Q1 are P-by-P, (M-P)-by-(M-P),
     !> and (M-Q)-by-(M-Q), respectively. They are represented implicitly by
     !> Householder vectors.
     !> B11 and B12 are (M-Q)-by-(M-Q) bidiagonal matrices represented
     !> implicitly by angles THETA, PHI.

     subroutine la_${ri}$unbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,phi,taup1,taup2,tauq1, &
               phantom,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lwork,m,p,q,ldx11,ldx21
           ! Array Arguments
           real(${rk}$),intent(out) :: phi(*),theta(*)
           complex(${rk}$),intent(out) :: phantom(*),taup1(*),taup2(*),tauq1(*),work(*)
           complex(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
        ! ====================================================================

           ! Local Scalars
           real(${rk}$) :: c,s
           integer(ilp) :: childinfo,i,ilarf,iorbdb5,j,llarf,lorbdb5,lworkmin, &
                     lworkopt
           logical(lk) :: lquery
           ! Intrinsic Function
           intrinsic :: atan2,cos,max,sin,sqrt
           ! Executable Statements
           ! test input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (p < m - q .or. m - p < m - q) then
              info = -2
           else if (q < m - q .or. q > m) then
              info = -3
           else if (ldx11 < max(1,p)) then
              info = -5
           else if (ldx21 < max(1,m - p)) then
              info = -7
           end if
           ! compute workspace
           if (info == 0) then
              ilarf = 2
              llarf = max(q - 1,p - 1,m - p - 1)
              iorbdb5 = 2
              lorbdb5 = q
              lworkopt = ilarf + llarf - 1
              lworkopt = max(lworkopt,iorbdb5 + lorbdb5 - 1)
              lworkmin = lworkopt
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                info = -14
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNBDB4',-info)
              return
           else if (lquery) then
              return
           end if
           ! reduce columns 1, ..., m-q of x11 and x21
           do i = 1,m - q
              if (i == 1) then
                 do j = 1,m
                    phantom(j) = czero
                 end do
                 call la_${ri}$unbdb5(p,m - p,q,phantom(1),1,phantom(p + 1),1,x11,ldx11,x21, &
                           ldx21,work(iorbdb5),lorbdb5,childinfo)
                 call la_${ri}$scal(p,cnegone,phantom(1),1)
                 call la_${ri}$larfgp(p,phantom(1),phantom(2),1,taup1(1))
                 call la_${ri}$larfgp(m - p,phantom(p + 1),phantom(p + 2),1,taup2(1))
                 theta(i) = atan2(real(phantom(1),KIND=${rk}$),real(phantom(p + 1),KIND=${rk}$))

                 c = cos(theta(i))
                 s = sin(theta(i))
                 phantom(1) = cone
                 phantom(p + 1) = cone
                 call la_${ri}$larf('L',p,q,phantom(1),1,conjg(taup1(1)),x11,ldx11,work( &
                           ilarf))
                 call la_${ri}$larf('L',m - p,q,phantom(p + 1),1,conjg(taup2(1)),x21,ldx21, &
                           work(ilarf))
              else
                 call la_${ri}$unbdb5(p - i + 1,m - p - i + 1,q - i + 1,x11(i,i - 1),1,x21(i,i - 1),1,x11(i,i) &
                           ,ldx11,x21(i,i),ldx21,work(iorbdb5),lorbdb5,childinfo)
                 call la_${ri}$scal(p - i + 1,cnegone,x11(i,i - 1),1)
                 call la_${ri}$larfgp(p - i + 1,x11(i,i - 1),x11(i + 1,i - 1),1,taup1(i))
                 call la_${ri}$larfgp(m - p - i + 1,x21(i,i - 1),x21(i + 1,i - 1),1,taup2(i))
                 theta(i) = atan2(real(x11(i,i - 1),KIND=${rk}$),real(x21(i,i - 1),KIND=${rk}$))
                 c = cos(theta(i))
                 s = sin(theta(i))
                 x11(i,i - 1) = cone
                 x21(i,i - 1) = cone
                 call la_${ri}$larf('L',p - i + 1,q - i + 1,x11(i,i - 1),1,conjg(taup1(i)),x11(i,i), &
                           ldx11,work(ilarf))
                 call la_${ri}$larf('L',m - p - i + 1,q - i + 1,x21(i,i - 1),1,conjg(taup2(i)),x21(i,i), &
                           ldx21,work(ilarf))
              end if
              call la_${ri}$${ci}$rot(q - i + 1,x11(i,i),ldx11,x21(i,i),ldx21,s,-c)
              call la_${ri}$lacgv(q - i + 1,x21(i,i),ldx21)
              call la_${ri}$larfgp(q - i + 1,x21(i,i),x21(i,i + 1),ldx21,tauq1(i))
              c = real(x21(i,i),KIND=${rk}$)
              x21(i,i) = cone
              call la_${ri}$larf('R',p - i,q - i + 1,x21(i,i),ldx21,tauq1(i),x11(i + 1,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',m - p - i,q - i + 1,x21(i,i),ldx21,tauq1(i),x21(i + 1,i),ldx21, &
                        work(ilarf))
              call la_${ri}$lacgv(q - i + 1,x21(i,i),ldx21)
              if (i < m - q) then
                 s = sqrt(la_${ci}$${ri}$nrm2(p - i,x11(i + 1,i),1)**2 + la_${ci}$${ri}$nrm2(m - p - i,x21(i + 1, &
                           i),1)**2)
                 phi(i) = atan2(s,c)
              end if
           end do
           ! reduce the bottom-right portion of x11 to [ i 0 ]
           do i = m - q + 1,p
              call la_${ri}$lacgv(q - i + 1,x11(i,i),ldx11)
              call la_${ri}$larfgp(q - i + 1,x11(i,i),x11(i,i + 1),ldx11,tauq1(i))
              x11(i,i) = cone
              call la_${ri}$larf('R',p - i,q - i + 1,x11(i,i),ldx11,tauq1(i),x11(i + 1,i),ldx11, &
                        work(ilarf))
              call la_${ri}$larf('R',q - p,q - i + 1,x11(i,i),ldx11,tauq1(i),x21(m - q + 1,i),ldx21, &
                        work(ilarf))
              call la_${ri}$lacgv(q - i + 1,x11(i,i),ldx11)
           end do
           ! reduce the bottom-right portion of x21 to [ 0 i ]
           do i = p + 1,q
              call la_${ri}$lacgv(q - i + 1,x21(m - q + i - p,i),ldx21)
              call la_${ri}$larfgp(q - i + 1,x21(m - q + i - p,i),x21(m - q + i - p,i + 1),ldx21,tauq1(i))

              x21(m - q + i - p,i) = cone
              call la_${ri}$larf('R',q - i,q - i + 1,x21(m - q + i - p,i),ldx21,tauq1(i),x21(m - q + i - p + 1,i) &
                        ,ldx21,work(ilarf))
              call la_${ri}$lacgv(q - i + 1,x21(m - q + i - p,i),ldx21)
           end do
           return
     end subroutine la_${ri}$unbdb4
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNCSD2BY1: computes the CS decomposition of an M-by-Q matrix X with
     !> orthonormal columns that has been partitioned into a 2-by-1 block
     !> structure:
     !> [  I1 0  0 ]
     !> [  0  C  0 ]
     !> [ X11 ]   [ U1 |    ] [  0  0  0 ]
     !> X = [-----] = [---------] [----------] V1**T .
     !> [ X21 ]   [    | U2 ] [  0  0  0 ]
     !> [  0  S  0 ]
     !> [  0  0  I2]
     !> X11 is P-by-Q. The unitary matrices U1, U2, and V1 are P-by-P,
     !> (M-P)-by-(M-P), and Q-by-Q, respectively. C and S are R-by-R
     !> nonnegative diagonal matrices satisfying C^2 + S^2 = I, in which
     !> R = MIN(P,M-P,Q,M-Q). I1 is a K1-by-K1 identity matrix and I2 is a
     !> K2-by-K2 identity matrix, where K1 = MAX(Q+P-M,0), K2 = MAX(Q-P,0).

     subroutine la_${ri}$uncsd2by1(jobu1,jobu2,jobv1t,m,p,q,x11,ldx11,x21,ldx21,theta, &
               u1,ldu1,u2,ldu2,v1t,ldv1t,work,lwork,rwork,lrwork,iwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobu1,jobu2,jobv1t
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: ldu1,ldu2,ldv1t,lwork,ldx11,ldx21,m,p,q
           integer(ilp),intent(in) :: lrwork
           integer(ilp) :: lrworkmin,lrworkopt
           ! Array Arguments
           real(${rk}$),intent(out) :: rwork(*)
           real(${rk}$),intent(out) :: theta(*)
           complex(${rk}$),intent(out) :: u1(ldu1,*),u2(ldu2,*),v1t(ldv1t,*),work(*)
           complex(${rk}$),intent(inout) :: x11(ldx11,*),x21(ldx21,*)
           integer(ilp),intent(out) :: iwork(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: childinfo,i,ib11d,ib11e,ib12d,ib12e,ib21d,ib21e,ib22d,ib22e, &
           ibbcsd,iorbdb,iorglq,iorgqr,iphi,itaup1,itaup2,itauq1,j,lbbcsd,lorbdb, &
           lorglq,lorglqmin,lorglqopt,lorgqr,lorgqrmin,lorgqropt,lworkmin,lworkopt, &
                     r
           logical(lk) :: lquery,wantu1,wantu2,wantv1t
           ! Local Arrays
           real(${rk}$) :: dum(1)
           complex(${rk}$) :: cdum(1,1)
           ! Intrinsic Function
           intrinsic :: int,max,min
           ! Executable Statements
           ! test input arguments
           info = 0
           wantu1 = la_lsame(jobu1,'Y')
           wantu2 = la_lsame(jobu2,'Y')
           wantv1t = la_lsame(jobv1t,'Y')
           lquery = (lwork == -1) .or. (lrwork == -1)
           if (m < 0) then
              info = -4
           else if (p < 0 .or. p > m) then
              info = -5
           else if (q < 0 .or. q > m) then
              info = -6
           else if (ldx11 < max(1,p)) then
              info = -8
           else if (ldx21 < max(1,m - p)) then
              info = -10
           else if (wantu1 .and. ldu1 < max(1,p)) then
              info = -13
           else if (wantu2 .and. ldu2 < max(1,m - p)) then
              info = -15
           else if (wantv1t .and. ldv1t < max(1,q)) then
              info = -17
           end if
           r = min(p,m - p,q,m - q)
           ! compute workspace
             ! work layout:
           ! |-----------------------------------------|
           ! | lworkopt (1)                            |
           ! |-----------------------------------------|
           ! | taup1 (max(1,p))                        |
           ! | taup2 (max(1,m-p))                      |
           ! | tauq1 (max(1,q))                        |
           ! |-----------------------------------------|
           ! | la_${ri}$unbdb work | la_${ri}$ungqr work | la_${ri}$unglq work |
           ! |             |             |             |
           ! |             |             |             |
           ! |             |             |             |
           ! |             |             |             |
           ! |-----------------------------------------|
             ! rwork layout:
           ! |------------------|
           ! | lrworkopt (1)    |
           ! |------------------|
           ! | phi (max(1,r-1)) |
           ! |------------------|
           ! | b11d (r)         |
           ! | b11e (r-1)       |
           ! | b12d (r)         |
           ! | b12e (r-1)       |
           ! | b21d (r)         |
           ! | b21e (r-1)       |
           ! | b22d (r)         |
           ! | b22e (r-1)       |
           ! | la_${ri}$bbcsd rwork     |
           ! |------------------|
           if (info == 0) then
              iphi = 2
              ib11d = iphi + max(1,r - 1)
              ib11e = ib11d + max(1,r)
              ib12d = ib11e + max(1,r - 1)
              ib12e = ib12d + max(1,r)
              ib21d = ib12e + max(1,r - 1)
              ib21e = ib21d + max(1,r)
              ib22d = ib21e + max(1,r - 1)
              ib22e = ib22d + max(1,r)
              ibbcsd = ib22e + max(1,r - 1)
              itaup1 = 2
              itaup2 = itaup1 + max(1,p)
              itauq1 = itaup2 + max(1,m - p)
              iorbdb = itauq1 + max(1,q)
              iorgqr = itauq1 + max(1,q)
              iorglq = itauq1 + max(1,q)
              lorgqrmin = 1
              lorgqropt = 1
              lorglqmin = 1
              lorglqopt = 1
              if (r == q) then
                 call la_${ri}$unbdb1(m,p,q,x11,ldx11,x21,ldx21,theta,dum,cdum,cdum, &
                           cdum,work,-1,childinfo)
                 lorbdb = int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$ungqr(p,p,q,u1,ldu1,cdum,work(1),-1,childinfo)
                    lorgqrmin = max(lorgqrmin,p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$ungqr(m - p,m - p,q,u2,ldu2,cdum,work(1),-1,childinfo)

                    lorgqrmin = max(lorgqrmin,m - p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$unglq(q - 1,q - 1,q - 1,v1t,ldv1t,cdum,work(1),-1,childinfo)

                    lorglqmin = max(lorglqmin,q - 1)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
#:if rk == "sp"
                 call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,'N','N',m,p,q,theta,dum(1),u1, &
                 ldu1,u2,ldu2,v1t,ldv1t,cdum,1,dum,dum,dum,dum,dum,dum,dum,dum,rwork( &
                           1),-1,childinfo)
#:else
                 call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,'N','N',m,p,q,theta,dum,u1,ldu1, &
                  u2,ldu2,v1t,ldv1t,cdum,1,dum,dum,dum,dum,dum,dum,dum,dum,rwork(1),- &
                            1,childinfo)
#:endif
                 lbbcsd = int(rwork(1),KIND=ilp)
              else if (r == p) then
                 call la_${ri}$unbdb2(m,p,q,x11,ldx11,x21,ldx21,theta,dum,cdum,cdum, &
                           cdum,work(1),-1,childinfo)
                 lorbdb = int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$ungqr(p - 1,p - 1,p - 1,u1(2,2),ldu1,cdum,work(1),-1,childinfo &
                              )
                    lorgqrmin = max(lorgqrmin,p - 1)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$ungqr(m - p,m - p,q,u2,ldu2,cdum,work(1),-1,childinfo)

                    lorgqrmin = max(lorgqrmin,m - p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$unglq(q,q,r,v1t,ldv1t,cdum,work(1),-1,childinfo)
                    lorglqmin = max(lorglqmin,q)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd(jobv1t,'N',jobu1,jobu2,'T',m,q,p,theta,dum,v1t, &
                 ldv1t,cdum,1,u1,ldu1,u2,ldu2,dum,dum,dum,dum,dum,dum,dum,dum,rwork( &
                           1),-1,childinfo)
                 lbbcsd = int(rwork(1),KIND=ilp)
              else if (r == m - p) then
                 call la_${ri}$unbdb3(m,p,q,x11,ldx11,x21,ldx21,theta,dum,cdum,cdum, &
                           cdum,work(1),-1,childinfo)
                 lorbdb = int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$ungqr(p,p,q,u1,ldu1,cdum,work(1),-1,childinfo)
                    lorgqrmin = max(lorgqrmin,p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$ungqr(m - p - 1,m - p - 1,m - p - 1,u2(2,2),ldu2,cdum,work(1),-1, &
                              childinfo)
                    lorgqrmin = max(lorgqrmin,m - p - 1)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$unglq(q,q,r,v1t,ldv1t,cdum,work(1),-1,childinfo)
                    lorglqmin = max(lorglqmin,q)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd('N',jobv1t,jobu2,jobu1,'T',m,m - q,m - p,theta,dum,cdum, &
                  1,v1t,ldv1t,u2,ldu2,u1,ldu1,dum,dum,dum,dum,dum,dum,dum,dum,rwork( &
                            1),-1,childinfo)
                 lbbcsd = int(rwork(1),KIND=ilp)
              else
                 call la_${ri}$unbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,dum,cdum,cdum, &
                           cdum,cdum,work(1),-1,childinfo)
                 lorbdb = m + int(work(1),KIND=ilp)
                 if (wantu1 .and. p > 0) then
                    call la_${ri}$ungqr(p,p,m - q,u1,ldu1,cdum,work(1),-1,childinfo)
                    lorgqrmin = max(lorgqrmin,p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantu2 .and. m - p > 0) then
                    call la_${ri}$ungqr(m - p,m - p,m - q,u2,ldu2,cdum,work(1),-1,childinfo)

                    lorgqrmin = max(lorgqrmin,m - p)
                    lorgqropt = max(lorgqropt,int(work(1),KIND=ilp))
                 end if
                 if (wantv1t .and. q > 0) then
                    call la_${ri}$unglq(q,q,q,v1t,ldv1t,cdum,work(1),-1,childinfo)
                    lorglqmin = max(lorglqmin,q)
                    lorglqopt = max(lorglqopt,int(work(1),KIND=ilp))
                 end if
                 call la_${ri}$bbcsd(jobu2,jobu1,'N',jobv1t,'N',m,m - p,m - q,theta,dum,u2, &
                 ldu2,u1,ldu1,cdum,1,v1t,ldv1t,dum,dum,dum,dum,dum,dum,dum,dum,rwork( &
                           1),-1,childinfo)
                 lbbcsd = int(rwork(1),KIND=ilp)
              end if
              lrworkmin = ibbcsd + lbbcsd - 1
              lrworkopt = lrworkmin
              rwork(1) = lrworkopt
              lworkmin = max(iorbdb + lorbdb - 1,iorgqr + lorgqrmin - 1,iorglq + lorglqmin - 1)
              lworkopt = max(iorbdb + lorbdb - 1,iorgqr + lorgqropt - 1,iorglq + lorglqopt - 1)
              work(1) = lworkopt
              if (lwork < lworkmin .and. .not. lquery) then
                 info = -19
              end if
              if (lrwork < lrworkmin .and. .not. lquery) then
                 info = -21
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNCSD2BY1',-info)
              return
           else if (lquery) then
              return
           end if
           lorgqr = lwork - iorgqr + 1
           lorglq = lwork - iorglq + 1
           ! handle four cases separately: r = q, r = p, r = m-p, and r = m-q,
           ! in which r = min(p,m-p,q,m-q)
           if (r == q) then
              ! case 1: r = q
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$unbdb1(m,p,q,x11,ldx11,x21,ldx21,theta,rwork(iphi),work( &
                        itaup1),work(itaup2),work(itauq1),work(iorbdb),lorbdb,childinfo)
              ! accumulate householder reflectors
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('L',p,q,x11,ldx11,u1,ldu1)
                 call la_${ri}$ungqr(p,p,q,u1,ldu1,work(itaup1),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('L',m - p,q,x21,ldx21,u2,ldu2)
                 call la_${ri}$ungqr(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 v1t(1,1) = cone
                 do j = 2,q
                    v1t(1,j) = czero
                    v1t(j,1) = czero
                 end do
                 call la_${ri}$lacpy('U',q - 1,q - 1,x21(1,2),ldx21,v1t(2,2),ldv1t)
                 call la_${ri}$unglq(q - 1,q - 1,q - 1,v1t(2,2),ldv1t,work(itauq1),work(iorglq), &
                           lorglq,childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd(jobu1,jobu2,jobv1t,'N','N',m,p,q,theta,rwork(iphi),u1, &
              ldu1,u2,ldu2,v1t,ldv1t,cdum,1,rwork(ib11d),rwork(ib11e),rwork(ib12d),rwork( &
              ib12e),rwork(ib21d),rwork(ib21e),rwork(ib22d),rwork(ib22e),rwork(ibbcsd),lrwork - &
                        ibbcsd + 1,childinfo)
              ! permute rows and columns to place czero submatrices in
              ! preferred positions
              if (q > 0 .and. wantu2) then
                 do i = 1,q
                    iwork(i) = m - p - q + i
                 end do
                 do i = q + 1,m - p
                    iwork(i) = i - q
                 end do
                 call la_${ri}$lapmt(.false.,m - p,m - p,u2,ldu2,iwork)
              end if
           else if (r == p) then
              ! case 2: r = p
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$unbdb2(m,p,q,x11,ldx11,x21,ldx21,theta,rwork(iphi),work( &
                        itaup1),work(itaup2),work(itauq1),work(iorbdb),lorbdb,childinfo)
              ! accumulate householder reflectors
              if (wantu1 .and. p > 0) then
                 u1(1,1) = cone
                 do j = 2,p
                    u1(1,j) = czero
                    u1(j,1) = czero
                 end do
                 call la_${ri}$lacpy('L',p - 1,p - 1,x11(2,1),ldx11,u1(2,2),ldu1)
                 call la_${ri}$ungqr(p - 1,p - 1,p - 1,u1(2,2),ldu1,work(itaup1),work(iorgqr), &
                           lorgqr,childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$lacpy('L',m - p,q,x21,ldx21,u2,ldu2)
                 call la_${ri}$ungqr(m - p,m - p,q,u2,ldu2,work(itaup2),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',p,q,x11,ldx11,v1t,ldv1t)
                 call la_${ri}$unglq(q,q,r,v1t,ldv1t,work(itauq1),work(iorglq),lorglq, &
                           childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd(jobv1t,'N',jobu1,jobu2,'T',m,q,p,theta,rwork(iphi),v1t, &
               ldv1t,cdum,1,u1,ldu1,u2,ldu2,rwork(ib11d),rwork(ib11e),rwork(ib12d),rwork( &
               ib12e),rwork(ib21d),rwork(ib21e),rwork(ib22d),rwork(ib22e),rwork(ibbcsd), &
                         lbbcsd,childinfo)
              ! permute rows and columns to place identity submatrices in
              ! preferred positions
              if (q > 0 .and. wantu2) then
                 do i = 1,q
                    iwork(i) = m - p - q + i
                 end do
                 do i = q + 1,m - p
                    iwork(i) = i - q
                 end do
                 call la_${ri}$lapmt(.false.,m - p,m - p,u2,ldu2,iwork)
              end if
           else if (r == m - p) then
              ! case 3: r = m-p
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$unbdb3(m,p,q,x11,ldx11,x21,ldx21,theta,rwork(iphi),work( &
                        itaup1),work(itaup2),work(itauq1),work(iorbdb),lorbdb,childinfo)
              ! accumulate householder reflectors
              if (wantu1 .and. p > 0) then
                 call la_${ri}$lacpy('L',p,q,x11,ldx11,u1,ldu1)
                 call la_${ri}$ungqr(p,p,q,u1,ldu1,work(itaup1),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 u2(1,1) = cone
                 do j = 2,m - p
                    u2(1,j) = czero
                    u2(j,1) = czero
                 end do
                 call la_${ri}$lacpy('L',m - p - 1,m - p - 1,x21(2,1),ldx21,u2(2,2),ldu2)
                 call la_${ri}$ungqr(m - p - 1,m - p - 1,m - p - 1,u2(2,2),ldu2,work(itaup2),work(iorgqr) &
                           ,lorgqr,childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',m - p,q,x21,ldx21,v1t,ldv1t)
                 call la_${ri}$unglq(q,q,r,v1t,ldv1t,work(itauq1),work(iorglq),lorglq, &
                           childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd('N',jobv1t,jobu2,jobu1,'T',m,m - q,m - p,theta,rwork(iphi), &
              cdum,1,v1t,ldv1t,u2,ldu2,u1,ldu1,rwork(ib11d),rwork(ib11e),rwork(ib12d), &
              rwork(ib12e),rwork(ib21d),rwork(ib21e),rwork(ib22d),rwork(ib22e),rwork(ibbcsd), &
                        lbbcsd,childinfo)
              ! permute rows and columns to place identity submatrices in
              ! preferred positions
              if (q > r) then
                 do i = 1,r
                    iwork(i) = q - r + i
                 end do
                 do i = r + 1,q
                    iwork(i) = i - r
                 end do
                 if (wantu1) then
                    call la_${ri}$lapmt(.false.,p,q,u1,ldu1,iwork)
                 end if
                 if (wantv1t) then
                    call la_${ri}$lapmr(.false.,q,q,v1t,ldv1t,iwork)
                 end if
              end if
           else
              ! case 4: r = m-q
              ! simultaneously bidiagonalize x11 and x21
              call la_${ri}$unbdb4(m,p,q,x11,ldx11,x21,ldx21,theta,rwork(iphi),work( &
              itaup1),work(itaup2),work(itauq1),work(iorbdb),work(iorbdb + m),lorbdb - m, &
                        childinfo)
              ! accumulate householder reflectors
              if (wantu2 .and. m - p > 0) then
                 call la_${ri}$copy(m - p,work(iorbdb + p),1,u2,1)
              end if
              if (wantu1 .and. p > 0) then
                 call la_${ri}$copy(p,work(iorbdb),1,u1,1)
                 do j = 2,p
                    u1(1,j) = czero
                 end do
                 call la_${ri}$lacpy('L',p - 1,m - q - 1,x11(2,1),ldx11,u1(2,2),ldu1)
                 call la_${ri}$ungqr(p,p,m - q,u1,ldu1,work(itaup1),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantu2 .and. m - p > 0) then
                 do j = 2,m - p
                    u2(1,j) = czero
                 end do
                 call la_${ri}$lacpy('L',m - p - 1,m - q - 1,x21(2,1),ldx21,u2(2,2),ldu2)
                 call la_${ri}$ungqr(m - p,m - p,m - q,u2,ldu2,work(itaup2),work(iorgqr),lorgqr, &
                           childinfo)
              end if
              if (wantv1t .and. q > 0) then
                 call la_${ri}$lacpy('U',m - q,q,x21,ldx21,v1t,ldv1t)
                 call la_${ri}$lacpy('U',p - (m - q),q - (m - q),x11(m - q + 1,m - q + 1),ldx11,v1t(m - q + 1,m - q + &
                           1),ldv1t)
                 call la_${ri}$lacpy('U',-p + q,q - p,x21(m - q + 1,p + 1),ldx21,v1t(p + 1,p + 1),ldv1t)

                 call la_${ri}$unglq(q,q,q,v1t,ldv1t,work(itauq1),work(iorglq),lorglq, &
                           childinfo)
              end if
              ! simultaneously diagonalize x11 and x21.
              call la_${ri}$bbcsd(jobu2,jobu1,'N',jobv1t,'N',m,m - p,m - q,theta,rwork(iphi), &
              u2,ldu2,u1,ldu1,cdum,1,v1t,ldv1t,rwork(ib11d),rwork(ib11e),rwork(ib12d), &
              rwork(ib12e),rwork(ib21d),rwork(ib21e),rwork(ib22d),rwork(ib22e),rwork(ibbcsd), &
                        lbbcsd,childinfo)
              ! permute rows and columns to place identity submatrices in
              ! preferred positions
              if (p > r) then
                 do i = 1,r
                    iwork(i) = p - r + i
                 end do
                 do i = r + 1,p
                    iwork(i) = i - r
                 end do
                 if (wantu1) then
                    call la_${ri}$lapmt(.false.,p,p,u1,ldu1,iwork)
                 end if
                 if (wantv1t) then
                    call la_${ri}$lapmr(.false.,p,q,v1t,ldv1t,iwork)
                 end if
              end if
           end if
           return
     end subroutine la_${ri}$uncsd2by1
#:endfor

end module la_lapack_cosine_sine
