    &  {'complex': '               pure subroutine {ri}geqr(m,n,a,lda,t,tsize,work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,m,n,tsize,lwork\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: t(*),work(*)\n               end subroutine {ri}geqr', 'real': '               pure subroutine {ri}geqr(m,n,a,lda,t,tsize,work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,m,n,tsize,lwork\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: t(*),work(*)\n               end subroutine {ri}geqr'}), &
