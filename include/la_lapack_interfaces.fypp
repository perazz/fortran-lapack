    &  {'complex': '               pure subroutine {ri}laqsp(uplo,n,ap,s,scond,amax,equed)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(out) :: equed\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: n\n                    real({rk}),intent(in) :: amax,scond,s(*)\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}laqsp', 'real': '               pure subroutine {ri}laqsp(uplo,n,ap,s,scond,amax,equed)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(out) :: equed\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(in) :: amax,scond,s(*)\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}laqsp'}), &
    & ('laqsy', ['LAQSY: equilibrates a symmetric matrix A using the scaling factors', 'in the vector S.'], &
