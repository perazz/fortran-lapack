    & ('posv', ['POSV: computes the solution to a complex system of linear equations', 'A * X = B,', 'where A is an N-by-N Hermitian positive definite matrix and X and B', 'are N-by-NRHS matrices.', 'The Cholesky decomposition is used to factor A as', "A = U**H* U,  if UPLO = 'U', or", "A = L * L**H,  if UPLO = 'L',", 'where U is an upper triangular matrix and  L is a lower triangular', 'matrix.  The factored form of A is then used to solve the system of', 'equations A * X = B.'], &
    &  [('cposv', 'cposv', 'complex'), ('dposv', 'dposv', 'real'), ('qposv', 'qposv', None), ('sposv', 'sposv', 'real'), ('wposv', 'wposv', None), ('xposv', 'xposv', None), ('yposv', 'yposv', None), ('zposv', 'zposv', 'complex')], &
    &  {'complex': '               pure subroutine {ri}posv(uplo,n,nrhs,a,lda,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n               end subroutine {ri}posv', 'real': '               pure subroutine {ri}posv(uplo,n,nrhs,a,lda,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,n,nrhs\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n               end subroutine {ri}posv'}), &
