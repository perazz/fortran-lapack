    &  {'complex': '               pure subroutine {ri}potrf(uplo,n,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}potrf', 'real': '               pure subroutine {ri}potrf(uplo,n,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}potrf'}), &
    & ('potrf2', ['POTRF2: computes the Cholesky factorization of a Hermitian', 'positive definite matrix A using the recursive algorithm.', 'The factorization has the form', "A = U**H * U,  if UPLO = 'U', or", "A = L  * L**H,  if UPLO = 'L',", 'where U is an upper triangular matrix and L is lower triangular.', 'This is the recursive version of the algorithm. It divides', 'the matrix into four submatrices:', '[  A11 | A12  ]  where A11 is n1 by n1 and A22 is n2 by n2', 'A = [ -----|----- ]  with n1 = n/2', '[  A21 | A22  ]       n2 = n-n1', 'The subroutine calls itself to factor A11. Update and scale A21', 'or A12, update A22 then calls itself to factor A22.'], &
    &  [('cpotrf2', 'cpotrf2', 'complex'), ('dpotrf2', 'dpotrf2', 'real'), ('qpotrf2', 'qpotrf2', None), ('spotrf2', 'spotrf2', 'real'), ('wpotrf2', 'wpotrf2', None), ('xpotrf2', 'xpotrf2', None), ('ypotrf2', 'ypotrf2', None), ('zpotrf2', 'zpotrf2', 'complex')], &
