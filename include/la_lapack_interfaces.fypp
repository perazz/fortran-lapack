    &  [('csytrs_aa', 'csytrs_aa', 'complex'), ('dsytrs_aa', 'dsytrs_aa', 'real'), ('qsytrs_aa', 'qsytrs_aa', None), ('ssytrs_aa', 'ssytrs_aa', 'real'), ('wsytrs_aa', 'wsytrs_aa', None), ('xsytrs_aa', 'xsytrs_aa', None), ('ysytrs_aa', 'ysytrs_aa', None), ('zsytrs_aa', 'zsytrs_aa', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sytrs_aa(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: n,nrhs,lda,ldb,lwork,ipiv(*)\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sytrs_aa', 'real': '               pure subroutine {ri}sytrs_aa(uplo,n,nrhs,a,lda,ipiv,b,ldb,work,lwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(in) :: n,nrhs,lda,ldb,lwork,ipiv(*)\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}sytrs_aa'}), &
    & ('sytrs_rook', ['SYTRS_ROOK: solves a system of linear equations A*X = B with', 'a complex symmetric matrix A using the factorization A = U*D*U**T or', 'A = L*D*L**T computed by CSYTRF_ROOK.'], &
    &  [('csytrs_rook', 'csytrs_rook', 'complex'), ('dsytrs_rook', 'dsytrs_rook', 'real'), ('qsytrs_rook', 'qsytrs_rook', None), ('ssytrs_rook', 'ssytrs_rook', 'real'), ('wsytrs_rook', 'wsytrs_rook', None), ('xsytrs_rook', 'xsytrs_rook', None), ('ysytrs_rook', 'ysytrs_rook', None), ('zsytrs_rook', 'zsytrs_rook', 'complex')], &
    &  {'complex': '               pure subroutine {ri}sytrs_rook(uplo,n,nrhs,a,lda,ipiv,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,n,nrhs,ipiv(*)\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}sytrs_rook', 'real': '               pure subroutine {ri}sytrs_rook(uplo,n,nrhs,a,lda,ipiv,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,n,nrhs,ipiv(*)\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}sytrs_rook'}), &
    & ('tbcon', ['TBCON: estimates the reciprocal of the condition number of a', 'triangular band matrix A, in either the 1-norm or the infinity-norm.', 'The norm of A is computed and an estimate is obtained for', 'norm(inv(A)), then the reciprocal of the condition number is', 'computed as', 'RCOND = 1 / ( norm(A) * norm(inv(A)) ).'], &
    &  [('ctbcon', 'ctbcon', 'complex'), ('dtbcon', 'dtbcon', 'real'), ('qtbcon', 'qtbcon', None), ('stbcon', 'stbcon', 'real'), ('wtbcon', 'wtbcon', None), ('xtbcon', 'xtbcon', None), ('ytbcon', 'ytbcon', None), ('ztbcon', 'ztbcon', 'complex')], &
    &  {'complex': '               subroutine {ri}tbcon(norm,uplo,diag,n,kd,ab,ldab,rcond,work,rwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,norm,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kd,ldab,n\n                    real({rk}),intent(out) :: rcond,rwork(*)\n                    {rt},intent(in) :: ab(ldab,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tbcon', 'real': '               subroutine {ri}tbcon(norm,uplo,diag,n,kd,ab,ldab,rcond,work,iwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,norm,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: kd,ldab,n\n                    {rt},intent(out) :: rcond,work(*)\n                    {rt},intent(in) :: ab(ldab,*)\n               end subroutine {ri}tbcon'}), &
    & ('tbrfs', ['TBRFS: provides error bounds and backward error estimates for the', 'solution to a system of linear equations with a triangular band', 'coefficient matrix.', 'The solution matrix X must be computed by CTBTRS or some other', 'means before entering this routine.  TBRFS does not do iterative', 'refinement because doing so cannot improve the backward error.'], &
    &  [('ctbrfs', 'ctbrfs', 'complex'), ('dtbrfs', 'dtbrfs', 'real'), ('qtbrfs', 'qtbrfs', None), ('stbrfs', 'stbrfs', 'real'), ('wtbrfs', 'wtbrfs', None), ('xtbrfs', 'xtbrfs', None), ('ytbrfs', 'ytbrfs', None), ('ztbrfs', 'ztbrfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tbrfs(uplo,trans,diag,n,kd,nrhs,ab,ldab,b,ldb,x,ldx, &\n                         ferr,berr,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kd,ldab,ldb,ldx,n,nrhs\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    {rt},intent(in) :: ab(ldab,*),b(ldb,*),x(ldx,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tbrfs', 'real': '               pure subroutine {ri}tbrfs(uplo,trans,diag,n,kd,nrhs,ab,ldab,b,ldb,x,ldx, &\n                         ferr,berr,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: kd,ldab,ldb,ldx,n,nrhs\n                    {rt},intent(in) :: ab(ldab,*),b(ldb,*),x(ldx,*)\n                    {rt},intent(out) :: berr(*),ferr(*),work(*)\n               end subroutine {ri}tbrfs'}), &
    & ('tbtrs', ['TBTRS: solves a triangular system of the form', 'A * X = B,  A**T * X = B,  or  A**H * X = B,', 'where A is a triangular band matrix of order N, and B is an', 'N-by-NRHS matrix.  A check is made to verify that A is nonsingular.'], &
    &  [('ctbtrs', 'ctbtrs', 'complex'), ('dtbtrs', 'dtbtrs', 'real'), ('qtbtrs', 'qtbtrs', None), ('stbtrs', 'stbtrs', 'real'), ('wtbtrs', 'wtbtrs', None), ('xtbtrs', 'xtbtrs', None), ('ytbtrs', 'ytbtrs', None), ('ztbtrs', 'ztbtrs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tbtrs(uplo,trans,diag,n,kd,nrhs,ab,ldab,b,ldb,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kd,ldab,ldb,n,nrhs\n                    {rt},intent(in) :: ab(ldab,*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}tbtrs', 'real': '               pure subroutine {ri}tbtrs(uplo,trans,diag,n,kd,nrhs,ab,ldab,b,ldb,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: kd,ldab,ldb,n,nrhs\n                    {rt},intent(in) :: ab(ldab,*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}tbtrs'}), &
    & ('tfsm', ['Level 3 BLAS like routine for A in RFP Format.', 'TFSM: solves the matrix equation', 'op( A )*X = alpha*B  or  X*op( A ) = alpha*B', 'where alpha is a scalar, X and B are m by n matrices, A is a unit, or', 'non-unit,  upper or lower triangular matrix  and  op( A )  is one  of', 'op( A ) = A   or   op( A ) = A**H.', 'A is in Rectangular Full Packed (RFP) Format.', 'The matrix X is overwritten on B.'], &
    &  [('ctfsm', 'ctfsm', 'complex'), ('dtfsm', 'dtfsm', 'real'), ('qtfsm', 'qtfsm', None), ('stfsm', 'stfsm', 'real'), ('wtfsm', 'wtfsm', None), ('xtfsm', 'xtfsm', None), ('ytfsm', 'ytfsm', None), ('ztfsm', 'ztfsm', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tfsm(transr,side,uplo,trans,diag,m,n,alpha,a,b,ldb)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,diag,side,trans,uplo\n                    integer(ilp),intent(in) :: ldb,m,n\n                    {rt},intent(in) :: alpha,a(0:*)\n                    {rt},intent(inout) :: b(0:ldb - 1,0:*)\n               end subroutine {ri}tfsm', 'real': '               pure subroutine {ri}tfsm(transr,side,uplo,trans,diag,m,n,alpha,a,b,ldb)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,diag,side,trans,uplo\n                    integer(ilp),intent(in) :: ldb,m,n\n                    {rt},intent(in) :: alpha,a(0:*)\n                    {rt},intent(inout) :: b(0:ldb - 1,0:*)\n               end subroutine {ri}tfsm'}), &
    & ('tftri', ['TFTRI: computes the inverse of a triangular matrix A stored in RFP', 'format.', 'This is a Level 3 BLAS version of the algorithm.'], &
    &  [('ctftri', 'ctftri', 'complex'), ('dtftri', 'dtftri', 'real'), ('qtftri', 'qtftri', None), ('stftri', 'stftri', 'real'), ('wtftri', 'wtftri', None), ('xtftri', 'xtftri', None), ('ytftri', 'ytftri', None), ('ztftri', 'ztftri', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tftri(transr,uplo,diag,n,a,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo,diag\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: a(0:*)\n               end subroutine {ri}tftri', 'real': '               pure subroutine {ri}tftri(transr,uplo,diag,n,a,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo,diag\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: a(0:*)\n               end subroutine {ri}tftri'}), &
    & ('tfttp', ['TFTTP: copies a triangular matrix A from rectangular full packed', 'format (TF) to standard packed format (TP).'], &
    &  [('ctfttp', 'ctfttp', 'complex'), ('dtfttp', 'dtfttp', 'real'), ('qtfttp', 'qtfttp', None), ('stfttp', 'stfttp', 'real'), ('wtfttp', 'wtfttp', None), ('xtfttp', 'xtfttp', None), ('ytfttp', 'ytfttp', None), ('ztfttp', 'ztfttp', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tfttp(transr,uplo,n,arf,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(out) :: ap(0:*)\n                    {rt},intent(in) :: arf(0:*)\n               end subroutine {ri}tfttp', 'real': '               pure subroutine {ri}tfttp(transr,uplo,n,arf,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(out) :: ap(0:*)\n                    {rt},intent(in) :: arf(0:*)\n               end subroutine {ri}tfttp'}), &
    & ('tfttr', ['TFTTR: copies a triangular matrix A from rectangular full packed', 'format (TF) to standard full format (TR).'], &
    &  [('ctfttr', 'ctfttr', 'complex'), ('dtfttr', 'dtfttr', 'real'), ('qtfttr', 'qtfttr', None), ('stfttr', 'stfttr', 'real'), ('wtfttr', 'wtfttr', None), ('xtfttr', 'xtfttr', None), ('ytfttr', 'ytfttr', None), ('ztfttr', 'ztfttr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tfttr(transr,uplo,n,arf,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,lda\n                    {rt},intent(out) :: a(0:lda - 1,0:*)\n                    {rt},intent(in) :: arf(0:*)\n               end subroutine {ri}tfttr', 'real': '               pure subroutine {ri}tfttr(transr,uplo,n,arf,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,lda\n                    {rt},intent(out) :: a(0:lda - 1,0:*)\n                    {rt},intent(in) :: arf(0:*)\n               end subroutine {ri}tfttr'}), &
    & ('tgevc', ['TGEVC: computes some or all of the right and/or left eigenvectors of', 'a pair of complex matrices (S,P), where S and P are upper triangular.', 'Matrix pairs of this type are produced by the generalized Schur', 'factorization of a complex matrix pair (A,B):', 'A = Q*S*Z**H,  B = Q*P*Z**H', 'as computed by CGGHRD + CHGEQZ.', 'The right eigenvector x and the left eigenvector y of (S,P)', 'corresponding to an eigenvalue w are defined by:', 'S*x = w*P*x,  (y**H)*S = w*(y**H)*P,', 'where y**H denotes the conjugate tranpose of y.', 'The eigenvalues are not input to this routine, but are computed', 'directly from the diagonal elements of S and P.', 'This routine returns the matrices X and/or Y of right and left', 'eigenvectors of (S,P), or the products Z*X and/or Q*Y,', 'where Z and Q are input matrices.', 'If Q and Z are the unitary factors from the generalized Schur', 'factorization of a matrix pair (A,B), then Z*X and Q*Y', 'are the matrices of right and left eigenvectors of (A,B).'], &
    &  [('ctgevc', 'ctgevc', 'complex'), ('dtgevc', 'dtgevc', 'real'), ('qtgevc', 'qtgevc', None), ('stgevc', 'stgevc', 'real'), ('wtgevc', 'wtgevc', None), ('xtgevc', 'xtgevc', None), ('ytgevc', 'ytgevc', None), ('ztgevc', 'ztgevc', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tgevc(side,howmny,select,n,s,lds,p,ldp,vl,ldvl,vr,ldvr, &\n                          mm,m,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,side\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldp,lds,ldvl,ldvr,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(in) :: p(ldp,*),s(lds,*)\n                    {rt},intent(inout) :: vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tgevc', 'real': '               pure subroutine {ri}tgevc(side,howmny,select,n,s,lds,p,ldp,vl,ldvl,vr,ldvr, &\n                          mm,m,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,side\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldp,lds,ldvl,ldvr,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    {rt},intent(in) :: p(ldp,*),s(lds,*)\n                    {rt},intent(inout) :: vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tgevc'}), &
    & ('tgexc', ['TGEXC: reorders the generalized Schur decomposition of a complex', 'matrix pair (A,B), using an unitary equivalence transformation', '(A, B) := Q * (A, B) * Z**H, so that the diagonal block of (A, B) with', 'row index IFST is moved to row ILST.', '(A, B) must be in generalized Schur canonical form, that is, A and', 'B are both upper triangular.', 'Optionally, the matrices Q and Z of generalized Schur vectors are', 'updated.', 'Q(in) * A(in) * Z(in)**H = Q(out) * A(out) * Z(out)**H', 'Q(in) * B(in) * Z(in)**H = Q(out) * B(out) * Z(out)**H'], &
    &  [('ctgexc', 'ctgexc', 'complex'), ('dtgexc', 'dtgexc', 'real'), ('qtgexc', 'qtgexc', None), ('stgexc', 'stgexc', 'real'), ('wtgexc', 'wtgexc', None), ('xtgexc', 'xtgexc', None), ('ytgexc', 'ytgexc', None), ('ztgexc', 'ztgexc', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tgexc(wantq,wantz,n,a,lda,b,ldb,q,ldq,z,ldz,ifst,ilst, &\n                          info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantq,wantz\n                    integer(ilp),intent(in) :: ifst,lda,ldb,ldq,ldz,n\n                    integer(ilp),intent(inout) :: ilst\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n               end subroutine {ri}tgexc', 'real': '               pure subroutine {ri}tgexc(wantq,wantz,n,a,lda,b,ldb,q,ldq,z,ldz,ifst,ilst, &\n                          work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantq,wantz\n                    integer(ilp),intent(inout) :: ifst,ilst\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldq,ldz,lwork,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tgexc'}), &
    & ('tgsen', ['TGSEN: reorders the generalized Schur decomposition of a complex', 'matrix pair (A, B) (in terms of an unitary equivalence trans-', 'formation Q**H * (A, B) * Z), so that a selected cluster of eigenvalues', 'appears in the leading diagonal blocks of the pair (A,B). The leading', 'columns of Q and Z form unitary bases of the corresponding left and', 'right eigenspaces (deflating subspaces). (A, B) must be in', 'generalized Schur canonical form, that is, A and B are both upper', 'triangular.', 'TGSEN also computes the generalized eigenvalues', 'w(j)= ALPHA(j) / BETA(j)', 'of the reordered matrix pair (A, B).', 'Optionally, the routine computes estimates of reciprocal condition', 'numbers for eigenvalues and eigenspaces. These are Difu[(A11,B11),', '(A22,B22)] and Difl[(A11,B11), (A22,B22)], i.e. the separation(s)', 'between the matrix pairs (A11, B11) and (A22,B22) that correspond to', 'the selected cluster and the eigenvalues outside the cluster, resp.,', 'and norms of "projections" onto left and right eigenspaces w.r.t.', 'the selected cluster in the (1,1)-block.'], &
    &  [('ctgsen', 'ctgsen', 'complex'), ('dtgsen', 'dtgsen', 'real'), ('qtgsen', 'qtgsen', None), ('stgsen', 'stgsen', 'real'), ('wtgsen', 'wtgsen', None), ('xtgsen', 'xtgsen', None), ('ytgsen', 'ytgsen', None), ('ztgsen', 'ztgsen', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tgsen(ijob,wantq,wantz,select,n,a,lda,b,ldb,alpha,beta, &\n                         q,ldq,z,ldz,m,pl,pr,dif,work,lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantq,wantz,select(*)\n                    integer(ilp),intent(in) :: ijob,lda,ldb,ldq,ldz,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,iwork(*)\n                    real({rk}),intent(out) :: pl,pr,dif(*)\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n                    {rt},intent(out) :: alpha(*),beta(*),work(*)\n               end subroutine {ri}tgsen', 'real': '               pure subroutine {ri}tgsen(ijob,wantq,wantz,select,n,a,lda,b,ldb,alphar, &\n               alphai,beta,q,ldq,z,ldz,m,pl,pr,dif,work,lwork,iwork,liwork,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    logical(lk),intent(in) :: wantq,wantz,select(*)\n                    integer(ilp),intent(in) :: ijob,lda,ldb,ldq,ldz,liwork,lwork,n\n                    integer(ilp),intent(out) :: info,m,iwork(*)\n                    {rt},intent(out) :: pl,pr,alphai(*),alphar(*),beta(*),dif(*),work(*)\n                              \n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),z(ldz,*)\n               end subroutine {ri}tgsen'}), &
    & ('tgsja', ['TGSJA: computes the generalized singular value decomposition (GSVD)', 'of two complex upper triangular (or trapezoidal) matrices A and B.', 'On entry, it is assumed that matrices A and B have the following', 'forms, which may be obtained by the preprocessing subroutine CGGSVP', 'from a general M-by-N matrix A and P-by-N matrix B:', 'N-K-L  K    L', 'A =    K ( 0    A12  A13 ) if M-K-L >= 0;', 'L ( 0     0   A23 )', 'M-K-L ( 0     0    0  )', 'N-K-L  K    L', 'A =  K ( 0    A12  A13 ) if M-K-L < 0;', 'M-K ( 0     0   A23 )', 'N-K-L  K    L', 'B =  L ( 0     0   B13 )', 'P-L ( 0     0    0  )', 'where the K-by-K matrix A12 and L-by-L matrix B13 are nonsingular', 'upper triangular; A23 is L-by-L upper triangular if M-K-L >= 0,', 'otherwise A23 is (M-K)-by-L upper trapezoidal.', 'On exit,', 'U**H *A*Q = D1*( 0 R ),    V**H *B*Q = D2*( 0 R ),', 'where U, V and Q are unitary matrices.', 'R is a nonsingular upper triangular matrix, and D1', "and D2 are ``diagonal'' matrices, which are of the following", 'structures:', 'If M-K-L >= 0,', 'K  L', 'D1 =     K ( I  0 )', 'L ( 0  C )', 'M-K-L ( 0  0 )', 'K  L', 'D2 = L   ( 0  S )', 'P-L ( 0  0 )', 'N-K-L  K    L', '( 0 R ) = K (  0   R11  R12 ) K', 'L (  0    0   R22 ) L', 'where', 'C = diag( ALPHA(K+1), ... , ALPHA(K+L) ),', 'S = diag( BETA(K+1),  ... , BETA(K+L) ),', 'C**2 + S**2 = I.', 'R is stored in A(1:K+L,N-K-L+1:N) on exit.', 'If M-K-L < 0,', 'K M-K K+L-M', 'D1 =   K ( I  0    0   )', 'M-K ( 0  C    0   )', 'K M-K K+L-M', 'D2 =   M-K ( 0  S    0   )', 'K+L-M ( 0  0    I   )', 'P-L ( 0  0    0   )', 'N-K-L  K   M-K  K+L-M', '( 0 R ) =    K ( 0    R11  R12  R13  )', 'M-K ( 0     0   R22  R23  )', 'K+L-M ( 0     0    0   R33  )', 'where', 'C = diag( ALPHA(K+1), ... , ALPHA(M) ),', 'S = diag( BETA(K+1),  ... , BETA(M) ),', 'C**2 + S**2 = I.', 'R = ( R11 R12 R13 ) is stored in A(1:M, N-K-L+1:N) and R33 is stored', '(  0  R22 R23 )', 'in B(M-K+1:L,N+M-K-L+1:N) on exit.', 'The computation of the unitary transformation matrices U, V or Q', 'is optional.  These matrices may either be formed explicitly, or they', 'may be postmultiplied into input matrices U1, V1, or Q1.'], &
    &  [('ctgsja', 'ctgsja', 'complex'), ('dtgsja', 'dtgsja', 'real'), ('qtgsja', 'qtgsja', None), ('stgsja', 'stgsja', 'real'), ('wtgsja', 'wtgsja', None), ('xtgsja', 'xtgsja', None), ('ytgsja', 'ytgsja', None), ('ztgsja', 'ztgsja', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tgsja(jobu,jobv,jobq,m,p,n,k,l,a,lda,b,ldb,tola,tolb, &\n                          alpha,beta,u,ldu,v,ldv,q,ldq,work,ncycle,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobq,jobu,jobv\n                    integer(ilp),intent(out) :: info,ncycle\n                    integer(ilp),intent(in) :: k,l,lda,ldb,ldq,ldu,ldv,m,n,p\n                    real({rk}),intent(in) :: tola,tolb\n                    real({rk}),intent(out) :: alpha(*),beta(*)\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),u(ldu,*),v(ldv,*)\n                              \n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tgsja', 'real': '               pure subroutine {ri}tgsja(jobu,jobv,jobq,m,p,n,k,l,a,lda,b,ldb,tola,tolb, &\n                          alpha,beta,u,ldu,v,ldv,q,ldq,work,ncycle,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: jobq,jobu,jobv\n                    integer(ilp),intent(out) :: info,ncycle\n                    integer(ilp),intent(in) :: k,l,lda,ldb,ldq,ldu,ldv,m,n,p\n                    {rt},intent(in) :: tola,tolb\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*),q(ldq,*),u(ldu,*),v(ldv,*)\n                              \n                    {rt},intent(out) :: alpha(*),beta(*),work(*)\n               end subroutine {ri}tgsja'}), &
    & ('tgsna', ['TGSNA: estimates reciprocal condition numbers for specified', 'eigenvalues and/or eigenvectors of a matrix pair (A, B).', '(A, B) must be in generalized Schur canonical form, that is, A and', 'B are both upper triangular.'], &
    &  [('ctgsna', 'ctgsna', 'complex'), ('dtgsna', 'dtgsna', 'real'), ('qtgsna', 'qtgsna', None), ('stgsna', 'stgsna', 'real'), ('wtgsna', 'wtgsna', None), ('xtgsna', 'xtgsna', None), ('ytgsna', 'ytgsna', None), ('ztgsna', 'ztgsna', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tgsna(job,howmny,select,n,a,lda,b,ldb,vl,ldvl,vr,ldvr, &\n                         s,dif,mm,m,work,lwork,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,job\n                    integer(ilp),intent(out) :: info,m,iwork(*)\n                    integer(ilp),intent(in) :: lda,ldb,ldvl,ldvr,lwork,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    real({rk}),intent(out) :: dif(*),s(*)\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tgsna', 'real': '               pure subroutine {ri}tgsna(job,howmny,select,n,a,lda,b,ldb,vl,ldvl,vr,ldvr, &\n                         s,dif,mm,m,work,lwork,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,job\n                    integer(ilp),intent(out) :: info,m,iwork(*)\n                    integer(ilp),intent(in) :: lda,ldb,ldvl,ldvr,lwork,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: dif(*),s(*),work(*)\n               end subroutine {ri}tgsna'}), &
    & ('tgsyl', ['TGSYL: solves the generalized Sylvester equation:', 'A * R - L * B = scale * C            (1)', 'D * R - L * E = scale * F', 'where R and L are unknown m-by-n matrices, (A, D), (B, E) and', '(C, F) are given matrix pairs of size m-by-m, n-by-n and m-by-n,', 'respectively, with complex entries. A, B, D and E are upper', 'triangular (i.e., (A,D) and (B,E) in generalized Schur form).', 'The solution (R, L) overwrites (C, F). 0 <= SCALE <= 1', 'is an output scaling factor chosen to avoid overflow.', 'In matrix notation (1) is equivalent to solve Zx = scale*b, where Z', 'is defined as', 'Z = [ kron(In, A)  -kron(B**H, Im) ]        (2)', '[ kron(In, D)  -kron(E**H, Im) ],', 'Here Ix is the identity matrix of size x and X**H is the conjugate', 'transpose of X. Kron(X, Y) is the Kronecker product between the', 'matrices X and Y.', "If TRANS = 'C', y in the conjugate transposed system Z**H *y = scale*b", 'is solved for, which is equivalent to solve for R and L in', 'A**H * R + D**H * L = scale * C           (3)', 'R * B**H + L * E**H = scale * -F', "This case (TRANS = 'C') is used to compute an one-norm-based estimate", 'of Dif[(A,D), (B,E)], the separation between the matrix pairs (A,D)', 'and (B,E), using CLACON.', 'If IJOB >= 1, TGSYL computes a Frobenius norm-based estimate of', 'Dif[(A,D),(B,E)]. That is, the reciprocal of a lower bound on the', 'reciprocal of the smallest singular value of Z.', 'This is a level-3 BLAS algorithm.'], &
    &  [('ctgsyl', 'ctgsyl', 'complex'), ('dtgsyl', 'dtgsyl', 'real'), ('qtgsyl', 'qtgsyl', None), ('stgsyl', 'stgsyl', 'real'), ('wtgsyl', 'wtgsyl', None), ('xtgsyl', 'xtgsyl', None), ('ytgsyl', 'ytgsyl', None), ('ztgsyl', 'ztgsyl', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tgsyl(trans,ijob,m,n,a,lda,b,ldb,c,ldc,d,ldd,e,lde, &\n                         f,ldf,scale,dif,work,lwork,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: trans\n                    integer(ilp),intent(in) :: ijob,lda,ldb,ldc,ldd,lde,ldf,lwork,m,n\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    real({rk}),intent(out) :: dif,scale\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),d(ldd,*),e(lde,*)\n                    {rt},intent(inout) :: c(ldc,*),f(ldf,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tgsyl', 'real': '               pure subroutine {ri}tgsyl(trans,ijob,m,n,a,lda,b,ldb,c,ldc,d,ldd,e,lde, &\n                         f,ldf,scale,dif,work,lwork,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: trans\n                    integer(ilp),intent(in) :: ijob,lda,ldb,ldc,ldd,lde,ldf,lwork,m,n\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    {rt},intent(out) :: dif,scale,work(*)\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),d(ldd,*),e(lde,*)\n                    {rt},intent(inout) :: c(ldc,*),f(ldf,*)\n               end subroutine {ri}tgsyl'}), &
    & ('tpcon', ['TPCON: estimates the reciprocal of the condition number of a packed', 'triangular matrix A, in either the 1-norm or the infinity-norm.', 'The norm of A is computed and an estimate is obtained for', 'norm(inv(A)), then the reciprocal of the condition number is', 'computed as', 'RCOND = 1 / ( norm(A) * norm(inv(A)) ).'], &
    &  [('ctpcon', 'ctpcon', 'complex'), ('dtpcon', 'dtpcon', 'real'), ('qtpcon', 'qtpcon', None), ('stpcon', 'stpcon', 'real'), ('wtpcon', 'wtpcon', None), ('xtpcon', 'xtpcon', None), ('ytpcon', 'ytpcon', None), ('ztpcon', 'ztpcon', 'complex')], &
    &  {'complex': '               subroutine {ri}tpcon(norm,uplo,diag,n,ap,rcond,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,norm,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    real({rk}),intent(out) :: rcond,rwork(*)\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tpcon', 'real': '               subroutine {ri}tpcon(norm,uplo,diag,n,ap,rcond,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,norm,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(out) :: rcond,work(*)\n                    {rt},intent(in) :: ap(*)\n               end subroutine {ri}tpcon'}), &
    & ('tplqt', ['TPLQT: computes a blocked LQ factorization of a complex', '"triangular-pentagonal" matrix C, which is composed of a', 'triangular block A and pentagonal block B, using the compact', 'WY representation for Q.'], &
    &  [('ctplqt', 'ctplqt', 'complex'), ('dtplqt', 'dtplqt', 'real'), ('qtplqt', 'qtplqt', None), ('stplqt', 'stplqt', 'real'), ('wtplqt', 'wtplqt', None), ('xtplqt', 'xtplqt', None), ('ytplqt', 'ytplqt', None), ('ztplqt', 'ztplqt', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tplqt(m,n,l,mb,a,lda,b,ldb,t,ldt,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l,mb\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*),work(*)\n               end subroutine {ri}tplqt', 'real': '               pure subroutine {ri}tplqt(m,n,l,mb,a,lda,b,ldb,t,ldt,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l,mb\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*),work(*)\n               end subroutine {ri}tplqt'}), &
    & ('tplqt2', ['TPLQT2: computes a LQ a factorization of a complex "triangular-pentagonal"', 'matrix C, which is composed of a triangular block A and pentagonal block B,', 'using the compact WY representation for Q.'], &
    &  [('ctplqt2', 'ctplqt2', 'complex'), ('dtplqt2', 'dtplqt2', 'real'), ('qtplqt2', 'qtplqt2', None), ('stplqt2', 'stplqt2', 'real'), ('wtplqt2', 'wtplqt2', None), ('xtplqt2', 'xtplqt2', None), ('ytplqt2', 'ytplqt2', None), ('ztplqt2', 'ztplqt2', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tplqt2(m,n,l,a,lda,b,ldb,t,ldt,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*)\n               end subroutine {ri}tplqt2', 'real': '               pure subroutine {ri}tplqt2(m,n,l,a,lda,b,ldb,t,ldt,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*)\n               end subroutine {ri}tplqt2'}), &
    & ('tpmlqt', ['TPMLQT: applies a complex unitary matrix Q obtained from a', '"triangular-pentagonal" complex block reflector H to a general', 'complex matrix C, which consists of two blocks A and B.'], &
    &  [('ctpmlqt', 'ctpmlqt', 'complex'), ('dtpmlqt', 'dtpmlqt', 'real'), ('qtpmlqt', 'qtpmlqt', None), ('stpmlqt', 'stpmlqt', 'real'), ('wtpmlqt', 'wtpmlqt', None), ('xtpmlqt', 'xtpmlqt', None), ('ytpmlqt', 'ytpmlqt', None), ('ztpmlqt', 'ztpmlqt', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tpmlqt(side,trans,m,n,k,l,mb,v,ldv,t,ldt,a,lda,b, &\n                         ldb,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: side,trans\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: k,ldv,lda,ldb,m,n,l,mb,ldt\n                    {rt},intent(in) :: v(ldv,*),t(ldt,*)\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tpmlqt', 'real': '               pure subroutine {ri}tpmlqt(side,trans,m,n,k,l,mb,v,ldv,t,ldt,a,lda,b, &\n                         ldb,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: side,trans\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: k,ldv,lda,ldb,m,n,l,mb,ldt\n                    {rt},intent(in) :: v(ldv,*),t(ldt,*)\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tpmlqt'}), &
    & ('tpmqrt', ['TPMQRT: applies a complex orthogonal matrix Q obtained from a', '"triangular-pentagonal" complex block reflector H to a general', 'complex matrix C, which consists of two blocks A and B.'], &
    &  [('ctpmqrt', 'ctpmqrt', 'complex'), ('dtpmqrt', 'dtpmqrt', 'real'), ('qtpmqrt', 'qtpmqrt', None), ('stpmqrt', 'stpmqrt', 'real'), ('wtpmqrt', 'wtpmqrt', None), ('xtpmqrt', 'xtpmqrt', None), ('ytpmqrt', 'ytpmqrt', None), ('ztpmqrt', 'ztpmqrt', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tpmqrt(side,trans,m,n,k,l,nb,v,ldv,t,ldt,a,lda,b, &\n                         ldb,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: side,trans\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: k,ldv,lda,ldb,m,n,l,nb,ldt\n                    {rt},intent(in) :: v(ldv,*),t(ldt,*)\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tpmqrt', 'real': '               pure subroutine {ri}tpmqrt(side,trans,m,n,k,l,nb,v,ldv,t,ldt,a,lda,b, &\n                         ldb,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: side,trans\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: k,ldv,lda,ldb,m,n,l,nb,ldt\n                    {rt},intent(in) :: v(ldv,*),t(ldt,*)\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tpmqrt'}), &
    & ('tpqrt', ['TPQRT: computes a blocked QR factorization of a complex', '"triangular-pentagonal" matrix C, which is composed of a', 'triangular block A and pentagonal block B, using the compact', 'WY representation for Q.'], &
    &  [('ctpqrt', 'ctpqrt', 'complex'), ('dtpqrt', 'dtpqrt', 'real'), ('qtpqrt', 'qtpqrt', None), ('stpqrt', 'stpqrt', 'real'), ('wtpqrt', 'wtpqrt', None), ('xtpqrt', 'xtpqrt', None), ('ytpqrt', 'ytpqrt', None), ('ztpqrt', 'ztpqrt', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tpqrt(m,n,l,nb,a,lda,b,ldb,t,ldt,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l,nb\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*),work(*)\n               end subroutine {ri}tpqrt', 'real': '               pure subroutine {ri}tpqrt(m,n,l,nb,a,lda,b,ldb,t,ldt,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l,nb\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*),work(*)\n               end subroutine {ri}tpqrt'}), &
    & ('tpqrt2', ['TPQRT2: computes a QR factorization of a complex "triangular-pentagonal"', 'matrix C, which is composed of a triangular block A and pentagonal block B,', 'using the compact WY representation for Q.'], &
    &  [('ctpqrt2', 'ctpqrt2', 'complex'), ('dtpqrt2', 'dtpqrt2', 'real'), ('qtpqrt2', 'qtpqrt2', None), ('stpqrt2', 'stpqrt2', 'real'), ('wtpqrt2', 'wtpqrt2', None), ('xtpqrt2', 'xtpqrt2', None), ('ytpqrt2', 'ytpqrt2', None), ('ztpqrt2', 'ztpqrt2', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tpqrt2(m,n,l,a,lda,b,ldb,t,ldt,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*)\n               end subroutine {ri}tpqrt2', 'real': '               pure subroutine {ri}tpqrt2(m,n,l,a,lda,b,ldb,t,ldt,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(out) :: t(ldt,*)\n               end subroutine {ri}tpqrt2'}), &
    & ('tprfb', ['TPRFB: applies a complex "triangular-pentagonal" block reflector H or its', 'conjugate transpose H**H to a complex matrix C, which is composed of two', 'blocks A and B, either from the left or right.'], &
    &  [('ctprfb', 'ctprfb', 'complex'), ('dtprfb', 'dtprfb', 'real'), ('qtprfb', 'qtprfb', None), ('stprfb', 'stprfb', 'real'), ('wtprfb', 'wtprfb', None), ('xtprfb', 'xtprfb', None), ('ytprfb', 'ytprfb', None), ('ztprfb', 'ztprfb', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tprfb(side,trans,direct,storev,m,n,k,l,v,ldv,t,ldt,a, &\n                         lda,b,ldb,work,ldwork)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: direct,side,storev,trans\n                    integer(ilp),intent(in) :: k,l,lda,ldb,ldt,ldv,ldwork,m,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(in) :: t(ldt,*),v(ldv,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}tprfb', 'real': '               pure subroutine {ri}tprfb(side,trans,direct,storev,m,n,k,l,v,ldv,t,ldt,a, &\n                         lda,b,ldb,work,ldwork)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: direct,side,storev,trans\n                    integer(ilp),intent(in) :: k,l,lda,ldb,ldt,ldv,ldwork,m,n\n                    {rt},intent(inout) :: a(lda,*),b(ldb,*)\n                    {rt},intent(in) :: t(ldt,*),v(ldv,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}tprfb'}), &
    & ('tprfs', ['TPRFS: provides error bounds and backward error estimates for the', 'solution to a system of linear equations with a triangular packed', 'coefficient matrix.', 'The solution matrix X must be computed by CTPTRS or some other', 'means before entering this routine.  TPRFS does not do iterative', 'refinement because doing so cannot improve the backward error.'], &
    &  [('ctprfs', 'ctprfs', 'complex'), ('dtprfs', 'dtprfs', 'real'), ('qtprfs', 'qtprfs', None), ('stprfs', 'stprfs', 'real'), ('wtprfs', 'wtprfs', None), ('xtprfs', 'xtprfs', None), ('ytprfs', 'ytprfs', None), ('ztprfs', 'ztprfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tprfs(uplo,trans,diag,n,nrhs,ap,b,ldb,x,ldx,ferr,berr, &\n                         work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    {rt},intent(in) :: ap(*),b(ldb,*),x(ldx,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}tprfs', 'real': '               pure subroutine {ri}tprfs(uplo,trans,diag,n,nrhs,ap,b,ldb,x,ldx,ferr,berr, &\n                         work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: ldb,ldx,n,nrhs\n                    {rt},intent(in) :: ap(*),b(ldb,*),x(ldx,*)\n                    {rt},intent(out) :: berr(*),ferr(*),work(*)\n               end subroutine {ri}tprfs'}), &
    & ('tptri', ['TPTRI: computes the inverse of a complex upper or lower triangular', 'matrix A stored in packed format.'], &
    &  [('ctptri', 'ctptri', 'complex'), ('dtptri', 'dtptri', 'real'), ('qtptri', 'qtptri', None), ('stptri', 'stptri', 'real'), ('wtptri', 'wtptri', None), ('xtptri', 'xtptri', None), ('ytptri', 'ytptri', None), ('ztptri', 'ztptri', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tptri(uplo,diag,n,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}tptri', 'real': '               pure subroutine {ri}tptri(uplo,diag,n,ap,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: ap(*)\n               end subroutine {ri}tptri'}), &
    & ('tptrs', ['TPTRS: solves a triangular system of the form', 'A * X = B,  A**T * X = B,  or  A**H * X = B,', 'where A is a triangular matrix of order N stored in packed format,', 'and B is an N-by-NRHS matrix.  A check is made to verify that A is', 'nonsingular.'], &
    &  [('ctptrs', 'ctptrs', 'complex'), ('dtptrs', 'dtptrs', 'real'), ('qtptrs', 'qtptrs', None), ('stptrs', 'stptrs', 'real'), ('wtptrs', 'wtptrs', None), ('xtptrs', 'xtptrs', None), ('ytptrs', 'ytptrs', None), ('ztptrs', 'ztptrs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tptrs(uplo,trans,diag,n,nrhs,ap,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}tptrs', 'real': '               pure subroutine {ri}tptrs(uplo,trans,diag,n,nrhs,ap,b,ldb,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldb,n,nrhs\n                    {rt},intent(in) :: ap(*)\n                    {rt},intent(inout) :: b(ldb,*)\n               end subroutine {ri}tptrs'}), &
    & ('tpttf', ['TPTTF: copies a triangular matrix A from standard packed format (TP)', 'to rectangular full packed format (TF).'], &
    &  [('ctpttf', 'ctpttf', 'complex'), ('dtpttf', 'dtpttf', 'real'), ('qtpttf', 'qtpttf', None), ('stpttf', 'stpttf', 'real'), ('wtpttf', 'wtpttf', None), ('xtpttf', 'xtpttf', None), ('ytpttf', 'ytpttf', None), ('ztpttf', 'ztpttf', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tpttf(transr,uplo,n,ap,arf,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(in) :: ap(0:*)\n                    {rt},intent(out) :: arf(0:*)\n               end subroutine {ri}tpttf', 'real': '               pure subroutine {ri}tpttf(transr,uplo,n,ap,arf,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: transr,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(in) :: ap(0:*)\n                    {rt},intent(out) :: arf(0:*)\n               end subroutine {ri}tpttf'}), &
    & ('tpttr', ['TPTTR: copies a triangular matrix A from standard packed format (TP)', 'to standard full format (TR).'], &
    &  [('ctpttr', 'ctpttr', 'complex'), ('dtpttr', 'dtpttr', 'real'), ('qtpttr', 'qtpttr', None), ('stpttr', 'stpttr', 'real'), ('wtpttr', 'wtpttr', None), ('xtpttr', 'xtpttr', None), ('ytpttr', 'ytpttr', None), ('ztpttr', 'ztpttr', 'complex')], &
    &  {'complex': '               pure subroutine {ri}tpttr(uplo,n,ap,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,lda\n                    {rt},intent(out) :: a(lda,*)\n                    {rt},intent(in) :: ap(*)\n               end subroutine {ri}tpttr', 'real': '               pure subroutine {ri}tpttr(uplo,n,ap,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: n,lda\n                    {rt},intent(out) :: a(lda,*)\n                    {rt},intent(in) :: ap(*)\n               end subroutine {ri}tpttr'}), &
    & ('trcon', ['TRCON: estimates the reciprocal of the condition number of a', 'triangular matrix A, in either the 1-norm or the infinity-norm.', 'The norm of A is computed and an estimate is obtained for', 'norm(inv(A)), then the reciprocal of the condition number is', 'computed as', 'RCOND = 1 / ( norm(A) * norm(inv(A)) ).'], &
    &  [('ctrcon', 'ctrcon', 'complex'), ('dtrcon', 'dtrcon', 'real'), ('qtrcon', 'qtrcon', None), ('strcon', 'strcon', 'real'), ('wtrcon', 'wtrcon', None), ('xtrcon', 'xtrcon', None), ('ytrcon', 'ytrcon', None), ('ztrcon', 'ztrcon', 'complex')], &
    &  {'complex': '               subroutine {ri}trcon(norm,uplo,diag,n,a,lda,rcond,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,norm,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    real({rk}),intent(out) :: rcond,rwork(*)\n                    {rt},intent(in) :: a(lda,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trcon', 'real': '               subroutine {ri}trcon(norm,uplo,diag,n,a,lda,rcond,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,norm,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(out) :: rcond,work(*)\n                    {rt},intent(in) :: a(lda,*)\n               end subroutine {ri}trcon'}), &
    & ('trevc', ['TREVC: computes some or all of the right and/or left eigenvectors of', 'a complex upper triangular matrix T.', 'Matrices of this type are produced by the Schur factorization of', 'a complex general matrix:  A = Q*T*Q**H, as computed by CHSEQR.', 'The right eigenvector x and the left eigenvector y of T corresponding', 'to an eigenvalue w are defined by:', 'T*x = w*x,     (y**H)*T = w*(y**H)', 'where y**H denotes the conjugate transpose of the vector y.', 'The eigenvalues are not input to this routine, but are read directly', 'from the diagonal of T.', 'This routine returns the matrices X and/or Y of right and left', 'eigenvectors of T, or the products Q*X and/or Q*Y, where Q is an', 'input matrix.  If Q is the unitary factor that reduces a matrix A to', 'Schur form T, then Q*X and Q*Y are the matrices of right and left', 'eigenvectors of A.'], &
    &  [('ctrevc', 'ctrevc', 'complex'), ('dtrevc', 'dtrevc', 'real'), ('qtrevc', 'qtrevc', None), ('strevc', 'strevc', 'real'), ('wtrevc', 'wtrevc', None), ('xtrevc', 'xtrevc', None), ('ytrevc', 'ytrevc', None), ('ztrevc', 'ztrevc', 'complex')], &
    &  {'complex': '               pure subroutine {ri}trevc(side,howmny,select,n,t,ldt,vl,ldvl,vr,ldvr,mm,m, &\n                         work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,side\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldt,ldvl,ldvr,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: t(ldt,*),vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trevc', 'real': '               pure subroutine {ri}trevc(side,howmny,select,n,t,ldt,vl,ldvl,vr,ldvr,mm,m, &\n                         work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,side\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldt,ldvl,ldvr,mm,n\n                    logical(lk),intent(inout) :: select(*)\n                    {rt},intent(in) :: t(ldt,*)\n                    {rt},intent(inout) :: vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trevc'}), &
    & ('trevc3', ['TREVC3: computes some or all of the right and/or left eigenvectors of', 'a complex upper triangular matrix T.', 'Matrices of this type are produced by the Schur factorization of', 'a complex general matrix:  A = Q*T*Q**H, as computed by CHSEQR.', 'The right eigenvector x and the left eigenvector y of T corresponding', 'to an eigenvalue w are defined by:', 'T*x = w*x,     (y**H)*T = w*(y**H)', 'where y**H denotes the conjugate transpose of the vector y.', 'The eigenvalues are not input to this routine, but are read directly', 'from the diagonal of T.', 'This routine returns the matrices X and/or Y of right and left', 'eigenvectors of T, or the products Q*X and/or Q*Y, where Q is an', 'input matrix. If Q is the unitary factor that reduces a matrix A to', 'Schur form T, then Q*X and Q*Y are the matrices of right and left', 'eigenvectors of A.', 'This uses a Level 3 BLAS version of the back transformation.'], &
    &  [('ctrevc3', 'ctrevc3', 'complex'), ('dtrevc3', 'dtrevc3', 'real'), ('qtrevc3', 'qtrevc3', None), ('strevc3', 'strevc3', 'real'), ('wtrevc3', 'wtrevc3', None), ('xtrevc3', 'xtrevc3', None), ('ytrevc3', 'ytrevc3', None), ('ztrevc3', 'ztrevc3', 'complex')], &
    &  {'complex': '               pure subroutine {ri}trevc3(side,howmny,select,n,t,ldt,vl,ldvl,vr,ldvr,mm,m, &\n                          work,lwork,rwork,lrwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,side\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldt,ldvl,ldvr,lwork,lrwork,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    real({rk}),intent(out) :: rwork(*)\n                    {rt},intent(inout) :: t(ldt,*),vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trevc3', 'real': '               pure subroutine {ri}trevc3(side,howmny,select,n,t,ldt,vl,ldvl,vr,ldvr,mm,m, &\n                          work,lwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,side\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldt,ldvl,ldvr,lwork,mm,n\n                    logical(lk),intent(inout) :: select(*)\n                    {rt},intent(in) :: t(ldt,*)\n                    {rt},intent(inout) :: vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trevc3'}), &
    & ('trexc', ['TREXC: reorders the Schur factorization of a complex matrix', 'A = Q*T*Q**H, so that the diagonal element of T with row index IFST', 'is moved to row ILST.', 'The Schur form T is reordered by a unitary similarity transformation', 'Z**H*T*Z, and optionally the matrix Q of Schur vectors is updated by', 'postmultplying it with Z.'], &
    &  [('ctrexc', 'ctrexc', 'complex'), ('dtrexc', 'dtrexc', 'real'), ('qtrexc', 'qtrexc', None), ('strexc', 'strexc', 'real'), ('wtrexc', 'wtrexc', None), ('xtrexc', 'xtrexc', None), ('ytrexc', 'ytrexc', None), ('ztrexc', 'ztrexc', 'complex')], &
    &  {'complex': '               pure subroutine {ri}trexc(compq,n,t,ldt,q,ldq,ifst,ilst,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compq\n                    integer(ilp),intent(in) :: ifst,ilst,ldq,ldt,n\n                    integer(ilp),intent(out) :: info\n                    {rt},intent(inout) :: q(ldq,*),t(ldt,*)\n               end subroutine {ri}trexc', 'real': '               subroutine {ri}trexc(compq,n,t,ldt,q,ldq,ifst,ilst,work,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compq\n                    integer(ilp),intent(inout) :: ifst,ilst\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: ldq,ldt,n\n                    {rt},intent(inout) :: q(ldq,*),t(ldt,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trexc'}), &
    & ('trrfs', ['TRRFS: provides error bounds and backward error estimates for the', 'solution to a system of linear equations with a triangular', 'coefficient matrix.', 'The solution matrix X must be computed by CTRTRS or some other', 'means before entering this routine.  TRRFS does not do iterative', 'refinement because doing so cannot improve the backward error.'], &
    &  [('ctrrfs', 'ctrrfs', 'complex'), ('dtrrfs', 'dtrrfs', 'real'), ('qtrrfs', 'qtrrfs', None), ('strrfs', 'strrfs', 'real'), ('wtrrfs', 'wtrrfs', None), ('xtrrfs', 'xtrrfs', None), ('ytrrfs', 'ytrrfs', None), ('ztrrfs', 'ztrrfs', 'complex')], &
    &  {'complex': '               pure subroutine {ri}trrfs(uplo,trans,diag,n,nrhs,a,lda,b,ldb,x,ldx,ferr, &\n                         berr,work,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,ldb,ldx,n,nrhs\n                    real({rk}),intent(out) :: berr(*),ferr(*),rwork(*)\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),x(ldx,*)\n                    {rt},intent(out) :: work(*)\n               end subroutine {ri}trrfs', 'real': '               pure subroutine {ri}trrfs(uplo,trans,diag,n,nrhs,a,lda,b,ldb,x,ldx,ferr, &\n                         berr,work,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: diag,trans,uplo\n                    integer(ilp),intent(out) :: info,iwork(*)\n                    integer(ilp),intent(in) :: lda,ldb,ldx,n,nrhs\n                    {rt},intent(in) :: a(lda,*),b(ldb,*),x(ldx,*)\n                    {rt},intent(out) :: berr(*),ferr(*),work(*)\n               end subroutine {ri}trrfs'}), &
    & ('trsen', ['TRSEN: reorders the Schur factorization of a complex matrix', 'A = Q*T*Q**H, so that a selected cluster of eigenvalues appears in', 'the leading positions on the diagonal of the upper triangular matrix', 'T, and the leading columns of Q form an orthonormal basis of the', 'corresponding right invariant subspace.', 'Optionally the routine computes the reciprocal condition numbers of', 'the cluster of eigenvalues and/or the invariant subspace.'], &
    &  [('ctrsen', 'ctrsen', 'complex'), ('dtrsen', 'dtrsen', 'real'), ('qtrsen', 'qtrsen', None), ('strsen', 'strsen', 'real'), ('wtrsen', 'wtrsen', None), ('xtrsen', 'xtrsen', None), ('ytrsen', 'ytrsen', None), ('ztrsen', 'ztrsen', 'complex')], &
    &  {'complex': '               subroutine {ri}trsen(job,compq,select,n,t,ldt,q,ldq,w,m,s,sep,work,lwork, &\n                          info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compq,job\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldq,ldt,lwork,n\n                    real({rk}),intent(out) :: s,sep\n                    logical(lk),intent(in) :: select(*)\n                    {rt},intent(inout) :: q(ldq,*),t(ldt,*)\n                    {rt},intent(out) :: w(*),work(*)\n               end subroutine {ri}trsen', 'real': '               subroutine {ri}trsen(job,compq,select,n,t,ldt,q,ldq,wr,wi,m,s,sep,work, &\n                         lwork,iwork,liwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: compq,job\n                    integer(ilp),intent(out) :: info,m,iwork(*)\n                    integer(ilp),intent(in) :: ldq,ldt,liwork,lwork,n\n                    {rt},intent(out) :: s,sep,wi(*),work(*),wr(*)\n                    logical(lk),intent(in) :: select(*)\n                    {rt},intent(inout) :: q(ldq,*),t(ldt,*)\n               end subroutine {ri}trsen'}), &
    & ('trsna', ['TRSNA: estimates reciprocal condition numbers for specified', 'eigenvalues and/or right eigenvectors of a complex upper triangular', 'matrix T (or of any matrix Q*T*Q**H with Q unitary).'], &
    &  [('ctrsna', 'ctrsna', 'complex'), ('dtrsna', 'dtrsna', 'real'), ('qtrsna', 'qtrsna', None), ('strsna', 'strsna', 'real'), ('wtrsna', 'wtrsna', None), ('xtrsna', 'xtrsna', None), ('ytrsna', 'ytrsna', None), ('ztrsna', 'ztrsna', 'complex')], &
    &  {'complex': '               pure subroutine {ri}trsna(job,howmny,select,n,t,ldt,vl,ldvl,vr,ldvr,s,sep, &\n                         mm,m,work,ldwork,rwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,job\n                    integer(ilp),intent(out) :: info,m\n                    integer(ilp),intent(in) :: ldt,ldvl,ldvr,ldwork,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    real({rk}),intent(out) :: rwork(*),s(*),sep(*)\n                    {rt},intent(in) :: t(ldt,*),vl(ldvl,*),vr(ldvr,*)\n                    {rt},intent(out) :: work(ldwork,*)\n               end subroutine {ri}trsna', 'real': '               subroutine {ri}trsna(job,howmny,select,n,t,ldt,vl,ldvl,vr,ldvr,s,sep,mm, &\n                         m,work,ldwork,iwork,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: howmny,job\n                    integer(ilp),intent(out) :: info,m,iwork(*)\n                    integer(ilp),intent(in) :: ldt,ldvl,ldvr,ldwork,mm,n\n                    logical(lk),intent(in) :: select(*)\n                    {rt},intent(out) :: s(*),sep(*),work(ldwork,*)\n                    {rt},intent(in) :: t(ldt,*),vl(ldvl,*),vr(ldvr,*)\n               end subroutine {ri}trsna'}), &
    & ('trsyl', ['TRSYL: solves the complex Sylvester matrix equation:', 'op(A)*X + X*op(B) = scale*C or', 'op(A)*X - X*op(B) = scale*C,', 'where op(A) = A or A**H, and A and B are both upper triangular. A is', 'M-by-M and B is N-by-N; the right hand side C and the solution X are', 'M-by-N; and scale is an output scale factor, set <= 1 to avoid', 'overflow in X.'], &
    &  [('ctrsyl', 'ctrsyl', 'complex'), ('dtrsyl', 'dtrsyl', 'real'), ('qtrsyl', 'qtrsyl', None), ('strsyl', 'strsyl', 'real'), ('wtrsyl', 'wtrsyl', None), ('xtrsyl', 'xtrsyl', None), ('ytrsyl', 'ytrsyl', None), ('ztrsyl', 'ztrsyl', 'complex')], &
    &  {'complex': '               subroutine {ri}trsyl(trana,tranb,isgn,m,n,a,lda,b,ldb,c,ldc,scale,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: trana,tranb\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: isgn,lda,ldb,ldc,m,n\n                    real({rk}),intent(out) :: scale\n                    {rt},intent(in) :: a(lda,*),b(ldb,*)\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}trsyl', 'real': '               subroutine {ri}trsyl(trana,tranb,isgn,m,n,a,lda,b,ldb,c,ldc,scale,info)\n                         \n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: trana,tranb\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: isgn,lda,ldb,ldc,m,n\n                    {rt},intent(out) :: scale\n                    {rt},intent(in) :: a(lda,*),b(ldb,*)\n                    {rt},intent(inout) :: c(ldc,*)\n               end subroutine {ri}trsyl'}), &
    & ('trtri', ['TRTRI: computes the inverse of a complex upper or lower triangular', 'matrix A.', 'This is the Level 3 BLAS version of the algorithm.'], &
