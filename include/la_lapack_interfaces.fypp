    & ('gemqr', ['GEMQR: overwrites the general real M-by-N matrix C with', "SIDE = 'L'     SIDE = 'R'", "TRANS = 'N':      Q * C          C * Q", "TRANS = 'T':      Q**H * C       C * Q**H", 'where Q is a complex unitary matrix defined as the product', 'of blocked elementary reflectors computed by tall skinny', 'QR factorization (CGEQR)'], &
