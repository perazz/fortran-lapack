#:include "common.fypp"
!> SVD drivers: divide and conquer, Jacobi and preconditioned Jacobi
module la_lapack_eigv_svd_drivers2
     use la_constants
     use la_blas_aux
     use la_blas_level1
     use la_blas_level3_gen
     use la_blas_level3_tri
     use la_lapack_aux
     use la_lapack_auxiliary
     use la_lapack_blas_like_base
     use la_lapack_blas_like_l1
     use la_lapack_blas_like_l2
     use la_lapack_blas_like_l3
     use la_lapack_blas_like_mnorm
     use la_lapack_blas_like_scalar
     use la_lapack_cosine_sine
     use la_lapack_eigv_svd_bidiag_dc
     use la_lapack_orthogonal_factors_ql
     use la_lapack_orthogonal_factors_qr
     use la_lapack_solve_chol_comp
     use la_lapack_solve_lu_comp
     use la_lapack_svd_comp
     implicit none(type,external)
     private

     public :: sp,dp,qp,lk,ilp
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     public :: la_${ri}$gesvj
     public :: la_${ri}$gejsv
     public :: la_${ri}$gesdd
#:endfor
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     public :: la_${ri}$gesdd
     public :: la_${ri}$gejsv
     public :: la_${ri}$gesvj
#:endfor

     contains

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GESVJ: computes the singular value decomposition (SVD) of a real
     !> M-by-N matrix A, where M >= N. The SVD of A is written as
     !> [++]   [xx]   [x0]   [xx]
     !> A = U * SIGMA * V^t,  [++] = [xx] * [ox] * [xx]
     !> [++]   [xx]
     !> where SIGMA is an N-by-N diagonal matrix, U is an M-by-N orthonormal
     !> matrix, and V is an N-by-N orthogonal matrix. The diagonal elements
     !> of SIGMA are the singular values of A. The columns of U and V are the
     !> left and the right singular vectors of A, respectively.
     !> ${ri.upper()}$GESVJ can sometimes compute tiny singular values and their singular vectors much
     !> more accurately than other SVD routines, see below under Further Details.

     pure subroutine la_${ri}$gesvj(joba,jobu,jobv,m,n,a,lda,sva,mv,v,ldv,work,lwork, &
               info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldv,lwork,m,mv,n
           character,intent(in) :: joba,jobu,jobv
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),v(ldv,*),work(lwork)
           real(${rk}$),intent(out) :: sva(n)
        ! =====================================================================
           ! Local Parameters
           integer(ilp),parameter :: nsweep = 30

           ! Local Scalars
           real(${rk}$) :: aapp,aapp0,aapq,aaqq,apoaq,aqoap,big,bigtheta,cs,ctol,epsln, &
           large,mxaapq,mxsinj,rootbig,rooteps,rootsfmin,roottol,skl,sfmin,small,sn,t, &
                     temp1,theta,thsign,tol
           integer(ilp) :: blskip,emptsw,i,ibr,ierr,igl,ijblsk,ir1,iswrot,jbc,jgl,kbl, &
                     lkahead,mvl,n2,n34,n4,nbl,notrot,p,pskipped,q,rowskip,swband
           logical(lk) :: applv,goscale,lower,lsvec,noscale,rotok,rsvec,uctol, &
                     upper
           ! Local Arrays
           real(${rk}$) :: fastr(5)
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,max,min,float,sign,sqrt
#:else
           intrinsic :: abs,max,min,real,sign,sqrt
#:endif
           ! from lapack
           ! from lapack
           ! Executable Statements
           ! test the input arguments
           lsvec = la_lsame(jobu,'U')
           uctol = la_lsame(jobu,'C')
           rsvec = la_lsame(jobv,'V')
           applv = la_lsame(jobv,'A')
           upper = la_lsame(joba,'U')
           lower = la_lsame(joba,'L')
           if (.not. (upper .or. lower .or. la_lsame(joba,'G'))) then
              info = -1
           else if (.not. (lsvec .or. uctol .or. la_lsame(jobu,'N'))) then
              info = -2
           else if (.not. (rsvec .or. applv .or. la_lsame(jobv,'N'))) then
              info = -3
           else if (m < 0) then
              info = -4
           else if ((n < 0) .or. (n > m)) then
              info = -5
           else if (lda < m) then
              info = -7
           else if (mv < 0) then
              info = -9
           else if ((rsvec .and. (ldv < n)) .or. (applv .and. (ldv < mv))) then
              info = -11
           else if (uctol .and. (work(1) <= one)) then
              info = -12
           else if (lwork < max(m + n,6)) then
              info = -13
           else
              info = 0
           end if
           ! #:(
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESVJ',-info)
              return
           end if
       ! #:) quick return for void matrix
           if ((m == 0) .or. (n == 0)) return
           ! set numerical parameters
           ! the stopping criterion for jacobi rotations is
           ! max_{i<>j}|a(:,i)^t * a(:,j)|/(||a(:,i)||*||a(:,j)||) < ctol*eps
           ! where eps is the round-off and ctol is defined as follows:
           if (uctol) then
              ! ... user controlled
              ctol = work(1)
           else
              ! ... default
              if (lsvec .or. rsvec .or. applv) then
                 ctol = sqrt(real(m,KIND=${rk}$))
              else
                 ctol = real(m,KIND=${rk}$)
              end if
           end if
           ! ... and the machine dependent parameters are
      ! [!]  (make sure that la_${ri}$lamch() works properly on the target machine.)
           epsln = la_${ri}$lamch('EPSILON')
           rooteps = sqrt(epsln)
           sfmin = la_${ri}$lamch('SAFEMINIMUM')
           rootsfmin = sqrt(sfmin)
           small = sfmin/epsln
           big = la_${ri}$lamch('OVERFLOW')
           ! big         = one    / sfmin
           rootbig = one/rootsfmin
           large = big/sqrt(real(m*n,KIND=${rk}$))
           bigtheta = one/rooteps
           tol = ctol*epsln
           roottol = sqrt(tol)
           if (real(m,KIND=${rk}$)*epsln >= one) then
              info = -4
              call la_xerbla('${ri.upper()}$GESVJ',-info)
              return
           end if
           ! initialize the right singular vector matrix.
           if (rsvec) then
              mvl = n
              call la_${ri}$laset('A',mvl,n,zero,one,v,ldv)
           else if (applv) then
              mvl = mv
           end if
           rsvec = rsvec .or. applv
           ! initialize sva( 1:n ) = ( ||a e_i||_2, i = 1:n )
      ! (!)  if necessary, scale a to protect the largest singular value
           ! from overflow. it is possible that saving the largest singular
           ! value destroys the information about the small ones.
           ! this initial scaling is almost minimal in the sense that the
           ! goal is to make sure that no column norm overflows, and that
           ! sqrt(n)*max_i sva(i) does not overflow. if infinite entries
           ! in a are detected, the procedure returns with info=-6.
           skl = one/sqrt(real(m,KIND=${rk}$)*real(n,KIND=${rk}$))
           noscale = .true.
           goscale = .true.
           if (lower) then
              ! the input matrix is m-by-n lower triangular (trapezoidal)
              do p = 1,n
                 aapp = zero
                 aaqq = one
                 call la_${ri}$lassq(m - p + 1,a(p,p),1,aapp,aaqq)
                 if (aapp > big) then
                    info = -6
                    call la_xerbla('${ri.upper()}$GESVJ',-info)
                    return
                 end if
                 aaqq = sqrt(aaqq)
                 if ((aapp < (big/aaqq)) .and. noscale) then
                    sva(p) = aapp*aaqq
                 else
                    noscale = .false.
                    sva(p) = aapp*(aaqq*skl)
                    if (goscale) then
                       goscale = .false.
                       do q = 1,p - 1
                          sva(q) = sva(q)*skl
                       end do
                    end if
                 end if
              end do
           else if (upper) then
              ! the input matrix is m-by-n upper triangular (trapezoidal)
              do p = 1,n
                 aapp = zero
                 aaqq = one
                 call la_${ri}$lassq(p,a(1,p),1,aapp,aaqq)
                 if (aapp > big) then
                    info = -6
                    call la_xerbla('${ri.upper()}$GESVJ',-info)
                    return
                 end if
                 aaqq = sqrt(aaqq)
                 if ((aapp < (big/aaqq)) .and. noscale) then
                    sva(p) = aapp*aaqq
                 else
                    noscale = .false.
                    sva(p) = aapp*(aaqq*skl)
                    if (goscale) then
                       goscale = .false.
                       do q = 1,p - 1
                          sva(q) = sva(q)*skl
                       end do
                    end if
                 end if
              end do
           else
              ! the input matrix is m-by-n general dense
              do p = 1,n
                 aapp = zero
                 aaqq = one
                 call la_${ri}$lassq(m,a(1,p),1,aapp,aaqq)
                 if (aapp > big) then
                    info = -6
                    call la_xerbla('${ri.upper()}$GESVJ',-info)
                    return
                 end if
                 aaqq = sqrt(aaqq)
                 if ((aapp < (big/aaqq)) .and. noscale) then
                    sva(p) = aapp*aaqq
                 else
                    noscale = .false.
                    sva(p) = aapp*(aaqq*skl)
                    if (goscale) then
                       goscale = .false.
                       do q = 1,p - 1
                          sva(q) = sva(q)*skl
                       end do
                    end if
                 end if
              end do
           end if
           if (noscale) skl = one
           ! move the smaller part of the spectrum from the underflow threshold
      ! (!)  start by determining the position of the nonzero entries of the
           ! array sva() relative to ( sfmin, big ).
           aapp = zero
           aaqq = big
           do p = 1,n
              if (sva(p) /= zero) aaqq = min(aaqq,sva(p))
              aapp = max(aapp,sva(p))
           end do
       ! #:) quick return for zero matrix
           if (aapp == zero) then
              if (lsvec) call la_${ri}$laset('G',m,n,zero,one,a,lda)
              work(1) = one
              work(2) = zero
              work(3) = zero
              work(4) = zero
              work(5) = zero
              work(6) = zero
              return
           end if
       ! #:) quick return for one-column matrix
           if (n == 1) then
              if (lsvec) call la_${ri}$lascl('G',0,0,sva(1),skl,m,1,a(1,1),lda,ierr)

              work(1) = one/skl
              if (sva(1) >= sfmin) then
                 work(2) = one
              else
                 work(2) = zero
              end if
              work(3) = zero
              work(4) = zero
              work(5) = zero
              work(6) = zero
              return
           end if
           ! protect small singular values from underflow, and try to
           ! avoid underflows/overflows in computing jacobi rotations.
           sn = sqrt(sfmin/epsln)
           temp1 = sqrt(big/real(n,KIND=${rk}$))
           if ((aapp <= sn) .or. (aaqq >= temp1) .or. ((sn <= aaqq) .and. (aapp <= temp1))) &
                     then
              temp1 = min(big,temp1/aapp)
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else if ((aaqq <= sn) .and. (aapp <= temp1)) then
              temp1 = min(sn/aaqq,big/(aapp*sqrt(real(n,KIND=${rk}$))))
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else if ((aaqq >= sn) .and. (aapp >= temp1)) then
              temp1 = max(sn/aaqq,temp1/aapp)
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else if ((aaqq <= sn) .and. (aapp >= temp1)) then
              temp1 = min(sn/aaqq,big/(sqrt(real(n,KIND=${rk}$))*aapp))
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else
              temp1 = one
           end if
           ! scale, if necessary
           if (temp1 /= one) then
              call la_${ri}$lascl('G',0,0,one,temp1,n,1,sva,n,ierr)
           end if
           skl = temp1*skl
           if (skl /= one) then
              call la_${ri}$lascl(joba,0,0,one,skl,m,n,a,lda,ierr)
              skl = one/skl
           end if
           ! row-cyclic jacobi svd algorithm with column pivoting
           emptsw = (n*(n - 1))/2
           notrot = 0
           fastr(1) = zero
           ! a is represented in factored form a = a * diag(work), where diag(work)
           ! is initialized to identity. work is updated during fast scaled
           ! rotations.
           do q = 1,n
              work(q) = one
           end do
           swband = 3
      ! [tp] swband is a tuning parameter [tp]. it is meaningful and effective
           ! if la_${ri}$gesvj is used as a computational routine in the preconditioned
           ! jacobi svd algorithm la_${ri}$gesvj. for sweeps i=1:swband the procedure
           ! works on pivots inside a band-like region around the diagonal.
           ! the boundaries are determined dynamically, based on the number of
           ! pivots above a threshold.
           kbl = min(8,n)
      ! [tp] kbl is a tuning parameter that defines the tile size in the
           ! tiling of the p-q loops of pivot pairs. in general, an optimal
           ! value of kbl depends on the matrix dimensions and on the
           ! parameters of the computer's memory.
           nbl = n/kbl
           if ((nbl*kbl) /= n) nbl = nbl + 1
           blskip = kbl**2
      ! [tp] blkskip is a tuning parameter that depends on swband and kbl.
           rowskip = min(5,kbl)
      ! [tp] rowskip is a tuning parameter.
           lkahead = 1
      ! [tp] lkahead is a tuning parameter.
           ! quasi block transformations, using the lower (upper) triangular
           ! structure of the input matrix. the quasi-block-cycling usually
           ! invokes cubic convergence. big part of this cycle is done inside
           ! canonical subspaces of dimensions less than m.
           if ((lower .or. upper) .and. (n > max(64,4*kbl))) then
      ! [tp] the number of partition levels and the actual partition are
           ! tuning parameters.
              n4 = n/4
              n2 = n/2
              n34 = 3*n4
              if (applv) then
                 q = 0
              else
                 q = 1
              end if
              if (lower) then
           ! this works very well on lower triangular matrices, in particular
           ! in the framework of the preconditioned jacobi svd (xgejsv).
           ! the idea is simple:
           ! [+ 0 0 0]   note that jacobi transformations of [0 0]
           ! [+ + 0 0]                                       [0 0]
           ! [+ + x 0]   actually work on [x 0]              [x 0]
           ! [+ + x x]                    [x x].             [x x]
                 call la_${ri}$gsvj0(jobv,m - n34,n - n34,a(n34 + 1,n34 + 1),lda,work(n34 + 1), &
                 sva(n34 + 1),mvl,v(n34*q + 1,n34 + 1),ldv,epsln,sfmin,tol,2,work(n + 1), &
                           lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,m - n2,n34 - n2,a(n2 + 1,n2 + 1),lda,work(n2 + 1),sva( &
                 n2 + 1),mvl,v(n2*q + 1,n2 + 1),ldv,epsln,sfmin,tol,2,work(n + 1),lwork - n, &
                           ierr)
                 call la_${ri}$gsvj1(jobv,m - n2,n - n2,n4,a(n2 + 1,n2 + 1),lda,work(n2 + 1),sva( &
                  n2 + 1),mvl,v(n2*q + 1,n2 + 1),ldv,epsln,sfmin,tol,1,work(n + 1),lwork - n, &
                            ierr)
                 call la_${ri}$gsvj0(jobv,m - n4,n2 - n4,a(n4 + 1,n4 + 1),lda,work(n4 + 1),sva( &
                 n4 + 1),mvl,v(n4*q + 1,n4 + 1),ldv,epsln,sfmin,tol,1,work(n + 1),lwork - n, &
                           ierr)
                 call la_${ri}$gsvj0(jobv,m,n4,a,lda,work,sva,mvl,v,ldv,epsln,sfmin, &
                           tol,1,work(n + 1),lwork - n,ierr)
                 call la_${ri}$gsvj1(jobv,m,n2,n4,a,lda,work,sva,mvl,v,ldv,epsln,sfmin, &
                            tol,1,work(n + 1),lwork - n,ierr)
              else if (upper) then
                 call la_${ri}$gsvj0(jobv,n4,n4,a,lda,work,sva,mvl,v,ldv,epsln,sfmin, &
                           tol,2,work(n + 1),lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,n2,n4,a(1,n4 + 1),lda,work(n4 + 1),sva(n4 + 1), &
                 mvl,v(n4*q + 1,n4 + 1),ldv,epsln,sfmin,tol,1,work(n + 1),lwork - n,ierr)

                 call la_${ri}$gsvj1(jobv,n2,n2,n4,a,lda,work,sva,mvl,v,ldv,epsln, &
                           sfmin,tol,1,work(n + 1),lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,n2 + n4,n4,a(1,n2 + 1),lda,work(n2 + 1),sva(n2 + 1), &
                  mvl,v(n2*q + 1,n2 + 1),ldv,epsln,sfmin,tol,1,work(n + 1),lwork - n,ierr)

              end if
           end if
           ! .. row-cyclic pivot strategy with de rijk's pivoting ..
           loop_1993: do i = 1,nsweep
           ! .. go go go ...
              mxaapq = zero
              mxsinj = zero
              iswrot = 0
              notrot = 0
              pskipped = 0
           ! each sweep is unrolled using kbl-by-kbl tiles over the pivot pairs
           ! 1 <= p < q <= n. this is the first step toward a blocked implementation
           ! of the rotations. new implementation, based on block transformations,
           ! is under development.
              loop_2000: do ibr = 1,nbl
                 igl = (ibr - 1)*kbl + 1
                 loop_1002: do ir1 = 0,min(lkahead,nbl - ibr)
                    igl = igl + ir1*kbl
                    loop_2001: do p = igl,min(igl + kbl - 1,n - 1)
           ! .. de rijk's pivoting
                       q = la_i${ri}$amax(n - p + 1,sva(p),1) + p - 1
                       if (p /= q) then
                          call la_${ri}$swap(m,a(1,p),1,a(1,q),1)
                          if (rsvec) call la_${ri}$swap(mvl,v(1,p),1,v(1,q),1)
                          temp1 = sva(p)
                          sva(p) = sva(q)
                          sva(q) = temp1
                          temp1 = work(p)
                          work(p) = work(q)
                          work(q) = temp1
                       end if
                       if (ir1 == 0) then
              ! column norms are periodically updated by explicit
              ! norm computation.
              ! caveat:
              ! unfortunately, some blas implementations compute la_${ri}$nrm2(m,a(1,p),1)
              ! as sqrt(la_${ri}$dot(m,a(1,p),1,a(1,p),1)), which may cause the result to
              ! overflow for ||a(:,p)||_2 > sqrt(overflow_threshold), and to
              ! underflow for ||a(:,p)||_2 < sqrt(underflow_threshold).
              ! hence, la_${ri}$nrm2 cannot be trusted, not even in the case when
              ! the true norm is far from the under(over)flow boundaries.
              ! if properly implemented la_${ri}$nrm2 is available, the if-then-else
              ! below should read "aapp = la_${ri}$nrm2( m, a(1,p), 1 ) * work(p)".
                          if ((sva(p) < rootbig) .and. (sva(p) > rootsfmin)) then
                             sva(p) = la_${ri}$nrm2(m,a(1,p),1)*work(p)
                          else
                             temp1 = zero
                             aapp = one
                             call la_${ri}$lassq(m,a(1,p),1,temp1,aapp)
                             sva(p) = temp1*sqrt(aapp)*work(p)
                          end if
                          aapp = sva(p)
                       else
                          aapp = sva(p)
                       end if
                       if (aapp > zero) then
                          pskipped = 0
                          loop_2002: do q = p + 1,min(igl + kbl - 1,n)
                             aaqq = sva(q)
                             if (aaqq > zero) then
                                aapp0 = aapp
                                if (aaqq >= one) then
                                   rotok = (small*aapp) <= aaqq
                                   if (aapp < (big/aaqq)) then
                                      aapq = (la_${ri}$dot(m,a(1,p),1,a(1,q),1)*work( &
                                                p)*work(q)/aaqq)/aapp
                                   else
                                      call la_${ri}$copy(m,a(1,p),1,work(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aapp,work(p),m,1,work(n + &
                                                1),lda,ierr)
                                      aapq = la_${ri}$dot(m,work(n + 1),1,a(1,q),1)*work( &
                                                q)/aaqq
                                   end if
                                else
                                   rotok = aapp <= (aaqq/small)
                                   if (aapp > (small/aaqq)) then
                                      aapq = (la_${ri}$dot(m,a(1,p),1,a(1,q),1)*work( &
                                                p)*work(q)/aaqq)/aapp
                                   else
                                      call la_${ri}$copy(m,a(1,q),1,work(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aaqq,work(q),m,1,work(n + &
                                                1),lda,ierr)
                                      aapq = la_${ri}$dot(m,work(n + 1),1,a(1,p),1)*work( &
                                                p)/aapp
                                   end if
                                end if
                                mxaapq = max(mxaapq,abs(aapq))
              ! to rotate or not to rotate, that is the question ...
                                if (abs(aapq) > tol) then
                 ! Rotate
      ! [rtd]      rotated = rotated + one
                                   if (ir1 == 0) then
                                      notrot = 0
                                      pskipped = 0
                                      iswrot = iswrot + 1
                                   end if
                                   if (rotok) then
                                      aqoap = aaqq/aapp
                                      apoaq = aapp/aaqq
                                      theta = -half*abs(aqoap - apoaq)/aapq
                                      if (abs(theta) > bigtheta) then
                                         t = half/theta
                                         fastr(3) = t*work(p)/work(q)
                                         fastr(4) = -t*work(q)/work(p)
                                         call la_${ri}$rotm(m,a(1,p),1,a(1,q),1,fastr)

                                         if (rsvec) call la_${ri}$rotm(mvl,v(1,p),1,v(1,q), &
                                                    1,fastr)
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq))
                                         mxsinj = max(mxsinj,abs(t))
                                      else
                       ! Choose Correct Signum For Theta And Rotate
                                         thsign = -sign(one,aapq)
                                         t = one/(theta + thsign*sqrt(one + theta*theta))

                                         cs = sqrt(one/(one + t*t))
                                         sn = t*cs
                                         mxsinj = max(mxsinj,abs(sn))
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq))
                                         apoaq = work(p)/work(q)
                                         aqoap = work(q)/work(p)
                                         if (work(p) >= one) then
                                            if (work(q) >= one) then
                                               fastr(3) = t*apoaq
                                               fastr(4) = -t*aqoap
                                               work(p) = work(p)*cs
                                               work(q) = work(q)*cs
                                               call la_${ri}$rotm(m,a(1,p),1,a(1,q),1, &
                                                         fastr)
                                               if (rsvec) call la_${ri}$rotm(mvl,v(1,p),1,v( &
                                                         1,q),1,fastr)
                                            else
                                               call la_${ri}$axpy(m,-t*aqoap,a(1,q),1,a(1, &
                                                         p),1)
                                               call la_${ri}$axpy(m,cs*sn*apoaq,a(1,p),1,a( &
                                                         1,q),1)
                                               work(p) = work(p)*cs
                                               work(q) = work(q)/cs
                                               if (rsvec) then
                                                  call la_${ri}$axpy(mvl,-t*aqoap,v(1,q),1,v( &
                                                             1,p),1)
                                                  call la_${ri}$axpy(mvl,cs*sn*apoaq,v(1,p),1, &
                                                            v(1,q),1)
                                               end if
                                            end if
                                         else
                                            if (work(q) >= one) then
                                               call la_${ri}$axpy(m,t*apoaq,a(1,p),1,a(1,q &
                                                         ),1)
                                               call la_${ri}$axpy(m,-cs*sn*aqoap,a(1,q),1,a( &
                                                         1,p),1)
                                               work(p) = work(p)/cs
                                               work(q) = work(q)*cs
                                               if (rsvec) then
                                                  call la_${ri}$axpy(mvl,t*apoaq,v(1,p),1,v( &
                                                            1,q),1)
                                                  call la_${ri}$axpy(mvl,-cs*sn*aqoap,v(1,q), &
                                                            1,v(1,p),1)
                                               end if
                                            else
                                               if (work(p) >= work(q)) then
                                                  call la_${ri}$axpy(m,-t*aqoap,a(1,q),1,a( &
                                                            1,p),1)
                                                  call la_${ri}$axpy(m,cs*sn*apoaq,a(1,p),1, &
                                                            a(1,q),1)
                                                  work(p) = work(p)*cs
                                                  work(q) = work(q)/cs
                                                  if (rsvec) then
                                                     call la_${ri}$axpy(mvl,-t*aqoap,v(1,q),1, &
                                                               v(1,p),1)
                                                     call la_${ri}$axpy(mvl,cs*sn*apoaq,v(1,p), &
                                                                1,v(1,q),1)
                                                  end if
                                               else
                                                  call la_${ri}$axpy(m,t*apoaq,a(1,p),1,a(1, &
                                                             q),1)
                                                  call la_${ri}$axpy(m,-cs*sn*aqoap,a(1,q),1, &
                                                            a(1,p),1)
                                                  work(p) = work(p)/cs
                                                  work(q) = work(q)*cs
                                                  if (rsvec) then
                                                     call la_${ri}$axpy(mvl,t*apoaq,v(1,p),1, &
                                                               v(1,q),1)
                                                     call la_${ri}$axpy(mvl,-cs*sn*aqoap,v(1,q) &
                                                               ,1,v(1,p),1)
                                                  end if
                                               end if
                                            end if
                                         end if
                                      end if
                                   else
                    ! .. have to use modified gram-schmidt like transformation
                                      call la_${ri}$copy(m,a(1,p),1,work(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aapp,one,m,1,work(n + 1), &
                                                lda,ierr)
                                      call la_${ri}$lascl('G',0,0,aaqq,one,m,1,a(1,q), &
                                                lda,ierr)
                                      temp1 = -aapq*work(p)/work(q)
                                      call la_${ri}$axpy(m,temp1,work(n + 1),1,a(1,q),1)

                                      call la_${ri}$lascl('G',0,0,one,aaqq,m,1,a(1,q), &
                                                lda,ierr)
                                      sva(q) = aaqq*sqrt(max(zero,one - aapq*aapq))
                                      mxsinj = max(mxsinj,sfmin)
                                   end if
                 ! end if rotok then ... else
                 ! in the case of cancellation in updating sva(q), sva(p)
                 ! recompute sva(q), sva(p).
                                   if ((sva(q)/aaqq)**2 <= rooteps) then
                                      if ((aaqq < rootbig) .and. (aaqq > rootsfmin)) then
                                         sva(q) = la_${ri}$nrm2(m,a(1,q),1)*work(q)

                                      else
                                         t = zero
                                         aaqq = one
                                         call la_${ri}$lassq(m,a(1,q),1,t,aaqq)
                                         sva(q) = t*sqrt(aaqq)*work(q)
                                      end if
                                   end if
                                   if ((aapp/aapp0) <= rooteps) then
                                      if ((aapp < rootbig) .and. (aapp > rootsfmin)) then
                                         aapp = la_${ri}$nrm2(m,a(1,p),1)*work(p)
                                      else
                                         t = zero
                                         aapp = one
                                         call la_${ri}$lassq(m,a(1,p),1,t,aapp)
                                         aapp = t*sqrt(aapp)*work(p)
                                      end if
                                      sva(p) = aapp
                                   end if
                                else
              ! a(:,p) and a(:,q) already numerically orthogonal
                                   if (ir1 == 0) notrot = notrot + 1
      ! [rtd]      skipped  = skipped  + 1
                                   pskipped = pskipped + 1
                                end if
                             else
              ! a(:,q) is zero column
                                if (ir1 == 0) notrot = notrot + 1
                                pskipped = pskipped + 1
                             end if
                             if ((i <= swband) .and. (pskipped > rowskip)) then
                                if (ir1 == 0) aapp = -aapp
                                notrot = 0
                                go to 2103
                             end if
                          end do loop_2002
           ! end q-loop
           2103 continue
           ! bailed out of q-loop
                          sva(p) = aapp
                       else
                          sva(p) = aapp
                          if ((ir1 == 0) .and. (aapp == zero)) notrot = notrot + min(igl + kbl - 1, &
                                    n) - p
                       end if
                    end do loop_2001
           ! end of the p-loop
           ! end of doing the block ( ibr, ibr )
                 end do loop_1002
           ! end of ir1-loop
       ! ... go to the off diagonal blocks
                 igl = (ibr - 1)*kbl + 1
                 loop_2010: do jbc = ibr + 1,nbl
                    jgl = (jbc - 1)*kbl + 1
              ! doing the block at ( ibr, jbc )
                    ijblsk = 0
                    loop_2100: do p = igl,min(igl + kbl - 1,n)
                       aapp = sva(p)
                       if (aapp > zero) then
                          pskipped = 0
                          loop_2200: do q = jgl,min(jgl + kbl - 1,n)
                             aaqq = sva(q)
                             if (aaqq > zero) then
                                aapp0 = aapp
           ! M X 2 Jacobi Svd
              ! safe gram matrix computation
                                if (aaqq >= one) then
                                   if (aapp >= aaqq) then
                                      rotok = (small*aapp) <= aaqq
                                   else
                                      rotok = (small*aaqq) <= aapp
                                   end if
                                   if (aapp < (big/aaqq)) then
                                      aapq = (la_${ri}$dot(m,a(1,p),1,a(1,q),1)*work( &
                                                p)*work(q)/aaqq)/aapp
                                   else
                                      call la_${ri}$copy(m,a(1,p),1,work(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aapp,work(p),m,1,work(n + &
                                                1),lda,ierr)
                                      aapq = la_${ri}$dot(m,work(n + 1),1,a(1,q),1)*work( &
                                                q)/aaqq
                                   end if
                                else
                                   if (aapp >= aaqq) then
                                      rotok = aapp <= (aaqq/small)
                                   else
                                      rotok = aaqq <= (aapp/small)
                                   end if
                                   if (aapp > (small/aaqq)) then
                                      aapq = (la_${ri}$dot(m,a(1,p),1,a(1,q),1)*work( &
                                                p)*work(q)/aaqq)/aapp
                                   else
                                      call la_${ri}$copy(m,a(1,q),1,work(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aaqq,work(q),m,1,work(n + &
                                                1),lda,ierr)
                                      aapq = la_${ri}$dot(m,work(n + 1),1,a(1,p),1)*work( &
                                                p)/aapp
                                   end if
                                end if
                                mxaapq = max(mxaapq,abs(aapq))
              ! to rotate or not to rotate, that is the question ...
                                if (abs(aapq) > tol) then
                                   notrot = 0
      ! [rtd]      rotated  = rotated + 1
                                   pskipped = 0
                                   iswrot = iswrot + 1
                                   if (rotok) then
                                      aqoap = aaqq/aapp
                                      apoaq = aapp/aaqq
                                      theta = -half*abs(aqoap - apoaq)/aapq
                                      if (aaqq > aapp0) theta = -theta
                                      if (abs(theta) > bigtheta) then
                                         t = half/theta
                                         fastr(3) = t*work(p)/work(q)
                                         fastr(4) = -t*work(q)/work(p)
                                         call la_${ri}$rotm(m,a(1,p),1,a(1,q),1,fastr)

                                         if (rsvec) call la_${ri}$rotm(mvl,v(1,p),1,v(1,q), &
                                                    1,fastr)
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq))
                                         mxsinj = max(mxsinj,abs(t))
                                      else
                       ! Choose Correct Signum For Theta And Rotate
                                         thsign = -sign(one,aapq)
                                         if (aaqq > aapp0) thsign = -thsign
                                         t = one/(theta + thsign*sqrt(one + theta*theta))

                                         cs = sqrt(one/(one + t*t))
                                         sn = t*cs
                                         mxsinj = max(mxsinj,abs(sn))
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq))
                                         apoaq = work(p)/work(q)
                                         aqoap = work(q)/work(p)
                                         if (work(p) >= one) then
                                            if (work(q) >= one) then
                                               fastr(3) = t*apoaq
                                               fastr(4) = -t*aqoap
                                               work(p) = work(p)*cs
                                               work(q) = work(q)*cs
                                               call la_${ri}$rotm(m,a(1,p),1,a(1,q),1, &
                                                         fastr)
                                               if (rsvec) call la_${ri}$rotm(mvl,v(1,p),1,v( &
                                                         1,q),1,fastr)
                                            else
                                               call la_${ri}$axpy(m,-t*aqoap,a(1,q),1,a(1, &
                                                         p),1)
                                               call la_${ri}$axpy(m,cs*sn*apoaq,a(1,p),1,a( &
                                                         1,q),1)
                                               if (rsvec) then
                                                  call la_${ri}$axpy(mvl,-t*aqoap,v(1,q),1,v( &
                                                             1,p),1)
                                                  call la_${ri}$axpy(mvl,cs*sn*apoaq,v(1,p),1, &
                                                            v(1,q),1)
                                               end if
                                               work(p) = work(p)*cs
                                               work(q) = work(q)/cs
                                            end if
                                         else
                                            if (work(q) >= one) then
                                               call la_${ri}$axpy(m,t*apoaq,a(1,p),1,a(1,q &
                                                         ),1)
                                               call la_${ri}$axpy(m,-cs*sn*aqoap,a(1,q),1,a( &
                                                         1,p),1)
                                               if (rsvec) then
                                                  call la_${ri}$axpy(mvl,t*apoaq,v(1,p),1,v( &
                                                            1,q),1)
                                                  call la_${ri}$axpy(mvl,-cs*sn*aqoap,v(1,q), &
                                                            1,v(1,p),1)
                                               end if
                                               work(p) = work(p)/cs
                                               work(q) = work(q)*cs
                                            else
                                               if (work(p) >= work(q)) then
                                                  call la_${ri}$axpy(m,-t*aqoap,a(1,q),1,a( &
                                                            1,p),1)
                                                  call la_${ri}$axpy(m,cs*sn*apoaq,a(1,p),1, &
                                                            a(1,q),1)
                                                  work(p) = work(p)*cs
                                                  work(q) = work(q)/cs
                                                  if (rsvec) then
                                                     call la_${ri}$axpy(mvl,-t*aqoap,v(1,q),1, &
                                                               v(1,p),1)
                                                     call la_${ri}$axpy(mvl,cs*sn*apoaq,v(1,p), &
                                                                1,v(1,q),1)
                                                  end if
                                               else
                                                  call la_${ri}$axpy(m,t*apoaq,a(1,p),1,a(1, &
                                                             q),1)
                                                  call la_${ri}$axpy(m,-cs*sn*aqoap,a(1,q),1, &
                                                            a(1,p),1)
                                                  work(p) = work(p)/cs
                                                  work(q) = work(q)*cs
                                                  if (rsvec) then
                                                     call la_${ri}$axpy(mvl,t*apoaq,v(1,p),1, &
                                                               v(1,q),1)
                                                     call la_${ri}$axpy(mvl,-cs*sn*aqoap,v(1,q) &
                                                               ,1,v(1,p),1)
                                                  end if
                                               end if
                                            end if
                                         end if
                                      end if
                                   else
                                      if (aapp > aaqq) then
                                         call la_${ri}$copy(m,a(1,p),1,work(n + 1),1)

                                         call la_${ri}$lascl('G',0,0,aapp,one,m,1,work(n + 1 &
                                                   ),lda,ierr)
                                         call la_${ri}$lascl('G',0,0,aaqq,one,m,1,a(1,q), &
                                                    lda,ierr)
                                         temp1 = -aapq*work(p)/work(q)
                                         call la_${ri}$axpy(m,temp1,work(n + 1),1,a(1,q),1 &
                                                   )
                                         call la_${ri}$lascl('G',0,0,one,aaqq,m,1,a(1,q), &
                                                    lda,ierr)
                                         sva(q) = aaqq*sqrt(max(zero,one - aapq*aapq))
                                         mxsinj = max(mxsinj,sfmin)
                                      else
                                         call la_${ri}$copy(m,a(1,q),1,work(n + 1),1)

                                         call la_${ri}$lascl('G',0,0,aaqq,one,m,1,work(n + 1 &
                                                   ),lda,ierr)
                                         call la_${ri}$lascl('G',0,0,aapp,one,m,1,a(1,p), &
                                                    lda,ierr)
                                         temp1 = -aapq*work(q)/work(p)
                                         call la_${ri}$axpy(m,temp1,work(n + 1),1,a(1,p),1 &
                                                   )
                                         call la_${ri}$lascl('G',0,0,one,aapp,m,1,a(1,p), &
                                                    lda,ierr)
                                         sva(p) = aapp*sqrt(max(zero,one - aapq*aapq))
                                         mxsinj = max(mxsinj,sfmin)
                                      end if
                                   end if
                 ! end if rotok then ... else
                 ! in the case of cancellation in updating sva(q)
                 ! .. recompute sva(q)
                                   if ((sva(q)/aaqq)**2 <= rooteps) then
                                      if ((aaqq < rootbig) .and. (aaqq > rootsfmin)) then
                                         sva(q) = la_${ri}$nrm2(m,a(1,q),1)*work(q)

                                      else
                                         t = zero
                                         aaqq = one
                                         call la_${ri}$lassq(m,a(1,q),1,t,aaqq)
                                         sva(q) = t*sqrt(aaqq)*work(q)
                                      end if
                                   end if
                                   if ((aapp/aapp0)**2 <= rooteps) then
                                      if ((aapp < rootbig) .and. (aapp > rootsfmin)) then
                                         aapp = la_${ri}$nrm2(m,a(1,p),1)*work(p)
                                      else
                                         t = zero
                                         aapp = one
                                         call la_${ri}$lassq(m,a(1,p),1,t,aapp)
                                         aapp = t*sqrt(aapp)*work(p)
                                      end if
                                      sva(p) = aapp
                                   end if
                    ! end of ok rotation
                                else
                                   notrot = notrot + 1
      ! [rtd]      skipped  = skipped  + 1
                                   pskipped = pskipped + 1
                                   ijblsk = ijblsk + 1
                                end if
                             else
                                notrot = notrot + 1
                                pskipped = pskipped + 1
                                ijblsk = ijblsk + 1
                             end if
                             if ((i <= swband) .and. (ijblsk >= blskip)) then
                                sva(p) = aapp
                                notrot = 0
                                go to 2011
                             end if
                             if ((i <= swband) .and. (pskipped > rowskip)) then
                                aapp = -aapp
                                notrot = 0
                                go to 2203
                             end if
                          end do loop_2200
              ! end of the q-loop
              2203 continue
                          sva(p) = aapp
                       else
                          if (aapp == zero) notrot = notrot + min(jgl + kbl - 1,n) - jgl + 1
                          if (aapp < zero) notrot = 0
                       end if
                    end do loop_2100
           ! end of the p-loop
                 end do loop_2010
           ! end of the jbc-loop
           2011 continue
      ! 2011 bailed out of the jbc-loop
                 do p = igl,min(igl + kbl - 1,n)
                    sva(p) = abs(sva(p))
                 end do
      ! **
              end do loop_2000
      ! 2000 :: end of the ibr-loop
           ! .. update sva(n)
              if ((sva(n) < rootbig) .and. (sva(n) > rootsfmin)) then
                 sva(n) = la_${ri}$nrm2(m,a(1,n),1)*work(n)
              else
                 t = zero
                 aapp = one
                 call la_${ri}$lassq(m,a(1,n),1,t,aapp)
                 sva(n) = t*sqrt(aapp)*work(n)
              end if
           ! additional steering devices
              if ((i < swband) .and. ((mxaapq <= roottol) .or. (iswrot <= n))) swband = i
              if ((i > swband + 1) .and. (mxaapq < sqrt(real(n,KIND=${rk}$))*tol) .and. (real(n, &
                        KIND=${rk}$)*mxaapq*mxsinj < tol)) then
                 go to 1994
              end if
              if (notrot >= emptsw) go to 1994
           end do loop_1993
           ! end i=1:nsweep loop
       ! #:( reaching this point means that the procedure has not converged.
           info = nsweep - 1
           go to 1995
           1994 continue
       ! #:) reaching this point means numerical convergence after the i-th
           ! sweep.
           info = 0
       ! #:) info = 0 confirms successful iterations.
       1995 continue
           ! sort the singular values and find how many are above
           ! the underflow threshold.
           n2 = 0
           n4 = 0
           do p = 1,n - 1
              q = la_i${ri}$amax(n - p + 1,sva(p),1) + p - 1
              if (p /= q) then
                 temp1 = sva(p)
                 sva(p) = sva(q)
                 sva(q) = temp1
                 temp1 = work(p)
                 work(p) = work(q)
                 work(q) = temp1
                 call la_${ri}$swap(m,a(1,p),1,a(1,q),1)
                 if (rsvec) call la_${ri}$swap(mvl,v(1,p),1,v(1,q),1)
              end if
              if (sva(p) /= zero) then
                 n4 = n4 + 1
                 if (sva(p)*skl > sfmin) n2 = n2 + 1
              end if
           end do
           if (sva(n) /= zero) then
              n4 = n4 + 1
              if (sva(n)*skl > sfmin) n2 = n2 + 1
           end if
           ! normalize the left singular vectors.
           if (lsvec .or. uctol) then
              do p = 1,n2
                 call la_${ri}$scal(m,work(p)/sva(p),a(1,p),1)
              end do
           end if
           ! scale the product of jacobi rotations (assemble the fast rotations).
           if (rsvec) then
              if (applv) then
                 do p = 1,n
                    call la_${ri}$scal(mvl,work(p),v(1,p),1)
                 end do
              else
                 do p = 1,n
                    temp1 = one/la_${ri}$nrm2(mvl,v(1,p),1)
                    call la_${ri}$scal(mvl,temp1,v(1,p),1)
                 end do
              end if
           end if
           ! undo scaling, if necessary (and possible).
#:if rk == "sp"
           if (((skl > one) .and. (sva(1) < (big/skl))) .or. ((skl < one) .and. (sva( &
                     max(n2,1)) > (sfmin/skl)))) then
#:else
           if (((skl > one) .and. (sva(1) < (big/skl))) .or. ((skl < one) .and. (sva(max( &
                      n2,1)) > (sfmin/skl)))) then
#:endif
              do p = 1,n
                 sva(p) = skl*sva(p)
              end do
              skl = one
           end if
           work(1) = skl
           ! the singular values of a are skl*sva(1:n). if skl/=one
           ! then some of the singular values may overflow or underflow and
           ! the spectrum is given in this factored representation.
           work(2) = real(n4,KIND=${rk}$)
           ! n4 is the number of computed nonzero singular values of a.
           work(3) = real(n2,KIND=${rk}$)
           ! n2 is the number of singular values of a greater than sfmin.
           ! if n2<n, sva(n2:n) contains zeros and/or denormalized numbers
           ! that may carry some information.
           work(4) = real(i,KIND=${rk}$)
           ! i is the index of the last sweep before declaring convergence.
           work(5) = mxaapq
           ! mxaapq is the largest absolute value of scaled pivots in the
           ! last sweep
           work(6) = mxsinj
           ! mxsinj is the largest absolute value of the sines of jacobi angles
           ! in the last sweep
           return
     end subroutine la_${ri}$gesvj
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEJSV: computes the singular value decomposition (SVD) of a real M-by-N
     !> matrix [A], where M >= N. The SVD of [A] is written as
     !> [A] = [U] * [SIGMA] * [V]^t,
     !> where [SIGMA] is an N-by-N (M-by-N) matrix which is zero except for its N
     !> diagonal elements, [U] is an M-by-N (or M-by-M) orthonormal matrix, and
     !> [V] is an N-by-N orthogonal matrix. The diagonal elements of [SIGMA] are
     !> the singular values of [A]. The columns of [U] and [V] are the left and
     !> the right singular vectors of [A], respectively. The matrices [U] and [V]
     !> are computed and stored in the arrays U and V, respectively. The diagonal
     !> of [SIGMA] is computed and stored in the array SVA.
     !> ${ri.upper()}$GEJSV can sometimes compute tiny singular values and their singular vectors much
     !> more accurately than other SVD routines, see below under Further Details.

     pure subroutine la_${ri}$gejsv(joba,jobu,jobv,jobr,jobt,jobp,m,n,a,lda,sva,u,ldu, &
               v,ldv,work,lwork,iwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldu,ldv,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: sva(n),u(ldu,*),v(ldv,*),work(lwork)
           integer(ilp),intent(out) :: iwork(*)
           character,intent(in) :: joba,jobp,jobr,jobt,jobu,jobv
        ! ===========================================================================

           ! Local Scalars
           real(${rk}$) :: aapp,aaqq,aatmax,aatmin,big,big1,cond_ok,condr1,condr2,entra, &
                     entrat,epsln,maxprj,scalem,sconda,sfmin,small,temp1,uscal1,uscal2,xsc
           integer(ilp) :: ierr,n1,nr,numrank,p,q,warning
           logical(lk) :: almort,defr,errest,goscal,jracc,kill,lsvec,l2aber,l2kill, &
                     l2pert,l2rank,l2tran,noscal,rowpiv,rsvec,transp
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,log,max,min,float,nint,sign,sqrt
#:else
           intrinsic :: abs,log,max,min,real,idnint,sign,sqrt
#:endif
           ! test the input arguments
           lsvec = la_lsame(jobu,'U') .or. la_lsame(jobu,'F')
           jracc = la_lsame(jobv,'J')
           rsvec = la_lsame(jobv,'V') .or. jracc
           rowpiv = la_lsame(joba,'F') .or. la_lsame(joba,'G')
           l2rank = la_lsame(joba,'R')
           l2aber = la_lsame(joba,'A')
           errest = la_lsame(joba,'E') .or. la_lsame(joba,'G')
           l2tran = la_lsame(jobt,'T')
           l2kill = la_lsame(jobr,'R')
           defr = la_lsame(jobr,'N')
           l2pert = la_lsame(jobp,'P')
           if (.not. (rowpiv .or. l2rank .or. l2aber .or. errest .or. la_lsame(joba,'C'))) &
                     then
              info = -1
           else if (.not. (lsvec .or. la_lsame(jobu,'N') .or. la_lsame(jobu,'W'))) &
                      then
              info = -2
           else if (.not. (rsvec .or. la_lsame(jobv,'N') .or. la_lsame(jobv,'W')) &
                     .or. (jracc .and. (.not. lsvec))) then
              info = -3
           else if (.not. (l2kill .or. defr)) then
              info = -4
           else if (.not. (l2tran .or. la_lsame(jobt,'N'))) then
              info = -5
           else if (.not. (l2pert .or. la_lsame(jobp,'N'))) then
              info = -6
           else if (m < 0) then
              info = -7
           else if ((n < 0) .or. (n > m)) then
              info = -8
           else if (lda < m) then
              info = -10
           else if (lsvec .and. (ldu < m)) then
              info = -13
           else if (rsvec .and. (ldv < n)) then
              info = -15
           else if ((.not. (lsvec .or. rsvec .or. errest) .and. (lwork < max(7,4*n + 1,2*m + n))) .or. ( &
           .not. (lsvec .or. rsvec) .and. errest .and. (lwork < max(7,4*n + n*n,2*m + n))) .or. (lsvec &
           .and. (.not. rsvec) .and. (lwork < max(7,2*m + n,4*n + 1))) .or. (rsvec .and. (.not. lsvec) &
           .and. (lwork < max(7,2*m + n,4*n + 1))) .or. (lsvec .and. rsvec .and. (.not. jracc) .and. ( &
           lwork < max(2*m + n,6*n + 2*n*n))) .or. (lsvec .and. rsvec .and. jracc .and. lwork < max(2*m + n, &
                     4*n + n*n,2*n + n*n + 6))) then
              info = -17
           else
              ! #:)
              info = 0
           end if
           if (info /= 0) then
             ! #:(
              call la_xerbla('${ri.upper()}$GEJSV',-info)
              return
           end if
           ! quick return for void matrix (y3k safe)
       ! #:)
           if ((m == 0) .or. (n == 0)) then
              iwork(1:3) = 0
              work(1:7) = 0
              return
           end if
           ! determine whether the matrix u should be m x n or m x m
           if (lsvec) then
              n1 = n
              if (la_lsame(jobu,'F')) n1 = m
           end if
           ! set numerical parameters
      ! !    note: make sure la_${ri}$lamch() does not fail on the target architecture.
           epsln = la_${ri}$lamch('EPSILON')
           sfmin = la_${ri}$lamch('SAFEMINIMUM')
           small = sfmin/epsln
           big = la_${ri}$lamch('O')
           ! big   = one / sfmin
           ! initialize sva(1:n) = diag( ||a e_i||_2 )_1^n
      ! (!)  if necessary, scale sva() to protect the largest norm from
           ! overflow. it is possible that this scaling pushes the smallest
           ! column norm left from the underflow threshold (extreme case).
           scalem = one/sqrt(real(m,KIND=${rk}$)*real(n,KIND=${rk}$))
           noscal = .true.
           goscal = .true.
           do p = 1,n
              aapp = zero
              aaqq = one
              call la_${ri}$lassq(m,a(1,p),1,aapp,aaqq)
              if (aapp > big) then
                 info = -9
                 call la_xerbla('${ri.upper()}$GEJSV',-info)
                 return
              end if
              aaqq = sqrt(aaqq)
              if ((aapp < (big/aaqq)) .and. noscal) then
                 sva(p) = aapp*aaqq
              else
                 noscal = .false.
                 sva(p) = aapp*(aaqq*scalem)
                 if (goscal) then
                    goscal = .false.
                    call la_${ri}$scal(p - 1,scalem,sva,1)
                 end if
              end if
           end do
           if (noscal) scalem = one
           aapp = zero
           aaqq = big
           do p = 1,n
              aapp = max(aapp,sva(p))
              if (sva(p) /= zero) aaqq = min(aaqq,sva(p))
           end do
           ! quick return for zero m x n matrix
       ! #:)
           if (aapp == zero) then
              if (lsvec) call la_${ri}$laset('G',m,n1,zero,one,u,ldu)
              if (rsvec) call la_${ri}$laset('G',n,n,zero,one,v,ldv)
              work(1) = one
              work(2) = one
              if (errest) work(3) = one
              if (lsvec .and. rsvec) then
                 work(4) = one
                 work(5) = one
              end if
              if (l2tran) then
                 work(6) = zero
                 work(7) = zero
              end if
              iwork(1) = 0
              iwork(2) = 0
              iwork(3) = 0
              return
           end if
           ! issue warning if denormalized column norms detected. override the
           ! high relative accuracy request. issue licence to kill columns
           ! (set them to zero) whose norm is less than sigma_max / big (roughly).
       ! #:(
           warning = 0
           if (aaqq <= sfmin) then
              l2rank = .true.
              l2kill = .true.
              warning = 1
           end if
           ! quick return for one-column matrix
       ! #:)
           if (n == 1) then
              if (lsvec) then
                 call la_${ri}$lascl('G',0,0,sva(1),scalem,m,1,a(1,1),lda,ierr)
                 call la_${ri}$lacpy('A',m,1,a,lda,u,ldu)
                 ! computing all m left singular vectors of the m x 1 matrix
                 if (n1 /= n) then
                    call la_${ri}$geqrf(m,n,u,ldu,work,work(n + 1),lwork - n,ierr)
                    call la_${ri}$orgqr(m,n1,1,u,ldu,work,work(n + 1),lwork - n,ierr)
                    call la_${ri}$copy(m,a(1,1),1,u(1,1),1)
                 end if
              end if
              if (rsvec) then
                  v(1,1) = one
              end if
              if (sva(1) < (big*scalem)) then
                 sva(1) = sva(1)/scalem
                 scalem = one
              end if
              work(1) = one/scalem
              work(2) = one
              if (sva(1) /= zero) then
                 iwork(1) = 1
                 if ((sva(1)/scalem) >= sfmin) then
                    iwork(2) = 1
                 else
                    iwork(2) = 0
                 end if
              else
                 iwork(1) = 0
                 iwork(2) = 0
              end if
              iwork(3) = 0
              if (errest) work(3) = one
              if (lsvec .and. rsvec) then
                 work(4) = one
                 work(5) = one
              end if
              if (l2tran) then
                 work(6) = zero
                 work(7) = zero
              end if
              return
           end if
           transp = .false.
           l2tran = l2tran .and. (m == n)
           aatmax = -one
           aatmin = big
           if (rowpiv .or. l2tran) then
           ! compute the row norms, needed to determine row pivoting sequence
           ! (in the case of heavily row weighted a, row pivoting is strongly
           ! advised) and to collect information needed to compare the
           ! structures of a * a^t and a^t * a (in the case l2tran==.true.).
              if (l2tran) then
                 do p = 1,m
                    xsc = zero
                    temp1 = one
                    call la_${ri}$lassq(n,a(p,1),lda,xsc,temp1)
                    ! la_${ri}$lassq gets both the ell_2 and the ell_infinity norm
                    ! in one pass through the vector
                    work(m + n + p) = xsc*scalem
                    work(n + p) = xsc*(scalem*sqrt(temp1))
                    aatmax = max(aatmax,work(n + p))
                    if (work(n + p) /= zero) aatmin = min(aatmin,work(n + p))
                 end do
              else
                 do p = 1,m
                    work(m + n + p) = scalem*abs(a(p,la_i${ri}$amax(n,a(p,1),lda)))
                    aatmax = max(aatmax,work(m + n + p))
                    aatmin = min(aatmin,work(m + n + p))
                 end do
              end if
           end if
           ! for square matrix a try to determine whether a^t  would be  better
           ! input for the preconditioned jacobi svd, with faster convergence.
           ! the decision is based on an o(n) function of the vector of column
           ! and row norms of a, based on the shannon entropy. this should give
           ! the right choice in most cases when the difference actually matters.
           ! it may fail and pick the slower converging side.
           entra = zero
           entrat = zero
           if (l2tran) then
              xsc = zero
              temp1 = one
              call la_${ri}$lassq(n,sva,1,xsc,temp1)
              temp1 = one/temp1
              entra = zero
              do p = 1,n
                 big1 = ((sva(p)/xsc)**2)*temp1
                 if (big1 /= zero) entra = entra + big1*log(big1)
              end do
              entra = -entra/log(real(n,KIND=${rk}$))
              ! now, sva().^2/trace(a^t * a) is a point in the probability simplex.
              ! it is derived from the diagonal of  a^t * a.  do the same with the
              ! diagonal of a * a^t, compute the entropy of the corresponding
              ! probability distribution. note that a * a^t and a^t * a have the
              ! same trace.
              entrat = zero
              do p = n + 1,n + m
                 big1 = ((work(p)/xsc)**2)*temp1
                 if (big1 /= zero) entrat = entrat + big1*log(big1)
              end do
              entrat = -entrat/log(real(m,KIND=${rk}$))
              ! analyze the entropies and decide a or a^t. smaller entropy
              ! usually means better input for the algorithm.
              transp = (entrat < entra)
              ! if a^t is better than a, transpose a.
              if (transp) then
                 ! in an optimal implementation, this trivial transpose
                 ! should be replaced with faster transpose.
                 do p = 1,n - 1
                    do q = p + 1,n
                        temp1 = a(q,p)
                       a(q,p) = a(p,q)
                       a(p,q) = temp1
                    end do
                 end do
                 do p = 1,n
                    work(m + n + p) = sva(p)
                    sva(p) = work(n + p)
                 end do
                 temp1 = aapp
                 aapp = aatmax
                 aatmax = temp1
                 temp1 = aaqq
                 aaqq = aatmin
                 aatmin = temp1
                 kill = lsvec
                 lsvec = rsvec
                 rsvec = kill
                 if (lsvec) n1 = n
                 rowpiv = .true.
              end if
           end if
           ! end if l2tran
           ! scale the matrix so that its maximal singular value remains less
           ! than sqrt(big) -- the matrix is scaled so that its maximal column
           ! has euclidean norm equal to sqrt(big/n). the only reason to keep
           ! sqrt(big) instead of big is the fact that la_${ri}$gejsv uses lapack and
           ! blas routines that, in some implementations, are not capable of
           ! working in the full interval [sfmin,big] and that they may provoke
           ! overflows in the intermediate results. if the singular values spread
           ! from sfmin to big, then la_${ri}$gesvj will compute them. so, in that case,
           ! one should use la_${ri}$gesvj instead of la_${ri}$gejsv.
           big1 = sqrt(big)
           temp1 = sqrt(big/real(n,KIND=${rk}$))
           call la_${ri}$lascl('G',0,0,aapp,temp1,n,1,sva,n,ierr)
           if (aaqq > (aapp*sfmin)) then
               aaqq = (aaqq/aapp)*temp1
           else
               aaqq = (aaqq*temp1)/aapp
           end if
           temp1 = temp1*scalem
           call la_${ri}$lascl('G',0,0,aapp,temp1,m,n,a,lda,ierr)
           ! to undo scaling at the end of this procedure, multiply the
           ! computed singular values with uscal2 / uscal1.
           uscal1 = temp1
           uscal2 = aapp
           if (l2kill) then
              ! l2kill enforces computation of nonzero singular values in
              ! the restricted range of condition number of the initial a,
              ! sigma_max(a) / sigma_min(a) approx. sqrt(big)/sqrt(sfmin).
              xsc = sqrt(sfmin)
           else
              xsc = small
              ! now, if the condition number of a is too big,
              ! sigma_max(a) / sigma_min(a) > sqrt(big/n) * epsln / sfmin,
              ! as a precaution measure, the full svd is computed using la_${ri}$gesvj
              ! with accumulated jacobi rotations. this provides numerically
              ! more robust computation, at the cost of slightly increased run
              ! time. depending on the concrete implementation of blas and lapack
              ! (i.e. how they behave in presence of extreme ill-conditioning) the
              ! implementor may decide to remove this switch.
              if ((aaqq < sqrt(sfmin)) .and. lsvec .and. rsvec) then
                 jracc = .true.
              end if
           end if
           if (aaqq < xsc) then
              do p = 1,n
                 if (sva(p) < xsc) then
                    call la_${ri}$laset('A',m,1,zero,zero,a(1,p),lda)
                    sva(p) = zero
                 end if
              end do
           end if
           ! preconditioning using qr factorization with pivoting
           if (rowpiv) then
              ! optional row permutation (bjoerck row pivoting):
              ! a result by cox and higham shows that the bjoerck's
              ! row pivoting combined with standard column pivoting
              ! has similar effect as powell-reid complete pivoting.
              ! the ell-infinity norms of a are made nonincreasing.
              do p = 1,m - 1
                 q = la_i${ri}$amax(m - p + 1,work(m + n + p),1) + p - 1
                 iwork(2*n + p) = q
                 if (p /= q) then
                    temp1 = work(m + n + p)
                    work(m + n + p) = work(m + n + q)
                    work(m + n + q) = temp1
                 end if
              end do
              call la_${ri}$laswp(n,a,lda,1,m - 1,iwork(2*n + 1),1)
           end if
           ! end of the preparation phase (scaling, optional sorting and
           ! transposing, optional flushing of small columns).
           ! preconditioning
           ! if the full svd is needed, the right singular vectors are computed
           ! from a matrix equation, and for that we need theoretical analysis
           ! of the businger-golub pivoting. so we use la_${ri}$geqp3 as the first rr qrf.
           ! in all other cases the first rr qrf can be chosen by other criteria
           ! (eg speed by replacing global with restricted window pivoting, such
           ! as in sgeqpx from toms # 782). good results will be obtained using
           ! sgeqpx with properly (!) chosen numerical parameters.
           ! any improvement of la_${ri}$geqp3 improves overall performance of la_${ri}$gejsv.
           ! a * p1 = q1 * [ r1^t 0]^t:
           do p = 1,n
              ! All Columns Are Free Columns
              iwork(p) = 0
           end do
           call la_${ri}$geqp3(m,n,a,lda,iwork,work,work(n + 1),lwork - n,ierr)
           ! the upper triangular matrix r1 from the first qrf is inspected for
           ! rank deficiency and possibilities for deflation, or possible
           ! ill-conditioning. depending on the user specified flag l2rank,
           ! the procedure explores possibilities to reduce the numerical
           ! rank by inspecting the computed upper triangular factor. if
           ! l2rank or l2aber are up, then la_${ri}$gejsv will compute the svd of
           ! a + da, where ||da|| <= f(m,n)*epsln.
           nr = 1
           if (l2aber) then
              ! standard absolute error bound suffices. all sigma_i with
              ! sigma_i < n*epsln*||a|| are flushed to zero. this is an
              ! aggressive enforcement of lower numerical rank by introducing a
              ! backward error of the order of n*epsln*||a||.
              temp1 = sqrt(real(n,KIND=${rk}$))*epsln
              do p = 2,n
                 if (abs(a(p,p)) >= (temp1*abs(a(1,1)))) then
                    nr = nr + 1
                 else
                    go to 3002
                 end if
              end do
              3002 continue
           else if (l2rank) then
              ! .. similarly as above, only slightly more gentle (less aggressive).
              ! sudden drop on the diagonal of r1 is used as the criterion for
              ! close-to-rank-deficient.
              temp1 = sqrt(sfmin)
              do p = 2,n
                 if ((abs(a(p,p)) < (epsln*abs(a(p - 1,p - 1)))) .or. (abs(a(p,p)) < small) .or. ( &
                           l2kill .and. (abs(a(p,p)) < temp1))) go to 3402
                 nr = nr + 1
              end do
              3402 continue
           else
              ! the goal is high relative accuracy. however, if the matrix
              ! has high scaled condition number the relative accuracy is in
              ! general not feasible. later on, a condition number estimator
              ! will be deployed to estimate the scaled condition number.
              ! here we just remove the underflowed part of the triangular
              ! factor. this prevents the situation in which the code is
              ! working hard to get the accuracy not warranted by the data.
              temp1 = sqrt(sfmin)
              do p = 2,n
                 if ((abs(a(p,p)) < small) .or. (l2kill .and. (abs(a(p,p)) < temp1))) go to &
                           3302
                 nr = nr + 1
              end do
              3302 continue
           end if
           almort = .false.
           if (nr == n) then
              maxprj = one
              do p = 2,n
                 temp1 = abs(a(p,p))/sva(iwork(p))
                 maxprj = min(maxprj,temp1)
              end do
              if (maxprj**2 >= one - real(n,KIND=${rk}$)*epsln) almort = .true.
           end if
           sconda = -one
           condr1 = -one
           condr2 = -one
           if (errest) then
              if (n == nr) then
                 if (rsvec) then
                    ! V Is Available As Workspace
                    call la_${ri}$lacpy('U',n,n,a,lda,v,ldv)
                    do p = 1,n
                       temp1 = sva(iwork(p))
                       call la_${ri}$scal(p,one/temp1,v(1,p),1)
                    end do
                    call la_${ri}$pocon('U',n,v,ldv,one,temp1,work(n + 1),iwork(2*n + m + 1), &
                              ierr)
                 else if (lsvec) then
                    ! U Is Available As Workspace
                    call la_${ri}$lacpy('U',n,n,a,lda,u,ldu)
                    do p = 1,n
                       temp1 = sva(iwork(p))
                       call la_${ri}$scal(p,one/temp1,u(1,p),1)
                    end do
                    call la_${ri}$pocon('U',n,u,ldu,one,temp1,work(n + 1),iwork(2*n + m + 1), &
                              ierr)
                 else
                    call la_${ri}$lacpy('U',n,n,a,lda,work(n + 1),n)
                    do p = 1,n
                       temp1 = sva(iwork(p))
                       call la_${ri}$scal(p,one/temp1,work(n + (p - 1)*n + 1),1)
                    end do
                 ! The Columns Of R Are Scaled To Have Unit Euclidean Lengths
                    call la_${ri}$pocon('U',n,work(n + 1),n,one,temp1,work(n + n*n + 1),iwork(2*n + &
                              m + 1),ierr)
                 end if
                 sconda = one/sqrt(temp1)
                 ! sconda is an estimate of sqrt(||(r^t * r)^(-1)||_1).
                 ! n^(-1/4) * sconda <= ||r^(-1)||_2 <= n^(1/4) * sconda
              else
                 sconda = -one
              end if
           end if
           l2pert = l2pert .and. (abs(a(1,1)/a(nr,nr)) > sqrt(big1))
           ! if there is no violent scaling, artificial perturbation is not needed.
           ! phase 3:
           if (.not. (rsvec .or. lsvec)) then
               ! singular values only
               ! .. transpose a(1:nr,1:n)
              do p = 1,min(n - 1,nr)
                 call la_${ri}$copy(n - p,a(p,p + 1),lda,a(p + 1,p),1)
              end do
              ! the following two do-loops introduce small relative perturbation
              ! into the strict upper triangle of the lower triangular matrix.
              ! small entries below the main diagonal are also changed.
              ! this modification is useful if the computing environment does not
              ! provide/allow flush to zero underflow, for it prevents many
              ! annoying denormalized numbers in case of strongly scaled matrices.
              ! the perturbation is structured so that it does not introduce any
              ! new perturbation of the singular values, and it does not destroy
              ! the job done by the preconditioner.
              ! the licence for this perturbation is in the variable l2pert, which
              ! should be .false. if flush to zero underflow is active.
              if (.not. almort) then
                 if (l2pert) then
                    ! xsc = sqrt(small)
                    xsc = epsln/real(n,KIND=${rk}$)
                    do q = 1,nr
                       temp1 = xsc*abs(a(q,q))
                       do p = 1,n
                          if (((p > q) .and. (abs(a(p,q)) <= temp1)) .or. (p < q)) a(p,q) = sign( &
                                    temp1,a(p,q))
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,a(1,2),lda)
                 end if
                  ! Second Preconditioning Using The Qr Factorization
                 call la_${ri}$geqrf(n,nr,a,lda,work,work(n + 1),lwork - n,ierr)
                 ! And Transpose Upper To Lower Triangular
                 do p = 1,nr - 1
                    call la_${ri}$copy(nr - p,a(p,p + 1),lda,a(p + 1,p),1)
                 end do
              end if
                 ! row-cyclic jacobi svd algorithm with column pivoting
                 ! .. again some perturbation (a "background noise") is added
                 ! to drown denormals
                 if (l2pert) then
                    ! xsc = sqrt(small)
                    xsc = epsln/real(n,KIND=${rk}$)
                    do q = 1,nr
                       temp1 = xsc*abs(a(q,q))
                       do p = 1,nr
                          if (((p > q) .and. (abs(a(p,q)) <= temp1)) .or. (p < q)) a(p,q) = sign( &
                                    temp1,a(p,q))
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,a(1,2),lda)
                 end if
                 ! .. and one-sided jacobi rotations are started on a lower
                 ! triangular matrix (plus perturbation which is ignored in
                 ! the part which destroys triangular form (confusing?!))
                 call la_${ri}$gesvj('L','NOU','NOV',nr,nr,a,lda,sva,n,v,ldv,work, &
                           lwork,info)
                 scalem = work(1)
                 numrank = nint(work(2),KIND=ilp)
           else if (rsvec .and. (.not. lsvec)) then
              ! -> singular values and right singular vectors <-
              if (almort) then
                 ! In This Case Nr Equals N
                 do p = 1,nr
                    call la_${ri}$copy(n - p + 1,a(p,p),lda,v(p,p),1)
                 end do
                 call la_${ri}$laset('UPPER',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 call la_${ri}$gesvj('L','U','N',n,nr,v,ldv,sva,nr,a,lda,work,lwork,info)

                 scalem = work(1)
                 numrank = nint(work(2),KIND=ilp)
              else
              ! .. two more qr factorizations ( one qrf is not enough, two require
              ! accumulated product of jacobi rotations, three are perfect )
                 call la_${ri}$laset('LOWER',nr - 1,nr - 1,zero,zero,a(2,1),lda)
                 call la_${ri}$gelqf(nr,n,a,lda,work,work(n + 1),lwork - n,ierr)
                 call la_${ri}$lacpy('LOWER',nr,nr,a,lda,v,ldv)
                 call la_${ri}$laset('UPPER',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 call la_${ri}$geqrf(nr,nr,v,ldv,work(n + 1),work(2*n + 1),lwork - 2*n,ierr)

                 do p = 1,nr
                    call la_${ri}$copy(nr - p + 1,v(p,p),ldv,v(p,p),1)
                 end do
                 call la_${ri}$laset('UPPER',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 call la_${ri}$gesvj('LOWER','U','N',nr,nr,v,ldv,sva,nr,u,ldu,work(n + 1), &
#:if rk == "sp"
                           lwork - n,info)
#:else
                           lwork,info)
#:endif
                 scalem = work(n + 1)
                 numrank = nint(work(n + 2),KIND=ilp)
                 if (nr < n) then
                    call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                    call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                    call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
                 end if
              call la_${ri}$ormlq('LEFT','TRANSPOSE',n,n,nr,a,lda,work,v,ldv,work(n + 1), &
                        lwork - n,ierr)
              end if
              do p = 1,n
                 call la_${ri}$copy(n,v(p,1),ldv,a(iwork(p),1),lda)
              end do
              call la_${ri}$lacpy('ALL',n,n,a,lda,v,ldv)
              if (transp) then
                 call la_${ri}$lacpy('ALL',n,n,v,ldv,u,ldu)
              end if
           else if (lsvec .and. (.not. rsvec)) then
              ! Singular Values And Left Singular Vectors
              ! Second Preconditioning Step To Avoid Need To Accumulate
              ! jacobi rotations in the jacobi iterations.
              do p = 1,nr
                 call la_${ri}$copy(n - p + 1,a(p,p),lda,u(p,p),1)
              end do
              call la_${ri}$laset('UPPER',nr - 1,nr - 1,zero,zero,u(1,2),ldu)
              call la_${ri}$geqrf(n,nr,u,ldu,work(n + 1),work(2*n + 1),lwork - 2*n,ierr)
              do p = 1,nr - 1
                 call la_${ri}$copy(nr - p,u(p,p + 1),ldu,u(p + 1,p),1)
              end do
              call la_${ri}$laset('UPPER',nr - 1,nr - 1,zero,zero,u(1,2),ldu)
              call la_${ri}$gesvj('LOWER','U','N',nr,nr,u,ldu,sva,nr,a,lda,work(n + 1), &
                        lwork - n,info)
              scalem = work(n + 1)
              numrank = nint(work(n + 2),KIND=ilp)
              if (nr < m) then
                 call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                 if (nr < n1) then
                    call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                    call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                 end if
              end if
              call la_${ri}$ormqr('LEFT','NO TR',m,n1,n,a,lda,work,u,ldu,work(n + 1), &
                        lwork - n,ierr)
              if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(2*n + 1),-1)
              do p = 1,n1
                 xsc = one/la_${ri}$nrm2(m,u(1,p),1)
                 call la_${ri}$scal(m,xsc,u(1,p),1)
              end do
              if (transp) then
                 call la_${ri}$lacpy('ALL',n,n,u,ldu,v,ldv)
              end if
           else
              ! Full Svd
              if (.not. jracc) then
              if (.not. almort) then
                 ! second preconditioning step (qrf [with pivoting])
                 ! note that the composition of transpose, qrf and transpose is
                 ! equivalent to an lqf call. since in many libraries the qrf
                 ! seems to be better optimized than the lqf, we do explicit
                 ! transpose and use the qrf. this is subject to changes in an
                 ! optimized implementation of la_${ri}$gejsv.
                 do p = 1,nr
                    call la_${ri}$copy(n - p + 1,a(p,p),lda,v(p,p),1)
                 end do
                 ! The Following Two Loops Perturb Small Entries To Avoid
                 ! denormals in the second qr factorization, where they are
                 ! as good as zeros. this is done to avoid painfully slow
                 ! computation with denormals. the relative size of the perturbation
                 ! is a parameter that can be changed by the implementer.
                 ! this perturbation device will be obsolete on machines with
                 ! properly implemented arithmetic.
                 ! to switch it off, set l2pert=.false. to remove it from  the
                 ! code, remove the action under l2pert=.true., leave the else part.
                 ! the following two loops should be blocked and fused with the
                 ! transposed copy above.
                 if (l2pert) then
                    xsc = sqrt(small)
                    do q = 1,nr
                       temp1 = xsc*abs(v(q,q))
                       do p = 1,n
                          if ((p > q) .and. (abs(v(p,q)) <= temp1) .or. (p < q)) v(p,q) = &
                                    sign(temp1,v(p,q))
                          if (p < q) v(p,q) = -v(p,q)
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 end if
                 ! estimate the row scaled condition number of r1
                 ! (if r1 is rectangular, n > nr, then the condition number
                 ! of the leading nr x nr submatrix is estimated.)
                 call la_${ri}$lacpy('L',nr,nr,v,ldv,work(2*n + 1),nr)
                 do p = 1,nr
                    temp1 = la_${ri}$nrm2(nr - p + 1,work(2*n + (p - 1)*nr + p),1)
                    call la_${ri}$scal(nr - p + 1,one/temp1,work(2*n + (p - 1)*nr + p),1)
                 end do
                 call la_${ri}$pocon('LOWER',nr,work(2*n + 1),nr,one,temp1,work(2*n + nr*nr + 1),iwork(m + &
                           2*n + 1),ierr)
                 condr1 = one/sqrt(temp1)
                 ! Here Need A Second Opinion On The Condition Number
                 ! Then Assume Worst Case Scenario
                 ! r1 is ok for inverse <=> condr1 < real(n,KIND=${rk}$)
                 ! more conservative    <=> condr1 < sqrt(real(n,KIND=${rk}$))
                 cond_ok = sqrt(real(nr,KIND=${rk}$))
      ! [tp]       cond_ok is a tuning parameter.
                 if (condr1 < cond_ok) then
                    ! .. the second qrf without pivoting. note: in an optimized
                    ! implementation, this qrf should be implemented as the qrf
                    ! of a lower triangular matrix.
                    ! r1^t = q2 * r2
                    call la_${ri}$geqrf(n,nr,v,ldv,work(n + 1),work(2*n + 1),lwork - 2*n,ierr)

                    if (l2pert) then
                       xsc = sqrt(small)/epsln
                       do p = 2,nr
                          do q = 1,p - 1
                             temp1 = xsc*min(abs(v(p,p)),abs(v(q,q)))
                             if (abs(v(q,p)) <= temp1) v(q,p) = sign(temp1,v(q,p))
                          end do
                       end do
                    end if
                    if (nr /= n) call la_${ri}$lacpy('A',n,nr,v,ldv,work(2*n + 1),n)
                    ! .. save ...
                 ! This Transposed Copy Should Be Better Than Naive
                    do p = 1,nr - 1
                       call la_${ri}$copy(nr - p,v(p,p + 1),ldv,v(p + 1,p),1)
                    end do
                    condr2 = condr1
                 else
                    ! .. ill-conditioned case: second qrf with pivoting
                    ! note that windowed pivoting would be equally good
                    ! numerically, and more run-time efficient. so, in
                    ! an optimal implementation, the next call to la_${ri}$geqp3
                    ! should be replaced with eg. call sgeqpx (acm toms #782)
                    ! with properly (carefully) chosen parameters.
                    ! r1^t * p2 = q2 * r2
                    do p = 1,nr
                       iwork(n + p) = 0
                    end do
                    call la_${ri}$geqp3(n,nr,v,ldv,iwork(n + 1),work(n + 1),work(2*n + 1),lwork - &
                              2*n,ierr)
      ! *               call la_${ri}$geqrf( n, nr, v, ldv, work(n+1), work(2*n+1),
      ! *     $              lwork-2*n, ierr )
                    if (l2pert) then
                       xsc = sqrt(small)
                       do p = 2,nr
                          do q = 1,p - 1
                             temp1 = xsc*min(abs(v(p,p)),abs(v(q,q)))
                             if (abs(v(q,p)) <= temp1) v(q,p) = sign(temp1,v(q,p))
                          end do
                       end do
                    end if
                    call la_${ri}$lacpy('A',n,nr,v,ldv,work(2*n + 1),n)
                    if (l2pert) then
                       xsc = sqrt(small)
                       do p = 2,nr
                          do q = 1,p - 1
                             temp1 = xsc*min(abs(v(p,p)),abs(v(q,q)))
                             v(p,q) = -sign(temp1,v(q,p))
                          end do
                       end do
                    else
                       call la_${ri}$laset('L',nr - 1,nr - 1,zero,zero,v(2,1),ldv)
                    end if
                    ! now, compute r2 = l3 * q3, the lq factorization.
                    call la_${ri}$gelqf(nr,nr,v,ldv,work(2*n + n*nr + 1),work(2*n + n*nr + nr + 1), &
                              lwork - 2*n - n*nr - nr,ierr)
                    ! And Estimate The Condition Number
                    call la_${ri}$lacpy('L',nr,nr,v,ldv,work(2*n + n*nr + nr + 1),nr)
                    do p = 1,nr
                       temp1 = la_${ri}$nrm2(p,work(2*n + n*nr + nr + p),nr)
                       call la_${ri}$scal(p,one/temp1,work(2*n + n*nr + nr + p),nr)
                    end do
                    call la_${ri}$pocon('L',nr,work(2*n + n*nr + nr + 1),nr,one,temp1,work(2*n + n*nr + nr + &
                              nr*nr + 1),iwork(m + 2*n + 1),ierr)
                    condr2 = one/sqrt(temp1)
                    if (condr2 >= cond_ok) then
                       ! Save The Householder Vectors Used For Q3
                       ! (this overwrites the copy of r2, as it will not be
                       ! needed in this branch, but it does not overwritte the
                       ! huseholder vectors of q2.).
                       call la_${ri}$lacpy('U',nr,nr,v,ldv,work(2*n + 1),n)
                       ! And The Rest Of The Information On Q3 Is In
                       ! work(2*n+n*nr+1:2*n+n*nr+n)
                    end if
                 end if
                 if (l2pert) then
                    xsc = sqrt(small)
                    do q = 2,nr
                       temp1 = xsc*v(q,q)
                       do p = 1,q - 1
                          ! v(p,q) = - sign( temp1, v(q,p) )
                          v(p,q) = -sign(temp1,v(p,q))
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
                 end if
              ! second preconditioning finished; continue with jacobi svd
              ! the input matrix is lower trinagular.
              ! recover the right singular vectors as solution of a well
              ! conditioned triangular matrix equation.
                 if (condr1 < cond_ok) then
                    call la_${ri}$gesvj('L','U','N',nr,nr,v,ldv,sva,nr,u,ldu,work(2*n + n*nr + nr + 1), &
                              lwork - 2*n - n*nr - nr,info)
                    scalem = work(2*n + n*nr + nr + 1)
                    numrank = nint(work(2*n + n*nr + nr + 2),KIND=ilp)
                    do p = 1,nr
                       call la_${ri}$copy(nr,v(1,p),1,u(1,p),1)
                       call la_${ri}$scal(nr,sva(p),v(1,p),1)
                    end do
              ! Pick The Right Matrix Equation And Solve It
                    if (nr == n) then
       ! :))             .. best case, r1 is inverted. the solution of this matrix
                       ! equation is q2*v2 = the product of the jacobi rotations
                       ! used in la_${ri}$gesvj, premultiplied with the orthogonal matrix
                       ! from the second qr factorization.
                       call la_${ri}$trsm('L','U','N','N',nr,nr,one,a,lda,v,ldv)
                    else
                       ! .. r1 is well conditioned, but non-square. transpose(r2)
                       ! is inverted to get the product of the jacobi rotations
                       ! used in la_${ri}$gesvj. the q-factor from the second qr
                       ! factorization is then built in explicitly.
                       call la_${ri}$trsm('L','U','T','N',nr,nr,one,work(2*n + 1),n,v,ldv)
                       if (nr < n) then
                         call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                         call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                         call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
                       end if
                       call la_${ri}$ormqr('L','N',n,n,nr,work(2*n + 1),n,work(n + 1),v,ldv,work(2*n + &
                                 n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                    end if
                 else if (condr2 < cond_ok) then
       ! :)           .. the input matrix a is very likely a relative of
                    ! the kahan matrix :)
                    ! the matrix r2 is inverted. the solution of the matrix equation
                    ! is q3^t*v3 = the product of the jacobi rotations (appplied to
                    ! the lower triangular l3 from the lq factorization of
                    ! r2=l3*q3), pre-multiplied with the transposed q3.
                    call la_${ri}$gesvj('L','U','N',nr,nr,v,ldv,sva,nr,u,ldu,work(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,info)
                    scalem = work(2*n + n*nr + nr + 1)
                    numrank = nint(work(2*n + n*nr + nr + 2),KIND=ilp)
                    do p = 1,nr
                       call la_${ri}$copy(nr,v(1,p),1,u(1,p),1)
                       call la_${ri}$scal(nr,sva(p),u(1,p),1)
                    end do
                    call la_${ri}$trsm('L','U','N','N',nr,nr,one,work(2*n + 1),n,u,ldu)
                    ! Apply The Permutation From The Second Qr Factorization
                    do q = 1,nr
                       do p = 1,nr
                          work(2*n + n*nr + nr + iwork(n + p)) = u(p,q)
                       end do
                       do p = 1,nr
                          u(p,q) = work(2*n + n*nr + nr + p)
                       end do
                    end do
                    if (nr < n) then
                       call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
                    end if
                    call la_${ri}$ormqr('L','N',n,n,nr,work(2*n + 1),n,work(n + 1),v,ldv,work(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                 else
                    ! last line of defense.
       ! #:(          this is a rather pathological case: no scaled condition
                    ! improvement after two pivoted qr factorizations. other
                    ! possibility is that the rank revealing qr factorization
                    ! or the condition estimator has failed, or the cond_ok
                    ! is set very close to one (which is unnecessary). normally,
                    ! this branch should never be executed, but in rare cases of
                    ! failure of the rrqr or condition estimator, the last line of
                    ! defense ensures that la_${ri}$gejsv completes the task.
                    ! compute the full svd of l3 using la_${ri}$gesvj with explicit
                    ! accumulation of jacobi rotations.
                    call la_${ri}$gesvj('L','U','V',nr,nr,v,ldv,sva,nr,u,ldu,work(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,info)
                    scalem = work(2*n + n*nr + nr + 1)
                    numrank = nint(work(2*n + n*nr + nr + 2),KIND=ilp)
                    if (nr < n) then
                       call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
                    end if
                    call la_${ri}$ormqr('L','N',n,n,nr,work(2*n + 1),n,work(n + 1),v,ldv,work(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                    call la_${ri}$ormlq('L','T',nr,nr,nr,work(2*n + 1),n,work(2*n + n*nr + 1),u, &
                              ldu,work(2*n + n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                    do q = 1,nr
                       do p = 1,nr
                          work(2*n + n*nr + nr + iwork(n + p)) = u(p,q)
                       end do
                       do p = 1,nr
                          u(p,q) = work(2*n + n*nr + nr + p)
                       end do
                    end do
                 end if
                 ! permute the rows of v using the (column) permutation from the
                 ! first qrf. also, scale the columns to make them unit in
                 ! euclidean norm. this applies to all cases.
                 temp1 = sqrt(real(n,KIND=${rk}$))*epsln
                 do q = 1,n
                    do p = 1,n
                       work(2*n + n*nr + nr + iwork(p)) = v(p,q)
                    end do
                    do p = 1,n
                       v(p,q) = work(2*n + n*nr + nr + p)
                    end do
                    xsc = one/la_${ri}$nrm2(n,v(1,q),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$scal(n,xsc, &
                              v(1,q),1)
                 end do
                 ! at this moment, v contains the right singular vectors of a.
                 ! next, assemble the left singular vector matrix u (m x n).
                 if (nr < m) then
                    call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                    if (nr < n1) then
                       call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                       call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                    end if
                 end if
                 ! the q matrix from the first qrf is built into the left singular
                 ! matrix u. this applies to all cases.
                 call la_${ri}$ormqr('LEFT','NO_TR',m,n1,n,a,lda,work,u,ldu,work(n + 1), &
                           lwork - n,ierr)
                 ! the columns of u are normalized. the cost is o(m*n) flops.
                 temp1 = sqrt(real(m,KIND=${rk}$))*epsln
                 do p = 1,nr
                    xsc = one/la_${ri}$nrm2(m,u(1,p),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$scal(m,xsc, &
                              u(1,p),1)
                 end do
                 ! if the initial qrf is computed with row pivoting, the left
                 ! singular vectors must be adjusted.
                 if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(2*n + 1),-1)
              else
              ! The Initial Matrix A Has Almost Orthogonal Columns And
              ! the second qrf is not needed
                 call la_${ri}$lacpy('UPPER',n,n,a,lda,work(n + 1),n)
                 if (l2pert) then
                    xsc = sqrt(small)
                    do p = 2,n
                       temp1 = xsc*work(n + (p - 1)*n + p)
                       do q = 1,p - 1
                          work(n + (q - 1)*n + p) = -sign(temp1,work(n + (p - 1)*n + q))
                       end do
                    end do
                 else
                    call la_${ri}$laset('LOWER',n - 1,n - 1,zero,zero,work(n + 2),n)
                 end if
                 call la_${ri}$gesvj('UPPER','U','N',n,n,work(n + 1),n,sva,n,u,ldu,work(n + &
                           n*n + 1),lwork - n - n*n,info)
                 scalem = work(n + n*n + 1)
                 numrank = nint(work(n + n*n + 2),KIND=ilp)
                 do p = 1,n
                    call la_${ri}$copy(n,work(n + (p - 1)*n + 1),1,u(1,p),1)
                    call la_${ri}$scal(n,sva(p),work(n + (p - 1)*n + 1),1)
                 end do
                 call la_${ri}$trsm('LEFT','UPPER','NOTRANS','NO UD',n,n,one,a,lda,work(n + &
                           1),n)
                 do p = 1,n
                    call la_${ri}$copy(n,work(n + p),n,v(iwork(p),1),ldv)
                 end do
                 temp1 = sqrt(real(n,KIND=${rk}$))*epsln
                 do p = 1,n
                    xsc = one/la_${ri}$nrm2(n,v(1,p),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$scal(n,xsc, &
                              v(1,p),1)
                 end do
                 ! assemble the left singular vector matrix u (m x n).
                 if (n < m) then
                    call la_${ri}$laset('A',m - n,n,zero,zero,u(n + 1,1),ldu)
                    if (n < n1) then
                       call la_${ri}$laset('A',n,n1 - n,zero,zero,u(1,n + 1),ldu)
                       call la_${ri}$laset('A',m - n,n1 - n,zero,one,u(n + 1,n + 1),ldu)
                    end if
                 end if
                 call la_${ri}$ormqr('LEFT','NO TR',m,n1,n,a,lda,work,u,ldu,work(n + 1), &
                           lwork - n,ierr)
                 temp1 = sqrt(real(m,KIND=${rk}$))*epsln
                 do p = 1,n1
                    xsc = one/la_${ri}$nrm2(m,u(1,p),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$scal(m,xsc, &
                              u(1,p),1)
                 end do
                 if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(2*n + 1),-1)
              end if
              ! end of the  >> almost orthogonal case <<  in the full svd
              else
              ! this branch deploys a preconditioned jacobi svd with explicitly
              ! accumulated rotations. it is included as optional, mainly for
              ! experimental purposes. it does perform well, and can also be used.
              ! in this implementation, this branch will be automatically activated
              ! if the  condition number sigma_max(a) / sigma_min(a) is predicted
              ! to be greater than the overflow threshold. this is because the
              ! a posteriori computation of the singular vectors assumes robust
              ! implementation of blas and some lapack procedures, capable of working
              ! in presence of extreme values. since that is not always the case, ...
              do p = 1,nr
                 call la_${ri}$copy(n - p + 1,a(p,p),lda,v(p,p),1)
              end do
              if (l2pert) then
                 xsc = sqrt(small/epsln)
                 do q = 1,nr
                    temp1 = xsc*abs(v(q,q))
                    do p = 1,n
                       if ((p > q) .and. (abs(v(p,q)) <= temp1) .or. (p < q)) v(p,q) = sign( &
                                  temp1,v(p,q))
                       if (p < q) v(p,q) = -v(p,q)
                    end do
                 end do
              else
                 call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,v(1,2),ldv)
              end if
              call la_${ri}$geqrf(n,nr,v,ldv,work(n + 1),work(2*n + 1),lwork - 2*n,ierr)
              call la_${ri}$lacpy('L',n,nr,v,ldv,work(2*n + 1),n)
              do p = 1,nr
                 call la_${ri}$copy(nr - p + 1,v(p,p),ldv,u(p,p),1)
              end do
              if (l2pert) then
                 xsc = sqrt(small/epsln)
                 do q = 2,nr
                    do p = 1,q - 1
                       temp1 = xsc*min(abs(u(p,p)),abs(u(q,q)))
                       u(p,q) = -sign(temp1,u(q,p))
                    end do
                 end do
              else
                 call la_${ri}$laset('U',nr - 1,nr - 1,zero,zero,u(1,2),ldu)
              end if
#:if rk == "sp"
              call la_${ri}$gesvj('L','U','V',nr,nr,u,ldu,sva,n,v,ldv,work(2*n + n*nr + 1), &
#:else
              call la_${ri}$gesvj('G','U','V',nr,nr,u,ldu,sva,n,v,ldv,work(2*n + n*nr + 1), &
#:endif
                        lwork - 2*n - n*nr,info)
              scalem = work(2*n + n*nr + 1)
              numrank = nint(work(2*n + n*nr + 2),KIND=ilp)
              if (nr < n) then
                 call la_${ri}$laset('A',n - nr,nr,zero,zero,v(nr + 1,1),ldv)
                 call la_${ri}$laset('A',nr,n - nr,zero,zero,v(1,nr + 1),ldv)
                 call la_${ri}$laset('A',n - nr,n - nr,zero,one,v(nr + 1,nr + 1),ldv)
              end if
              call la_${ri}$ormqr('L','N',n,n,nr,work(2*n + 1),n,work(n + 1),v,ldv,work(2*n + n*nr + nr + 1) &
                        ,lwork - 2*n - n*nr - nr,ierr)
                 ! permute the rows of v using the (column) permutation from the
                 ! first qrf. also, scale the columns to make them unit in
                 ! euclidean norm. this applies to all cases.
                 temp1 = sqrt(real(n,KIND=${rk}$))*epsln
                 do q = 1,n
                    do p = 1,n
                       work(2*n + n*nr + nr + iwork(p)) = v(p,q)
                    end do
                    do p = 1,n
                       v(p,q) = work(2*n + n*nr + nr + p)
                    end do
                    xsc = one/la_${ri}$nrm2(n,v(1,q),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$scal(n,xsc, &
                              v(1,q),1)
                 end do
                 ! at this moment, v contains the right singular vectors of a.
                 ! next, assemble the left singular vector matrix u (m x n).
              if (nr < m) then
                 call la_${ri}$laset('A',m - nr,nr,zero,zero,u(nr + 1,1),ldu)
                 if (nr < n1) then
                    call la_${ri}$laset('A',nr,n1 - nr,zero,zero,u(1,nr + 1),ldu)
                    call la_${ri}$laset('A',m - nr,n1 - nr,zero,one,u(nr + 1,nr + 1),ldu)
                 end if
              end if
              call la_${ri}$ormqr('LEFT','NO TR',m,n1,n,a,lda,work,u,ldu,work(n + 1), &
                        lwork - n,ierr)
                 if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(2*n + 1),-1)
              end if
              if (transp) then
                 ! .. swap u and v because the procedure worked on a^t
                 do p = 1,n
                    call la_${ri}$swap(n,u(1,p),1,v(1,p),1)
                 end do
              end if
           end if
           ! end of the full svd
           ! undo scaling, if necessary (and possible)
           if (uscal2 <= (big/sva(1))*uscal1) then
              call la_${ri}$lascl('G',0,0,uscal1,uscal2,nr,1,sva,n,ierr)
              uscal1 = one
              uscal2 = one
           end if
           if (nr < n) then
              do p = nr + 1,n
                 sva(p) = zero
              end do
           end if
           work(1) = uscal2*scalem
           work(2) = uscal1
           if (errest) work(3) = sconda
           if (lsvec .and. rsvec) then
              work(4) = condr1
              work(5) = condr2
           end if
           if (l2tran) then
              work(6) = entra
              work(7) = entrat
           end if
           iwork(1) = nr
           iwork(2) = numrank
           iwork(3) = warning
           return
     end subroutine la_${ri}$gejsv
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GESDD: computes the singular value decomposition (SVD) of a real
     !> M-by-N matrix A, optionally computing the left and right singular
     !> vectors.  If singular vectors are desired, it uses a
     !> divide-and-conquer algorithm.
     !> The SVD is written
     !> A = U * SIGMA * transpose(V)
     !> where SIGMA is an M-by-N matrix which is zero except for its
     !> min(m,n) diagonal elements, U is an M-by-M orthogonal matrix, and
     !> V is an N-by-N orthogonal matrix.  The diagonal elements of SIGMA
     !> are the singular values of A; they are real and non-negative, and
     !> are returned in descending order.  The first min(m,n) columns of
     !> U and V are the left and right singular vectors of A.
     !> Note that the routine returns VT = V**T, not V.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$gesdd(jobz,m,n,a,lda,s,u,ldu,vt,ldvt,work,lwork,iwork,info)
        use la_constants_${rk}$,only:zero,one

        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldu,ldvt,lwork,m,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: s(*),u(ldu,*),vt(ldvt,*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,wntqa,wntqas,wntqn,wntqo,wntqs
           integer(ilp) :: bdspac,blk,chunk,i,ie,ierr,il,ir,iscl,itau,itaup,itauq,iu, &
                     ivt,ldwkvt,ldwrkl,ldwrkr,ldwrku,maxwrk,minmn,minwrk,mnthr,nwork,wrkbl
           integer(ilp) :: lwork_${ri}$gebrd_mn,lwork_${ri}$gebrd_mm,lwork_${ri}$gebrd_nn,lwork_${ri}$gelqf_mn, &
           lwork_${ri}$geqrf_mn,lwork_${ri}$orgbr_p_mm,lwork_${ri}$orgbr_q_nn,lwork_${ri}$orglq_mn, &
           lwork_${ri}$orglq_nn,lwork_${ri}$orgqr_mm,lwork_${ri}$orgqr_mn,lwork_${ri}$ormbr_prt_mm, &
           lwork_${ri}$ormbr_qln_mm,lwork_${ri}$ormbr_prt_mn,lwork_${ri}$ormbr_qln_mn,lwork_${ri}$ormbr_prt_nn, &
                     lwork_${ri}$ormbr_qln_nn
           real(${rk}$) :: anrm,bignum,eps,smlnum
           ! Local Arrays
           integer(ilp) :: idum(1)
           real(${rk}$) :: dum(1)
           ! Intrinsic Functions
           intrinsic :: int,max,min,sqrt
           ! Executable Statements
           ! test the input arguments
           info = 0
           minmn = min(m,n)
           wntqa = la_lsame(jobz,'A')
           wntqs = la_lsame(jobz,'S')
           wntqas = wntqa .or. wntqs
           wntqo = la_lsame(jobz,'O')
           wntqn = la_lsame(jobz,'N')
           lquery = (lwork == -1)
           if (.not. (wntqa .or. wntqs .or. wntqo .or. wntqn)) then
              info = -1
           else if (m < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldu < 1 .or. (wntqas .and. ldu < m) .or. (wntqo .and. m < n .and. ldu < m)) &
                     then
              info = -8
           else if (ldvt < 1 .or. (wntqa .and. ldvt < n) .or. (wntqs .and. ldvt < minmn) .or. (wntqo &
                     .and. m >= n .and. ldvt < n)) then
              info = -10
           end if
           ! compute workspace
             ! note: comments in the code beginning "workspace:" describe the
             ! minimal amount of workspace allocated at that point in the code,
             ! as well as the preferred amount for good performance.
             ! nb refers to the optimal block size for the immediately
             ! following subroutine, as returned by la_ilaenv.
           if (info == 0) then
              minwrk = 1
              maxwrk = 1
              bdspac = 0
              mnthr = int(minmn*11.0_${rk}$/6.0_${rk}$,KIND=ilp)
              if (m >= n .and. minmn > 0) then
                 ! compute space needed for la_${ri}$bdsdc
                 if (wntqn) then
                    ! la_${ri}$bdsdc needs only 4*n (or 6*n for uplo=l for lapack <= 3.6_${rk}$)
                    ! keep 7*n for backwards compatibility.
                    bdspac = 7*n
                 else
                    bdspac = 3*n*n + 4*n
                 end if
                 ! compute space preferred for each routine
                 call la_${ri}$gebrd(m,n,dum(1),m,dum(1),dum(1),dum(1),dum(1),dum(1),-1, &
                           ierr)
                 lwork_${ri}$gebrd_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$gebrd(n,n,dum(1),n,dum(1),dum(1),dum(1),dum(1),dum(1),-1, &
                           ierr)
                 lwork_${ri}$gebrd_nn = int(dum(1),KIND=ilp)
                 call la_${ri}$geqrf(m,n,dum(1),m,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$geqrf_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$orgbr('Q',n,n,n,dum(1),n,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgbr_q_nn = int(dum(1),KIND=ilp)
                 call la_${ri}$orgqr(m,m,n,dum(1),m,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgqr_mm = int(dum(1),KIND=ilp)
                 call la_${ri}$orgqr(m,n,n,dum(1),m,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgqr_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('P','R','T',n,n,n,dum(1),n,dum(1),dum(1),n,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_prt_nn = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('Q','L','N',n,n,n,dum(1),n,dum(1),dum(1),n,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_qln_nn = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('Q','L','N',m,n,n,dum(1),m,dum(1),dum(1),m,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_qln_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('Q','L','N',m,m,n,dum(1),m,dum(1),dum(1),m,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_qln_mm = int(dum(1),KIND=ilp)
                 if (m >= mnthr) then
                    if (wntqn) then
                       ! path 1 (m >> n, jobz='n')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd_nn)
                       maxwrk = max(wrkbl,bdspac + n)
                       minwrk = bdspac + n
                    else if (wntqo) then
                       ! path 2 (m >> n, jobz='o')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_mn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_qln_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_prt_nn)
                       wrkbl = max(wrkbl,3*n + bdspac)
                       maxwrk = wrkbl + 2*n*n
                       minwrk = bdspac + 2*n*n + 3*n
                    else if (wntqs) then
                       ! path 3 (m >> n, jobz='s')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_mn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_qln_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_prt_nn)
                       wrkbl = max(wrkbl,3*n + bdspac)
                       maxwrk = wrkbl + n*n
                       minwrk = bdspac + n*n + 3*n
                    else if (wntqa) then
                       ! path 4 (m >> n, jobz='a')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,n + lwork_${ri}$orgqr_mm)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$gebrd_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_qln_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_prt_nn)
                       wrkbl = max(wrkbl,3*n + bdspac)
                       maxwrk = wrkbl + n*n
                       minwrk = n*n + max(3*n + bdspac,n + m)
                    end if
                 else
                    ! path 5 (m >= n, but not much larger)
                    wrkbl = 3*n + lwork_${ri}$gebrd_mn
                    if (wntqn) then
                       ! path 5n (m >= n, jobz='n')
                       maxwrk = max(wrkbl,3*n + bdspac)
                       minwrk = 3*n + max(m,bdspac)
                    else if (wntqo) then
                       ! path 5o (m >= n, jobz='o')
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_prt_nn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_qln_mn)
                       wrkbl = max(wrkbl,3*n + bdspac)
                       maxwrk = wrkbl + m*n
                       minwrk = 3*n + max(m,n*n + bdspac)
                    else if (wntqs) then
                       ! path 5s (m >= n, jobz='s')
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_qln_mn)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_prt_nn)
                       maxwrk = max(wrkbl,3*n + bdspac)
                       minwrk = 3*n + max(m,bdspac)
                    else if (wntqa) then
                       ! path 5a (m >= n, jobz='a')
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*n + lwork_${ri}$ormbr_prt_nn)
                       maxwrk = max(wrkbl,3*n + bdspac)
                       minwrk = 3*n + max(m,bdspac)
                    end if
                 end if
              else if (minmn > 0) then
                 ! compute space needed for la_${ri}$bdsdc
                 if (wntqn) then
                    ! la_${ri}$bdsdc needs only 4*n (or 6*n for uplo=l for lapack <= 3.6_${rk}$)
                    ! keep 7*n for backwards compatibility.
                    bdspac = 7*m
                 else
                    bdspac = 3*m*m + 4*m
                 end if
                 ! compute space preferred for each routine
                 call la_${ri}$gebrd(m,n,dum(1),m,dum(1),dum(1),dum(1),dum(1),dum(1),-1, &
                           ierr)
                 lwork_${ri}$gebrd_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$gebrd(m,m,a,m,s,dum(1),dum(1),dum(1),dum(1),-1,ierr)

                 lwork_${ri}$gebrd_mm = int(dum(1),KIND=ilp)
                 call la_${ri}$gelqf(m,n,a,m,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$gelqf_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$orglq(n,n,m,dum(1),n,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orglq_nn = int(dum(1),KIND=ilp)
                 call la_${ri}$orglq(m,n,m,a,m,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orglq_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$orgbr('P',m,m,m,a,n,dum(1),dum(1),-1,ierr)
                 lwork_${ri}$orgbr_p_mm = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('P','R','T',m,m,m,dum(1),m,dum(1),dum(1),m,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_prt_mm = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('P','R','T',m,n,m,dum(1),m,dum(1),dum(1),m,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_prt_mn = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('P','R','T',n,n,m,dum(1),n,dum(1),dum(1),n,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_prt_nn = int(dum(1),KIND=ilp)
                 call la_${ri}$ormbr('Q','L','N',m,m,m,dum(1),m,dum(1),dum(1),m,dum(1), &
                           -1,ierr)
                 lwork_${ri}$ormbr_qln_mm = int(dum(1),KIND=ilp)
                 if (n >= mnthr) then
                    if (wntqn) then
                       ! path 1t (n >> m, jobz='n')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd_mm)
                       maxwrk = max(wrkbl,bdspac + m)
                       minwrk = bdspac + m
                    else if (wntqo) then
                       ! path 2t (n >> m, jobz='o')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_mn)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_prt_mm)
                       wrkbl = max(wrkbl,3*m + bdspac)
                       maxwrk = wrkbl + 2*m*m
                       minwrk = bdspac + 2*m*m + 3*m
                    else if (wntqs) then
                       ! path 3t (n >> m, jobz='s')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_mn)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_prt_mm)
                       wrkbl = max(wrkbl,3*m + bdspac)
                       maxwrk = wrkbl + m*m
                       minwrk = bdspac + m*m + 3*m
                    else if (wntqa) then
                       ! path 4t (n >> m, jobz='a')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,m + lwork_${ri}$orglq_nn)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$gebrd_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_prt_mm)
                       wrkbl = max(wrkbl,3*m + bdspac)
                       maxwrk = wrkbl + m*m
                       minwrk = m*m + max(3*m + bdspac,m + n)
                    end if
                 else
                    ! path 5t (n > m, but not much larger)
                    wrkbl = 3*m + lwork_${ri}$gebrd_mn
                    if (wntqn) then
                       ! path 5tn (n > m, jobz='n')
                       maxwrk = max(wrkbl,3*m + bdspac)
                       minwrk = 3*m + max(n,bdspac)
                    else if (wntqo) then
                       ! path 5to (n > m, jobz='o')
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_prt_mn)
                       wrkbl = max(wrkbl,3*m + bdspac)
                       maxwrk = wrkbl + m*n
                       minwrk = 3*m + max(n,m*m + bdspac)
                    else if (wntqs) then
                       ! path 5ts (n > m, jobz='s')
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_prt_mn)
                       maxwrk = max(wrkbl,3*m + bdspac)
                       minwrk = 3*m + max(n,bdspac)
                    else if (wntqa) then
                       ! path 5ta (n > m, jobz='a')
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_qln_mm)
                       wrkbl = max(wrkbl,3*m + lwork_${ri}$ormbr_prt_nn)
                       maxwrk = max(wrkbl,3*m + bdspac)
                       minwrk = 3*m + max(n,bdspac)
                    end if
                 end if
              end if
              maxwrk = max(maxwrk,minwrk)
              work(1) = la_${ri}$roundup_lwork(maxwrk)
              if (lwork < minwrk .and. .not. lquery) then
                 info = -12
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESDD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) then
              return
           end if
           ! get machine constants
           eps = la_${ri}$lamch('P')
           smlnum = sqrt(la_${ri}$lamch('S'))/eps
           bignum = one/smlnum
           ! scale a if max element outside range [smlnum,bignum]
           anrm = la_${ri}$lange('M',m,n,a,lda,dum)
           if (la_${ri}$isnan(anrm)) then
               info = -4
               return
           end if
           iscl = 0
           if (anrm > zero .and. anrm < smlnum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,smlnum,m,n,a,lda,ierr)
           else if (anrm > bignum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,bignum,m,n,a,lda,ierr)
           end if
           if (m >= n) then
              ! a has at least as many rows as columns. if a has sufficiently
              ! more rows than columns, first reduce using the qr
              ! decomposition (if sufficient workspace available)
              if (m >= mnthr) then
                 if (wntqn) then
                    ! path 1 (m >> n, jobz='n')
                    ! no singular vectors to be computed
                    itau = 1
                    nwork = itau + n
                    ! compute a=q*r
                    ! workspace: need   n [tau] + n    [work]
                    ! workspace: prefer n [tau] + n*nb [work]
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! zero out below r
                    call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)
                    ie = 1
                    itauq = ie + n
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in a
                    ! workspace: need   3*n [e, tauq, taup] + n      [work]
                    ! workspace: prefer 3*n [e, tauq, taup] + 2*n*nb [work]
                    call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                              work(nwork),lwork - nwork + 1,ierr)
                    nwork = ie + n
                    ! perform bidiagonal svd, computing singular values only
                    ! workspace: need   n [e] + bdspac
                    call la_${ri}$bdsdc('U','N',n,s,work(ie),dum,1,dum,1,dum,idum, &
                              work(nwork),iwork,info)
                 else if (wntqo) then
                    ! path 2 (m >> n, jobz = 'o')
                    ! n left singular vectors to be overwritten on a and
                    ! n right singular vectors to be computed in vt
                    ir = 1
                    ! work(ir) is ldwrkr by n
                    if (lwork >= lda*n + n*n + 3*n + bdspac) then
                       ldwrkr = lda
                    else
                       ldwrkr = (lwork - n*n - 3*n - bdspac)/n
                    end if
                    itau = ir + ldwrkr*n
                    nwork = itau + n
                    ! compute a=q*r
                    ! workspace: need   n*n [r] + n [tau] + n    [work]
                    ! workspace: prefer n*n [r] + n [tau] + n*nb [work]
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! copy r to work(ir), zeroing out below it
                    call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                    call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(ir + 1),ldwrkr)
                    ! generate q in a
                    ! workspace: need   n*n [r] + n [tau] + n    [work]
                    ! workspace: prefer n*n [r] + n [tau] + n*nb [work]
                    call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ie = itau
                    itauq = ie + n
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in work(ir)
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + n      [work]
                    ! workspace: prefer n*n [r] + 3*n [e, tauq, taup] + 2*n*nb [work]
                    call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,work(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! work(iu) is n by n
                    iu = nwork
                    nwork = iu + n*n
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in work(iu) and computing right
                    ! singular vectors of bidiagonal matrix in vt
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + n*n [u] + bdspac
                    call la_${ri}$bdsdc('U','I',n,s,work(ie),work(iu),n,vt,ldvt,dum, &
                              idum,work(nwork),iwork,info)
                    ! overwrite work(iu) by left singular vectors of r
                    ! and vt by right singular vectors of r
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + n*n [u] + n    [work]
                    ! workspace: prefer n*n [r] + 3*n [e, tauq, taup] + n*n [u] + n*nb [work]
                    call la_${ri}$ormbr('Q','L','N',n,n,n,work(ir),ldwrkr,work(itauq), &
                              work(iu),n,work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',n,n,n,work(ir),ldwrkr,work(itaup), &
                              vt,ldvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply q in a by left singular vectors of r in
                    ! work(iu), storing result in work(ir) and copying to a
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + n*n [u]
                    ! workspace: prefer m*n [r] + 3*n [e, tauq, taup] + n*n [u]
                    do i = 1,m,ldwrkr
                       chunk = min(m - i + 1,ldwrkr)
                       call la_${ri}$gemm('N','N',chunk,n,n,one,a(i,1),lda,work(iu), &
                                 n,zero,work(ir),ldwrkr)
                       call la_${ri}$lacpy('F',chunk,n,work(ir),ldwrkr,a(i,1),lda)

                    end do
                 else if (wntqs) then
                    ! path 3 (m >> n, jobz='s')
                    ! n left singular vectors to be computed in u and
                    ! n right singular vectors to be computed in vt
                    ir = 1
                    ! work(ir) is n by n
                    ldwrkr = n
                    itau = ir + ldwrkr*n
                    nwork = itau + n
                    ! compute a=q*r
                    ! workspace: need   n*n [r] + n [tau] + n    [work]
                    ! workspace: prefer n*n [r] + n [tau] + n*nb [work]
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! copy r to work(ir), zeroing out below it
                    call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                    call la_${ri}$laset('L',n - 1,n - 1,zero,zero,work(ir + 1),ldwrkr)
                    ! generate q in a
                    ! workspace: need   n*n [r] + n [tau] + n    [work]
                    ! workspace: prefer n*n [r] + n [tau] + n*nb [work]
                    call la_${ri}$orgqr(m,n,n,a,lda,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ie = itau
                    itauq = ie + n
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in work(ir)
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + n      [work]
                    ! workspace: prefer n*n [r] + 3*n [e, tauq, taup] + 2*n*nb [work]
                    call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,work(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagoal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in vt
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('U','I',n,s,work(ie),u,ldu,vt,ldvt,dum,idum, &
                              work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of r and vt
                    ! by right singular vectors of r
                    ! workspace: need   n*n [r] + 3*n [e, tauq, taup] + n    [work]
                    ! workspace: prefer n*n [r] + 3*n [e, tauq, taup] + n*nb [work]
                    call la_${ri}$ormbr('Q','L','N',n,n,n,work(ir),ldwrkr,work(itauq), &
                              u,ldu,work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',n,n,n,work(ir),ldwrkr,work(itaup), &
                              vt,ldvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply q in a by left singular vectors of r in
                    ! work(ir), storing result in u
                    ! workspace: need   n*n [r]
                    call la_${ri}$lacpy('F',n,n,u,ldu,work(ir),ldwrkr)
                    call la_${ri}$gemm('N','N',m,n,n,one,a,lda,work(ir),ldwrkr,zero,u, &
                               ldu)
                 else if (wntqa) then
                    ! path 4 (m >> n, jobz='a')
                    ! m left singular vectors to be computed in u and
                    ! n right singular vectors to be computed in vt
                    iu = 1
                    ! work(iu) is n by n
                    ldwrku = n
                    itau = iu + ldwrku*n
                    nwork = itau + n
                    ! compute a=q*r, copying result to u
                    ! workspace: need   n*n [u] + n [tau] + n    [work]
                    ! workspace: prefer n*n [u] + n [tau] + n*nb [work]
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                    ! generate q in u
                    ! workspace: need   n*n [u] + n [tau] + m    [work]
                    ! workspace: prefer n*n [u] + n [tau] + m*nb [work]
                    call la_${ri}$orgqr(m,m,n,u,ldu,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! produce r in a, zeroing out other entries
                    call la_${ri}$laset('L',n - 1,n - 1,zero,zero,a(2,1),lda)
                    ie = itau
                    itauq = ie + n
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in a
                    ! workspace: need   n*n [u] + 3*n [e, tauq, taup] + n      [work]
                    ! workspace: prefer n*n [u] + 3*n [e, tauq, taup] + 2*n*nb [work]
                    call la_${ri}$gebrd(n,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in work(iu) and computing right
                    ! singular vectors of bidiagonal matrix in vt
                    ! workspace: need   n*n [u] + 3*n [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('U','I',n,s,work(ie),work(iu),n,vt,ldvt,dum, &
                              idum,work(nwork),iwork,info)
                    ! overwrite work(iu) by left singular vectors of r and vt
                    ! by right singular vectors of r
                    ! workspace: need   n*n [u] + 3*n [e, tauq, taup] + n    [work]
                    ! workspace: prefer n*n [u] + 3*n [e, tauq, taup] + n*nb [work]
                    call la_${ri}$ormbr('Q','L','N',n,n,n,a,lda,work(itauq),work(iu), &
                              ldwrku,work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! multiply q in u by left singular vectors of r in
                    ! work(iu), storing result in a
                    ! workspace: need   n*n [u]
                    call la_${ri}$gemm('N','N',m,n,n,one,u,ldu,work(iu),ldwrku,zero,a, &
                               lda)
                    ! copy left singular vectors of a from a to u
                    call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                 end if
              else
                 ! m < mnthr
                 ! path 5 (m >= n, but not much larger)
                 ! reduce to bidiagonal form without qr decomposition
                 ie = 1
                 itauq = ie + n
                 itaup = itauq + n
                 nwork = itaup + n
                 ! bidiagonalize a
                 ! workspace: need   3*n [e, tauq, taup] + m        [work]
                 ! workspace: prefer 3*n [e, tauq, taup] + (m+n)*nb [work]
                 call la_${ri}$gebrd(m,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                           work(nwork),lwork - nwork + 1,ierr)
                 if (wntqn) then
                    ! path 5n (m >= n, jobz='n')
                    ! perform bidiagonal svd, only computing singular values
                    ! workspace: need   3*n [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('U','N',n,s,work(ie),dum,1,dum,1,dum,idum, &
                              work(nwork),iwork,info)
                 else if (wntqo) then
                    ! path 5o (m >= n, jobz='o')
                    iu = nwork
                    if (lwork >= m*n + 3*n + bdspac) then
                       ! work( iu ) is m by n
                       ldwrku = m
                       nwork = iu + ldwrku*n
                       call la_${ri}$laset('F',m,n,zero,zero,work(iu),ldwrku)
                       ! ir is unused; silence compile warnings
                       ir = -1
                    else
                       ! work( iu ) is n by n
                       ldwrku = n
                       nwork = iu + ldwrku*n
                       ! work(ir) is ldwrkr by n
                       ir = nwork
                       ldwrkr = (lwork - n*n - 3*n)/n
                    end if
                    nwork = iu + ldwrku*n
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in work(iu) and computing right
                    ! singular vectors of bidiagonal matrix in vt
                    ! workspace: need   3*n [e, tauq, taup] + n*n [u] + bdspac
                    call la_${ri}$bdsdc('U','I',n,s,work(ie),work(iu),ldwrku,vt,ldvt, &
                              dum,idum,work(nwork),iwork,info)
                    ! overwrite vt by right singular vectors of a
                    ! workspace: need   3*n [e, tauq, taup] + n*n [u] + n    [work]
                    ! workspace: prefer 3*n [e, tauq, taup] + n*n [u] + n*nb [work]
                    call la_${ri}$ormbr('P','R','T',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                    if (lwork >= m*n + 3*n + bdspac) then
                       ! path 5o-fast
                       ! overwrite work(iu) by left singular vectors of a
                       ! workspace: need   3*n [e, tauq, taup] + m*n [u] + n    [work]
                       ! workspace: prefer 3*n [e, tauq, taup] + m*n [u] + n*nb [work]
                       call la_${ri}$ormbr('Q','L','N',m,n,n,a,lda,work(itauq),work(iu &
                                 ),ldwrku,work(nwork),lwork - nwork + 1,ierr)
                       ! copy left singular vectors of a from work(iu) to a
                       call la_${ri}$lacpy('F',m,n,work(iu),ldwrku,a,lda)
                    else
                       ! path 5o-slow
                       ! generate q in a
                       ! workspace: need   3*n [e, tauq, taup] + n*n [u] + n    [work]
                       ! workspace: prefer 3*n [e, tauq, taup] + n*n [u] + n*nb [work]
                       call la_${ri}$orgbr('Q',m,n,n,a,lda,work(itauq),work(nwork), &
                                 lwork - nwork + 1,ierr)
                       ! multiply q in a by left singular vectors of
                       ! bidiagonal matrix in work(iu), storing result in
                       ! work(ir) and copying to a
                       ! workspace: need   3*n [e, tauq, taup] + n*n [u] + nb*n [r]
                       ! workspace: prefer 3*n [e, tauq, taup] + n*n [u] + m*n  [r]
                       do i = 1,m,ldwrkr
                          chunk = min(m - i + 1,ldwrkr)
                          call la_${ri}$gemm('N','N',chunk,n,n,one,a(i,1),lda,work(iu) &
                                    ,ldwrku,zero,work(ir),ldwrkr)
                          call la_${ri}$lacpy('F',chunk,n,work(ir),ldwrkr,a(i,1),lda)

                       end do
                    end if
                 else if (wntqs) then
                    ! path 5s (m >= n, jobz='s')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in vt
                    ! workspace: need   3*n [e, tauq, taup] + bdspac
                    call la_${ri}$laset('F',m,n,zero,zero,u,ldu)
                    call la_${ri}$bdsdc('U','I',n,s,work(ie),u,ldu,vt,ldvt,dum,idum, &
                              work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of a and vt
                    ! by right singular vectors of a
                    ! workspace: need   3*n [e, tauq, taup] + n    [work]
                    ! workspace: prefer 3*n [e, tauq, taup] + n*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,n,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 else if (wntqa) then
                    ! path 5a (m >= n, jobz='a')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in vt
                    ! workspace: need   3*n [e, tauq, taup] + bdspac
                    call la_${ri}$laset('F',m,m,zero,zero,u,ldu)
                    call la_${ri}$bdsdc('U','I',n,s,work(ie),u,ldu,vt,ldvt,dum,idum, &
                              work(nwork),iwork,info)
                    ! set the right corner of u to identity matrix
                    if (m > n) then
                       call la_${ri}$laset('F',m - n,m - n,zero,one,u(n + 1,n + 1),ldu)
                    end if
                    ! overwrite u by left singular vectors of a and vt
                    ! by right singular vectors of a
                    ! workspace: need   3*n [e, tauq, taup] + m    [work]
                    ! workspace: prefer 3*n [e, tauq, taup] + m*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',n,n,m,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 end if
              end if
           else
              ! a has more columns than rows. if a has sufficiently more
              ! columns than rows, first reduce using the lq decomposition (if
              ! sufficient workspace available)
              if (n >= mnthr) then
                 if (wntqn) then
                    ! path 1t (n >> m, jobz='n')
                    ! no singular vectors to be computed
                    itau = 1
                    nwork = itau + m
                    ! compute a=l*q
                    ! workspace: need   m [tau] + m [work]
                    ! workspace: prefer m [tau] + m*nb [work]
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! zero out above l
                    call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                    ie = 1
                    itauq = ie + m
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in a
                    ! workspace: need   3*m [e, tauq, taup] + m      [work]
                    ! workspace: prefer 3*m [e, tauq, taup] + 2*m*nb [work]
                    call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work(itaup), &
                              work(nwork),lwork - nwork + 1,ierr)
                    nwork = ie + m
                    ! perform bidiagonal svd, computing singular values only
                    ! workspace: need   m [e] + bdspac
                    call la_${ri}$bdsdc('U','N',m,s,work(ie),dum,1,dum,1,dum,idum, &
                              work(nwork),iwork,info)
                 else if (wntqo) then
                    ! path 2t (n >> m, jobz='o')
                    ! m right singular vectors to be overwritten on a and
                    ! m left singular vectors to be computed in u
                    ivt = 1
                    ! work(ivt) is m by m
                    ! work(il)  is m by m; it is later resized to m by chunk for gemm
                    il = ivt + m*m
                    if (lwork >= m*n + m*m + 3*m + bdspac) then
                       ldwrkl = m
                       chunk = n
                    else
                       ldwrkl = m
                       chunk = (lwork - m*m)/m
                    end if
                    itau = il + ldwrkl*m
                    nwork = itau + m
                    ! compute a=l*q
                    ! workspace: need   m*m [vt] + m*m [l] + m [tau] + m    [work]
                    ! workspace: prefer m*m [vt] + m*m [l] + m [tau] + m*nb [work]
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! copy l to work(il), zeroing about above it
                    call la_${ri}$lacpy('L',m,m,a,lda,work(il),ldwrkl)
                    call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(il + ldwrkl),ldwrkl &
                              )
                    ! generate q in a
                    ! workspace: need   m*m [vt] + m*m [l] + m [tau] + m    [work]
                    ! workspace: prefer m*m [vt] + m*m [l] + m [tau] + m*nb [work]
                    call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ie = itau
                    itauq = ie + m
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in work(il)
                    ! workspace: need   m*m [vt] + m*m [l] + 3*m [e, tauq, taup] + m      [work]
                    ! workspace: prefer m*m [vt] + m*m [l] + 3*m [e, tauq, taup] + 2*m*nb [work]
                    call la_${ri}$gebrd(m,m,work(il),ldwrkl,s,work(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u, and computing right singular
                    ! vectors of bidiagonal matrix in work(ivt)
                    ! workspace: need   m*m [vt] + m*m [l] + 3*m [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('U','I',m,s,work(ie),u,ldu,work(ivt),m,dum, &
                              idum,work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of l and work(ivt)
                    ! by right singular vectors of l
                    ! workspace: need   m*m [vt] + m*m [l] + 3*m [e, tauq, taup] + m    [work]
                    ! workspace: prefer m*m [vt] + m*m [l] + 3*m [e, tauq, taup] + m*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,m,work(il),ldwrkl,work(itauq), &
                              u,ldu,work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',m,m,m,work(il),ldwrkl,work(itaup), &
                              work(ivt),m,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply right singular vectors of l in work(ivt) by q
                    ! in a, storing result in work(il) and copying to a
                    ! workspace: need   m*m [vt] + m*m [l]
                    ! workspace: prefer m*m [vt] + m*n [l]
                    ! at this point, l is resized as m by chunk.
                    do i = 1,n,chunk
                       blk = min(n - i + 1,chunk)
                       call la_${ri}$gemm('N','N',m,blk,m,one,work(ivt),m,a(1,i),lda, &
                                  zero,work(il),ldwrkl)
                       call la_${ri}$lacpy('F',m,blk,work(il),ldwrkl,a(1,i),lda)

                    end do
                 else if (wntqs) then
                    ! path 3t (n >> m, jobz='s')
                    ! m right singular vectors to be computed in vt and
                    ! m left singular vectors to be computed in u
                    il = 1
                    ! work(il) is m by m
                    ldwrkl = m
                    itau = il + ldwrkl*m
                    nwork = itau + m
                    ! compute a=l*q
                    ! workspace: need   m*m [l] + m [tau] + m    [work]
                    ! workspace: prefer m*m [l] + m [tau] + m*nb [work]
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! copy l to work(il), zeroing out above it
                    call la_${ri}$lacpy('L',m,m,a,lda,work(il),ldwrkl)
                    call la_${ri}$laset('U',m - 1,m - 1,zero,zero,work(il + ldwrkl),ldwrkl &
                              )
                    ! generate q in a
                    ! workspace: need   m*m [l] + m [tau] + m    [work]
                    ! workspace: prefer m*m [l] + m [tau] + m*nb [work]
                    call la_${ri}$orglq(m,n,m,a,lda,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ie = itau
                    itauq = ie + m
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in work(iu).
                    ! workspace: need   m*m [l] + 3*m [e, tauq, taup] + m      [work]
                    ! workspace: prefer m*m [l] + 3*m [e, tauq, taup] + 2*m*nb [work]
                    call la_${ri}$gebrd(m,m,work(il),ldwrkl,s,work(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in vt
                    ! workspace: need   m*m [l] + 3*m [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('U','I',m,s,work(ie),u,ldu,vt,ldvt,dum,idum, &
                              work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of l and vt
                    ! by right singular vectors of l
                    ! workspace: need   m*m [l] + 3*m [e, tauq, taup] + m    [work]
                    ! workspace: prefer m*m [l] + 3*m [e, tauq, taup] + m*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,m,work(il),ldwrkl,work(itauq), &
                              u,ldu,work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',m,m,m,work(il),ldwrkl,work(itaup), &
                              vt,ldvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply right singular vectors of l in work(il) by
                    ! q in a, storing result in vt
                    ! workspace: need   m*m [l]
                    call la_${ri}$lacpy('F',m,m,vt,ldvt,work(il),ldwrkl)
                    call la_${ri}$gemm('N','N',m,n,m,one,work(il),ldwrkl,a,lda,zero, &
                              vt,ldvt)
                 else if (wntqa) then
                    ! path 4t (n >> m, jobz='a')
                    ! n right singular vectors to be computed in vt and
                    ! m left singular vectors to be computed in u
                    ivt = 1
                    ! work(ivt) is m by m
                    ldwkvt = m
                    itau = ivt + ldwkvt*m
                    nwork = itau + m
                    ! compute a=l*q, copying result to vt
                    ! workspace: need   m*m [vt] + m [tau] + m    [work]
                    ! workspace: prefer m*m [vt] + m [tau] + m*nb [work]
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                    ! generate q in vt
                    ! workspace: need   m*m [vt] + m [tau] + n    [work]
                    ! workspace: prefer m*m [vt] + m [tau] + n*nb [work]
                    call la_${ri}$orglq(n,n,m,vt,ldvt,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! produce l in a, zeroing out other entries
                    call la_${ri}$laset('U',m - 1,m - 1,zero,zero,a(1,2),lda)
                    ie = itau
                    itauq = ie + m
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in a
                    ! workspace: need   m*m [vt] + 3*m [e, tauq, taup] + m      [work]
                    ! workspace: prefer m*m [vt] + 3*m [e, tauq, taup] + 2*m*nb [work]
                    call la_${ri}$gebrd(m,m,a,lda,s,work(ie),work(itauq),work(itaup), &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in work(ivt)
                    ! workspace: need   m*m [vt] + 3*m [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('U','I',m,s,work(ie),u,ldu,work(ivt),ldwkvt, &
                              dum,idum,work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of l and work(ivt)
                    ! by right singular vectors of l
                    ! workspace: need   m*m [vt] + 3*m [e, tauq, taup]+ m    [work]
                    ! workspace: prefer m*m [vt] + 3*m [e, tauq, taup]+ m*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,m,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',m,m,m,a,lda,work(itaup),work(ivt), &
                               ldwkvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply right singular vectors of l in work(ivt) by
                    ! q in vt, storing result in a
                    ! workspace: need   m*m [vt]
                    call la_${ri}$gemm('N','N',m,n,m,one,work(ivt),ldwkvt,vt,ldvt,zero, &
                               a,lda)
                    ! copy right singular vectors of a from a to vt
                    call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                 end if
              else
                 ! n < mnthr
                 ! path 5t (n > m, but not much larger)
                 ! reduce to bidiagonal form without lq decomposition
                 ie = 1
                 itauq = ie + m
                 itaup = itauq + m
                 nwork = itaup + m
                 ! bidiagonalize a
                 ! workspace: need   3*m [e, tauq, taup] + n        [work]
                 ! workspace: prefer 3*m [e, tauq, taup] + (m+n)*nb [work]
                 call la_${ri}$gebrd(m,n,a,lda,s,work(ie),work(itauq),work(itaup), &
                           work(nwork),lwork - nwork + 1,ierr)
                 if (wntqn) then
                    ! path 5tn (n > m, jobz='n')
                    ! perform bidiagonal svd, only computing singular values
                    ! workspace: need   3*m [e, tauq, taup] + bdspac
                    call la_${ri}$bdsdc('L','N',m,s,work(ie),dum,1,dum,1,dum,idum, &
                              work(nwork),iwork,info)
                 else if (wntqo) then
                    ! path 5to (n > m, jobz='o')
                    ldwkvt = m
                    ivt = nwork
                    if (lwork >= m*n + 3*m + bdspac) then
                       ! work( ivt ) is m by n
                       call la_${ri}$laset('F',m,n,zero,zero,work(ivt),ldwkvt)
                       nwork = ivt + ldwkvt*n
                       ! il is unused; silence compile warnings
                       il = -1
                    else
                       ! work( ivt ) is m by m
                       nwork = ivt + ldwkvt*m
                       il = nwork
                       ! work(il) is m by chunk
                       chunk = (lwork - m*m - 3*m)/m
                    end if
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in work(ivt)
                    ! workspace: need   3*m [e, tauq, taup] + m*m [vt] + bdspac
                    call la_${ri}$bdsdc('L','I',m,s,work(ie),u,ldu,work(ivt),ldwkvt, &
                              dum,idum,work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of a
                    ! workspace: need   3*m [e, tauq, taup] + m*m [vt] + m    [work]
                    ! workspace: prefer 3*m [e, tauq, taup] + m*m [vt] + m*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    if (lwork >= m*n + 3*m + bdspac) then
                       ! path 5to-fast
                       ! overwrite work(ivt) by left singular vectors of a
                       ! workspace: need   3*m [e, tauq, taup] + m*n [vt] + m    [work]
                       ! workspace: prefer 3*m [e, tauq, taup] + m*n [vt] + m*nb [work]
                       call la_${ri}$ormbr('P','R','T',m,n,m,a,lda,work(itaup),work( &
                                 ivt),ldwkvt,work(nwork),lwork - nwork + 1,ierr)
                       ! copy right singular vectors of a from work(ivt) to a
                       call la_${ri}$lacpy('F',m,n,work(ivt),ldwkvt,a,lda)
                    else
                       ! path 5to-slow
                       ! generate p**t in a
                       ! workspace: need   3*m [e, tauq, taup] + m*m [vt] + m    [work]
                       ! workspace: prefer 3*m [e, tauq, taup] + m*m [vt] + m*nb [work]
                       call la_${ri}$orgbr('P',m,n,m,a,lda,work(itaup),work(nwork), &
                                 lwork - nwork + 1,ierr)
                       ! multiply q in a by right singular vectors of
                       ! bidiagonal matrix in work(ivt), storing result in
                       ! work(il) and copying to a
                       ! workspace: need   3*m [e, tauq, taup] + m*m [vt] + m*nb [l]
                       ! workspace: prefer 3*m [e, tauq, taup] + m*m [vt] + m*n  [l]
                       do i = 1,n,chunk
                          blk = min(n - i + 1,chunk)
                          call la_${ri}$gemm('N','N',m,blk,m,one,work(ivt),ldwkvt,a(1, &
                                    i),lda,zero,work(il),m)
                          call la_${ri}$lacpy('F',m,blk,work(il),m,a(1,i),lda)
                       end do
                    end if
                 else if (wntqs) then
                    ! path 5ts (n > m, jobz='s')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in vt
                    ! workspace: need   3*m [e, tauq, taup] + bdspac
                    call la_${ri}$laset('F',m,n,zero,zero,vt,ldvt)
                    call la_${ri}$bdsdc('L','I',m,s,work(ie),u,ldu,vt,ldvt,dum,idum, &
                              work(nwork),iwork,info)
                    ! overwrite u by left singular vectors of a and vt
                    ! by right singular vectors of a
                    ! workspace: need   3*m [e, tauq, taup] + m    [work]
                    ! workspace: prefer 3*m [e, tauq, taup] + m*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',m,n,m,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 else if (wntqa) then
                    ! path 5ta (n > m, jobz='a')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in u and computing right singular
                    ! vectors of bidiagonal matrix in vt
                    ! workspace: need   3*m [e, tauq, taup] + bdspac
                    call la_${ri}$laset('F',n,n,zero,zero,vt,ldvt)
                    call la_${ri}$bdsdc('L','I',m,s,work(ie),u,ldu,vt,ldvt,dum,idum, &
                              work(nwork),iwork,info)
                    ! set the right corner of vt to identity matrix
                    if (n > m) then
                       call la_${ri}$laset('F',n - m,n - m,zero,one,vt(m + 1,m + 1),ldvt)
                    end if
                    ! overwrite u by left singular vectors of a and vt
                    ! by right singular vectors of a
                    ! workspace: need   3*m [e, tauq, taup] + n    [work]
                    ! workspace: prefer 3*m [e, tauq, taup] + n*nb [work]
                    call la_${ri}$ormbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    call la_${ri}$ormbr('P','R','T',n,n,m,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 end if
              end if
           end if
           ! undo scaling if necessary
           if (iscl == 1) then
              if (anrm > bignum) call la_${ri}$lascl('G',0,0,bignum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (anrm < smlnum) call la_${ri}$lascl('G',0,0,smlnum,anrm,minmn,1,s,minmn, &
                        ierr)
           end if
           ! return optimal workspace in work(1)
           work(1) = la_${ri}$roundup_lwork(maxwrk)
           return
     end subroutine la_${ri}$gesdd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GESDD: computes the singular value decomposition (SVD) of a complex
     !> M-by-N matrix A, optionally computing the left and/or right singular
     !> vectors, by using divide-and-conquer method. The SVD is written
     !> A = U * SIGMA * conjugate-transpose(V)
     !> where SIGMA is an M-by-N matrix which is zero except for its
     !> min(m,n) diagonal elements, U is an M-by-M unitary matrix, and
     !> V is an N-by-N unitary matrix.  The diagonal elements of SIGMA
     !> are the singular values of A; they are real and non-negative, and
     !> are returned in descending order.  The first min(m,n) columns of
     !> U and V are the left and right singular vectors of A.
     !> Note that the routine returns VT = V**H, not V.
     !> The divide and conquer algorithm makes very mild assumptions about
     !> floating point arithmetic. It will work on machines with a guard
     !> digit in add/subtract, or on those binary machines without guard
     !> digits which subtract like the Cray X-MP, Cray Y-MP, Cray C-90, or
     !> Cray-2. It could conceivably fail on hexadecimal or decimal machines
     !> without guard digits, but we know of none.

     subroutine la_${ri}$gesdd(jobz,m,n,a,lda,s,u,ldu,vt,ldvt,work,lwork,rwork,iwork, &
               info)
        use la_constants_${rk}$,only:zero,one,czero,cone
        ! -- lapack driver routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: jobz
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldu,ldvt,lwork,m,n
           ! Array Arguments
           integer(ilp),intent(out) :: iwork(*)
           real(${rk}$),intent(out) :: rwork(*),s(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: u(ldu,*),vt(ldvt,*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery,wntqa,wntqas,wntqn,wntqo,wntqs
           integer(ilp) :: blk,chunk,i,ie,ierr,il,ir,iru,irvt,iscl,itau,itaup,itauq, &
           iu,ivt,ldwkvt,ldwrkl,ldwrkr,ldwrku,maxwrk,minmn,minwrk,mnthr1,mnthr2,nrwork, &
                      nwork,wrkbl
           integer(ilp) :: lwork_${ri}$gebrd_mn,lwork_${ri}$gebrd_mm,lwork_${ri}$gebrd_nn,lwork_${ri}$gelqf_mn, &
           lwork_${ri}$geqrf_mn,lwork_${ri}$ungbr_p_mn,lwork_${ri}$ungbr_p_nn,lwork_${ri}$ungbr_q_mn, &
           lwork_${ri}$ungbr_q_mm,lwork_${ri}$unglq_mn,lwork_${ri}$unglq_nn,lwork_${ri}$ungqr_mm,lwork_${ri}$ungqr_mn, &
           lwork_${ri}$unmbr_prc_mm,lwork_${ri}$unmbr_qln_mm,lwork_${ri}$unmbr_prc_mn,lwork_${ri}$unmbr_qln_mn, &
                     lwork_${ri}$unmbr_prc_nn,lwork_${ri}$unmbr_qln_nn
           real(${rk}$) :: anrm,bignum,eps,smlnum
           ! Local Arrays
           integer(ilp) :: idum(1)
           real(${rk}$) :: dum(1)
           complex(${rk}$) :: cdum(1)
           ! Intrinsic Functions
           intrinsic :: int,max,min,sqrt
           ! Executable Statements
           ! test the input arguments
           info = 0
           minmn = min(m,n)
           mnthr1 = int(minmn*17.0_${rk}$/9.0_${rk}$,KIND=ilp)
           mnthr2 = int(minmn*5.0_${rk}$/3.0_${rk}$,KIND=ilp)
           wntqa = la_lsame(jobz,'A')
           wntqs = la_lsame(jobz,'S')
           wntqas = wntqa .or. wntqs
           wntqo = la_lsame(jobz,'O')
           wntqn = la_lsame(jobz,'N')
           lquery = (lwork == -1)
           minwrk = 1
           maxwrk = 1
           if (.not. (wntqa .or. wntqs .or. wntqo .or. wntqn)) then
              info = -1
           else if (m < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldu < 1 .or. (wntqas .and. ldu < m) .or. (wntqo .and. m < n .and. ldu < m)) &
                     then
              info = -8
           else if (ldvt < 1 .or. (wntqa .and. ldvt < n) .or. (wntqs .and. ldvt < minmn) .or. (wntqo &
                     .and. m >= n .and. ldvt < n)) then
              info = -10
           end if
           ! compute workspace
             ! note: comments in the code beginning "workspace:" describe the
             ! minimal amount of workspace allocated at that point in the code,
             ! as well as the preferred amount for good performance.
             ! cworkspace refers to complex workspace, and rworkspace to
             ! real workspace. nb refers to the optimal block size for the
             ! immediately following subroutine, as returned by la_ilaenv.)
           if (info == 0) then
              minwrk = 1
              maxwrk = 1
              if (m >= n .and. minmn > 0) then
                 ! there is no complex work space needed for bidiagonal svd
                 ! the realwork space needed for bidiagonal svd (la_${ci}$bdsdc,KIND=${rk}$) is
                 ! bdspac = 3*n*n + 4*n for singular values and vectors;
                 ! bdspac = 4*n         for singular values only;
                 ! not including e, ru, and rvt matrices.
                 ! compute space preferred for each routine
                 call la_${ri}$gebrd(m,n,cdum(1),m,dum(1),dum(1),cdum(1),cdum(1),cdum(1),- &
                           1,ierr)
                 lwork_${ri}$gebrd_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$gebrd(n,n,cdum(1),n,dum(1),dum(1),cdum(1),cdum(1),cdum(1),- &
                           1,ierr)
                 lwork_${ri}$gebrd_nn = int(cdum(1),KIND=ilp)
                 call la_${ri}$geqrf(m,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$geqrf_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('P',n,n,n,cdum(1),n,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_p_nn = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('Q',m,m,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_q_mm = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('Q',m,n,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_q_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungqr(m,m,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungqr_mm = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungqr(m,n,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungqr_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('P','R','C',n,n,n,cdum(1),n,cdum(1),cdum(1),n,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_prc_nn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('Q','L','N',m,m,n,cdum(1),m,cdum(1),cdum(1),m,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_qln_mm = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('Q','L','N',m,n,n,cdum(1),m,cdum(1),cdum(1),m,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_qln_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('Q','L','N',n,n,n,cdum(1),n,cdum(1),cdum(1),n,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_qln_nn = int(cdum(1),KIND=ilp)
                 if (m >= mnthr1) then
                    if (wntqn) then
                       ! path 1 (m >> n, jobz='n')
                       maxwrk = n + lwork_${ri}$geqrf_mn
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$gebrd_nn)
                       minwrk = 3*n
                    else if (wntqo) then
                       ! path 2 (m >> n, jobz='o')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_mn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd_nn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$unmbr_qln_nn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$unmbr_prc_nn)
                       maxwrk = m*n + n*n + wrkbl
                       minwrk = 2*n*n + 3*n
                    else if (wntqs) then
                       ! path 3 (m >> n, jobz='s')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_mn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd_nn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$unmbr_qln_nn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$unmbr_prc_nn)
                       maxwrk = n*n + wrkbl
                       minwrk = n*n + 3*n
                    else if (wntqa) then
                       ! path 4 (m >> n, jobz='a')
                       wrkbl = n + lwork_${ri}$geqrf_mn
                       wrkbl = max(wrkbl,n + lwork_${ri}$ungqr_mm)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$gebrd_nn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$unmbr_qln_nn)
                       wrkbl = max(wrkbl,2*n + lwork_${ri}$unmbr_prc_nn)
                       maxwrk = n*n + wrkbl
                       minwrk = n*n + max(3*n,n + m)
                    end if
                 else if (m >= mnthr2) then
                    ! path 5 (m >> n, but not as much as mnthr1)
                    maxwrk = 2*n + lwork_${ri}$gebrd_mn
                    minwrk = 2*n + m
                    if (wntqo) then
                       ! path 5o (m >> n, jobz='o')
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_p_nn)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_q_mn)
                       maxwrk = maxwrk + m*n
                       minwrk = minwrk + n*n
                    else if (wntqs) then
                       ! path 5s (m >> n, jobz='s')
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_p_nn)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_q_mn)
                    else if (wntqa) then
                       ! path 5a (m >> n, jobz='a')
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_p_nn)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$ungbr_q_mm)
                    end if
                 else
                    ! path 6 (m >= n, but not much larger)
                    maxwrk = 2*n + lwork_${ri}$gebrd_mn
                    minwrk = 2*n + m
                    if (wntqo) then
                       ! path 6o (m >= n, jobz='o')
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$unmbr_prc_nn)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$unmbr_qln_mn)
                       maxwrk = maxwrk + m*n
                       minwrk = minwrk + n*n
                    else if (wntqs) then
                       ! path 6s (m >= n, jobz='s')
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$unmbr_qln_mn)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$unmbr_prc_nn)
                    else if (wntqa) then
                       ! path 6a (m >= n, jobz='a')
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$unmbr_qln_mm)
                       maxwrk = max(maxwrk,2*n + lwork_${ri}$unmbr_prc_nn)
                    end if
                 end if
              else if (minmn > 0) then
                 ! there is no complex work space needed for bidiagonal svd
                 ! the realwork space needed for bidiagonal svd (la_${ci}$bdsdc,KIND=${rk}$) is
                 ! bdspac = 3*m*m + 4*m for singular values and vectors;
                 ! bdspac = 4*m         for singular values only;
                 ! not including e, ru, and rvt matrices.
                 ! compute space preferred for each routine
                 call la_${ri}$gebrd(m,n,cdum(1),m,dum(1),dum(1),cdum(1),cdum(1),cdum(1),- &
                           1,ierr)
                 lwork_${ri}$gebrd_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$gebrd(m,m,cdum(1),m,dum(1),dum(1),cdum(1),cdum(1),cdum(1),- &
                           1,ierr)
                 lwork_${ri}$gebrd_mm = int(cdum(1),KIND=ilp)
                 call la_${ri}$gelqf(m,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$gelqf_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('P',m,n,m,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_p_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('P',n,n,m,cdum(1),n,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_p_nn = int(cdum(1),KIND=ilp)
                 call la_${ri}$ungbr('Q',m,m,n,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$ungbr_q_mm = int(cdum(1),KIND=ilp)
                 call la_${ri}$unglq(m,n,m,cdum(1),m,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$unglq_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unglq(n,n,m,cdum(1),n,cdum(1),cdum(1),-1,ierr)
                 lwork_${ri}$unglq_nn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('P','R','C',m,m,m,cdum(1),m,cdum(1),cdum(1),m,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_prc_mm = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('P','R','C',m,n,m,cdum(1),m,cdum(1),cdum(1),m,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_prc_mn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('P','R','C',n,n,m,cdum(1),n,cdum(1),cdum(1),n,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_prc_nn = int(cdum(1),KIND=ilp)
                 call la_${ri}$unmbr('Q','L','N',m,m,m,cdum(1),m,cdum(1),cdum(1),m,cdum( &
                           1),-1,ierr)
                 lwork_${ri}$unmbr_qln_mm = int(cdum(1),KIND=ilp)
                 if (n >= mnthr1) then
                    if (wntqn) then
                       ! path 1t (n >> m, jobz='n')
                       maxwrk = m + lwork_${ri}$gelqf_mn
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$gebrd_mm)
                       minwrk = 3*m
                    else if (wntqo) then
                       ! path 2t (n >> m, jobz='o')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_mn)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd_mm)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$unmbr_qln_mm)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$unmbr_prc_mm)
                       maxwrk = m*n + m*m + wrkbl
                       minwrk = 2*m*m + 3*m
                    else if (wntqs) then
                       ! path 3t (n >> m, jobz='s')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_mn)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd_mm)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$unmbr_qln_mm)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$unmbr_prc_mm)
                       maxwrk = m*m + wrkbl
                       minwrk = m*m + 3*m
                    else if (wntqa) then
                       ! path 4t (n >> m, jobz='a')
                       wrkbl = m + lwork_${ri}$gelqf_mn
                       wrkbl = max(wrkbl,m + lwork_${ri}$unglq_nn)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$gebrd_mm)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$unmbr_qln_mm)
                       wrkbl = max(wrkbl,2*m + lwork_${ri}$unmbr_prc_mm)
                       maxwrk = m*m + wrkbl
                       minwrk = m*m + max(3*m,m + n)
                    end if
                 else if (n >= mnthr2) then
                    ! path 5t (n >> m, but not as much as mnthr1)
                    maxwrk = 2*m + lwork_${ri}$gebrd_mn
                    minwrk = 2*m + n
                    if (wntqo) then
                       ! path 5to (n >> m, jobz='o')
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_q_mm)
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_p_mn)
                       maxwrk = maxwrk + m*n
                       minwrk = minwrk + m*m
                    else if (wntqs) then
                       ! path 5ts (n >> m, jobz='s')
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_q_mm)
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_p_mn)
                    else if (wntqa) then
                       ! path 5ta (n >> m, jobz='a')
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_q_mm)
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$ungbr_p_nn)
                    end if
                 else
                    ! path 6t (n > m, but not much larger)
                    maxwrk = 2*m + lwork_${ri}$gebrd_mn
                    minwrk = 2*m + n
                    if (wntqo) then
                       ! path 6to (n > m, jobz='o')
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$unmbr_qln_mm)
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$unmbr_prc_mn)
                       maxwrk = maxwrk + m*n
                       minwrk = minwrk + m*m
                    else if (wntqs) then
                       ! path 6ts (n > m, jobz='s')
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$unmbr_qln_mm)
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$unmbr_prc_mn)
                    else if (wntqa) then
                       ! path 6ta (n > m, jobz='a')
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$unmbr_qln_mm)
                       maxwrk = max(maxwrk,2*m + lwork_${ri}$unmbr_prc_nn)
                    end if
                 end if
              end if
              maxwrk = max(maxwrk,minwrk)
           end if
           if (info == 0) then
              work(1) = la_${ci}$roundup_lwork(maxwrk)
              if (lwork < minwrk .and. .not. lquery) then
                 info = -12
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESDD',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) then
              return
           end if
           ! get machine constants
           eps = la_${ci}$lamch('P')
           smlnum = sqrt(la_${ci}$lamch('S'))/eps
           bignum = one/smlnum
           ! scale a if max element outside range [smlnum,bignum]
           anrm = la_${ri}$lange('M',m,n,a,lda,dum)
           if (la_${ci}$isnan(anrm)) then
               info = -4
               return
           end if
           iscl = 0
           if (anrm > zero .and. anrm < smlnum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,smlnum,m,n,a,lda,ierr)
           else if (anrm > bignum) then
              iscl = 1
              call la_${ri}$lascl('G',0,0,anrm,bignum,m,n,a,lda,ierr)
           end if
           if (m >= n) then
              ! a has at least as many rows as columns. if a has sufficiently
              ! more rows than columns, first reduce using the qr
              ! decomposition (if sufficient workspace available)
              if (m >= mnthr1) then
                 if (wntqn) then
                    ! path 1 (m >> n, jobz='n')
                    ! no singular vectors to be computed
                    itau = 1
                    nwork = itau + n
                    ! compute a=q*r
                    ! cworkspace: need   n [tau] + n    [work]
                    ! cworkspace: prefer n [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    ! zero out below r
                    call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)
                    ie = 1
                    itauq = 1
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in a
                    ! cworkspace: need   2*n [tauq, taup] + n      [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + 2*n*nb [work]
                    ! rworkspace: need   n [e]
                    call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                               work(nwork),lwork - nwork + 1,ierr)
                    nrwork = ie + n
                    ! perform bidiagonal svd, compute singular values only
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + bdspac
                    call la_${ci}$bdsdc('U','N',n,s,rwork(ie),dum,1,dum,1,dum,idum,rwork( &
                               nrwork),iwork,info)
                 else if (wntqo) then
                    ! path 2 (m >> n, jobz='o')
                    ! n left singular vectors to be overwritten on a and
                    ! n right singular vectors to be computed in vt
                    iu = 1
                    ! work(iu) is n by n
                    ldwrku = n
                    ir = iu + ldwrku*n
                    if (lwork >= m*n + n*n + 3*n) then
                       ! work(ir) is m by n
                       ldwrkr = m
                    else
                       ldwrkr = (lwork - n*n - 3*n)/n
                    end if
                    itau = ir + ldwrkr*n
                    nwork = itau + n
                    ! compute a=q*r
                    ! cworkspace: need   n*n [u] + n*n [r] + n [tau] + n    [work]
                    ! cworkspace: prefer n*n [u] + n*n [r] + n [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    ! copy r to work( ir ), zeroing out below it
                    call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                    call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(ir + 1),ldwrkr)
                    ! generate q in a
                    ! cworkspace: need   n*n [u] + n*n [r] + n [tau] + n    [work]
                    ! cworkspace: prefer n*n [u] + n*n [r] + n [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ie = 1
                    itauq = itau
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in work(ir)
                    ! cworkspace: need   n*n [u] + n*n [r] + 2*n [tauq, taup] + n      [work]
                    ! cworkspace: prefer n*n [u] + n*n [r] + 2*n [tauq, taup] + 2*n*nb [work]
                    ! rworkspace: need   n [e]
                    call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,rwork(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of r in work(iru) and computing right singular vectors
                    ! of r in work(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    iru = ie + n
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix work(iu)
                    ! overwrite work(iu) by the left singular vectors of r
                    ! cworkspace: need   n*n [u] + n*n [r] + 2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer n*n [u] + n*n [r] + 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',n,n,rwork(iru),n,work(iu),ldwrku)
                    call la_${ri}$unmbr('Q','L','N',n,n,n,work(ir),ldwrkr,work(itauq), &
                              work(iu),ldwrku,work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by the right singular vectors of r
                    ! cworkspace: need   n*n [u] + n*n [r] + 2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer n*n [u] + n*n [r] + 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',n,n,rwork(irvt),n,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,n,work(ir),ldwrkr,work(itaup), &
                              vt,ldvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply q in a by left singular vectors of r in
                    ! work(iu), storing result in work(ir) and copying to a
                    ! cworkspace: need   n*n [u] + n*n [r]
                    ! cworkspace: prefer n*n [u] + m*n [r]
                    ! rworkspace: need   0
                    do i = 1,m,ldwrkr
                       chunk = min(m - i + 1,ldwrkr)
                       call la_${ri}$gemm('N','N',chunk,n,n,cone,a(i,1),lda,work(iu), &
                                 ldwrku,czero,work(ir),ldwrkr)
                       call la_${ri}$lacpy('F',chunk,n,work(ir),ldwrkr,a(i,1),lda)

                    end do
                 else if (wntqs) then
                    ! path 3 (m >> n, jobz='s')
                    ! n left singular vectors to be computed in u and
                    ! n right singular vectors to be computed in vt
                    ir = 1
                    ! work(ir) is n by n
                    ldwrkr = n
                    itau = ir + ldwrkr*n
                    nwork = itau + n
                    ! compute a=q*r
                    ! cworkspace: need   n*n [r] + n [tau] + n    [work]
                    ! cworkspace: prefer n*n [r] + n [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    ! copy r to work(ir), zeroing out below it
                    call la_${ri}$lacpy('U',n,n,a,lda,work(ir),ldwrkr)
                    call la_${ri}$laset('L',n - 1,n - 1,czero,czero,work(ir + 1),ldwrkr)
                    ! generate q in a
                    ! cworkspace: need   n*n [r] + n [tau] + n    [work]
                    ! cworkspace: prefer n*n [r] + n [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$ungqr(m,n,n,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ie = 1
                    itauq = itau
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in work(ir)
                    ! cworkspace: need   n*n [r] + 2*n [tauq, taup] + n      [work]
                    ! cworkspace: prefer n*n [r] + 2*n [tauq, taup] + 2*n*nb [work]
                    ! rworkspace: need   n [e]
                    call la_${ri}$gebrd(n,n,work(ir),ldwrkr,s,rwork(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    iru = ie + n
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of r
                    ! cworkspace: need   n*n [r] + 2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer n*n [r] + 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',n,n,rwork(iru),n,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',n,n,n,work(ir),ldwrkr,work(itauq), &
                              u,ldu,work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of r
                    ! cworkspace: need   n*n [r] + 2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer n*n [r] + 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',n,n,rwork(irvt),n,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,n,work(ir),ldwrkr,work(itaup), &
                              vt,ldvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply q in a by left singular vectors of r in
                    ! work(ir), storing result in u
                    ! cworkspace: need   n*n [r]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('F',n,n,u,ldu,work(ir),ldwrkr)
                    call la_${ri}$gemm('N','N',m,n,n,cone,a,lda,work(ir),ldwrkr,czero, &
                              u,ldu)
                 else if (wntqa) then
                    ! path 4 (m >> n, jobz='a')
                    ! m left singular vectors to be computed in u and
                    ! n right singular vectors to be computed in vt
                    iu = 1
                    ! work(iu) is n by n
                    ldwrku = n
                    itau = iu + ldwrku*n
                    nwork = itau + n
                    ! compute a=q*r, copying result to u
                    ! cworkspace: need   n*n [u] + n [tau] + n    [work]
                    ! cworkspace: prefer n*n [u] + n [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$geqrf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                    ! generate q in u
                    ! cworkspace: need   n*n [u] + n [tau] + m    [work]
                    ! cworkspace: prefer n*n [u] + n [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$ungqr(m,m,n,u,ldu,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ! produce r in a, zeroing out below it
                    call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)
                    ie = 1
                    itauq = itau
                    itaup = itauq + n
                    nwork = itaup + n
                    ! bidiagonalize r in a
                    ! cworkspace: need   n*n [u] + 2*n [tauq, taup] + n      [work]
                    ! cworkspace: prefer n*n [u] + 2*n [tauq, taup] + 2*n*nb [work]
                    ! rworkspace: need   n [e]
                    call la_${ri}$gebrd(n,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                               work(nwork),lwork - nwork + 1,ierr)
                    iru = ie + n
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix work(iu)
                    ! overwrite work(iu) by left singular vectors of r
                    ! cworkspace: need   n*n [u] + 2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer n*n [u] + 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',n,n,rwork(iru),n,work(iu),ldwrku)
                    call la_${ri}$unmbr('Q','L','N',n,n,n,a,lda,work(itauq),work(iu), &
                              ldwrku,work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of r
                    ! cworkspace: need   n*n [u] + 2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer n*n [u] + 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',n,n,rwork(irvt),n,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! multiply q in u by left singular vectors of r in
                    ! work(iu), storing result in a
                    ! cworkspace: need   n*n [u]
                    ! rworkspace: need   0
                    call la_${ri}$gemm('N','N',m,n,n,cone,u,ldu,work(iu),ldwrku,czero, &
                              a,lda)
                    ! copy left singular vectors of a from a to u
                    call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                 end if
              else if (m >= mnthr2) then
                 ! mnthr2 <= m < mnthr1
                 ! path 5 (m >> n, but not as much as mnthr1)
                 ! reduce to bidiagonal form without qr decomposition, use
                 ! la_${ri}$ungbr and matrix multiplication to compute singular vectors
                 ie = 1
                 nrwork = ie + n
                 itauq = 1
                 itaup = itauq + n
                 nwork = itaup + n
                 ! bidiagonalize a
                 ! cworkspace: need   2*n [tauq, taup] + m        [work]
                 ! cworkspace: prefer 2*n [tauq, taup] + (m+n)*nb [work]
                 ! rworkspace: need   n [e]
                 call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                           work(nwork),lwork - nwork + 1,ierr)
                 if (wntqn) then
                    ! path 5n (m >> n, jobz='n')
                    ! compute singular values only
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + bdspac
                    call la_${ci}$bdsdc('U','N',n,s,rwork(ie),dum,1,dum,1,dum,idum, &
                              rwork(nrwork),iwork,info)
                 else if (wntqo) then
                    iu = nwork
                    iru = nrwork
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    ! path 5o (m >> n, jobz='o')
                    ! copy a to vt, generate p**h
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                    call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(nwork), &
                              lwork - nwork + 1,ierr)
                    ! generate q in a
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$ungbr('Q',m,n,n,a,lda,work(itauq),work(nwork),lwork - &
                              nwork + 1,ierr)
                    if (lwork >= m*n + 3*n) then
                       ! work( iu ) is m by n
                       ldwrku = m
                    else
                       ! work(iu) is ldwrku by n
                       ldwrku = (lwork - 3*n)/n
                    end if
                    nwork = iu + ldwrku*n
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! multiply realmatrix rwork(irvt,KIND=${rk}$) by p**h in vt,
                    ! storing the result in work(iu), copying to vt
                    ! cworkspace: need   2*n [tauq, taup] + n*n [u]
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + 2*n*n [rwork]
                    call la_${ri}$larcm(n,n,rwork(irvt),n,vt,ldvt,work(iu),ldwrku, &
                              rwork(nrwork))
                    call la_${ri}$lacpy('F',n,n,work(iu),ldwrku,vt,ldvt)
                    ! multiply q in a by realmatrix rwork(iru,KIND=${rk}$), storing the
                    ! result in work(iu), copying to a
                    ! cworkspace: need   2*n [tauq, taup] + n*n [u]
                    ! cworkspace: prefer 2*n [tauq, taup] + m*n [u]
                    ! rworkspace: need   n [e] + n*n [ru] + 2*n*n [rwork]
                    ! rworkspace: prefer n [e] + n*n [ru] + 2*m*n [rwork] < n + 5*n*n since m < 2*n here
                    nrwork = irvt
                    do i = 1,m,ldwrku
                       chunk = min(m - i + 1,ldwrku)
                       call la_${ri}$lacrm(chunk,n,a(i,1),lda,rwork(iru),n,work(iu), &
                                 ldwrku,rwork(nrwork))
                       call la_${ri}$lacpy('F',chunk,n,work(iu),ldwrku,a(i,1),lda)

                    end do
                 else if (wntqs) then
                    ! path 5s (m >> n, jobz='s')
                    ! copy a to vt, generate p**h
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                    call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(nwork), &
                              lwork - nwork + 1,ierr)
                    ! copy a to u, generate q
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                    call la_${ri}$ungbr('Q',m,n,n,u,ldu,work(itauq),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    iru = nrwork
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! multiply realmatrix rwork(irvt,KIND=${rk}$) by p**h in vt,
                    ! storing the result in a, copying to vt
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + 2*n*n [rwork]
                    call la_${ri}$larcm(n,n,rwork(irvt),n,vt,ldvt,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',n,n,a,lda,vt,ldvt)
                    ! multiply q in u by realmatrix rwork(iru,KIND=${rk}$), storing the
                    ! result in a, copying to u
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + 2*m*n [rwork] < n + 5*n*n since m < 2*n here
                    nrwork = irvt
                    call la_${ri}$lacrm(m,n,u,ldu,rwork(iru),n,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                 else
                    ! path 5a (m >> n, jobz='a')
                    ! copy a to vt, generate p**h
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('U',n,n,a,lda,vt,ldvt)
                    call la_${ri}$ungbr('P',n,n,n,vt,ldvt,work(itaup),work(nwork), &
                              lwork - nwork + 1,ierr)
                    ! copy a to u, generate q
                    ! cworkspace: need   2*n [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('L',m,n,a,lda,u,ldu)
                    call la_${ri}$ungbr('Q',m,m,n,u,ldu,work(itauq),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    iru = nrwork
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! multiply realmatrix rwork(irvt,KIND=${rk}$) by p**h in vt,
                    ! storing the result in a, copying to vt
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + 2*n*n [rwork]
                    call la_${ri}$larcm(n,n,rwork(irvt),n,vt,ldvt,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',n,n,a,lda,vt,ldvt)
                    ! multiply q in u by realmatrix rwork(iru,KIND=${rk}$), storing the
                    ! result in a, copying to u
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + 2*m*n [rwork] < n + 5*n*n since m < 2*n here
                    nrwork = irvt
                    call la_${ri}$lacrm(m,n,u,ldu,rwork(iru),n,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',m,n,a,lda,u,ldu)
                 end if
              else
                 ! m < mnthr2
                 ! path 6 (m >= n, but not much larger)
                 ! reduce to bidiagonal form without qr decomposition
                 ! use la_${ri}$unmbr to compute singular vectors
                 ie = 1
                 nrwork = ie + n
                 itauq = 1
                 itaup = itauq + n
                 nwork = itaup + n
                 ! bidiagonalize a
                 ! cworkspace: need   2*n [tauq, taup] + m        [work]
                 ! cworkspace: prefer 2*n [tauq, taup] + (m+n)*nb [work]
                 ! rworkspace: need   n [e]
                 call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                           work(nwork),lwork - nwork + 1,ierr)
                 if (wntqn) then
                    ! path 6n (m >= n, jobz='n')
                    ! compute singular values only
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + bdspac
                    call la_${ci}$bdsdc('U','N',n,s,rwork(ie),dum,1,dum,1,dum,idum,rwork( &
                               nrwork),iwork,info)
                 else if (wntqo) then
                    iu = nwork
                    iru = nrwork
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    if (lwork >= m*n + 3*n) then
                       ! work( iu ) is m by n
                       ldwrku = m
                    else
                       ! work( iu ) is ldwrku by n
                       ldwrku = (lwork - 3*n)/n
                    end if
                    nwork = iu + ldwrku*n
                    ! path 6o (m >= n, jobz='o')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of a
                    ! cworkspace: need   2*n [tauq, taup] + n*n [u] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*n [u] + n*nb [work]
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt]
                    call la_${ri}$lacp2('F',n,n,rwork(irvt),n,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                    if (lwork >= m*n + 3*n) then
                       ! path 6o-fast
                       ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix work(iu)
                       ! overwrite work(iu) by left singular vectors of a, copying
                       ! to a
                       ! cworkspace: need   2*n [tauq, taup] + m*n [u] + n    [work]
                       ! cworkspace: prefer 2*n [tauq, taup] + m*n [u] + n*nb [work]
                       ! rworkspace: need   n [e] + n*n [ru]
                       call la_${ri}$laset('F',m,n,czero,czero,work(iu),ldwrku)
                       call la_${ri}$lacp2('F',n,n,rwork(iru),n,work(iu),ldwrku)
                       call la_${ri}$unmbr('Q','L','N',m,n,n,a,lda,work(itauq),work(iu &
                                 ),ldwrku,work(nwork),lwork - nwork + 1,ierr)
                       call la_${ri}$lacpy('F',m,n,work(iu),ldwrku,a,lda)
                    else
                       ! path 6o-slow
                       ! generate q in a
                       ! cworkspace: need   2*n [tauq, taup] + n*n [u] + n    [work]
                       ! cworkspace: prefer 2*n [tauq, taup] + n*n [u] + n*nb [work]
                       ! rworkspace: need   0
                       call la_${ri}$ungbr('Q',m,n,n,a,lda,work(itauq),work(nwork), &
                                 lwork - nwork + 1,ierr)
                       ! multiply q in a by realmatrix rwork(iru,KIND=${rk}$), storing the
                       ! result in work(iu), copying to a
                       ! cworkspace: need   2*n [tauq, taup] + n*n [u]
                       ! cworkspace: prefer 2*n [tauq, taup] + m*n [u]
                       ! rworkspace: need   n [e] + n*n [ru] + 2*n*n [rwork]
                       ! rworkspace: prefer n [e] + n*n [ru] + 2*m*n [rwork] < n + 5*n*n since m < 2*n here
                       nrwork = irvt
                       do i = 1,m,ldwrku
                          chunk = min(m - i + 1,ldwrku)
                          call la_${ri}$lacrm(chunk,n,a(i,1),lda,rwork(iru),n,work(iu) &
                                    ,ldwrku,rwork(nrwork))
                          call la_${ri}$lacpy('F',chunk,n,work(iu),ldwrku,a(i,1),lda)

                       end do
                    end if
                 else if (wntqs) then
                    ! path 6s (m >= n, jobz='s')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    iru = nrwork
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of a
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt]
                    call la_${ri}$laset('F',m,n,czero,czero,u,ldu)
                    call la_${ri}$lacp2('F',n,n,rwork(iru),n,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,n,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of a
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt]
                    call la_${ri}$lacp2('F',n,n,rwork(irvt),n,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 else
                    ! path 6a (m >= n, jobz='a')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt] + bdspac
                    iru = nrwork
                    irvt = iru + n*n
                    nrwork = irvt + n*n
                    call la_${ci}$bdsdc('U','I',n,s,rwork(ie),rwork(iru),n,rwork(irvt) &
                              ,n,dum,idum,rwork(nrwork),iwork,info)
                    ! set the right corner of u to identity matrix
                    call la_${ri}$laset('F',m,m,czero,czero,u,ldu)
                    if (m > n) then
                       call la_${ri}$laset('F',m - n,m - n,czero,cone,u(n + 1,n + 1),ldu)
                    end if
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of a
                    ! cworkspace: need   2*n [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + m*nb [work]
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt]
                    call la_${ri}$lacp2('F',n,n,rwork(iru),n,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of a
                    ! cworkspace: need   2*n [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*n [tauq, taup] + n*nb [work]
                    ! rworkspace: need   n [e] + n*n [ru] + n*n [rvt]
                    call la_${ri}$lacp2('F',n,n,rwork(irvt),n,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,n,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 end if
              end if
           else
              ! a has more columns than rows. if a has sufficiently more
              ! columns than rows, first reduce using the lq decomposition (if
              ! sufficient workspace available)
              if (n >= mnthr1) then
                 if (wntqn) then
                    ! path 1t (n >> m, jobz='n')
                    ! no singular vectors to be computed
                    itau = 1
                    nwork = itau + m
                    ! compute a=l*q
                    ! cworkspace: need   m [tau] + m    [work]
                    ! cworkspace: prefer m [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    ! zero out above l
                    call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                    ie = 1
                    itauq = 1
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in a
                    ! cworkspace: need   2*m [tauq, taup] + m      [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + 2*m*nb [work]
                    ! rworkspace: need   m [e]
                    call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                               work(nwork),lwork - nwork + 1,ierr)
                    nrwork = ie + m
                    ! perform bidiagonal svd, compute singular values only
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + bdspac
                    call la_${ci}$bdsdc('U','N',m,s,rwork(ie),dum,1,dum,1,dum,idum,rwork( &
                               nrwork),iwork,info)
                 else if (wntqo) then
                    ! path 2t (n >> m, jobz='o')
                    ! m right singular vectors to be overwritten on a and
                    ! m left singular vectors to be computed in u
                    ivt = 1
                    ldwkvt = m
                    ! work(ivt) is m by m
                    il = ivt + ldwkvt*m
                    if (lwork >= m*n + m*m + 3*m) then
                       ! work(il) m by n
                       ldwrkl = m
                       chunk = n
                    else
                       ! work(il) is m by chunk
                       ldwrkl = m
                       chunk = (lwork - m*m - 3*m)/m
                    end if
                    itau = il + ldwrkl*chunk
                    nwork = itau + m
                    ! compute a=l*q
                    ! cworkspace: need   m*m [vt] + m*m [l] + m [tau] + m    [work]
                    ! cworkspace: prefer m*m [vt] + m*m [l] + m [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    ! copy l to work(il), zeroing about above it
                    call la_${ri}$lacpy('L',m,m,a,lda,work(il),ldwrkl)
                    call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(il + ldwrkl),ldwrkl)

                    ! generate q in a
                    ! cworkspace: need   m*m [vt] + m*m [l] + m [tau] + m    [work]
                    ! cworkspace: prefer m*m [vt] + m*m [l] + m [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ie = 1
                    itauq = itau
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in work(il)
                    ! cworkspace: need   m*m [vt] + m*m [l] + 2*m [tauq, taup] + m      [work]
                    ! cworkspace: prefer m*m [vt] + m*m [l] + 2*m [tauq, taup] + 2*m*nb [work]
                    ! rworkspace: need   m [e]
                    call la_${ri}$gebrd(m,m,work(il),ldwrkl,s,rwork(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [ru] + m*m [rvt] + bdspac
                    iru = ie + m
                    irvt = iru + m*m
                    nrwork = irvt + m*m
                    call la_${ci}$bdsdc('U','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix work(iu)
                    ! overwrite work(iu) by the left singular vectors of l
                    ! cworkspace: need   m*m [vt] + m*m [l] + 2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer m*m [vt] + m*m [l] + 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',m,m,rwork(iru),m,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,m,work(il),ldwrkl,work(itauq), &
                              u,ldu,work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix work(ivt)
                    ! overwrite work(ivt) by the right singular vectors of l
                    ! cworkspace: need   m*m [vt] + m*m [l] + 2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer m*m [vt] + m*m [l] + 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',m,m,rwork(irvt),m,work(ivt),ldwkvt)
                    call la_${ri}$unmbr('P','R','C',m,m,m,work(il),ldwrkl,work(itaup), &
                              work(ivt),ldwkvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply right singular vectors of l in work(il) by q
                    ! in a, storing result in work(il) and copying to a
                    ! cworkspace: need   m*m [vt] + m*m [l]
                    ! cworkspace: prefer m*m [vt] + m*n [l]
                    ! rworkspace: need   0
                    do i = 1,n,chunk
                       blk = min(n - i + 1,chunk)
                       call la_${ri}$gemm('N','N',m,blk,m,cone,work(ivt),m,a(1,i), &
                                 lda,czero,work(il),ldwrkl)
                       call la_${ri}$lacpy('F',m,blk,work(il),ldwrkl,a(1,i),lda)

                    end do
                 else if (wntqs) then
                    ! path 3t (n >> m, jobz='s')
                    ! m right singular vectors to be computed in vt and
                    ! m left singular vectors to be computed in u
                    il = 1
                    ! work(il) is m by m
                    ldwrkl = m
                    itau = il + ldwrkl*m
                    nwork = itau + m
                    ! compute a=l*q
                    ! cworkspace: need   m*m [l] + m [tau] + m    [work]
                    ! cworkspace: prefer m*m [l] + m [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    ! copy l to work(il), zeroing out above it
                    call la_${ri}$lacpy('L',m,m,a,lda,work(il),ldwrkl)
                    call la_${ri}$laset('U',m - 1,m - 1,czero,czero,work(il + ldwrkl),ldwrkl)

                    ! generate q in a
                    ! cworkspace: need   m*m [l] + m [tau] + m    [work]
                    ! cworkspace: prefer m*m [l] + m [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$unglq(m,n,m,a,lda,work(itau),work(nwork),lwork - nwork + &
                              1,ierr)
                    ie = 1
                    itauq = itau
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in work(il)
                    ! cworkspace: need   m*m [l] + 2*m [tauq, taup] + m      [work]
                    ! cworkspace: prefer m*m [l] + 2*m [tauq, taup] + 2*m*nb [work]
                    ! rworkspace: need   m [e]
                    call la_${ri}$gebrd(m,m,work(il),ldwrkl,s,rwork(ie),work(itauq), &
                              work(itaup),work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [ru] + m*m [rvt] + bdspac
                    iru = ie + m
                    irvt = iru + m*m
                    nrwork = irvt + m*m
                    call la_${ci}$bdsdc('U','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of l
                    ! cworkspace: need   m*m [l] + 2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer m*m [l] + 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',m,m,rwork(iru),m,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,m,work(il),ldwrkl,work(itauq), &
                              u,ldu,work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by left singular vectors of l
                    ! cworkspace: need   m*m [l] + 2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer m*m [l] + 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',m,m,rwork(irvt),m,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',m,m,m,work(il),ldwrkl,work(itaup), &
                              vt,ldvt,work(nwork),lwork - nwork + 1,ierr)
                    ! copy vt to work(il), multiply right singular vectors of l
                    ! in work(il) by q in a, storing result in vt
                    ! cworkspace: need   m*m [l]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('F',m,m,vt,ldvt,work(il),ldwrkl)
                    call la_${ri}$gemm('N','N',m,n,m,cone,work(il),ldwrkl,a,lda,czero, &
                              vt,ldvt)
                 else if (wntqa) then
                    ! path 4t (n >> m, jobz='a')
                    ! n right singular vectors to be computed in vt and
                    ! m left singular vectors to be computed in u
                    ivt = 1
                    ! work(ivt) is m by m
                    ldwkvt = m
                    itau = ivt + ldwkvt*m
                    nwork = itau + m
                    ! compute a=l*q, copying result to vt
                    ! cworkspace: need   m*m [vt] + m [tau] + m    [work]
                    ! cworkspace: prefer m*m [vt] + m [tau] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$gelqf(m,n,a,lda,work(itau),work(nwork),lwork - nwork + 1, &
                              ierr)
                    call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                    ! generate q in vt
                    ! cworkspace: need   m*m [vt] + m [tau] + n    [work]
                    ! cworkspace: prefer m*m [vt] + m [tau] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$unglq(n,n,m,vt,ldvt,work(itau),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! produce l in a, zeroing out above it
                    call la_${ri}$laset('U',m - 1,m - 1,czero,czero,a(1,2),lda)
                    ie = 1
                    itauq = itau
                    itaup = itauq + m
                    nwork = itaup + m
                    ! bidiagonalize l in a
                    ! cworkspace: need   m*m [vt] + 2*m [tauq, taup] + m      [work]
                    ! cworkspace: prefer m*m [vt] + 2*m [tauq, taup] + 2*m*nb [work]
                    ! rworkspace: need   m [e]
                    call la_${ri}$gebrd(m,m,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                               work(nwork),lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [ru] + m*m [rvt] + bdspac
                    iru = ie + m
                    irvt = iru + m*m
                    nrwork = irvt + m*m
                    call la_${ci}$bdsdc('U','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of l
                    ! cworkspace: need   m*m [vt] + 2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer m*m [vt] + 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',m,m,rwork(iru),m,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,m,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix work(ivt)
                    ! overwrite work(ivt) by right singular vectors of l
                    ! cworkspace: need   m*m [vt] + 2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer m*m [vt] + 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacp2('F',m,m,rwork(irvt),m,work(ivt),ldwkvt)
                    call la_${ri}$unmbr('P','R','C',m,m,m,a,lda,work(itaup),work(ivt), &
                               ldwkvt,work(nwork),lwork - nwork + 1,ierr)
                    ! multiply right singular vectors of l in work(ivt) by
                    ! q in vt, storing result in a
                    ! cworkspace: need   m*m [vt]
                    ! rworkspace: need   0
                    call la_${ri}$gemm('N','N',m,n,m,cone,work(ivt),ldwkvt,vt,ldvt, &
                              czero,a,lda)
                    ! copy right singular vectors of a from a to vt
                    call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                 end if
              else if (n >= mnthr2) then
                 ! mnthr2 <= n < mnthr1
                 ! path 5t (n >> m, but not as much as mnthr1)
                 ! reduce to bidiagonal form without qr decomposition, use
                 ! la_${ri}$ungbr and matrix multiplication to compute singular vectors
                 ie = 1
                 nrwork = ie + m
                 itauq = 1
                 itaup = itauq + m
                 nwork = itaup + m
                 ! bidiagonalize a
                 ! cworkspace: need   2*m [tauq, taup] + n        [work]
                 ! cworkspace: prefer 2*m [tauq, taup] + (m+n)*nb [work]
                 ! rworkspace: need   m [e]
                 call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                           work(nwork),lwork - nwork + 1,ierr)
                 if (wntqn) then
                    ! path 5tn (n >> m, jobz='n')
                    ! compute singular values only
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + bdspac
                    call la_${ci}$bdsdc('L','N',m,s,rwork(ie),dum,1,dum,1,dum,idum,rwork( &
                               nrwork),iwork,info)
                 else if (wntqo) then
                    irvt = nrwork
                    iru = irvt + m*m
                    nrwork = iru + m*m
                    ivt = nwork
                    ! path 5to (n >> m, jobz='o')
                    ! copy a to u, generate q
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                    call la_${ri}$ungbr('Q',m,m,n,u,ldu,work(itauq),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! generate p**h in a
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$ungbr('P',m,n,m,a,lda,work(itaup),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ldwkvt = m
                    if (lwork >= m*n + 3*m) then
                       ! work( ivt ) is m by n
                       nwork = ivt + ldwkvt*n
                       chunk = n
                    else
                       ! work( ivt ) is m by chunk
                       chunk = (lwork - 3*m)/m
                       nwork = ivt + ldwkvt*chunk
                    end if
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + bdspac
                    call la_${ci}$bdsdc('L','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! multiply q in u by realmatrix rwork(irvt,KIND=${rk}$)
                    ! storing the result in work(ivt), copying to u
                    ! cworkspace: need   2*m [tauq, taup] + m*m [vt]
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + 2*m*m [rwork]
                    call la_${ri}$lacrm(m,m,u,ldu,rwork(iru),m,work(ivt),ldwkvt,rwork( &
                              nrwork))
                    call la_${ri}$lacpy('F',m,m,work(ivt),ldwkvt,u,ldu)
                    ! multiply rwork(irvt) by p**h in a, storing the
                    ! result in work(ivt), copying to a
                    ! cworkspace: need   2*m [tauq, taup] + m*m [vt]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*n [vt]
                    ! rworkspace: need   m [e] + m*m [rvt] + 2*m*m [rwork]
                    ! rworkspace: prefer m [e] + m*m [rvt] + 2*m*n [rwork] < m + 5*m*m since n < 2*m here
                    nrwork = iru
                    do i = 1,n,chunk
                       blk = min(n - i + 1,chunk)
                       call la_${ri}$larcm(m,blk,rwork(irvt),m,a(1,i),lda,work(ivt), &
                                 ldwkvt,rwork(nrwork))
                       call la_${ri}$lacpy('F',m,blk,work(ivt),ldwkvt,a(1,i),lda)

                    end do
                 else if (wntqs) then
                    ! path 5ts (n >> m, jobz='s')
                    ! copy a to u, generate q
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                    call la_${ri}$ungbr('Q',m,m,n,u,ldu,work(itauq),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! copy a to vt, generate p**h
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                    call la_${ri}$ungbr('P',m,n,m,vt,ldvt,work(itaup),work(nwork), &
                              lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + bdspac
                    irvt = nrwork
                    iru = irvt + m*m
                    nrwork = iru + m*m
                    call la_${ci}$bdsdc('L','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! multiply q in u by realmatrix rwork(iru,KIND=${rk}$), storing the
                    ! result in a, copying to u
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + 2*m*m [rwork]
                    call la_${ri}$lacrm(m,m,u,ldu,rwork(iru),m,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',m,m,a,lda,u,ldu)
                    ! multiply realmatrix rwork(irvt,KIND=${rk}$) by p**h in vt,
                    ! storing the result in a, copying to vt
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + 2*m*n [rwork] < m + 5*m*m since n < 2*m here
                    nrwork = iru
                    call la_${ri}$larcm(m,n,rwork(irvt),m,vt,ldvt,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                 else
                    ! path 5ta (n >> m, jobz='a')
                    ! copy a to u, generate q
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('L',m,m,a,lda,u,ldu)
                    call la_${ri}$ungbr('Q',m,m,n,u,ldu,work(itauq),work(nwork),lwork - &
                              nwork + 1,ierr)
                    ! copy a to vt, generate p**h
                    ! cworkspace: need   2*m [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + n*nb [work]
                    ! rworkspace: need   0
                    call la_${ri}$lacpy('U',m,n,a,lda,vt,ldvt)
                    call la_${ri}$ungbr('P',n,n,m,vt,ldvt,work(itaup),work(nwork), &
                              lwork - nwork + 1,ierr)
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + bdspac
                    irvt = nrwork
                    iru = irvt + m*m
                    nrwork = iru + m*m
                    call la_${ci}$bdsdc('L','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! multiply q in u by realmatrix rwork(iru,KIND=${rk}$), storing the
                    ! result in a, copying to u
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + 2*m*m [rwork]
                    call la_${ri}$lacrm(m,m,u,ldu,rwork(iru),m,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',m,m,a,lda,u,ldu)
                    ! multiply realmatrix rwork(irvt,KIND=${rk}$) by p**h in vt,
                    ! storing the result in a, copying to vt
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + 2*m*n [rwork] < m + 5*m*m since n < 2*m here
                    nrwork = iru
                    call la_${ri}$larcm(m,n,rwork(irvt),m,vt,ldvt,a,lda,rwork(nrwork))

                    call la_${ri}$lacpy('F',m,n,a,lda,vt,ldvt)
                 end if
              else
                 ! n < mnthr2
                 ! path 6t (n > m, but not much larger)
                 ! reduce to bidiagonal form without lq decomposition
                 ! use la_${ri}$unmbr to compute singular vectors
                 ie = 1
                 nrwork = ie + m
                 itauq = 1
                 itaup = itauq + m
                 nwork = itaup + m
                 ! bidiagonalize a
                 ! cworkspace: need   2*m [tauq, taup] + n        [work]
                 ! cworkspace: prefer 2*m [tauq, taup] + (m+n)*nb [work]
                 ! rworkspace: need   m [e]
                 call la_${ri}$gebrd(m,n,a,lda,s,rwork(ie),work(itauq),work(itaup), &
                           work(nwork),lwork - nwork + 1,ierr)
                 if (wntqn) then
                    ! path 6tn (n > m, jobz='n')
                    ! compute singular values only
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + bdspac
                    call la_${ci}$bdsdc('L','N',m,s,rwork(ie),dum,1,dum,1,dum,idum,rwork( &
                               nrwork),iwork,info)
                 else if (wntqo) then
                    ! path 6to (n > m, jobz='o')
                    ldwkvt = m
                    ivt = nwork
                    if (lwork >= m*n + 3*m) then
                       ! work( ivt ) is m by n
                       call la_${ri}$laset('F',m,n,czero,czero,work(ivt),ldwkvt)
                       nwork = ivt + ldwkvt*n
                    else
                       ! work( ivt ) is m by chunk
                       chunk = (lwork - 3*m)/m
                       nwork = ivt + ldwkvt*chunk
                    end if
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + bdspac
                    irvt = nrwork
                    iru = irvt + m*m
                    nrwork = iru + m*m
                    call la_${ci}$bdsdc('L','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of a
                    ! cworkspace: need   2*m [tauq, taup] + m*m [vt] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*m [vt] + m*nb [work]
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru]
                    call la_${ri}$lacp2('F',m,m,rwork(iru),m,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    if (lwork >= m*n + 3*m) then
                       ! path 6to-fast
                       ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix work(ivt)
                       ! overwrite work(ivt) by right singular vectors of a,
                       ! copying to a
                       ! cworkspace: need   2*m [tauq, taup] + m*n [vt] + m    [work]
                       ! cworkspace: prefer 2*m [tauq, taup] + m*n [vt] + m*nb [work]
                       ! rworkspace: need   m [e] + m*m [rvt]
                       call la_${ri}$lacp2('F',m,m,rwork(irvt),m,work(ivt),ldwkvt)

                       call la_${ri}$unmbr('P','R','C',m,n,m,a,lda,work(itaup),work( &
                                 ivt),ldwkvt,work(nwork),lwork - nwork + 1,ierr)
                       call la_${ri}$lacpy('F',m,n,work(ivt),ldwkvt,a,lda)
                    else
                       ! path 6to-slow
                       ! generate p**h in a
                       ! cworkspace: need   2*m [tauq, taup] + m*m [vt] + m    [work]
                       ! cworkspace: prefer 2*m [tauq, taup] + m*m [vt] + m*nb [work]
                       ! rworkspace: need   0
                       call la_${ri}$ungbr('P',m,n,m,a,lda,work(itaup),work(nwork), &
                                 lwork - nwork + 1,ierr)
                       ! multiply q in a by realmatrix rwork(iru,KIND=${rk}$), storing the
                       ! result in work(iu), copying to a
                       ! cworkspace: need   2*m [tauq, taup] + m*m [vt]
                       ! cworkspace: prefer 2*m [tauq, taup] + m*n [vt]
                       ! rworkspace: need   m [e] + m*m [rvt] + 2*m*m [rwork]
                       ! rworkspace: prefer m [e] + m*m [rvt] + 2*m*n [rwork] < m + 5*m*m since n < 2*m here
                       nrwork = iru
                       do i = 1,n,chunk
                          blk = min(n - i + 1,chunk)
                          call la_${ri}$larcm(m,blk,rwork(irvt),m,a(1,i),lda,work(ivt) &
                                    ,ldwkvt,rwork(nrwork))
                          call la_${ri}$lacpy('F',m,blk,work(ivt),ldwkvt,a(1,i),lda)

                       end do
                    end if
                 else if (wntqs) then
                    ! path 6ts (n > m, jobz='s')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + bdspac
                    irvt = nrwork
                    iru = irvt + m*m
                    nrwork = iru + m*m
                    call la_${ci}$bdsdc('L','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of a
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru]
                    call la_${ri}$lacp2('F',m,m,rwork(iru),m,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of a
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   m [e] + m*m [rvt]
                    call la_${ri}$laset('F',m,n,czero,czero,vt,ldvt)
                    call la_${ri}$lacp2('F',m,m,rwork(irvt),m,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',m,n,m,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 else
                    ! path 6ta (n > m, jobz='a')
                    ! perform bidiagonal svd, computing left singular vectors
                    ! of bidiagonal matrix in rwork(iru) and computing right
                    ! singular vectors of bidiagonal matrix in rwork(irvt)
                    ! cworkspace: need   0
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru] + bdspac
                    irvt = nrwork
                    iru = irvt + m*m
                    nrwork = iru + m*m
                    call la_${ci}$bdsdc('L','I',m,s,rwork(ie),rwork(iru),m,rwork(irvt) &
                              ,m,dum,idum,rwork(nrwork),iwork,info)
                    ! copy realmatrix rwork(iru,KIND=${rk}$) to complex matrix u
                    ! overwrite u by left singular vectors of a
                    ! cworkspace: need   2*m [tauq, taup] + m    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + m*nb [work]
                    ! rworkspace: need   m [e] + m*m [rvt] + m*m [ru]
                    call la_${ri}$lacp2('F',m,m,rwork(iru),m,u,ldu)
                    call la_${ri}$unmbr('Q','L','N',m,m,n,a,lda,work(itauq),u,ldu, &
                              work(nwork),lwork - nwork + 1,ierr)
                    ! set all of vt to identity matrix
                    call la_${ri}$laset('F',n,n,czero,cone,vt,ldvt)
                    ! copy realmatrix rwork(irvt,KIND=${rk}$) to complex matrix vt
                    ! overwrite vt by right singular vectors of a
                    ! cworkspace: need   2*m [tauq, taup] + n    [work]
                    ! cworkspace: prefer 2*m [tauq, taup] + n*nb [work]
                    ! rworkspace: need   m [e] + m*m [rvt]
                    call la_${ri}$lacp2('F',m,m,rwork(irvt),m,vt,ldvt)
                    call la_${ri}$unmbr('P','R','C',n,n,m,a,lda,work(itaup),vt,ldvt, &
                              work(nwork),lwork - nwork + 1,ierr)
                 end if
              end if
           end if
           ! undo scaling if necessary
           if (iscl == 1) then
              if (anrm > bignum) call la_${ci}$lascl('G',0,0,bignum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (info /= 0 .and. anrm > bignum) call la_${ci}$lascl('G',0,0,bignum,anrm,minmn - 1, &
                         1,rwork(ie),minmn,ierr)
              if (anrm < smlnum) call la_${ci}$lascl('G',0,0,smlnum,anrm,minmn,1,s,minmn, &
                        ierr)
              if (info /= 0 .and. anrm < smlnum) call la_${ci}$lascl('G',0,0,smlnum,anrm,minmn - 1, &
                         1,rwork(ie),minmn,ierr)
           end if
           ! return optimal workspace in work(1)
           work(1) = la_${ci}$roundup_lwork(maxwrk)
           return
     end subroutine la_${ri}$gesdd
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEJSV: computes the singular value decomposition (SVD) of a complex M-by-N
     !> matrix [A], where M >= N. The SVD of [A] is written as
     !> [A] = [U] * [SIGMA] * [V]^*,
     !> where [SIGMA] is an N-by-N (M-by-N) matrix which is zero except for its N
     !> diagonal elements, [U] is an M-by-N (or M-by-M) unitary matrix, and
     !> [V] is an N-by-N unitary matrix. The diagonal elements of [SIGMA] are
     !> the singular values of [A]. The columns of [U] and [V] are the left and
     !> the right singular vectors of [A], respectively. The matrices [U] and [V]
     !> are computed and stored in the arrays U and V, respectively. The diagonal
     !> of [SIGMA] is computed and stored in the array SVA.

     pure subroutine la_${ri}$gejsv(joba,jobu,jobv,jobr,jobt,jobp,m,n,a,lda,sva,u,ldu, &
               v,ldv,cwork,lwork,rwork,lrwork,iwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldu,ldv,lwork,lrwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: u(ldu,*),v(ldv,*),cwork(lwork)
           real(${rk}$),intent(out) :: sva(n),rwork(lrwork)
           integer(ilp),intent(out) :: iwork(*)
           character,intent(in) :: joba,jobp,jobr,jobt,jobu,jobv
        ! ===========================================================================

           ! Local Scalars
           complex(${rk}$) :: ctemp
           real(${rk}$) :: aapp,aaqq,aatmax,aatmin,big,big1,cond_ok,condr1,condr2,entra, &
                     entrat,epsln,maxprj,scalem,sconda,sfmin,small,temp1,uscal1,uscal2,xsc
           integer(ilp) :: ierr,n1,nr,numrank,p,q,warning
           logical(lk) :: almort,defr,errest,goscal,jracc,kill,lquery,lsvec,l2aber, &
                     l2kill,l2pert,l2rank,l2tran,noscal,rowpiv,rsvec,transp
           integer(ilp) :: optwrk,minwrk,minrwrk,miniwrk
           integer(ilp) :: lwcon,lwlqf,lwqp3,lwqrf,lwunmlq,lwunmqr,lwunmqrm,lwsvdj, &
                     lwsvdjv,lrwqp3,lrwcon,lrwsvdj,iwoff
           integer(ilp) :: lwrk_${ri}$gelqf,lwrk_${ri}$geqp3,lwrk_${ri}$geqp3n,lwrk_${ri}$geqrf,lwrk_${ri}$gesvj, &
                     lwrk_${ri}$gesvjv,lwrk_${ri}$gesvju,lwrk_${ri}$unmlq,lwrk_${ri}$unmqr,lwrk_${ri}$unmqrm
           ! Local Arrays
           complex(${rk}$) :: cdummy(1)
           real(${rk}$) :: rdummy(1)
           ! Intrinsic Functions
           intrinsic :: abs,cmplx,conjg,log,max,min,real,nint,sqrt
           ! test the input arguments
           lsvec = la_lsame(jobu,'U') .or. la_lsame(jobu,'F')
           jracc = la_lsame(jobv,'J')
           rsvec = la_lsame(jobv,'V') .or. jracc
           rowpiv = la_lsame(joba,'F') .or. la_lsame(joba,'G')
           l2rank = la_lsame(joba,'R')
           l2aber = la_lsame(joba,'A')
           errest = la_lsame(joba,'E') .or. la_lsame(joba,'G')
           l2tran = la_lsame(jobt,'T') .and. (m == n)
           l2kill = la_lsame(jobr,'R')
           defr = la_lsame(jobr,'N')
           l2pert = la_lsame(jobp,'P')
           lquery = (lwork == -1) .or. (lrwork == -1)
           if (.not. (rowpiv .or. l2rank .or. l2aber .or. errest .or. la_lsame(joba,'C'))) &
                     then
              info = -1
           else if (.not. (lsvec .or. la_lsame(jobu,'N') .or. (la_lsame(jobu,'W') &
                     .and. rsvec .and. l2tran))) then
              info = -2
           else if (.not. (rsvec .or. la_lsame(jobv,'N') .or. (la_lsame(jobv,'W') &
                     .and. lsvec .and. l2tran))) then
              info = -3
           else if (.not. (l2kill .or. defr)) then
              info = -4
           else if (.not. (la_lsame(jobt,'T') .or. la_lsame(jobt,'N'))) then
              info = -5
           else if (.not. (l2pert .or. la_lsame(jobp,'N'))) then
              info = -6
           else if (m < 0) then
              info = -7
           else if ((n < 0) .or. (n > m)) then
              info = -8
           else if (lda < m) then
              info = -10
           else if (lsvec .and. (ldu < m)) then
              info = -13
           else if (rsvec .and. (ldv < n)) then
              info = -15
           else
              ! #:)
              info = 0
           end if
           if (info == 0) then
               ! Compute The Minimal And The Optimal Workspace Lengths
               ! [[the expressions for computing the minimal and the optimal
               ! values of lcwork, lrwork are written with a lot of redundancy and
               ! can be simplified. however, this verbose form is useful for
               ! maintenance and modifications of the code.]]
              ! .. minimal workspace length for la_${ri}$geqp3 of an m x n matrix,
               ! la_${ri}$geqrf of an n x n matrix, la_${ri}$gelqf of an n x n matrix,
               ! la_${ri}$unmlq for computing n x n matrix, la_${ri}$unmqr for computing n x n
               ! matrix, la_${ri}$unmqr for computing m x n matrix, respectively.
               lwqp3 = n + 1
               lwqrf = max(1,n)
               lwlqf = max(1,n)
               lwunmlq = max(1,n)
               lwunmqr = max(1,n)
               lwunmqrm = max(1,m)
              ! Minimal Workspace Length For la_${ri}$pocon Of An N X N Matrix
               lwcon = 2*n
              ! .. minimal workspace length for la_${ri}$gesvj of an n x n matrix,
               ! without and with explicit accumulation of jacobi rotations
               lwsvdj = max(2*n,1)
               lwsvdjv = max(2*n,1)
               ! .. minimal real workspace length for la_${ri}$geqp3, la_${ri}$pocon, la_${ri}$gesvj
               lrwqp3 = 2*n
               lrwcon = n
               lrwsvdj = n
               if (lquery) then
                   call la_${ri}$geqp3(m,n,a,lda,iwork,cdummy,cdummy,-1,rdummy,ierr)

                   lwrk_${ri}$geqp3 = real(cdummy(1),KIND=${rk}$)
                   call la_${ri}$geqrf(n,n,a,lda,cdummy,cdummy,-1,ierr)
                   lwrk_${ri}$geqrf = real(cdummy(1),KIND=${rk}$)
                   call la_${ri}$gelqf(n,n,a,lda,cdummy,cdummy,-1,ierr)
                   lwrk_${ri}$gelqf = real(cdummy(1),KIND=${rk}$)
               end if
               minwrk = 2
               optwrk = 2
               miniwrk = n
               if (.not. (lsvec .or. rsvec)) then
                   ! Minimal And Optimal Sizes Of The Complex Workspace If
                   ! only the singular values are requested
                   if (errest) then
                       minwrk = max(n + lwqp3,n**2 + lwcon,n + lwqrf,lwsvdj)
                   else
                       minwrk = max(n + lwqp3,n + lwqrf,lwsvdj)
                   end if
                   if (lquery) then
                       call la_${ri}$gesvj('L','N','N',n,n,a,lda,sva,n,v,ldv,cdummy,-1, &
                                  rdummy,-1,ierr)
                       lwrk_${ri}$gesvj = real(cdummy(1),KIND=${rk}$)
                       if (errest) then
                           optwrk = max(n + lwrk_${ri}$geqp3,n**2 + lwcon,n + lwrk_${ri}$geqrf,lwrk_${ri}$gesvj)

                       else
                           optwrk = max(n + lwrk_${ri}$geqp3,n + lwrk_${ri}$geqrf,lwrk_${ri}$gesvj)
                       end if
                   end if
                   if (l2tran .or. rowpiv) then
                       if (errest) then
                          minrwrk = max(7,2*m,lrwqp3,lrwcon,lrwsvdj)
                       else
                          minrwrk = max(7,2*m,lrwqp3,lrwsvdj)
                       end if
                   else
                       if (errest) then
                          minrwrk = max(7,lrwqp3,lrwcon,lrwsvdj)
                       else
                          minrwrk = max(7,lrwqp3,lrwsvdj)
                       end if
                   end if
                   if (rowpiv .or. l2tran) miniwrk = miniwrk + m
               else if (rsvec .and. (.not. lsvec)) then
                  ! Minimal And Optimal Sizes Of The Complex Workspace If The
                  ! singular values and the right singular vectors are requested
                  if (errest) then
                      minwrk = max(n + lwqp3,lwcon,lwsvdj,n + lwlqf,2*n + lwqrf,n + lwsvdj,n + &
                                lwunmlq)
                  else
                      minwrk = max(n + lwqp3,lwsvdj,n + lwlqf,2*n + lwqrf,n + lwsvdj,n + lwunmlq)

                  end if
                  if (lquery) then
                      call la_${ri}$gesvj('L','U','N',n,n,u,ldu,sva,n,a,lda,cdummy,-1, &
                                rdummy,-1,ierr)
                      lwrk_${ri}$gesvj = real(cdummy(1),KIND=${rk}$)
                      call la_${ri}$unmlq('L','C',n,n,n,a,lda,cdummy,v,ldv,cdummy,-1, &
                                ierr)
                      lwrk_${ri}$unmlq = real(cdummy(1),KIND=${rk}$)
                      if (errest) then
                      optwrk = max(n + lwrk_${ri}$geqp3,lwcon,lwrk_${ri}$gesvj,n + lwrk_${ri}$gelqf,2*n + &
                                lwrk_${ri}$geqrf,n + lwrk_${ri}$gesvj,n + lwrk_${ri}$unmlq)
                      else
                      optwrk = max(n + lwrk_${ri}$geqp3,lwrk_${ri}$gesvj,n + lwrk_${ri}$gelqf,2*n + lwrk_${ri}$geqrf,n + &
                                lwrk_${ri}$gesvj,n + lwrk_${ri}$unmlq)
                      end if
                  end if
                  if (l2tran .or. rowpiv) then
                       if (errest) then
                          minrwrk = max(7,2*m,lrwqp3,lrwsvdj,lrwcon)
                       else
                          minrwrk = max(7,2*m,lrwqp3,lrwsvdj)
                       end if
                  else
                       if (errest) then
                          minrwrk = max(7,lrwqp3,lrwsvdj,lrwcon)
                       else
                          minrwrk = max(7,lrwqp3,lrwsvdj)
                       end if
                  end if
                  if (rowpiv .or. l2tran) miniwrk = miniwrk + m
               else if (lsvec .and. (.not. rsvec)) then
                  ! Minimal And Optimal Sizes Of The Complex Workspace If The
                  ! singular values and the left singular vectors are requested
                  if (errest) then
                      minwrk = n + max(lwqp3,lwcon,n + lwqrf,lwsvdj,lwunmqrm)
                  else
                      minwrk = n + max(lwqp3,n + lwqrf,lwsvdj,lwunmqrm)
                  end if
                  if (lquery) then
                      call la_${ri}$gesvj('L','U','N',n,n,u,ldu,sva,n,a,lda,cdummy,-1, &
                                rdummy,-1,ierr)
                      lwrk_${ri}$gesvj = real(cdummy(1),KIND=${rk}$)
                      call la_${ri}$unmqr('L','N',m,n,n,a,lda,cdummy,u,ldu,cdummy,-1, &
                                ierr)
                      lwrk_${ri}$unmqrm = real(cdummy(1),KIND=${rk}$)
                      if (errest) then
                      optwrk = n + max(lwrk_${ri}$geqp3,lwcon,n + lwrk_${ri}$geqrf,lwrk_${ri}$gesvj, &
                                lwrk_${ri}$unmqrm)
                      else
                      optwrk = n + max(lwrk_${ri}$geqp3,n + lwrk_${ri}$geqrf,lwrk_${ri}$gesvj,lwrk_${ri}$unmqrm)

                      end if
                  end if
                  if (l2tran .or. rowpiv) then
                      if (errest) then
                         minrwrk = max(7,2*m,lrwqp3,lrwsvdj,lrwcon)
                      else
                         minrwrk = max(7,2*m,lrwqp3,lrwsvdj)
                      end if
                  else
                      if (errest) then
                         minrwrk = max(7,lrwqp3,lrwsvdj,lrwcon)
                      else
                         minrwrk = max(7,lrwqp3,lrwsvdj)
                      end if
                  end if
                  if (rowpiv .or. l2tran) miniwrk = miniwrk + m
               else
                  ! Minimal And Optimal Sizes Of The Complex Workspace If The
                  ! full svd is requested
                  if (.not. jracc) then
                      if (errest) then
                         minwrk = max(n + lwqp3,n + lwcon,2*n + n**2 + lwcon,2*n + lwqrf,2*n + &
                         lwqp3,2*n + n**2 + n + lwlqf,2*n + n**2 + n + n**2 + lwcon,2*n + n**2 + n + lwsvdj,2*n + &
                         n**2 + n + lwsvdjv,2*n + n**2 + n + lwunmqr,2*n + n**2 + n + lwunmlq,n + n**2 + lwsvdj,n + &
                                   lwunmqrm)
                      else
                         minwrk = max(n + lwqp3,2*n + n**2 + lwcon,2*n + lwqrf,2*n + &
                         lwqp3,2*n + n**2 + n + lwlqf,2*n + n**2 + n + n**2 + lwcon,2*n + n**2 + n + lwsvdj,2*n + &
                         n**2 + n + lwsvdjv,2*n + n**2 + n + lwunmqr,2*n + n**2 + n + lwunmlq,n + n**2 + lwsvdj, &
                                   n + lwunmqrm)
                      end if
                      miniwrk = miniwrk + n
                      if (rowpiv .or. l2tran) miniwrk = miniwrk + m
                  else
                      if (errest) then
                         minwrk = max(n + lwqp3,n + lwcon,2*n + lwqrf,2*n + n**2 + lwsvdjv,2*n + n**2 + n + &
                                   lwunmqr,n + lwunmqrm)
                      else
                         minwrk = max(n + lwqp3,2*n + lwqrf,2*n + n**2 + lwsvdjv,2*n + n**2 + n + lwunmqr,n + &
                                   lwunmqrm)
                      end if
                      if (rowpiv .or. l2tran) miniwrk = miniwrk + m
                  end if
                  if (lquery) then
                      call la_${ri}$unmqr('L','N',m,n,n,a,lda,cdummy,u,ldu,cdummy,-1, &
                                ierr)
                      lwrk_${ri}$unmqrm = real(cdummy(1),KIND=${rk}$)
                      call la_${ri}$unmqr('L','N',n,n,n,a,lda,cdummy,u,ldu,cdummy,-1, &
                                ierr)
                      lwrk_${ri}$unmqr = real(cdummy(1),KIND=${rk}$)
                      if (.not. jracc) then
                          call la_${ri}$geqp3(n,n,a,lda,iwork,cdummy,cdummy,-1,rdummy,ierr)

                          lwrk_${ri}$geqp3n = real(cdummy(1),KIND=${rk}$)
                          call la_${ri}$gesvj('L','U','N',n,n,u,ldu,sva,n,v,ldv,cdummy, &
                                    -1,rdummy,-1,ierr)
                          lwrk_${ri}$gesvj = real(cdummy(1),KIND=${rk}$)
                          call la_${ri}$gesvj('U','U','N',n,n,u,ldu,sva,n,v,ldv,cdummy, &
                                    -1,rdummy,-1,ierr)
                          lwrk_${ri}$gesvju = real(cdummy(1),KIND=${rk}$)
                          call la_${ri}$gesvj('L','U','V',n,n,u,ldu,sva,n,v,ldv,cdummy, &
                                    -1,rdummy,-1,ierr)
                          lwrk_${ri}$gesvjv = real(cdummy(1),KIND=${rk}$)
                          call la_${ri}$unmlq('L','C',n,n,n,a,lda,cdummy,v,ldv,cdummy,- &
                                    1,ierr)
                          lwrk_${ri}$unmlq = real(cdummy(1),KIND=${rk}$)
                          if (errest) then
                            optwrk = max(n + lwrk_${ri}$geqp3,n + lwcon,2*n + n**2 + lwcon,2*n + lwrk_${ri}$geqrf, &
                            2*n + lwrk_${ri}$geqp3n,2*n + n**2 + n + lwrk_${ri}$gelqf,2*n + n**2 + n + n**2 + lwcon,2*n + &
                            n**2 + n + lwrk_${ri}$gesvj,2*n + n**2 + n + lwrk_${ri}$gesvjv,2*n + n**2 + n + lwrk_${ri}$unmqr,2*n + &
                                      n**2 + n + lwrk_${ri}$unmlq,n + n**2 + lwrk_${ri}$gesvju,n + lwrk_${ri}$unmqrm)
                          else
                            optwrk = max(n + lwrk_${ri}$geqp3,2*n + n**2 + lwcon,2*n + lwrk_${ri}$geqrf,2*n + &
                            lwrk_${ri}$geqp3n,2*n + n**2 + n + lwrk_${ri}$gelqf,2*n + n**2 + n + n**2 + lwcon,2*n + n**2 + n + &
                            lwrk_${ri}$gesvj,2*n + n**2 + n + lwrk_${ri}$gesvjv,2*n + n**2 + n + lwrk_${ri}$unmqr,2*n + n**2 + n + &
                                      lwrk_${ri}$unmlq,n + n**2 + lwrk_${ri}$gesvju,n + lwrk_${ri}$unmqrm)
                          end if
                      else
                          call la_${ri}$gesvj('L','U','V',n,n,u,ldu,sva,n,v,ldv,cdummy, &
                                    -1,rdummy,-1,ierr)
                          lwrk_${ri}$gesvjv = real(cdummy(1),KIND=${rk}$)
                          call la_${ri}$unmqr('L','N',n,n,n,cdummy,n,cdummy,v,ldv,cdummy, &
                                     -1,ierr)
                          lwrk_${ri}$unmqr = real(cdummy(1),KIND=${rk}$)
                          call la_${ri}$unmqr('L','N',m,n,n,a,lda,cdummy,u,ldu,cdummy,- &
                                    1,ierr)
                          lwrk_${ri}$unmqrm = real(cdummy(1),KIND=${rk}$)
                          if (errest) then
                             optwrk = max(n + lwrk_${ri}$geqp3,n + lwcon,2*n + lwrk_${ri}$geqrf,2*n + n**2,2*n + &
                                       n**2 + lwrk_${ri}$gesvjv,2*n + n**2 + n + lwrk_${ri}$unmqr,n + lwrk_${ri}$unmqrm)
                          else
                             optwrk = max(n + lwrk_${ri}$geqp3,2*n + lwrk_${ri}$geqrf,2*n + n**2,2*n + n**2 + &
                                       lwrk_${ri}$gesvjv,2*n + n**2 + n + lwrk_${ri}$unmqr,n + lwrk_${ri}$unmqrm)
                          end if
                      end if
                  end if
                  if (l2tran .or. rowpiv) then
                      minrwrk = max(7,2*m,lrwqp3,lrwsvdj,lrwcon)
                  else
                      minrwrk = max(7,lrwqp3,lrwsvdj,lrwcon)
                  end if
               end if
               minwrk = max(2,minwrk)
#:if rk == "sp"
               optwrk = max(optwrk,minwrk)
#:else
               optwrk = max(minwrk,optwrk)
#:endif
               if (lwork < minwrk .and. (.not. lquery)) info = -17
               if (lrwork < minrwrk .and. (.not. lquery)) info = -19
           end if
           if (info /= 0) then
             ! #:(
              call la_xerbla('${ri.upper()}$GEJSV',-info)
              return
           else if (lquery) then
               cwork(1) = optwrk
               cwork(2) = minwrk
               rwork(1) = minrwrk
               iwork(1) = max(4,miniwrk)
               return
           end if
           ! quick return for void matrix (y3k safe)
       ! #:)
           if ((m == 0) .or. (n == 0)) then
              iwork(1:4) = 0
              rwork(1:7) = 0
              return
           end if
           ! determine whether the matrix u should be m x n or m x m
           if (lsvec) then
              n1 = n
              if (la_lsame(jobu,'F')) n1 = m
           end if
           ! set numerical parameters
      ! !    note: make sure la_${ci}$lamch() does not fail on the target architecture.
           epsln = la_${ci}$lamch('EPSILON')
           sfmin = la_${ci}$lamch('SAFEMINIMUM')
           small = sfmin/epsln
           big = la_${ci}$lamch('O')
           ! big   = one / sfmin
           ! initialize sva(1:n) = diag( ||a e_i||_2 )_1^n
      ! (!)  if necessary, scale sva() to protect the largest norm from
           ! overflow. it is possible that this scaling pushes the smallest
           ! column norm left from the underflow threshold (extreme case).
           scalem = one/sqrt(real(m,KIND=${rk}$)*real(n,KIND=${rk}$))
           noscal = .true.
           goscal = .true.
           do p = 1,n
              aapp = zero
              aaqq = one
              call la_${ri}$lassq(m,a(1,p),1,aapp,aaqq)
              if (aapp > big) then
                 info = -9
                 call la_xerbla('${ri.upper()}$GEJSV',-info)
                 return
              end if
              aaqq = sqrt(aaqq)
              if ((aapp < (big/aaqq)) .and. noscal) then
                 sva(p) = aapp*aaqq
              else
                 noscal = .false.
                 sva(p) = aapp*(aaqq*scalem)
                 if (goscal) then
                    goscal = .false.
                    call la_${ci}$scal(p - 1,scalem,sva,1)
                 end if
              end if
           end do
           if (noscal) scalem = one
           aapp = zero
           aaqq = big
           do p = 1,n
              aapp = max(aapp,sva(p))
              if (sva(p) /= zero) aaqq = min(aaqq,sva(p))
           end do
           ! quick return for zero m x n matrix
       ! #:)
           if (aapp == zero) then
              if (lsvec) call la_${ri}$laset('G',m,n1,czero,cone,u,ldu)
              if (rsvec) call la_${ri}$laset('G',n,n,czero,cone,v,ldv)
              rwork(1) = one
              rwork(2) = one
              if (errest) rwork(3) = one
              if (lsvec .and. rsvec) then
                 rwork(4) = one
                 rwork(5) = one
              end if
              if (l2tran) then
                 rwork(6) = zero
                 rwork(7) = zero
              end if
              iwork(1) = 0
              iwork(2) = 0
              iwork(3) = 0
              iwork(4) = -1
              return
           end if
           ! issue warning if denormalized column norms detected. override the
           ! high relative accuracy request. issue licence to kill nonzero columns
           ! (set them to zero) whose norm is less than sigma_max / big (roughly).
       ! #:(
           warning = 0
           if (aaqq <= sfmin) then
              l2rank = .true.
              l2kill = .true.
              warning = 1
           end if
           ! quick return for one-column matrix
       ! #:)
           if (n == 1) then
              if (lsvec) then
                 call la_${ri}$lascl('G',0,0,sva(1),scalem,m,1,a(1,1),lda,ierr)
                 call la_${ri}$lacpy('A',m,1,a,lda,u,ldu)
                 ! computing all m left singular vectors of the m x 1 matrix
                 if (n1 /= n) then
                   call la_${ri}$geqrf(m,n,u,ldu,cwork,cwork(n + 1),lwork - n,ierr)
                   call la_${ri}$ungqr(m,n1,1,u,ldu,cwork,cwork(n + 1),lwork - n,ierr)
                   call la_${ri}$copy(m,a(1,1),1,u(1,1),1)
                 end if
              end if
              if (rsvec) then
                  v(1,1) = cone
              end if
              if (sva(1) < (big*scalem)) then
                 sva(1) = sva(1)/scalem
                 scalem = one
              end if
              rwork(1) = one/scalem
              rwork(2) = one
              if (sva(1) /= zero) then
                 iwork(1) = 1
                 if ((sva(1)/scalem) >= sfmin) then
                    iwork(2) = 1
                 else
                    iwork(2) = 0
                 end if
              else
                 iwork(1) = 0
                 iwork(2) = 0
              end if
              iwork(3) = 0
              iwork(4) = -1
              if (errest) rwork(3) = one
              if (lsvec .and. rsvec) then
                 rwork(4) = one
                 rwork(5) = one
              end if
              if (l2tran) then
                 rwork(6) = zero
                 rwork(7) = zero
              end if
              return
           end if
           transp = .false.
           aatmax = -one
           aatmin = big
           if (rowpiv .or. l2tran) then
           ! compute the row norms, needed to determine row pivoting sequence
           ! (in the case of heavily row weighted a, row pivoting is strongly
           ! advised) and to collect information needed to compare the
           ! structures of a * a^* and a^* * a (in the case l2tran==.true.).
              if (l2tran) then
                 do p = 1,m
                    xsc = zero
                    temp1 = one
                    call la_${ri}$lassq(n,a(p,1),lda,xsc,temp1)
                    ! la_${ri}$lassq gets both the ell_2 and the ell_infinity norm
                    ! in one pass through the vector
                    rwork(m + p) = xsc*scalem
                    rwork(p) = xsc*(scalem*sqrt(temp1))
                    aatmax = max(aatmax,rwork(p))
                    if (rwork(p) /= zero) aatmin = min(aatmin,rwork(p))
                 end do
              else
                 do p = 1,m
                    rwork(m + p) = scalem*abs(a(p,la_i${ri}$amax(n,a(p,1),lda)))
                    aatmax = max(aatmax,rwork(m + p))
                    aatmin = min(aatmin,rwork(m + p))
                 end do
              end if
           end if
           ! for square matrix a try to determine whether a^*  would be better
           ! input for the preconditioned jacobi svd, with faster convergence.
           ! the decision is based on an o(n) function of the vector of column
           ! and row norms of a, based on the shannon entropy. this should give
           ! the right choice in most cases when the difference actually matters.
           ! it may fail and pick the slower converging side.
           entra = zero
           entrat = zero
           if (l2tran) then
              xsc = zero
              temp1 = one
              call la_${ci}$lassq(n,sva,1,xsc,temp1)
              temp1 = one/temp1
              entra = zero
              do p = 1,n
                 big1 = ((sva(p)/xsc)**2)*temp1
                 if (big1 /= zero) entra = entra + big1*log(big1)
              end do
              entra = -entra/log(real(n,KIND=${rk}$))
              ! now, sva().^2/trace(a^* * a) is a point in the probability simplex.
              ! it is derived from the diagonal of  a^* * a.  do the same with the
              ! diagonal of a * a^*, compute the entropy of the corresponding
              ! probability distribution. note that a * a^* and a^* * a have the
              ! same trace.
              entrat = zero
              do p = 1,m
                 big1 = ((rwork(p)/xsc)**2)*temp1
                 if (big1 /= zero) entrat = entrat + big1*log(big1)
              end do
              entrat = -entrat/log(real(m,KIND=${rk}$))
              ! analyze the entropies and decide a or a^*. smaller entropy
              ! usually means better input for the algorithm.
              transp = (entrat < entra)
              ! if a^* is better than a, take the adjoint of a. this is allowed
              ! only for square matrices, m=n.
              if (transp) then
                 ! in an optimal implementation, this trivial transpose
                 ! should be replaced with faster transpose.
                 do p = 1,n - 1
                    a(p,p) = conjg(a(p,p))
                    do q = p + 1,n
                        ctemp = conjg(a(q,p))
                       a(q,p) = conjg(a(p,q))
                       a(p,q) = ctemp
                    end do
                 end do
                 a(n,n) = conjg(a(n,n))
                 do p = 1,n
                    rwork(m + p) = sva(p)
                    sva(p) = rwork(p)
                    ! previously computed row 2-norms are now column 2-norms
                    ! of the transposed matrix
                 end do
                 temp1 = aapp
                 aapp = aatmax
                 aatmax = temp1
                 temp1 = aaqq
                 aaqq = aatmin
                 aatmin = temp1
                 kill = lsvec
                 lsvec = rsvec
                 rsvec = kill
                 if (lsvec) n1 = n
                 rowpiv = .true.
              end if
           end if
           ! end if l2tran
           ! scale the matrix so that its maximal singular value remains less
           ! than sqrt(big) -- the matrix is scaled so that its maximal column
           ! has euclidean norm equal to sqrt(big/n). the only reason to keep
           ! sqrt(big) instead of big is the fact that la_${ri}$gejsv uses lapack and
           ! blas routines that, in some implementations, are not capable of
           ! working in the full interval [sfmin,big] and that they may provoke
           ! overflows in the intermediate results. if the singular values spread
           ! from sfmin to big, then la_${ri}$gesvj will compute them. so, in that case,
           ! one should use la_${ri}$gesvj instead of la_${ri}$gejsv.
#:if rk != "sp"
           ! >> change in the april 2016 update: allow bigger range, i.e. the
           ! largest column is allowed up to big/n and la_${ri}$gesvj will do the rest.
#:endif
           big1 = sqrt(big)
           temp1 = sqrt(big/real(n,KIND=${rk}$))
#:if rk == "sp"
           ! >> for future updates: allow bigger range, i.e. the largest column
           ! will be allowed up to big/n and la_${ri}$gesvj will do the rest. however, for
           ! this all other (lapack) components must allow such a range.
#:endif
            ! temp1  = big/real(n,KIND=${rk}$)
#:if rk == "sp"
           ! temp1  = big * epsln  this should 'almost' work with current lapack components
#:endif
           call la_${ci}$lascl('G',0,0,aapp,temp1,n,1,sva,n,ierr)
           if (aaqq > (aapp*sfmin)) then
               aaqq = (aaqq/aapp)*temp1
           else
               aaqq = (aaqq*temp1)/aapp
           end if
           temp1 = temp1*scalem
           call la_${ri}$lascl('G',0,0,aapp,temp1,m,n,a,lda,ierr)
           ! to undo scaling at the end of this procedure, multiply the
           ! computed singular values with uscal2 / uscal1.
           uscal1 = temp1
           uscal2 = aapp
           if (l2kill) then
              ! l2kill enforces computation of nonzero singular values in
              ! the restricted range of condition number of the initial a,
              ! sigma_max(a) / sigma_min(a) approx. sqrt(big)/sqrt(sfmin).
              xsc = sqrt(sfmin)
           else
              xsc = small
              ! now, if the condition number of a is too big,
              ! sigma_max(a) / sigma_min(a) > sqrt(big/n) * epsln / sfmin,
              ! as a precaution measure, the full svd is computed using la_${ri}$gesvj
              ! with accumulated jacobi rotations. this provides numerically
              ! more robust computation, at the cost of slightly increased run
              ! time. depending on the concrete implementation of blas and lapack
              ! (i.e. how they behave in presence of extreme ill-conditioning) the
              ! implementor may decide to remove this switch.
              if ((aaqq < sqrt(sfmin)) .and. lsvec .and. rsvec) then
                 jracc = .true.
              end if
           end if
           if (aaqq < xsc) then
              do p = 1,n
                 if (sva(p) < xsc) then
                    call la_${ri}$laset('A',m,1,czero,czero,a(1,p),lda)
                    sva(p) = zero
                 end if
              end do
           end if
           ! preconditioning using qr factorization with pivoting
           if (rowpiv) then
              ! optional row permutation (bjoerck row pivoting):
              ! a result by cox and higham shows that the bjoerck's
              ! row pivoting combined with standard column pivoting
              ! has similar effect as powell-reid complete pivoting.
              ! the ell-infinity norms of a are made nonincreasing.
              if ((lsvec .and. rsvec) .and. .not. (jracc)) then
                   iwoff = 2*n
              else
                   iwoff = n
              end if
              do p = 1,m - 1
                 q = la_i${ci}$amax(m - p + 1,rwork(m + p),1) + p - 1
                 iwork(iwoff + p) = q
                 if (p /= q) then
                    temp1 = rwork(m + p)
                    rwork(m + p) = rwork(m + q)
                    rwork(m + q) = temp1
                 end if
              end do
              call la_${ri}$laswp(n,a,lda,1,m - 1,iwork(iwoff + 1),1)
           end if
           ! end of the preparation phase (scaling, optional sorting and
           ! transposing, optional flushing of small columns).
           ! preconditioning
           ! if the full svd is needed, the right singular vectors are computed
           ! from a matrix equation, and for that we need theoretical analysis
           ! of the businger-golub pivoting. so we use la_${ri}$geqp3 as the first rr qrf.
           ! in all other cases the first rr qrf can be chosen by other criteria
           ! (eg speed by replacing global with restricted window pivoting, such
           ! as in xgeqpx from toms # 782). good results will be obtained using
           ! xgeqpx with properly (!) chosen numerical parameters.
           ! any improvement of la_${ri}$geqp3 improves overall performance of la_${ri}$gejsv.
           ! a * p1 = q1 * [ r1^* 0]^*:
           do p = 1,n
              ! All Columns Are Free Columns
              iwork(p) = 0
           end do
           call la_${ri}$geqp3(m,n,a,lda,iwork,cwork,cwork(n + 1),lwork - n,rwork,ierr)

           ! the upper triangular matrix r1 from the first qrf is inspected for
           ! rank deficiency and possibilities for deflation, or possible
           ! ill-conditioning. depending on the user specified flag l2rank,
           ! the procedure explores possibilities to reduce the numerical
           ! rank by inspecting the computed upper triangular factor. if
           ! l2rank or l2aber are up, then la_${ri}$gejsv will compute the svd of
           ! a + da, where ||da|| <= f(m,n)*epsln.
           nr = 1
           if (l2aber) then
              ! standard absolute error bound suffices. all sigma_i with
              ! sigma_i < n*epsln*||a|| are flushed to zero. this is an
              ! aggressive enforcement of lower numerical rank by introducing a
              ! backward error of the order of n*epsln*||a||.
              temp1 = sqrt(real(n,KIND=${rk}$))*epsln
              do p = 2,n
                 if (abs(a(p,p)) >= (temp1*abs(a(1,1)))) then
                    nr = nr + 1
                 else
                    go to 3002
                 end if
              end do
              3002 continue
           else if (l2rank) then
              ! .. similarly as above, only slightly more gentle (less aggressive).
              ! sudden drop on the diagonal of r1 is used as the criterion for
              ! close-to-rank-deficient.
              temp1 = sqrt(sfmin)
              do p = 2,n
                 if ((abs(a(p,p)) < (epsln*abs(a(p - 1,p - 1)))) .or. (abs(a(p,p)) < small) .or. ( &
                           l2kill .and. (abs(a(p,p)) < temp1))) go to 3402
                 nr = nr + 1
              end do
              3402 continue
           else
              ! the goal is high relative accuracy. however, if the matrix
              ! has high scaled condition number the relative accuracy is in
              ! general not feasible. later on, a condition number estimator
              ! will be deployed to estimate the scaled condition number.
              ! here we just remove the underflowed part of the triangular
              ! factor. this prevents the situation in which the code is
              ! working hard to get the accuracy not warranted by the data.
              temp1 = sqrt(sfmin)
              do p = 2,n
                 if ((abs(a(p,p)) < small) .or. (l2kill .and. (abs(a(p,p)) < temp1))) go to &
                           3302
                 nr = nr + 1
              end do
              3302 continue
           end if
           almort = .false.
           if (nr == n) then
              maxprj = one
              do p = 2,n
                 temp1 = abs(a(p,p))/sva(iwork(p))
                 maxprj = min(maxprj,temp1)
              end do
              if (maxprj**2 >= one - real(n,KIND=${rk}$)*epsln) almort = .true.
           end if
           sconda = -one
           condr1 = -one
           condr2 = -one
           if (errest) then
              if (n == nr) then
                 if (rsvec) then
                    ! V Is Available As Workspace
                    call la_${ri}$lacpy('U',n,n,a,lda,v,ldv)
                    do p = 1,n
                       temp1 = sva(iwork(p))
                       call la_${ri}$${ci}$scal(p,one/temp1,v(1,p),1)
                    end do
                    if (lsvec) then
                        call la_${ri}$pocon('U',n,v,ldv,one,temp1,cwork(n + 1),rwork,ierr)

                    else
                        call la_${ri}$pocon('U',n,v,ldv,one,temp1,cwork,rwork,ierr)

                    end if
                 else if (lsvec) then
                    ! U Is Available As Workspace
                    call la_${ri}$lacpy('U',n,n,a,lda,u,ldu)
                    do p = 1,n
                       temp1 = sva(iwork(p))
                       call la_${ri}$${ci}$scal(p,one/temp1,u(1,p),1)
                    end do
                    call la_${ri}$pocon('U',n,u,ldu,one,temp1,cwork(n + 1),rwork,ierr)

                 else
                    call la_${ri}$lacpy('U',n,n,a,lda,cwork,n)
      ! []            call la_${ri}$lacpy( 'u', n, n, a, lda, cwork(n+1), n )
                    ! change: here index shifted by n to the left, cwork(1:n)
                    ! not needed for sigma only computation
                    do p = 1,n
                       temp1 = sva(iwork(p))
      ! []               call la_${ri}$${ci}$scal( p, one/temp1, cwork(n+(p-1)*n+1), 1 )
                       call la_${ri}$${ci}$scal(p,one/temp1,cwork((p - 1)*n + 1),1)
                    end do
                 ! The Columns Of R Are Scaled To Have Unit Euclidean Lengths
      ! []               call la_${ri}$pocon( 'u', n, cwork(n+1), n, one, temp1,
      ! []     $              cwork(n+n*n+1), rwork, ierr )
                    call la_${ri}$pocon('U',n,cwork,n,one,temp1,cwork(n*n + 1),rwork,ierr)

                 end if
                 if (temp1 /= zero) then
                    sconda = one/sqrt(temp1)
                 else
                    sconda = -one
                 end if
                 ! sconda is an estimate of sqrt(||(r^* * r)^(-1)||_1).
                 ! n^(-1/4) * sconda <= ||r^(-1)||_2 <= n^(1/4) * sconda
              else
                 sconda = -one
              end if
           end if
           l2pert = l2pert .and. (abs(a(1,1)/a(nr,nr)) > sqrt(big1))
           ! if there is no violent scaling, artificial perturbation is not needed.
           ! phase 3:
           if (.not. (rsvec .or. lsvec)) then
               ! singular values only
               ! .. transpose a(1:nr,1:n)
              do p = 1,min(n - 1,nr)
                 call la_${ri}$copy(n - p,a(p,p + 1),lda,a(p + 1,p),1)
                 call la_${ri}$lacgv(n - p + 1,a(p,p),1)
              end do
              if (nr == n) a(n,n) = conjg(a(n,n))
              ! the following two do-loops introduce small relative perturbation
              ! into the strict upper triangle of the lower triangular matrix.
              ! small entries below the main diagonal are also changed.
              ! this modification is useful if the computing environment does not
              ! provide/allow flush to zero underflow, for it prevents many
              ! annoying denormalized numbers in case of strongly scaled matrices.
              ! the perturbation is structured so that it does not introduce any
              ! new perturbation of the singular values, and it does not destroy
              ! the job done by the preconditioner.
              ! the licence for this perturbation is in the variable l2pert, which
              ! should be .false. if flush to zero underflow is active.
              if (.not. almort) then
                 if (l2pert) then
                    ! xsc = sqrt(small)
                    xsc = epsln/real(n,KIND=${rk}$)
                    do q = 1,nr
                       ctemp = cmplx(xsc*abs(a(q,q)),zero,KIND=${rk}$)
                       do p = 1,n
                          if (((p > q) .and. (abs(a(p,q)) <= temp1)) .or. (p < q)) a(p,q) = &
                                    ctemp
           ! $                     a(p,q) = temp1 * ( a(p,q) / abs(a(p,q)) )
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,a(1,2),lda)
                 end if
                  ! Second Preconditioning Using The Qr Factorization
                 call la_${ri}$geqrf(n,nr,a,lda,cwork,cwork(n + 1),lwork - n,ierr)
                 ! And Transpose Upper To Lower Triangular
                 do p = 1,nr - 1
                    call la_${ri}$copy(nr - p,a(p,p + 1),lda,a(p + 1,p),1)
                    call la_${ri}$lacgv(nr - p + 1,a(p,p),1)
                 end do
           end if
                 ! row-cyclic jacobi svd algorithm with column pivoting
                 ! .. again some perturbation (a "background noise") is added
                 ! to drown denormals
                 if (l2pert) then
                    ! xsc = sqrt(small)
                    xsc = epsln/real(n,KIND=${rk}$)
                    do q = 1,nr
                       ctemp = cmplx(xsc*abs(a(q,q)),zero,KIND=${rk}$)
                       do p = 1,nr
                          if (((p > q) .and. (abs(a(p,q)) <= temp1)) .or. (p < q)) a(p,q) = &
                                    ctemp
           ! $                   a(p,q) = temp1 * ( a(p,q) / abs(a(p,q)) )
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,a(1,2),lda)
                 end if
                 ! .. and one-sided jacobi rotations are started on a lower
                 ! triangular matrix (plus perturbation which is ignored in
                 ! the part which destroys triangular form (confusing?!))
                 call la_${ri}$gesvj('L','N','N',nr,nr,a,lda,sva,n,v,ldv,cwork,lwork, &
                           rwork,lrwork,info)
                 scalem = rwork(1)
                 numrank = nint(rwork(2),KIND=ilp)
           else if ((rsvec .and. (.not. lsvec) .and. (.not. jracc)) .or. (jracc .and. ( &
                     .not. lsvec) .and. (nr /= n))) then
              ! -> singular values and right singular vectors <-
              if (almort) then
                 ! In This Case Nr Equals N
                 do p = 1,nr
                    call la_${ri}$copy(n - p + 1,a(p,p),lda,v(p,p),1)
                    call la_${ri}$lacgv(n - p + 1,v(p,p),1)
                 end do
                 call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
                 call la_${ri}$gesvj('L','U','N',n,nr,v,ldv,sva,nr,a,lda,cwork,lwork, &
                           rwork,lrwork,info)
                 scalem = rwork(1)
                 numrank = nint(rwork(2),KIND=ilp)
              else
              ! .. two more qr factorizations ( one qrf is not enough, two require
              ! accumulated product of jacobi rotations, three are perfect )
                 call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,a(2,1),lda)
                 call la_${ri}$gelqf(nr,n,a,lda,cwork,cwork(n + 1),lwork - n,ierr)
                 call la_${ri}$lacpy('L',nr,nr,a,lda,v,ldv)
                 call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
                 call la_${ri}$geqrf(nr,nr,v,ldv,cwork(n + 1),cwork(2*n + 1),lwork - 2*n,ierr)

                 do p = 1,nr
                    call la_${ri}$copy(nr - p + 1,v(p,p),ldv,v(p,p),1)
                    call la_${ri}$lacgv(nr - p + 1,v(p,p),1)
                 end do
                 call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
                 call la_${ri}$gesvj('L','U','N',nr,nr,v,ldv,sva,nr,u,ldu,cwork(n + 1), &
                           lwork - n,rwork,lrwork,info)
                 scalem = rwork(1)
                 numrank = nint(rwork(2),KIND=ilp)
                 if (nr < n) then
                    call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                    call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                    call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
                 end if
              call la_${ri}$unmlq('L','C',n,n,nr,a,lda,cwork,v,ldv,cwork(n + 1),lwork - n, &
                        ierr)
              end if
               ! Permute The Rows Of V
               ! do 8991 p = 1, n
                  ! call la_${ri}$copy( n, v(p,1), ldv, a(iwork(p),1), lda )
                  8991 continue
               ! call la_${ri}$lacpy( 'all', n, n, a, lda, v, ldv )
              call la_${ri}$lapmr(.false.,n,n,v,ldv,iwork)
               if (transp) then
                 call la_${ri}$lacpy('A',n,n,v,ldv,u,ldu)
               end if
           else if (jracc .and. (.not. lsvec) .and. (nr == n)) then
              call la_${ri}$laset('L',n - 1,n - 1,czero,czero,a(2,1),lda)
              call la_${ri}$gesvj('U','N','V',n,n,a,lda,sva,n,v,ldv,cwork,lwork,rwork, &
                        lrwork,info)
               scalem = rwork(1)
               numrank = nint(rwork(2),KIND=ilp)
               call la_${ri}$lapmr(.false.,n,n,v,ldv,iwork)
           else if (lsvec .and. (.not. rsvec)) then
              ! Singular Values And Left Singular Vectors
              ! Second Preconditioning Step To Avoid Need To Accumulate
              ! jacobi rotations in the jacobi iterations.
              do p = 1,nr
                 call la_${ri}$copy(n - p + 1,a(p,p),lda,u(p,p),1)
                 call la_${ri}$lacgv(n - p + 1,u(p,p),1)
              end do
              call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,u(1,2),ldu)
              call la_${ri}$geqrf(n,nr,u,ldu,cwork(n + 1),cwork(2*n + 1),lwork - 2*n,ierr)

              do p = 1,nr - 1
                 call la_${ri}$copy(nr - p,u(p,p + 1),ldu,u(p + 1,p),1)
                 call la_${ri}$lacgv(n - p + 1,u(p,p),1)
              end do
              call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,u(1,2),ldu)
              call la_${ri}$gesvj('L','U','N',nr,nr,u,ldu,sva,nr,a,lda,cwork(n + 1),lwork - &
                        n,rwork,lrwork,info)
              scalem = rwork(1)
              numrank = nint(rwork(2),KIND=ilp)
              if (nr < m) then
                 call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                 if (nr < n1) then
                    call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                    call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)
                 end if
              end if
              call la_${ri}$unmqr('L','N',m,n1,n,a,lda,cwork,u,ldu,cwork(n + 1),lwork - n, &
                        ierr)
              if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(iwoff + 1),-1)
              do p = 1,n1
                 xsc = one/la_${ci}$${ri}$nrm2(m,u(1,p),1)
                 call la_${ri}$${ci}$scal(m,xsc,u(1,p),1)
              end do
              if (transp) then
                 call la_${ri}$lacpy('A',n,n,u,ldu,v,ldv)
              end if
           else
              ! Full Svd
              if (.not. jracc) then
              if (.not. almort) then
                 ! second preconditioning step (qrf [with pivoting])
                 ! note that the composition of transpose, qrf and transpose is
                 ! equivalent to an lqf call. since in many libraries the qrf
                 ! seems to be better optimized than the lqf, we do explicit
                 ! transpose and use the qrf. this is subject to changes in an
                 ! optimized implementation of la_${ri}$gejsv.
                 do p = 1,nr
                    call la_${ri}$copy(n - p + 1,a(p,p),lda,v(p,p),1)
                    call la_${ri}$lacgv(n - p + 1,v(p,p),1)
                 end do
                 ! The Following Two Loops Perturb Small Entries To Avoid
                 ! denormals in the second qr factorization, where they are
                 ! as good as zeros. this is done to avoid painfully slow
                 ! computation with denormals. the relative size of the perturbation
                 ! is a parameter that can be changed by the implementer.
                 ! this perturbation device will be obsolete on machines with
                 ! properly implemented arithmetic.
                 ! to switch it off, set l2pert=.false. to remove it from  the
                 ! code, remove the action under l2pert=.true., leave the else part.
                 ! the following two loops should be blocked and fused with the
                 ! transposed copy above.
                 if (l2pert) then
                    xsc = sqrt(small)
                    do q = 1,nr
                       ctemp = cmplx(xsc*abs(v(q,q)),zero,KIND=${rk}$)
                       do p = 1,n
                          if ((p > q) .and. (abs(v(p,q)) <= temp1) .or. (p < q)) v(p,q) = &
                                    ctemp
           ! $                   v(p,q) = temp1 * ( v(p,q) / abs(v(p,q)) )
                          if (p < q) v(p,q) = -v(p,q)
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
                 end if
                 ! estimate the row scaled condition number of r1
                 ! (if r1 is rectangular, n > nr, then the condition number
                 ! of the leading nr x nr submatrix is estimated.)
                 call la_${ri}$lacpy('L',nr,nr,v,ldv,cwork(2*n + 1),nr)
                 do p = 1,nr
                    temp1 = la_${ci}$${ri}$nrm2(nr - p + 1,cwork(2*n + (p - 1)*nr + p),1)
                    call la_${ri}$${ci}$scal(nr - p + 1,one/temp1,cwork(2*n + (p - 1)*nr + p),1)
                 end do
                 call la_${ri}$pocon('L',nr,cwork(2*n + 1),nr,one,temp1,cwork(2*n + nr*nr + 1),rwork, &
                           ierr)
                 condr1 = one/sqrt(temp1)
                 ! Here Need A Second Opinion On The Condition Number
                 ! Then Assume Worst Case Scenario
                 ! r1 is ok for inverse <=> condr1 < real(n,KIND=${rk}$)
                 ! more conservative    <=> condr1 < sqrt(real(n,KIND=${rk}$))
                 cond_ok = sqrt(sqrt(real(nr,KIND=${rk}$)))
      ! [tp]       cond_ok is a tuning parameter.
                 if (condr1 < cond_ok) then
                    ! .. the second qrf without pivoting. note: in an optimized
                    ! implementation, this qrf should be implemented as the qrf
                    ! of a lower triangular matrix.
                    ! r1^* = q2 * r2
                    call la_${ri}$geqrf(n,nr,v,ldv,cwork(n + 1),cwork(2*n + 1),lwork - 2*n,ierr)

                    if (l2pert) then
                       xsc = sqrt(small)/epsln
                       do p = 2,nr
                          do q = 1,p - 1
                             ctemp = cmplx(xsc*min(abs(v(p,p)),abs(v(q,q))),zero,KIND=${rk}$)
                             if (abs(v(q,p)) <= temp1) v(q,p) = ctemp
           ! $                     v(q,p) = temp1 * ( v(q,p) / abs(v(q,p)) )
                          end do
                       end do
                    end if
                    if (nr /= n) call la_${ri}$lacpy('A',n,nr,v,ldv,cwork(2*n + 1),n)

                    ! .. save ...
                 ! This Transposed Copy Should Be Better Than Naive
                    do p = 1,nr - 1
                       call la_${ri}$copy(nr - p,v(p,p + 1),ldv,v(p + 1,p),1)
                       call la_${ri}$lacgv(nr - p + 1,v(p,p),1)
                    end do
                    v(nr,nr) = conjg(v(nr,nr))
                    condr2 = condr1
                 else
                    ! .. ill-conditioned case: second qrf with pivoting
                    ! note that windowed pivoting would be equally good
                    ! numerically, and more run-time efficient. so, in
                    ! an optimal implementation, the next call to la_${ri}$geqp3
                    ! should be replaced with eg. call ${ri}$geqpx (acm toms #782)
                    ! with properly (carefully) chosen parameters.
                    ! r1^* * p2 = q2 * r2
                    do p = 1,nr
                       iwork(n + p) = 0
                    end do
                    call la_${ri}$geqp3(n,nr,v,ldv,iwork(n + 1),cwork(n + 1),cwork(2*n + 1),lwork - &
                              2*n,rwork,ierr)
      ! *               call la_${ri}$geqrf( n, nr, v, ldv, cwork(n+1), cwork(2*n+1),
      ! *     $              lwork-2*n, ierr )
                    if (l2pert) then
                       xsc = sqrt(small)
                       do p = 2,nr
                          do q = 1,p - 1
                             ctemp = cmplx(xsc*min(abs(v(p,p)),abs(v(q,q))),zero,KIND=${rk}$)
                             if (abs(v(q,p)) <= temp1) v(q,p) = ctemp
           ! $                     v(q,p) = temp1 * ( v(q,p) / abs(v(q,p)) )
                          end do
                       end do
                    end if
                    call la_${ri}$lacpy('A',n,nr,v,ldv,cwork(2*n + 1),n)
                    if (l2pert) then
                       xsc = sqrt(small)
                       do p = 2,nr
                          do q = 1,p - 1
                             ctemp = cmplx(xsc*min(abs(v(p,p)),abs(v(q,q))),zero,KIND=${rk}$)
                              ! v(p,q) = - temp1*( v(q,p) / abs(v(q,p)) )
                             v(p,q) = -ctemp
                          end do
                       end do
                    else
                       call la_${ri}$laset('L',nr - 1,nr - 1,czero,czero,v(2,1),ldv)
                    end if
                    ! now, compute r2 = l3 * q3, the lq factorization.
                    call la_${ri}$gelqf(nr,nr,v,ldv,cwork(2*n + n*nr + 1),cwork(2*n + n*nr + nr + 1), &
                              lwork - 2*n - n*nr - nr,ierr)
                    ! And Estimate The Condition Number
                    call la_${ri}$lacpy('L',nr,nr,v,ldv,cwork(2*n + n*nr + nr + 1),nr)
                    do p = 1,nr
                       temp1 = la_${ci}$${ri}$nrm2(p,cwork(2*n + n*nr + nr + p),nr)
                       call la_${ri}$${ci}$scal(p,one/temp1,cwork(2*n + n*nr + nr + p),nr)
                    end do
                    call la_${ri}$pocon('L',nr,cwork(2*n + n*nr + nr + 1),nr,one,temp1,cwork(2*n + n*nr + &
                              nr + nr*nr + 1),rwork,ierr)
                    condr2 = one/sqrt(temp1)
                    if (condr2 >= cond_ok) then
                       ! Save The Householder Vectors Used For Q3
                       ! (this overwrites the copy of r2, as it will not be
                       ! needed in this branch, but it does not overwritte the
                       ! huseholder vectors of q2.).
                       call la_${ri}$lacpy('U',nr,nr,v,ldv,cwork(2*n + 1),n)
                       ! And The Rest Of The Information On Q3 Is In
                       ! work(2*n+n*nr+1:2*n+n*nr+n)
                    end if
                 end if
                 if (l2pert) then
                    xsc = sqrt(small)
                    do q = 2,nr
                       ctemp = xsc*v(q,q)
                       do p = 1,q - 1
                           ! v(p,q) = - temp1*( v(p,q) / abs(v(p,q)) )
                          v(p,q) = -ctemp
                       end do
                    end do
                 else
                    call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
                 end if
              ! second preconditioning finished; continue with jacobi svd
              ! the input matrix is lower trinagular.
              ! recover the right singular vectors as solution of a well
              ! conditioned triangular matrix equation.
                 if (condr1 < cond_ok) then
                    call la_${ri}$gesvj('L','U','N',nr,nr,v,ldv,sva,nr,u,ldu,cwork(2*n + n*nr + nr + 1) &
                              ,lwork - 2*n - n*nr - nr,rwork,lrwork,info)
                    scalem = rwork(1)
                    numrank = nint(rwork(2),KIND=ilp)
                    do p = 1,nr
                       call la_${ri}$copy(nr,v(1,p),1,u(1,p),1)
                       call la_${ri}$${ci}$scal(nr,sva(p),v(1,p),1)
                    end do
              ! Pick The Right Matrix Equation And Solve It
                    if (nr == n) then
       ! :))             .. best case, r1 is inverted. the solution of this matrix
                       ! equation is q2*v2 = the product of the jacobi rotations
                       ! used in la_${ri}$gesvj, premultiplied with the orthogonal matrix
                       ! from the second qr factorization.
                       call la_${ri}$trsm('L','U','N','N',nr,nr,cone,a,lda,v,ldv)
                    else
                       ! .. r1 is well conditioned, but non-square. adjoint of r2
                       ! is inverted to get the product of the jacobi rotations
                       ! used in la_${ri}$gesvj. the q-factor from the second qr
                       ! factorization is then built in explicitly.
                       call la_${ri}$trsm('L','U','C','N',nr,nr,cone,cwork(2*n + 1),n,v,ldv)
                       if (nr < n) then
                       call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
                       end if
                       call la_${ri}$unmqr('L','N',n,n,nr,cwork(2*n + 1),n,cwork(n + 1),v,ldv,cwork( &
                                 2*n + n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                    end if
                 else if (condr2 < cond_ok) then
                    ! the matrix r2 is inverted. the solution of the matrix equation
                    ! is q3^* * v3 = the product of the jacobi rotations (appplied to
                    ! the lower triangular l3 from the lq factorization of
                    ! r2=l3*q3), pre-multiplied with the transposed q3.
                    call la_${ri}$gesvj('L','U','N',nr,nr,v,ldv,sva,nr,u,ldu,cwork(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,rwork,lrwork,info)
                    scalem = rwork(1)
                    numrank = nint(rwork(2),KIND=ilp)
                    do p = 1,nr
                       call la_${ri}$copy(nr,v(1,p),1,u(1,p),1)
                       call la_${ri}$${ci}$scal(nr,sva(p),u(1,p),1)
                    end do
                    call la_${ri}$trsm('L','U','N','N',nr,nr,cone,cwork(2*n + 1),n,u,ldu)
                    ! Apply The Permutation From The Second Qr Factorization
                    do q = 1,nr
                       do p = 1,nr
                          cwork(2*n + n*nr + nr + iwork(n + p)) = u(p,q)
                       end do
                       do p = 1,nr
                          u(p,q) = cwork(2*n + n*nr + nr + p)
                       end do
                    end do
                    if (nr < n) then
                       call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
                    end if
                    call la_${ri}$unmqr('L','N',n,n,nr,cwork(2*n + 1),n,cwork(n + 1),v,ldv,cwork(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                 else
                    ! last line of defense.
       ! #:(          this is a rather pathological case: no scaled condition
                    ! improvement after two pivoted qr factorizations. other
                    ! possibility is that the rank revealing qr factorization
                    ! or the condition estimator has failed, or the cond_ok
                    ! is set very close to one (which is unnecessary). normally,
                    ! this branch should never be executed, but in rare cases of
                    ! failure of the rrqr or condition estimator, the last line of
                    ! defense ensures that la_${ri}$gejsv completes the task.
                    ! compute the full svd of l3 using la_${ri}$gesvj with explicit
                    ! accumulation of jacobi rotations.
                    call la_${ri}$gesvj('L','U','V',nr,nr,v,ldv,sva,nr,u,ldu,cwork(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,rwork,lrwork,info)
                    scalem = rwork(1)
                    numrank = nint(rwork(2),KIND=ilp)
                    if (nr < n) then
                       call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                       call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                       call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
                    end if
                    call la_${ri}$unmqr('L','N',n,n,nr,cwork(2*n + 1),n,cwork(n + 1),v,ldv,cwork(2*n + &
                              n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                    call la_${ri}$unmlq('L','C',nr,nr,nr,cwork(2*n + 1),n,cwork(2*n + n*nr + 1), &
                              u,ldu,cwork(2*n + n*nr + nr + 1),lwork - 2*n - n*nr - nr,ierr)
                    do q = 1,nr
                       do p = 1,nr
                          cwork(2*n + n*nr + nr + iwork(n + p)) = u(p,q)
                       end do
                       do p = 1,nr
                          u(p,q) = cwork(2*n + n*nr + nr + p)
                       end do
                    end do
                 end if
                 ! permute the rows of v using the (column) permutation from the
                 ! first qrf. also, scale the columns to make them unit in
                 ! euclidean norm. this applies to all cases.
                 temp1 = sqrt(real(n,KIND=${rk}$))*epsln
                 do q = 1,n
                    do p = 1,n
                       cwork(2*n + n*nr + nr + iwork(p)) = v(p,q)
                    end do
                    do p = 1,n
                       v(p,q) = cwork(2*n + n*nr + nr + p)
                    end do
                    xsc = one/la_${ci}$${ri}$nrm2(n,v(1,q),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$${ci}$scal(n,xsc, &
                               v(1,q),1)
                 end do
                 ! at this moment, v contains the right singular vectors of a.
                 ! next, assemble the left singular vector matrix u (m x n).
                 if (nr < m) then
                    call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                    if (nr < n1) then
                       call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                       call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)
                    end if
                 end if
                 ! the q matrix from the first qrf is built into the left singular
                 ! matrix u. this applies to all cases.
                 call la_${ri}$unmqr('L','N',m,n1,n,a,lda,cwork,u,ldu,cwork(n + 1),lwork - &
                           n,ierr)
                 ! the columns of u are normalized. the cost is o(m*n) flops.
                 temp1 = sqrt(real(m,KIND=${rk}$))*epsln
                 do p = 1,nr
                    xsc = one/la_${ci}$${ri}$nrm2(m,u(1,p),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$${ci}$scal(m,xsc, &
                               u(1,p),1)
                 end do
                 ! if the initial qrf is computed with row pivoting, the left
                 ! singular vectors must be adjusted.
                 if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(iwoff + 1),-1)
              else
              ! The Initial Matrix A Has Almost Orthogonal Columns And
              ! the second qrf is not needed
                 call la_${ri}$lacpy('U',n,n,a,lda,cwork(n + 1),n)
                 if (l2pert) then
                    xsc = sqrt(small)
                    do p = 2,n
                       ctemp = xsc*cwork(n + (p - 1)*n + p)
                       do q = 1,p - 1
                           ! cwork(n+(q-1)*n+p)=-temp1 * ( cwork(n+(p-1)*n+q) /
           ! $                                        abs(cwork(n+(p-1)*n+q)) )
                          cwork(n + (q - 1)*n + p) = -ctemp
                       end do
                    end do
                 else
                    call la_${ri}$laset('L',n - 1,n - 1,czero,czero,cwork(n + 2),n)
                 end if
                 call la_${ri}$gesvj('U','U','N',n,n,cwork(n + 1),n,sva,n,u,ldu,cwork(n + &
                           n*n + 1),lwork - n - n*n,rwork,lrwork,info)
                 scalem = rwork(1)
                 numrank = nint(rwork(2),KIND=ilp)
                 do p = 1,n
                    call la_${ri}$copy(n,cwork(n + (p - 1)*n + 1),1,u(1,p),1)
                    call la_${ri}$${ci}$scal(n,sva(p),cwork(n + (p - 1)*n + 1),1)
                 end do
                 call la_${ri}$trsm('L','U','N','N',n,n,cone,a,lda,cwork(n + 1),n)
                 do p = 1,n
                    call la_${ri}$copy(n,cwork(n + p),n,v(iwork(p),1),ldv)
                 end do
                 temp1 = sqrt(real(n,KIND=${rk}$))*epsln
                 do p = 1,n
                    xsc = one/la_${ci}$${ri}$nrm2(n,v(1,p),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$${ci}$scal(n,xsc, &
                               v(1,p),1)
                 end do
                 ! assemble the left singular vector matrix u (m x n).
                 if (n < m) then
                    call la_${ri}$laset('A',m - n,n,czero,czero,u(n + 1,1),ldu)
                    if (n < n1) then
                       call la_${ri}$laset('A',n,n1 - n,czero,czero,u(1,n + 1),ldu)
                       call la_${ri}$laset('A',m - n,n1 - n,czero,cone,u(n + 1,n + 1),ldu)
                    end if
                 end if
                 call la_${ri}$unmqr('L','N',m,n1,n,a,lda,cwork,u,ldu,cwork(n + 1),lwork - &
                           n,ierr)
                 temp1 = sqrt(real(m,KIND=${rk}$))*epsln
                 do p = 1,n1
                    xsc = one/la_${ci}$${ri}$nrm2(m,u(1,p),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$${ci}$scal(m,xsc, &
                               u(1,p),1)
                 end do
                 if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(iwoff + 1),-1)
              end if
              ! end of the  >> almost orthogonal case <<  in the full svd
              else
              ! this branch deploys a preconditioned jacobi svd with explicitly
              ! accumulated rotations. it is included as optional, mainly for
              ! experimental purposes. it does perform well, and can also be used.
              ! in this implementation, this branch will be automatically activated
              ! if the  condition number sigma_max(a) / sigma_min(a) is predicted
              ! to be greater than the overflow threshold. this is because the
              ! a posteriori computation of the singular vectors assumes robust
              ! implementation of blas and some lapack procedures, capable of working
              ! in presence of extreme values, e.g. when the singular values spread from
              ! the underflow to the overflow threshold.
              do p = 1,nr
                 call la_${ri}$copy(n - p + 1,a(p,p),lda,v(p,p),1)
                 call la_${ri}$lacgv(n - p + 1,v(p,p),1)
              end do
              if (l2pert) then
                 xsc = sqrt(small/epsln)
                 do q = 1,nr
                    ctemp = cmplx(xsc*abs(v(q,q)),zero,KIND=${rk}$)
                    do p = 1,n
                       if ((p > q) .and. (abs(v(p,q)) <= temp1) .or. (p < q)) v(p,q) = &
                                 ctemp
           ! $                v(p,q) = temp1 * ( v(p,q) / abs(v(p,q)) )
                       if (p < q) v(p,q) = -v(p,q)
                    end do
                 end do
              else
                 call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,v(1,2),ldv)
              end if
              call la_${ri}$geqrf(n,nr,v,ldv,cwork(n + 1),cwork(2*n + 1),lwork - 2*n,ierr)

              call la_${ri}$lacpy('L',n,nr,v,ldv,cwork(2*n + 1),n)
              do p = 1,nr
                 call la_${ri}$copy(nr - p + 1,v(p,p),ldv,u(p,p),1)
                 call la_${ri}$lacgv(nr - p + 1,u(p,p),1)
              end do
              if (l2pert) then
                 xsc = sqrt(small/epsln)
                 do q = 2,nr
                    do p = 1,q - 1
                       ctemp = cmplx(xsc*min(abs(u(p,p)),abs(u(q,q))),zero,KIND=${rk}$)
                        ! u(p,q) = - temp1 * ( u(q,p) / abs(u(q,p)) )
                       u(p,q) = -ctemp
                    end do
                 end do
              else
                 call la_${ri}$laset('U',nr - 1,nr - 1,czero,czero,u(1,2),ldu)
              end if
              call la_${ri}$gesvj('L','U','V',nr,nr,u,ldu,sva,n,v,ldv,cwork(2*n + n*nr + 1), &
                         lwork - 2*n - n*nr,rwork,lrwork,info)
              scalem = rwork(1)
              numrank = nint(rwork(2),KIND=ilp)
              if (nr < n) then
                 call la_${ri}$laset('A',n - nr,nr,czero,czero,v(nr + 1,1),ldv)
                 call la_${ri}$laset('A',nr,n - nr,czero,czero,v(1,nr + 1),ldv)
                 call la_${ri}$laset('A',n - nr,n - nr,czero,cone,v(nr + 1,nr + 1),ldv)
              end if
              call la_${ri}$unmqr('L','N',n,n,nr,cwork(2*n + 1),n,cwork(n + 1),v,ldv,cwork(2*n + n*nr + &
                        nr + 1),lwork - 2*n - n*nr - nr,ierr)
                 ! permute the rows of v using the (column) permutation from the
                 ! first qrf. also, scale the columns to make them unit in
                 ! euclidean norm. this applies to all cases.
                 temp1 = sqrt(real(n,KIND=${rk}$))*epsln
                 do q = 1,n
                    do p = 1,n
                       cwork(2*n + n*nr + nr + iwork(p)) = v(p,q)
                    end do
                    do p = 1,n
                       v(p,q) = cwork(2*n + n*nr + nr + p)
                    end do
                    xsc = one/la_${ci}$${ri}$nrm2(n,v(1,q),1)
                    if ((xsc < (one - temp1)) .or. (xsc > (one + temp1))) call la_${ri}$${ci}$scal(n,xsc, &
                               v(1,q),1)
                 end do
                 ! at this moment, v contains the right singular vectors of a.
                 ! next, assemble the left singular vector matrix u (m x n).
              if (nr < m) then
                 call la_${ri}$laset('A',m - nr,nr,czero,czero,u(nr + 1,1),ldu)
                 if (nr < n1) then
                    call la_${ri}$laset('A',nr,n1 - nr,czero,czero,u(1,nr + 1),ldu)
                    call la_${ri}$laset('A',m - nr,n1 - nr,czero,cone,u(nr + 1,nr + 1),ldu)
                 end if
              end if
              call la_${ri}$unmqr('L','N',m,n1,n,a,lda,cwork,u,ldu,cwork(n + 1),lwork - n, &
                        ierr)
                 if (rowpiv) call la_${ri}$laswp(n1,u,ldu,1,m - 1,iwork(iwoff + 1),-1)
              end if
              if (transp) then
                 ! .. swap u and v because the procedure worked on a^*
                 do p = 1,n
                    call la_${ri}$swap(n,u(1,p),1,v(1,p),1)
                 end do
              end if
           end if
           ! end of the full svd
           ! undo scaling, if necessary (and possible)
           if (uscal2 <= (big/sva(1))*uscal1) then
              call la_${ci}$lascl('G',0,0,uscal1,uscal2,nr,1,sva,n,ierr)
              uscal1 = one
              uscal2 = one
           end if
           if (nr < n) then
              do p = nr + 1,n
                 sva(p) = zero
              end do
           end if
           rwork(1) = uscal2*scalem
           rwork(2) = uscal1
           if (errest) rwork(3) = sconda
           if (lsvec .and. rsvec) then
              rwork(4) = condr1
              rwork(5) = condr2
           end if
           if (l2tran) then
              rwork(6) = entra
              rwork(7) = entrat
           end if
           iwork(1) = nr
           iwork(2) = numrank
           iwork(3) = warning
           if (transp) then
               iwork(4) = 1
           else
               iwork(4) = -1
           end if
           return
     end subroutine la_${ri}$gejsv
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GESVJ: computes the singular value decomposition (SVD) of a complex
     !> M-by-N matrix A, where M >= N. The SVD of A is written as
     !> [++]   [xx]   [x0]   [xx]
     !> A = U * SIGMA * V^*,  [++] = [xx] * [ox] * [xx]
     !> [++]   [xx]
     !> where SIGMA is an N-by-N diagonal matrix, U is an M-by-N orthonormal
     !> matrix, and V is an N-by-N unitary matrix. The diagonal elements
     !> of SIGMA are the singular values of A. The columns of U and V are the
     !> left and the right singular vectors of A, respectively.

     pure subroutine la_${ri}$gesvj(joba,jobu,jobv,m,n,a,lda,sva,mv,v,ldv,cwork,lwork, &
               rwork,lrwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldv,lwork,lrwork,m,mv,n
           character,intent(in) :: joba,jobu,jobv
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),v(ldv,*),cwork(lwork)
           real(${rk}$),intent(inout) :: rwork(lrwork)
           real(${rk}$),intent(out) :: sva(n)
        ! =====================================================================
           ! Local Parameters
           integer(ilp),parameter :: nsweep = 30

           ! Local Scalars
           complex(${rk}$) :: aapq,ompq
           real(${rk}$) :: aapp,aapp0,aapq1,aaqq,apoaq,aqoap,big,bigtheta,cs,ctol,epsln, &
           mxaapq,mxsinj,rootbig,rooteps,rootsfmin,roottol,skl,sfmin,small,sn,t,temp1, &
                     theta,thsign,tol
           integer(ilp) :: blskip,emptsw,i,ibr,ierr,igl,ijblsk,ir1,iswrot,jbc,jgl,kbl, &
                     lkahead,mvl,n2,n34,n4,nbl,notrot,p,pskipped,q,rowskip,swband
           logical(lk) :: applv,goscale,lower,lquery,lsvec,noscale,rotok,rsvec,uctol, &
                     upper
           ! Intrinsic Functions
           intrinsic :: abs,max,min,conjg,real,sign,sqrt
           ! from lapack
           ! from lapack
           ! Executable Statements
           ! test the input arguments
           lsvec = la_lsame(jobu,'U') .or. la_lsame(jobu,'F')
           uctol = la_lsame(jobu,'C')
           rsvec = la_lsame(jobv,'V') .or. la_lsame(jobv,'J')
           applv = la_lsame(jobv,'A')
           upper = la_lsame(joba,'U')
           lower = la_lsame(joba,'L')
           lquery = (lwork == -1) .or. (lrwork == -1)
           if (.not. (upper .or. lower .or. la_lsame(joba,'G'))) then
              info = -1
           else if (.not. (lsvec .or. uctol .or. la_lsame(jobu,'N'))) then
              info = -2
           else if (.not. (rsvec .or. applv .or. la_lsame(jobv,'N'))) then
              info = -3
           else if (m < 0) then
              info = -4
           else if ((n < 0) .or. (n > m)) then
              info = -5
           else if (lda < m) then
              info = -7
           else if (mv < 0) then
              info = -9
           else if ((rsvec .and. (ldv < n)) .or. (applv .and. (ldv < mv))) then
              info = -11
           else if (uctol .and. (rwork(1) <= one)) then
              info = -12
#:if rk == "sp"
           else if (lwork < (m + n) .and. (.not. lquery)) then
#:else
           else if ((lwork < (m + n)) .and. (.not. lquery)) then
#:endif
              info = -13
#:if rk == "sp"
           else if (lrwork < max(n,6) .and. (.not. lquery)) then
#:else
           else if ((lrwork < max(n,6)) .and. (.not. lquery)) then
#:endif
              info = -15
           else
              info = 0
           end if
           ! #:(
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GESVJ',-info)
              return
           else if (lquery) then
              cwork(1) = m + n
              rwork(1) = max(n,6)
              return
           end if
       ! #:) quick return for void matrix
           if ((m == 0) .or. (n == 0)) return
           ! set numerical parameters
           ! the stopping criterion for jacobi rotations is
           ! max_{i<>j}|a(:,i)^* * a(:,j)| / (||a(:,i)||*||a(:,j)||) < ctol*eps
           ! where eps is the round-off and ctol is defined as follows:
           if (uctol) then
              ! ... user controlled
              ctol = rwork(1)
           else
              ! ... default
              if (lsvec .or. rsvec .or. applv) then
                 ctol = sqrt(real(m,KIND=${rk}$))
              else
                 ctol = real(m,KIND=${rk}$)
              end if
           end if
           ! ... and the machine dependent parameters are
#:if rk == "sp"
      ! [!]  (make sure that la_${ci}$lamch() works properly on the target machine.)
#:else
      ! [!]  (make sure that la_${cil}$lamch() works properly on the target machine.)
#:endif
           epsln = la_${ci}$lamch('EPSILON')
           rooteps = sqrt(epsln)
           sfmin = la_${ci}$lamch('SAFEMINIMUM')
           rootsfmin = sqrt(sfmin)
           small = sfmin/epsln
#:if rk == "sp"
            ! big = la_${ci}$lamch( 'overflow' )
           big = one/sfmin
#:else
           big = la_${ci}$lamch('OVERFLOW')
           ! big         = one    / sfmin
#:endif
           rootbig = one/rootsfmin
            ! large = big / sqrt( real( m*n,KIND=${rk}$) )
           bigtheta = one/rooteps
           tol = ctol*epsln
           roottol = sqrt(tol)
           if (real(m,KIND=${rk}$)*epsln >= one) then
              info = -4
              call la_xerbla('${ri.upper()}$GESVJ',-info)
              return
           end if
           ! initialize the right singular vector matrix.
           if (rsvec) then
              mvl = n
              call la_${ri}$laset('A',mvl,n,czero,cone,v,ldv)
           else if (applv) then
              mvl = mv
           end if
           rsvec = rsvec .or. applv
           ! initialize sva( 1:n ) = ( ||a e_i||_2, i = 1:n )
      ! (!)  if necessary, scale a to protect the largest singular value
           ! from overflow. it is possible that saving the largest singular
           ! value destroys the information about the small ones.
           ! this initial scaling is almost minimal in the sense that the
           ! goal is to make sure that no column norm overflows, and that
           ! sqrt(n)*max_i sva(i) does not overflow. if infinite entries
           ! in a are detected, the procedure returns with info=-6.
           skl = one/sqrt(real(m,KIND=${rk}$)*real(n,KIND=${rk}$))
           noscale = .true.
           goscale = .true.
           if (lower) then
              ! the input matrix is m-by-n lower triangular (trapezoidal)
              do p = 1,n
                 aapp = zero
                 aaqq = one
                 call la_${ri}$lassq(m - p + 1,a(p,p),1,aapp,aaqq)
                 if (aapp > big) then
                    info = -6
                    call la_xerbla('${ri.upper()}$GESVJ',-info)
                    return
                 end if
                 aaqq = sqrt(aaqq)
                 if ((aapp < (big/aaqq)) .and. noscale) then
                    sva(p) = aapp*aaqq
                 else
                    noscale = .false.
                    sva(p) = aapp*(aaqq*skl)
                    if (goscale) then
                       goscale = .false.
                       do q = 1,p - 1
                          sva(q) = sva(q)*skl
                       end do
                    end if
                 end if
              end do
           else if (upper) then
              ! the input matrix is m-by-n upper triangular (trapezoidal)
              do p = 1,n
                 aapp = zero
                 aaqq = one
                 call la_${ri}$lassq(p,a(1,p),1,aapp,aaqq)
                 if (aapp > big) then
                    info = -6
                    call la_xerbla('${ri.upper()}$GESVJ',-info)
                    return
                 end if
                 aaqq = sqrt(aaqq)
                 if ((aapp < (big/aaqq)) .and. noscale) then
                    sva(p) = aapp*aaqq
                 else
                    noscale = .false.
                    sva(p) = aapp*(aaqq*skl)
                    if (goscale) then
                       goscale = .false.
                       do q = 1,p - 1
                          sva(q) = sva(q)*skl
                       end do
                    end if
                 end if
              end do
           else
              ! the input matrix is m-by-n general dense
              do p = 1,n
                 aapp = zero
                 aaqq = one
                 call la_${ri}$lassq(m,a(1,p),1,aapp,aaqq)
                 if (aapp > big) then
                    info = -6
                    call la_xerbla('${ri.upper()}$GESVJ',-info)
                    return
                 end if
                 aaqq = sqrt(aaqq)
                 if ((aapp < (big/aaqq)) .and. noscale) then
                    sva(p) = aapp*aaqq
                 else
                    noscale = .false.
                    sva(p) = aapp*(aaqq*skl)
                    if (goscale) then
                       goscale = .false.
                       do q = 1,p - 1
                          sva(q) = sva(q)*skl
                       end do
                    end if
                 end if
              end do
           end if
           if (noscale) skl = one
           ! move the smaller part of the spectrum from the underflow threshold
      ! (!)  start by determining the position of the nonzero entries of the
           ! array sva() relative to ( sfmin, big ).
           aapp = zero
           aaqq = big
           do p = 1,n
              if (sva(p) /= zero) aaqq = min(aaqq,sva(p))
              aapp = max(aapp,sva(p))
           end do
       ! #:) quick return for zero matrix
           if (aapp == zero) then
              if (lsvec) call la_${ri}$laset('G',m,n,czero,cone,a,lda)
              rwork(1) = one
              rwork(2) = zero
              rwork(3) = zero
              rwork(4) = zero
              rwork(5) = zero
              rwork(6) = zero
              return
           end if
       ! #:) quick return for one-column matrix
           if (n == 1) then
              if (lsvec) call la_${ri}$lascl('G',0,0,sva(1),skl,m,1,a(1,1),lda,ierr)

              rwork(1) = one/skl
              if (sva(1) >= sfmin) then
                 rwork(2) = one
              else
                 rwork(2) = zero
              end if
              rwork(3) = zero
              rwork(4) = zero
              rwork(5) = zero
              rwork(6) = zero
              return
           end if
           ! protect small singular values from underflow, and try to
           ! avoid underflows/overflows in computing jacobi rotations.
           sn = sqrt(sfmin/epsln)
           temp1 = sqrt(big/real(n,KIND=${rk}$))
           if ((aapp <= sn) .or. (aaqq >= temp1) .or. ((sn <= aaqq) .and. (aapp <= temp1))) &
                     then
              temp1 = min(big,temp1/aapp)
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else if ((aaqq <= sn) .and. (aapp <= temp1)) then
              temp1 = min(sn/aaqq,big/(aapp*sqrt(real(n,KIND=${rk}$))))
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else if ((aaqq >= sn) .and. (aapp >= temp1)) then
              temp1 = max(sn/aaqq,temp1/aapp)
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else if ((aaqq <= sn) .and. (aapp >= temp1)) then
              temp1 = min(sn/aaqq,big/(sqrt(real(n,KIND=${rk}$))*aapp))
               ! aaqq  = aaqq*temp1
               ! aapp  = aapp*temp1
           else
              temp1 = one
           end if
           ! scale, if necessary
           if (temp1 /= one) then
              call la_${ci}$lascl('G',0,0,one,temp1,n,1,sva,n,ierr)
           end if
           skl = temp1*skl
           if (skl /= one) then
              call la_${ri}$lascl(joba,0,0,one,skl,m,n,a,lda,ierr)
              skl = one/skl
           end if
           ! row-cyclic jacobi svd algorithm with column pivoting
           emptsw = (n*(n - 1))/2
           notrot = 0
           do q = 1,n
              cwork(q) = cone
           end do
           swband = 3
      ! [tp] swband is a tuning parameter [tp]. it is meaningful and effective
           ! if la_${ri}$gesvj is used as a computational routine in the preconditioned
           ! jacobi svd algorithm la_${ri}$gejsv. for sweeps i=1:swband the procedure
           ! works on pivots inside a band-like region around the diagonal.
           ! the boundaries are determined dynamically, based on the number of
           ! pivots above a threshold.
           kbl = min(8,n)
      ! [tp] kbl is a tuning parameter that defines the tile size in the
           ! tiling of the p-q loops of pivot pairs. in general, an optimal
           ! value of kbl depends on the matrix dimensions and on the
           ! parameters of the computer's memory.
           nbl = n/kbl
           if ((nbl*kbl) /= n) nbl = nbl + 1
           blskip = kbl**2
      ! [tp] blkskip is a tuning parameter that depends on swband and kbl.
           rowskip = min(5,kbl)
      ! [tp] rowskip is a tuning parameter.
           lkahead = 1
      ! [tp] lkahead is a tuning parameter.
           ! quasi block transformations, using the lower (upper) triangular
           ! structure of the input matrix. the quasi-block-cycling usually
           ! invokes cubic convergence. big part of this cycle is done inside
           ! canonical subspaces of dimensions less than m.
           if ((lower .or. upper) .and. (n > max(64,4*kbl))) then
      ! [tp] the number of partition levels and the actual partition are
           ! tuning parameters.
              n4 = n/4
              n2 = n/2
              n34 = 3*n4
              if (applv) then
                 q = 0
              else
                 q = 1
              end if
              if (lower) then
           ! this works very well on lower triangular matrices, in particular
           ! in the framework of the preconditioned jacobi svd (xgejsv).
           ! the idea is simple:
           ! [+ 0 0 0]   note that jacobi transformations of [0 0]
           ! [+ + 0 0]                                       [0 0]
           ! [+ + x 0]   actually work on [x 0]              [x 0]
           ! [+ + x x]                    [x x].             [x x]
                 call la_${ri}$gsvj0(jobv,m - n34,n - n34,a(n34 + 1,n34 + 1),lda,cwork(n34 + 1), &
                 sva(n34 + 1),mvl,v(n34*q + 1,n34 + 1),ldv,epsln,sfmin,tol,2,cwork(n + 1), &
                           lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,m - n2,n34 - n2,a(n2 + 1,n2 + 1),lda,cwork(n2 + 1),sva( &
                 n2 + 1),mvl,v(n2*q + 1,n2 + 1),ldv,epsln,sfmin,tol,2,cwork(n + 1),lwork - n, &
                           ierr)
                 call la_${ri}$gsvj1(jobv,m - n2,n - n2,n4,a(n2 + 1,n2 + 1),lda,cwork(n2 + 1), &
                 sva(n2 + 1),mvl,v(n2*q + 1,n2 + 1),ldv,epsln,sfmin,tol,1,cwork(n + 1), &
                           lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,m - n4,n2 - n4,a(n4 + 1,n4 + 1),lda,cwork(n4 + 1),sva( &
                 n4 + 1),mvl,v(n4*q + 1,n4 + 1),ldv,epsln,sfmin,tol,1,cwork(n + 1),lwork - n, &
                           ierr)
                 call la_${ri}$gsvj0(jobv,m,n4,a,lda,cwork,sva,mvl,v,ldv,epsln,sfmin, &
                           tol,1,cwork(n + 1),lwork - n,ierr)
                 call la_${ri}$gsvj1(jobv,m,n2,n4,a,lda,cwork,sva,mvl,v,ldv,epsln, &
                           sfmin,tol,1,cwork(n + 1),lwork - n,ierr)
              else if (upper) then
                 call la_${ri}$gsvj0(jobv,n4,n4,a,lda,cwork,sva,mvl,v,ldv,epsln,sfmin, &
                           tol,2,cwork(n + 1),lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,n2,n4,a(1,n4 + 1),lda,cwork(n4 + 1),sva(n4 + 1), &
                 mvl,v(n4*q + 1,n4 + 1),ldv,epsln,sfmin,tol,1,cwork(n + 1),lwork - n,ierr)

                 call la_${ri}$gsvj1(jobv,n2,n2,n4,a,lda,cwork,sva,mvl,v,ldv,epsln, &
                           sfmin,tol,1,cwork(n + 1),lwork - n,ierr)
                 call la_${ri}$gsvj0(jobv,n2 + n4,n4,a(1,n2 + 1),lda,cwork(n2 + 1),sva(n2 + 1) &
                 ,mvl,v(n2*q + 1,n2 + 1),ldv,epsln,sfmin,tol,1,cwork(n + 1),lwork - n,ierr)

              end if
           end if
           ! .. row-cyclic pivot strategy with de rijk's pivoting ..
           loop_1993: do i = 1,nsweep
           ! .. go go go ...
              mxaapq = zero
              mxsinj = zero
              iswrot = 0
              notrot = 0
              pskipped = 0
           ! each sweep is unrolled using kbl-by-kbl tiles over the pivot pairs
           ! 1 <= p < q <= n. this is the first step toward a blocked implementation
           ! of the rotations. new implementation, based on block transformations,
           ! is under development.
              loop_2000: do ibr = 1,nbl
                 igl = (ibr - 1)*kbl + 1
                 loop_1002: do ir1 = 0,min(lkahead,nbl - ibr)
                    igl = igl + ir1*kbl
                    loop_2001: do p = igl,min(igl + kbl - 1,n - 1)
           ! .. de rijk's pivoting
                       q = la_i${ci}$amax(n - p + 1,sva(p),1) + p - 1
                       if (p /= q) then
                          call la_${ri}$swap(m,a(1,p),1,a(1,q),1)
                          if (rsvec) call la_${ri}$swap(mvl,v(1,p),1,v(1,q),1)
                          temp1 = sva(p)
                          sva(p) = sva(q)
                          sva(q) = temp1
                          aapq = cwork(p)
                          cwork(p) = cwork(q)
                          cwork(q) = aapq
                       end if
                       if (ir1 == 0) then
              ! column norms are periodically updated by explicit
              ! norm computation.
      ! [!]     caveat:
              ! unfortunately, some blas implementations compute la_${ci}$${ri}$nrm2(m,a(1,p),1)
#:if rk == "sp"
              ! as sqrt(s=la_${ri}$dotc(m,a(1,p),1,a(1,p),1)), which may cause the result to
#:else
              ! as sqrt(s=la_${ril}$dotc(m,a(1,p),1,a(1,p),1)), which may cause the result to
#:endif
              ! overflow for ||a(:,p)||_2 > sqrt(overflow_threshold), and to
              ! underflow for ||a(:,p)||_2 < sqrt(underflow_threshold).
              ! hence, la_${ci}$${ri}$nrm2 cannot be trusted, not even in the case when
              ! the true norm is far from the under(over)flow boundaries.
#:if rk == "sp"
              ! if properly implemented la_${ci}$${ri}$nrm2 is available, the if-then-else-end if
#:else
              ! if properly implemented la_${cil}$${ril}$nrm2 is available, the if-then-else-end if
#:endif
              ! below should be replaced with "aapp = la_${ci}$${ri}$nrm2( m, a(1,p), 1 )".
                          if ((sva(p) < rootbig) .and. (sva(p) > rootsfmin)) then
                             sva(p) = la_${ci}$${ri}$nrm2(m,a(1,p),1)
                          else
                             temp1 = zero
                             aapp = one
                             call la_${ri}$lassq(m,a(1,p),1,temp1,aapp)
                             sva(p) = temp1*sqrt(aapp)
                          end if
                          aapp = sva(p)
                       else
                          aapp = sva(p)
                       end if
                       if (aapp > zero) then
                          pskipped = 0
                          loop_2002: do q = p + 1,min(igl + kbl - 1,n)
                             aaqq = sva(q)
                             if (aaqq > zero) then
                                aapp0 = aapp
                                if (aaqq >= one) then
                                   rotok = (small*aapp) <= aaqq
                                   if (aapp < (big/aaqq)) then
                                      aapq = (la_${ri}$dotc(m,a(1,p),1,a(1,q),1)/ &
                                                aaqq)/aapp
                                   else
                                      call la_${ri}$copy(m,a(1,p),1,cwork(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aapp,one,m,1,cwork(n + 1), &
                                                lda,ierr)
                                      aapq = la_${ri}$dotc(m,cwork(n + 1),1,a(1,q),1)/ &
                                                aaqq
                                   end if
                                else
                                   rotok = aapp <= (aaqq/small)
                                   if (aapp > (small/aaqq)) then
                                      aapq = (la_${ri}$dotc(m,a(1,p),1,a(1,q),1)/ &
                                                aapp)/aaqq
                                   else
                                      call la_${ri}$copy(m,a(1,q),1,cwork(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aaqq,one,m,1,cwork(n + 1), &
                                                lda,ierr)
                                      aapq = la_${ri}$dotc(m,a(1,p),1,cwork(n + 1),1)/ &
                                                aapp
                                   end if
                                end if
                                 ! aapq = aapq * conjg( cwork(p) ) * cwork(q)
                                aapq1 = -abs(aapq)
                                mxaapq = max(mxaapq,-aapq1)
              ! to rotate or not to rotate, that is the question ...
                                if (abs(aapq1) > tol) then
                                ompq = aapq/abs(aapq)
                 ! Rotate
      ! [rtd]      rotated = rotated + one
                                   if (ir1 == 0) then
                                      notrot = 0
                                      pskipped = 0
                                      iswrot = iswrot + 1
                                   end if
                                   if (rotok) then
                                      aqoap = aaqq/aapp
                                      apoaq = aapp/aaqq
                                      theta = -half*abs(aqoap - apoaq)/aapq1
                                      if (abs(theta) > bigtheta) then
                                         t = half/theta
                                         cs = one
                                         call la_${ri}$rot(m,a(1,p),1,a(1,q),1,cs,conjg(ompq) &
                                                   *t)
                                         if (rsvec) then
                                             call la_${ri}$rot(mvl,v(1,p),1,v(1,q),1,cs, &
                                                       conjg(ompq)*t)
                                         end if
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq1))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq1))
                                         mxsinj = max(mxsinj,abs(t))
                                      else
                       ! Choose Correct Signum For Theta And Rotate
                                         thsign = -sign(one,aapq1)
                                         t = one/(theta + thsign*sqrt(one + theta*theta))

                                         cs = sqrt(one/(one + t*t))
                                         sn = t*cs
                                         mxsinj = max(mxsinj,abs(sn))
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq1))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq1))
                                         call la_${ri}$rot(m,a(1,p),1,a(1,q),1,cs,conjg(ompq) &
                                                   *sn)
                                         if (rsvec) then
                                             call la_${ri}$rot(mvl,v(1,p),1,v(1,q),1,cs, &
                                                       conjg(ompq)*sn)
                                         end if
                                      end if
                                      cwork(p) = -cwork(q)*ompq
                                      else
                    ! .. have to use modified gram-schmidt like transformation
                                      call la_${ri}$copy(m,a(1,p),1,cwork(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aapp,one,m,1,cwork(n + 1), &
                                                lda,ierr)
                                      call la_${ri}$lascl('G',0,0,aaqq,one,m,1,a(1,q), &
                                                lda,ierr)
                                      call la_${ri}$axpy(m,-aapq,cwork(n + 1),1,a(1,q),1)

                                      call la_${ri}$lascl('G',0,0,one,aaqq,m,1,a(1,q), &
                                                lda,ierr)
                                      sva(q) = aaqq*sqrt(max(zero,one - aapq1*aapq1))
                                      mxsinj = max(mxsinj,sfmin)
                                   end if
                 ! end if rotok then ... else
                 ! in the case of cancellation in updating sva(q), sva(p)
                 ! recompute sva(q), sva(p).
                                   if ((sva(q)/aaqq)**2 <= rooteps) then
                                      if ((aaqq < rootbig) .and. (aaqq > rootsfmin)) then
                                         sva(q) = la_${ci}$${ri}$nrm2(m,a(1,q),1)
                                      else
                                         t = zero
                                         aaqq = one
                                         call la_${ri}$lassq(m,a(1,q),1,t,aaqq)
                                         sva(q) = t*sqrt(aaqq)
                                      end if
                                   end if
                                   if ((aapp/aapp0) <= rooteps) then
                                      if ((aapp < rootbig) .and. (aapp > rootsfmin)) then
                                         aapp = la_${ci}$${ri}$nrm2(m,a(1,p),1)
                                      else
                                         t = zero
                                         aapp = one
                                         call la_${ri}$lassq(m,a(1,p),1,t,aapp)
                                         aapp = t*sqrt(aapp)
                                      end if
                                      sva(p) = aapp
                                   end if
                                else
                                   ! a(:,p) and a(:,q) already numerically orthogonal
                                   if (ir1 == 0) notrot = notrot + 1
      ! [rtd]      skipped  = skipped + 1
                                   pskipped = pskipped + 1
                                end if
                             else
                                ! a(:,q) is zero column
                                if (ir1 == 0) notrot = notrot + 1
                                pskipped = pskipped + 1
                             end if
                             if ((i <= swband) .and. (pskipped > rowskip)) then
                                if (ir1 == 0) aapp = -aapp
                                notrot = 0
                                go to 2103
                             end if
                          end do loop_2002
           ! end q-loop
           2103 continue
           ! bailed out of q-loop
                          sva(p) = aapp
                       else
                          sva(p) = aapp
                          if ((ir1 == 0) .and. (aapp == zero)) notrot = notrot + min(igl + kbl - 1, &
                                    n) - p
                       end if
                    end do loop_2001
           ! end of the p-loop
           ! end of doing the block ( ibr, ibr )
                 end do loop_1002
           ! end of ir1-loop
       ! ... go to the off diagonal blocks
                 igl = (ibr - 1)*kbl + 1
                 loop_2010: do jbc = ibr + 1,nbl
                    jgl = (jbc - 1)*kbl + 1
              ! doing the block at ( ibr, jbc )
                    ijblsk = 0
                    loop_2100: do p = igl,min(igl + kbl - 1,n)
                       aapp = sva(p)
                       if (aapp > zero) then
                          pskipped = 0
                          loop_2200: do q = jgl,min(jgl + kbl - 1,n)
                             aaqq = sva(q)
                             if (aaqq > zero) then
                                aapp0 = aapp
           ! M X 2 Jacobi Svd
              ! safe gram matrix computation
                                if (aaqq >= one) then
                                   if (aapp >= aaqq) then
                                      rotok = (small*aapp) <= aaqq
                                   else
                                      rotok = (small*aaqq) <= aapp
                                   end if
                                   if (aapp < (big/aaqq)) then
                                      aapq = (la_${ri}$dotc(m,a(1,p),1,a(1,q),1)/ &
                                                aaqq)/aapp
                                   else
                                      call la_${ri}$copy(m,a(1,p),1,cwork(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aapp,one,m,1,cwork(n + 1), &
                                                lda,ierr)
                                      aapq = la_${ri}$dotc(m,cwork(n + 1),1,a(1,q),1)/ &
                                                aaqq
                                   end if
                                else
                                   if (aapp >= aaqq) then
                                      rotok = aapp <= (aaqq/small)
                                   else
                                      rotok = aaqq <= (aapp/small)
                                   end if
                                   if (aapp > (small/aaqq)) then
                                      aapq = (la_${ri}$dotc(m,a(1,p),1,a(1,q),1)/max( &
                                                aaqq,aapp))/min(aaqq,aapp)
                                   else
                                      call la_${ri}$copy(m,a(1,q),1,cwork(n + 1),1)
                                      call la_${ri}$lascl('G',0,0,aaqq,one,m,1,cwork(n + 1), &
                                                lda,ierr)
                                      aapq = la_${ri}$dotc(m,a(1,p),1,cwork(n + 1),1)/ &
                                                aapp
                                   end if
                                end if
                                 ! aapq = aapq * conjg(cwork(p))*cwork(q)
                                aapq1 = -abs(aapq)
                                mxaapq = max(mxaapq,-aapq1)
              ! to rotate or not to rotate, that is the question ...
                                if (abs(aapq1) > tol) then
                                   ompq = aapq/abs(aapq)
                                   notrot = 0
      ! [rtd]      rotated  = rotated + 1
                                   pskipped = 0
                                   iswrot = iswrot + 1
                                   if (rotok) then
                                      aqoap = aaqq/aapp
                                      apoaq = aapp/aaqq
                                      theta = -half*abs(aqoap - apoaq)/aapq1
                                      if (aaqq > aapp0) theta = -theta
                                      if (abs(theta) > bigtheta) then
                                         t = half/theta
                                         cs = one
                                         call la_${ri}$rot(m,a(1,p),1,a(1,q),1,cs,conjg(ompq) &
                                                   *t)
                                         if (rsvec) then
                                             call la_${ri}$rot(mvl,v(1,p),1,v(1,q),1,cs, &
                                                       conjg(ompq)*t)
                                         end if
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq1))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq1))
                                         mxsinj = max(mxsinj,abs(t))
                                      else
                       ! Choose Correct Signum For Theta And Rotate
                                         thsign = -sign(one,aapq1)
                                         if (aaqq > aapp0) thsign = -thsign
                                         t = one/(theta + thsign*sqrt(one + theta*theta))

                                         cs = sqrt(one/(one + t*t))
                                         sn = t*cs
                                         mxsinj = max(mxsinj,abs(sn))
                                         sva(q) = aaqq*sqrt(max(zero,one + t*apoaq*aapq1))

                                         aapp = aapp*sqrt(max(zero,one - t*aqoap*aapq1))
                                         call la_${ri}$rot(m,a(1,p),1,a(1,q),1,cs,conjg(ompq) &
                                                   *sn)
                                         if (rsvec) then
                                             call la_${ri}$rot(mvl,v(1,p),1,v(1,q),1,cs, &
                                                       conjg(ompq)*sn)
                                         end if
                                      end if
                                      cwork(p) = -cwork(q)*ompq
                                   else
                    ! .. have to use modified gram-schmidt like transformation
                                    if (aapp > aaqq) then
                                         call la_${ri}$copy(m,a(1,p),1,cwork(n + 1),1)

                                         call la_${ri}$lascl('G',0,0,aapp,one,m,1,cwork(n + 1) &
                                                   ,lda,ierr)
                                         call la_${ri}$lascl('G',0,0,aaqq,one,m,1,a(1,q), &
                                                    lda,ierr)
                                         call la_${ri}$axpy(m,-aapq,cwork(n + 1),1,a(1,q),1)

                                         call la_${ri}$lascl('G',0,0,one,aaqq,m,1,a(1,q), &
                                                    lda,ierr)
                                         sva(q) = aaqq*sqrt(max(zero,one - aapq1*aapq1))

                                         mxsinj = max(mxsinj,sfmin)
                                    else
                                        call la_${ri}$copy(m,a(1,q),1,cwork(n + 1),1)
                                         call la_${ri}$lascl('G',0,0,aaqq,one,m,1,cwork(n + 1) &
                                                   ,lda,ierr)
                                         call la_${ri}$lascl('G',0,0,aapp,one,m,1,a(1,p), &
                                                    lda,ierr)
                                         call la_${ri}$axpy(m,-conjg(aapq),cwork(n + 1),1,a(1, &
                                                   p),1)
                                         call la_${ri}$lascl('G',0,0,one,aapp,m,1,a(1,p), &
                                                    lda,ierr)
                                         sva(p) = aapp*sqrt(max(zero,one - aapq1*aapq1))

                                         mxsinj = max(mxsinj,sfmin)
                                    end if
                                   end if
                 ! end if rotok then ... else
                 ! in the case of cancellation in updating sva(q), sva(p)
                 ! .. recompute sva(q), sva(p)
                                   if ((sva(q)/aaqq)**2 <= rooteps) then
                                      if ((aaqq < rootbig) .and. (aaqq > rootsfmin)) then
                                         sva(q) = la_${ci}$${ri}$nrm2(m,a(1,q),1)
                                       else
                                         t = zero
                                         aaqq = one
                                         call la_${ri}$lassq(m,a(1,q),1,t,aaqq)
                                         sva(q) = t*sqrt(aaqq)
                                      end if
                                   end if
                                   if ((aapp/aapp0)**2 <= rooteps) then
                                      if ((aapp < rootbig) .and. (aapp > rootsfmin)) then
                                         aapp = la_${ci}$${ri}$nrm2(m,a(1,p),1)
                                      else
                                         t = zero
                                         aapp = one
                                         call la_${ri}$lassq(m,a(1,p),1,t,aapp)
                                         aapp = t*sqrt(aapp)
                                      end if
                                      sva(p) = aapp
                                   end if
                    ! end of ok rotation
                                else
                                   notrot = notrot + 1
      ! [rtd]      skipped  = skipped  + 1
                                   pskipped = pskipped + 1
                                   ijblsk = ijblsk + 1
                                end if
                             else
                                notrot = notrot + 1
                                pskipped = pskipped + 1
                                ijblsk = ijblsk + 1
                             end if
                             if ((i <= swband) .and. (ijblsk >= blskip)) then
                                sva(p) = aapp
                                notrot = 0
                                go to 2011
                             end if
                             if ((i <= swband) .and. (pskipped > rowskip)) then
                                aapp = -aapp
                                notrot = 0
                                go to 2203
                             end if
                          end do loop_2200
              ! end of the q-loop
              2203 continue
                          sva(p) = aapp
                       else
                          if (aapp == zero) notrot = notrot + min(jgl + kbl - 1,n) - jgl + 1
                          if (aapp < zero) notrot = 0
                       end if
                    end do loop_2100
           ! end of the p-loop
                 end do loop_2010
           ! end of the jbc-loop
           2011 continue
      ! 2011 bailed out of the jbc-loop
                 do p = igl,min(igl + kbl - 1,n)
                    sva(p) = abs(sva(p))
                 end do
      ! **
              end do loop_2000
      ! 2000 :: end of the ibr-loop
           ! .. update sva(n)
              if ((sva(n) < rootbig) .and. (sva(n) > rootsfmin)) then
                 sva(n) = la_${ci}$${ri}$nrm2(m,a(1,n),1)
              else
                 t = zero
                 aapp = one
                 call la_${ri}$lassq(m,a(1,n),1,t,aapp)
                 sva(n) = t*sqrt(aapp)
              end if
           ! additional steering devices
              if ((i < swband) .and. ((mxaapq <= roottol) .or. (iswrot <= n))) swband = i
              if ((i > swband + 1) .and. (mxaapq < sqrt(real(n,KIND=${rk}$))*tol) .and. (real(n, &
                        KIND=${rk}$)*mxaapq*mxsinj < tol)) then
                 go to 1994
              end if
              if (notrot >= emptsw) go to 1994
           end do loop_1993
           ! end i=1:nsweep loop
       ! #:( reaching this point means that the procedure has not converged.
           info = nsweep - 1
           go to 1995
           1994 continue
       ! #:) reaching this point means numerical convergence after the i-th
           ! sweep.
           info = 0
       ! #:) info = 0 confirms successful iterations.
       1995 continue
           ! sort the singular values and find how many are above
           ! the underflow threshold.
           n2 = 0
           n4 = 0
           do p = 1,n - 1
              q = la_i${ci}$amax(n - p + 1,sva(p),1) + p - 1
              if (p /= q) then
                 temp1 = sva(p)
                 sva(p) = sva(q)
                 sva(q) = temp1
                 call la_${ri}$swap(m,a(1,p),1,a(1,q),1)
                 if (rsvec) call la_${ri}$swap(mvl,v(1,p),1,v(1,q),1)
              end if
              if (sva(p) /= zero) then
                 n4 = n4 + 1
                 if (sva(p)*skl > sfmin) n2 = n2 + 1
              end if
           end do
           if (sva(n) /= zero) then
              n4 = n4 + 1
              if (sva(n)*skl > sfmin) n2 = n2 + 1
           end if
           ! normalize the left singular vectors.
           if (lsvec .or. uctol) then
              do p = 1,n4
                  ! call la_${ri}$${ci}$scal( m, one / sva( p ), a( 1, p ), 1 )
                 call la_${ri}$lascl('G',0,0,sva(p),one,m,1,a(1,p),m,ierr)
              end do
           end if
           ! scale the product of jacobi rotations.
           if (rsvec) then
                 do p = 1,n
                    temp1 = one/la_${ci}$${ri}$nrm2(mvl,v(1,p),1)
                    call la_${ri}$${ci}$scal(mvl,temp1,v(1,p),1)
                 end do
           end if
           ! undo scaling, if necessary (and possible).
           if (((skl > one) .and. (sva(1) < (big/skl))) .or. ((skl < one) .and. (sva( &
                     max(n2,1)) > (sfmin/skl)))) then
              do p = 1,n
                 sva(p) = skl*sva(p)
              end do
              skl = one
           end if
           rwork(1) = skl
           ! the singular values of a are skl*sva(1:n). if skl/=one
           ! then some of the singular values may overflow or underflow and
           ! the spectrum is given in this factored representation.
           rwork(2) = real(n4,KIND=${rk}$)
           ! n4 is the number of computed nonzero singular values of a.
           rwork(3) = real(n2,KIND=${rk}$)
           ! n2 is the number of singular values of a greater than sfmin.
           ! if n2<n, sva(n2:n) contains zeros and/or denormalized numbers
           ! that may carry some information.
           rwork(4) = real(i,KIND=${rk}$)
           ! i is the index of the last sweep before declaring convergence.
           rwork(5) = mxaapq
           ! mxaapq is the largest absolute value of scaled pivots in the
           ! last sweep
           rwork(6) = mxsinj
           ! mxsinj is the largest absolute value of the sines of jacobi angles
           ! in the last sweep
           return
     end subroutine la_${ri}$gesvj
#:endfor

end module la_lapack_eigv_svd_drivers2
