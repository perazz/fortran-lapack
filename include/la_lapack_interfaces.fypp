    &  [('cpotri', 'cpotri', 'complex'), ('dpotri', 'dpotri', 'real'), ('qpotri', 'qpotri', None), ('spotri', 'spotri', 'real'), ('wpotri', 'wpotri', None), ('xpotri', 'xpotri', None), ('ypotri', 'ypotri', None), ('zpotri', 'zpotri', 'complex')], &
    &  {'complex': '               pure subroutine {ri}potri(uplo,n,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}potri', 'real': '               pure subroutine {ri}potri(uplo,n,a,lda,info)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    character,intent(in) :: uplo\n                    integer(ilp),intent(out) :: info\n                    integer(ilp),intent(in) :: lda,n\n                    {rt},intent(inout) :: a(lda,*)\n               end subroutine {ri}potri'}), &
