    & ('pbstf', ['PBSTF: computes a split Cholesky factorization of a complex', 'Hermitian positive definite band matrix A.', 'This routine is designed to be used in conjunction with CHBGST.', 'The factorization has the form  A = S**H*S  where S is a band matrix', 'of the same bandwidth as A and the following structure:', 'S = ( U    )', '( M  L )', 'where U is upper triangular of order m = (n+kd)/2, and L is lower', 'triangular of order n-m.'], &
    &  [('cpbstf', 'cpbstf', 'complex'), ('dpbstf', 'dpbstf', 'real'), ('qpbstf', 'qpbstf', None), ('spbstf', 'spbstf', 'real'), ('wpbstf', 'wpbstf', None), ('xpbstf', 'xpbstf', None), ('ypbstf', 'ypbstf', None), ('zpbstf', 'zpbstf', 'complex')], &
