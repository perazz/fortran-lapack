    &  [('cla_wwaddw', 'cla_wwaddw', 'complex'), ('dla_wwaddw', 'dla_wwaddw', 'real'), ('qla_wwaddw', 'qla_wwaddw', None), ('sla_wwaddw', 'sla_wwaddw', 'real'), ('wla_wwaddw', 'wla_wwaddw', None), ('xla_wwaddw', 'xla_wwaddw', None), ('yla_wwaddw', 'yla_wwaddw', None), ('zla_wwaddw', 'zla_wwaddw', 'complex')], &
    &  {'complex': '               pure subroutine {ri}la_wwaddw(n,x,y,w)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: x(*),y(*)\n                    {rt},intent(in) :: w(*)\n               end subroutine {ri}la_wwaddw', 'real': '               pure subroutine {ri}la_wwaddw(n,x,y,w)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: n\n                    {rt},intent(inout) :: x(*),y(*)\n                    {rt},intent(in) :: w(*)\n               end subroutine {ri}la_wwaddw'}), &
    & ('labad', ['LABAD: takes as input the values computed by DLAMCH for underflow and', 'overflow, and returns the square root of each of these values if the', 'log of LARGE is sufficiently large.  This subroutine is intended to', 'identify machines with a large exponent range, such as the Crays, and', 'redefine the underflow and overflow limits to be the square roots of', 'the values computed by DLAMCH.  This subroutine is needed because', 'DLAMCH does not compensate for poor arithmetic in the upper half of', 'the exponent range, as is found on a Cray.'], &
    &  [('dlabad', 'dlabad', 'real'), ('qlabad', 'qlabad', None), ('slabad', 'slabad', 'real'), ('xlabad', 'xlabad', None)], &
    &  {'real': '               pure subroutine {ri}labad(small,large)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    {rt},intent(inout) :: large,small\n               end subroutine {ri}labad'}), &
    & ('labrd', ['LABRD: reduces the first NB rows and columns of a complex general', 'm by n matrix A to upper or lower real bidiagonal form by a unitary', 'transformation Q**H * A * P, and returns the matrices X and Y which', 'are needed to apply the transformation to the unreduced part of A.', 'If m >= n, A is reduced to upper bidiagonal form; if m < n, to lower', 'bidiagonal form.', 'This is an auxiliary routine called by CGEBRD'], &
    &  [('clabrd', 'clabrd', 'complex'), ('dlabrd', 'dlabrd', 'real'), ('qlabrd', 'qlabrd', None), ('slabrd', 'slabrd', 'real'), ('wlabrd', 'wlabrd', None), ('xlabrd', 'xlabrd', None), ('ylabrd', 'ylabrd', None), ('zlabrd', 'zlabrd', 'complex')], &
    &  {'complex': '               pure subroutine {ri}labrd(m,n,nb,a,lda,d,e,tauq,taup,x,ldx,y,ldy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: lda,ldx,ldy,m,n,nb\n                    real({rk}),intent(out) :: d(*),e(*)\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: taup(*),tauq(*),x(ldx,*),y(ldy,*)\n               end subroutine {ri}labrd', 'real': '               pure subroutine {ri}labrd(m,n,nb,a,lda,d,e,tauq,taup,x,ldx,y,ldy)\n                    import sp,dp,qp,ilp,lk\n                    implicit none(type,external)\n                    integer(ilp),intent(in) :: lda,ldx,ldy,m,n,nb\n                    {rt},intent(inout) :: a(lda,*)\n                    {rt},intent(out) :: d(*),e(*),taup(*),tauq(*),x(ldx,*),y(ldy,*)\n               end subroutine {ri}labrd'}), &
    & ('lacgv', ['LACGV: conjugates a complex vector of length N.'], &
