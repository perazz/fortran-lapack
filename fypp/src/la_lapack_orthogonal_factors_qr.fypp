#:include "common.fypp"
!> QR and RQ factorizations: blocked, tall-skinny, pivoted and triangular-pentagonal variants
module la_lapack_orthogonal_factors_qr
     use la_constants
     use la_blas_aux
     use la_blas_level1
     use la_blas_level2_gen
     use la_blas_level2_tri
     use la_blas_level3_gen
     use la_blas_level3_tri
     use la_lapack_aux
     use la_lapack_auxiliary
     use la_lapack_blas_like_base
     use la_lapack_blas_like_l1
     use la_lapack_householder_reflectors
     implicit none(type,external)
     private

     public :: sp,dp,qp,lk,ilp
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     public :: la_${ri}$laorhr_col_getrfnp2
     public :: la_${ri}$larfb_gett
     public :: la_${ri}$org2r
     public :: la_${ri}$orgqr
     public :: la_${ri}$orgr2
     public :: la_${ri}$orgrq
     public :: la_${ri}$orgtsqr_row
     public :: la_${ri}$orm2r
     public :: la_${ri}$ormqr
     public :: la_${ri}$ormr2
     public :: la_${ri}$ormrq
     public :: la_${ri}$tprfb
     public :: la_${ri}$gemqrt
     public :: la_${ri}$laorhr_col_getrfnp
     public :: la_${ri}$orhr_col
     public :: la_${ri}$tpmqrt
     public :: la_${ri}$tpqrt2
     public :: la_${ri}$geqr2
     public :: la_${ri}$geqr2p
     public :: la_${ri}$geqrf
     public :: la_${ri}$geqrfp
     public :: la_${ri}$geqrt2
     public :: la_${ri}$geqrt3
     public :: la_${ri}$gerq2
     public :: la_${ri}$gerqf
     public :: la_${ri}$ggqrf
     public :: la_${ri}$ggrqf
     public :: la_${ri}$lamtsqr
     public :: la_${ri}$laqp2
     public :: la_${ri}$laqps
     public :: la_${ri}$orgtsqr
     public :: la_${ri}$tpqrt
     public :: la_${ri}$gemqr
     public :: la_${ri}$geqp3
     public :: la_${ri}$geqrt
     public :: la_${ri}$latsqr
     public :: la_${ri}$geqr
     public :: la_${ri}$getsqrhrt
#:endfor
#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     public :: la_${ri}$larfb_gett
     public :: la_${ri}$launhr_col_getrfnp2
     public :: la_${ri}$tpqrt2
     public :: la_${ri}$tprfb
     public :: la_${ri}$ung2r
     public :: la_${ri}$ungqr
     public :: la_${ri}$ungr2
     public :: la_${ri}$ungrq
     public :: la_${ri}$ungtsqr_row
     public :: la_${ri}$unm2r
     public :: la_${ri}$unmqr
     public :: la_${ri}$unmr2
     public :: la_${ri}$unmrq
     public :: la_${ri}$gemqrt
     public :: la_${ri}$geqr2
     public :: la_${ri}$geqr2p
     public :: la_${ri}$geqrf
     public :: la_${ri}$geqrfp
     public :: la_${ri}$geqrt2
     public :: la_${ri}$geqrt3
     public :: la_${ri}$gerq2
     public :: la_${ri}$gerqf
     public :: la_${ri}$ggqrf
     public :: la_${ri}$ggrqf
     public :: la_${ri}$laqp2
     public :: la_${ri}$laqps
     public :: la_${ri}$launhr_col_getrfnp
     public :: la_${ri}$tpmqrt
     public :: la_${ri}$tpqrt
     public :: la_${ri}$unhr_col
     public :: la_${ri}$geqp3
     public :: la_${ri}$geqrt
     public :: la_${ri}$lamtsqr
     public :: la_${ri}$latsqr
     public :: la_${ri}$ungtsqr
     public :: la_${ri}$gemqr
     public :: la_${ri}$geqr
     public :: la_${ri}$getsqrhrt
#:endfor

     contains

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAORHR_COL_GETRFNP2: computes the modified LU factorization without
     !> pivoting of a real general M-by-N matrix A. The factorization has
     !> the form:
     !> A - S = L * U,
     !> where:
     !> S is a m-by-n diagonal sign matrix with the diagonal D, so that
     !> D(i) = S(i,i), 1 <= i <= min(M,N). The diagonal D is constructed
     !> as D(i)=-SIGN(A(i,i)), where A(i,i) is the value after performing
     !> i-1 steps of Gaussian elimination. This means that the diagonal
     !> element at each step of "modified" Gaussian elimination is at
     !> least one in absolute value (so that division-by-zero not
     !> possible during the division by the diagonal element);
     !> L is a M-by-N lower triangular matrix with unit diagonal elements
     !> (lower trapezoidal if M > N);
     !> and U is a M-by-N upper triangular matrix
     !> (upper trapezoidal if M < N).
     !> This routine is an auxiliary routine used in the Householder
     !> reconstruction routine ${ri.upper()}$ORHR_COL. In ${ri.upper()}$ORHR_COL, this routine is
     !> applied to an M-by-N matrix A with orthonormal columns, where each
     !> element is bounded by one in absolute value. With the choice of
     !> the matrix S above, one can show that the diagonal element at each
     !> step of Gaussian elimination is the largest (in absolute value) in
     !> the column on or below the diagonal, so that no pivoting is required
     !> for numerical stability [1].
     !> For more details on the Householder reconstruction algorithm,
     !> including the modified LU factorization, see [1].
     !> This is the recursive version of the LU factorization algorithm.
     !> Denote A - S by B. The algorithm divides the matrix B into four
     !> submatrices:
     !> [  B11 | B12  ]  where B11 is n1 by n1,
     !> B = [ -----|----- ]        B21 is (m-n1) by n1,
     !> [  B21 | B22  ]        B12 is n1 by n2,
     !> B22 is (m-n1) by n2,
     !> with n1 = min(m,n)/2, n2 = n-n1.
     !> The subroutine calls itself to factor B11, solves for B21,
     !> solves for B12, updates B22, then calls itself to factor B22.
     !> For more details on the recursive LU algorithm, see [2].
     !> ${ri.upper()}$LAORHR_COL_GETRFNP2 is called to factorize a block by the blocked
     !> routine ${ri.upper()}$LAORHR_COL_GETRFNP, which uses blocked code calling
     !> Level 3 BLAS to update the submatrix. However, ${ri.upper()}$LAORHR_COL_GETRFNP2
     !> is self-sufficient and can be used without ${ri.upper()}$LAORHR_COL_GETRFNP.
     !> [1] "Reconstructing Householder vectors from tall-skinny QR",
     !> G. Ballard, J. Demmel, L. Grigori, M. Jacquelin, H.D. Nguyen,
     !> E. Solomonik, J. Parallel Distrib. Comput.,
     !> vol. 85, pp. 3-31, 2015.
     !> [2] "Recursion leads to automatic variable blocking for dense linear
     !> algebra algorithms", F. Gustavson, IBM J. of Res. and Dev.,
     !> vol. 41, no. 6, pp. 737-755, 1997.

     pure recursive subroutine la_${ri}$laorhr_col_getrfnp2(m,n,a,lda,d,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: d(*)
        ! =====================================================================

           ! Local Scalars
           real(${rk}$) :: sfmin
           integer(ilp) :: i,iinfo,n1,n2
           ! Intrinsic Functions
           intrinsic :: abs,sign,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$LAORHR_COL_GETRFNP2',-info)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) return
           if (m == 1) then
              ! one row case, (also recursion termination case),
              ! use unblocked code
              ! transfer the sign
              d(1) = -sign(one,a(1,1))
              ! construct the row of u
              a(1,1) = a(1,1) - d(1)
           else if (n == 1) then
              ! one column case, (also recursion termination case),
              ! use unblocked code
              ! transfer the sign
              d(1) = -sign(one,a(1,1))
              ! construct the row of u
              a(1,1) = a(1,1) - d(1)
              ! scale the elements 2:m of the column
              ! determine machine safe minimum
              sfmin = la_${ri}$lamch('S')
              ! construct the subdiagonal elements of l
              if (abs(a(1,1)) >= sfmin) then
                 call la_${ri}$scal(m - 1,one/a(1,1),a(2,1),1)
              else
                 do i = 2,m
                    a(i,1) = a(i,1)/a(1,1)
                 end do
              end if
           else
              ! divide the matrix b into four submatrices
              n1 = min(m,n)/2
              n2 = n - n1
              ! factor b11, recursive call
              call la_${ri}$laorhr_col_getrfnp2(n1,n1,a,lda,d,iinfo)
              ! solve for b21
              call la_${ri}$trsm('R','U','N','N',m - n1,n1,one,a,lda,a(n1 + 1,1),lda)

              ! solve for b12
              call la_${ri}$trsm('L','L','N','U',n1,n2,one,a,lda,a(1,n1 + 1),lda)

              ! update b22, i.e. compute the schur complement
              ! b22 := b22 - b21*b12
              call la_${ri}$gemm('N','N',m - n1,n2,n1,-one,a(n1 + 1,1),lda,a(1,n1 + 1), &
                        lda,one,a(n1 + 1,n1 + 1),lda)
              ! factor b22, recursive call
              call la_${ri}$laorhr_col_getrfnp2(m - n1,n2,a(n1 + 1,n1 + 1),lda,d(n1 + 1),iinfo)

           end if
           return
     end subroutine la_${ri}$laorhr_col_getrfnp2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LARFB_GETT: applies a real Householder block reflector H from the
     !> left to a real (K+M)-by-N  "triangular-pentagonal" matrix
     !> composed of two block matrices: an upper trapezoidal K-by-N matrix A
     !> stored in the array A, and a rectangular M-by-(N-K) matrix B, stored
     !> in the array B. The block reflector H is stored in a compact
     !> WY-representation, where the elementary reflectors are in the
     !> arrays A, B and T. See Further Details section.

     pure subroutine la_${ri}$larfb_gett(ident,m,n,k,t,ldt,a,lda,b,ldb,work,ldwork)
        use la_constants_${rk}$

        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: ident
           integer(ilp),intent(in) :: k,lda,ldb,ldt,ldwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(in) :: t(ldt,*)
           real(${rk}$),intent(out) :: work(ldwork,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lnotident
           integer(ilp) :: i,j
           ! Executable Statements
           ! quick return if possible
           if (m < 0 .or. n <= 0 .or. k == 0 .or. k > n) return
           lnotident = .not. la_lsame(ident,'I')
           ! ------------------------------------------------------------------
           ! first step. computation of the column block 2:
              ! ( a2 ) := h * ( a2 )
              ! ( b2 )        ( b2 )
           ! ------------------------------------------------------------------
           if (n > k) then
              ! col2_(1) compute w2: = a2. therefore, copy a2 = a(1:k, k+1:n)
              ! into w2=work(1:k, 1:n-k) column-by-column.
              do j = 1,n - k
                 call la_${ri}$copy(k,a(1,k + j),1,work(1,j),1)
              end do
              if (lnotident) then
                 ! col2_(2) compute w2: = (v1**t) * w2 = (a1**t) * w2,
                 ! v1 is not an identy matrix, but unit lower-triangular
                 ! v1 stored in a1 (diagonal ones are not stored).
                 call la_${ri}$trmm('L','L','T','U',k,n - k,one,a,lda,work,ldwork)
              end if
              ! col2_(3) compute w2: = w2 + (v2**t) * b2 = w2 + (b1**t) * b2
              ! v2 stored in b1.
              if (m > 0) then
                 call la_${ri}$gemm('T','N',k,n - k,m,one,b,ldb,b(1,k + 1),ldb,one,work, &
                           ldwork)
              end if
              ! col2_(4) compute w2: = t * w2,
              ! t is upper-triangular.
              call la_${ri}$trmm('L','U','N','N',k,n - k,one,t,ldt,work,ldwork)
              ! col2_(5) compute b2: = b2 - v2 * w2 = b2 - b1 * w2,
              ! v2 stored in b1.
              if (m > 0) then
                 call la_${ri}$gemm('N','N',m,n - k,k,-one,b,ldb,work,ldwork,one,b(1,k + &
                           1),ldb)
              end if
              if (lnotident) then
                 ! col2_(6) compute w2: = v1 * w2 = a1 * w2,
                 ! v1 is not an identity matrix, but unit lower-triangular,
                 ! v1 stored in a1 (diagonal ones are not stored).
                 call la_${ri}$trmm('L','L','N','U',k,n - k,one,a,lda,work,ldwork)
              end if
              ! col2_(7) compute a2: = a2 - w2 =
                                   ! = a(1:k, k+1:n-k) - work(1:k, 1:n-k),
              ! column-by-column.
              do j = 1,n - k
                 do i = 1,k
                    a(i,k + j) = a(i,k + j) - work(i,j)
                 end do
              end do
           end if
           ! ------------------------------------------------------------------
           ! second step. computation of the column block 1:
              ! ( a1 ) := h * ( a1 )
              ! ( b1 )        (  0 )
           ! ------------------------------------------------------------------
           ! col1_(1) compute w1: = a1. copy the upper-triangular
           ! a1 = a(1:k, 1:k) into the upper-triangular
           ! w1 = work(1:k, 1:k) column-by-column.
           do j = 1,k
              call la_${ri}$copy(j,a(1,j),1,work(1,j),1)
           end do
           ! set the subdiagonal elements of w1 to zero column-by-column.
           do j = 1,k - 1
              do i = j + 1,k
                 work(i,j) = zero
              end do
           end do
           if (lnotident) then
              ! col1_(2) compute w1: = (v1**t) * w1 = (a1**t) * w1,
              ! v1 is not an identity matrix, but unit lower-triangular
              ! v1 stored in a1 (diagonal ones are not stored),
              ! w1 is upper-triangular with zeroes below the diagonal.
              call la_${ri}$trmm('L','L','T','U',k,k,one,a,lda,work,ldwork)
           end if
           ! col1_(3) compute w1: = t * w1,
           ! t is upper-triangular,
           ! w1 is upper-triangular with zeroes below the diagonal.
           call la_${ri}$trmm('L','U','N','N',k,k,one,t,ldt,work,ldwork)
           ! col1_(4) compute b1: = - v2 * w1 = - b1 * w1,
           ! v2 = b1, w1 is upper-triangular with zeroes below the diagonal.
           if (m > 0) then
              call la_${ri}$trmm('R','U','N','N',m,k,-one,work,ldwork,b,ldb)
           end if
           if (lnotident) then
              ! col1_(5) compute w1: = v1 * w1 = a1 * w1,
              ! v1 is not an identity matrix, but unit lower-triangular
              ! v1 stored in a1 (diagonal ones are not stored),
              ! w1 is upper-triangular on input with zeroes below the diagonal,
              ! and square on output.
              call la_${ri}$trmm('L','L','N','U',k,k,one,a,lda,work,ldwork)
              ! col1_(6) compute a1: = a1 - w1 = a(1:k, 1:k) - work(1:k, 1:k)
              ! column-by-column. a1 is upper-triangular on input.
              ! if ident, a1 is square on output, and w1 is square,
              ! if not ident, a1 is upper-triangular on output,
              ! w1 is upper-triangular.
              ! col1_(6)_a compute elements of a1 below the diagonal.
              do j = 1,k - 1
                 do i = j + 1,k
                    a(i,j) = -work(i,j)
                 end do
              end do
           end if
           ! col1_(6)_b compute elements of a1 on and above the diagonal.
           do j = 1,k
              do i = 1,j
                 a(i,j) = a(i,j) - work(i,j)
              end do
           end do
           return
     end subroutine la_${ri}$larfb_gett
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORG2R: generates an m by n real matrix Q with orthonormal columns,
     !> which is defined as the first n columns of a product of k elementary
     !> reflectors of order m
     !> Q  =  H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF.

     pure subroutine la_${ri}$org2r(m,n,k,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,j,l
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0 .or. n > m) then
              info = -2
           else if (k < 0 .or. k > n) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORG2R',-info)
              return
           end if
           ! quick return if possible
           if (n <= 0) return
           ! initialise columns k+1:n to columns of the unit matrix
           do j = k + 1,n
              do l = 1,m
                 a(l,j) = zero
              end do
              a(j,j) = one
           end do
           do i = k,1,-1
              ! apply h(i) to a(i:m,i:n) from the left
              if (i < n) then
                 a(i,i) = one
                 call la_${ri}$larf('LEFT',m - i + 1,n - i,a(i,i),1,tau(i),a(i,i + 1),lda, &
                           work)
              end if
              if (i < m) call la_${ri}$scal(m - i,-tau(i),a(i + 1,i),1)
              a(i,i) = one - tau(i)
              ! set a(1:i-1,i) to zero
              do l = 1,i - 1
                 a(l,i) = zero
              end do
           end do
           return
     end subroutine la_${ri}$org2r
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORGQR: generates an M-by-N real matrix Q with orthonormal columns,
     !> which is defined as the first N columns of a product of K elementary
     !> reflectors of order M
     !> Q  =  H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF.

     pure subroutine la_${ri}$orgqr(m,n,k,a,lda,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,j,ki,kk,l,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$ORGQR',' ',m,n,k,-1)
           lwkopt = max(1,n)*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0 .or. n > m) then
              info = -2
           else if (k < 0 .or. k > n) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (lwork < max(1,n) .and. .not. lquery) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORGQR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n <= 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           nx = 0
           iws = n
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$ORGQR',' ',m,n,k,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$ORGQR',' ',m,n,k,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code after the last block.
              ! the first kk columns are handled by the block method.
              ki = ((k - nx - 1)/nb)*nb
              kk = min(k,ki + nb)
              ! set a(1:kk,kk+1:n) to zero.
              do j = kk + 1,n
                 do i = 1,kk
                    a(i,j) = zero
                 end do
              end do
           else
              kk = 0
           end if
           ! use unblocked code for the last or only block.
           if (kk < n) call la_${ri}$org2r(m - kk,n - kk,k - kk,a(kk + 1,kk + 1),lda,tau(kk + 1),work, &
                      iinfo)
           if (kk > 0) then
              ! use blocked code
              do i = ki + 1,1,-nb
                 ib = min(nb,k - i + 1)
                 if (i + ib <= n) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i) h(i+1) . . . h(i+ib-1)
                    call la_${ri}$larft('FORWARD','COLUMNWISE',m - i + 1,ib,a(i,i),lda,tau(i &
                              ),work,ldwork)
                    ! apply h to a(i:m,i+ib:n) from the left
                    call la_${ri}$larfb('LEFT','NO TRANSPOSE','FORWARD','COLUMNWISE',m - i + 1,n - &
                    i - ib + 1,ib,a(i,i),lda,work,ldwork,a(i,i + ib),lda,work(ib + 1), &
                              ldwork)
                 end if
                 ! apply h to rows i:m of current block
                 call la_${ri}$org2r(m - i + 1,ib,ib,a(i,i),lda,tau(i),work,iinfo)
                 ! set rows 1:i-1 of current block to zero
                 do j = i,i + ib - 1
                    do l = 1,i - 1
                       a(l,j) = zero
                    end do
                 end do
              end do
           end if
           work(1) = iws
           return
     end subroutine la_${ri}$orgqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORGR2: generates an m by n real matrix Q with orthonormal rows,
     !> which is defined as the last m rows of a product of k elementary
     !> reflectors of order n
     !> Q  =  H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GERQF.

     pure subroutine la_${ri}$orgr2(m,n,k,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,ii,j,l
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < m) then
              info = -2
           else if (k < 0 .or. k > m) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORGR2',-info)
              return
           end if
           ! quick return if possible
           if (m <= 0) return
           if (k < m) then
              ! initialise rows 1:m-k to rows of the unit matrix
              do j = 1,n
                 do l = 1,m - k
                    a(l,j) = zero
                 end do
                 if (j > n - m .and. j <= n - k) a(m - n + j,j) = one
              end do
           end if
           do i = 1,k
              ii = m - k + i
              ! apply h(i) to a(1:m-k+i,1:n-k+i) from the right
              a(ii,n - m + ii) = one
              call la_${ri}$larf('RIGHT',ii - 1,n - m + ii,a(ii,1),lda,tau(i),a,lda,work)

              call la_${ri}$scal(n - m + ii - 1,-tau(i),a(ii,1),lda)
              a(ii,n - m + ii) = one - tau(i)
              ! set a(m-k+i,n-k+i+1:n) to zero
              do l = n - m + ii + 1,n
                 a(ii,l) = zero
              end do
           end do
           return
     end subroutine la_${ri}$orgr2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORGRQ: generates an M-by-N real matrix Q with orthonormal rows,
     !> which is defined as the last M rows of a product of K elementary
     !> reflectors of order N
     !> Q  =  H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GERQF.

     pure subroutine la_${ri}$orgrq(m,n,k,a,lda,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,ii,iinfo,iws,j,kk,l,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < m) then
              info = -2
           else if (k < 0 .or. k > m) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           end if
           if (info == 0) then
              if (m <= 0) then
                 lwkopt = 1
              else
                 nb = la_ilaenv(1,'${ri.upper()}$ORGRQ',' ',m,n,k,-1)
                 lwkopt = m*nb
              end if
              work(1) = lwkopt
              if (lwork < max(1,m) .and. .not. lquery) then
                 info = -8
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORGRQ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m <= 0) then
              return
           end if
           nbmin = 2
           nx = 0
           iws = m
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$ORGRQ',' ',m,n,k,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = m
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$ORGRQ',' ',m,n,k,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code after the first block.
              ! the last kk rows are handled by the block method.
              kk = min(k, ((k - nx + nb - 1)/nb)*nb)
              ! set a(1:m-kk,n-kk+1:n) to zero.
              do j = n - kk + 1,n
                 do i = 1,m - kk
                    a(i,j) = zero
                 end do
              end do
           else
              kk = 0
           end if
           ! use unblocked code for the first or only block.
           call la_${ri}$orgr2(m - kk,n - kk,k - kk,a,lda,tau,work,iinfo)
           if (kk > 0) then
              ! use blocked code
              do i = k - kk + 1,k,nb
                 ib = min(nb,k - i + 1)
                 ii = m - k + i
                 if (ii > 1) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i+ib-1) . . . h(i+1) h(i)
                    call la_${ri}$larft('BACKWARD','ROWWISE',n - k + i + ib - 1,ib,a(ii,1),lda, &
                              tau(i),work,ldwork)
                    ! apply h**t to a(1:m-k+i-1,1:n-k+i+ib-1) from the right
                    call la_${ri}$larfb('RIGHT','TRANSPOSE','BACKWARD','ROWWISE',ii - 1,n - k + i + &
                              ib - 1,ib,a(ii,1),lda,work,ldwork,a,lda,work(ib + 1),ldwork)
                 end if
                 ! apply h**t to columns 1:n-k+i+ib-1 of current block
                 call la_${ri}$orgr2(ib,n - k + i + ib - 1,ib,a(ii,1),lda,tau(i),work,iinfo)

                 ! set columns n-k+i+ib:n of current block to zero
                 do l = n - k + i + ib,n
                    do j = ii,ii + ib - 1
                       a(j,l) = zero
                    end do
                 end do
              end do
           end if
           work(1) = iws
           return
     end subroutine la_${ri}$orgrq
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORGTSQR_ROW: generates an M-by-N real matrix Q_out with
     !> orthonormal columns from the output of ${ri.upper()}$LATSQR. These N orthonormal
     !> columns are the first N columns of a product of complex unitary
     !> matrices Q(k)_in of order M, which are returned by ${ri.upper()}$LATSQR in
     !> a special format.
     !> Q_out = first_N_columns_of( Q(1)_in * Q(2)_in * ... * Q(k)_in ).
     !> The input matrices Q(k)_in are stored in row and column blocks in A.
     !> See the documentation of ${ri.upper()}$LATSQR for more details on the format of
     !> Q(k)_in, where each Q(k)_in is represented by block Householder
     !> transformations. This routine calls an auxiliary routine ${ri.upper()}$LARFB_GETT,
     !> where the computation is performed on each individual block. The
     !> algorithm first sweeps NB-sized column blocks from the right to left
     !> starting in the bottom row block and continues to the top row block
     !> (hence _ROW in the routine name). This sweep is in reverse order of
     !> the order in which ${ri.upper()}$LATSQR generates the output blocks.

     pure subroutine la_${ri}$orgtsqr_row(m,n,mb,nb,a,lda,t,ldt,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,lwork,m,n,mb,nb
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: t(ldt,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: nblocal,mb2,m_plus_one,itmp,ib_bottom,lworkopt, &
                     num_all_row_blocks,jb_t,ib,imb,kb,kb_last,knb,mb1
           ! Local Arrays
           real(${rk}$) :: dummy(1,1)
           ! Intrinsic Functions
           intrinsic :: real,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (n < 0 .or. m < n) then
              info = -2
           else if (mb <= n) then
              info = -3
           else if (nb < 1) then
              info = -4
           else if (lda < max(1,m)) then
              info = -6
           else if (ldt < max(1,min(nb,n))) then
              info = -8
           else if (lwork < 1 .and. .not. lquery) then
              info = -10
           end if
           nblocal = min(nb,n)
           ! determine the workspace size.
           if (info == 0) then
              lworkopt = nblocal*max(nblocal, (n - nblocal))
           end if
           ! handle error in the input parameters and handle the workspace query.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORGTSQR_ROW',-info)
              return
           else if (lquery) then
              work(1) = real(lworkopt,KIND=${rk}$)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              work(1) = real(lworkopt,KIND=${rk}$)
              return
           end if
           ! (0) set the upper-triangular part of the matrix a to zero and
           ! its diagonal elements to one.
           call la_${ri}$laset('U',m,n,zero,one,a,lda)
           ! kb_last is the column index of the last column block reflector
           ! in the matrices t and v.
           kb_last = ((n - 1)/nblocal)*nblocal + 1
           ! (1) bottom-up loop over row blocks of a, except the top row block.
           ! note: if mb>=m, then the loop is never executed.
           if (mb < m) then
              ! mb2 is the row blocking size for the row blocks before the
              ! first top row block in the matrix a. ib is the row index for
              ! the row blocks in the matrix a before the first top row block.
              ! ib_bottom is the row index for the last bottom row block
              ! in the matrix a. jb_t is the column index of the corresponding
              ! column block in the matrix t.
              ! initialize variables.
              ! num_all_row_blocks is the number of row blocks in the matrix a
              ! including the first row block.
              mb2 = mb - n
              m_plus_one = m + 1
              itmp = (m - mb - 1)/mb2
              ib_bottom = itmp*mb2 + mb + 1
              num_all_row_blocks = itmp + 2
              jb_t = num_all_row_blocks*n + 1
              do ib = ib_bottom,mb + 1,-mb2
                 ! determine the block size imb for the current row block
                 ! in the matrix a.
                 imb = min(m_plus_one - ib,mb2)
                 ! determine the column index jb_t for the current column block
                 ! in the matrix t.
                 jb_t = jb_t - n
                 ! apply column blocks of h in the row block from right to left.
                 ! kb is the column index of the current column block reflector
                 ! in the matrices t and v.
                 do kb = kb_last,1,-nblocal
                    ! determine the size of the current column block knb in
                    ! the matrices t and v.
                    knb = min(nblocal,n - kb + 1)
                    call la_${ri}$larfb_gett('I',imb,n - kb + 1,knb,t(1,jb_t + kb - 1),ldt,a(kb, &
                              kb),lda,a(ib,kb),lda,work,knb)
                 end do
              end do
           end if
           ! (2) top row block of a.
           ! note: if mb>=m, then we have only one row block of a of size m
           ! and we work on the entire matrix a.
           mb1 = min(mb,m)
           ! apply column blocks of h in the top row block from right to left.
           ! kb is the column index of the current block reflector in
           ! the matrices t and v.
           do kb = kb_last,1,-nblocal
              ! determine the size of the current column block knb in
              ! the matrices t and v.
              knb = min(nblocal,n - kb + 1)
              if (mb1 - kb - knb + 1 == 0) then
#:if rk == "sp"
                 ! in la_${ri}$larfb_gett parameters, when m=0, then the matrix b
#:else
                 ! in la_${ril}$larfb_gett parameters, when m=0, then the matrix b
#:endif
                 ! does not exist, hence we need to pass a dummy array
                 ! reference dummy(1,1) to b with lddummy=1.
                 call la_${ri}$larfb_gett('N',0,n - kb + 1,knb,t(1,kb),ldt,a(kb,kb),lda, &
                           dummy(1,1),1,work,knb)
              else
                 call la_${ri}$larfb_gett('N',mb1 - kb - knb + 1,n - kb + 1,knb,t(1,kb),ldt,a(kb, &
                           kb),lda,a(kb + knb,kb),lda,work,knb)
              end if
           end do
           work(1) = real(lworkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$orgtsqr_row
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORM2R: overwrites the general real m by n matrix C with
     !> Q * C  if SIDE = 'L' and TRANS = 'N', or
     !> Q**T* C  if SIDE = 'L' and TRANS = 'T', or
     !> C * Q  if SIDE = 'R' and TRANS = 'N', or
     !> C * Q**T if SIDE = 'R' and TRANS = 'T',
     !> where Q is a real orthogonal matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF. Q is of order m if SIDE = 'L' and of order n
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$orm2r(side,trans,m,n,k,a,lda,tau,c,ldc,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: left,notran
           integer(ilp) :: i,i1,i2,i3,ic,jc,mi,ni,nq
           real(${rk}$) :: aii
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           ! nq is the order of q
           if (left) then
              nq = m
           else
              nq = n
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'T')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,nq)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORM2R',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if ((left .and. .not. notran) .or. (.not. left .and. notran)) then
              i1 = 1
              i2 = k
              i3 = 1
           else
              i1 = k
              i2 = 1
              i3 = -1
           end if
           if (left) then
              ni = n
              jc = 1
           else
              mi = m
              ic = 1
           end if
           do i = i1,i2,i3
              if (left) then
                 ! h(i) is applied to c(i:m,1:n)
                 mi = m - i + 1
                 ic = i
              else
                 ! h(i) is applied to c(1:m,i:n)
                 ni = n - i + 1
                 jc = i
              end if
              ! apply h(i)
              aii = a(i,i)
              a(i,i) = one
              call la_${ri}$larf(side,mi,ni,a(i,i),1,tau(i),c(ic,jc),ldc,work)

              a(i,i) = aii
           end do
           return
     end subroutine la_${ri}$orm2r
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORMQR: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'T':      Q**T * C       C * Q**T
     !> where Q is a real orthogonal matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF. Q is of order M if SIDE = 'L' and of order N
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$ormqr(side,trans,m,n,k,a,lda,tau,c,ldc,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 64
           integer(ilp),parameter :: ldt = nbmax + 1
           integer(ilp),parameter :: tsize = ldt*nbmax

           ! Local Scalars
           logical(lk) :: left,lquery,notran
           integer(ilp) :: i,i1,i2,i3,ib,ic,iinfo,iwt,jc,ldwork,lwkopt,mi,nb,nbmin, &
                     ni,nq,nw
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           lquery = (lwork == -1)
           ! nq is the order of q and nw is the minimum dimension of work
           if (left) then
              nq = m
              nw = max(1,n)
           else
              nq = n
              nw = max(1,m)
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'T')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,nq)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           else if (lwork < nw .and. .not. lquery) then
              info = -12
           end if
           if (info == 0) then
              ! compute the workspace requirements
              nb = min(nbmax,la_ilaenv(1,'${ri.upper()}$ORMQR',side//trans,m,n,k,-1))
              lwkopt = nw*nb + tsize
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORMQR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. k == 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           ldwork = nw
           if (nb > 1 .and. nb < k) then
              if (lwork < lwkopt) then
                 nb = (lwork - tsize)/ldwork
                 nbmin = max(2,la_ilaenv(2,'${ri.upper()}$ORMQR',side//trans,m,n,k,-1))
              end if
           end if
           if (nb < nbmin .or. nb >= k) then
              ! use unblocked code
              call la_${ri}$orm2r(side,trans,m,n,k,a,lda,tau,c,ldc,work,iinfo)
           else
              ! use blocked code
              iwt = 1 + nw*nb
              if ((left .and. .not. notran) .or. (.not. left .and. notran)) then
                 i1 = 1
                 i2 = k
                 i3 = nb
              else
                 i1 = ((k - 1)/nb)*nb + 1
                 i2 = 1
                 i3 = -nb
              end if
              if (left) then
                 ni = n
                 jc = 1
              else
                 mi = m
                 ic = 1
              end if
              do i = i1,i2,i3
                 ib = min(nb,k - i + 1)
                 ! form the triangular factor of the block reflector
                 ! h = h(i) h(i+1) . . . h(i+ib-1)
                 call la_${ri}$larft('FORWARD','COLUMNWISE',nq - i + 1,ib,a(i,i),lda,tau(i), &
                            work(iwt),ldt)
                 if (left) then
                    ! h or h**t is applied to c(i:m,1:n)
                    mi = m - i + 1
                    ic = i
                 else
                    ! h or h**t is applied to c(1:m,i:n)
                    ni = n - i + 1
                    jc = i
                 end if
                 ! apply h or h**t
                 call la_${ri}$larfb(side,trans,'FORWARD','COLUMNWISE',mi,ni,ib,a(i,i), &
                           lda,work(iwt),ldt,c(ic,jc),ldc,work,ldwork)
              end do
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$ormqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORMR2: overwrites the general real m by n matrix C with
     !> Q * C  if SIDE = 'L' and TRANS = 'N', or
     !> Q**T* C  if SIDE = 'L' and TRANS = 'T', or
     !> C * Q  if SIDE = 'R' and TRANS = 'N', or
     !> C * Q**T if SIDE = 'R' and TRANS = 'T',
     !> where Q is a real orthogonal matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GERQF. Q is of order m if SIDE = 'L' and of order n
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$ormr2(side,trans,m,n,k,a,lda,tau,c,ldc,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: left,notran
           integer(ilp) :: i,i1,i2,i3,mi,ni,nq
           real(${rk}$) :: aii
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           ! nq is the order of q
           if (left) then
              nq = m
           else
              nq = n
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'T')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,k)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORMR2',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if ((left .and. .not. notran) .or. (.not. left .and. notran)) then
              i1 = 1
              i2 = k
              i3 = 1
           else
              i1 = k
              i2 = 1
              i3 = -1
           end if
           if (left) then
              ni = n
           else
              mi = m
           end if
           do i = i1,i2,i3
              if (left) then
                 ! h(i) is applied to c(1:m-k+i,1:n)
                 mi = m - k + i
              else
                 ! h(i) is applied to c(1:m,1:n-k+i)
                 ni = n - k + i
              end if
              ! apply h(i)
              aii = a(i,nq - k + i)
              a(i,nq - k + i) = one
              call la_${ri}$larf(side,mi,ni,a(i,1),lda,tau(i),c,ldc,work)
              a(i,nq - k + i) = aii
           end do
           return
     end subroutine la_${ri}$ormr2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORMRQ: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'T':      Q**T * C       C * Q**T
     !> where Q is a real orthogonal matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GERQF. Q is of order M if SIDE = 'L' and of order N
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$ormrq(side,trans,m,n,k,a,lda,tau,c,ldc,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           real(${rk}$),intent(in) :: tau(*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 64
           integer(ilp),parameter :: ldt = nbmax + 1
           integer(ilp),parameter :: tsize = ldt*nbmax

           ! Local Scalars
           logical(lk) :: left,lquery,notran
           character :: transt
           integer(ilp) :: i,i1,i2,i3,ib,iinfo,iwt,ldwork,lwkopt,mi,nb,nbmin,ni,nq, &
                     nw
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           lquery = (lwork == -1)
           ! nq is the order of q and nw is the minimum dimension of work
           if (left) then
              nq = m
              nw = max(1,n)
           else
              nq = n
              nw = max(1,m)
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'T')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,k)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           else if (lwork < nw .and. .not. lquery) then
              info = -12
           end if
           if (info == 0) then
              ! compute the workspace requirements
              if (m == 0 .or. n == 0) then
                 lwkopt = 1
              else
                 nb = min(nbmax,la_ilaenv(1,'${ri.upper()}$ORMRQ',side//trans,m,n,k,-1))

                 lwkopt = nw*nb + tsize
              end if
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORMRQ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) then
              return
           end if
           nbmin = 2
           ldwork = nw
           if (nb > 1 .and. nb < k) then
              if (lwork < lwkopt) then
                 nb = (lwork - tsize)/ldwork
                 nbmin = max(2,la_ilaenv(2,'${ri.upper()}$ORMRQ',side//trans,m,n,k,-1))
              end if
           end if
           if (nb < nbmin .or. nb >= k) then
              ! use unblocked code
              call la_${ri}$ormr2(side,trans,m,n,k,a,lda,tau,c,ldc,work,iinfo)
           else
              ! use blocked code
              iwt = 1 + nw*nb
              if ((left .and. .not. notran) .or. (.not. left .and. notran)) then
                 i1 = 1
                 i2 = k
                 i3 = nb
              else
                 i1 = ((k - 1)/nb)*nb + 1
                 i2 = 1
                 i3 = -nb
              end if
              if (left) then
                 ni = n
              else
                 mi = m
              end if
              if (notran) then
                 transt = 'T'
              else
                 transt = 'N'
              end if
              do i = i1,i2,i3
                 ib = min(nb,k - i + 1)
                 ! form the triangular factor of the block reflector
                 ! h = h(i+ib-1) . . . h(i+1) h(i)
                 call la_${ri}$larft('BACKWARD','ROWWISE',nq - k + i + ib - 1,ib,a(i,1),lda,tau( &
                           i),work(iwt),ldt)
                 if (left) then
                    ! h or h**t is applied to c(1:m-k+i+ib-1,1:n)
                    mi = m - k + i + ib - 1
                 else
                    ! h or h**t is applied to c(1:m,1:n-k+i+ib-1)
                    ni = n - k + i + ib - 1
                 end if
                 ! apply h or h**t
                 call la_${ri}$larfb(side,transt,'BACKWARD','ROWWISE',mi,ni,ib,a(i,1), &
                           lda,work(iwt),ldt,c,ldc,work,ldwork)
              end do
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$ormrq
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$TPRFB: applies a real "triangular-pentagonal" block reflector H or its
#:if rk == "sp"
     !> conjugate transpose H^H to a real matrix C, which is composed of two
#:else
     !> transpose H**T to a real matrix C, which is composed of two
#:endif
     !> blocks A and B, either from the left or right.

     pure subroutine la_${ri}$tprfb(side,trans,direct,storev,m,n,k,l,v,ldv,t,ldt,a, &
               lda,b,ldb,work,ldwork)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: direct,side,storev,trans
           integer(ilp),intent(in) :: k,l,lda,ldb,ldt,ldv,ldwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(in) :: t(ldt,*),v(ldv,*)
           real(${rk}$),intent(out) :: work(ldwork,*)
        ! ==========================================================================

           ! Local Scalars
           integer(ilp) :: i,j,mp,np,kp
           logical(lk) :: left,forward,column,right,backward,row
           ! Executable Statements
           ! quick return if possible
           if (m <= 0 .or. n <= 0 .or. k <= 0 .or. l < 0) return
           if (la_lsame(storev,'C')) then
              column = .true.
              row = .false.
           else if (la_lsame(storev,'R')) then
              column = .false.
              row = .true.
           else
              column = .false.
              row = .false.
           end if
           if (la_lsame(side,'L')) then
              left = .true.
              right = .false.
           else if (la_lsame(side,'R')) then
              left = .false.
              right = .true.
           else
              left = .false.
              right = .false.
           end if
           if (la_lsame(direct,'F')) then
              forward = .true.
              backward = .false.
           else if (la_lsame(direct,'B')) then
              forward = .false.
              backward = .true.
           else
              forward = .false.
              backward = .false.
           end if
       ! ---------------------------------------------------------------------------
           if (column .and. forward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i ]    (k-by-k)
                        ! [ v ]    (m-by-k)
#:if rk == "sp"
              ! form  h c  or  h^h c  where  c = [ a ]  (k-by-n)
#:else
              ! form  h c  or  h**t c  where  c = [ a ]  (k-by-n)
#:endif
                                                ! [ b ]  (m-by-n)
#:if rk == "sp"
              ! h = i - w t w^h          or  h^h = i - w t^h w^h
              ! a = a -   t (a + v^h b)  or  a = a -   t^h (a + v^h b)
              ! b = b - v t (a + v^h b)  or  b = b - v t^h (a + v^h b)
#:else
              ! h = i - w t w**t          or  h**t = i - w t**t w**t
              ! a = a -   t (a + v**t b)  or  a = a -   t**t (a + v**t b)
              ! b = b - v t (a + v**t b)  or  b = b - v t**t (a + v**t b)
#:endif
       ! ---------------------------------------------------------------------------
              mp = min(m - l + 1,m)
              kp = min(l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(i,j) = b(m - l + i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U','T','N',l,n,one,v(mp,1),ldv,work,ldwork)

              call la_${ri}$gemm('T','N',l,n,m - l,one,v,ldv,b,ldb,one,work,ldwork)

              call la_${ri}$gemm('T','N',k - l,n,m,one,v(1,kp),ldv,b,ldb,zero,work(kp, &
                         1),ldwork)
              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U',trans,'N',k,n,one,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m - l,n,k,-one,v,ldv,work,ldwork,one,b,ldb)

              call la_${ri}$gemm('N','N',l,n,k - l,-one,v(mp,kp),ldv,work(kp,1), &
                        ldwork,one,b(mp,1),ldb)
              call la_${ri}$trmm('L','U','N','N',l,n,one,v(mp,1),ldv,work,ldwork)

              do j = 1,n
                 do i = 1,l
                    b(m - l + i,j) = b(m - l + i,j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (column .and. forward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i ]    (k-by-k)
                        ! [ v ]    (n-by-k)
#:if rk == "sp"
              ! form  c h or  c h^h  where  c = [ a b ] (a is m-by-k, b is m-by-n)
              ! h = i - w t w^h          or  h^h = i - w t^h w^h
              ! a = a - (a + b v) t      or  a = a - (a + b v) t^h
              ! b = b - (a + b v) t v^h  or  b = b - (a + b v) t^h v^h
#:else
              ! form  c h or  c h**t  where  c = [ a b ] (a is m-by-k, b is m-by-n)
              ! h = i - w t w**t          or  h**t = i - w t**t w**t
              ! a = a - (a + b v) t      or  a = a - (a + b v) t**t
              ! b = b - (a + b v) t v**t  or  b = b - (a + b v) t**t v**t
#:endif
       ! ---------------------------------------------------------------------------
              np = min(n - l + 1,n)
              kp = min(l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,j) = b(i,n - l + j)
                 end do
              end do
              call la_${ri}$trmm('R','U','N','N',m,l,one,v(np,1),ldv,work,ldwork)

              call la_${ri}$gemm('N','N',m,l,n - l,one,b,ldb,v,ldv,one,work,ldwork)

              call la_${ri}$gemm('N','N',m,k - l,n,one,b,ldb,v(1,kp),ldv,zero,work(1, &
                        kp),ldwork)
              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','U',trans,'N',m,k,one,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','T',m,n - l,k,-one,work,ldwork,v,ldv,one,b,ldb)

              call la_${ri}$gemm('N','T',m,l,k - l,-one,work(1,kp),ldwork,v(np,kp), &
                        ldv,one,b(1,np),ldb)
              call la_${ri}$trmm('R','U','T','N',m,l,one,v(np,1),ldv,work,ldwork)

              do j = 1,l
                 do i = 1,m
                    b(i,n - l + j) = b(i,n - l + j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (column .and. backward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v ]    (m-by-k)
                        ! [ i ]    (k-by-k)
#:if rk == "sp"
              ! form  h c  or  h^h c  where  c = [ b ]  (m-by-n)
#:else
              ! form  h c  or  h**t c  where  c = [ b ]  (m-by-n)
#:endif
                                                ! [ a ]  (k-by-n)
#:if rk == "sp"
              ! h = i - w t w^h          or  h^h = i - w t^h w^h
              ! a = a -   t (a + v^h b)  or  a = a -   t^h (a + v^h b)
              ! b = b - v t (a + v^h b)  or  b = b - v t^h (a + v^h b)
#:else
              ! h = i - w t w**t          or  h**t = i - w t**t w**t
              ! a = a -   t (a + v**t b)  or  a = a -   t**t (a + v**t b)
              ! b = b - v t (a + v**t b)  or  b = b - v t**t (a + v**t b)
#:endif
       ! ---------------------------------------------------------------------------
              mp = min(l + 1,m)
              kp = min(k - l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(k - l + i,j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L','T','N',l,n,one,v(1,kp),ldv,work(kp,1), &
                        ldwork)
              call la_${ri}$gemm('T','N',l,n,m - l,one,v(mp,kp),ldv,b(mp,1),ldb,one, &
                        work(kp,1),ldwork)
              call la_${ri}$gemm('T','N',k - l,n,m,one,v,ldv,b,ldb,zero,work,ldwork)

              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L',trans,'N',k,n,one,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m - l,n,k,-one,v(mp,1),ldv,work,ldwork,one,b( &
                        mp,1),ldb)
              call la_${ri}$gemm('N','N',l,n,k - l,-one,v,ldv,work,ldwork,one,b,ldb)

              call la_${ri}$trmm('L','L','N','N',l,n,one,v(1,kp),ldv,work(kp,1), &
                        ldwork)
              do j = 1,n
                 do i = 1,l
                    b(i,j) = b(i,j) - work(k - l + i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (column .and. backward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v ]    (n-by-k)
                        ! [ i ]    (k-by-k)
#:if rk == "sp"
              ! form  c h  or  c h^h  where  c = [ b a ] (b is m-by-n, a is m-by-k)
              ! h = i - w t w^h          or  h^h = i - w t^h w^h
              ! a = a - (a + b v) t      or  a = a - (a + b v) t^h
              ! b = b - (a + b v) t v^h  or  b = b - (a + b v) t^h v^h
#:else
              ! form  c h  or  c h**t  where  c = [ b a ] (b is m-by-n, a is m-by-k)
              ! h = i - w t w**t          or  h**t = i - w t**t w**t
              ! a = a - (a + b v) t      or  a = a - (a + b v) t**t
              ! b = b - (a + b v) t v**t  or  b = b - (a + b v) t**t v**t
#:endif
       ! ---------------------------------------------------------------------------
              np = min(l + 1,n)
              kp = min(k - l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,k - l + j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','L','N','N',m,l,one,v(1,kp),ldv,work(1,kp), &
                        ldwork)
              call la_${ri}$gemm('N','N',m,l,n - l,one,b(1,np),ldb,v(np,kp),ldv,one, &
                        work(1,kp),ldwork)
              call la_${ri}$gemm('N','N',m,k - l,n,one,b,ldb,v,ldv,zero,work,ldwork)

              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','L',trans,'N',m,k,one,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','T',m,n - l,k,-one,work,ldwork,v(np,1),ldv,one,b( &
                        1,np),ldb)
              call la_${ri}$gemm('N','T',m,l,k - l,-one,work,ldwork,v,ldv,one,b,ldb)

              call la_${ri}$trmm('R','L','T','N',m,l,one,v(1,kp),ldv,work(1,kp), &
                        ldwork)
              do j = 1,l
                 do i = 1,m
                    b(i,j) = b(i,j) - work(i,k - l + j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. forward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i v ] ( i is k-by-k, v is k-by-m )
#:if rk == "sp"
              ! form  h c  or  h^h c  where  c = [ a ]  (k-by-n)
#:else
              ! form  h c  or  h**t c  where  c = [ a ]  (k-by-n)
#:endif
                                                ! [ b ]  (m-by-n)
#:if rk == "sp"
              ! h = i - w^h t w          or  h^h = i - w^h t^h w
              ! a = a -     t (a + v b)  or  a = a -     t^h (a + v b)
              ! b = b - v^h t (a + v b)  or  b = b - v^h t^h (a + v b)
#:else
              ! h = i - w**t t w          or  h**t = i - w**t t**t w
              ! a = a -     t (a + v b)  or  a = a -     t**t (a + v b)
              ! b = b - v**t t (a + v b)  or  b = b - v**t t**t (a + v b)
#:endif
       ! ---------------------------------------------------------------------------
              mp = min(m - l + 1,m)
              kp = min(l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(i,j) = b(m - l + i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L','N','N',l,n,one,v(1,mp),ldv,work,ldb)

              call la_${ri}$gemm('N','N',l,n,m - l,one,v,ldv,b,ldb,one,work,ldwork)

              call la_${ri}$gemm('N','N',k - l,n,m,one,v(kp,1),ldv,b,ldb,zero,work(kp, &
                         1),ldwork)
              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U',trans,'N',k,n,one,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('T','N',m - l,n,k,-one,v,ldv,work,ldwork,one,b,ldb)

              call la_${ri}$gemm('T','N',l,n,k - l,-one,v(kp,mp),ldv,work(kp,1), &
                        ldwork,one,b(mp,1),ldb)
              call la_${ri}$trmm('L','L','T','N',l,n,one,v(1,mp),ldv,work,ldwork)

              do j = 1,n
                 do i = 1,l
                    b(m - l + i,j) = b(m - l + i,j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. forward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i v ] ( i is k-by-k, v is k-by-n )
#:if rk == "sp"
              ! form  c h  or  c h^h  where  c = [ a b ] (a is m-by-k, b is m-by-n)
              ! h = i - w^h t w            or  h^h = i - w^h t^h w
              ! a = a - (a + b v^h) t      or  a = a - (a + b v^h) t^h
              ! b = b - (a + b v^h) t v    or  b = b - (a + b v^h) t^h v
#:else
              ! form  c h  or  c h**t  where  c = [ a b ] (a is m-by-k, b is m-by-n)
              ! h = i - w**t t w            or  h**t = i - w**t t**t w
              ! a = a - (a + b v**t) t      or  a = a - (a + b v**t) t**t
              ! b = b - (a + b v**t) t v    or  b = b - (a + b v**t) t**t v
#:endif
       ! ---------------------------------------------------------------------------
              np = min(n - l + 1,n)
              kp = min(l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,j) = b(i,n - l + j)
                 end do
              end do
              call la_${ri}$trmm('R','L','T','N',m,l,one,v(1,np),ldv,work,ldwork)

              call la_${ri}$gemm('N','T',m,l,n - l,one,b,ldb,v,ldv,one,work,ldwork)

              call la_${ri}$gemm('N','T',m,k - l,n,one,b,ldb,v(kp,1),ldv,zero,work(1, &
                        kp),ldwork)
              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','U',trans,'N',m,k,one,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m,n - l,k,-one,work,ldwork,v,ldv,one,b,ldb)

              call la_${ri}$gemm('N','N',m,l,k - l,-one,work(1,kp),ldwork,v(kp,np), &
                        ldv,one,b(1,np),ldb)
              call la_${ri}$trmm('R','L','N','N',m,l,one,v(1,np),ldv,work,ldwork)

              do j = 1,l
                 do i = 1,m
                    b(i,n - l + j) = b(i,n - l + j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. backward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v i ] ( i is k-by-k, v is k-by-m )
#:if rk == "sp"
              ! form  h c  or  h^h c  where  c = [ b ]  (m-by-n)
#:else
              ! form  h c  or  h**t c  where  c = [ b ]  (m-by-n)
#:endif
                                                ! [ a ]  (k-by-n)
#:if rk == "sp"
              ! h = i - w^h t w          or  h^h = i - w^h t^h w
              ! a = a -     t (a + v b)  or  a = a -     t^h (a + v b)
              ! b = b - v^h t (a + v b)  or  b = b - v^h t^h (a + v b)
#:else
              ! h = i - w**t t w          or  h**t = i - w**t t**t w
              ! a = a -     t (a + v b)  or  a = a -     t**t (a + v b)
              ! b = b - v**t t (a + v b)  or  b = b - v**t t**t (a + v b)
#:endif
       ! ---------------------------------------------------------------------------
              mp = min(l + 1,m)
              kp = min(k - l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(k - l + i,j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U','N','N',l,n,one,v(kp,1),ldv,work(kp,1), &
                        ldwork)
              call la_${ri}$gemm('N','N',l,n,m - l,one,v(kp,mp),ldv,b(mp,1),ldb,one, &
                        work(kp,1),ldwork)
              call la_${ri}$gemm('N','N',k - l,n,m,one,v,ldv,b,ldb,zero,work,ldwork)

              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L ',trans,'N',k,n,one,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('T','N',m - l,n,k,-one,v(1,mp),ldv,work,ldwork,one,b( &
                        mp,1),ldb)
              call la_${ri}$gemm('T','N',l,n,k - l,-one,v,ldv,work,ldwork,one,b,ldb)

              call la_${ri}$trmm('L','U','T','N',l,n,one,v(kp,1),ldv,work(kp,1), &
                        ldwork)
              do j = 1,n
                 do i = 1,l
                    b(i,j) = b(i,j) - work(k - l + i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. backward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v i ] ( i is k-by-k, v is k-by-n )
#:if rk == "sp"
              ! form  c h  or  c h^h  where  c = [ b a ] (a is m-by-k, b is m-by-n)
              ! h = i - w^h t w            or  h^h = i - w^h t^h w
              ! a = a - (a + b v^h) t      or  a = a - (a + b v^h) t^h
              ! b = b - (a + b v^h) t v    or  b = b - (a + b v^h) t^h v
#:else
              ! form  c h  or  c h**t  where  c = [ b a ] (a is m-by-k, b is m-by-n)
              ! h = i - w**t t w            or  h**t = i - w**t t**t w
              ! a = a - (a + b v**t) t      or  a = a - (a + b v**t) t**t
              ! b = b - (a + b v**t) t v    or  b = b - (a + b v**t) t**t v
#:endif
       ! ---------------------------------------------------------------------------
              np = min(l + 1,n)
              kp = min(k - l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,k - l + j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','U','T','N',m,l,one,v(kp,1),ldv,work(1,kp), &
                        ldwork)
              call la_${ri}$gemm('N','T',m,l,n - l,one,b(1,np),ldb,v(kp,np),ldv,one, &
                        work(1,kp),ldwork)
              call la_${ri}$gemm('N','T',m,k - l,n,one,b,ldb,v,ldv,zero,work,ldwork)

              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','L',trans,'N',m,k,one,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m,n - l,k,-one,work,ldwork,v(1,np),ldv,one,b( &
                        1,np),ldb)
              call la_${ri}$gemm('N','N',m,l,k - l,-one,work,ldwork,v,ldv,one,b,ldb)

              call la_${ri}$trmm('R','U','N','N',m,l,one,v(kp,1),ldv,work(1,kp), &
                        ldwork)
              do j = 1,l
                 do i = 1,m
                    b(i,j) = b(i,j) - work(i,k - l + j)
                 end do
              end do
           end if
           return
     end subroutine la_${ri}$tprfb
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEMQRT: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q C            C Q
     !> TRANS = 'T':   Q**T C            C Q**T
     !> where Q is a real orthogonal matrix defined as the product of K
     !> elementary reflectors:
     !> Q = H(1) H(2) . . . H(K) = I - V T V**T
     !> generated using the compact WY representation as returned by ${ri.upper()}$GEQRT.
     !> Q is of order M if SIDE = 'L' and of order N  if SIDE = 'R'.

     pure subroutine la_${ri}$gemqrt(side,trans,m,n,k,nb,v,ldv,t,ldt,c,ldc,work,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,ldv,ldc,m,n,nb,ldt
           ! Array Arguments
           real(${rk}$),intent(in) :: v(ldv,*),t(ldt,*)
           real(${rk}$),intent(inout) :: c(ldc,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran
           integer(ilp) :: i,ib,ldwork,kf,q
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! Test The Input Arguments
           info = 0
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           tran = la_lsame(trans,'T')
           notran = la_lsame(trans,'N')
           if (left) then
              ldwork = max(1,n)
              q = m
           else if (right) then
              ldwork = max(1,m)
              q = n
           end if
           if (.not. left .and. .not. right) then
              info = -1
           else if (.not. tran .and. .not. notran) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > q) then
              info = -5
           else if (nb < 1 .or. (nb > k .and. k > 0)) then
              info = -6
           else if (ldv < max(1,q)) then
              info = -8
           else if (ldt < nb) then
              info = -10
           else if (ldc < max(1,m)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEMQRT',-info)
              return
           end if
           ! Quick Return If Possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if (left .and. tran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('L','T','F','C',m - i + 1,n,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(i,1),ldc,work,ldwork)
              end do
           else if (right .and. notran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('R','N','F','C',m,n - i + 1,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(1,i),ldc,work,ldwork)
              end do
           else if (left .and. notran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('L','N','F','C',m - i + 1,n,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(i,1),ldc,work,ldwork)
              end do
           else if (right .and. tran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('R','T','F','C',m,n - i + 1,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(1,i),ldc,work,ldwork)
              end do
           end if
           return
     end subroutine la_${ri}$gemqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAORHR_COL_GETRFNP: computes the modified LU factorization without
     !> pivoting of a real general M-by-N matrix A. The factorization has
     !> the form:
     !> A - S = L * U,
     !> where:
     !> S is a m-by-n diagonal sign matrix with the diagonal D, so that
     !> D(i) = S(i,i), 1 <= i <= min(M,N). The diagonal D is constructed
     !> as D(i)=-SIGN(A(i,i)), where A(i,i) is the value after performing
     !> i-1 steps of Gaussian elimination. This means that the diagonal
     !> element at each step of "modified" Gaussian elimination is
     !> at least one in absolute value (so that division-by-zero not
     !> not possible during the division by the diagonal element);
     !> L is a M-by-N lower triangular matrix with unit diagonal elements
     !> (lower trapezoidal if M > N);
     !> and U is a M-by-N upper triangular matrix
     !> (upper trapezoidal if M < N).
     !> This routine is an auxiliary routine used in the Householder
     !> reconstruction routine ${ri.upper()}$ORHR_COL. In ${ri.upper()}$ORHR_COL, this routine is
     !> applied to an M-by-N matrix A with orthonormal columns, where each
     !> element is bounded by one in absolute value. With the choice of
     !> the matrix S above, one can show that the diagonal element at each
     !> step of Gaussian elimination is the largest (in absolute value) in
     !> the column on or below the diagonal, so that no pivoting is required
     !> for numerical stability [1].
     !> For more details on the Householder reconstruction algorithm,
     !> including the modified LU factorization, see [1].
     !> This is the blocked right-looking version of the algorithm,
     !> calling Level 3 BLAS to update the submatrix. To factorize a block,
     !> this routine calls the recursive routine ${ri.upper()}$LAORHR_COL_GETRFNP2.
     !> [1] "Reconstructing Householder vectors from tall-skinny QR",
     !> G. Ballard, J. Demmel, L. Grigori, M. Jacquelin, H.D. Nguyen,
     !> E. Solomonik, J. Parallel Distrib. Comput.,
     !> vol. 85, pp. 3-31, 2015.

     pure subroutine la_${ri}$laorhr_col_getrfnp(m,n,a,lda,d,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: d(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: iinfo,j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$LAORHR_COL_GETRFNP',-info)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) return
           ! determine the block size for this environment.
           nb = la_ilaenv(1,'${ri.upper()}$LAORHR_COL_GETRFNP',' ',m,n,-1,-1)
           if (nb <= 1 .or. nb >= min(m,n)) then
              ! use unblocked code.
              call la_${ri}$laorhr_col_getrfnp2(m,n,a,lda,d,info)
           else
              ! use blocked code.
              do j = 1,min(m,n),nb
                 jb = min(min(m,n) - j + 1,nb)
                 ! factor diagonal and subdiagonal blocks.
                 call la_${ri}$laorhr_col_getrfnp2(m - j + 1,jb,a(j,j),lda,d(j),iinfo)

                 if (j + jb <= n) then
                    ! compute block row of u.
                    call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','UNIT',jb,n - j - jb + 1,one, &
                              a(j,j),lda,a(j,j + jb),lda)
                    if (j + jb <= m) then
                       ! update trailing submatrix.
                       call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',m - j - jb + 1,n - j - jb + 1,jb,- &
                       one,a(j + jb,j),lda,a(j,j + jb),lda,one,a(j + jb,j + jb),lda)

                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$laorhr_col_getrfnp
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORHR_COL: takes an M-by-N real matrix Q_in with orthonormal columns
     !> as input, stored in A, and performs Householder Reconstruction (HR),
     !> i.e. reconstructs Householder vectors V(i) implicitly representing
     !> another M-by-N matrix Q_out, with the property that Q_in = Q_out*S,
     !> where S is an N-by-N diagonal matrix with diagonal entries
     !> equal to +1 or -1. The Householder vectors (columns V(i) of V) are
     !> stored in A on output, and the diagonal entries of S are stored in D.
     !> Block reflectors are also returned in T
     !> (same output format as ${ri.upper()}$GEQRT).

     pure subroutine la_${ri}$orhr_col(m,n,nb,a,lda,t,ldt,d,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,m,n,nb
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: d(*),t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,iinfo,j,jb,jbtemp1,jbtemp2,jnb,nplusone
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0 .or. n > m) then
              info = -2
           else if (nb < 1) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldt < max(1,min(nb,n))) then
              info = -7
           end if
           ! handle error in the input parameters.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORHR_COL',-info)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              return
           end if
           ! on input, the m-by-n matrix a contains the orthogonal
           ! m-by-n matrix q_in.
           ! (1) compute the unit lower-trapezoidal v (ones on the diagonal
           ! are not stored) by performing the "modified" lu-decomposition.
           ! q_in - ( s ) = v * u = ( v1 ) * u,
                  ! ( 0 )           ( v2 )
           ! where 0 is an (m-n)-by-n zero matrix.
           ! (1-1) factor v1 and u.
           call la_${ri}$laorhr_col_getrfnp(n,n,a,lda,d,iinfo)
           ! (1-2) solve for v2.
           if (m > n) then
              call la_${ri}$trsm('R','U','N','N',m - n,n,one,a,lda,a(n + 1,1),lda)

           end if
           ! (2) reconstruct the block reflector t stored in t(1:nb, 1:n)
           ! as a sequence of upper-triangular blocks with nb-size column
           ! blocking.
           ! loop over the column blocks of size nb of the array a(1:m,1:n)
           ! and the array t(1:nb,1:n), jb is the column index of a column
           ! block, jnb is the column block size at each step jb.
           nplusone = n + 1
           do jb = 1,n,nb
              ! (2-0) determine the column block size jnb.
              jnb = min(nplusone - jb,nb)
              ! (2-1) copy the upper-triangular part of the current jnb-by-jnb
              ! diagonal block u(jb) (of the n-by-n matrix u) stored
              ! in a(jb:jb+jnb-1,jb:jb+jnb-1) into the upper-triangular part
              ! of the current jnb-by-jnb block t(1:jnb,jb:jb+jnb-1)
              ! column-by-column, total jnb*(jnb+1)/2 elements.
              jbtemp1 = jb - 1
              do j = jb,jb + jnb - 1
                 call la_${ri}$copy(j - jbtemp1,a(jb,j),1,t(1,j),1)
              end do
              ! (2-2) perform on the upper-triangular part of the current
              ! jnb-by-jnb diagonal block u(jb) (of the n-by-n matrix u) stored
              ! in t(1:jnb,jb:jb+jnb-1) the following operation in place:
              ! (-1)*u(jb)*s(jb), i.e the result will be stored in the upper-
              ! triangular part of t(1:jnb,jb:jb+jnb-1). this multiplication
              ! of the jnb-by-jnb diagonal block u(jb) by the jnb-by-jnb
              ! diagonal block s(jb) of the n-by-n sign matrix s from the
              ! right means changing the sign of each j-th column of the block
              ! u(jb) according to the sign of the diagonal element of the block
              ! s(jb), i.e. s(j,j) that is stored in the array element d(j).
              do j = jb,jb + jnb - 1
                 if (d(j) == one) then
                    call la_${ri}$scal(j - jbtemp1,-one,t(1,j),1)
                 end if
              end do
              ! (2-3) perform the triangular solve for the current block
              ! matrix x(jb):
                     ! x(jb) * (a(jb)**t) = b(jb), where:
                     ! a(jb)**t  is a jnb-by-jnb unit upper-triangular
                               ! coefficient block, and a(jb)=v1(jb), which
                               ! is a jnb-by-jnb unit lower-triangular block
                               ! stored in a(jb:jb+jnb-1,jb:jb+jnb-1).
                               ! the n-by-n matrix v1 is the upper part
                               ! of the m-by-n lower-trapezoidal matrix v
                               ! stored in a(1:m,1:n);
                     ! b(jb)     is a jnb-by-jnb  upper-triangular right-hand
                               ! side block, b(jb) = (-1)*u(jb)*s(jb), and
                               ! b(jb) is stored in t(1:jnb,jb:jb+jnb-1);
                     ! x(jb)     is a jnb-by-jnb upper-triangular solution
                               ! block, x(jb) is the upper-triangular block
                               ! reflector t(jb), and x(jb) is stored
                               ! in t(1:jnb,jb:jb+jnb-1).
                   ! in other words, we perform the triangular solve for the
                   ! upper-triangular block t(jb):
                     ! t(jb) * (v1(jb)**t) = (-1)*u(jb)*s(jb).
                   ! even though the blocks x(jb) and b(jb) are upper-
                   ! triangular, the routine la_${ri}$trsm will access all jnb**2
                   ! elements of the square t(1:jnb,jb:jb+jnb-1). therefore,
                   ! we need to set to zero the elements of the block
                   ! t(1:jnb,jb:jb+jnb-1) below the diagonal before the call
                   ! to la_${ri}$trsm.
              ! (2-3a) set the elements to zero.
              jbtemp2 = jb - 2
              do j = jb,jb + jnb - 2
                 do i = j - jbtemp2,nb
                    t(i,j) = zero
                 end do
              end do
              ! (2-3b) perform the triangular solve.
              call la_${ri}$trsm('R','L','T','U',jnb,jnb,one,a(jb,jb),lda,t(1,jb), &
                        ldt)
           end do
           return
     end subroutine la_${ri}$orhr_col
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$TPMQRT: applies a real orthogonal matrix Q obtained from a
     !> "triangular-pentagonal" real block reflector H to a general
     !> real matrix C, which consists of two blocks A and B.

     pure subroutine la_${ri}$tpmqrt(side,trans,m,n,k,l,nb,v,ldv,t,ldt,a,lda,b,ldb, &
               work,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,ldv,lda,ldb,m,n,l,nb,ldt
           ! Array Arguments
           real(${rk}$),intent(in) :: v(ldv,*),t(ldt,*)
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran
           integer(ilp) :: i,ib,mb,lb,kf,ldaq,ldvq
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! Test The Input Arguments
           info = 0
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           tran = la_lsame(trans,'T')
           notran = la_lsame(trans,'N')
           if (left) then
              ldvq = max(1,m)
              ldaq = max(1,k)
           else if (right) then
              ldvq = max(1,n)
              ldaq = max(1,m)
           end if
           if (.not. left .and. .not. right) then
              info = -1
           else if (.not. tran .and. .not. notran) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0) then
              info = -5
           else if (l < 0 .or. l > k) then
              info = -6
           else if (nb < 1 .or. (nb > k .and. k > 0)) then
              info = -7
           else if (ldv < ldvq) then
              info = -9
           else if (ldt < nb) then
              info = -11
           else if (lda < ldaq) then
              info = -13
           else if (ldb < max(1,m)) then
              info = -15
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$TPMQRT',-info)
              return
           end if
           ! Quick Return If Possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if (left .and. tran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 mb = min(m - l + i + ib - 1,m)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - m + l - i + 1
                 end if
                 call la_${ri}$tprfb('L','T','F','C',mb,n,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(i,1),lda,b,ldb,work,ib)
              end do
           else if (right .and. notran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 mb = min(n - l + i + ib - 1,n)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - n + l - i + 1
                 end if
                 call la_${ri}$tprfb('R','N','F','C',m,mb,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(1,i),lda,b,ldb,work,m)
              end do
           else if (left .and. notran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 mb = min(m - l + i + ib - 1,m)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - m + l - i + 1
                 end if
                 call la_${ri}$tprfb('L','N','F','C',mb,n,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(i,1),lda,b,ldb,work,ib)
              end do
           else if (right .and. tran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 mb = min(n - l + i + ib - 1,n)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - n + l - i + 1
                 end if
                 call la_${ri}$tprfb('R','T','F','C',m,mb,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(1,i),lda,b,ldb,work,m)
              end do
           end if
           return
     end subroutine la_${ri}$tpmqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$TPQRT2: computes a QR factorization of a real "triangular-pentagonal"
     !> matrix C, which is composed of a triangular block A and pentagonal block B,
     !> using the compact WY representation for Q.

     pure subroutine la_${ri}$tpqrt2(m,n,l,a,lda,b,ldb,t,ldt,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,j,p,mp,np
           real(${rk}$) :: alpha
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (l < 0 .or. l > min(m,n)) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,m)) then
              info = -7
           else if (ldt < max(1,n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$TPQRT2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. m == 0) return
           do i = 1,n
              ! generate elementary reflector h(i) to annihilate b(:,i)
              p = m - l + min(l,i)
              call la_${ri}$larfg(p + 1,a(i,i),b(1,i),1,t(i,1))
              if (i < n) then
                 ! w(1:n-i) := c(i:m,i+1:n)^h * c(i:m,i) [use w = t(:,n)]
                 do j = 1,n - i
                    t(j,n) = (a(i,i + j))
                 end do
                 call la_${ri}$gemv('T',p,n - i,one,b(1,i + 1),ldb,b(1,i),1,one,t(1,n &
                           ),1)
                 ! c(i:m,i+1:n) = c(i:m,i+1:n) + alpha*c(i:m,i)*w(1:n-1)^h
                 alpha = -(t(i,1))
                 do j = 1,n - i
                    a(i,i + j) = a(i,i + j) + alpha*(t(j,n))
                 end do
                 call la_${ri}$ger(p,n - i,alpha,b(1,i),1,t(1,n),1,b(1,i + 1),ldb)

              end if
           end do
           do i = 2,n
              ! t(1:i-1,i) := c(i:m,1:i-1)^h * (alpha * c(i:m,i))
              alpha = -t(i,1)
              do j = 1,i - 1
                 t(j,i) = zero
              end do
              p = min(i - 1,l)
              mp = min(m - l + 1,m)
              np = min(p + 1,n)
              ! triangular part of b2
              do j = 1,p
                 t(j,i) = alpha*b(m - l + j,i)
              end do
              call la_${ri}$trmv('U','T','N',p,b(mp,1),ldb,t(1,i),1)
              ! rectangular part of b2
              call la_${ri}$gemv('T',l,i - 1 - p,alpha,b(mp,np),ldb,b(mp,i),1,zero,t( &
                        np,i),1)
              ! b1
              call la_${ri}$gemv('T',m - l,i - 1,alpha,b,ldb,b(1,i),1,one,t(1,i),1)

              ! t(1:i-1,i) := t(1:i-1,1:i-1) * t(1:i-1,i)
              call la_${ri}$trmv('U','N','N',i - 1,t,ldt,t(1,i),1)
              ! t(i,i) = tau(i)
              t(i,i) = t(i,1)
              t(i,1) = zero
           end do
     end subroutine la_${ri}$tpqrt2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQR2: computes a QR factorization of a real m-by-n matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a m-by-m orthogonal matrix;
     !> R is an upper-triangular n-by-n matrix;
     !> 0 is a (m-n)-by-n zero matrix, if m > n.

     pure subroutine la_${ri}$geqr2(m,n,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           real(${rk}$) :: aii
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQR2',-info)
              return
           end if
           k = min(m,n)
           do i = 1,k
              ! generate elementary reflector h(i) to annihilate a(i+1:m,i)
              call la_${ri}$larfg(m - i + 1,a(i,i),a(min(i + 1,m),i),1,tau(i))
              if (i < n) then
                 ! apply h(i) to a(i:m,i+1:n) from the left
                 aii = a(i,i)
                 a(i,i) = one
                 call la_${ri}$larf('LEFT',m - i + 1,n - i,a(i,i),1,tau(i),a(i,i + 1),lda, &
                           work)
                 a(i,i) = aii
              end if
           end do
           return
     end subroutine la_${ri}$geqr2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQR2P: computes a QR factorization of a real m-by-n matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a m-by-m orthogonal matrix;
     !> R is an upper-triangular n-by-n matrix with nonnegative diagonal
     !> entries;
     !> 0 is a (m-n)-by-n zero matrix, if m > n.

     subroutine la_${ri}$geqr2p(m,n,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           real(${rk}$) :: aii
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQR2P',-info)
              return
           end if
           k = min(m,n)
           do i = 1,k
              ! generate elementary reflector h(i) to annihilate a(i+1:m,i)
              call la_${ri}$larfgp(m - i + 1,a(i,i),a(min(i + 1,m),i),1,tau(i))
              if (i < n) then
                 ! apply h(i) to a(i:m,i+1:n) from the left
                 aii = a(i,i)
                 a(i,i) = one
                 call la_${ri}$larf('LEFT',m - i + 1,n - i,a(i,i),1,tau(i),a(i,i + 1),lda, &
                           work)
                 a(i,i) = aii
              end if
           end do
           return
     end subroutine la_${ri}$geqr2p
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQRF: computes a QR factorization of a real M-by-N matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix;
     !> R is an upper-triangular N-by-N matrix;
     !> 0 is a (M-N)-by-N zero matrix, if M > N.

     pure subroutine la_${ri}$geqrf(m,n,a,lda,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,k,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           k = min(m,n)
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',m,n,-1,-1)
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           else if (.not. lquery) then
              if (lwork <= 0 .or. (m > 0 .and. lwork < max(1,n))) info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRF',-info)
              return
           else if (lquery) then
              if (k == 0) then
                 lwkopt = 1
              else
                 lwkopt = n*nb
              end if
              work(1) = lwkopt
              return
           end if
           ! quick return if possible
           if (k == 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           nx = 0
           iws = n
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code initially
              do i = 1,k - nx,nb
                 ib = min(k - i + 1,nb)
                 ! compute the qr factorization of the current block
                 ! a(i:m,i:i+ib-1)
                 call la_${ri}$geqr2(m - i + 1,ib,a(i,i),lda,tau(i),work,iinfo)
                 if (i + ib <= n) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i) h(i+1) . . . h(i+ib-1)
                    call la_${ri}$larft('FORWARD','COLUMNWISE',m - i + 1,ib,a(i,i),lda,tau(i &
                              ),work,ldwork)
                    ! apply h**t to a(i:m,i+ib:n) from the left
                    call la_${ri}$larfb('LEFT','TRANSPOSE','FORWARD','COLUMNWISE',m - i + 1,n - i - &
                    ib + 1,ib,a(i,i),lda,work,ldwork,a(i,i + ib),lda,work(ib + 1),ldwork &
                              )
                 end if
              end do
           else
              i = 1
           end if
           ! use unblocked code to factor the last or only block.
           if (i <= k) call la_${ri}$geqr2(m - i + 1,n - i + 1,a(i,i),lda,tau(i),work,iinfo)

           work(1) = iws
           return
     end subroutine la_${ri}$geqrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQR2P computes a QR factorization of a real M-by-N matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix;
     !> R is an upper-triangular N-by-N matrix with nonnegative diagonal
     !> entries;
     !> 0 is a (M-N)-by-N zero matrix, if M > N.

     subroutine la_${ri}$geqrfp(m,n,a,lda,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,k,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',m,n,-1,-1)
           lwkopt = n*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           else if (lwork < max(1,n) .and. .not. lquery) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRFP',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           k = min(m,n)
           if (k == 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           nx = 0
           iws = n
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code initially
              do i = 1,k - nx,nb
                 ib = min(k - i + 1,nb)
                 ! compute the qr factorization of the current block
                 ! a(i:m,i:i+ib-1)
                 call la_${ri}$geqr2p(m - i + 1,ib,a(i,i),lda,tau(i),work,iinfo)
                 if (i + ib <= n) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i) h(i+1) . . . h(i+ib-1)
                    call la_${ri}$larft('FORWARD','COLUMNWISE',m - i + 1,ib,a(i,i),lda,tau(i &
                              ),work,ldwork)
                    ! apply h**t to a(i:m,i+ib:n) from the left
                    call la_${ri}$larfb('LEFT','TRANSPOSE','FORWARD','COLUMNWISE',m - i + 1,n - i - &
                    ib + 1,ib,a(i,i),lda,work,ldwork,a(i,i + ib),lda,work(ib + 1),ldwork &
                              )
                 end if
              end do
           else
              i = 1
           end if
           ! use unblocked code to factor the last or only block.
           if (i <= k) call la_${ri}$geqr2p(m - i + 1,n - i + 1,a(i,i),lda,tau(i),work,iinfo)

           work(1) = iws
           return
     end subroutine la_${ri}$geqrfp
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQRT2: computes a QR factorization of a real M-by-N matrix A,
     !> using the compact WY representation of Q.

     pure subroutine la_${ri}$geqrt2(m,n,a,lda,t,ldt,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           real(${rk}$) :: aii,alpha
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (n < 0) then
              info = -2
           else if (m < n) then
              info = -1
           else if (lda < max(1,m)) then
              info = -4
           else if (ldt < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRT2',-info)
              return
           end if
           k = min(m,n)
           do i = 1,k
              ! generate elem. refl. h(i) to annihilate a(i+1:m,i), tau(i) -> t(i,1)
              call la_${ri}$larfg(m - i + 1,a(i,i),a(min(i + 1,m),i),1,t(i,1))
              if (i < n) then
                 ! apply h(i) to a(i:m,i+1:n) from the left
                 aii = a(i,i)
                 a(i,i) = one
                 ! w(1:n-i) := a(i:m,i+1:n)^h * a(i:m,i) [w = t(:,n)]
                 call la_${ri}$gemv('T',m - i + 1,n - i,one,a(i,i + 1),lda,a(i,i),1,zero,t( &
                           1,n),1)
                 ! a(i:m,i+1:n) = a(i:m,i+1:n) + alpha*a(i:m,i)*w(1:n-1)^h
                 alpha = -(t(i,1))
                 call la_${ri}$ger(m - i + 1,n - i,alpha,a(i,i),1,t(1,n),1,a(i,i + 1),lda &
                           )
                 a(i,i) = aii
              end if
           end do
           do i = 2,n
              aii = a(i,i)
              a(i,i) = one
              ! t(1:i-1,i) := alpha * a(i:m,1:i-1)**t * a(i:m,i)
              alpha = -t(i,1)
              call la_${ri}$gemv('T',m - i + 1,i - 1,alpha,a(i,1),lda,a(i,i),1,zero,t(1, &
                        i),1)
              a(i,i) = aii
              ! t(1:i-1,i) := t(1:i-1,1:i-1) * t(1:i-1,i)
              call la_${ri}$trmv('U','N','N',i - 1,t,ldt,t(1,i),1)
                 ! t(i,i) = tau(i)
                 t(i,i) = t(i,1)
                 t(i,1) = zero
           end do
     end subroutine la_${ri}$geqrt2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQRT3: recursively computes a QR factorization of a real M-by-N
     !> matrix A, using the compact WY representation of Q.
     !> Based on the algorithm of Elmroth and Gustavson,
     !> IBM J. Res. Develop. Vol 44 No. 4 July 2000.

     pure recursive subroutine la_${ri}$geqrt3(m,n,a,lda,t,ldt,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,ldt
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,i1,j,j1,n1,n2,iinfo
           ! Executable Statements
           info = 0
           if (n < 0) then
              info = -2
           else if (m < n) then
              info = -1
           else if (lda < max(1,m)) then
              info = -4
           else if (ldt < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRT3',-info)
              return
           end if
           if (n == 1) then
              ! compute householder transform when n=1
              call la_${ri}$larfg(m,a(1,1),a(min(2,m),1),1,t(1,1))
           else
              ! otherwise, split a into blocks...
              n1 = n/2
              n2 = n - n1
              j1 = min(n1 + 1,n)
              i1 = min(n + 1,m)
              ! compute a(1:m,1:n1) <- (y1,r1,t1), where q1 = i - y1 t1 y1^h
              call la_${ri}$geqrt3(m,n1,a,lda,t,ldt,iinfo)
              ! compute a(1:m,j1:n) = q1^h a(1:m,j1:n) [workspace: t(1:n1,j1:n)]
              do j = 1,n2
                 do i = 1,n1
                    t(i,j + n1) = a(i,j + n1)
                 end do
              end do
              call la_${ri}$trmm('L','L','T','U',n1,n2,one,a,lda,t(1,j1),ldt)
              call la_${ri}$gemm('T','N',n1,n2,m - n1,one,a(j1,1),lda,a(j1,j1),lda, &
                        one,t(1,j1),ldt)
              call la_${ri}$trmm('L','U','T','N',n1,n2,one,t,ldt,t(1,j1),ldt)
              call la_${ri}$gemm('N','N',m - n1,n2,n1,-one,a(j1,1),lda,t(1,j1),ldt, &
                        one,a(j1,j1),lda)
              call la_${ri}$trmm('L','L','N','U',n1,n2,one,a,lda,t(1,j1),ldt)
              do j = 1,n2
                 do i = 1,n1
                    a(i,j + n1) = a(i,j + n1) - t(i,j + n1)
                 end do
              end do
              ! compute a(j1:m,j1:n) <- (y2,r2,t2) where q2 = i - y2 t2 y2^h
              call la_${ri}$geqrt3(m - n1,n2,a(j1,j1),lda,t(j1,j1),ldt,iinfo)
              ! compute t3 = t(1:n1,j1:n) = -t1 y1^h y2 t2
              do i = 1,n1
                 do j = 1,n2
                    t(i,j + n1) = (a(j + n1,i))
                 end do
              end do
              call la_${ri}$trmm('R','L','N','U',n1,n2,one,a(j1,j1),lda,t(1,j1), &
                        ldt)
              call la_${ri}$gemm('T','N',n1,n2,m - n,one,a(i1,1),lda,a(i1,j1),lda, &
                        one,t(1,j1),ldt)
              call la_${ri}$trmm('L','U','N','N',n1,n2,-one,t,ldt,t(1,j1),ldt)

              call la_${ri}$trmm('R','U','N','N',n1,n2,one,t(j1,j1),ldt,t(1,j1), &
                        ldt)
              ! y = (y1,y2); r = [ r1  a(1:n1,j1:n) ];  t = [t1 t3]
                               ! [  0        r2     ]       [ 0 t2]
           end if
           return
     end subroutine la_${ri}$geqrt3
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GERQ2: computes an RQ factorization of a real m by n matrix A:
     !> A = R * Q.

     pure subroutine la_${ri}$gerq2(m,n,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           real(${rk}$) :: aii
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GERQ2',-info)
              return
           end if
           k = min(m,n)
           do i = k,1,-1
              ! generate elementary reflector h(i) to annihilate
              ! a(m-k+i,1:n-k+i-1)
              call la_${ri}$larfg(n - k + i,a(m - k + i,n - k + i),a(m - k + i,1),lda,tau(i))
              ! apply h(i) to a(1:m-k+i-1,1:n-k+i) from the right
              aii = a(m - k + i,n - k + i)
              a(m - k + i,n - k + i) = one
              call la_${ri}$larf('RIGHT',m - k + i - 1,n - k + i,a(m - k + i,1),lda,tau(i),a,lda, &
                        work)
              a(m - k + i,n - k + i) = aii
           end do
           return
     end subroutine la_${ri}$gerq2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GERQF: computes an RQ factorization of a real M-by-N matrix A:
     !> A = R * Q.

     pure subroutine la_${ri}$gerqf(m,n,a,lda,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,k,ki,kk,ldwork,lwkopt,mu,nb,nbmin,nu, &
                     nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info == 0) then
              k = min(m,n)
              if (k == 0) then
                 lwkopt = 1
              else
                 nb = la_ilaenv(1,'${ri.upper()}$GERQF',' ',m,n,-1,-1)
                 lwkopt = m*nb
              end if
              work(1) = lwkopt
              if (.not. lquery) then
                 if (lwork <= 0 .or. (n > 0 .and. lwork < max(1,m))) info = -7
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GERQF',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (k == 0) then
              return
           end if
           nbmin = 2
           nx = 1
           iws = m
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$GERQF',' ',m,n,-1,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = m
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GERQF',' ',m,n,-1,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code initially.
              ! the last kk rows are handled by the block method.
              ki = ((k - nx - 1)/nb)*nb
              kk = min(k,ki + nb)
              do i = k - kk + ki + 1,k - kk + 1,-nb
                 ib = min(k - i + 1,nb)
                 ! compute the rq factorization of the current block
                 ! a(m-k+i:m-k+i+ib-1,1:n-k+i+ib-1)
                 call la_${ri}$gerq2(ib,n - k + i + ib - 1,a(m - k + i,1),lda,tau(i),work,iinfo)

                 if (m - k + i > 1) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i+ib-1) . . . h(i+1) h(i)
                    call la_${ri}$larft('BACKWARD','ROWWISE',n - k + i + ib - 1,ib,a(m - k + i,1),lda, &
                              tau(i),work,ldwork)
                    ! apply h to a(1:m-k+i-1,1:n-k+i+ib-1) from the right
                    call la_${ri}$larfb('RIGHT','NO TRANSPOSE','BACKWARD','ROWWISE',m - k + i - 1,n - &
                    k + i + ib - 1,ib,a(m - k + i,1),lda,work,ldwork,a,lda,work(ib + 1),ldwork)

                 end if
              end do
              mu = m - k + i + nb - 1
              nu = n - k + i + nb - 1
           else
              mu = m
              nu = n
           end if
           ! use unblocked code to factor the last or only block
           if (mu > 0 .and. nu > 0) call la_${ri}$gerq2(mu,nu,a,lda,tau,work,iinfo)
           work(1) = iws
           return
     end subroutine la_${ri}$gerqf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GGQRF: computes a generalized QR factorization of an N-by-M matrix A
     !> and an N-by-P matrix B:
     !> A = Q*R,        B = Q*T*Z,
     !> where Q is an N-by-N orthogonal matrix, Z is a P-by-P orthogonal
     !> matrix, and R and T assume one of the forms:
     !> if N >= M,  R = ( R11 ) M  ,   or if N < M,  R = ( R11  R12 ) N,
     !> (  0  ) N-M                         N   M-N
     !> M
     !> where R11 is upper triangular, and
     !> if N <= P,  T = ( 0  T12 ) N,   or if N > P,  T = ( T11 ) N-P,
     !> P-N  N                           ( T21 ) P
     !> P
     !> where T12 or T21 is upper triangular.
     !> In particular, if B is square and nonsingular, the GQR factorization
     !> of A and B implicitly gives the QR factorization of inv(B)*A:
     !> inv(B)*A = Z**T*(inv(T)*R)
     !> where inv(B) denotes the inverse of the matrix B, and Z**T denotes the
     !> transpose of the matrix Z.

     pure subroutine la_${ri}$ggqrf(n,m,p,a,lda,taua,b,ldb,taub,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,lwork,m,n,p
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: taua(*),taub(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: lopt,lwkopt,nb,nb1,nb2,nb3
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           nb1 = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',n,m,-1,-1)
           nb2 = la_ilaenv(1,'${ri.upper()}$GERQF',' ',n,p,-1,-1)
           nb3 = la_ilaenv(1,'${ri.upper()}$ORMQR',' ',n,m,p,-1)
           nb = max(nb1,nb2,nb3)
           lwkopt = max(n,m,p)*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (n < 0) then
              info = -1
           else if (m < 0) then
              info = -2
           else if (p < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,n)) then
              info = -8
           else if (lwork < max(1,n,m,p) .and. .not. lquery) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GGQRF',-info)
              return
           else if (lquery) then
              return
           end if
           ! qr factorization of n-by-m matrix a: a = q*r
           call la_${ri}$geqrf(n,m,a,lda,taua,work,lwork,info)
           lopt = work(1)
           ! update b := q**t*b.
           call la_${ri}$ormqr('LEFT','TRANSPOSE',n,p,min(n,m),a,lda,taua,b,ldb,work, &
                     lwork,info)
           lopt = max(lopt,int(work(1),KIND=ilp))
           ! rq factorization of n-by-p matrix b: b = t*z.
           call la_${ri}$gerqf(n,p,b,ldb,taub,work,lwork,info)
           work(1) = max(lopt,int(work(1),KIND=ilp))
           return
     end subroutine la_${ri}$ggqrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GGRQF: computes a generalized RQ factorization of an M-by-N matrix A
     !> and a P-by-N matrix B:
     !> A = R*Q,        B = Z*T*Q,
     !> where Q is an N-by-N orthogonal matrix, Z is a P-by-P orthogonal
     !> matrix, and R and T assume one of the forms:
     !> if M <= N,  R = ( 0  R12 ) M,   or if M > N,  R = ( R11 ) M-N,
     !> N-M  M                           ( R21 ) N
     !> N
     !> where R12 or R21 is upper triangular, and
     !> if P >= N,  T = ( T11 ) N  ,   or if P < N,  T = ( T11  T12 ) P,
     !> (  0  ) P-N                         P   N-P
     !> N
     !> where T11 is upper triangular.
     !> In particular, if B is square and nonsingular, the GRQ factorization
     !> of A and B implicitly gives the RQ factorization of A*inv(B):
     !> A*inv(B) = (R*inv(T))*Z**T
     !> where inv(B) denotes the inverse of the matrix B, and Z**T denotes the
     !> transpose of the matrix Z.

     pure subroutine la_${ri}$ggrqf(m,p,n,a,lda,taua,b,ldb,taub,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,lwork,m,n,p
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: taua(*),taub(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: lopt,lwkopt,nb,nb1,nb2,nb3
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           nb1 = la_ilaenv(1,'${ri.upper()}$GERQF',' ',m,n,-1,-1)
           nb2 = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',p,n,-1,-1)
           nb3 = la_ilaenv(1,'${ri.upper()}$ORMRQ',' ',m,n,p,-1)
           nb = max(nb1,nb2,nb3)
           lwkopt = max(n,m,p)*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (p < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldb < max(1,p)) then
              info = -8
           else if (lwork < max(1,m,p,n) .and. .not. lquery) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GGRQF',-info)
              return
           else if (lquery) then
              return
           end if
           ! rq factorization of m-by-n matrix a: a = r*q
           call la_${ri}$gerqf(m,n,a,lda,taua,work,lwork,info)
           lopt = work(1)
           ! update b := b*q**t
           call la_${ri}$ormrq('RIGHT','TRANSPOSE',p,n,min(m,n),a(max(1,m - n + 1),1), &
                     lda,taua,b,ldb,work,lwork,info)
           lopt = max(lopt,int(work(1),KIND=ilp))
           ! qr factorization of p-by-n matrix b: b = z*t
           call la_${ri}$geqrf(p,n,b,ldb,taub,work,lwork,info)
           work(1) = max(lopt,int(work(1),KIND=ilp))
           return
     end subroutine la_${ri}$ggrqf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAMTSQR: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'T':      Q**T * C       C * Q**T
     !> where Q is a real orthogonal matrix defined as the product
     !> of blocked elementary reflectors computed by tall skinny
     !> QR factorization (${ri.upper()}$LATSQR)

     pure subroutine la_${ri}$lamtsqr(side,trans,m,n,k,mb,nb,a,lda,t,ldt,c,ldc,work, &
               lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,k,mb,nb,ldt,lwork,ldc
           ! Array Arguments
           real(${rk}$),intent(in) :: a(lda,*),t(ldt,*)
           real(${rk}$),intent(out) :: work(*)
           real(${rk}$),intent(inout) :: c(ldc,*)
       ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran,lquery
           integer(ilp) :: i,ii,kk,lw,ctr,q
           ! External Subroutines
           ! Executable Statements
           ! test the input arguments
           lquery = lwork < 0
           notran = la_lsame(trans,'N')
           tran = la_lsame(trans,'T')
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           if (left) then
             lw = n*nb
             q = m
           else
             lw = mb*nb
             q = n
           end if
           info = 0
           if (.not. left .and. .not. right) then
              info = -1
           else if (.not. tran .and. .not. notran) then
              info = -2
           else if (m < k) then
             info = -3
           else if (n < 0) then
             info = -4
           else if (k < 0) then
             info = -5
           else if (k < nb .or. nb < 1) then
             info = -7
           else if (lda < max(1,q)) then
             info = -9
           else if (ldt < max(1,nb)) then
             info = -11
           else if (ldc < max(1,m)) then
              info = -13
           else if ((lwork < max(1,lw)) .and. (.not. lquery)) then
             info = -15
           end if
           ! determine the block size if it is tall skinny or short and wide
           if (info == 0) then
               work(1) = lw
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$LAMTSQR',-info)
             return
           else if (lquery) then
            return
           end if
           ! quick return if possible
           if (min(m,n,k) == 0) then
             return
           end if
           if ((mb <= k) .or. (mb >= max(m,n,k))) then
             call la_${ri}$gemqrt(side,trans,m,n,k,nb,a,lda,t,ldt,c,ldc,work,info)

             return
            end if
           if (left .and. notran) then
               ! multiply q to the last block of c
              kk = mod((m - k), (mb - k))
              ctr = (m - k)/(mb - k)
              if (kk > 0) then
                ii = m - kk + 1
                call la_${ri}$tpmqrt('L','N',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c(1, &
                          1),ldc,c(ii,1),ldc,work,info)
              else
                ii = m + 1
              end if
              do i = ii - (mb - k),mb + 1,-(mb - k)
               ! multiply q to the current block of c (i:i+mb,1:n)
                ctr = ctr - 1
#:if rk == "sp"
                call la_${ri}$tpmqrt('L','N',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt, &
                           c(1,1),ldc,c(i,1),ldc,work,info)
#:else
                call la_${ri}$tpmqrt('L','N',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c(1, &
                          1),ldc,c(i,1),ldc,work,info)
#:endif
              end do
               ! multiply q to the first block of c (1:mb,1:n)
              call la_${ri}$gemqrt('L','N',mb,n,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                        info)
           else if (left .and. tran) then
               ! multiply q to the first block of c
              kk = mod((m - k), (mb - k))
              ii = m - kk + 1
              ctr = 1
              call la_${ri}$gemqrt('L','T',mb,n,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                        info)
              do i = mb + 1,ii - mb + k, (mb - k)
               ! multiply q to the current block of c (i:i+mb,1:n)
               call la_${ri}$tpmqrt('L','T',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c( &
                         1,1),ldc,c(i,1),ldc,work,info)
               ctr = ctr + 1
              end do
              if (ii <= m) then
               ! multiply q to the last block of c
#:if rk == "sp"
               call la_${ri}$tpmqrt('L','T',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt, &
                         c(1,1),ldc,c(ii,1),ldc,work,info)
#:else
               call la_${ri}$tpmqrt('L','T',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c( &
                         1,1),ldc,c(ii,1),ldc,work,info)
#:endif
              end if
           else if (right .and. tran) then
               ! multiply q to the last block of c
               kk = mod((n - k), (mb - k))
               ctr = (n - k)/(mb - k)
               if (kk > 0) then
                 ii = n - kk + 1
#:if rk == "sp"
                 call la_${ri}$tpmqrt('R','T',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1), &
                           ldt,c(1,1),ldc,c(1,ii),ldc,work,info)
#:else
                 call la_${ri}$tpmqrt('R','T',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c( &
                           1,1),ldc,c(1,ii),ldc,work,info)
#:endif
               else
                 ii = n + 1
               end if
               do i = ii - (mb - k),mb + 1,-(mb - k)
               ! multiply q to the current block of c (1:m,i:i+mb)
                 ctr = ctr - 1
#:if rk == "sp"
                 call la_${ri}$tpmqrt('R','T',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1), &
                           ldt,c(1,1),ldc,c(1,i),ldc,work,info)
#:else
                 call la_${ri}$tpmqrt('R','T',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c( &
                           1,1),ldc,c(1,i),ldc,work,info)
#:endif
               end do
               ! multiply q to the first block of c (1:m,1:mb)
               call la_${ri}$gemqrt('R','T',m,mb,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                         info)
           else if (right .and. notran) then
               ! multiply q to the first block of c
              kk = mod((n - k), (mb - k))
              ii = n - kk + 1
              ctr = 1
              call la_${ri}$gemqrt('R','N',m,mb,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                        info)
              do i = mb + 1,ii - mb + k, (mb - k)
               ! multiply q to the current block of c (1:m,i:i+mb)
               call la_${ri}$tpmqrt('R','N',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt, &
                         c(1,1),ldc,c(1,i),ldc,work,info)
               ctr = ctr + 1
              end do
              if (ii <= n) then
               ! multiply q to the last block of c
               call la_${ri}$tpmqrt('R','N',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt, &
                         c(1,1),ldc,c(1,ii),ldc,work,info)
              end if
           end if
           work(1) = lw
           return
     end subroutine la_${ri}$lamtsqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAQP2: computes a QR factorization with column pivoting of
     !> the block A(OFFSET+1:M,1:N).
     !> The block A(1:OFFSET,1:N) is accordingly pivoted, but not factorized.

     pure subroutine la_${ri}$laqp2(m,n,offset,a,lda,jpvt,tau,vn1,vn2,work)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: lda,m,n,offset
           ! Array Arguments
           integer(ilp),intent(inout) :: jpvt(*)
           real(${rk}$),intent(inout) :: a(lda,*),vn1(*),vn2(*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,itemp,j,mn,offpi,pvt
           real(${rk}$) :: aii,temp,temp2,tol3z
           ! Intrinsic Functions
           intrinsic :: abs,max,min,sqrt
           ! Executable Statements
           mn = min(m - offset,n)
           tol3z = sqrt(la_${ri}$lamch('EPSILON'))
           ! compute factorization.
           loop_20: do i = 1,mn
              offpi = offset + i
              ! determine ith pivot column and swap if necessary.
              pvt = (i - 1) + la_i${ri}$amax(n - i + 1,vn1(i),1)
              if (pvt /= i) then
                 call la_${ri}$swap(m,a(1,pvt),1,a(1,i),1)
                 itemp = jpvt(pvt)
                 jpvt(pvt) = jpvt(i)
                 jpvt(i) = itemp
                 vn1(pvt) = vn1(i)
                 vn2(pvt) = vn2(i)
              end if
              ! generate elementary reflector h(i).
              if (offpi < m) then
                 call la_${ri}$larfg(m - offpi + 1,a(offpi,i),a(offpi + 1,i),1,tau(i))

              else
                 call la_${ri}$larfg(1,a(m,i),a(m,i),1,tau(i))
              end if
              if (i < n) then
                 ! apply h(i)**t to a(offset+i:m,i+1:n) from the left.
                 aii = a(offpi,i)
                 a(offpi,i) = one
                 call la_${ri}$larf('LEFT',m - offpi + 1,n - i,a(offpi,i),1,tau(i),a(offpi, &
                           i + 1),lda,work(1))
                 a(offpi,i) = aii
              end if
              ! update partial column norms.
              do j = i + 1,n
                 if (vn1(j) /= zero) then
                    ! note: the following 4 lines follow from the analysis in
                    ! lapack working note 176.
                    temp = one - (abs(a(offpi,j))/vn1(j))**2
                    temp = max(temp,zero)
                    temp2 = temp*(vn1(j)/vn2(j))**2
                    if (temp2 <= tol3z) then
                       if (offpi < m) then
                          vn1(j) = la_${ri}$nrm2(m - offpi,a(offpi + 1,j),1)
                          vn2(j) = vn1(j)
                       else
                          vn1(j) = zero
                          vn2(j) = zero
                       end if
                    else
                       vn1(j) = vn1(j)*sqrt(temp)
                    end if
                 end if
              end do
           end do loop_20
           return
     end subroutine la_${ri}$laqp2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LAQPS: computes a step of QR factorization with column pivoting
     !> of a real M-by-N matrix A by using Blas-3.  It tries to factorize
     !> NB columns from A starting from the row OFFSET+1, and updates all
     !> of the matrix with Blas-3 xGEMM.
     !> In some cases, due to catastrophic cancellations, it cannot
     !> factorize NB columns.  Hence, the actual number of factorized
     !> columns is returned in KB.
     !> Block A(1:OFFSET,1:N) is accordingly pivoted, but not factorized.

     pure subroutine la_${ri}$laqps(m,n,offset,nb,kb,a,lda,jpvt,tau,vn1,vn2,auxv,f, &
               ldf)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: kb
           integer(ilp),intent(in) :: lda,ldf,m,n,nb,offset
           ! Array Arguments
           integer(ilp),intent(inout) :: jpvt(*)
           real(${rk}$),intent(inout) :: a(lda,*),auxv(*),f(ldf,*),vn1(*),vn2(*)
           real(${rk}$),intent(out) :: tau(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: itemp,j,k,lastrk,lsticc,pvt,rk
           real(${rk}$) :: akk,temp,temp2,tol3z
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,max,min,nint,real,sqrt
#:else
           intrinsic :: abs,real,max,min,nint,sqrt
#:endif
           ! Executable Statements
           lastrk = min(m,n + offset)
           lsticc = 0
           k = 0
           tol3z = sqrt(la_${ri}$lamch('EPSILON'))
           ! beginning of while loop.
           10 continue
           if ((k < nb) .and. (lsticc == 0)) then
              k = k + 1
              rk = offset + k
              ! determine ith pivot column and swap if necessary
              pvt = (k - 1) + la_i${ri}$amax(n - k + 1,vn1(k),1)
              if (pvt /= k) then
                 call la_${ri}$swap(m,a(1,pvt),1,a(1,k),1)
                 call la_${ri}$swap(k - 1,f(pvt,1),ldf,f(k,1),ldf)
                 itemp = jpvt(pvt)
                 jpvt(pvt) = jpvt(k)
                 jpvt(k) = itemp
                 vn1(pvt) = vn1(k)
                 vn2(pvt) = vn2(k)
              end if
              ! apply previous householder reflectors to column k:
              ! a(rk:m,k) := a(rk:m,k) - a(rk:m,1:k-1)*f(k,1:k-1)**t.
              if (k > 1) then
                 call la_${ri}$gemv('NO TRANSPOSE',m - rk + 1,k - 1,-one,a(rk,1),lda,f(k,1), &
                           ldf,one,a(rk,k),1)
              end if
              ! generate elementary reflector h(k).
              if (rk < m) then
                 call la_${ri}$larfg(m - rk + 1,a(rk,k),a(rk + 1,k),1,tau(k))
              else
                 call la_${ri}$larfg(1,a(rk,k),a(rk,k),1,tau(k))
              end if
              akk = a(rk,k)
              a(rk,k) = one
              ! compute kth column of f:
              ! compute  f(k+1:n,k) := tau(k)*a(rk:m,k+1:n)**t*a(rk:m,k).
              if (k < n) then
                 call la_${ri}$gemv('TRANSPOSE',m - rk + 1,n - k,tau(k),a(rk,k + 1),lda,a(rk, &
                           k),1,zero,f(k + 1,k),1)
              end if
              ! padding f(1:k,k) with zeros.
              do j = 1,k
                 f(j,k) = zero
              end do
              ! incremental updating of f:
              ! f(1:n,k) := f(1:n,k) - tau(k)*f(1:n,1:k-1)*a(rk:m,1:k-1)**t
                          ! *a(rk:m,k).
              if (k > 1) then
                 call la_${ri}$gemv('TRANSPOSE',m - rk + 1,k - 1,-tau(k),a(rk,1),lda,a(rk,k &
                           ),1,zero,auxv(1),1)
                 call la_${ri}$gemv('NO TRANSPOSE',n,k - 1,one,f(1,1),ldf,auxv(1),1,one, &
                            f(1,k),1)
              end if
              ! update the current row of a:
              ! a(rk,k+1:n) := a(rk,k+1:n) - a(rk,1:k)*f(k+1:n,1:k)**t.
              if (k < n) then
                 call la_${ri}$gemv('NO TRANSPOSE',n - k,k,-one,f(k + 1,1),ldf,a(rk,1), &
                           lda,one,a(rk,k + 1),lda)
              end if
              ! update partial column norms.
              if (rk < lastrk) then
                 do j = k + 1,n
                    if (vn1(j) /= zero) then
                       ! note: the following 4 lines follow from the analysis in
                       ! lapack working note 176.
                       temp = abs(a(rk,j))/vn1(j)
                       temp = max(zero, (one + temp)*(one - temp))
                       temp2 = temp*(vn1(j)/vn2(j))**2
                       if (temp2 <= tol3z) then
                          vn2(j) = real(lsticc,KIND=${rk}$)
                          lsticc = j
                       else
                          vn1(j) = vn1(j)*sqrt(temp)
                       end if
                    end if
                 end do
              end if
              a(rk,k) = akk
              ! end of while loop.
              go to 10
           end if
           kb = k
           rk = offset + kb
           ! apply the block reflector to the rest of the matrix:
           ! a(offset+kb+1:m,kb+1:n) := a(offset+kb+1:m,kb+1:n) -
                               ! a(offset+kb+1:m,1:kb)*f(kb+1:n,1:kb)**t.
           if (kb < min(n,m - offset)) then
              call la_${ri}$gemm('NO TRANSPOSE','TRANSPOSE',m - rk,n - kb,kb,-one,a(rk + 1,1), &
                        lda,f(kb + 1,1),ldf,one,a(rk + 1,kb + 1),lda)
           end if
           ! recomputation of difficult columns.
           40 continue
           if (lsticc > 0) then
              itemp = nint(vn2(lsticc),KIND=ilp)
              vn1(lsticc) = la_${ri}$nrm2(m - rk,a(rk + 1,lsticc),1)
              ! note: the computation of vn1( lsticc ) relies on the fact that
#:if rk == "sp"
              ! la_${ri}$nrm2 does not fail on vectors with norm below the value of
              ! sqrt(la_${riu}$lamch('s'))
#:else
              ! la_${ril}$nrm2 does not fail on vectors with norm below the value of
              ! sqrt(la_${ri}$lamch('s'))
#:endif
              vn2(lsticc) = vn1(lsticc)
              lsticc = itemp
              go to 40
           end if
           return
     end subroutine la_${ri}$laqps
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$ORGTSQR: generates an M-by-N real matrix Q_out with orthonormal columns,
     !> which are the first N columns of a product of real orthogonal
     !> matrices of order M which are returned by ${ri.upper()}$LATSQR
     !> Q_out = first_N_columns_of( Q(1)_in * Q(2)_in * ... * Q(k)_in ).
     !> See the documentation for ${ri.upper()}$LATSQR.

     pure subroutine la_${ri}$orgtsqr(m,n,mb,nb,a,lda,t,ldt,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,lwork,m,n,mb,nb
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(in) :: t(ldt,*)
           real(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: iinfo,ldc,lworkopt,lc,lw,nblocal,j
           ! Intrinsic Functions
           intrinsic :: real,max,min
           ! Executable Statements
           ! test the input parameters
           lquery = lwork == -1
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0 .or. m < n) then
              info = -2
           else if (mb <= n) then
              info = -3
           else if (nb < 1) then
              info = -4
           else if (lda < max(1,m)) then
              info = -6
           else if (ldt < max(1,min(nb,n))) then
              info = -8
           else
              ! test the input lwork for the dimension of the array work.
              ! this workspace is used to store array c(ldc, n) and work(lwork)
              ! in the call to la_${ri}$lamtsqr. see the documentation for la_${ri}$lamtsqr.
              if (lwork < 2 .and. (.not. lquery)) then
                 info = -10
              else
                 ! set block size for column blocks
                 nblocal = min(nb,n)
                 ! lwork = -1, then set the size for the array c(ldc,n)
                 ! in la_${ri}$lamtsqr call and set the optimal size of the work array
                 ! work(lwork) in la_${ri}$lamtsqr call.
                 ldc = m
                 lc = ldc*n
                 lw = n*nblocal
                 lworkopt = lc + lw
                 if ((lwork < max(1,lworkopt)) .and. (.not. lquery)) then
                    info = -10
                 end if
              end if
           end if
           ! handle error in the input parameters and return workspace query.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$ORGTSQR',-info)
              return
           else if (lquery) then
              work(1) = real(lworkopt,KIND=${rk}$)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              work(1) = real(lworkopt,KIND=${rk}$)
              return
           end if
           ! (1) form explicitly the tall-skinny m-by-n left submatrix q1_in
           ! of m-by-m orthogonal matrix q_in, which is implicitly stored in
           ! the subdiagonal part of input array a and in the input array t.
           ! perform by the following operation using the routine la_${ri}$lamtsqr.
               ! q1_in = q_in * ( i ), where i is a n-by-n identity matrix,
                              ! ( 0 )        0 is a (m-n)-by-n zero matrix.
           ! (1a) form m-by-n matrix in the array work(1:ldc*n) with ones
           ! on the diagonal and zeros elsewhere.
           call la_${ri}$laset('F',m,n,zero,one,work,ldc)
           ! (1b)  on input, work(1:ldc*n) stores ( i );
                                                ! ( 0 )
                 ! on output, work(1:ldc*n) stores q1_in.
           call la_${ri}$lamtsqr('L','N',m,n,n,mb,nblocal,a,lda,t,ldt,work,ldc,work( &
                     lc + 1),lw,iinfo)
           ! (2) copy the result from the part of the work array (1:m,1:n)
           ! with the leading dimension ldc that starts at work(1) into
           ! the output array a(1:m,1:n) column-by-column.
           do j = 1,n
              call la_${ri}$copy(m,work((j - 1)*ldc + 1),1,a(1,j),1)
           end do
           work(1) = real(lworkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$orgtsqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$TPQRT: computes a blocked QR factorization of a real
     !> "triangular-pentagonal" matrix C, which is composed of a
     !> triangular block A and pentagonal block B, using the compact
     !> WY representation for Q.

     pure subroutine la_${ri}$tpqrt(m,n,l,nb,a,lda,b,ldb,t,ldt,work,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l,nb
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           real(${rk}$),intent(out) :: t(ldt,*),work(*)
       ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,ib,lb,mb,iinfo
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (l < 0 .or. (l > min(m,n) .and. min(m,n) >= 0)) then
              info = -3
           else if (nb < 1 .or. (nb > n .and. n > 0)) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else if (ldb < max(1,m)) then
              info = -8
           else if (ldt < nb) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$TPQRT',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) return
           do i = 1,n,nb
           ! compute the qr factorization of the current block
              ib = min(n - i + 1,nb)
              mb = min(m - l + i + ib - 1,m)
              if (i >= l) then
                 lb = 0
              else
                 lb = mb - m + l - i + 1
              end if
              call la_${ri}$tpqrt2(mb,ib,lb,a(i,i),lda,b(1,i),ldb,t(1,i),ldt,iinfo)

#:if rk == "sp"
           ! update by applying h^h to b(:,i+ib:n) from the left
#:else
           ! update by applying h**t to b(:,i+ib:n) from the left
#:endif
              if (i + ib <= n) then
                 call la_${ri}$tprfb('L','T','F','C',mb,n - i - ib + 1,ib,lb,b(1,i),ldb,t( &
                           1,i),ldt,a(i,i + ib),lda,b(1,i + ib),ldb,work,ib)
              end if
           end do
           return
     end subroutine la_${ri}$tpqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEMQR: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'T':      Q**T * C       C * Q**T
     !> where Q is a real orthogonal matrix defined as the product
     !> of blocked elementary reflectors computed by tall skinny
     !> QR factorization (${ri.upper()}$GEQR)

     pure subroutine la_${ri}$gemqr(side,trans,m,n,k,a,lda,t,tsize,c,ldc,work,lwork, &
               info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,k,tsize,lwork,ldc
           ! Array Arguments
           real(${rk}$),intent(in) :: a(lda,*),t(*)
           real(${rk}$),intent(inout) :: c(ldc,*)
           real(${rk}$),intent(out) :: work(*)
       ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran,lquery
           integer(ilp) :: mb,nb,lw,nblcks,mn
           ! Intrinsic Functions
           intrinsic :: int,max,min,mod
           ! Executable Statements
           ! test the input arguments
           lquery = lwork == -1
           notran = la_lsame(trans,'N')
           tran = la_lsame(trans,'T')
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           mb = int(t(2),KIND=ilp)
           nb = int(t(3),KIND=ilp)
           if (left) then
             lw = n*nb
             mn = m
           else
             lw = mb*nb
             mn = n
           end if
           if ((mb > k) .and. (mn > k)) then
             if (mod(mn - k,mb - k) == 0) then
               nblcks = (mn - k)/(mb - k)
             else
               nblcks = (mn - k)/(mb - k) + 1
             end if
           else
             nblcks = 1
           end if
           info = 0
           if (.not. left .and. .not. right) then
             info = -1
           else if (.not. tran .and. .not. notran) then
             info = -2
           else if (m < 0) then
             info = -3
           else if (n < 0) then
             info = -4
           else if (k < 0 .or. k > mn) then
             info = -5
           else if (lda < max(1,mn)) then
             info = -7
           else if (tsize < 5) then
             info = -9
           else if (ldc < max(1,m)) then
             info = -11
           else if ((lwork < max(1,lw)) .and. (.not. lquery)) then
             info = -13
           end if
           if (info == 0) then
             work(1) = lw
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$GEMQR',-info)
             return
           else if (lquery) then
             return
           end if
           ! quick return if possible
           if (min(m,n,k) == 0) then
             return
           end if
           if ((left .and. m <= k) .or. (right .and. n <= k) .or. (mb <= k) .or. (mb >= max(m,n, &
                     k))) then
             call la_${ri}$gemqrt(side,trans,m,n,k,nb,a,lda,t(6),nb,c,ldc,work,info &
                       )
           else
             call la_${ri}$lamtsqr(side,trans,m,n,k,mb,nb,a,lda,t(6),nb,c,ldc,work, &
                       lwork,info)
           end if
           work(1) = lw
           return
     end subroutine la_${ri}$gemqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQP3: computes a QR factorization with column pivoting of a
     !> matrix A:  A*P = Q*R  using Level 3 BLAS.

     pure subroutine la_${ri}$geqp3(m,n,a,lda,jpvt,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           integer(ilp),intent(inout) :: jpvt(*)
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: inb = 1
           integer(ilp),parameter :: inbmin = 2
           integer(ilp),parameter :: ixover = 3

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: fjb,iws,j,jb,lwkopt,minmn,minws,na,nb,nbmin,nfxd,nx,sm, &
                     sminmn,sn,topbmn
           ! Intrinsic Functions
           intrinsic :: int,max,min
#:if rk != "sp"
           ! Executable Statements
#:endif
           ! test input arguments
        ! ====================
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info == 0) then
              minmn = min(m,n)
              if (minmn == 0) then
                 iws = 1
                 lwkopt = 1
              else
                 iws = 3*n + 1
                 nb = la_ilaenv(inb,'${ri.upper()}$GEQRF',' ',m,n,-1,-1)
                 lwkopt = 2*n + (n + 1)*nb
              end if
              work(1) = lwkopt
              if ((lwork < iws) .and. .not. lquery) then
                 info = -8
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQP3',-info)
              return
           else if (lquery) then
              return
           end if
           ! move initial columns up front.
           nfxd = 1
           do j = 1,n
              if (jpvt(j) /= 0) then
                 if (j /= nfxd) then
                    call la_${ri}$swap(m,a(1,j),1,a(1,nfxd),1)
                    jpvt(j) = jpvt(nfxd)
                    jpvt(nfxd) = j
                 else
                    jpvt(j) = j
                 end if
                 nfxd = nfxd + 1
              else
                 jpvt(j) = j
              end if
           end do
           nfxd = nfxd - 1
           ! factorize fixed columns
        ! =======================
           ! compute the qr factorization of fixed columns and update
           ! remaining columns.
           if (nfxd > 0) then
              na = min(m,nfxd)
      ! cc      call la_${ri}$geqr2( m, na, a, lda, tau, work, info )
              call la_${ri}$geqrf(m,na,a,lda,tau,work,lwork,info)
              iws = max(iws,int(work(1),KIND=ilp))
              if (na < n) then
      ! cc         call la_${ri}$orm2r( 'left', 'transpose', m, n-na, na, a, lda,
      ! cc  $                   tau, a( 1, na+1 ), lda, work, info )
                 call la_${ri}$ormqr('LEFT','TRANSPOSE',m,n - na,na,a,lda,tau,a(1,na + 1), &
                           lda,work,lwork,info)
                 iws = max(iws,int(work(1),KIND=ilp))
              end if
           end if
           ! factorize free columns
        ! ======================
           if (nfxd < minmn) then
              sm = m - nfxd
              sn = n - nfxd
              sminmn = minmn - nfxd
              ! determine the block size.
              nb = la_ilaenv(inb,'${ri.upper()}$GEQRF',' ',sm,sn,-1,-1)
              nbmin = 2
              nx = 0
              if ((nb > 1) .and. (nb < sminmn)) then
                 ! determine when to cross over from blocked to unblocked code.
                 nx = max(0,la_ilaenv(ixover,'${ri.upper()}$GEQRF',' ',sm,sn,-1,-1))
                 if (nx < sminmn) then
                    ! determine if workspace is large enough for blocked code.
                    minws = 2*sn + (sn + 1)*nb
                    iws = max(iws,minws)
                    if (lwork < minws) then
                       ! not enough workspace to use optimal nb: reduce nb and
                       ! determine the minimum value of nb.
                       nb = (lwork - 2*sn)/(sn + 1)
                       nbmin = max(2,la_ilaenv(inbmin,'${ri.upper()}$GEQRF',' ',sm,sn,-1,-1))

                    end if
                 end if
              end if
              ! initialize partial column norms. the first n elements of work
              ! store the exact column norms.
              do j = nfxd + 1,n
                 work(j) = la_${ri}$nrm2(sm,a(nfxd + 1,j),1)
                 work(n + j) = work(j)
              end do
              if ((nb >= nbmin) .and. (nb < sminmn) .and. (nx < sminmn)) then
                 ! use blocked code initially.
                 j = nfxd + 1
                 ! compute factorization: while loop.
                 topbmn = minmn - nx
                 30 continue
                 if (j <= topbmn) then
                    jb = min(nb,topbmn - j + 1)
                    ! factorize jb columns among columns j:n.
                    call la_${ri}$laqps(m,n - j + 1,j - 1,jb,fjb,a(1,j),lda,jpvt(j),tau(j) &
                              ,work(j),work(n + j),work(2*n + 1),work(2*n + jb + 1),n - j + 1)
                    j = j + fjb
                    go to 30
                 end if
              else
                 j = nfxd + 1
              end if
              ! use unblocked code to factor the last or only block.
              if (j <= minmn) call la_${ri}$laqp2(m,n - j + 1,j - 1,a(1,j),lda,jpvt(j),tau(j), &
                         work(j),work(n + j),work(2*n + 1))
           end if
           work(1) = iws
           return
     end subroutine la_${ri}$geqp3
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQRT: computes a blocked QR factorization of a real M-by-N matrix A
     !> using the compact WY representation of Q.

     pure subroutine la_${ri}$geqrt(m,n,nb,a,lda,t,ldt,work,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,m,n,nb
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: t(ldt,*),work(*)
       ! =====================================================================
           ! Local Scalars
           logical(lk),parameter :: use_recursive_qr = .true.
           integer(ilp) :: i,ib,iinfo,k

           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nb < 1 .or. (nb > min(m,n) .and. min(m,n) > 0)) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldt < nb) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRT',-info)
              return
           end if
           ! quick return if possible
           k = min(m,n)
           if (k == 0) return
           ! blocked loop of length k
           do i = 1,k,nb
              ib = min(k - i + 1,nb)
           ! compute the qr factorization of the current block a(i:m,i:i+ib-1)
              if (use_recursive_qr) then
                 call la_${ri}$geqrt3(m - i + 1,ib,a(i,i),lda,t(1,i),ldt,iinfo)
              else
                 call la_${ri}$geqrt2(m - i + 1,ib,a(i,i),lda,t(1,i),ldt,iinfo)
              end if
              if (i + ib <= n) then
           ! update by applying h**t to a(i:m,i+ib:n) from the left
                 call la_${ri}$larfb('L','T','F','C',m - i + 1,n - i - ib + 1,ib,a(i,i),lda,t(1, &
                            i),ldt,a(i,i + ib),lda,work,n - i - ib + 1)
              end if
           end do
           return
     end subroutine la_${ri}$geqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$LATSQR: computes a blocked Tall-Skinny QR factorization of
     !> a real M-by-N matrix A for M >= N:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix, stored on exit in an implicit
     !> form in the elements below the diagonal of the array A and in
     !> the elements of the array T;
     !> R is an upper-triangular N-by-N matrix, stored on exit in
     !> the elements on and above the diagonal of the array A.
     !> 0 is a (M-N)-by-N zero matrix, and is not stored.

     pure subroutine la_${ri}$latsqr(m,n,mb,nb,a,lda,t,ldt,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd. --
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,mb,nb,ldt,lwork
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: work(*),t(ldt,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ii,kk,ctr
           ! External Subroutines
           intrinsic :: max,min,mod
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
             info = -1
           else if (n < 0 .or. m < n) then
             info = -2
           else if (mb < 1) then
             info = -3
           else if (nb < 1 .or. (nb > n .and. n > 0)) then
             info = -4
           else if (lda < max(1,m)) then
             info = -6
           else if (ldt < nb) then
             info = -8
           else if (lwork < (n*nb) .and. (.not. lquery)) then
             info = -10
           end if
           if (info == 0) then
             work(1) = nb*n
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$LATSQR',-info)
             return
           else if (lquery) then
            return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
               return
           end if
           ! the qr decomposition
            if ((mb <= n) .or. (mb >= m)) then
              call la_${ri}$geqrt(m,n,nb,a,lda,t,ldt,work,info)
              return
            end if
            kk = mod((m - n), (mb - n))
            ii = m - kk + 1
            ! compute the qr factorization of the first block a(1:mb,1:n)
            call la_${ri}$geqrt(mb,n,nb,a(1,1),lda,t,ldt,work,info)
            ctr = 1
            do i = mb + 1,ii - mb + n, (mb - n)
            ! compute the qr factorization of the current block a(i:i+mb-n,1:n)
              call la_${ri}$tpqrt(mb - n,n,0,nb,a(1,1),lda,a(i,1),lda,t(1,ctr*n + 1), &
                        ldt,work,info)
              ctr = ctr + 1
            end do
            ! compute the qr factorization of the last block a(ii:m,1:n)
            if (ii <= m) then
              call la_${ri}$tpqrt(kk,n,0,nb,a(1,1),lda,a(ii,1),lda,t(1,ctr*n + 1), &
                        ldt,work,info)
            end if
           work(1) = n*nb
           return
     end subroutine la_${ri}$latsqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GEQR: computes a QR factorization of a real M-by-N matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix;
     !> R is an upper-triangular N-by-N matrix;
     !> 0 is a (M-N)-by-N zero matrix, if M > N.

     pure subroutine la_${ri}$geqr(m,n,a,lda,t,tsize,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd. --
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,tsize,lwork
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: t(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery,lminws,mint,minw
           integer(ilp) :: mb,nb,mintsz,nblcks
           ! Intrinsic Functions
           intrinsic :: max,min,mod
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (tsize == -1 .or. tsize == -2 .or. lwork == -1 .or. lwork == -2)
           mint = .false.
           minw = .false.
           if (tsize == -2 .or. lwork == -2) then
             if (tsize /= -1) mint = .true.
             if (lwork /= -1) minw = .true.
           end if
           ! determine the block size
           if (min(m,n) > 0) then
             mb = la_ilaenv(1,'${ri.upper()}$GEQR ',' ',m,n,1,-1)
             nb = la_ilaenv(1,'${ri.upper()}$GEQR ',' ',m,n,2,-1)
           else
             mb = m
             nb = 1
           end if
           if (mb > m .or. mb <= n) mb = m
           if (nb > min(m,n) .or. nb < 1) nb = 1
           mintsz = n + 5
           if (mb > n .and. m > n) then
             if (mod(m - n,mb - n) == 0) then
               nblcks = (m - n)/(mb - n)
             else
               nblcks = (m - n)/(mb - n) + 1
             end if
           else
             nblcks = 1
           end if
           ! determine if the workspace size satisfies minimal size
           lminws = .false.
           if ((tsize < max(1,nb*n*nblcks + 5) .or. lwork < nb*n) .and. (lwork >= n) .and. ( &
                     tsize >= mintsz) .and. (.not. lquery)) then
             if (tsize < max(1,nb*n*nblcks + 5)) then
               lminws = .true.
               nb = 1
               mb = m
             end if
             if (lwork < nb*n) then
               lminws = .true.
               nb = 1
             end if
           end if
           if (m < 0) then
             info = -1
           else if (n < 0) then
             info = -2
           else if (lda < max(1,m)) then
             info = -4
           else if (tsize < max(1,nb*n*nblcks + 5) .and. (.not. lquery) .and. (.not. lminws)) &
                     then
             info = -6
           else if ((lwork < max(1,n*nb)) .and. (.not. lquery) .and. (.not. lminws)) &
                     then
             info = -8
           end if
           if (info == 0) then
             if (mint) then
               t(1) = mintsz
             else
               t(1) = nb*n*nblcks + 5
             end if
             t(2) = mb
             t(3) = nb
             if (minw) then
               work(1) = max(1,n)
             else
               work(1) = max(1,nb*n)
             end if
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$GEQR',-info)
             return
           else if (lquery) then
             return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
             return
           end if
           ! the qr decomposition
           if ((m <= n) .or. (mb <= n) .or. (mb >= m)) then
             call la_${ri}$geqrt(m,n,nb,a,lda,t(6),nb,work,info)
           else
             call la_${ri}$latsqr(m,n,mb,nb,a,lda,t(6),nb,work,lwork,info)
           end if
           work(1) = max(1,nb*n)
           return
     end subroutine la_${ri}$geqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_REAL_KINDS
     !> ${ri.upper()}$GETSQRHRT: computes a NB2-sized column blocked QR-factorization
#:if rk == "sp"
     !> of a complex M-by-N matrix A with M >= N,
#:else
     !> of a real M-by-N matrix A with M >= N,
#:endif
     !> A = Q * R.
     !> The routine uses internally a NB1-sized column blocked and MB1-sized
     !> row blocked TSQR-factorization and perfors the reconstruction
     !> of the Householder vectors from the TSQR output. The routine also
     !> converts the R_tsqr factor from the TSQR-factorization output into
     !> the R factor that corresponds to the Householder QR-factorization,
     !> A = Q_tsqr * R_tsqr = Q * R.
     !> The output Q and R factors are stored in the same format as in ${ri.upper()}$GEQRT
     !> (Q is in blocked compact WY-representation). See the documentation
     !> of ${ri.upper()}$GEQRT for more details on the format.

     pure subroutine la_${ri}$getsqrhrt(m,n,mb1,nb1,nb2,a,lda,t,ldt,work,lwork,info)
        use la_constants_${rk}$

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,lwork,m,n,nb1,nb2,mb1
           ! Array Arguments
           real(${rk}$),intent(inout) :: a(lda,*)
           real(${rk}$),intent(out) :: t(ldt,*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,iinfo,j,lw1,lw2,lwt,ldwt,lworkopt,nb1local,nb2local, &
                     num_all_row_blocks
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: ceiling,max,min
#:else
           intrinsic :: ceiling,real,max,min
#:endif
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (n < 0 .or. m < n) then
              info = -2
           else if (mb1 <= n) then
              info = -3
           else if (nb1 < 1) then
              info = -4
           else if (nb2 < 1) then
              info = -5
           else if (lda < max(1,m)) then
              info = -7
           else if (ldt < max(1,min(nb2,n))) then
              info = -9
           else
              ! test the input lwork for the dimension of the array work.
              ! this workspace is used to store array:
              ! a) matrix t and work for la_${ri}$latsqr;
              ! b) n-by-n upper-triangular factor r_tsqr;
              ! c) matrix t and array work for la_${ri}$orgtsqr_row;
              ! d) diagonal d for la_${ri}$orhr_col.
              if (lwork < n*n + 1 .and. .not. lquery) then
                 info = -11
              else
                 ! set block size for column blocks
                 nb1local = min(nb1,n)
                 num_all_row_blocks = max(1,ceiling(real(m - n,KIND=${rk}$)/real(mb1 - n, &
                           KIND=${rk}$)))
                 ! length and leading dimension of work array to place
                 ! t array in tsqr.
                 lwt = num_all_row_blocks*n*nb1local
                 ldwt = nb1local
                 ! length of tsqr work array
                 lw1 = nb1local*n
                 ! length of la_${ri}$orgtsqr_row work array.
                 lw2 = nb1local*max(nb1local, (n - nb1local))
                 lworkopt = max(lwt + lw1,max(lwt + n*n + lw2,lwt + n*n + n))
                 if ((lwork < max(1,lworkopt)) .and. (.not. lquery)) then
                    info = -11
                 end if
              end if
           end if
           ! handle error in the input parameters and return workspace query.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETSQRHRT',-info)
              return
           else if (lquery) then
              work(1) = real(lworkopt,KIND=${rk}$)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              work(1) = real(lworkopt,KIND=${rk}$)
              return
           end if
           nb2local = min(nb2,n)
           ! (1) perform tsqr-factorization of the m-by-n matrix a.
           call la_${ri}$latsqr(m,n,mb1,nb1local,a,lda,work,ldwt,work(lwt + 1),lw1,iinfo)

           ! (2) copy the factor r_tsqr stored in the upper-triangular part
               ! of a into the square matrix in the work array
               ! work(lwt+1:lwt+n*n) column-by-column.
           do j = 1,n
              call la_${ri}$copy(j,a(1,j),1,work(lwt + n*(j - 1) + 1),1)
           end do
           ! (3) generate a m-by-n matrix q with orthonormal columns from
           ! the result stored below the diagonal in the array a in place.
           call la_${ri}$orgtsqr_row(m,n,mb1,nb1local,a,lda,work,ldwt,work(lwt + n*n + 1), &
                     lw2,iinfo)
           ! (4) perform the reconstruction of householder vectors from
           ! the matrix q (stored in a) in place.
           call la_${ri}$orhr_col(m,n,nb2local,a,lda,t,ldt,work(lwt + n*n + 1),iinfo)

           ! (5) copy the factor r_tsqr stored in the square matrix in the
           ! work array work(lwt+1:lwt+n*n) into the upper-triangular
           ! part of a.
           ! (6) compute from r_tsqr the factor r_hr corresponding to
           ! the reconstructed householder vectors, i.e. r_hr = s * r_tsqr.
           ! this multiplication by the sign matrix s on the left means
           ! changing the sign of i-th row of the matrix r_tsqr according
           ! to sign of the i-th diagonal element diag(i) of the matrix s.
           ! diag is stored in work( lwt+n*n+1 ) from the la_${ri}$orhr_col output.
           ! (5) and (6) can be combined in a single loop, so the rows in a
           ! are accessed only once.
           do i = 1,n
              if (work(lwt + n*n + i) == -one) then
                 do j = i,n
                    a(i,j) = -one*work(lwt + n*(j - 1) + i)
                 end do
              else
                 call la_${ri}$copy(n - i + 1,work(lwt + n*(i - 1) + i),n,a(i,i),lda)
              end if
           end do
           work(1) = real(lworkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$getsqrhrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LARFB_GETT: applies a complex Householder block reflector H from the
     !> left to a complex (K+M)-by-N  "triangular-pentagonal" matrix
     !> composed of two block matrices: an upper trapezoidal K-by-N matrix A
     !> stored in the array A, and a rectangular M-by-(N-K) matrix B, stored
     !> in the array B. The block reflector H is stored in a compact
     !> WY-representation, where the elementary reflectors are in the
     !> arrays A, B and T. See Further Details section.

     pure subroutine la_${ri}$larfb_gett(ident,m,n,k,t,ldt,a,lda,b,ldb,work,ldwork)
        use la_constants_${rk}$

        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: ident
           integer(ilp),intent(in) :: k,lda,ldb,ldt,ldwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(in) :: t(ldt,*)
           complex(${rk}$),intent(out) :: work(ldwork,*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lnotident
           integer(ilp) :: i,j
           ! Executable Statements
           ! quick return if possible
           if (m < 0 .or. n <= 0 .or. k == 0 .or. k > n) return
           lnotident = .not. la_lsame(ident,'I')
           ! ------------------------------------------------------------------
           ! first step. computation of the column block 2:
              ! ( a2 ) := h * ( a2 )
              ! ( b2 )        ( b2 )
           ! ------------------------------------------------------------------
           if (n > k) then
              ! col2_(1) compute w2: = a2. therefore, copy a2 = a(1:k, k+1:n)
              ! into w2=work(1:k, 1:n-k) column-by-column.
              do j = 1,n - k
                 call la_${ri}$copy(k,a(1,k + j),1,work(1,j),1)
              end do
              if (lnotident) then
                 ! col2_(2) compute w2: = (v1**h) * w2 = (a1**h) * w2,
                 ! v1 is not an identy matrix, but unit lower-triangular
                 ! v1 stored in a1 (diagonal ones are not stored).
                 call la_${ri}$trmm('L','L','C','U',k,n - k,cone,a,lda,work,ldwork)

              end if
              ! col2_(3) compute w2: = w2 + (v2**h) * b2 = w2 + (b1**h) * b2
              ! v2 stored in b1.
              if (m > 0) then
                 call la_${ri}$gemm('C','N',k,n - k,m,cone,b,ldb,b(1,k + 1),ldb,cone, &
                           work,ldwork)
              end if
              ! col2_(4) compute w2: = t * w2,
              ! t is upper-triangular.
              call la_${ri}$trmm('L','U','N','N',k,n - k,cone,t,ldt,work,ldwork)
              ! col2_(5) compute b2: = b2 - v2 * w2 = b2 - b1 * w2,
              ! v2 stored in b1.
              if (m > 0) then
                 call la_${ri}$gemm('N','N',m,n - k,k,-cone,b,ldb,work,ldwork,cone,b(1, &
                           k + 1),ldb)
              end if
              if (lnotident) then
                 ! col2_(6) compute w2: = v1 * w2 = a1 * w2,
                 ! v1 is not an identity matrix, but unit lower-triangular,
                 ! v1 stored in a1 (diagonal ones are not stored).
                 call la_${ri}$trmm('L','L','N','U',k,n - k,cone,a,lda,work,ldwork)

              end if
              ! col2_(7) compute a2: = a2 - w2 =
                                   ! = a(1:k, k+1:n-k) - work(1:k, 1:n-k),
              ! column-by-column.
              do j = 1,n - k
                 do i = 1,k
                    a(i,k + j) = a(i,k + j) - work(i,j)
                 end do
              end do
           end if
           ! ------------------------------------------------------------------
           ! second step. computation of the column block 1:
              ! ( a1 ) := h * ( a1 )
              ! ( b1 )        (  0 )
           ! ------------------------------------------------------------------
           ! col1_(1) compute w1: = a1. copy the upper-triangular
           ! a1 = a(1:k, 1:k) into the upper-triangular
           ! w1 = work(1:k, 1:k) column-by-column.
           do j = 1,k
              call la_${ri}$copy(j,a(1,j),1,work(1,j),1)
           end do
           ! set the subdiagonal elements of w1 to zero column-by-column.
           do j = 1,k - 1
              do i = j + 1,k
                 work(i,j) = czero
              end do
           end do
           if (lnotident) then
              ! col1_(2) compute w1: = (v1**h) * w1 = (a1**h) * w1,
              ! v1 is not an identity matrix, but unit lower-triangular
              ! v1 stored in a1 (diagonal ones are not stored),
              ! w1 is upper-triangular with zeroes below the diagonal.
              call la_${ri}$trmm('L','L','C','U',k,k,cone,a,lda,work,ldwork)
           end if
           ! col1_(3) compute w1: = t * w1,
           ! t is upper-triangular,
           ! w1 is upper-triangular with zeroes below the diagonal.
           call la_${ri}$trmm('L','U','N','N',k,k,cone,t,ldt,work,ldwork)
           ! col1_(4) compute b1: = - v2 * w1 = - b1 * w1,
           ! v2 = b1, w1 is upper-triangular with zeroes below the diagonal.
           if (m > 0) then
              call la_${ri}$trmm('R','U','N','N',m,k,-cone,work,ldwork,b,ldb)
           end if
           if (lnotident) then
              ! col1_(5) compute w1: = v1 * w1 = a1 * w1,
              ! v1 is not an identity matrix, but unit lower-triangular
              ! v1 stored in a1 (diagonal ones are not stored),
              ! w1 is upper-triangular on input with zeroes below the diagonal,
              ! and square on output.
              call la_${ri}$trmm('L','L','N','U',k,k,cone,a,lda,work,ldwork)
              ! col1_(6) compute a1: = a1 - w1 = a(1:k, 1:k) - work(1:k, 1:k)
              ! column-by-column. a1 is upper-triangular on input.
              ! if ident, a1 is square on output, and w1 is square,
              ! if not ident, a1 is upper-triangular on output,
              ! w1 is upper-triangular.
              ! col1_(6)_a compute elements of a1 below the diagonal.
              do j = 1,k - 1
                 do i = j + 1,k
                    a(i,j) = -work(i,j)
                 end do
              end do
           end if
           ! col1_(6)_b compute elements of a1 on and above the diagonal.
           do j = 1,k
              do i = 1,j
                 a(i,j) = a(i,j) - work(i,j)
              end do
           end do
           return
     end subroutine la_${ri}$larfb_gett
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAUNHR_COL_GETRFNP2: computes the modified LU factorization without
     !> pivoting of a complex general M-by-N matrix A. The factorization has
     !> the form:
     !> A - S = L * U,
     !> where:
     !> S is a m-by-n diagonal sign matrix with the diagonal D, so that
     !> D(i) = S(i,i), 1 <= i <= min(M,N). The diagonal D is constructed
     !> as D(i)=-SIGN(A(i,i)), where A(i,i) is the value after performing
     !> i-1 steps of Gaussian elimination. This means that the diagonal
     !> element at each step of "modified" Gaussian elimination is at
     !> least one in absolute value (so that division-by-zero not
     !> possible during the division by the diagonal element);
     !> L is a M-by-N lower triangular matrix with unit diagonal elements
     !> (lower trapezoidal if M > N);
     !> and U is a M-by-N upper triangular matrix
     !> (upper trapezoidal if M < N).
     !> This routine is an auxiliary routine used in the Householder
     !> reconstruction routine ${ri.upper()}$UNHR_COL. In ${ri.upper()}$UNHR_COL, this routine is
     !> applied to an M-by-N matrix A with orthonormal columns, where each
     !> element is bounded by one in absolute value. With the choice of
     !> the matrix S above, one can show that the diagonal element at each
     !> step of Gaussian elimination is the largest (in absolute value) in
     !> the column on or below the diagonal, so that no pivoting is required
     !> for numerical stability [1].
     !> For more details on the Householder reconstruction algorithm,
     !> including the modified LU factorization, see [1].
     !> This is the recursive version of the LU factorization algorithm.
     !> Denote A - S by B. The algorithm divides the matrix B into four
     !> submatrices:
     !> [  B11 | B12  ]  where B11 is n1 by n1,
     !> B = [ -----|----- ]        B21 is (m-n1) by n1,
     !> [  B21 | B22  ]        B12 is n1 by n2,
     !> B22 is (m-n1) by n2,
     !> with n1 = min(m,n)/2, n2 = n-n1.
     !> The subroutine calls itself to factor B11, solves for B21,
     !> solves for B12, updates B22, then calls itself to factor B22.
     !> For more details on the recursive LU algorithm, see [2].
     !> ${ri.upper()}$LAUNHR_COL_GETRFNP2 is called to factorize a block by the blocked
     !> routine ${ri.upper()}$LAUNHR_COL_GETRFNP, which uses blocked code calling
     !> Level 3 BLAS to update the submatrix. However, ${ri.upper()}$LAUNHR_COL_GETRFNP2
     !> is self-sufficient and can be used without ${ri.upper()}$LAUNHR_COL_GETRFNP.
     !> [1] "Reconstructing Householder vectors from tall-skinny QR",
     !> G. Ballard, J. Demmel, L. Grigori, M. Jacquelin, H.D. Nguyen,
     !> E. Solomonik, J. Parallel Distrib. Comput.,
     !> vol. 85, pp. 3-31, 2015.
     !> [2] "Recursion leads to automatic variable blocking for dense linear
     !> algebra algorithms", F. Gustavson, IBM J. of Res. and Dev.,
     !> vol. 41, no. 6, pp. 737-755, 1997.

     pure recursive subroutine la_${ri}$launhr_col_getrfnp2(m,n,a,lda,d,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: d(*)
        ! =====================================================================

           ! Local Scalars
           real(${rk}$) :: sfmin
           integer(ilp) :: i,iinfo,n1,n2
           complex(${rk}$) :: z
           ! Intrinsic Functions
           intrinsic :: abs,real,cmplx,aimag,sign,max,min
           ! Statement Functions
           real(${rk}$) :: cabs1
           ! Statement Function Definitions
           cabs1(z) = abs(real(z,KIND=${rk}$)) + abs(aimag(z))
           ! Executable Statements
           ! test the input parameters
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$LAUNHR_COL_GETRFNP2',-info)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) return
           if (m == 1) then
              ! one row case, (also recursion termination case),
              ! use unblocked code
              ! transfer the sign
              d(1) = cmplx(-sign(one,real(a(1,1),KIND=${rk}$)),KIND=${rk}$)
              ! construct the row of u
              a(1,1) = a(1,1) - d(1)
           else if (n == 1) then
              ! one column case, (also recursion termination case),
              ! use unblocked code
              ! transfer the sign
              d(1) = cmplx(-sign(one,real(a(1,1),KIND=${rk}$)),KIND=${rk}$)
              ! construct the row of u
              a(1,1) = a(1,1) - d(1)
              ! scale the elements 2:m of the column
              ! determine machine safe minimum
              sfmin = la_${ci}$lamch('S')
              ! construct the subdiagonal elements of l
              if (cabs1(a(1,1)) >= sfmin) then
                 call la_${ri}$scal(m - 1,cone/a(1,1),a(2,1),1)
              else
                 do i = 2,m
                    a(i,1) = a(i,1)/a(1,1)
                 end do
              end if
           else
              ! divide the matrix b into four submatrices
              n1 = min(m,n)/2
              n2 = n - n1
              ! factor b11, recursive call
              call la_${ri}$launhr_col_getrfnp2(n1,n1,a,lda,d,iinfo)
              ! solve for b21
              call la_${ri}$trsm('R','U','N','N',m - n1,n1,cone,a,lda,a(n1 + 1,1),lda)

              ! solve for b12
              call la_${ri}$trsm('L','L','N','U',n1,n2,cone,a,lda,a(1,n1 + 1),lda)

              ! update b22, i.e. compute the schur complement
              ! b22 := b22 - b21*b12
              call la_${ri}$gemm('N','N',m - n1,n2,n1,-cone,a(n1 + 1,1),lda,a(1,n1 + 1), &
                        lda,cone,a(n1 + 1,n1 + 1),lda)
              ! factor b22, recursive call
              call la_${ri}$launhr_col_getrfnp2(m - n1,n2,a(n1 + 1,n1 + 1),lda,d(n1 + 1),iinfo)

           end if
           return
     end subroutine la_${ri}$launhr_col_getrfnp2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$TPQRT2: computes a QR factorization of a complex "triangular-pentagonal"
     !> matrix C, which is composed of a triangular block A and pentagonal block B,
     !> using the compact WY representation for Q.

     pure subroutine la_${ri}$tpqrt2(m,n,l,a,lda,b,ldb,t,ldt,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,j,p,mp,np
           complex(${rk}$) :: alpha
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (l < 0 .or. l > min(m,n)) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,m)) then
              info = -7
           else if (ldt < max(1,n)) then
              info = -9
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$TPQRT2',-info)
              return
           end if
           ! quick return if possible
           if (n == 0 .or. m == 0) return
           do i = 1,n
              ! generate elementary reflector h(i) to annihilate b(:,i)
              p = m - l + min(l,i)
              call la_${ri}$larfg(p + 1,a(i,i),b(1,i),1,t(i,1))
              if (i < n) then
                 ! w(1:n-i) := c(i:m,i+1:n)**h * c(i:m,i) [use w = t(:,n)]
                 do j = 1,n - i
                    t(j,n) = conjg(a(i,i + j))
                 end do
                 call la_${ri}$gemv('C',p,n - i,cone,b(1,i + 1),ldb,b(1,i),1,cone,t(1, &
                           n),1)
                 ! c(i:m,i+1:n) = c(i:m,i+1:n) + alpha*c(i:m,i)*w(1:n-1)**h
                 alpha = -conjg(t(i,1))
                 do j = 1,n - i
                    a(i,i + j) = a(i,i + j) + alpha*conjg(t(j,n))
                 end do
                 call la_${ri}$gerc(p,n - i,alpha,b(1,i),1,t(1,n),1,b(1,i + 1),ldb)

              end if
           end do
           do i = 2,n
              ! t(1:i-1,i) := c(i:m,1:i-1)**h * (alpha * c(i:m,i))
              alpha = -t(i,1)
              do j = 1,i - 1
                 t(j,i) = czero
              end do
              p = min(i - 1,l)
              mp = min(m - l + 1,m)
              np = min(p + 1,n)
              ! triangular part of b2
              do j = 1,p
                 t(j,i) = alpha*b(m - l + j,i)
              end do
              call la_${ri}$trmv('U','C','N',p,b(mp,1),ldb,t(1,i),1)
              ! rectangular part of b2
              call la_${ri}$gemv('C',l,i - 1 - p,alpha,b(mp,np),ldb,b(mp,i),1,czero,t( &
                        np,i),1)
              ! b1
              call la_${ri}$gemv('C',m - l,i - 1,alpha,b,ldb,b(1,i),1,cone,t(1,i),1)

              ! t(1:i-1,i) := t(1:i-1,1:i-1) * t(1:i-1,i)
              call la_${ri}$trmv('U','N','N',i - 1,t,ldt,t(1,i),1)
              ! t(i,i) = tau(i)
              t(i,i) = t(i,1)
              t(i,1) = czero
           end do
     end subroutine la_${ri}$tpqrt2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$TPRFB: applies a complex "triangular-pentagonal" block reflector H or its
     !> conjugate transpose H**H to a complex matrix C, which is composed of two
     !> blocks A and B, either from the left or right.

     pure subroutine la_${ri}$tprfb(side,trans,direct,storev,m,n,k,l,v,ldv,t,ldt,a, &
               lda,b,ldb,work,ldwork)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: direct,side,storev,trans
           integer(ilp),intent(in) :: k,l,lda,ldb,ldt,ldv,ldwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(in) :: t(ldt,*),v(ldv,*)
           complex(${rk}$),intent(out) :: work(ldwork,*)
        ! ==========================================================================

           ! Local Scalars
           integer(ilp) :: i,j,mp,np,kp
           logical(lk) :: left,forward,column,right,backward,row
           ! Intrinsic Functions
           intrinsic :: conjg
           ! Executable Statements
           ! quick return if possible
           if (m <= 0 .or. n <= 0 .or. k <= 0 .or. l < 0) return
           if (la_lsame(storev,'C')) then
              column = .true.
              row = .false.
           else if (la_lsame(storev,'R')) then
              column = .false.
              row = .true.
           else
              column = .false.
              row = .false.
           end if
           if (la_lsame(side,'L')) then
              left = .true.
              right = .false.
           else if (la_lsame(side,'R')) then
              left = .false.
              right = .true.
           else
              left = .false.
              right = .false.
           end if
           if (la_lsame(direct,'F')) then
              forward = .true.
              backward = .false.
           else if (la_lsame(direct,'B')) then
              forward = .false.
              backward = .true.
           else
              forward = .false.
              backward = .false.
           end if
       ! ---------------------------------------------------------------------------
           if (column .and. forward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i ]    (k-by-k)
                        ! [ v ]    (m-by-k)
              ! form  h c  or  h**h c  where  c = [ a ]  (k-by-n)
                                                ! [ b ]  (m-by-n)
              ! h = i - w t w**h          or  h**h = i - w t**h w**h
              ! a = a -   t (a + v**h b)  or  a = a -   t**h (a + v**h b)
              ! b = b - v t (a + v**h b)  or  b = b - v t**h (a + v**h b)
       ! ---------------------------------------------------------------------------
              mp = min(m - l + 1,m)
              kp = min(l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(i,j) = b(m - l + i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U','C','N',l,n,cone,v(mp,1),ldv,work,ldwork)

              call la_${ri}$gemm('C','N',l,n,m - l,cone,v,ldv,b,ldb,cone,work,ldwork)

              call la_${ri}$gemm('C','N',k - l,n,m,cone,v(1,kp),ldv,b,ldb,czero,work( &
                        kp,1),ldwork)
              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U',trans,'N',k,n,cone,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m - l,n,k,-cone,v,ldv,work,ldwork,cone,b,ldb)

              call la_${ri}$gemm('N','N',l,n,k - l,-cone,v(mp,kp),ldv,work(kp,1), &
                        ldwork,cone,b(mp,1),ldb)
              call la_${ri}$trmm('L','U','N','N',l,n,cone,v(mp,1),ldv,work,ldwork)

              do j = 1,n
                 do i = 1,l
                    b(m - l + i,j) = b(m - l + i,j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (column .and. forward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i ]    (k-by-k)
                        ! [ v ]    (n-by-k)
              ! form  c h or  c h**h  where  c = [ a b ] (a is m-by-k, b is m-by-n)
              ! h = i - w t w**h          or  h**h = i - w t**h w**h
              ! a = a - (a + b v) t      or  a = a - (a + b v) t**h
              ! b = b - (a + b v) t v**h  or  b = b - (a + b v) t**h v**h
       ! ---------------------------------------------------------------------------
              np = min(n - l + 1,n)
              kp = min(l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,j) = b(i,n - l + j)
                 end do
              end do
              call la_${ri}$trmm('R','U','N','N',m,l,cone,v(np,1),ldv,work,ldwork)

              call la_${ri}$gemm('N','N',m,l,n - l,cone,b,ldb,v,ldv,cone,work,ldwork)

              call la_${ri}$gemm('N','N',m,k - l,n,cone,b,ldb,v(1,kp),ldv,czero,work( &
                        1,kp),ldwork)
              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','U',trans,'N',m,k,cone,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','C',m,n - l,k,-cone,work,ldwork,v,ldv,cone,b,ldb)

              call la_${ri}$gemm('N','C',m,l,k - l,-cone,work(1,kp),ldwork,v(np,kp), &
                        ldv,cone,b(1,np),ldb)
              call la_${ri}$trmm('R','U','C','N',m,l,cone,v(np,1),ldv,work,ldwork)

              do j = 1,l
                 do i = 1,m
                    b(i,n - l + j) = b(i,n - l + j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (column .and. backward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v ]    (m-by-k)
                        ! [ i ]    (k-by-k)
              ! form  h c  or  h**h c  where  c = [ b ]  (m-by-n)
                                                ! [ a ]  (k-by-n)
              ! h = i - w t w**h          or  h**h = i - w t**h w**h
              ! a = a -   t (a + v**h b)  or  a = a -   t**h (a + v**h b)
              ! b = b - v t (a + v**h b)  or  b = b - v t**h (a + v**h b)
       ! ---------------------------------------------------------------------------
              mp = min(l + 1,m)
              kp = min(k - l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(k - l + i,j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L','C','N',l,n,cone,v(1,kp),ldv,work(kp,1), &
                        ldwork)
              call la_${ri}$gemm('C','N',l,n,m - l,cone,v(mp,kp),ldv,b(mp,1),ldb, &
                        cone,work(kp,1),ldwork)
              call la_${ri}$gemm('C','N',k - l,n,m,cone,v,ldv,b,ldb,czero,work,ldwork)

              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L',trans,'N',k,n,cone,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m - l,n,k,-cone,v(mp,1),ldv,work,ldwork,cone, &
                        b(mp,1),ldb)
              call la_${ri}$gemm('N','N',l,n,k - l,-cone,v,ldv,work,ldwork,cone,b,ldb)

              call la_${ri}$trmm('L','L','N','N',l,n,cone,v(1,kp),ldv,work(kp,1), &
                        ldwork)
              do j = 1,n
                 do i = 1,l
                    b(i,j) = b(i,j) - work(k - l + i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (column .and. backward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v ]    (n-by-k)
                        ! [ i ]    (k-by-k)
              ! form  c h  or  c h**h  where  c = [ b a ] (b is m-by-n, a is m-by-k)
              ! h = i - w t w**h          or  h**h = i - w t**h w**h
              ! a = a - (a + b v) t      or  a = a - (a + b v) t**h
              ! b = b - (a + b v) t v**h  or  b = b - (a + b v) t**h v**h
       ! ---------------------------------------------------------------------------
              np = min(l + 1,n)
              kp = min(k - l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,k - l + j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','L','N','N',m,l,cone,v(1,kp),ldv,work(1,kp), &
                        ldwork)
              call la_${ri}$gemm('N','N',m,l,n - l,cone,b(1,np),ldb,v(np,kp),ldv, &
                        cone,work(1,kp),ldwork)
              call la_${ri}$gemm('N','N',m,k - l,n,cone,b,ldb,v,ldv,czero,work,ldwork)

              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','L',trans,'N',m,k,cone,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','C',m,n - l,k,-cone,work,ldwork,v(np,1),ldv,cone, &
                        b(1,np),ldb)
              call la_${ri}$gemm('N','C',m,l,k - l,-cone,work,ldwork,v,ldv,cone,b,ldb)

              call la_${ri}$trmm('R','L','C','N',m,l,cone,v(1,kp),ldv,work(1,kp), &
                        ldwork)
              do j = 1,l
                 do i = 1,m
                    b(i,j) = b(i,j) - work(i,k - l + j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. forward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i v ] ( i is k-by-k, v is k-by-m )
              ! form  h c  or  h**h c  where  c = [ a ]  (k-by-n)
                                                ! [ b ]  (m-by-n)
              ! h = i - w**h t w          or  h**h = i - w**h t**h w
              ! a = a -     t (a + v b)  or  a = a -     t**h (a + v b)
              ! b = b - v**h t (a + v b)  or  b = b - v**h t**h (a + v b)
       ! ---------------------------------------------------------------------------
              mp = min(m - l + 1,m)
              kp = min(l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(i,j) = b(m - l + i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L','N','N',l,n,cone,v(1,mp),ldv,work,ldb)

              call la_${ri}$gemm('N','N',l,n,m - l,cone,v,ldv,b,ldb,cone,work,ldwork)

              call la_${ri}$gemm('N','N',k - l,n,m,cone,v(kp,1),ldv,b,ldb,czero,work( &
                        kp,1),ldwork)
              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U',trans,'N',k,n,cone,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('C','N',m - l,n,k,-cone,v,ldv,work,ldwork,cone,b,ldb)

              call la_${ri}$gemm('C','N',l,n,k - l,-cone,v(kp,mp),ldv,work(kp,1), &
                        ldwork,cone,b(mp,1),ldb)
              call la_${ri}$trmm('L','L','C','N',l,n,cone,v(1,mp),ldv,work,ldwork)

              do j = 1,n
                 do i = 1,l
                    b(m - l + i,j) = b(m - l + i,j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. forward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ i v ] ( i is k-by-k, v is k-by-n )
              ! form  c h  or  c h**h  where  c = [ a b ] (a is m-by-k, b is m-by-n)
              ! h = i - w**h t w            or  h**h = i - w**h t**h w
              ! a = a - (a + b v**h) t      or  a = a - (a + b v**h) t**h
              ! b = b - (a + b v**h) t v    or  b = b - (a + b v**h) t**h v
       ! ---------------------------------------------------------------------------
              np = min(n - l + 1,n)
              kp = min(l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,j) = b(i,n - l + j)
                 end do
              end do
              call la_${ri}$trmm('R','L','C','N',m,l,cone,v(1,np),ldv,work,ldwork)

              call la_${ri}$gemm('N','C',m,l,n - l,cone,b,ldb,v,ldv,cone,work,ldwork)

              call la_${ri}$gemm('N','C',m,k - l,n,cone,b,ldb,v(kp,1),ldv,czero,work( &
                        1,kp),ldwork)
              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','U',trans,'N',m,k,cone,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m,n - l,k,-cone,work,ldwork,v,ldv,cone,b,ldb)

              call la_${ri}$gemm('N','N',m,l,k - l,-cone,work(1,kp),ldwork,v(kp,np), &
                        ldv,cone,b(1,np),ldb)
              call la_${ri}$trmm('R','L','N','N',m,l,cone,v(1,np),ldv,work,ldwork)

              do j = 1,l
                 do i = 1,m
                    b(i,n - l + j) = b(i,n - l + j) - work(i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. backward .and. left) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v i ] ( i is k-by-k, v is k-by-m )
              ! form  h c  or  h**h c  where  c = [ b ]  (m-by-n)
                                                ! [ a ]  (k-by-n)
              ! h = i - w**h t w          or  h**h = i - w**h t**h w
              ! a = a -     t (a + v b)  or  a = a -     t**h (a + v b)
              ! b = b - v**h t (a + v b)  or  b = b - v**h t**h (a + v b)
       ! ---------------------------------------------------------------------------
              mp = min(l + 1,m)
              kp = min(k - l + 1,k)
              do j = 1,n
                 do i = 1,l
                    work(k - l + i,j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','U','N','N',l,n,cone,v(kp,1),ldv,work(kp,1), &
                        ldwork)
              call la_${ri}$gemm('N','N',l,n,m - l,cone,v(kp,mp),ldv,b(mp,1),ldb, &
                        cone,work(kp,1),ldwork)
              call la_${ri}$gemm('N','N',k - l,n,m,cone,v,ldv,b,ldb,czero,work,ldwork)

              do j = 1,n
                 do i = 1,k
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('L','L ',trans,'N',k,n,cone,t,ldt,work,ldwork)
              do j = 1,n
                 do i = 1,k
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('C','N',m - l,n,k,-cone,v(1,mp),ldv,work,ldwork,cone, &
                        b(mp,1),ldb)
              call la_${ri}$gemm('C','N',l,n,k - l,-cone,v,ldv,work,ldwork,cone,b,ldb)

              call la_${ri}$trmm('L','U','C','N',l,n,cone,v(kp,1),ldv,work(kp,1), &
                        ldwork)
              do j = 1,n
                 do i = 1,l
                    b(i,j) = b(i,j) - work(k - l + i,j)
                 end do
              end do
       ! ---------------------------------------------------------------------------
           else if (row .and. backward .and. right) then
       ! ---------------------------------------------------------------------------
              ! let  w =  [ v i ] ( i is k-by-k, v is k-by-n )
              ! form  c h  or  c h**h  where  c = [ b a ] (a is m-by-k, b is m-by-n)
              ! h = i - w**h t w            or  h**h = i - w**h t**h w
              ! a = a - (a + b v**h) t      or  a = a - (a + b v**h) t**h
              ! b = b - (a + b v**h) t v    or  b = b - (a + b v**h) t**h v
       ! ---------------------------------------------------------------------------
              np = min(l + 1,n)
              kp = min(k - l + 1,k)
              do j = 1,l
                 do i = 1,m
                    work(i,k - l + j) = b(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','U','C','N',m,l,cone,v(kp,1),ldv,work(1,kp), &
                        ldwork)
              call la_${ri}$gemm('N','C',m,l,n - l,cone,b(1,np),ldb,v(kp,np),ldv, &
                        cone,work(1,kp),ldwork)
              call la_${ri}$gemm('N','C',m,k - l,n,cone,b,ldb,v,ldv,czero,work,ldwork)

              do j = 1,k
                 do i = 1,m
                    work(i,j) = work(i,j) + a(i,j)
                 end do
              end do
              call la_${ri}$trmm('R','L',trans,'N',m,k,cone,t,ldt,work,ldwork)
              do j = 1,k
                 do i = 1,m
                    a(i,j) = a(i,j) - work(i,j)
                 end do
              end do
              call la_${ri}$gemm('N','N',m,n - l,k,-cone,work,ldwork,v(1,np),ldv,cone, &
                        b(1,np),ldb)
              call la_${ri}$gemm('N','N',m,l,k - l,-cone,work,ldwork,v,ldv,cone,b,ldb)

              call la_${ri}$trmm('R','U','N','N',m,l,cone,v(kp,1),ldv,work(1,kp), &
                        ldwork)
              do j = 1,l
                 do i = 1,m
                    b(i,j) = b(i,j) - work(i,k - l + j)
                 end do
              end do
           end if
           return
     end subroutine la_${ri}$tprfb
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNG2R: generates an m by n complex matrix Q with orthonormal columns,
     !> which is defined as the first n columns of a product of k elementary
     !> reflectors of order m
     !> Q  =  H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF.

     pure subroutine la_${ri}$ung2r(m,n,k,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,j,l
           ! Intrinsic Functions
           intrinsic :: max
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0 .or. n > m) then
              info = -2
           else if (k < 0 .or. k > n) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNG2R',-info)
              return
           end if
           ! quick return if possible
           if (n <= 0) return
           ! initialise columns k+1:n to columns of the unit matrix
           do j = k + 1,n
              do l = 1,m
                 a(l,j) = czero
              end do
              a(j,j) = cone
           end do
           do i = k,1,-1
              ! apply h(i) to a(i:m,i:n) from the left
              if (i < n) then
                 a(i,i) = cone
                 call la_${ri}$larf('LEFT',m - i + 1,n - i,a(i,i),1,tau(i),a(i,i + 1),lda, &
                           work)
              end if
              if (i < m) call la_${ri}$scal(m - i,-tau(i),a(i + 1,i),1)
              a(i,i) = cone - tau(i)
              ! set a(1:i-1,i) to czero
              do l = 1,i - 1
                 a(l,i) = czero
              end do
           end do
           return
     end subroutine la_${ri}$ung2r
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNGQR: generates an M-by-N complex matrix Q with orthonormal columns,
     !> which is defined as the first N columns of a product of K elementary
     !> reflectors of order M
     !> Q  =  H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF.

     pure subroutine la_${ri}$ungqr(m,n,k,a,lda,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,j,ki,kk,l,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$UNGQR',' ',m,n,k,-1)
           lwkopt = max(1,n)*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0 .or. n > m) then
              info = -2
           else if (k < 0 .or. k > n) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (lwork < max(1,n) .and. .not. lquery) then
              info = -8
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNGQR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (n <= 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           nx = 0
           iws = n
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$UNGQR',' ',m,n,k,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$UNGQR',' ',m,n,k,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code after the last block.
              ! the first kk columns are handled by the block method.
              ki = ((k - nx - 1)/nb)*nb
              kk = min(k,ki + nb)
              ! set a(1:kk,kk+1:n) to czero.
              do j = kk + 1,n
                 do i = 1,kk
                    a(i,j) = czero
                 end do
              end do
           else
              kk = 0
           end if
           ! use unblocked code for the last or only block.
           if (kk < n) call la_${ri}$ung2r(m - kk,n - kk,k - kk,a(kk + 1,kk + 1),lda,tau(kk + 1),work, &
                      iinfo)
           if (kk > 0) then
              ! use blocked code
              do i = ki + 1,1,-nb
                 ib = min(nb,k - i + 1)
                 if (i + ib <= n) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i) h(i+1) . . . h(i+ib-1)
                    call la_${ri}$larft('FORWARD','COLUMNWISE',m - i + 1,ib,a(i,i),lda,tau(i &
                              ),work,ldwork)
                    ! apply h to a(i:m,i+ib:n) from the left
                    call la_${ri}$larfb('LEFT','NO TRANSPOSE','FORWARD','COLUMNWISE',m - i + 1,n - &
                    i - ib + 1,ib,a(i,i),lda,work,ldwork,a(i,i + ib),lda,work(ib + 1), &
                              ldwork)
                 end if
                 ! apply h to rows i:m of current block
                 call la_${ri}$ung2r(m - i + 1,ib,ib,a(i,i),lda,tau(i),work,iinfo)
                 ! set rows 1:i-1 of current block to czero
                 do j = i,i + ib - 1
                    do l = 1,i - 1
                       a(l,j) = czero
                    end do
                 end do
              end do
           end if
           work(1) = iws
           return
     end subroutine la_${ri}$ungqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNGR2: generates an m by n complex matrix Q with orthonormal rows,
     !> which is defined as the last m rows of a product of k elementary
     !> reflectors of order n
     !> Q  =  H(1)**H H(2)**H . . . H(k)**H
     !> as returned by ${ri.upper()}$GERQF.

     pure subroutine la_${ri}$ungr2(m,n,k,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,ii,j,l
           ! Intrinsic Functions
           intrinsic :: conjg,max
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < m) then
              info = -2
           else if (k < 0 .or. k > m) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNGR2',-info)
              return
           end if
           ! quick return if possible
           if (m <= 0) return
           if (k < m) then
              ! initialise rows 1:m-k to rows of the unit matrix
              do j = 1,n
                 do l = 1,m - k
                    a(l,j) = czero
                 end do
                 if (j > n - m .and. j <= n - k) a(m - n + j,j) = cone
              end do
           end if
           do i = 1,k
              ii = m - k + i
              ! apply h(i)**h to a(1:m-k+i,1:n-k+i) from the right
              call la_${ri}$lacgv(n - m + ii - 1,a(ii,1),lda)
              a(ii,n - m + ii) = cone
              call la_${ri}$larf('RIGHT',ii - 1,n - m + ii,a(ii,1),lda,conjg(tau(i)),a,lda, &
                         work)
              call la_${ri}$scal(n - m + ii - 1,-tau(i),a(ii,1),lda)
              call la_${ri}$lacgv(n - m + ii - 1,a(ii,1),lda)
              a(ii,n - m + ii) = cone - conjg(tau(i))
              ! set a(m-k+i,n-k+i+1:n) to czero
              do l = n - m + ii + 1,n
                 a(ii,l) = czero
              end do
           end do
           return
     end subroutine la_${ri}$ungr2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNGRQ: generates an M-by-N complex matrix Q with orthonormal rows,
     !> which is defined as the last M rows of a product of K elementary
     !> reflectors of order N
     !> Q  =  H(1)**H H(2)**H . . . H(k)**H
     !> as returned by ${ri.upper()}$GERQF.

     pure subroutine la_${ri}$ungrq(m,n,k,a,lda,tau,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,ii,iinfo,iws,j,kk,l,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < m) then
              info = -2
           else if (k < 0 .or. k > m) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           end if
           if (info == 0) then
              if (m <= 0) then
                 lwkopt = 1
              else
                 nb = la_ilaenv(1,'${ri.upper()}$UNGRQ',' ',m,n,k,-1)
                 lwkopt = m*nb
              end if
              work(1) = lwkopt
              if (lwork < max(1,m) .and. .not. lquery) then
                 info = -8
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNGRQ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m <= 0) then
              return
           end if
           nbmin = 2
           nx = 0
           iws = m
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$UNGRQ',' ',m,n,k,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = m
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$UNGRQ',' ',m,n,k,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code after the first block.
              ! the last kk rows are handled by the block method.
              kk = min(k, ((k - nx + nb - 1)/nb)*nb)
              ! set a(1:m-kk,n-kk+1:n) to czero.
              do j = n - kk + 1,n
                 do i = 1,m - kk
                    a(i,j) = czero
                 end do
              end do
           else
              kk = 0
           end if
           ! use unblocked code for the first or only block.
           call la_${ri}$ungr2(m - kk,n - kk,k - kk,a,lda,tau,work,iinfo)
           if (kk > 0) then
              ! use blocked code
              do i = k - kk + 1,k,nb
                 ib = min(nb,k - i + 1)
                 ii = m - k + i
                 if (ii > 1) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i+ib-1) . . . h(i+1) h(i)
                    call la_${ri}$larft('BACKWARD','ROWWISE',n - k + i + ib - 1,ib,a(ii,1),lda, &
                              tau(i),work,ldwork)
                    ! apply h**h to a(1:m-k+i-1,1:n-k+i+ib-1) from the right
                    call la_${ri}$larfb('RIGHT','CONJUGATE TRANSPOSE','BACKWARD','ROWWISE',ii - &
                    1,n - k + i + ib - 1,ib,a(ii,1),lda,work,ldwork,a,lda,work(ib + 1),ldwork)

                 end if
                 ! apply h**h to columns 1:n-k+i+ib-1 of current block
                 call la_${ri}$ungr2(ib,n - k + i + ib - 1,ib,a(ii,1),lda,tau(i),work,iinfo)

                 ! set columns n-k+i+ib:n of current block to czero
                 do l = n - k + i + ib,n
                    do j = ii,ii + ib - 1
                       a(j,l) = czero
                    end do
                 end do
              end do
           end if
           work(1) = iws
           return
     end subroutine la_${ri}$ungrq
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNGTSQR_ROW: generates an M-by-N complex matrix Q_out with
     !> orthonormal columns from the output of ${ri.upper()}$LATSQR. These N orthonormal
     !> columns are the first N columns of a product of complex unitary
     !> matrices Q(k)_in of order M, which are returned by ${ri.upper()}$LATSQR in
     !> a special format.
     !> Q_out = first_N_columns_of( Q(1)_in * Q(2)_in * ... * Q(k)_in ).
     !> The input matrices Q(k)_in are stored in row and column blocks in A.
     !> See the documentation of ${ri.upper()}$LATSQR for more details on the format of
     !> Q(k)_in, where each Q(k)_in is represented by block Householder
     !> transformations. This routine calls an auxiliary routine ${ri.upper()}$LARFB_GETT,
     !> where the computation is performed on each individual block. The
     !> algorithm first sweeps NB-sized column blocks from the right to left
     !> starting in the bottom row block and continues to the top row block
     !> (hence _ROW in the routine name). This sweep is in reverse order of
     !> the order in which ${ri.upper()}$LATSQR generates the output blocks.

     pure subroutine la_${ri}$ungtsqr_row(m,n,mb,nb,a,lda,t,ldt,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,lwork,m,n,mb,nb
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: t(ldt,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: nblocal,mb2,m_plus_one,itmp,ib_bottom,lworkopt, &
                     num_all_row_blocks,jb_t,ib,imb,kb,kb_last,knb,mb1
           ! Local Arrays
           complex(${rk}$) :: dummy(1,1)
           ! Intrinsic Functions
           intrinsic :: cmplx,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (n < 0 .or. m < n) then
              info = -2
           else if (mb <= n) then
              info = -3
           else if (nb < 1) then
              info = -4
           else if (lda < max(1,m)) then
              info = -6
           else if (ldt < max(1,min(nb,n))) then
              info = -8
           else if (lwork < 1 .and. .not. lquery) then
              info = -10
           end if
           nblocal = min(nb,n)
           ! determine the workspace size.
           if (info == 0) then
              lworkopt = nblocal*max(nblocal, (n - nblocal))
           end if
           ! handle error in the input parameters and handle the workspace query.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNGTSQR_ROW',-info)
              return
           else if (lquery) then
              work(1) = cmplx(lworkopt,KIND=${rk}$)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              work(1) = cmplx(lworkopt,KIND=${rk}$)
              return
           end if
           ! (0) set the upper-triangular part of the matrix a to zero and
           ! its diagonal elements to one.
           call la_${ri}$laset('U',m,n,czero,cone,a,lda)
           ! kb_last is the column index of the last column block reflector
           ! in the matrices t and v.
           kb_last = ((n - 1)/nblocal)*nblocal + 1
           ! (1) bottom-up loop over row blocks of a, except the top row block.
           ! note: if mb>=m, then the loop is never executed.
           if (mb < m) then
              ! mb2 is the row blocking size for the row blocks before the
              ! first top row block in the matrix a. ib is the row index for
              ! the row blocks in the matrix a before the first top row block.
              ! ib_bottom is the row index for the last bottom row block
              ! in the matrix a. jb_t is the column index of the corresponding
              ! column block in the matrix t.
              ! initialize variables.
              ! num_all_row_blocks is the number of row blocks in the matrix a
              ! including the first row block.
              mb2 = mb - n
              m_plus_one = m + 1
              itmp = (m - mb - 1)/mb2
              ib_bottom = itmp*mb2 + mb + 1
              num_all_row_blocks = itmp + 2
              jb_t = num_all_row_blocks*n + 1
              do ib = ib_bottom,mb + 1,-mb2
                 ! determine the block size imb for the current row block
                 ! in the matrix a.
                 imb = min(m_plus_one - ib,mb2)
                 ! determine the column index jb_t for the current column block
                 ! in the matrix t.
                 jb_t = jb_t - n
                 ! apply column blocks of h in the row block from right to left.
                 ! kb is the column index of the current column block reflector
                 ! in the matrices t and v.
                 do kb = kb_last,1,-nblocal
                    ! determine the size of the current column block knb in
                    ! the matrices t and v.
                    knb = min(nblocal,n - kb + 1)
                    call la_${ri}$larfb_gett('I',imb,n - kb + 1,knb,t(1,jb_t + kb - 1),ldt,a(kb, &
                              kb),lda,a(ib,kb),lda,work,knb)
                 end do
              end do
           end if
           ! (2) top row block of a.
           ! note: if mb>=m, then we have only one row block of a of size m
           ! and we work on the entire matrix a.
           mb1 = min(mb,m)
           ! apply column blocks of h in the top row block from right to left.
           ! kb is the column index of the current block reflector in
           ! the matrices t and v.
           do kb = kb_last,1,-nblocal
              ! determine the size of the current column block knb in
              ! the matrices t and v.
              knb = min(nblocal,n - kb + 1)
              if (mb1 - kb - knb + 1 == 0) then
#:if rk == "sp"
                 ! in la_${ci}$larfb_gett parameters, when m=0, then the matrix b
#:else
                 ! in la_${cil}$larfb_gett parameters, when m=0, then the matrix b
#:endif
                 ! does not exist, hence we need to pass a dummy array
                 ! reference dummy(1,1) to b with lddummy=1.
                 call la_${ri}$larfb_gett('N',0,n - kb + 1,knb,t(1,kb),ldt,a(kb,kb),lda, &
                           dummy(1,1),1,work,knb)
              else
                 call la_${ri}$larfb_gett('N',mb1 - kb - knb + 1,n - kb + 1,knb,t(1,kb),ldt,a(kb, &
                           kb),lda,a(kb + knb,kb),lda,work,knb)
              end if
           end do
           work(1) = cmplx(lworkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$ungtsqr_row
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNM2R: overwrites the general complex m-by-n matrix C with
     !> Q * C  if SIDE = 'L' and TRANS = 'N', or
     !> Q**H* C  if SIDE = 'L' and TRANS = 'C', or
     !> C * Q  if SIDE = 'R' and TRANS = 'N', or
     !> C * Q**H if SIDE = 'R' and TRANS = 'C',
     !> where Q is a complex unitary matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF. Q is of order m if SIDE = 'L' and of order n
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$unm2r(side,trans,m,n,k,a,lda,tau,c,ldc,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: left,notran
           integer(ilp) :: i,i1,i2,i3,ic,jc,mi,ni,nq
           complex(${rk}$) :: aii,taui
           ! Intrinsic Functions
           intrinsic :: conjg,max
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           ! nq is the order of q
           if (left) then
              nq = m
           else
              nq = n
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'C')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,nq)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNM2R',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if ((left .and. .not. notran .or. .not. left .and. notran)) then
              i1 = 1
              i2 = k
              i3 = 1
           else
              i1 = k
              i2 = 1
              i3 = -1
           end if
           if (left) then
              ni = n
              jc = 1
           else
              mi = m
              ic = 1
           end if
           do i = i1,i2,i3
              if (left) then
                 ! h(i) or h(i)**h is applied to c(i:m,1:n)
                 mi = m - i + 1
                 ic = i
              else
                 ! h(i) or h(i)**h is applied to c(1:m,i:n)
                 ni = n - i + 1
                 jc = i
              end if
              ! apply h(i) or h(i)**h
              if (notran) then
                 taui = tau(i)
              else
                 taui = conjg(tau(i))
              end if
              aii = a(i,i)
              a(i,i) = cone
              call la_${ri}$larf(side,mi,ni,a(i,i),1,taui,c(ic,jc),ldc,work)
              a(i,i) = aii
           end do
           return
     end subroutine la_${ri}$unm2r
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNMQR: overwrites the general complex M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'C':      Q**H * C       C * Q**H
     !> where Q is a complex unitary matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1) H(2) . . . H(k)
     !> as returned by ${ri.upper()}$GEQRF. Q is of order M if SIDE = 'L' and of order N
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$unmqr(side,trans,m,n,k,a,lda,tau,c,ldc,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 64
           integer(ilp),parameter :: ldt = nbmax + 1
           integer(ilp),parameter :: tsize = ldt*nbmax

           ! Local Scalars
           logical(lk) :: left,lquery,notran
           integer(ilp) :: i,i1,i2,i3,ib,ic,iinfo,iwt,jc,ldwork,lwkopt,mi,nb,nbmin, &
                     ni,nq,nw
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           lquery = (lwork == -1)
           ! nq is the order of q and nw is the minimum dimension of work
           if (left) then
              nq = m
              nw = max(1,n)
           else
              nq = n
              nw = max(1,m)
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'C')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,nq)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           else if (lwork < nw .and. .not. lquery) then
              info = -12
           end if
           if (info == 0) then
              ! compute the workspace requirements
              nb = min(nbmax,la_ilaenv(1,'${ri.upper()}$UNMQR',side//trans,m,n,k,-1))
              lwkopt = nw*nb + tsize
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNMQR',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. k == 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           ldwork = nw
           if (nb > 1 .and. nb < k) then
              if (lwork < lwkopt) then
                 nb = (lwork - tsize)/ldwork
                 nbmin = max(2,la_ilaenv(2,'${ri.upper()}$UNMQR',side//trans,m,n,k,-1))
              end if
           end if
           if (nb < nbmin .or. nb >= k) then
              ! use unblocked code
              call la_${ri}$unm2r(side,trans,m,n,k,a,lda,tau,c,ldc,work,iinfo)
           else
              ! use blocked code
              iwt = 1 + nw*nb
              if ((left .and. .not. notran) .or. (.not. left .and. notran)) then
                 i1 = 1
                 i2 = k
                 i3 = nb
              else
                 i1 = ((k - 1)/nb)*nb + 1
                 i2 = 1
                 i3 = -nb
              end if
              if (left) then
                 ni = n
                 jc = 1
              else
                 mi = m
                 ic = 1
              end if
              do i = i1,i2,i3
                 ib = min(nb,k - i + 1)
                 ! form the triangular factor of the block reflector
                 ! h = h(i) h(i+1) . . . h(i+ib-1)
                 call la_${ri}$larft('FORWARD','COLUMNWISE',nq - i + 1,ib,a(i,i),lda,tau(i), &
                            work(iwt),ldt)
                 if (left) then
                    ! h or h**h is applied to c(i:m,1:n)
                    mi = m - i + 1
                    ic = i
                 else
                    ! h or h**h is applied to c(1:m,i:n)
                    ni = n - i + 1
                    jc = i
                 end if
                 ! apply h or h**h
                 call la_${ri}$larfb(side,trans,'FORWARD','COLUMNWISE',mi,ni,ib,a(i,i), &
                           lda,work(iwt),ldt,c(ic,jc),ldc,work,ldwork)
              end do
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$unmqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNMR2: overwrites the general complex m-by-n matrix C with
     !> Q * C  if SIDE = 'L' and TRANS = 'N', or
     !> Q**H* C  if SIDE = 'L' and TRANS = 'C', or
     !> C * Q  if SIDE = 'R' and TRANS = 'N', or
     !> C * Q**H if SIDE = 'R' and TRANS = 'C',
     !> where Q is a complex unitary matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1)**H H(2)**H . . . H(k)**H
     !> as returned by ${ri.upper()}$GERQF. Q is of order m if SIDE = 'L' and of order n
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$unmr2(side,trans,m,n,k,a,lda,tau,c,ldc,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: left,notran
           integer(ilp) :: i,i1,i2,i3,mi,ni,nq
           complex(${rk}$) :: aii,taui
           ! Intrinsic Functions
           intrinsic :: conjg,max
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           ! nq is the order of q
           if (left) then
              nq = m
           else
              nq = n
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'C')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,k)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNMR2',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if ((left .and. .not. notran .or. .not. left .and. notran)) then
              i1 = 1
              i2 = k
              i3 = 1
           else
              i1 = k
              i2 = 1
              i3 = -1
           end if
           if (left) then
              ni = n
           else
              mi = m
           end if
           do i = i1,i2,i3
              if (left) then
                 ! h(i) or h(i)**h is applied to c(1:m-k+i,1:n)
                 mi = m - k + i
              else
                 ! h(i) or h(i)**h is applied to c(1:m,1:n-k+i)
                 ni = n - k + i
              end if
              ! apply h(i) or h(i)**h
              if (notran) then
                 taui = conjg(tau(i))
              else
                 taui = tau(i)
              end if
              call la_${ri}$lacgv(nq - k + i - 1,a(i,1),lda)
              aii = a(i,nq - k + i)
              a(i,nq - k + i) = cone
              call la_${ri}$larf(side,mi,ni,a(i,1),lda,taui,c,ldc,work)
              a(i,nq - k + i) = aii
              call la_${ri}$lacgv(nq - k + i - 1,a(i,1),lda)
           end do
           return
     end subroutine la_${ri}$unmr2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNMRQ: overwrites the general complex M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'C':      Q**H * C       C * Q**H
     !> where Q is a complex unitary matrix defined as the product of k
     !> elementary reflectors
     !> Q = H(1)**H H(2)**H . . . H(k)**H
     !> as returned by ${ri.upper()}$GERQF. Q is of order M if SIDE = 'L' and of order N
     !> if SIDE = 'R'.

     pure subroutine la_${ri}$unmrq(side,trans,m,n,k,a,lda,tau,c,ldc,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,lda,ldc,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),c(ldc,*)
           complex(${rk}$),intent(in) :: tau(*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: nbmax = 64
           integer(ilp),parameter :: ldt = nbmax + 1
           integer(ilp),parameter :: tsize = ldt*nbmax

           ! Local Scalars
           logical(lk) :: left,lquery,notran
           character :: transt
           integer(ilp) :: i,i1,i2,i3,ib,iinfo,iwt,ldwork,lwkopt,mi,nb,nbmin,ni,nq, &
                     nw
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           left = la_lsame(side,'L')
           notran = la_lsame(trans,'N')
           lquery = (lwork == -1)
           ! nq is the order of q and nw is the minimum dimension of work
           if (left) then
              nq = m
              nw = max(1,n)
           else
              nq = n
              nw = max(1,m)
           end if
           if (.not. left .and. .not. la_lsame(side,'R')) then
              info = -1
           else if (.not. notran .and. .not. la_lsame(trans,'C')) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > nq) then
              info = -5
           else if (lda < max(1,k)) then
              info = -7
           else if (ldc < max(1,m)) then
              info = -10
           else if (lwork < nw .and. .not. lquery) then
              info = -12
           end if
           if (info == 0) then
              ! compute the workspace requirements
              if (m == 0 .or. n == 0) then
                 lwkopt = 1
              else
                 nb = min(nbmax,la_ilaenv(1,'${ri.upper()}$UNMRQ',side//trans,m,n,k,-1))

                 lwkopt = nw*nb + tsize
              end if
              work(1) = lwkopt
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNMRQ',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) then
              return
           end if
           nbmin = 2
           ldwork = nw
           if (nb > 1 .and. nb < k) then
              if (lwork < lwkopt) then
                 nb = (lwork - tsize)/ldwork
                 nbmin = max(2,la_ilaenv(2,'${ri.upper()}$UNMRQ',side//trans,m,n,k,-1))
              end if
           end if
           if (nb < nbmin .or. nb >= k) then
              ! use unblocked code
              call la_${ri}$unmr2(side,trans,m,n,k,a,lda,tau,c,ldc,work,iinfo)
           else
              ! use blocked code
              iwt = 1 + nw*nb
              if ((left .and. .not. notran) .or. (.not. left .and. notran)) then
                 i1 = 1
                 i2 = k
                 i3 = nb
              else
                 i1 = ((k - 1)/nb)*nb + 1
                 i2 = 1
                 i3 = -nb
              end if
              if (left) then
                 ni = n
              else
                 mi = m
              end if
              if (notran) then
                 transt = 'C'
              else
                 transt = 'N'
              end if
              do i = i1,i2,i3
                 ib = min(nb,k - i + 1)
                 ! form the triangular factor of the block reflector
                 ! h = h(i+ib-1) . . . h(i+1) h(i)
                 call la_${ri}$larft('BACKWARD','ROWWISE',nq - k + i + ib - 1,ib,a(i,1),lda,tau( &
                           i),work(iwt),ldt)
                 if (left) then
                    ! h or h**h is applied to c(1:m-k+i+ib-1,1:n)
                    mi = m - k + i + ib - 1
                 else
                    ! h or h**h is applied to c(1:m,1:n-k+i+ib-1)
                    ni = n - k + i + ib - 1
                 end if
                 ! apply h or h**h
                 call la_${ri}$larfb(side,transt,'BACKWARD','ROWWISE',mi,ni,ib,a(i,1), &
                           lda,work(iwt),ldt,c,ldc,work,ldwork)
              end do
           end if
           work(1) = lwkopt
           return
     end subroutine la_${ri}$unmrq
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEMQRT: overwrites the general complex M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q C            C Q
     !> TRANS = 'C':    Q**H C            C Q**H
     !> where Q is a complex orthogonal matrix defined as the product of K
     !> elementary reflectors:
     !> Q = H(1) H(2) . . . H(K) = I - V T V**H
     !> generated using the compact WY representation as returned by ${ri.upper()}$GEQRT.
     !> Q is of order M if SIDE = 'L' and of order N  if SIDE = 'R'.

     pure subroutine la_${ri}$gemqrt(side,trans,m,n,k,nb,v,ldv,t,ldt,c,ldc,work,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,ldv,ldc,m,n,nb,ldt
           ! Array Arguments
           complex(${rk}$),intent(in) :: v(ldv,*),t(ldt,*)
           complex(${rk}$),intent(inout) :: c(ldc,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran
           integer(ilp) :: i,ib,ldwork,kf,q
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! Test The Input Arguments
           info = 0
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           tran = la_lsame(trans,'C')
           notran = la_lsame(trans,'N')
           if (left) then
              ldwork = max(1,n)
              q = m
           else if (right) then
              ldwork = max(1,m)
              q = n
           end if
           if (.not. left .and. .not. right) then
              info = -1
           else if (.not. tran .and. .not. notran) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0 .or. k > q) then
              info = -5
           else if (nb < 1 .or. (nb > k .and. k > 0)) then
              info = -6
           else if (ldv < max(1,q)) then
              info = -8
           else if (ldt < nb) then
              info = -10
           else if (ldc < max(1,m)) then
              info = -12
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEMQRT',-info)
              return
           end if
           ! Quick Return If Possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if (left .and. tran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('L','C','F','C',m - i + 1,n,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(i,1),ldc,work,ldwork)
              end do
           else if (right .and. notran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('R','N','F','C',m,n - i + 1,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(1,i),ldc,work,ldwork)
              end do
           else if (left .and. notran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('L','N','F','C',m - i + 1,n,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(i,1),ldc,work,ldwork)
              end do
           else if (right .and. tran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 call la_${ri}$larfb('R','C','F','C',m,n - i + 1,ib,v(i,i),ldv,t(1,i), &
                           ldt,c(1,i),ldc,work,ldwork)
              end do
           end if
           return
     end subroutine la_${ri}$gemqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQR2: computes a QR factorization of a complex m-by-n matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a m-by-m orthogonal matrix;
     !> R is an upper-triangular n-by-n matrix;
     !> 0 is a (m-n)-by-n zero matrix, if m > n.

     pure subroutine la_${ri}$geqr2(m,n,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           complex(${rk}$) :: alpha
           ! Intrinsic Functions
           intrinsic :: conjg,max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQR2',-info)
              return
           end if
           k = min(m,n)
           do i = 1,k
              ! generate elementary reflector h(i) to annihilate a(i+1:m,i)
              call la_${ri}$larfg(m - i + 1,a(i,i),a(min(i + 1,m),i),1,tau(i))
              if (i < n) then
                 ! apply h(i)**h to a(i:m,i+1:n) from the left
                 alpha = a(i,i)
                 a(i,i) = cone
                 call la_${ri}$larf('LEFT',m - i + 1,n - i,a(i,i),1,conjg(tau(i)),a(i,i + 1 &
                           ),lda,work)
                 a(i,i) = alpha
              end if
           end do
           return
     end subroutine la_${ri}$geqr2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQR2P: computes a QR factorization of a complex m-by-n matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a m-by-m orthogonal matrix;
     !> R is an upper-triangular n-by-n matrix with nonnegative diagonal
     !> entries;
     !> 0 is a (m-n)-by-n zero matrix, if m > n.

     subroutine la_${ri}$geqr2p(m,n,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           complex(${rk}$) :: alpha
           ! Intrinsic Functions
           intrinsic :: conjg,max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQR2P',-info)
              return
           end if
           k = min(m,n)
           do i = 1,k
              ! generate elementary reflector h(i) to annihilate a(i+1:m,i)
              call la_${ri}$larfgp(m - i + 1,a(i,i),a(min(i + 1,m),i),1,tau(i))
              if (i < n) then
                 ! apply h(i)**h to a(i:m,i+1:n) from the left
                 alpha = a(i,i)
                 a(i,i) = cone
                 call la_${ri}$larf('LEFT',m - i + 1,n - i,a(i,i),1,conjg(tau(i)),a(i,i + 1 &
                           ),lda,work)
                 a(i,i) = alpha
              end if
           end do
           return
     end subroutine la_${ri}$geqr2p
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQRF: computes a QR factorization of a complex M-by-N matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix;
     !> R is an upper-triangular N-by-N matrix;
     !> 0 is a (M-N)-by-N zero matrix, if M > N.

     pure subroutine la_${ri}$geqrf(m,n,a,lda,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,k,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           k = min(m,n)
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',m,n,-1,-1)
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           else if (.not. lquery) then
              if (lwork <= 0 .or. (m > 0 .and. lwork < max(1,n))) info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRF',-info)
              return
           else if (lquery) then
              if (k == 0) then
                 lwkopt = 1
              else
                 lwkopt = n*nb
              end if
              work(1) = lwkopt
              return
           end if
           ! quick return if possible
           if (k == 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           nx = 0
           iws = n
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code initially
              do i = 1,k - nx,nb
                 ib = min(k - i + 1,nb)
                 ! compute the qr factorization of the current block
                 ! a(i:m,i:i+ib-1)
                 call la_${ri}$geqr2(m - i + 1,ib,a(i,i),lda,tau(i),work,iinfo)
                 if (i + ib <= n) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i) h(i+1) . . . h(i+ib-1)
                    call la_${ri}$larft('FORWARD','COLUMNWISE',m - i + 1,ib,a(i,i),lda,tau(i &
                              ),work,ldwork)
                    ! apply h**h to a(i:m,i+ib:n) from the left
                    call la_${ri}$larfb('LEFT','CONJUGATE TRANSPOSE','FORWARD','COLUMNWISE',m - &
                    i + 1,n - i - ib + 1,ib,a(i,i),lda,work,ldwork,a(i,i + ib),lda,work(ib + 1) &
                              ,ldwork)
                 end if
              end do
           else
              i = 1
           end if
           ! use unblocked code to factor the last or only block.
           if (i <= k) call la_${ri}$geqr2(m - i + 1,n - i + 1,a(i,i),lda,tau(i),work,iinfo)

           work(1) = iws
           return
     end subroutine la_${ri}$geqrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQR2P computes a QR factorization of a complex M-by-N matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix;
     !> R is an upper-triangular N-by-N matrix with nonnegative diagonal
     !> entries;
     !> 0 is a (M-N)-by-N zero matrix, if M > N.

     subroutine la_${ri}$geqrfp(m,n,a,lda,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,k,ldwork,lwkopt,nb,nbmin,nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           nb = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',m,n,-1,-1)
           lwkopt = n*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           else if (lwork < max(1,n) .and. .not. lquery) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRFP',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           k = min(m,n)
           if (k == 0) then
              work(1) = 1
              return
           end if
           nbmin = 2
           nx = 0
           iws = n
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = n
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GEQRF',' ',m,n,-1,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code initially
              do i = 1,k - nx,nb
                 ib = min(k - i + 1,nb)
                 ! compute the qr factorization of the current block
                 ! a(i:m,i:i+ib-1)
                 call la_${ri}$geqr2p(m - i + 1,ib,a(i,i),lda,tau(i),work,iinfo)
                 if (i + ib <= n) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i) h(i+1) . . . h(i+ib-1)
                    call la_${ri}$larft('FORWARD','COLUMNWISE',m - i + 1,ib,a(i,i),lda,tau(i &
                              ),work,ldwork)
                    ! apply h**h to a(i:m,i+ib:n) from the left
                    call la_${ri}$larfb('LEFT','CONJUGATE TRANSPOSE','FORWARD','COLUMNWISE',m - &
                    i + 1,n - i - ib + 1,ib,a(i,i),lda,work,ldwork,a(i,i + ib),lda,work(ib + 1) &
                              ,ldwork)
                 end if
              end do
           else
              i = 1
           end if
           ! use unblocked code to factor the last or only block.
           if (i <= k) call la_${ri}$geqr2p(m - i + 1,n - i + 1,a(i,i),lda,tau(i),work,iinfo)

           work(1) = iws
           return
     end subroutine la_${ri}$geqrfp
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQRT2: computes a QR factorization of a complex M-by-N matrix A,
     !> using the compact WY representation of Q.

     pure subroutine la_${ri}$geqrt2(m,n,a,lda,t,ldt,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           complex(${rk}$) :: aii,alpha
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (n < 0) then
              info = -2
           else if (m < n) then
              info = -1
           else if (lda < max(1,m)) then
              info = -4
           else if (ldt < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRT2',-info)
              return
           end if
           k = min(m,n)
           do i = 1,k
              ! generate elem. refl. h(i) to annihilate a(i+1:m,i), tau(i) -> t(i,1)
              call la_${ri}$larfg(m - i + 1,a(i,i),a(min(i + 1,m),i),1,t(i,1))
              if (i < n) then
                 ! apply h(i) to a(i:m,i+1:n) from the left
                 aii = a(i,i)
                 a(i,i) = cone
#:if rk == "sp"
                 ! w(1:n-i) := a(i:m,i+1:n)**h * a(i:m,i) [w = t(:,n)]
#:else
                 ! w(1:n-i) := a(i:m,i+1:n)^h * a(i:m,i) [w = t(:,n)]
#:endif
                 call la_${ri}$gemv('C',m - i + 1,n - i,cone,a(i,i + 1),lda,a(i,i),1,czero,t( &
                            1,n),1)
#:if rk == "sp"
                 ! a(i:m,i+1:n) = a(i:m,i+1:n) + alpha*a(i:m,i)*w(1:n-1)**h
#:else
                 ! a(i:m,i+1:n) = a(i:m,i+1:n) + alpha*a(i:m,i)*w(1:n-1)^h
#:endif
                 alpha = -conjg(t(i,1))
                 call la_${ri}$gerc(m - i + 1,n - i,alpha,a(i,i),1,t(1,n),1,a(i,i + 1), &
                           lda)
                 a(i,i) = aii
              end if
           end do
           do i = 2,n
              aii = a(i,i)
              a(i,i) = cone
              ! t(1:i-1,i) := alpha * a(i:m,1:i-1)**h * a(i:m,i)
              alpha = -t(i,1)
              call la_${ri}$gemv('C',m - i + 1,i - 1,alpha,a(i,1),lda,a(i,i),1,czero,t(1, &
                         i),1)
              a(i,i) = aii
              ! t(1:i-1,i) := t(1:i-1,1:i-1) * t(1:i-1,i)
              call la_${ri}$trmv('U','N','N',i - 1,t,ldt,t(1,i),1)
                 ! t(i,i) = tau(i)
                 t(i,i) = t(i,1)
                 t(i,1) = czero
           end do
     end subroutine la_${ri}$geqrt2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
#:if rk == "sp"
     !> ${ri.upper()}$GEQRT3: recursively computes a QR factorization of a complex M-by-N matrix A,
     !> using the compact WY representation of Q.
#:else
     !> ${ri.upper()}$GEQRT3: recursively computes a QR factorization of a complex M-by-N
     !> matrix A, using the compact WY representation of Q.
#:endif
     !> Based on the algorithm of Elmroth and Gustavson,
     !> IBM J. Res. Develop. Vol 44 No. 4 July 2000.

     pure recursive subroutine la_${ri}$geqrt3(m,n,a,lda,t,ldt,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,ldt
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,i1,j,j1,n1,n2,iinfo
           ! Executable Statements
           info = 0
           if (n < 0) then
              info = -2
           else if (m < n) then
              info = -1
           else if (lda < max(1,m)) then
              info = -4
           else if (ldt < max(1,n)) then
              info = -6
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRT3',-info)
              return
           end if
           if (n == 1) then
              ! compute householder transform when n=1
              call la_${ri}$larfg(m,a(1,1),a(min(2,m),1),1,t(1,1))
           else
              ! otherwise, split a into blocks...
              n1 = n/2
              n2 = n - n1
              j1 = min(n1 + 1,n)
              i1 = min(n + 1,m)
#:if rk == "sp"
              ! compute a(1:m,1:n1) <- (y1,r1,t1), where q1 = i - y1 t1 y1**h
#:else
              ! compute a(1:m,1:n1) <- (y1,r1,t1), where q1 = i - y1 t1 y1^h
#:endif
              call la_${ri}$geqrt3(m,n1,a,lda,t,ldt,iinfo)
#:if rk == "sp"
              ! compute a(1:m,j1:n) = q1**h a(1:m,j1:n) [workspace: t(1:n1,j1:n)]
#:else
              ! compute a(1:m,j1:n) = q1^h a(1:m,j1:n) [workspace: t(1:n1,j1:n)]
#:endif
              do j = 1,n2
                 do i = 1,n1
                    t(i,j + n1) = a(i,j + n1)
                 end do
              end do
              call la_${ri}$trmm('L','L','C','U',n1,n2,cone,a,lda,t(1,j1),ldt)

              call la_${ri}$gemm('C','N',n1,n2,m - n1,cone,a(j1,1),lda,a(j1,j1),lda, &
                        cone,t(1,j1),ldt)
              call la_${ri}$trmm('L','U','C','N',n1,n2,cone,t,ldt,t(1,j1),ldt)

              call la_${ri}$gemm('N','N',m - n1,n2,n1,-cone,a(j1,1),lda,t(1,j1),ldt, &
                        cone,a(j1,j1),lda)
              call la_${ri}$trmm('L','L','N','U',n1,n2,cone,a,lda,t(1,j1),ldt)

              do j = 1,n2
                 do i = 1,n1
                    a(i,j + n1) = a(i,j + n1) - t(i,j + n1)
                 end do
              end do
#:if rk == "sp"
              ! compute a(j1:m,j1:n) <- (y2,r2,t2) where q2 = i - y2 t2 y2**h
#:else
              ! compute a(j1:m,j1:n) <- (y2,r2,t2) where q2 = i - y2 t2 y2^h
#:endif
              call la_${ri}$geqrt3(m - n1,n2,a(j1,j1),lda,t(j1,j1),ldt,iinfo)
#:if rk == "sp"
              ! compute t3 = t(1:n1,j1:n) = -t1 y1**h y2 t2
#:else
              ! compute t3 = t(1:n1,j1:n) = -t1 y1^h y2 t2
#:endif
              do i = 1,n1
                 do j = 1,n2
                    t(i,j + n1) = conjg(a(j + n1,i))
                 end do
              end do
              call la_${ri}$trmm('R','L','N','U',n1,n2,cone,a(j1,j1),lda,t(1,j1), &
                        ldt)
              call la_${ri}$gemm('C','N',n1,n2,m - n,cone,a(i1,1),lda,a(i1,j1),lda, &
                        cone,t(1,j1),ldt)
              call la_${ri}$trmm('L','U','N','N',n1,n2,-cone,t,ldt,t(1,j1),ldt)

              call la_${ri}$trmm('R','U','N','N',n1,n2,cone,t(j1,j1),ldt,t(1,j1), &
                        ldt)
              ! y = (y1,y2); r = [ r1  a(1:n1,j1:n) ];  t = [t1 t3]
                               ! [  0        r2     ]       [ 0 t2]
           end if
           return
     end subroutine la_${ri}$geqrt3
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GERQ2: computes an RQ factorization of a complex m by n matrix A:
     !> A = R * Q.

     pure subroutine la_${ri}$gerq2(m,n,a,lda,tau,work,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,k
           complex(${rk}$) :: alpha
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GERQ2',-info)
              return
           end if
           k = min(m,n)
           do i = k,1,-1
              ! generate elementary reflector h(i) to annihilate
              ! a(m-k+i,1:n-k+i-1)
              call la_${ri}$lacgv(n - k + i,a(m - k + i,1),lda)
              alpha = a(m - k + i,n - k + i)
              call la_${ri}$larfg(n - k + i,alpha,a(m - k + i,1),lda,tau(i))
              ! apply h(i) to a(1:m-k+i-1,1:n-k+i) from the right
              a(m - k + i,n - k + i) = cone
              call la_${ri}$larf('RIGHT',m - k + i - 1,n - k + i,a(m - k + i,1),lda,tau(i),a,lda, &
                        work)
              a(m - k + i,n - k + i) = alpha
              call la_${ri}$lacgv(n - k + i - 1,a(m - k + i,1),lda)
           end do
           return
     end subroutine la_${ri}$gerq2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GERQF: computes an RQ factorization of a complex M-by-N matrix A:
     !> A = R * Q.

     pure subroutine la_${ri}$gerqf(m,n,a,lda,tau,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ib,iinfo,iws,k,ki,kk,ldwork,lwkopt,mu,nb,nbmin,nu, &
                     nx
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info == 0) then
              k = min(m,n)
              if (k == 0) then
                 lwkopt = 1
              else
                 nb = la_ilaenv(1,'${ri.upper()}$GERQF',' ',m,n,-1,-1)
                 lwkopt = m*nb
              end if
              work(1) = lwkopt
              if (.not. lquery) then
                 if (lwork <= 0 .or. (n > 0 .and. lwork < max(1,m))) info = -7
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GERQF',-info)
              return
           else if (lquery) then
              return
           end if
           ! quick return if possible
           if (k == 0) then
              return
           end if
           nbmin = 2
           nx = 1
           iws = m
           if (nb > 1 .and. nb < k) then
              ! determine when to cross over from blocked to unblocked code.
              nx = max(0,la_ilaenv(3,'${ri.upper()}$GERQF',' ',m,n,-1,-1))
              if (nx < k) then
                 ! determine if workspace is large enough for blocked code.
                 ldwork = m
                 iws = ldwork*nb
                 if (lwork < iws) then
                    ! not enough workspace to use optimal nb:  reduce nb and
                    ! determine the minimum value of nb.
                    nb = lwork/ldwork
                    nbmin = max(2,la_ilaenv(2,'${ri.upper()}$GERQF',' ',m,n,-1,-1))
                 end if
              end if
           end if
           if (nb >= nbmin .and. nb < k .and. nx < k) then
              ! use blocked code initially.
              ! the last kk rows are handled by the block method.
              ki = ((k - nx - 1)/nb)*nb
              kk = min(k,ki + nb)
              do i = k - kk + ki + 1,k - kk + 1,-nb
                 ib = min(k - i + 1,nb)
                 ! compute the rq factorization of the current block
                 ! a(m-k+i:m-k+i+ib-1,1:n-k+i+ib-1)
                 call la_${ri}$gerq2(ib,n - k + i + ib - 1,a(m - k + i,1),lda,tau(i),work,iinfo)

                 if (m - k + i > 1) then
                    ! form the triangular factor of the block reflector
                    ! h = h(i+ib-1) . . . h(i+1) h(i)
                    call la_${ri}$larft('BACKWARD','ROWWISE',n - k + i + ib - 1,ib,a(m - k + i,1),lda, &
                              tau(i),work,ldwork)
                    ! apply h to a(1:m-k+i-1,1:n-k+i+ib-1) from the right
                    call la_${ri}$larfb('RIGHT','NO TRANSPOSE','BACKWARD','ROWWISE',m - k + i - 1,n - &
                    k + i + ib - 1,ib,a(m - k + i,1),lda,work,ldwork,a,lda,work(ib + 1),ldwork)

                 end if
              end do
              mu = m - k + i + nb - 1
              nu = n - k + i + nb - 1
           else
              mu = m
              nu = n
           end if
           ! use unblocked code to factor the last or only block
           if (mu > 0 .and. nu > 0) call la_${ri}$gerq2(mu,nu,a,lda,tau,work,iinfo)
           work(1) = iws
           return
     end subroutine la_${ri}$gerqf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GGQRF: computes a generalized QR factorization of an N-by-M matrix A
     !> and an N-by-P matrix B:
     !> A = Q*R,        B = Q*T*Z,
     !> where Q is an N-by-N unitary matrix, Z is a P-by-P unitary matrix,
     !> and R and T assume one of the forms:
     !> if N >= M,  R = ( R11 ) M  ,   or if N < M,  R = ( R11  R12 ) N,
     !> (  0  ) N-M                         N   M-N
     !> M
     !> where R11 is upper triangular, and
     !> if N <= P,  T = ( 0  T12 ) N,   or if N > P,  T = ( T11 ) N-P,
     !> P-N  N                           ( T21 ) P
     !> P
     !> where T12 or T21 is upper triangular.
     !> In particular, if B is square and nonsingular, the GQR factorization
     !> of A and B implicitly gives the QR factorization of inv(B)*A:
     !> inv(B)*A = Z**H * (inv(T)*R)
#:if rk == "sp"
     !> where inv(B) denotes the inverse of the matrix B, and Z' denotes the
#:else
     !> where inv(B) denotes the inverse of the matrix B, and Z**H denotes the
#:endif
     !> conjugate transpose of matrix Z.

     pure subroutine la_${ri}$ggqrf(n,m,p,a,lda,taua,b,ldb,taub,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,lwork,m,n,p
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: taua(*),taub(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: lopt,lwkopt,nb,nb1,nb2,nb3
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           nb1 = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',n,m,-1,-1)
           nb2 = la_ilaenv(1,'${ri.upper()}$GERQF',' ',n,p,-1,-1)
           nb3 = la_ilaenv(1,'${ri.upper()}$UNMQR',' ',n,m,p,-1)
           nb = max(nb1,nb2,nb3)
           lwkopt = max(n,m,p)*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (n < 0) then
              info = -1
           else if (m < 0) then
              info = -2
           else if (p < 0) then
              info = -3
           else if (lda < max(1,n)) then
              info = -5
           else if (ldb < max(1,n)) then
              info = -8
           else if (lwork < max(1,n,m,p) .and. .not. lquery) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GGQRF',-info)
              return
           else if (lquery) then
              return
           end if
           ! qr factorization of n-by-m matrix a: a = q*r
           call la_${ri}$geqrf(n,m,a,lda,taua,work,lwork,info)
           lopt = real(work(1),KIND=${rk}$)
           ! update b := q**h*b.
           call la_${ri}$unmqr('LEFT','CONJUGATE TRANSPOSE',n,p,min(n,m),a,lda,taua,b, &
                     ldb,work,lwork,info)
           lopt = max(lopt,int(work(1),KIND=ilp))
           ! rq factorization of n-by-p matrix b: b = t*z.
           call la_${ri}$gerqf(n,p,b,ldb,taub,work,lwork,info)
           work(1) = max(lopt,int(work(1),KIND=ilp))
           return
     end subroutine la_${ri}$ggqrf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GGRQF: computes a generalized RQ factorization of an M-by-N matrix A
     !> and a P-by-N matrix B:
     !> A = R*Q,        B = Z*T*Q,
     !> where Q is an N-by-N unitary matrix, Z is a P-by-P unitary
     !> matrix, and R and T assume one of the forms:
     !> if M <= N,  R = ( 0  R12 ) M,   or if M > N,  R = ( R11 ) M-N,
     !> N-M  M                           ( R21 ) N
     !> N
     !> where R12 or R21 is upper triangular, and
     !> if P >= N,  T = ( T11 ) N  ,   or if P < N,  T = ( T11  T12 ) P,
     !> (  0  ) P-N                         P   N-P
     !> N
     !> where T11 is upper triangular.
     !> In particular, if B is square and nonsingular, the GRQ factorization
     !> of A and B implicitly gives the RQ factorization of A*inv(B):
     !> A*inv(B) = (R*inv(T))*Z**H
     !> where inv(B) denotes the inverse of the matrix B, and Z**H denotes the
     !> conjugate transpose of the matrix Z.

     pure subroutine la_${ri}$ggrqf(m,p,n,a,lda,taua,b,ldb,taub,work,lwork,info)

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,lwork,m,n,p
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: taua(*),taub(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: lopt,lwkopt,nb,nb1,nb2,nb3
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           nb1 = la_ilaenv(1,'${ri.upper()}$GERQF',' ',m,n,-1,-1)
           nb2 = la_ilaenv(1,'${ri.upper()}$GEQRF',' ',p,n,-1,-1)
           nb3 = la_ilaenv(1,'${ri.upper()}$UNMRQ',' ',m,n,p,-1)
           nb = max(nb1,nb2,nb3)
           lwkopt = max(n,m,p)*nb
           work(1) = lwkopt
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (p < 0) then
              info = -2
           else if (n < 0) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldb < max(1,p)) then
              info = -8
           else if (lwork < max(1,m,p,n) .and. .not. lquery) then
              info = -11
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GGRQF',-info)
              return
           else if (lquery) then
              return
           end if
           ! rq factorization of m-by-n matrix a: a = r*q
           call la_${ri}$gerqf(m,n,a,lda,taua,work,lwork,info)
           lopt = real(work(1),KIND=${rk}$)
           ! update b := b*q**h
           call la_${ri}$unmrq('RIGHT','CONJUGATE TRANSPOSE',p,n,min(m,n),a(max(1,m - n + 1 &
                     ),1),lda,taua,b,ldb,work,lwork,info)
           lopt = max(lopt,int(work(1),KIND=ilp))
           ! qr factorization of p-by-n matrix b: b = z*t
           call la_${ri}$geqrf(p,n,b,ldb,taub,work,lwork,info)
           work(1) = max(lopt,int(work(1),KIND=ilp))
           return
     end subroutine la_${ri}$ggrqf
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAQP2: computes a QR factorization with column pivoting of
     !> the block A(OFFSET+1:M,1:N).
     !> The block A(1:OFFSET,1:N) is accordingly pivoted, but not factorized.

     pure subroutine la_${ri}$laqp2(m,n,offset,a,lda,jpvt,tau,vn1,vn2,work)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(in) :: lda,m,n,offset
           ! Array Arguments
           integer(ilp),intent(inout) :: jpvt(*)
           real(${rk}$),intent(inout) :: vn1(*),vn2(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,itemp,j,mn,offpi,pvt
           real(${rk}$) :: temp,temp2,tol3z
           complex(${rk}$) :: aii
           ! Intrinsic Functions
           intrinsic :: abs,conjg,max,min,sqrt
           ! Executable Statements
           mn = min(m - offset,n)
           tol3z = sqrt(la_${ci}$lamch('EPSILON'))
           ! compute factorization.
           loop_20: do i = 1,mn
              offpi = offset + i
              ! determine ith pivot column and swap if necessary.
              pvt = (i - 1) + la_i${ci}$amax(n - i + 1,vn1(i),1)
              if (pvt /= i) then
                 call la_${ri}$swap(m,a(1,pvt),1,a(1,i),1)
                 itemp = jpvt(pvt)
                 jpvt(pvt) = jpvt(i)
                 jpvt(i) = itemp
                 vn1(pvt) = vn1(i)
                 vn2(pvt) = vn2(i)
              end if
              ! generate elementary reflector h(i).
              if (offpi < m) then
                 call la_${ri}$larfg(m - offpi + 1,a(offpi,i),a(offpi + 1,i),1,tau(i))

              else
                 call la_${ri}$larfg(1,a(m,i),a(m,i),1,tau(i))
              end if
              if (i < n) then
                 ! apply h(i)**h to a(offset+i:m,i+1:n) from the left.
                 aii = a(offpi,i)
                 a(offpi,i) = cone
                 call la_${ri}$larf('LEFT',m - offpi + 1,n - i,a(offpi,i),1,conjg(tau(i)),a( &
                            offpi,i + 1),lda,work(1))
                 a(offpi,i) = aii
              end if
              ! update partial column norms.
              do j = i + 1,n
                 if (vn1(j) /= zero) then
                    ! note: the following 4 lines follow from the analysis in
                    ! lapack working note 176.
                    temp = one - (abs(a(offpi,j))/vn1(j))**2
                    temp = max(temp,zero)
                    temp2 = temp*(vn1(j)/vn2(j))**2
                    if (temp2 <= tol3z) then
                       if (offpi < m) then
                          vn1(j) = la_${ci}$${ri}$nrm2(m - offpi,a(offpi + 1,j),1)
                          vn2(j) = vn1(j)
                       else
                          vn1(j) = zero
                          vn2(j) = zero
                       end if
                    else
                       vn1(j) = vn1(j)*sqrt(temp)
                    end if
                 end if
              end do
           end do loop_20
           return
     end subroutine la_${ri}$laqp2
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAQPS: computes a step of QR factorization with column pivoting
     !> of a complex M-by-N matrix A by using Blas-3.  It tries to factorize
     !> NB columns from A starting from the row OFFSET+1, and updates all
     !> of the matrix with Blas-3 xGEMM.
     !> In some cases, due to catastrophic cancellations, it cannot
     !> factorize NB columns.  Hence, the actual number of factorized
     !> columns is returned in KB.
     !> Block A(1:OFFSET,1:N) is accordingly pivoted, but not factorized.

     pure subroutine la_${ri}$laqps(m,n,offset,nb,kb,a,lda,jpvt,tau,vn1,vn2,auxv,f, &
               ldf)
        use la_constants_${rk}$
        ! -- lapack auxiliary routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: kb
           integer(ilp),intent(in) :: lda,ldf,m,n,nb,offset
           ! Array Arguments
           integer(ilp),intent(inout) :: jpvt(*)
           real(${rk}$),intent(inout) :: vn1(*),vn2(*)
           complex(${rk}$),intent(inout) :: a(lda,*),auxv(*),f(ldf,*)
           complex(${rk}$),intent(out) :: tau(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: itemp,j,k,lastrk,lsticc,pvt,rk
           real(${rk}$) :: temp,temp2,tol3z
           complex(${rk}$) :: akk
           ! Intrinsic Functions
#:if rk == "sp"
           intrinsic :: abs,conjg,max,min,nint,real,sqrt
#:else
           intrinsic :: abs,real,conjg,max,min,nint,sqrt
#:endif
           ! Executable Statements
           lastrk = min(m,n + offset)
           lsticc = 0
           k = 0
           tol3z = sqrt(la_${ci}$lamch('EPSILON'))
           ! beginning of while loop.
           10 continue
           if ((k < nb) .and. (lsticc == 0)) then
              k = k + 1
              rk = offset + k
              ! determine ith pivot column and swap if necessary
              pvt = (k - 1) + la_i${ci}$amax(n - k + 1,vn1(k),1)
              if (pvt /= k) then
                 call la_${ri}$swap(m,a(1,pvt),1,a(1,k),1)
                 call la_${ri}$swap(k - 1,f(pvt,1),ldf,f(k,1),ldf)
                 itemp = jpvt(pvt)
                 jpvt(pvt) = jpvt(k)
                 jpvt(k) = itemp
                 vn1(pvt) = vn1(k)
                 vn2(pvt) = vn2(k)
              end if
              ! apply previous householder reflectors to column k:
              ! a(rk:m,k) := a(rk:m,k) - a(rk:m,1:k-1)*f(k,1:k-1)**h.
              if (k > 1) then
                 do j = 1,k - 1
                    f(k,j) = conjg(f(k,j))
                 end do
                 call la_${ri}$gemv('NO TRANSPOSE',m - rk + 1,k - 1,-cone,a(rk,1),lda,f(k,1), &
                            ldf,cone,a(rk,k),1)
                 do j = 1,k - 1
                    f(k,j) = conjg(f(k,j))
                 end do
              end if
              ! generate elementary reflector h(k).
              if (rk < m) then
                 call la_${ri}$larfg(m - rk + 1,a(rk,k),a(rk + 1,k),1,tau(k))
              else
                 call la_${ri}$larfg(1,a(rk,k),a(rk,k),1,tau(k))
              end if
              akk = a(rk,k)
              a(rk,k) = cone
              ! compute kth column of f:
              ! compute  f(k+1:n,k) := tau(k)*a(rk:m,k+1:n)**h*a(rk:m,k).
              if (k < n) then
                 call la_${ri}$gemv('CONJUGATE TRANSPOSE',m - rk + 1,n - k,tau(k),a(rk,k + 1), &
                           lda,a(rk,k),1,czero,f(k + 1,k),1)
              end if
              ! padding f(1:k,k) with zeros.
              do j = 1,k
                 f(j,k) = czero
              end do
              ! incremental updating of f:
              ! f(1:n,k) := f(1:n,k) - tau(k)*f(1:n,1:k-1)*a(rk:m,1:k-1)**h
                          ! *a(rk:m,k).
              if (k > 1) then
                 call la_${ri}$gemv('CONJUGATE TRANSPOSE',m - rk + 1,k - 1,-tau(k),a(rk,1),lda, &
                            a(rk,k),1,czero,auxv(1),1)
                 call la_${ri}$gemv('NO TRANSPOSE',n,k - 1,cone,f(1,1),ldf,auxv(1),1, &
                           cone,f(1,k),1)
              end if
              ! update the current row of a:
              ! a(rk,k+1:n) := a(rk,k+1:n) - a(rk,1:k)*f(k+1:n,1:k)**h.
              if (k < n) then
                 call la_${ri}$gemm('NO TRANSPOSE','CONJUGATE TRANSPOSE',1,n - k,k,-cone,a(rk, &
                            1),lda,f(k + 1,1),ldf,cone,a(rk,k + 1),lda)
              end if
              ! update partial column norms.
              if (rk < lastrk) then
                 do j = k + 1,n
                    if (vn1(j) /= zero) then
                       ! note: the following 4 lines follow from the analysis in
                       ! lapack working note 176.
                       temp = abs(a(rk,j))/vn1(j)
                       temp = max(zero, (one + temp)*(one - temp))
                       temp2 = temp*(vn1(j)/vn2(j))**2
                       if (temp2 <= tol3z) then
                          vn2(j) = real(lsticc,KIND=${rk}$)
                          lsticc = j
                       else
                          vn1(j) = vn1(j)*sqrt(temp)
                       end if
                    end if
                 end do
              end if
              a(rk,k) = akk
              ! end of while loop.
              go to 10
           end if
           kb = k
           rk = offset + kb
           ! apply the block reflector to the rest of the matrix:
           ! a(offset+kb+1:m,kb+1:n) := a(offset+kb+1:m,kb+1:n) -
                               ! a(offset+kb+1:m,1:kb)*f(kb+1:n,1:kb)**h.
           if (kb < min(n,m - offset)) then
              call la_${ri}$gemm('NO TRANSPOSE','CONJUGATE TRANSPOSE',m - rk,n - kb,kb,-cone,a( &
                        rk + 1,1),lda,f(kb + 1,1),ldf,cone,a(rk + 1,kb + 1),lda)
           end if
           ! recomputation of difficult columns.
           60 continue
           if (lsticc > 0) then
              itemp = nint(vn2(lsticc),KIND=ilp)
              vn1(lsticc) = la_${ci}$${ri}$nrm2(m - rk,a(rk + 1,lsticc),1)
              ! note: the computation of vn1( lsticc ) relies on the fact that
#:if rk == "sp"
              ! la_${ci}$nrm2 does not fail on vectors with norm below the value of
              ! sqrt(la_${ciu}$lamch('s'))
#:else
              ! la_${cil}$nrm2 does not fail on vectors with norm below the value of
              ! sqrt(la_${ci}$lamch('s'))
#:endif
              vn2(lsticc) = vn1(lsticc)
              lsticc = itemp
              go to 60
           end if
           return
     end subroutine la_${ri}$laqps
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAUNHR_COL_GETRFNP: computes the modified LU factorization without
     !> pivoting of a complex general M-by-N matrix A. The factorization has
     !> the form:
     !> A - S = L * U,
     !> where:
     !> S is a m-by-n diagonal sign matrix with the diagonal D, so that
     !> D(i) = S(i,i), 1 <= i <= min(M,N). The diagonal D is constructed
     !> as D(i)=-SIGN(A(i,i)), where A(i,i) is the value after performing
     !> i-1 steps of Gaussian elimination. This means that the diagonal
     !> element at each step of "modified" Gaussian elimination is
     !> at least one in absolute value (so that division-by-zero not
     !> not possible during the division by the diagonal element);
     !> L is a M-by-N lower triangular matrix with unit diagonal elements
     !> (lower trapezoidal if M > N);
     !> and U is a M-by-N upper triangular matrix
     !> (upper trapezoidal if M < N).
     !> This routine is an auxiliary routine used in the Householder
     !> reconstruction routine ${ri.upper()}$UNHR_COL. In ${ri.upper()}$UNHR_COL, this routine is
     !> applied to an M-by-N matrix A with orthonormal columns, where each
     !> element is bounded by one in absolute value. With the choice of
     !> the matrix S above, one can show that the diagonal element at each
     !> step of Gaussian elimination is the largest (in absolute value) in
     !> the column on or below the diagonal, so that no pivoting is required
     !> for numerical stability [1].
     !> For more details on the Householder reconstruction algorithm,
     !> including the modified LU factorization, see [1].
     !> This is the blocked right-looking version of the algorithm,
     !> calling Level 3 BLAS to update the submatrix. To factorize a block,
     !> this routine calls the recursive routine ${ri.upper()}$LAUNHR_COL_GETRFNP2.
     !> [1] "Reconstructing Householder vectors from tall-skinny QR",
     !> G. Ballard, J. Demmel, L. Grigori, M. Jacquelin, H.D. Nguyen,
     !> E. Solomonik, J. Parallel Distrib. Comput.,
     !> vol. 85, pp. 3-31, 2015.

     pure subroutine la_${ri}$launhr_col_getrfnp(m,n,a,lda,d,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: d(*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: iinfo,j,jb,nb
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters.
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$LAUNHR_COL_GETRFNP',-info)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) return
           ! determine the block size for this environment.
           nb = la_ilaenv(1,'${ri.upper()}$LAUNHR_COL_GETRFNP',' ',m,n,-1,-1)
           if (nb <= 1 .or. nb >= min(m,n)) then
              ! use unblocked code.
              call la_${ri}$launhr_col_getrfnp2(m,n,a,lda,d,info)
           else
              ! use blocked code.
              do j = 1,min(m,n),nb
                 jb = min(min(m,n) - j + 1,nb)
                 ! factor diagonal and subdiagonal blocks.
                 call la_${ri}$launhr_col_getrfnp2(m - j + 1,jb,a(j,j),lda,d(j),iinfo)

                 if (j + jb <= n) then
                    ! compute block row of u.
                    call la_${ri}$trsm('LEFT','LOWER','NO TRANSPOSE','UNIT',jb,n - j - jb + 1,cone, &
                               a(j,j),lda,a(j,j + jb),lda)
                    if (j + jb <= m) then
                       ! update trailing submatrix.
                       call la_${ri}$gemm('NO TRANSPOSE','NO TRANSPOSE',m - j - jb + 1,n - j - jb + 1,jb,- &
                       cone,a(j + jb,j),lda,a(j,j + jb),lda,cone,a(j + jb,j + jb),lda)

                    end if
                 end if
              end do
           end if
           return
     end subroutine la_${ri}$launhr_col_getrfnp
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$TPMQRT: applies a complex orthogonal matrix Q obtained from a
     !> "triangular-pentagonal" complex block reflector H to a general
     !> complex matrix C, which consists of two blocks A and B.

     pure subroutine la_${ri}$tpmqrt(side,trans,m,n,k,l,nb,v,ldv,t,ldt,a,lda,b,ldb, &
               work,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: k,ldv,lda,ldb,m,n,l,nb,ldt
           ! Array Arguments
           complex(${rk}$),intent(in) :: v(ldv,*),t(ldt,*)
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran
           integer(ilp) :: i,ib,mb,lb,kf,ldaq,ldvq
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! Test The Input Arguments
           info = 0
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           tran = la_lsame(trans,'C')
           notran = la_lsame(trans,'N')
           if (left) then
              ldvq = max(1,m)
              ldaq = max(1,k)
           else if (right) then
              ldvq = max(1,n)
              ldaq = max(1,m)
           end if
           if (.not. left .and. .not. right) then
              info = -1
           else if (.not. tran .and. .not. notran) then
              info = -2
           else if (m < 0) then
              info = -3
           else if (n < 0) then
              info = -4
           else if (k < 0) then
              info = -5
           else if (l < 0 .or. l > k) then
              info = -6
           else if (nb < 1 .or. (nb > k .and. k > 0)) then
              info = -7
           else if (ldv < ldvq) then
              info = -9
           else if (ldt < nb) then
              info = -11
           else if (lda < ldaq) then
              info = -13
           else if (ldb < max(1,m)) then
              info = -15
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$TPMQRT',-info)
              return
           end if
           ! Quick Return If Possible
           if (m == 0 .or. n == 0 .or. k == 0) return
           if (left .and. tran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 mb = min(m - l + i + ib - 1,m)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - m + l - i + 1
                 end if
                 call la_${ri}$tprfb('L','C','F','C',mb,n,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(i,1),lda,b,ldb,work,ib)
              end do
           else if (right .and. notran) then
              do i = 1,k,nb
                 ib = min(nb,k - i + 1)
                 mb = min(n - l + i + ib - 1,n)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - n + l - i + 1
                 end if
                 call la_${ri}$tprfb('R','N','F','C',m,mb,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(1,i),lda,b,ldb,work,m)
              end do
           else if (left .and. notran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 mb = min(m - l + i + ib - 1,m)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - m + l - i + 1
                 end if
                 call la_${ri}$tprfb('L','N','F','C',mb,n,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(i,1),lda,b,ldb,work,ib)
              end do
           else if (right .and. tran) then
              kf = ((k - 1)/nb)*nb + 1
              do i = kf,1,-nb
                 ib = min(nb,k - i + 1)
                 mb = min(n - l + i + ib - 1,n)
                 if (i >= l) then
                    lb = 0
                 else
                    lb = mb - n + l - i + 1
                 end if
                 call la_${ri}$tprfb('R','C','F','C',m,mb,ib,lb,v(1,i),ldv,t(1,i), &
                           ldt,a(1,i),lda,b,ldb,work,m)
              end do
           end if
           return
     end subroutine la_${ri}$tpmqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$TPQRT: computes a blocked QR factorization of a complex
     !> "triangular-pentagonal" matrix C, which is composed of a
     !> triangular block A and pentagonal block B, using the compact
     !> WY representation for Q.

     pure subroutine la_${ri}$tpqrt(m,n,l,nb,a,lda,b,ldb,t,ldt,work,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldb,ldt,n,m,l,nb
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*),b(ldb,*)
           complex(${rk}$),intent(out) :: t(ldt,*),work(*)
       ! =====================================================================
           ! Local Scalars
           integer(ilp) :: i,ib,lb,mb,iinfo
           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (l < 0 .or. (l > min(m,n) .and. min(m,n) >= 0)) then
              info = -3
           else if (nb < 1 .or. (nb > n .and. n > 0)) then
              info = -4
           else if (lda < max(1,n)) then
              info = -6
           else if (ldb < max(1,m)) then
              info = -8
           else if (ldt < nb) then
              info = -10
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$TPQRT',-info)
              return
           end if
           ! quick return if possible
           if (m == 0 .or. n == 0) return
           do i = 1,n,nb
           ! compute the qr factorization of the current block
              ib = min(n - i + 1,nb)
              mb = min(m - l + i + ib - 1,m)
              if (i >= l) then
                 lb = 0
              else
                 lb = mb - m + l - i + 1
              end if
              call la_${ri}$tpqrt2(mb,ib,lb,a(i,i),lda,b(1,i),ldb,t(1,i),ldt,iinfo)

           ! update by applying h**h to b(:,i+ib:n) from the left
              if (i + ib <= n) then
                 call la_${ri}$tprfb('L','C','F','C',mb,n - i - ib + 1,ib,lb,b(1,i),ldb,t( &
                           1,i),ldt,a(i,i + ib),lda,b(1,i + ib),ldb,work,ib)
              end if
           end do
           return
     end subroutine la_${ri}$tpqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNHR_COL: takes an M-by-N complex matrix Q_in with orthonormal columns
     !> as input, stored in A, and performs Householder Reconstruction (HR),
     !> i.e. reconstructs Householder vectors V(i) implicitly representing
     !> another M-by-N matrix Q_out, with the property that Q_in = Q_out*S,
     !> where S is an N-by-N diagonal matrix with diagonal entries
     !> equal to +1 or -1. The Householder vectors (columns V(i) of V) are
     !> stored in A on output, and the diagonal entries of S are stored in D.
     !> Block reflectors are also returned in T
     !> (same output format as ${ri.upper()}$GEQRT).

     pure subroutine la_${ri}$unhr_col(m,n,nb,a,lda,t,ldt,d,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,m,n,nb
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: d(*),t(ldt,*)
        ! =====================================================================

           ! Local Scalars
           integer(ilp) :: i,iinfo,j,jb,jbtemp1,jbtemp2,jnb,nplusone
           ! Intrinsic Functions
           intrinsic :: max,min
           ! Executable Statements
           ! test the input parameters
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0 .or. n > m) then
              info = -2
           else if (nb < 1) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldt < max(1,min(nb,n))) then
              info = -7
           end if
           ! handle error in the input parameters.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNHR_COL',-info)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              return
           end if
           ! on input, the m-by-n matrix a contains the unitary
           ! m-by-n matrix q_in.
           ! (1) compute the unit lower-trapezoidal v (ones on the diagonal
           ! are not stored) by performing the "modified" lu-decomposition.
           ! q_in - ( s ) = v * u = ( v1 ) * u,
                  ! ( 0 )           ( v2 )
           ! where 0 is an (m-n)-by-n zero matrix.
           ! (1-1) factor v1 and u.
           call la_${ri}$launhr_col_getrfnp(n,n,a,lda,d,iinfo)
           ! (1-2) solve for v2.
           if (m > n) then
              call la_${ri}$trsm('R','U','N','N',m - n,n,cone,a,lda,a(n + 1,1),lda)

           end if
           ! (2) reconstruct the block reflector t stored in t(1:nb, 1:n)
           ! as a sequence of upper-triangular blocks with nb-size column
           ! blocking.
           ! loop over the column blocks of size nb of the array a(1:m,1:n)
           ! and the array t(1:nb,1:n), jb is the column index of a column
           ! block, jnb is the column block size at each step jb.
           nplusone = n + 1
           do jb = 1,n,nb
              ! (2-0) determine the column block size jnb.
              jnb = min(nplusone - jb,nb)
              ! (2-1) copy the upper-triangular part of the current jnb-by-jnb
              ! diagonal block u(jb) (of the n-by-n matrix u) stored
              ! in a(jb:jb+jnb-1,jb:jb+jnb-1) into the upper-triangular part
              ! of the current jnb-by-jnb block t(1:jnb,jb:jb+jnb-1)
              ! column-by-column, total jnb*(jnb+1)/2 elements.
              jbtemp1 = jb - 1
              do j = jb,jb + jnb - 1
                 call la_${ri}$copy(j - jbtemp1,a(jb,j),1,t(1,j),1)
              end do
              ! (2-2) perform on the upper-triangular part of the current
              ! jnb-by-jnb diagonal block u(jb) (of the n-by-n matrix u) stored
              ! in t(1:jnb,jb:jb+jnb-1) the following operation in place:
              ! (-1)*u(jb)*s(jb), i.e the result will be stored in the upper-
              ! triangular part of t(1:jnb,jb:jb+jnb-1). this multiplication
              ! of the jnb-by-jnb diagonal block u(jb) by the jnb-by-jnb
              ! diagonal block s(jb) of the n-by-n sign matrix s from the
              ! right means changing the sign of each j-th column of the block
              ! u(jb) according to the sign of the diagonal element of the block
              ! s(jb), i.e. s(j,j) that is stored in the array element d(j).
              do j = jb,jb + jnb - 1
                 if (d(j) == cone) then
                    call la_${ri}$scal(j - jbtemp1,-cone,t(1,j),1)
                 end if
              end do
              ! (2-3) perform the triangular solve for the current block
              ! matrix x(jb):
                     ! x(jb) * (a(jb)**t) = b(jb), where:
                     ! a(jb)**t  is a jnb-by-jnb unit upper-triangular
                               ! coefficient block, and a(jb)=v1(jb), which
                               ! is a jnb-by-jnb unit lower-triangular block
                               ! stored in a(jb:jb+jnb-1,jb:jb+jnb-1).
                               ! the n-by-n matrix v1 is the upper part
                               ! of the m-by-n lower-trapezoidal matrix v
                               ! stored in a(1:m,1:n);
                     ! b(jb)     is a jnb-by-jnb  upper-triangular right-hand
                               ! side block, b(jb) = (-1)*u(jb)*s(jb), and
                               ! b(jb) is stored in t(1:jnb,jb:jb+jnb-1);
                     ! x(jb)     is a jnb-by-jnb upper-triangular solution
                               ! block, x(jb) is the upper-triangular block
                               ! reflector t(jb), and x(jb) is stored
                               ! in t(1:jnb,jb:jb+jnb-1).
                   ! in other words, we perform the triangular solve for the
                   ! upper-triangular block t(jb):
                     ! t(jb) * (v1(jb)**t) = (-1)*u(jb)*s(jb).
                   ! even though the blocks x(jb) and b(jb) are upper-
                   ! triangular, the routine la_${ri}$trsm will access all jnb**2
                   ! elements of the square t(1:jnb,jb:jb+jnb-1). therefore,
                   ! we need to set to zero the elements of the block
                   ! t(1:jnb,jb:jb+jnb-1) below the diagonal before the call
                   ! to la_${ri}$trsm.
              ! (2-3a) set the elements to zero.
              jbtemp2 = jb - 2
              do j = jb,jb + jnb - 2
                 do i = j - jbtemp2,nb
                    t(i,j) = czero
                 end do
              end do
              ! (2-3b) perform the triangular solve.
              call la_${ri}$trsm('R','L','C','U',jnb,jnb,cone,a(jb,jb),lda,t(1,jb), &
                        ldt)
           end do
           return
     end subroutine la_${ri}$unhr_col
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQP3: computes a QR factorization with column pivoting of a
     !> matrix A:  A*P = Q*R  using Level 3 BLAS.

     pure subroutine la_${ri}$geqp3(m,n,a,lda,jpvt,tau,work,lwork,rwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,lwork,m,n
           ! Array Arguments
           integer(ilp),intent(inout) :: jpvt(*)
           real(${rk}$),intent(out) :: rwork(*)
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: tau(*),work(*)
        ! =====================================================================
           ! Parameters
           integer(ilp),parameter :: inb = 1
           integer(ilp),parameter :: inbmin = 2
           integer(ilp),parameter :: ixover = 3

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: fjb,iws,j,jb,lwkopt,minmn,minws,na,nb,nbmin,nfxd,nx,sm, &
                     sminmn,sn,topbmn
           ! Intrinsic Functions
           intrinsic :: int,max,min
           ! Executable Statements
           ! test input arguments
        ! ====================
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (lda < max(1,m)) then
              info = -4
           end if
           if (info == 0) then
              minmn = min(m,n)
              if (minmn == 0) then
                 iws = 1
                 lwkopt = 1
              else
                 iws = n + 1
                 nb = la_ilaenv(inb,'${ri.upper()}$GEQRF',' ',m,n,-1,-1)
                 lwkopt = (n + 1)*nb
              end if
              work(1) = cmplx(lwkopt,KIND=${rk}$)
              if ((lwork < iws) .and. .not. lquery) then
                 info = -8
              end if
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQP3',-info)
              return
           else if (lquery) then
              return
           end if
           ! move initial columns up front.
           nfxd = 1
           do j = 1,n
              if (jpvt(j) /= 0) then
                 if (j /= nfxd) then
                    call la_${ri}$swap(m,a(1,j),1,a(1,nfxd),1)
                    jpvt(j) = jpvt(nfxd)
                    jpvt(nfxd) = j
                 else
                    jpvt(j) = j
                 end if
                 nfxd = nfxd + 1
              else
                 jpvt(j) = j
              end if
           end do
           nfxd = nfxd - 1
           ! factorize fixed columns
        ! =======================
           ! compute the qr factorization of fixed columns and update
           ! remaining columns.
           if (nfxd > 0) then
              na = min(m,nfxd)
      ! cc      call la_${ri}$geqr2( m, na, a, lda, tau, work, info )
              call la_${ri}$geqrf(m,na,a,lda,tau,work,lwork,info)
              iws = max(iws,int(work(1),KIND=ilp))
              if (na < n) then
      ! cc         call la_${ri}$unm2r( 'left', 'conjugate transpose', m, n-na,
      ! cc  $                   na, a, lda, tau, a( 1, na+1 ), lda, work,
      ! cc  $                   info )
                 call la_${ri}$unmqr('LEFT','CONJUGATE TRANSPOSE',m,n - na,na,a,lda,tau,a(1, &
                            na + 1),lda,work,lwork,info)
                 iws = max(iws,int(work(1),KIND=ilp))
              end if
           end if
           ! factorize free columns
        ! ======================
           if (nfxd < minmn) then
              sm = m - nfxd
              sn = n - nfxd
              sminmn = minmn - nfxd
              ! determine the block size.
              nb = la_ilaenv(inb,'${ri.upper()}$GEQRF',' ',sm,sn,-1,-1)
              nbmin = 2
              nx = 0
              if ((nb > 1) .and. (nb < sminmn)) then
                 ! determine when to cross over from blocked to unblocked code.
                 nx = max(0,la_ilaenv(ixover,'${ri.upper()}$GEQRF',' ',sm,sn,-1,-1))
                 if (nx < sminmn) then
                    ! determine if workspace is large enough for blocked code.
                    minws = (sn + 1)*nb
                    iws = max(iws,minws)
                    if (lwork < minws) then
                       ! not enough workspace to use optimal nb: reduce nb and
                       ! determine the minimum value of nb.
                       nb = lwork/(sn + 1)
                       nbmin = max(2,la_ilaenv(inbmin,'${ri.upper()}$GEQRF',' ',sm,sn,-1,-1))

                    end if
                 end if
              end if
              ! initialize partial column norms. the first n elements of work
              ! store the exact column norms.
              do j = nfxd + 1,n
                 rwork(j) = la_${ci}$${ri}$nrm2(sm,a(nfxd + 1,j),1)
                 rwork(n + j) = rwork(j)
              end do
              if ((nb >= nbmin) .and. (nb < sminmn) .and. (nx < sminmn)) then
                 ! use blocked code initially.
                 j = nfxd + 1
                 ! compute factorization: while loop.
                 topbmn = minmn - nx
                 30 continue
                 if (j <= topbmn) then
                    jb = min(nb,topbmn - j + 1)
                    ! factorize jb columns among columns j:n.
                    call la_${ri}$laqps(m,n - j + 1,j - 1,jb,fjb,a(1,j),lda,jpvt(j),tau(j) &
                              ,rwork(j),rwork(n + j),work(1),work(jb + 1),n - j + 1)
                    j = j + fjb
                    go to 30
                 end if
              else
                 j = nfxd + 1
              end if
              ! use unblocked code to factor the last or only block.
              if (j <= minmn) call la_${ri}$laqp2(m,n - j + 1,j - 1,a(1,j),lda,jpvt(j),tau(j), &
                         rwork(j),rwork(n + j),work(1))
           end if
           work(1) = cmplx(lwkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$geqp3
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQRT: computes a blocked QR factorization of a complex M-by-N matrix A
     !> using the compact WY representation of Q.

     pure subroutine la_${ri}$geqrt(m,n,nb,a,lda,t,ldt,work,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,m,n,nb
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: t(ldt,*),work(*)
       ! =====================================================================
           ! Local Scalars
           logical(lk),parameter :: use_recursive_qr = .true.
           integer(ilp) :: i,ib,iinfo,k

           ! Executable Statements
           ! test the input arguments
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0) then
              info = -2
           else if (nb < 1 .or. (nb > min(m,n) .and. min(m,n) > 0)) then
              info = -3
           else if (lda < max(1,m)) then
              info = -5
           else if (ldt < nb) then
              info = -7
           end if
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GEQRT',-info)
              return
           end if
           ! quick return if possible
           k = min(m,n)
           if (k == 0) return
           ! blocked loop of length k
           do i = 1,k,nb
              ib = min(k - i + 1,nb)
           ! compute the qr factorization of the current block a(i:m,i:i+ib-1)
              if (use_recursive_qr) then
                 call la_${ri}$geqrt3(m - i + 1,ib,a(i,i),lda,t(1,i),ldt,iinfo)
              else
                 call la_${ri}$geqrt2(m - i + 1,ib,a(i,i),lda,t(1,i),ldt,iinfo)
              end if
              if (i + ib <= n) then
           ! update by applying h**h to a(i:m,i+ib:n) from the left
                 call la_${ri}$larfb('L','C','F','C',m - i + 1,n - i - ib + 1,ib,a(i,i),lda,t(1, &
                            i),ldt,a(i,i + ib),lda,work,n - i - ib + 1)
              end if
           end do
           return
     end subroutine la_${ri}$geqrt
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LAMTSQR: overwrites the general complex M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'C':      Q**H * C       C * Q**H
     !> where Q is a complex unitary matrix defined as the product
     !> of blocked elementary reflectors computed by tall skinny
     !> QR factorization (${ri.upper()}$LATSQR)

     pure subroutine la_${ri}$lamtsqr(side,trans,m,n,k,mb,nb,a,lda,t,ldt,c,ldc,work, &
               lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,k,mb,nb,ldt,lwork,ldc
           ! Array Arguments
           complex(${rk}$),intent(in) :: a(lda,*),t(ldt,*)
           complex(${rk}$),intent(out) :: work(*)
           complex(${rk}$),intent(inout) :: c(ldc,*)
       ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran,lquery
           integer(ilp) :: i,ii,kk,lw,ctr,q
           ! External Subroutines
           ! Executable Statements
           ! test the input arguments
           lquery = lwork < 0
           notran = la_lsame(trans,'N')
           tran = la_lsame(trans,'C')
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           if (left) then
             lw = n*nb
             q = m
           else
             lw = m*nb
             q = n
           end if
           info = 0
           if (.not. left .and. .not. right) then
              info = -1
           else if (.not. tran .and. .not. notran) then
              info = -2
           else if (m < k) then
             info = -3
           else if (n < 0) then
             info = -4
           else if (k < 0) then
             info = -5
           else if (k < nb .or. nb < 1) then
             info = -7
           else if (lda < max(1,q)) then
             info = -9
           else if (ldt < max(1,nb)) then
             info = -11
           else if (ldc < max(1,m)) then
              info = -13
           else if ((lwork < max(1,lw)) .and. (.not. lquery)) then
             info = -15
           end if
           ! determine the block size if it is tall skinny or short and wide
           if (info == 0) then
               work(1) = lw
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$LAMTSQR',-info)
             return
           else if (lquery) then
            return
           end if
           ! quick return if possible
           if (min(m,n,k) == 0) then
             return
           end if
           if ((mb <= k) .or. (mb >= max(m,n,k))) then
             call la_${ri}$gemqrt(side,trans,m,n,k,nb,a,lda,t,ldt,c,ldc,work,info)

             return
            end if
           if (left .and. notran) then
               ! multiply q to the last block of c
              kk = mod((m - k), (mb - k))
              ctr = (m - k)/(mb - k)
              if (kk > 0) then
                ii = m - kk + 1
#:if rk == "sp"
                call la_${ri}$tpmqrt('L','N',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c( &
                          1,1),ldc,c(ii,1),ldc,work,info)
#:else
                call la_${ri}$tpmqrt('L','N',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt, &
                           c(1,1),ldc,c(ii,1),ldc,work,info)
#:endif
              else
                ii = m + 1
              end if
              do i = ii - (mb - k),mb + 1,-(mb - k)
               ! multiply q to the current block of c (i:i+mb,1:n)
                ctr = ctr - 1
#:if rk == "sp"
                call la_${ri}$tpmqrt('L','N',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c(1, &
                          1),ldc,c(i,1),ldc,work,info)
#:else
                call la_${ri}$tpmqrt('L','N',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt, &
                          c(1,1),ldc,c(i,1),ldc,work,info)
#:endif
              end do
               ! multiply q to the first block of c (1:mb,1:n)
              call la_${ri}$gemqrt('L','N',mb,n,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                        info)
           else if (left .and. tran) then
               ! multiply q to the first block of c
              kk = mod((m - k), (mb - k))
              ii = m - kk + 1
              ctr = 1
              call la_${ri}$gemqrt('L','C',mb,n,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                        info)
              do i = mb + 1,ii - mb + k, (mb - k)
               ! multiply q to the current block of c (i:i+mb,1:n)
#:if rk == "sp"
               call la_${ri}$tpmqrt('L','C',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c(1, &
                         1),ldc,c(i,1),ldc,work,info)
#:else
               call la_${ri}$tpmqrt('L','C',mb - k,n,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c( &
                         1,1),ldc,c(i,1),ldc,work,info)
#:endif
               ctr = ctr + 1
              end do
              if (ii <= m) then
               ! multiply q to the last block of c
#:if rk == "sp"
               call la_${ri}$tpmqrt('L','C',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c(1,1) &
                         ,ldc,c(ii,1),ldc,work,info)
#:else
               call la_${ri}$tpmqrt('L','C',kk,n,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt, &
                         c(1,1),ldc,c(ii,1),ldc,work,info)
#:endif
              end if
           else if (right .and. tran) then
               ! multiply q to the last block of c
               kk = mod((n - k), (mb - k))
               ctr = (n - k)/(mb - k)
               if (kk > 0) then
                 ii = n - kk + 1
#:if rk == "sp"
                 call la_${ri}$tpmqrt('R','C',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c( &
                           1,1),ldc,c(1,ii),ldc,work,info)
#:else
                 call la_${ri}$tpmqrt('R','C',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt, &
                            c(1,1),ldc,c(1,ii),ldc,work,info)
#:endif
               else
                 ii = n + 1
               end if
               do i = ii - (mb - k),mb + 1,-(mb - k)
               ! multiply q to the current block of c (1:m,i:i+mb)
                 ctr = ctr - 1
#:if rk == "sp"
                 call la_${ri}$tpmqrt('R','C',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c( &
                           1,1),ldc,c(1,i),ldc,work,info)
#:else
                 call la_${ri}$tpmqrt('R','C',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1), &
                           ldt,c(1,1),ldc,c(1,i),ldc,work,info)
#:endif
               end do
               ! multiply q to the first block of c (1:m,1:mb)
               call la_${ri}$gemqrt('R','C',m,mb,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                         info)
           else if (right .and. notran) then
               ! multiply q to the first block of c
              kk = mod((n - k), (mb - k))
              ii = n - kk + 1
              ctr = 1
              call la_${ri}$gemqrt('R','N',m,mb,k,nb,a(1,1),lda,t,ldt,c(1,1),ldc,work, &
                        info)
              do i = mb + 1,ii - mb + k, (mb - k)
               ! multiply q to the current block of c (1:m,i:i+mb)
#:if rk == "sp"
               call la_${ri}$tpmqrt('R','N',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt,c(1,1) &
                         ,ldc,c(1,i),ldc,work,info)
#:else
               call la_${ri}$tpmqrt('R','N',m,mb - k,k,0,nb,a(i,1),lda,t(1,ctr*k + 1),ldt, &
                         c(1,1),ldc,c(1,i),ldc,work,info)
#:endif
               ctr = ctr + 1
              end do
              if (ii <= n) then
               ! multiply q to the last block of c
#:if rk == "sp"
               call la_${ri}$tpmqrt('R','N',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c(1,1) &
                         ,ldc,c(1,ii),ldc,work,info)
#:else
               call la_${ri}$tpmqrt('R','N',m,kk,k,0,nb,a(ii,1),lda,t(1,ctr*k + 1),ldt,c( &
                         1,1),ldc,c(1,ii),ldc,work,info)
#:endif
              end if
           end if
           work(1) = lw
           return
     end subroutine la_${ri}$lamtsqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$LATSQR: computes a blocked Tall-Skinny QR factorization of
     !> a complex M-by-N matrix A for M >= N:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix, stored on exit in an implicit
     !> form in the elements below the diagonal of the array A and in
     !> the elements of the array T;
     !> R is an upper-triangular N-by-N matrix, stored on exit in
     !> the elements on and above the diagonal of the array A.
     !> 0 is a (M-N)-by-N zero matrix, and is not stored.

     pure subroutine la_${ri}$latsqr(m,n,mb,nb,a,lda,t,ldt,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd. --
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,mb,nb,ldt,lwork
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: work(*),t(ldt,*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,ii,kk,ctr
           ! External Subroutines
           intrinsic :: max,min,mod
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (lwork == -1)
           if (m < 0) then
             info = -1
           else if (n < 0 .or. m < n) then
             info = -2
           else if (mb < 1) then
             info = -3
           else if (nb < 1 .or. (nb > n .and. n > 0)) then
             info = -4
           else if (lda < max(1,m)) then
             info = -6
           else if (ldt < nb) then
             info = -8
           else if (lwork < (n*nb) .and. (.not. lquery)) then
             info = -10
           end if
           if (info == 0) then
             work(1) = nb*n
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$LATSQR',-info)
             return
           else if (lquery) then
            return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
               return
           end if
           ! the qr decomposition
            if ((mb <= n) .or. (mb >= m)) then
              call la_${ri}$geqrt(m,n,nb,a,lda,t,ldt,work,info)
              return
            end if
            kk = mod((m - n), (mb - n))
            ii = m - kk + 1
            ! compute the qr factorization of the first block a(1:mb,1:n)
            call la_${ri}$geqrt(mb,n,nb,a(1,1),lda,t,ldt,work,info)
            ctr = 1
            do i = mb + 1,ii - mb + n, (mb - n)
            ! compute the qr factorization of the current block a(i:i+mb-n,1:n)
              call la_${ri}$tpqrt(mb - n,n,0,nb,a(1,1),lda,a(i,1),lda,t(1,ctr*n + 1), &
                        ldt,work,info)
              ctr = ctr + 1
            end do
            ! compute the qr factorization of the last block a(ii:m,1:n)
            if (ii <= m) then
              call la_${ri}$tpqrt(kk,n,0,nb,a(1,1),lda,a(ii,1),lda,t(1,ctr*n + 1), &
                        ldt,work,info)
            end if
           work(1) = n*nb
           return
     end subroutine la_${ri}$latsqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$UNGTSQR: generates an M-by-N complex matrix Q_out with orthonormal
     !> columns, which are the first N columns of a product of comlpex unitary
     !> matrices of order M which are returned by ${ri.upper()}$LATSQR
     !> Q_out = first_N_columns_of( Q(1)_in * Q(2)_in * ... * Q(k)_in ).
     !> See the documentation for ${ri.upper()}$LATSQR.

     pure subroutine la_${ri}$ungtsqr(m,n,mb,nb,a,lda,t,ldt,work,lwork,info)
        use la_constants_${rk}$
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,lwork,m,n,mb,nb
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(in) :: t(ldt,*)
           complex(${rk}$),intent(out) :: work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: iinfo,ldc,lworkopt,lc,lw,nblocal,j
           ! Intrinsic Functions
           intrinsic :: cmplx,max,min
           ! Executable Statements
           ! test the input parameters
           lquery = lwork == -1
           info = 0
           if (m < 0) then
              info = -1
           else if (n < 0 .or. m < n) then
              info = -2
           else if (mb <= n) then
              info = -3
           else if (nb < 1) then
              info = -4
           else if (lda < max(1,m)) then
              info = -6
           else if (ldt < max(1,min(nb,n))) then
              info = -8
           else
              ! test the input lwork for the dimension of the array work.
              ! this workspace is used to store array c(ldc, n) and work(lwork)
              ! in the call to la_${ri}$lamtsqr. see the documentation for la_${ri}$lamtsqr.
              if (lwork < 2 .and. (.not. lquery)) then
                 info = -10
              else
                 ! set block size for column blocks
                 nblocal = min(nb,n)
                 ! lwork = -1, then set the size for the array c(ldc,n)
                 ! in la_${ri}$lamtsqr call and set the optimal size of the work array
                 ! work(lwork) in la_${ri}$lamtsqr call.
                 ldc = m
                 lc = ldc*n
                 lw = n*nblocal
                 lworkopt = lc + lw
                 if ((lwork < max(1,lworkopt)) .and. (.not. lquery)) then
                    info = -10
                 end if
              end if
           end if
           ! handle error in the input parameters and return workspace query.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$UNGTSQR',-info)
              return
           else if (lquery) then
              work(1) = cmplx(lworkopt,KIND=${rk}$)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              work(1) = cmplx(lworkopt,KIND=${rk}$)
              return
           end if
           ! (1) form explicitly the tall-skinny m-by-n left submatrix q1_in
           ! of m-by-m orthogonal matrix q_in, which is implicitly stored in
           ! the subdiagonal part of input array a and in the input array t.
           ! perform by the following operation using the routine la_${ri}$lamtsqr.
               ! q1_in = q_in * ( i ), where i is a n-by-n identity matrix,
                              ! ( 0 )        0 is a (m-n)-by-n zero matrix.
           ! (1a) form m-by-n matrix in the array work(1:ldc*n) with ones
           ! on the diagonal and zeros elsewhere.
           call la_${ri}$laset('F',m,n,czero,cone,work,ldc)
           ! (1b)  on input, work(1:ldc*n) stores ( i );
                                                ! ( 0 )
                 ! on output, work(1:ldc*n) stores q1_in.
           call la_${ri}$lamtsqr('L','N',m,n,n,mb,nblocal,a,lda,t,ldt,work,ldc,work( &
                     lc + 1),lw,iinfo)
           ! (2) copy the result from the part of the work array (1:m,1:n)
           ! with the leading dimension ldc that starts at work(1) into
           ! the output array a(1:m,1:n) column-by-column.
           do j = 1,n
              call la_${ri}$copy(m,work((j - 1)*ldc + 1),1,a(1,j),1)
           end do
           work(1) = cmplx(lworkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$ungtsqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEMQR: overwrites the general real M-by-N matrix C with
     !> SIDE = 'L'     SIDE = 'R'
     !> TRANS = 'N':      Q * C          C * Q
     !> TRANS = 'T':      Q**H * C       C * Q**H
     !> where Q is a complex unitary matrix defined as the product
     !> of blocked elementary reflectors computed by tall skinny
     !> QR factorization (${ri.upper()}$GEQR)

     pure subroutine la_${ri}$gemqr(side,trans,m,n,k,a,lda,t,tsize,c,ldc,work,lwork, &
               info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           character,intent(in) :: side,trans
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,k,tsize,lwork,ldc
           ! Array Arguments
           complex(${rk}$),intent(in) :: a(lda,*),t(*)
           complex(${rk}$),intent(inout) :: c(ldc,*)
           complex(${rk}$),intent(out) :: work(*)
       ! =====================================================================
           ! Local Scalars
           logical(lk) :: left,right,tran,notran,lquery
           integer(ilp) :: mb,nb,lw,nblcks,mn
           ! Intrinsic Functions
           intrinsic :: int,max,min,mod
           ! Executable Statements
           ! test the input arguments
           lquery = lwork == -1
           notran = la_lsame(trans,'N')
           tran = la_lsame(trans,'C')
           left = la_lsame(side,'L')
           right = la_lsame(side,'R')
           mb = int(t(2),KIND=ilp)
           nb = int(t(3),KIND=ilp)
           if (left) then
             lw = n*nb
             mn = m
           else
             lw = mb*nb
             mn = n
           end if
           if ((mb > k) .and. (mn > k)) then
             if (mod(mn - k,mb - k) == 0) then
               nblcks = (mn - k)/(mb - k)
             else
               nblcks = (mn - k)/(mb - k) + 1
             end if
           else
             nblcks = 1
           end if
           info = 0
           if (.not. left .and. .not. right) then
             info = -1
           else if (.not. tran .and. .not. notran) then
             info = -2
           else if (m < 0) then
             info = -3
           else if (n < 0) then
             info = -4
           else if (k < 0 .or. k > mn) then
             info = -5
           else if (lda < max(1,mn)) then
             info = -7
           else if (tsize < 5) then
             info = -9
           else if (ldc < max(1,m)) then
             info = -11
           else if ((lwork < max(1,lw)) .and. (.not. lquery)) then
             info = -13
           end if
           if (info == 0) then
             work(1) = lw
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$GEMQR',-info)
             return
           else if (lquery) then
             return
           end if
           ! quick return if possible
           if (min(m,n,k) == 0) then
             return
           end if
           if ((left .and. m <= k) .or. (right .and. n <= k) .or. (mb <= k) .or. (mb >= max(m,n, &
                     k))) then
             call la_${ri}$gemqrt(side,trans,m,n,k,nb,a,lda,t(6),nb,c,ldc,work,info &
                       )
           else
             call la_${ri}$lamtsqr(side,trans,m,n,k,mb,nb,a,lda,t(6),nb,c,ldc,work, &
                       lwork,info)
           end if
           work(1) = lw
           return
     end subroutine la_${ri}$gemqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GEQR: computes a QR factorization of a complex M-by-N matrix A:
     !> A = Q * ( R ),
     !> ( 0 )
     !> where:
     !> Q is a M-by-M orthogonal matrix;
     !> R is an upper-triangular N-by-N matrix;
     !> 0 is a (M-N)-by-N zero matrix, if M > N.

     pure subroutine la_${ri}$geqr(m,n,a,lda,t,tsize,work,lwork,info)
        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd. --
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,m,n,tsize,lwork
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: t(*),work(*)
        ! =====================================================================
           ! Local Scalars
           logical(lk) :: lquery,lminws,mint,minw
           integer(ilp) :: mb,nb,mintsz,nblcks
           ! Intrinsic Functions
           intrinsic :: max,min,mod
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = (tsize == -1 .or. tsize == -2 .or. lwork == -1 .or. lwork == -2)
           mint = .false.
           minw = .false.
           if (tsize == -2 .or. lwork == -2) then
             if (tsize /= -1) mint = .true.
             if (lwork /= -1) minw = .true.
           end if
           ! determine the block size
           if (min(m,n) > 0) then
             mb = la_ilaenv(1,'${ri.upper()}$GEQR ',' ',m,n,1,-1)
             nb = la_ilaenv(1,'${ri.upper()}$GEQR ',' ',m,n,2,-1)
           else
             mb = m
             nb = 1
           end if
           if (mb > m .or. mb <= n) mb = m
           if (nb > min(m,n) .or. nb < 1) nb = 1
           mintsz = n + 5
           if (mb > n .and. m > n) then
             if (mod(m - n,mb - n) == 0) then
               nblcks = (m - n)/(mb - n)
             else
               nblcks = (m - n)/(mb - n) + 1
             end if
           else
             nblcks = 1
           end if
           ! determine if the workspace size satisfies minimal size
           lminws = .false.
           if ((tsize < max(1,nb*n*nblcks + 5) .or. lwork < nb*n) .and. (lwork >= n) .and. ( &
                     tsize >= mintsz) .and. (.not. lquery)) then
             if (tsize < max(1,nb*n*nblcks + 5)) then
               lminws = .true.
               nb = 1
               mb = m
             end if
             if (lwork < nb*n) then
               lminws = .true.
               nb = 1
             end if
           end if
           if (m < 0) then
             info = -1
           else if (n < 0) then
             info = -2
           else if (lda < max(1,m)) then
             info = -4
           else if (tsize < max(1,nb*n*nblcks + 5) .and. (.not. lquery) .and. (.not. lminws)) &
                     then
             info = -6
           else if ((lwork < max(1,n*nb)) .and. (.not. lquery) .and. (.not. lminws)) &
                     then
             info = -8
           end if
           if (info == 0) then
             if (mint) then
               t(1) = mintsz
             else
               t(1) = nb*n*nblcks + 5
             end if
             t(2) = mb
             t(3) = nb
             if (minw) then
               work(1) = max(1,n)
             else
               work(1) = max(1,nb*n)
             end if
           end if
           if (info /= 0) then
             call la_xerbla('${ri.upper()}$GEQR',-info)
             return
           else if (lquery) then
             return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
             return
           end if
           ! the qr decomposition
           if ((m <= n) .or. (mb <= n) .or. (mb >= m)) then
             call la_${ri}$geqrt(m,n,nb,a,lda,t(6),nb,work,info)
           else
             call la_${ri}$latsqr(m,n,mb,nb,a,lda,t(6),nb,work,lwork,info)
           end if
           work(1) = max(1,nb*n)
           return
     end subroutine la_${ri}$geqr
#:endfor

#:for rk, rt, ri, ci, rkl, ril, cil, rku, riu, ciu in LA_CMPL_KINDS
     !> ${ri.upper()}$GETSQRHRT: computes a NB2-sized column blocked QR-factorization
     !> of a complex M-by-N matrix A with M >= N,
     !> A = Q * R.
     !> The routine uses internally a NB1-sized column blocked and MB1-sized
     !> row blocked TSQR-factorization and perfors the reconstruction
     !> of the Householder vectors from the TSQR output. The routine also
     !> converts the R_tsqr factor from the TSQR-factorization output into
     !> the R factor that corresponds to the Householder QR-factorization,
     !> A = Q_tsqr * R_tsqr = Q * R.
     !> The output Q and R factors are stored in the same format as in ${ri.upper()}$GEQRT
     !> (Q is in blocked compact WY-representation). See the documentation
     !> of ${ri.upper()}$GEQRT for more details on the format.

     pure subroutine la_${ri}$getsqrhrt(m,n,mb1,nb1,nb2,a,lda,t,ldt,work,lwork,info)
        use la_constants_${rk}$

        ! -- lapack computational routine --
        ! -- lapack is a software package provided by univ. of tennessee,    --
        ! -- univ. of california berkeley, univ. of colorado denver and nag ltd..--
           ! Scalar Arguments
           integer(ilp),intent(out) :: info
           integer(ilp),intent(in) :: lda,ldt,lwork,m,n,nb1,nb2,mb1
           ! Array Arguments
           complex(${rk}$),intent(inout) :: a(lda,*)
           complex(${rk}$),intent(out) :: t(ldt,*),work(*)
        ! =====================================================================

           ! Local Scalars
           logical(lk) :: lquery
           integer(ilp) :: i,iinfo,j,lw1,lw2,lwt,ldwt,lworkopt,nb1local,nb2local, &
                     num_all_row_blocks
           ! Intrinsic Functions
           intrinsic :: ceiling,real,cmplx,max,min
           ! Executable Statements
           ! test the input arguments
           info = 0
           lquery = lwork == -1
           if (m < 0) then
              info = -1
           else if (n < 0 .or. m < n) then
              info = -2
           else if (mb1 <= n) then
              info = -3
           else if (nb1 < 1) then
              info = -4
           else if (nb2 < 1) then
              info = -5
           else if (lda < max(1,m)) then
              info = -7
           else if (ldt < max(1,min(nb2,n))) then
              info = -9
           else
              ! test the input lwork for the dimension of the array work.
              ! this workspace is used to store array:
              ! a) matrix t and work for la_${ri}$latsqr;
              ! b) n-by-n upper-triangular factor r_tsqr;
              ! c) matrix t and array work for la_${ri}$ungtsqr_row;
              ! d) diagonal d for la_${ri}$unhr_col.
              if (lwork < n*n + 1 .and. .not. lquery) then
                 info = -11
              else
                 ! set block size for column blocks
                 nb1local = min(nb1,n)
                 num_all_row_blocks = max(1,ceiling(real(m - n,KIND=${rk}$)/real(mb1 - n, &
                           KIND=${rk}$)))
                 ! length and leading dimension of work array to place
                 ! t array in tsqr.
                 lwt = num_all_row_blocks*n*nb1local
                 ldwt = nb1local
                 ! length of tsqr work array
                 lw1 = nb1local*n
                 ! length of la_${ri}$ungtsqr_row work array.
                 lw2 = nb1local*max(nb1local, (n - nb1local))
                 lworkopt = max(lwt + lw1,max(lwt + n*n + lw2,lwt + n*n + n))
                 if ((lwork < max(1,lworkopt)) .and. (.not. lquery)) then
                    info = -11
                 end if
              end if
           end if
           ! handle error in the input parameters and return workspace query.
           if (info /= 0) then
              call la_xerbla('${ri.upper()}$GETSQRHRT',-info)
              return
           else if (lquery) then
              work(1) = cmplx(lworkopt,KIND=${rk}$)
              return
           end if
           ! quick return if possible
           if (min(m,n) == 0) then
              work(1) = cmplx(lworkopt,KIND=${rk}$)
              return
           end if
           nb2local = min(nb2,n)
           ! (1) perform tsqr-factorization of the m-by-n matrix a.
           call la_${ri}$latsqr(m,n,mb1,nb1local,a,lda,work,ldwt,work(lwt + 1),lw1,iinfo)

           ! (2) copy the factor r_tsqr stored in the upper-triangular part
               ! of a into the square matrix in the work array
               ! work(lwt+1:lwt+n*n) column-by-column.
           do j = 1,n
              call la_${ri}$copy(j,a(1,j),1,work(lwt + n*(j - 1) + 1),1)
           end do
           ! (3) generate a m-by-n matrix q with orthonormal columns from
           ! the result stored below the diagonal in the array a in place.
           call la_${ri}$ungtsqr_row(m,n,mb1,nb1local,a,lda,work,ldwt,work(lwt + n*n + 1), &
                     lw2,iinfo)
           ! (4) perform the reconstruction of householder vectors from
           ! the matrix q (stored in a) in place.
           call la_${ri}$unhr_col(m,n,nb2local,a,lda,t,ldt,work(lwt + n*n + 1),iinfo)

           ! (5) copy the factor r_tsqr stored in the square matrix in the
           ! work array work(lwt+1:lwt+n*n) into the upper-triangular
           ! part of a.
           ! (6) compute from r_tsqr the factor r_hr corresponding to
           ! the reconstructed householder vectors, i.e. r_hr = s * r_tsqr.
           ! this multiplication by the sign matrix s on the left means
           ! changing the sign of i-th row of the matrix r_tsqr according
           ! to sign of the i-th diagonal element diag(i) of the matrix s.
           ! diag is stored in work( lwt+n*n+1 ) from the la_${ri}$unhr_col output.
           ! (5) and (6) can be combined in a single loop, so the rows in a
           ! are accessed only once.
           do i = 1,n
              if (work(lwt + n*n + i) == -cone) then
                 do j = i,n
                    a(i,j) = -cone*work(lwt + n*(j - 1) + i)
                 end do
              else
                 call la_${ri}$copy(n - i + 1,work(lwt + n*(i - 1) + i),n,a(i,i),lda)
              end if
           end do
           work(1) = cmplx(lworkopt,KIND=${rk}$)
           return
     end subroutine la_${ri}$getsqrhrt
#:endfor

end module la_lapack_orthogonal_factors_qr
