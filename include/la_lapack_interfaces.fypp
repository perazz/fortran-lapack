    & ('unmrz', ['UNMRZ: overwrites the general complex M-by-N matrix C with', "SIDE = 'L'     SIDE = 'R'", "TRANS = 'N':      Q * C          C * Q", "TRANS = 'C':      Q**H * C       C * Q**H", 'where Q is a complex unitary matrix defined as the product of k', 'elementary reflectors', 'Q = H(1) H(2) . . . H(k)', "as returned by CTZRZF. Q is of order M if SIDE = 'L' and of order N", "if SIDE = 'R'."], &
